{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 19:51:45",
            "content": "こんばんは。今日はよろしくおねがいします。",
            "English": "Good evening. Thank you for having me today."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 19:52:21",
            "content": "こんばんは。こちらこそよろしくお願いします",
            "English": "Good evening. Thank you for coming."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 19:54:00",
            "content": "お名前はなんと呼んだらいいでしょうか❔予定時間に始めますね宜しくお願い致します。",
            "English": "What would you like me to call you? We'll start at the scheduled time. Thank you."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 19:54:57",
            "content": "はい。",
            "English": "Okay."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 19:55:29",
            "content": "名前はみさきで、お願いします。",
            "English": "Please call me Misaki."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 19:55:56",
            "content": "承知いたしました。宜しくお願い致します。",
            "English": "Understood. Thank you."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:01:19",
            "content": "今日は相談に来てくれてありがとうございます。はじめに年齢、性別を宜しくお願い致します。",
            "English": "Thank you for coming to talk with me today. To begin, could you please tell me your age and gender?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:01:48",
            "content": "高2 女子です",
            "English": "I'm a second-year high school girl."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:02:39",
            "content": "ありがとうございます。高校２年生なんですね。",
            "English": "Thank you. So you're a second-year high school student."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:02:43",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:03:24",
            "content": "今日の相談したいことを宜しくお願い致します。",
            "English": "Please tell me what you’d like to talk about today."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:03:30",
            "content": "はい",
            "English": "Okay."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:03:56",
            "content": "はい",
            "English": "Okay."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:05:23",
            "content": "結構前から頭痛がひどくて、マラソン大会の練習の為に、持久走をしているんだけど、頭痛の事を先生に言えないんです。",
            "English": "I've been having severe headaches for a while now, and we're doing endurance running practice for a marathon event, but I can't tell my teacher about them."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:05:49",
            "content": "体育の先生は担任で、怖くて。",
            "English": "The PE teacher is also my homeroom teacher, and they're scary."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:06:03",
            "content": "そうなんですね。話してくれてありがとうございます。",
            "English": "I see. Thank you for sharing that with me."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:06:13",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:07:09",
            "content": "体育の先生は怖くて言いにくいんですね。それは、お辛いですね",
            "English": "So it's hard to tell your PE teacher because they're scary. That must be very hard for you."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:07:17",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:08:07",
            "content": "体育の後はしんどくて、授業中半分寝てます",
            "English": "I feel so exhausted after PE that I'm half-asleep during my other classes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:08:11",
            "content": "頭痛がひどいのはいつ頃くらいですか❔",
            "English": "About when did your headaches start getting bad?"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:08:29",
            "content": "そうなんですね。",
            "English": "I see."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:08:33",
            "content": "去年の7月くらいからかなー",
            "English": "I think it started around July last year."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:08:55",
            "content": "雨の日は特にひどいです。",
            "English": "They're especially bad on rainy days."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:09:09",
            "content": "頭痛のことは周りの人には言えてますか",
            "English": "Have you been able to tell the people around you about your headaches?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:09:25",
            "content": "言えてないです。",
            "English": "I haven’t been able to."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:10:14",
            "content": "それは、より、しんどいですね",
            "English": "That must make it even tougher."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:10:51",
            "content": "1回言った事あるけど「元気じゃん」って嘘ついた様に言われた事があって。",
            "English": "I tried telling someone once, but they said something like, \"You look fine,\" as if I were lying."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:10:59",
            "content": "だから言いにくいです。",
            "English": "That's why it's hard to talk about it."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:11:01",
            "content": "雨の日は特に頭痛ひどくなるの、よくわかります",
            "English": "I completely understand how headaches can get worse on rainy days."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:11:20",
            "content": "相談員さんも痛くなりますか?",
            "English": "Do you get headaches too, counselor?"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:11:33",
            "content": "それは、辛いですね",
            "English": "That sounds really tough."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:11:47",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:12:15",
            "content": "私もたまに雨の日頭痛ありますので",
            "English": "I sometimes get headaches on rainy days myself."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:12:26",
            "content": "そうなんですね",
            "English": "Oh, really?"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:12:29",
            "content": "よくわかります",
            "English": "I can relate."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:12:37",
            "content": "どう過ごしてますか?",
            "English": "How do you deal with them?"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:13:15",
            "content": "私は、頭痛薬飲んであったかいお茶飲んだり",
            "English": "I take some headache medicine and drink some warm tea."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:13:37",
            "content": "周りに言ったりしますか?",
            "English": "Do you tell people around you?"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:13:56",
            "content": "後は意外と電話したりすると気がまぎれますよ",
            "English": "Also, surprisingly, making a phone call can be a good distraction."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:14:16",
            "content": "私の場合は言いますね",
            "English": "In my case, I do tell others."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:15:03",
            "content": "きっと雨のせいだって言われたりもします。",
            "English": "Sometimes they just say, \"It's probably because of the rain.\""
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:15:30",
            "content": "雨のせいですか…",
            "English": "Because of the rain..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:15:53",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:16:20",
            "content": "気圧の変化でなる方も多いみたいで",
            "English": "It seems many people get them due to changes in atmospheric pressure."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:16:51",
            "content": "そうですか…",
            "English": "I see..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:18:04",
            "content": "みさきさんの場合は一番どんな時に頭痛ひどくなりますか❔",
            "English": "In your case, Misaki, when do your headaches get the worst?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:18:43",
            "content": "日によるんですけど、雨の日は特に。",
            "English": "It depends on the day, but especially on rainy days."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:19:15",
            "content": "そうなんですね。",
            "English": "I see."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:19:35",
            "content": "最近は学校行く前とか痛くなるので、時々遅れていったり、休んだりする事もあります。",
            "English": "Lately, they've been hurting before I go to school, so sometimes I'm late or I have to take the day off."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:20:07",
            "content": "お薬は飲んだりしてますか❔大丈夫ですか",
            "English": "Are you taking any medicine? Are you okay?"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:21:23",
            "content": "学校に行くのにも痛くなるのは、とても、辛いですね。",
            "English": "Having pain even before going to school must be very difficult."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:22:53",
            "content": "薬はドラッグストアで買ったりしてます。",
            "English": "I sometimes buy medicine at the drugstore."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:23:10",
            "content": "そうなんですね。",
            "English": "I see."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:23:19",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:23:59",
            "content": "病院に行ったり、親御さんに相談はできてますか",
            "English": "Have you been to a doctor or been able to talk to your parents about it?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:24:28",
            "content": "うーん(+_+)",
            "English": "Umm..."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:24:45",
            "content": "出来てないです",
            "English": "I haven't been able to."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:24:52",
            "content": "難しいですよね。",
            "English": "It's difficult, isn't it?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:25:04",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:25:38",
            "content": "言いにくいこともありますよね。",
            "English": "Some things are hard to talk about."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:25:43",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:27:00",
            "content": "周りには話しにくいですもんね。",
            "English": "It's hard to talk about it with people around you, right?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:27:14",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:27:30",
            "content": "そうですよね",
            "English": "I understand."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:27:36",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:28:32",
            "content": "みさきさんの頭痛のひどい時の過ごし方は、どうされてますか❔",
            "English": "Misaki, how do you manage when your headaches are severe?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:28:46",
            "content": "寝ます",
            "English": "I sleep."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:28:59",
            "content": "寝るんですね",
            "English": "So you sleep."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:29:09",
            "content": "薬のんだりして、基本休みます",
            "English": "I take medicine and basically just rest."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:29:30",
            "content": "学校でも時々飲みます。",
            "English": "I sometimes take it at school, too."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:29:44",
            "content": "頭痛の時にお薬飲んで休めるならいいですね。",
            "English": "It's good that you can take medicine and rest when you have a headache."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:30:09",
            "content": "はぁ…",
            "English": "Sigh..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:30:15",
            "content": "そうなんですね。",
            "English": "I see."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:30:52",
            "content": "つらそうですね",
            "English": "It sounds tough."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:31:07",
            "content": "学校だと元気にしてないと、先生怖いから。",
            "English": "At school, I have to act like I'm fine, because the teacher is scary."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:31:57",
            "content": "辛い時に無理すると余計に身体に負担が来ますよね",
            "English": "Pushing yourself when you're in pain puts an extra strain on your body, doesn't it?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:32:03",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:32:42",
            "content": "先生が怖いから余計に無理してるんですね",
            "English": "You're pushing yourself even more because the teacher is scary, aren't you?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:32:49",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:33:15",
            "content": "話しやすい先生はいますか❔",
            "English": "Are there any teachers you feel comfortable talking to?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:33:42",
            "content": "うーん(+_+)",
            "English": "Ummm..."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:33:56",
            "content": "思い浮かびません。",
            "English": "No one comes to mind."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:34:09",
            "content": "そうなんですね。",
            "English": "I see."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:34:30",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:34:58",
            "content": "学校以外もまりいないかな❔",
            "English": "How about outside of school?"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:35:23",
            "content": "あまりいないですか",
            "English": "Not really anyone?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:35:31",
            "content": "はい",
            "English": "No, not many."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:35:55",
            "content": "そうなんですね。",
            "English": "I see."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:36:00",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:36:38",
            "content": "7月より前はあまり頭痛はなかったですか❔",
            "English": "Did you have many headaches before July?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:37:00",
            "content": "多分。",
            "English": "Probably not."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:37:11",
            "content": "そうなんですね。",
            "English": "I see."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:37:31",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:37:46",
            "content": "そうなんですね。",
            "English": "I see."
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:38:06",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:38:16",
            "content": "ほかには思い当たる原因はありそうですか",
            "English": "Can you think of any other possible causes?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:39:02",
            "content": "わかりません",
            "English": "I don't know."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:39:33",
            "content": "難しいですもんね。",
            "English": "It's hard to figure out, isn't it?"
        },
        {
            "role": "クライアント",
            "time": "2021/12/09(木) 20:39:49",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/09(木) 20:40:21",
            "content": "頭痛も忘れちゃうくらいの時もありますか❔",
            "English": "Are there times when you can forget about the headaches?"
        },
        {
            "role": "クライアント",
