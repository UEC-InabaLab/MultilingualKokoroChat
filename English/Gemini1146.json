{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:52:31",
            "content": "よろしくお願いします。",
            "English": "Hello, nice to meet you."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:53:51",
            "content": "私はいつ始められても大丈夫です。よろしくお願いします。",
            "English": "I’m ready to start whenever you are. Thank you."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:55:02",
            "content": "こんばんは。",
            "English": "Good evening."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:55:16",
            "content": "よろしくお願いいたします。",
            "English": "Thank you. I look forward to speaking with you."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:55:24",
            "content": "はい。",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:56:02",
            "content": "もう始めてもよろしいでしょうか？",
            "English": "Shall we begin?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:56:10",
            "content": "はいお願いします。",
            "English": "Yes, please."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:56:31",
            "content": "ではお願いいたします。",
            "English": "Okay, let's begin."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:56:43",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:56:45",
            "content": "こんばんは。相談員です。",
            "English": "Good evening. I'm your counselor."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:56:57",
            "content": "こんばんは。",
            "English": "Good evening."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:57:00",
            "content": "今日はどのようなご相談でしょうか？",
            "English": "What would you like to discuss today?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:57:15",
            "content": "私は自分に自信が持てなくて",
            "English": "I lack confidence in myself."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:57:38",
            "content": "はい、そうなのですね。",
            "English": "I see."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:58:11",
            "content": "はじめに性別と年齢をお聞きしてもよろしいでしょうか？",
            "English": "First, may I ask your gender and age?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:58:33",
            "content": "頑張らなきゃいけないといつも思ってしまいます。30代女性です。",
            "English": "I always feel I have to push myself. I’m a woman in my 30s."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:58:59",
            "content": "ありがとうございます。",
            "English": "Thank you."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:59:23",
            "content": "頑張らなきゃいけないと思うときは具体的にどんな時でしょうか？",
            "English": "Could you tell me more specifically about the situations in which you feel you have to push yourself?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:59:40",
            "content": "仕事も家庭も",
            "English": "Both at work and at home."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:00:03",
            "content": "ええ",
            "English": "Uh-huh."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:00:37",
            "content": "お仕事でもご家庭でも、いつも頑張っていらっしゃるのですね。",
            "English": "You're always working hard both at work and at home, aren't you?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:00:55",
            "content": "役に立つ職員で痛いとか、おお母さんでいようとか",
            "English": "Like, I want to be a helpful employee, and I try to be a good mother."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:01:26",
            "content": "無理して躓いてしまうことが多いです。",
            "English": "I often overdo it and end up stumbling."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:01:35",
            "content": "いたいですね。",
            "English": "Yes, I *want* to be."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:01:46",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:01:59",
            "content": "そうなのですね。いつもフルパワーで頑張っていらっしゃる感じなのですなね。",
            "English": "I see. It sounds like you're always running at full power."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:04:03",
            "content": "疲れるのですが、やらなきゃいけないと思うのです。特に特技もないし",
            "English": "It's exhausting, but I feel like I have to do it. I don't have any special skills or anything."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:06:13",
            "content": "gomennnasai,hennkanndekinakunarimasita.soreha,tukaretesimaimasuyone.",
            "English": "I'm sorry, my keyboard isn't converting correctly. That must be exhausting."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:06:38",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:07:55",
            "content": "gokateideha,donnnakotoga komatteimasuka?",
            "English": "What sort of things are you struggling with at home?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:08:52",
            "content": "外食もなく、パンなども手作りです",
            "English": "We don’t eat out, and I even make things like bread from scratch."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:10:18",
            "content": "sounanodesune,tezukuriha,ategakakatteimasuyone",
            "English": "I see, making things from scratch takes a lot of effort, doesn't it?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:11:13",
            "content": "はい。手がかかります。時間も",
            "English": "Yes. It takes a lot of effort. And time, too."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:11:52",
            "content": "soudesuyone.gokazokuha ,nannninn irassyaimasuka?",
            "English": "I can imagine. How many people are in your family?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:12:19",
            "content": "私含めて4人です。",
            "English": "Four, including me."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:13:03",
            "content": "soudesitaka.kazokukouseiwo ,osiete itdakemasuka?",
            "English": "I see. Could you tell me about your family members?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:13:45",
            "content": "夫と娘と息子と私です。",
            "English": "My husband, my daughter, my son, and me."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:14:28",
            "content": "sounanodesumne.okosannha ,oikutudesyouka?",
            "English": "I see. How old are your children?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:15:06",
            "content": "小学生です。高学年です。",
            "English": "They’re in elementary school—the upper grades."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:16:47",
            "content": "sounanodesune.gokateideha,gokateideha,donnnakotogakomatteirassyaimasuka?",
            "English": "I see. At home, what sort of things are you struggling with?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:18:01",
            "content": "頑張ろうと思うので疲れます。",
            "English": "I get tired from trying so hard."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:18:50",
            "content": "gnnbaroutoomouto,sugokutukaretesimaimasuyone.",
            "English": "Trying so hard must be incredibly tiring."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:19:24",
            "content": "本当は私はずぼらですし、作りたいときにしか作りたくないし、時には外食で楽したい気持ちもありますが…つい頑張ってしまいます。",
            "English": "To be honest, I'm naturally a bit lazy, and I only want to cook when I feel like it. Sometimes I wish we could just eat out and take it easy... but I just end up pushing myself to do it."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:20:29",
            "content": "sorekurai,tedukuride,gannbatteirassyarunodesune.",
            "English": "It sounds like you are working that hard, making everything from scratch."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:21:14",
            "content": "kyuujitunadoha,odekadesitatokihaikagadesuka?",
            "English": "What about on your days off, when you go out?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:21:17",
            "content": "はい。",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:23:18",
            "content": "dannnasannha,fudannha,osyokujinokotonitaisite,nanikaiwaeteimasuka?",
            "English": "Does your husband usually say anything about the meals?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:24:14",
            "content": "わりと時間が一定で出かけるのも、アスレチックやサイクリングなどが多いので夕方には帰り、家庭で食事します。",
            "English": "Our outings are usually at set times, and we often do things like go to adventure playgrounds or go cycling, so we're home by the evening and eat at home."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:25:15",
            "content": "kyuujituha,karadawougokasite,iede osyokujinasarunodesune.",
            "English": "So on your days off, you're physically active and then have your meals at home."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:25:35",
            "content": "何も言いません。仕事自体は好きな仕事なので。",
            "English": "He doesn't say anything. As for my work, I do like the job itself."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:26:07",
            "content": "誰かに",
            "English": "It's not that someone..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:26:20",
            "content": "hai",
            "English": "Yes."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:27:00",
            "content": "何か言われるというのではなく、自分が頑張りすぎているのです。家族は好きでやっていると思っていると思います。",
            "English": "It's not that anyone says anything to me; it's that I'm pushing myself too hard. I think my family just thinks I enjoy doing it."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:27:32",
            "content": "soudesitaka.",
            "English": "I see."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:28:29",
            "content": "ottosannto,gaisyokunokotonituiite,hanasitakotohaarimasuka?",
            "English": "Have you ever spoken with your husband about eating out?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:30:32",
            "content": "子どもも、夫も家庭の食事で満足しているので何も言いません。外で食べる？と聞くと、庭に椅子を持っていこうとするくらい、外食という習慣はないです。",
            "English": "My children and my husband are satisfied with home-cooked meals, so they don't say anything. If I ask, 'Should we eat outside?', they'll try to bring chairs out into the yard. We just don't have the habit of eating out."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:31:48",
            "content": "soreha,asa,ihiru,banntohitoride,gannbatteirassyaimasune.",
            "English": "That means you're working hard all by yourself for breakfast, lunch, and dinner."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:32:22",
            "content": "dzennzujibunndeyaranakerebaikenainoha",
            "English": "Having to do everything by yourself all the time—"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:32:33",
            "content": "sinndoidesuyone",
            "English": "—is tough, isn’t it."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:33:42",
            "content": "そうですね。特別手の込んだものは作りませんが、自分でもよく作るなあと思います。",
            "English": "That's right. I don't make anything particularly elaborate, but even I think I cook a lot."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:34:44",
            "content": "家族に共感してほしいとかではなく、がんばる自分を解放したいのです。",
            "English": "It's not that I want my family to sympathize with me; I just want to free myself from this need to always try so hard."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:34:52",
            "content": "syufuha,oyasumiganaidesukara,tukaretesimaukotomoarimasuyone",
            "English": "Being a homemaker means you don't get any days off, so it's understandable that you get tired."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:35:34",
            "content": "疲れますね。",
            "English": "It is tiring."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:36:22",
            "content": "gohannwotukuritudeketeirukotoha,taihennnakotodatoomimasu",
            "English": "Continuing to cook meals every day is a very demanding task."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:37:11",
            "content": "gokateiigaideha,otohadonnnakotodeganbatteirassyaimasuka?",
            "English": "Outside the home, in what ways do you find yourself pushing yourself?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:38:37",
            "content": "仕事も他の人が動こうとすると、私がやるよと言ってしまったり・・・です。",
            "English": "At work, when someone else is about to do something, I end up saying, \"I’ll do it.\""
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:39:40",
            "content": "sorehakakaekomisugirutotukaretesimaimasuyone",
            "English": "Taking on too much like that must be exhausting."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:40:17",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:40:59",
            "content": "imamadenoohanasiwo okikisite,ohanasiwomatomesaseteitadaitemoyorosiidesyouka?",
            "English": "Based on what you've told me so far, would it be alright if I summarized our conversation?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:41:22",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:42:09",
            "content": "anataha,gokatei,syokubadeitumogannbaranakerebaikenaitoomotteirassyaimasu",
            "English": "You feel you must always work hard, both at home and at work."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:43:08",
            "content": "oosigotomosinagara,mainiti,tedukurinosyokujiwotukuttari,",
            "English": "While also working, you make homemade meals every day,"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:43:53",
            "content": "syokubademo,hokanokatanosigotowotetudattarisiteimasu",
            "English": "and at your workplace, you help other people with their tasks."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:45:05",
            "content": "soredemo,gojibunnhazuboradeari,gaisyokuwositerakusitaina,toomotteirassyaimasune.",
            "English": "Despite all that, you see yourself as lazy and wish you could take it easy and eat out sometimes."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:46:03",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:46:28",
            "content": "sositegannbarisugirugojibunnwokaihousitaitoomottairrasyaimasu",
            "English": "And you want to free yourself from this pattern of overexerting yourself."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:47:28",
            "content": "はいでも自分に自信が持てないのでつい頑張ろうとします。",
            "English": "Yes, but because I lack confidence in myself, I end up pushing myself."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:49:01",
            "content": "gojibunnnijisinngamotenaitoomowareteirunodesune",
            "English": "So you feel you don’t have confidence in yourself."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:49:36",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:50:12",
            "content": "imamadenoohanasiwookikisitewatasinoomottakotowootutaesitemoyososiidesyouka?",
            "English": "May I share what I’ve been thinking as I’ve listened to you?"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:50:28",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:51:30",
            "content": "anataha,osigoto,gokateidetotemoyokuganbatteirassyarutoomoimasu",
            "English": "I think you are working incredibly hard, both at your job and at home."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:53:12",
            "content": "gokazokunosyokujiwomainititukurunomotedukurideaijyoukomottaoryouriwotukurareteimasune",
            "English": "You make meals for your family every day from scratch, creating dishes filled with love."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:54:27",
            "content": "syokubadeha,hokanokatawokidukaiokoekakedekirunomokigakiku,yasasiikatananodatoomoimasu",
            "English": "At work, you are considerate of others and offer your help, which tells me you are a very attentive and kind person."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:56:39",
            "content": "gokazokuniaijyouwososoidmainiti,oryouriwotukurunomohahaoyatositegokazokuwoomottanokotodatoomoimasita",
            "English": "Pouring love into your family and making meals every day shows me how much you care for them as a mother."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:58:33",
            "content": "ippoudeosigoto,syokujidukuritoisogasiinaka,tukarenagaramomainitigannbatteirassyarukotohasugoikotodatoomoimasu",
            "English": "At the same time, continuing to work hard every day while busy with your job and cooking, even when tired, is truly admirable."
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:59:17",
            "content": "はい。頑張っています。それにつかれています。",
            "English": "Yes. I am working hard, and I’m tired from it."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:59:30",
            "content": "soudesuyone",
            "English": "I can understand that."
        },
        {
