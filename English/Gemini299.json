{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 17:59:31",
            "content": "本日はよろしくお願いいたします。",
            "English": "Thank you for seeing me today."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:00:13",
            "content": "初めまして。よろしくお願いいたします。",
            "English": "It's nice to meet you. Thank you for coming."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:00:21",
            "content": "お願いいたします。",
            "English": "Thank you."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:01:00",
            "content": "では始めてもよろしいでしょうか？",
            "English": "Shall we begin then?"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:01:09",
            "content": "お願いいたします。",
            "English": "Yes, please."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:01:51",
            "content": "相談ありがとうございます。始めに年齢と性別、相談内容を教えてもらえますか？",
            "English": "Thank you for reaching out. To start, could you tell me your age, gender, and what you’d like to discuss?"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:01:59",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:02:31",
            "content": "30代 女です",
            "English": "I'm a woman in my 30s."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:02:39",
            "content": "相談内容は",
            "English": "As for what I’d like to discuss…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:02:46",
            "content": "はい。",
            "English": "Alright."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:03:11",
            "content": "友人とのトラブルというか",
            "English": "It's about some trouble with a friend, or rather..."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:03:24",
            "content": "ケンカをしてしまい",
            "English": "we ended up having a fight,"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:03:46",
            "content": "女の友人です",
            "English": "It's a female friend."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:04:06",
            "content": "仲直りしたいのですが",
            "English": "I’d like to make up with her,"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:04:24",
            "content": "どうしたら良いのか",
            "English": "but I’m not sure what to do."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:04:29",
            "content": "はい。",
            "English": "I see."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:04:51",
            "content": "色々考えてしまい",
            "English": "I keep overthinking it,"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:05:05",
            "content": "混乱しています",
            "English": "and I’m feeling confused."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:05:49",
            "content": "そうだったのですね。",
            "English": "I see, that must be difficult."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:05:55",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:06:13",
            "content": "ご友人とのトラブルで困ってらっしゃるのですね。",
            "English": "So you’re having a hard time because of a conflict with your friend."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:06:23",
            "content": "はいそうです",
            "English": "Yes, that’s right."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:07:12",
            "content": "その状況について、もう少し詳しくお話していただけますか？",
            "English": "Could you tell me a bit more about the situation?"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:07:39",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:08:40",
            "content": "先月中旬頃 数名の友人とオンラインで飲んでいました",
            "English": "Around the middle of last month, I was having online drinks with a few friends."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:08:48",
            "content": "そのときに",
            "English": "At that time..."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:08:50",
            "content": "はい",
            "English": "Okay."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:09:25",
            "content": "友人が気分を害してしまい",
            "English": "one of my friends took offense,"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:10:06",
            "content": "雰囲気を壊してしまい",
            "English": "and it ruined the atmosphere,"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:10:43",
            "content": "フォローできずに終わってしまいました",
            "English": "and I wasn't able to smooth things over, so it just ended like that."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:12:05",
            "content": "あなたはご友人をかばうことができなかったことに対して、後悔されているのですね",
            "English": "So you regret that you weren't able to support your friend in that moment."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:12:16",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:12:42",
            "content": "その時、どんな風に感じたのですか？",
            "English": "How did you feel at that moment?"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:13:11",
            "content": "それは",
            "English": "Do you mean,"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:13:32",
            "content": "友人の態度に対してでしょうか？",
            "English": "how I felt about my friend's attitude?"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:14:30",
            "content": "態度も含めて、その場にいた時のあなたのお気持ちを聞かせていただけますか？",
            "English": "Including her attitude, could you share how you felt being there in that moment?"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:15:49",
            "content": "そんなに気になることかな？ということに強く反応して",
            "English": "She reacted strongly to something that I thought wasn’t such a big deal,"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:16:13",
            "content": "今までそんな感じの子ではなかったのですが",
            "English": "and she’d never been like that before."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:16:33",
            "content": "そのような態度を見たのは初めてだったのですね",
            "English": "So that was the first time you'd seen her act that way."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:16:48",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:17:12",
            "content": "それは、あなたもどうすれば良いか戸惑ってしまいますよね",
            "English": "I can see how that would leave you feeling confused about what to do."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:17:23",
            "content": "そうですね",
            "English": "Yes, it did."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:18:08",
            "content": "それは思い悩んでしまいますね",
            "English": "That would weigh on your mind."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:18:17",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:18:36",
            "content": "先ほど、仲直りしてたいとおっしゃっておりましたが",
            "English": "Earlier, you mentioned wanting to make up with her."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:18:44",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:19:11",
            "content": "ご友人の方はあなたに対しても嫌な思いをされていると感じてらっしゃるのですか？",
            "English": "Do you feel that your friend is also upset with you?"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:19:56",
            "content": "友人が気分を害した原因は",
            "English": "The reason my friend got offended..."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:20:04",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:20:11",
            "content": "他の友人のことだったのですが",
            "English": "was about something another friend did,"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:20:51",
            "content": "あなたではないのですね",
            "English": "So it wasn’t about you."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:21:01",
            "content": "はい",
            "English": "That’s right."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:21:33",
            "content": "でも一緒になって と思われたと思います",
            "English": "But I think she felt like I was ganging up on her with the others."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:22:04",
            "content": "つい笑ってしまい",
            "English": "I couldn't help but laugh,"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:22:31",
            "content": "ご友人の方はみんなに言われたように感じてらっしゃると思われているのですね",
            "English": "So you think she felt as if everyone was piling on."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:22:40",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:22:58",
            "content": "友人のことを笑ったわけではなく",
            "English": "It's not that I was laughing at my friend,"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:23:03",
            "content": "はい",
            "English": "I understand."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:23:30",
            "content": "話をしている表情だとか",
            "English": "it was the expression on the other friend's face while she was talking..."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:23:59",
            "content": "怒らせた友人のですね",
            "English": "The one who upset her, I mean."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:24:06",
            "content": "はい",
            "English": "Right."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:24:28",
            "content": "話の内容がおかしくて笑ってしまい",
            "English": "The content of the conversation was funny, so I laughed,"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:24:38",
            "content": "傷つけてしまいました",
            "English": "and I ended up hurting her feelings."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:24:48",
            "content": "悪気はなかったです",
            "English": "I didn’t mean any harm."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:25:41",
            "content": "そうだったんですね。ご友人の方はどこで傷つかれたと思うのでしょうか？",
            "English": "I see. What part do you think hurt your friend's feelings?"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:26:03",
            "content": "そうですね",
            "English": "Let me see…"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:27:41",
            "content": "体型と恋愛のこと",
            "English": "About her body shape and her love life."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:27:50",
            "content": "以前からぽっちゃり体型で",
            "English": "She's always been a bit chubby,"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:27:55",
            "content": "はい",
            "English": "I see."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:28:48",
            "content": "自分から私こんなんだからとか自虐的に話していて",
            "English": "and she often makes self-deprecating remarks like, “This is just who I am.”"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:29:19",
            "content": "いつも自虐的なのですか？",
            "English": "Is she always self-deprecating?"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:29:34",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:30:06",
            "content": "冗談だったかもしれませんが",
            "English": "She might have been joking, but..."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:30:24",
            "content": "飲みの会でしたし、盛り上がってしまいますよね",
            "English": "It was a drinking party, so it's easy to get carried away."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:30:25",
            "content": "可愛くてモテるとは思います",
            "English": "I think she's cute and popular with guys."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:30:31",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:30:37",
            "content": "そうなのですね",
            "English": "I see."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:31:47",
            "content": "でもその友人が好きだった人と",
            "English": "But the person she liked..."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:32:28",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:32:30",
            "content": "怒らせちゃった人が付き合っていると分かりまして",
            "English": "it turned out that the friend who upset her is now dating him."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:33:21",
            "content": "気分が悪くなったのだと思います",
            "English": "I think that's why she got upset."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:33:29",
            "content": "なるほど、、、",
            "English": "I see..."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:33:50",
            "content": "怒らせちゃった人は友人が好きだったことは知らないです",
            "English": "The friend who upset her doesn't know she had a crush on him."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:34:05",
            "content": "ご友人はショックだったんでしょうね",
            "English": "Your friend must have been shocked."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:34:21",
            "content": "だと思います",
            "English": "I think so."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:34:44",
            "content": "悪気はないし、それは困りますね、、、",
            "English": "There was no ill intent, but that does make it a difficult situation."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:34:56",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:35:24",
            "content": "でも怒っちゃった友人の気持ちも今はわかります",
            "English": "But now I can understand how my upset friend felt."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:35:50",
            "content": "その時は雰囲気で笑ってしまったけど、",
            "English": "At the time, you laughed along with the mood, but..."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:35:57",
            "content": "はい",
            "English": "Yes,"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:36:23",
            "content": "今冷静になって考えてみると、見えてくることってありますよね",
            "English": "now that you've had time to think about it calmly, you see things differently."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:36:32",
            "content": "そうですね",
            "English": "That’s true."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:37:14",
            "content": "飲み会の日以来、その子とは連絡は取っていないんですか？",
            "English": "Have you been in contact with her since the day of the party?"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:37:24",
            "content": "はい",
            "English": "No, I haven't."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:37:34",
            "content": "連絡しても",
            "English": "Even when I reach out,"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:38:02",
            "content": "返答なしです",
            "English": "there’s no reply."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:38:12",
            "content": "そうでしたか、、、",
            "English": "I see…"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:38:17",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:38:18",
            "content": "心配ですね、、、",
            "English": "That must be worrying."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:38:23",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:38:33",
            "content": "どのように送ったのですか？",
            "English": "What did you say in your message?"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:38:56",
            "content": "電話は出てくれなかったので",
            "English": "She didn't answer my call, so..."
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:39:12",
            "content": "はい",
            "English": "Okay."
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:39:42",
            "content": "話そうよといった内容で",
            "English": "I sent a message saying something like, “Let's talk.”"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:39:50",
            "content": "文で送るより",
            "English": "Rather than sending it in writing,"
        },
        {
            "role": "クライアント",
