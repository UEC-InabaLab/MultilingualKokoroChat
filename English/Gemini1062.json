{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:56:06",
            "content": "こんにちは、相談員です。ご相談にお越しくださりありがとうございます。",
            "English": "Hello, I'm the counselor. Thank you for coming in today."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:56:17",
            "content": "こんにちは",
            "English": "Hello."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:56:23",
            "content": "今日はどのようなご相談でしょうか？",
            "English": "What would you like to talk about today?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:56:54",
            "content": "恋愛相談なのですが",
            "English": "It's about a romantic issue..."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:56:58",
            "content": "いいですか？",
            "English": "Is that okay?"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:57:20",
            "content": "はい、大丈夫ですよ。",
            "English": "Yes, of course."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:57:47",
            "content": "どういったことなのか、お聞かせいただけますか…",
            "English": "Could you tell me a little more about it?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:57:48",
            "content": "好きな人がいるんです",
            "English": "There's someone I like."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:57:58",
            "content": "はい",
            "English": "I see."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:58:13",
            "content": "告白しなきゃと",
            "English": "I feel like I have to confess my feelings,"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:58:22",
            "content": "思うんですけど",
            "English": "but..."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:58:33",
            "content": "できなくて、どうしたらいいですか？",
            "English": "I can't do it. What should I do?"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:58:33",
            "content": "はい",
            "English": "I understand."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:59:08",
            "content": "そうなんですね…勇気がいりますよね…",
            "English": "I understand... That takes a lot of courage, doesn't it?"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:59:57",
            "content": "お力になれればと思います。まずは、あなたのことから教えていただけますか？",
            "English": "I hope I can help. First, could you tell me a little about yourself?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:00:33",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:00:49",
            "content": "年齢、性別とか教えていただけますか…",
            "English": "Could you tell me your age and gender?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:01:26",
            "content": "13歳",
            "English": "I'm 13 years old."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:01:34",
            "content": "女子",
            "English": "Female."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:01:54",
            "content": "教えてくれてありがとう。",
            "English": "Thank you for sharing that."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:02:25",
            "content": "好きな人は、どんな人なんですか…",
            "English": "What is he like?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:02:56",
            "content": "塾が同じなんです",
            "English": "We go to the same cram school."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:05:45",
            "content": "そうなんですね…ちなみに、あなたが告白できないって思うのは、どんな理由からなのか教えてもらえますか？",
            "English": "I see... By the way, could you share what makes it hard for you to confess?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:06:05",
            "content": "とても恥ずかしくて",
            "English": "I'm so embarrassed,"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:06:10",
            "content": "言えないです",
            "English": "I just can't say it."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:07:00",
            "content": "うんうん、そう思うのも自然な気持ちですよね…",
            "English": "Mm-hmm, it's completely natural to feel that way."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:07:16",
            "content": "そうなんです",
            "English": "Yes, it is."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:07:30",
            "content": "どうしたらいいですか？",
            "English": "What should I do?"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:09:42",
            "content": "うんうん、悩むと思います。",
            "English": "Mm-hm, it's understandable to struggle with that."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:09:47",
            "content": "あなたが今日ここに来られたのは、どうしたら告白できる勇気をもてるのか、知りたいという理解で合っていますか？",
            "English": "Am I understanding correctly that you came today to explore how you can find the courage to tell him how you feel?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:09:59",
            "content": "そうです",
            "English": "Yes, that's right."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:11:03",
            "content": "そうか…一緒に考えていきましょうね",
            "English": "I see... Let's think it through together."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:11:14",
            "content": "はい",
            "English": "Okay."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:12:18",
            "content": "さっき、恥ずかしいって言っていたけど、どんなことからそんな風に感じるのか、教えてもらえますか？",
            "English": "You mentioned feeling embarrassed earlier. Could you tell me what makes you feel that way?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:13:15",
            "content": "彼が思わせぶりなことするし",
            "English": "Well, he does things that seem like he's leading me on,"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:13:28",
            "content": "うんうん",
            "English": "Mm-hmm."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:14:12",
            "content": "びっくりします。どうしたらいいか",
            "English": "It surprises me, and I don't know what to do."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:14:49",
            "content": "そうか…思わせぶりというと、どんなことなのかしら…",
            "English": "I see... When you say he leads you on, what kind of things does he do?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:15:40",
            "content": "おまえかわいいなとか",
            "English": "He says things like, 'You're cute,'"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:15:49",
            "content": "キスするぞとか",
            "English": "'I'm gonna kiss you,'"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:16:25",
            "content": "隣に座ってきたり",
            "English": "and he'll come and sit next to me."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:17:50",
            "content": "うん、そうなんですね…驚いちゃうよね…",
            "English": "Mm-hmm, I see... That would be surprising, wouldn't it?"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:17:54",
            "content": "彼からそんな風にされて、あなたはどう思ったりするのか、教えてもらえますか？",
            "English": "When he does those things, how do you feel?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:18:02",
            "content": "恥ずかしくて",
            "English": "I get embarrassed,"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:18:08",
            "content": "そうなんです",
            "English": "yeah."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:18:47",
            "content": "赤くなっているかもと心配です",
            "English": "I worry I might be blushing."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:19:25",
            "content": "それを、彼に見られたくない、って感じなのかしら…",
            "English": "And you feel like you don't want him to see that?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:20:36",
            "content": "見らたらどうしよう",
            "English": "What if he sees me?"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:21:19",
            "content": "うんうん、そう思うと心配になったりするんですね…",
            "English": "Mm-hmm, so thinking about that makes you anxious."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:22:10",
            "content": "今日こうしてお話しして、相談者の感じたことをお伝えしてもいいですか…",
            "English": "As we've talked today, may I share what I've sensed?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:22:23",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:23:40",
            "content": "お話をうかがっていると、私には、相手の子はあなたに好意があるように感じるんですが、",
            "English": "From what you've told me, it sounds to me like he has feelings for you,"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:23:52",
            "content": "あなたはどう思われますか？",
            "English": "What do you think?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:24:17",
            "content": "周りにもラブラブだと言われます",
            "English": "People around us say we're lovey-dovey too."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:24:54",
            "content": "うん、そんな風に感じましたよ。",
            "English": "Yes, that's the impression I got."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:25:05",
            "content": "ありがとうございます",
            "English": "Thank you."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:25:34",
            "content": "告白しなきゃって、あなたが思っているのは、どんな理由からなのかしら…",
            "English": "You mentioned you feel you have to confess. Could you tell me why you feel that way?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:26:23",
            "content": "彼と帰り道が一緒の",
            "English": "He and my childhood friend,"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:26:33",
            "content": "私の幼なじみと",
            "English": "who walks home with him,"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:26:39",
            "content": "彼が最近",
            "English": "have been getting really close"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:26:45",
            "content": "仲がいいんです",
            "English": "lately."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:27:06",
            "content": "うわぁ…それは不安になるよね…",
            "English": "Oh... that would make you feel anxious, wouldn't it?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:27:18",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:27:39",
            "content": "とられちゃうんじゃないかって、心配になりますよね…",
            "English": "You worry she might steal him away, don't you?"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:27:50",
            "content": "はい",
            "English": "Yes."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:28:08",
            "content": "どうしたら",
            "English": "What should I do..."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:28:38",
            "content": "そうか…だからちゃんと告白して、自分が彼女だって認識したいんだよね…",
            "English": "I see... So that's why you want to properly confess, to establish yourself as his girlfriend."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:31:45",
            "content": "お時間になりましたので、ここで終了させていただきます。今日は、ありがとうございました。",
            "English": "It looks like our time is up for today, so we'll have to stop here. Thank you for coming in today."
        }
    ],
