{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 11:56:09",
            "content": "https://line.me/R/ti/p/%40208umcjj",
            "Chinese": "https://line.me/R/ti/p/%40208umcjj"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 11:57:45",
            "content": "こんにちわ相談員です。",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 11:58:16",
            "content": "こんにちは。宜しくお願いします。",
            "Chinese": "您好，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 11:58:23",
            "content": "宜しくお願いします！",
            "Chinese": "也请您多关照！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 11:58:45",
            "content": "今日はどんなご相談でいらっしゃいましたか？",
            "Chinese": "您今天想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 11:58:50",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 11:59:08",
            "content": "くだらない内容かも知れないのですが、、",
            "Chinese": "可能不是什么大事……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 11:59:16",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 11:59:18",
            "content": "聞いていただけますか？",
            "Chinese": "您愿意听我说吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 11:59:29",
            "content": "はい、どうぞ！",
            "Chinese": "好的，请讲！"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 11:59:45",
            "content": "職場の人間関係のことなんですが、",
            "Chinese": "是关于职场人际关系的……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 11:59:54",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:00:23",
            "content": "小さな家族的会社でお米を全国に発送している事務をしています。",
            "Chinese": "我在一家小型的家族式公司做文员，负责向全国邮寄大米。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:00:33",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:00:59",
            "content": "社長の他に奥様と社長のお母さんと",
            "Chinese": "除了社长，还有他的夫人和母亲，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:01:06",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:01:29",
            "content": "私と他にスタッフが３人でやっているのですが、",
            "Chinese": "再加上我和另外3名员工一起工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:01:41",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:02:07",
            "content": "最近、入った女性の新人さんが",
            "Chinese": "最近新来的那位女同事，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:02:16",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:02:26",
            "content": "はじめは明るくて人当たりもよかったのですが、",
            "Chinese": "起初性格开朗、待人也很好，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:02:33",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:02:44",
            "content": "入って三ヶ月過ぎたあたりから",
            "Chinese": "但进来三个月以后开始，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:02:50",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:03:12",
            "content": "先輩である私の悪口を言いふらしているようなんです。",
            "Chinese": "她好像在到处说我这个前辈的坏话。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:03:29",
            "content": "ええーー、そうなんですか",
            "Chinese": "啊——是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:03:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:03:54",
            "content": "あっ、すいません、続けてください",
            "Chinese": "啊，抱歉，请您继续。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:04:01",
            "content": "会社は家族経営的な感じなんですが",
            "Chinese": "公司有点像家族式经营，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:04:12",
            "content": "社長の奥様が少し",
            "Chinese": "社长的夫人有点……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:04:20",
            "content": "言いにくいのですが",
            "Chinese": "不太好说，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:04:25",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:04:39",
            "content": "知的障害がすこしある感じで",
            "Chinese": "给人的感觉是有些轻度的智力障碍，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:04:47",
            "content": "なるほどですね",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:05:01",
            "content": "日中もボーっとしていることが多くて、",
            "Chinese": "白天也经常发呆，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:05:06",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:05:31",
            "content": "何をやるにもスローだし、たくさんのことを同時にできないんですね",
            "Chinese": "做什么事都很慢，而且没法同时处理很多事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:05:40",
            "content": "なるほど",
            "Chinese": "我明白。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:06:01",
            "content": "私も最初はあれって？思ったのですが",
            "Chinese": "我一开始也觉得有点奇怪，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:06:08",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:06:27",
            "content": "徐々にこれは疾患のひとつなんだなぁーと",
            "Chinese": "逐渐意识到这应该是一种障碍，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:06:36",
            "content": "なるほど",
            "Chinese": "明白。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:06:43",
            "content": "本人は全く悪気はなくて",
            "Chinese": "她本人完全没有恶意，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:06:48",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:07:00",
            "content": "社長もすごく良い人柄なんです",
            "Chinese": "社长人也特别好，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:07:09",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:07:35",
            "content": "知的障害を軽度に持っていることを承知で結婚されたようです。",
            "Chinese": "他似乎是在知道对方有轻度智力障碍的情况下结的婚。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:07:45",
            "content": "なるほどですね",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:08:14",
            "content": "その新人が",
            "Chinese": "但那位新人"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:08:19",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:08:37",
            "content": "その奥様の何というか、、、",
            "Chinese": "对那位夫人，怎么说呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:08:46",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:08:53",
            "content": "仕事をサボっているとか",
            "Chinese": "说她工作偷懒之类的，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:09:08",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:09:19",
            "content": "奥様に対して非難めいた言動が多くなり",
            "Chinese": "对夫人的指责言行越来越多了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:09:31",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:09:41",
            "content": "こっちは忙しいのになんにもしないとか",
            "Chinese": "说什么“我们这么忙，她却什么都不干”，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:09:59",
            "content": "私に苦情を言ってくるようになったんですね",
            "Chinese": "还开始向我抱怨。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:10:09",
            "content": "なるほど",
            "Chinese": "我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:10:31",
            "content": "私はもともと人の悪口を言うのは好きではなく",
            "Chinese": "我本来就不喜欢说别人的坏话，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:10:37",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:10:51",
            "content": "まして知的障害があることを承知で",
            "Chinese": "更何况我也清楚她有智力障碍，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:10:59",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:11:20",
            "content": "家族経営上社員として配置されている事情もわかっていたので",
            "Chinese": "也明白在家族企业里，把她安排成员工是有原因的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:11:31",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:11:42",
            "content": "その新人によくわかるように何度も説明したんですが",
            "Chinese": "所以我也多次向那位新人解释得清清楚楚，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:11:53",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:12:03",
            "content": "最初はあー、そうなんですねーと聞いていたのですが",
            "Chinese": "她一开始还听着，说‘啊，是这样啊’，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:12:32",
            "content": "そのうちに奥様の悪口を私に毎日言ってくるようになり",
            "Chinese": "但不久就又开始每天对我说夫人的坏话，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:12:40",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:12:55",
            "content": "私は本人はそれは生まれもったものだから",
            "Chinese": "我跟她说那是天生的，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:13:27",
            "content": "仕方ないことなんだよといくら言ってもエスカレートしてきて",
            "Chinese": "不管我怎么说‘这是没办法的事’，她反而变本加厉。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:13:33",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:13:47",
            "content": "最近では",
            "Chinese": "最近甚至，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:13:53",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:14:23",
            "content": "他の男性のスタッフに私の悪口まで言うようになってきてしまい、、、",
            "Chinese": "她甚至开始跟其他男同事说我的坏话了……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:14:34",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:14:55",
            "content": "ほとほと会社に行くのが嫌になってしまい、、",
            "Chinese": "搞得我实在是不想去公司了……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:15:03",
            "content": "はい",
            "Chinese": "我明白。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:15:25",
            "content": "この先どのように気持ちを整理したらいいのか？",
            "Chinese": "我不知道接下来该怎么调整自己的心情？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:15:51",
            "content": "どうしたらいいでしょうか？相談に乗ってもらえますか？",
            "Chinese": "我该怎么办才好呢？能和您谈谈吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:15:51",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:16:16",
            "content": "はい、、いろいろお話頂き有難うございます",
            "Chinese": "好的……非常感谢您跟我说了这么多。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:16:21",
            "content": "まずは、、",
            "Chinese": "首先……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:16:29",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:16:37",
            "content": "最初にくだらない話しとおっしゃってましたが、、",
            "Chinese": "您一开始说可能不是什么大事，但是……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:16:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:16:53",
            "content": "全然くだらないことではなく、",
            "Chinese": "这完全不是小事，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:17:06",
            "content": "はい、、、",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:17:15",
            "content": "お仕事の、職場の大切な問題ですよね、",
            "Chinese": "是工作上、职场中很重要的问题，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:17:55",
            "content": "そうなんです。最近は夜もあんまり眠れない感じで、、、",
            "Chinese": "是的。最近晚上也总是睡不太好……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:18:01",
            "content": "いろいろと悩まれてるのが分かりました、問題も何点かあり、気苦労されてますよね",
            "Chinese": "我明白您有很多烦恼，问题也有好几个方面，确实让您很操心吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:18:21",
            "content": "そうなんですよね。それ以外にも",
            "Chinese": "是啊。除此之外还有……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:18:22",
            "content": "そうですか、それほど不安を感じてるんですね",
            "Chinese": "是吗，看来您感到非常不安呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:18:27",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:18:30",
            "content": "あっ、はい、どうぞ",
            "Chinese": "啊，好的，您请说。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:19:29",
            "content": "その彼女はお米を発送する際の送付状とかも雑に貼るんですね。いくら注意しても直さないんです。",
            "Chinese": "她在寄大米的时候，运单之类的也贴得很潦草。我提醒她好几次了，她就是不改。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:19:40",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:20:08",
            "content": "そうなんですね、そういった事でも不満をお持ちなんですね",
            "Chinese": "是这样啊，您对这些事也感到不满呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:20:25",
            "content": "はい。受け取ったお客様が嫌な感じを持ってしまうので、私は丁寧な貼るように指導するのですが、",
            "Chinese": "是的。因为客户收到后会感到不悦，所以我指导她要贴得仔细一些，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:20:33",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:20:55",
            "content": "人当たりは悪くないのですが、仕事が雑なんですね。",
            "Chinese": "她待人接物还不错，就是工作太马虎了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:21:10",
            "content": "なるほど、、厄介ですねー",
            "Chinese": "原来如此……确实挺棘手的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:21:20",
            "content": "そうなんです、、、",
            "Chinese": "就是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:21:44",
            "content": "毎日毎日、大変な思いをされてるのが目に浮かびます",
            "Chinese": "我能想象得到您每天都过得很辛苦。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:22:03",
            "content": "ほんとうですか。ありがとうございます。",
            "Chinese": "真的吗？谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:22:08",
            "content": "先ほど、",
            "Chinese": "刚才，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:22:12",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:22:35",
            "content": "寝れてないとのことでしたが、そこはそんな状況でしょうか？",
            "Chinese": "您提到睡不好，具体是什么情况呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:22:45",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:22:54",
            "content": "うちに帰っても",
            "Chinese": "回到家也"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:23:06",
            "content": "気分がもやもやして、",
            "Chinese": "心情很烦闷，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:23:10",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:23:31",
            "content": "夜もなかなか寝付けない感じで眠りも浅い感じなんです。",
            "Chinese": "晚上也很难入睡，睡得也很浅。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:23:58",
            "content": "なるほど、、睡眠は大切なので、心配ですね。",
            "Chinese": "我明白……睡眠很重要，这确实令人担心。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:24:15",
            "content": "何時間くらい寝れてますか？",
            "Chinese": "您大概能睡几个小时呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:24:36",
            "content": "はい。大体5時間程度だと思います。",
            "Chinese": "嗯，大概5个小时左右吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:24:52",
            "content": "それは少ないですね、、",
            "Chinese": "那太少了呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:25:03",
            "content": "あさも疲れが抜けない感じで。",
            "Chinese": "早上起来也感觉没消除疲劳。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:25:13",
            "content": "そうですよね、、",
            "Chinese": "是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:25:26",
            "content": "疲れが取れない感じですよね",
            "Chinese": "总觉得疲惫消不掉，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:25:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:25:56",
            "content": "今までせっかく頑張ってきた仕事を辞めたくはないんです。",
            "Chinese": "我并不想辞掉这份好不容易坚持下来的工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:26:21",
            "content": "はい、なるほど、、そうお考えなのですね",
            "Chinese": "嗯，原来如此……您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:26:33",
            "content": "はいしかし、、、",
            "Chinese": "是的，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:26:38",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:27:00",
            "content": "この職場は三年目になるのですが。",
            "Chinese": "我在这家公司已经第三年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:27:06",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:27:54",
            "content": "前の職場でもやはり周りに悪口を言う女性スタッフがいて精神的にまいって辞めたんですね、、、",
            "Chinese": "在之前的工作里也有喜欢在周围说坏话的女同事，我被折腾得身心俱疲，最后辞职了……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:28:03",
            "content": "なるほど",
            "Chinese": "我明白。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:28:27",
            "content": "だからいまの職場はその新人が入る前はすごくやりやすい職場だったので",
            "Chinese": "所以，现在的职场在那个新人来之前，工作环境非常好，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:28:40",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:29:09",
            "content": "私は人の悪口を言うのも聞くのも本当に嫌なんです。",
            "Chinese": "我真的很讨厌说别人坏话，也很讨厌听别人说坏话。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:29:32",
            "content": "はい、そうですよね、嫌ですよね",
            "Chinese": "嗯，是啊，很讨厌对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:29:38",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:30:07",
            "content": "ちなみに、、",
            "Chinese": "顺便问一下……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:30:23",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:30:30",
            "content": "新人さんが入ってくる前はどんな感じの職場だったのでしょうか？",
            "Chinese": "在新同事来之前，职场的氛围是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:31:05",
            "content": "みんなほんわかして和気藹々としてました。",
            "Chinese": "大家都很温和，气氛和睦融洽。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:31:26",
            "content": "なるほど、、そんな職場いいでよね",
            "Chinese": "原来如此……那样的职场真好啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:31:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:31:46",
            "content": "であればなおさら、",
            "Chinese": "既然如此，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:32:11",
            "content": "辞めずに、改善できる方法を、一緒に考えてみましょう。",
            "Chinese": "我们更应该一起想想不辞职、而是改善现状的方法。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:32:20",
            "content": "ありがとうございます！",
            "Chinese": "非常感谢！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:32:39",
            "content": "それと、一番気になるのは、睡眠のところですが、、",
            "Chinese": "另外，我最担心的还是您的睡眠问题……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:32:51",
            "content": "はい、、、",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:33:08",
            "content": "病院に行ったりはされてますか？",
            "Chinese": "您有去医院就诊过吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:33:48",
            "content": "いいえ。私は病院があまり好きではなくて。薬とかには頼りたくなんいんですね。",
            "Chinese": "没有。我不太喜欢去医院，也不想依赖药物。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:34:01",
            "content": "なるほど、、わかりました。",
            "Chinese": "原来如此，我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:34:16",
            "content": "本当は",
            "Chinese": "其实，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:34:24",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:35:04",
            "content": "仕事が終わったらオンとオフをうまく切り替えてうちではリラックスしたいんですが、、、なんだか頭から離れなくて",
            "Chinese": "我很想在下班后好好切换工作和休息的状态，在家里放松一下……但不知为何，那些事总是在脑子里挥之不去。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:35:14",
            "content": "どうしたら良いでしょうか？",
            "Chinese": "我该怎么办才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:35:24",
            "content": "なるほど、、そうですよね、切り替えたいですよね",
            "Chinese": "原来如此……是啊，您很想切换状态对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:35:33",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:35:57",
            "content": "私は気にし過ぎなんでしょうか？",
            "Chinese": "是我太在意了吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:36:04",
            "content": "ちなみに、ストレス軽減のための何かに取り組まれたりしてますか？",
            "Chinese": "顺便问一下，您有尝试过什么减压方法吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:37:01",
            "content": "それが前はストレッチ教室に通っていたのですが今、コロナで自粛中で、、、",
            "Chinese": "这个嘛，我以前会去上拉伸课，但现在因为疫情暂停了……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:37:26",
            "content": "なるほど、、コロナ禍ですからね",
            "Chinese": "原来如此……毕竟是疫情期间嘛。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:38:02",
            "content": "そうなんですよね。なんか気分が落ち込むことが多くて、、、",
            "Chinese": "是啊。总觉得心情很低落……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:38:26",
            "content": "本当は、職場離れたら、気持ちを切り替え、五感を使った楽しみができればいいのですが、、",
            "Chinese": "其实，如果离开工作场所后，能转换心情，找一些能调动五感的乐子是最好的，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:38:54",
            "content": "今の状況の中では厳しいですよね",
            "Chinese": "在现在这种情况下很难做到吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:38:54",
            "content": "そうですね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:39:17",
            "content": "ちなみに、ムーさんとお呼びして宜しいでしょうか？",
            "Chinese": "顺便问一下，可以称呼您为“Muu”吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:39:28",
            "content": "はい。ありがとうございます。",
            "Chinese": "好的。谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:40:28",
            "content": "ムーさんは、一番は、何がどうなれば寝れるようになりそうですか？",
            "Chinese": "Muu女士，您觉得最主要的是，什么问题解决了才能睡个好觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:40:53",
            "content": "そうですね、、、",
            "Chinese": "这个嘛……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:41:10",
            "content": "新人さんが",
            "Chinese": "如果那位新人"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:41:16",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:42:07",
            "content": "奥様の悪口を言わないようになりさらに仕事をひとつひとつ丁寧に気持ちを込めてやってもらえたらと願います。",
            "Chinese": "能不再说夫人的坏话，并且能用心把每一项工作都做得细致一些，那就好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:42:34",
            "content": "なるほど、、そこ重要ですよね",
            "Chinese": "原来如此……那点很重要呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:42:42",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:42:57",
            "content": "奥様の悪口が一番引っかかってる感じでしょうか？",
            "Chinese": "感觉说夫人的坏话是您最介意的部分吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:43:08",
            "content": "そうなんです！",
            "Chinese": "没错！"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:43:16",
            "content": "そこです！",
            "Chinese": "就是这点！"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:44:17",
            "content": "自分のまわりには人の悪口を言うような友達はいないから余計に違和感と嫌悪感があります。",
            "Chinese": "我身边的朋友都没有会说别人坏话的人，所以更觉得不舒服和厌恶。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:44:44",
            "content": "ムーさんのお話を聞いてると、そこですよね。",
            "Chinese": "听了Muu女士的话，感觉就是这点呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:44:52",
            "content": "はい！",
            "Chinese": "是的！"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:45:04",
            "content": "よく",
            "Chinese": "经常……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:45:05",
            "content": "人の悪口は聞きたくもないし、言いたくいもない",
            "Chinese": "别人的坏话既不想听，也不想说。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:45:13",
            "content": "そうなんです！",
            "Chinese": "就是这样！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:45:45",
            "content": "悪口って、聞いてる方も、嫌な気分なってきちゃいますよね",
            "Chinese": "说坏话这件事，听的人也会觉得心里很不舒服，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:46:06",
            "content": "たしかに、その通りですよね。",
            "Chinese": "确实，您说得对。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:46:19",
            "content": "ちなみに、悪口なくなれば、寝れそうですか？",
            "Chinese": "顺便问一下，如果没有坏话了，您觉得能睡好吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:46:45",
            "content": "うーん。そうですね。",
            "Chinese": "嗯……是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:47:18",
            "content": "仕事が雑なことよりそちらがひっかかります。",
            "Chinese": "比起工作马虎，这点更让我在意。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:47:27",
            "content": "そうですか、まだ何か気になる事あれば、おしゃってください。",
            "Chinese": "是吗，如果还有其他在意的事情，请告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:48:05",
            "content": "よく他人は変えられないから自分を変えるしかないと言われますが",
            "Chinese": "常言道，改变不了别人就只能改变自己，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:48:59",
            "content": "私の場合どのように自分の気の持ちようを変えたら良いものか？とも考えたりします。",
            "Chinese": "就我这种情况，我也在想该如何调整自己的心态才好？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:49:18",
            "content": "なるほど、、そういった事も悩んでるんですね",
            "Chinese": "原来如此……您也在为这件事烦恼啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:49:27",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:49:44",
            "content": "不安と不満が入り混じってる感じですね",
            "Chinese": "感觉您的不安和不满交织在了一起呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:50:00",
            "content": "そうですね、",
            "Chinese": "是啊，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:50:06",
            "content": "了解しました、少し一緒に考えてみましょう",
            "Chinese": "明白了，我们一起来想一想吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:50:18",
            "content": "すみません、、、",
            "Chinese": "不好意思……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:50:34",
            "content": "ちなみに、これらの事は、誰かに相談されたりしてましたか？",
            "Chinese": "顺便问一下，这些事情，您有和谁商量过吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:51:52",
            "content": "親しい友人にだけは相談しました。そしたらその新人はきっとどこに行っても人の悪口を言う性格なんじゃないかと。だかり気にしないようにと、、、",
            "Chinese": "只和亲近的朋友商量过。朋友说那个新人可能就是那种到哪都会说别人坏话的性格，让我别在意……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:52:19",
            "content": "なるほど、ご友人と相談されてるんですね",
            "Chinese": "原来如此，您和朋友商量过了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:52:41",
            "content": "それで、ムーさんはどう思いましたか？",
            "Chinese": "那Muu女士您听了之后怎么想呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:52:45",
            "content": "はい。てもやっぱり気になってしまって、、",
            "Chinese": "是的。但还是忍不住在意……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:53:15",
            "content": "そうですよね、気にしないようにはすぐにはなれない感じですかね",
            "Chinese": "是啊，想做到不去在意，也不是一下子就能做到的，对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:53:33",
            "content": "一つお聞きしたいのですが、、",
            "Chinese": "我想问一个问题……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:53:38",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:54:06",
            "content": "その新人さんは、なぜ悪口を言うのでしょうか？",
            "Chinese": "您觉得那位新人，为什么会说这些坏话呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:54:22",
            "content": "そうですね、、、",
            "Chinese": "这个嘛……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:54:29",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:55:01",
            "content": "奥様が日中にデスクでうとうとしたりする場面があるんですね、、、",
            "Chinese": "因为夫人白天有时会在办公桌前打瞌睡……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:55:09",
            "content": "なるほど",
            "Chinese": "我明白。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:55:13",
            "content": "私とかまわりのスタッフは",
            "Chinese": "我和周围的同事，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:55:20",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:55:31",
            "content": "それは仕方ないことと割り切っているんです。",
            "Chinese": "都把那当作没办法的事，想开了。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:55:34",
            "content": "しかし、",
            "Chinese": "但是，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:55:38",
            "content": "彼女は",
            "Chinese": "她却"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:56:16",
            "content": "許されない！と、私に奥様を注意してくださいとけしかけるんです。",
            "Chinese": "就说‘这不能容忍！’，然后怂恿我去提醒夫人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:56:26",
            "content": "なるほど",
            "Chinese": "我明白。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:56:29",
            "content": "本来なら",
            "Chinese": "按理说，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:57:32",
            "content": "家族経営上奥様を社員にして様々な経費とかを調整するのはわかるのですが、、、他のスタッフのモチベーションが落ちる部分もあるから",
            "Chinese": "我能理解在家族企业里，让夫人当员工来调整各种经费开销……但这也确实会影响其他员工的积极性，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:57:43",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:58:03",
            "content": "あまり事務所には無理して配置しない方が良いのはみんなわかっているんです。",
            "Chinese": "大家都知道最好不要硬把她安排在办公室。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:58:12",
            "content": "なるほど",
            "Chinese": "明白。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:58:57",
            "content": "私も最初そうでした。だから新人にはこれは仕方ないことなんですよ、、、とよーく説明したのですが、、、",
            "Chinese": "我一开始也是这么想的。所以我很仔细地向新人解释说‘这是没办法的事’……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:59:05",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 12:59:41",
            "content": "奥様を注意しない私にまでとばっちりがきてしまい、、、",
            "Chinese": "结果连我这个不去提醒夫人的人也受到了牵连……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 12:59:56",
            "content": "なるほど",
            "Chinese": "我明白。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:00:31",
            "content": "他の男性スタッフもその新人に仕方ないことだよと教えてくれているのに、、、",
            "Chinese": "明明其他男同事也跟那位新人说“这是没办法的事”……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:00:39",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:01:27",
            "content": "知的障害をお持ちの方は見た目には普通に写るかも知れませんが",
            "Chinese": "有智力障碍的人，外表看起来可能和普通人一样，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:01:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:01:58",
            "content": "悪気があって居眠りとかしている訳ではないんですよね、、、",
            "Chinese": "但他们并不是出于恶意才会打瞌-睡之类的，对吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:02:05",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:02:11",
            "content": "そう思います",
            "Chinese": "我也这么认为。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:02:29",
            "content": "但し、、",
            "Chinese": "但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:02:39",
            "content": "（宜しいでしょうか？）",
            "Chinese": "（我可以说一下我的看法吗？）"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:02:46",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:03:53",
            "content": "新人さんが言ってる事は、健常者であれば、やってはいけない居眠りですよね",
            "Chinese": "新同事说的事情，如果是健康的人，在工作中打瞌-睡确实是不应该的，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:04:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:04:17",
            "content": "周りの男性スタッフさんも新人さんに教えてるようならば、、",
            "Chinese": "如果周围的男同事们也都在跟新人解释的话……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:04:32",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:04:53",
            "content": "本当はこの件は、社長に一度ご相談頂くもの一つかと思いますが、いかがでしょうか？",
            "Chinese": "其实我觉得这件事，和社长商量一下或许是个办法，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:05:11",
            "content": "あっ、なるほど！",
            "Chinese": "啊，原来如此！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:05:16",
            "content": "障害者だから、居眠りを許される職場か、、",
            "Chinese": "是因为是残障人士，就可以在职场打瞌睡吗……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:05:40",
            "content": "それで給料でるようなら",
            "Chinese": "如果这样还能拿工资的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:05:59",
            "content": "納得できない人もいらっしゃるかもですね",
            "Chinese": "确实可能会有人无法接受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:06:04",
            "content": "それと、、",
            "Chinese": "另外……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:06:18",
            "content": "ムーさんおお話をお聞きしてて思うのですが、",
            "Chinese": "听了Muu女士您的话，我觉得，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:06:24",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:07:00",
            "content": "ムーさんは非常に真面目で、気配りもあり、会社の事、同僚の事、いっぱいいろんな事を，、",
            "Chinese": "Muu女士您是一位非常认真、体贴的人，会为公司、为同事操心，考虑很多事情……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:07:19",
            "content": "心配され、気にかけていただいて、、",
            "Chinese": "您为这些事担心，费心了……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:07:38",
            "content": "素晴らしい人柄の方と感じます。",
            "Chinese": "我觉得您的人品非常好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:07:42",
            "content": "ただし、",
            "Chinese": "但是，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:08:05",
            "content": "睡眠が取れてないのが、大病にも繋がりますので、",
            "Chinese": "睡眠不足可能会导致大病，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:08:22",
            "content": "早々に改善された方がいいかと思います",
            "Chinese": "我觉得最好尽快改善。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:08:38",
            "content": "そこで、、ご友人にも相談されてると思いますが、",
            "Chinese": "所以……虽然您也和朋友商量过了，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:08:46",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:09:34",
            "content": "社長や、同僚の方々には、相談や話をされる事をお勧めしたいdれす。話すことで、少しはスッキリすることもあると思いますので",
            "Chinese": "我建议您和社长以及其他同事们商量或谈谈这件事。通过交谈，心情或许能舒畅一些。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:09:53",
            "content": "あっ、確かに！",
            "Chinese": "啊，确实！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:09:56",
            "content": "ムーさん、いかがでしょうか？",
            "Chinese": "Muu女士，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:10:27",
            "content": "肝心の大事な部分が抜けていたことに今、気づきました！",
            "Chinese": "我现在意识到，自己漏掉了最关键的部分！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:10:37",
            "content": "そうですか！",
            "Chinese": "是吗！"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:10:41",
            "content": "そうですよね！",
            "Chinese": "是啊！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:10:59",
            "content": "気づきがあって良かったです",
            "Chinese": "能有这样的觉察真是太好了。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:11:34",
            "content": "おかげで大切なことに気づきました！ありがとうございます！",
            "Chinese": "多亏了您，我意识到了重要的事情！非常感谢！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:11:58",
            "content": "いいえ、こちらこそいろいろ話して頂き有難うございました。",
            "Chinese": "不客气，我也要谢谢您跟我说了这么多。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:12:23",
            "content": "そろそろお時間ですが、今日はこの辺で宜しいでしょうか？",
            "Chinese": "时间差不多了，今天就到这里可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:12:32",
            "content": "はい。本当にありがとうございます！",
            "Chinese": "好的。真的非常感谢您！"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:12:45",
            "content": "お世話になりました。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:12:53",
            "content": "また次回、お話しお聞かせ頂きたいと思いますので、ぜひいらしてください。",
            "Chinese": "希望下次还能听您聊聊，请一定再来。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:13:08",
            "content": "有難うございました。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:13:15",
            "content": "ありがとうございます。また、宜しくお願いします。",
            "Chinese": "谢谢您。下次也麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 13:13:43",
            "content": "宜しくお願いします。本日は有難うございました。",
            "Chinese": "也请您多关照。今天谢谢您了。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 13:13:55",
            "content": "ありがとうございました。",
            "Chinese": "非常感谢。"
        }
