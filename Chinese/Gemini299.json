        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:40:58",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:41:29",
            "content": "本来であれば",
            "Chinese": "本来呢，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:42:01",
            "content": "話をきいてあげたいところです",
            "Chinese": "我很想听听她的心里话。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:42:42",
            "content": "あなたのご友人を思うお気持ちがすごく伝わってきます、、、",
            "Chinese": "我能深切地感受到您为朋友着想的心情……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:42:54",
            "content": "ありがとうございます",
