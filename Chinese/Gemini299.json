{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 17:59:31",
            "content": "本日はよろしくお願いいたします。",
            "Chinese": "今天请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:00:13",
            "content": "初めまして。よろしくお願いいたします。",
            "Chinese": "初次见面，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:00:21",
            "content": "お願いいたします。",
            "Chinese": "拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:01:00",
            "content": "では始めてもよろしいでしょうか？",
            "Chinese": "那么我们可以开始了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:01:09",
            "content": "お願いいたします。",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:01:51",
            "content": "相談ありがとうございます。始めに年齢と性別、相談内容を教えてもらえますか？",
            "Chinese": "感谢您的咨询。首先，可以请您告知您的年龄、性别和咨询内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:01:59",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:02:31",
            "content": "30代 女です",
            "Chinese": "30多岁，女性。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:02:39",
            "content": "相談内容は",
            "Chinese": "咨询内容是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:02:46",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:03:11",
            "content": "友人とのトラブルというか",
            "Chinese": "该说是和朋友之间的纠纷吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:03:24",
            "content": "ケンカをしてしまい",
            "Chinese": "我们吵了一架。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:03:46",
            "content": "女の友人です",
            "Chinese": "是一位女性朋友。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:04:06",
            "content": "仲直りしたいのですが",
            "Chinese": "我想和她和好，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:04:24",
            "content": "どうしたら良いのか",
            "Chinese": "但不知道该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:04:29",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:04:51",
            "content": "色々考えてしまい",
            "Chinese": "我想了很多，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:05:05",
            "content": "混乱しています",
            "Chinese": "现在有些混乱。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:05:49",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:05:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:06:13",
            "content": "ご友人とのトラブルで困ってらっしゃるのですね。",
            "Chinese": "您正因为和朋友的纠纷而困扰呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:06:23",
            "content": "はいそうです",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:07:12",
            "content": "その状況について、もう少し詳しくお話していただけますか？",
            "Chinese": "关于当时的情况，您能再详细地跟我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:07:39",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:08:40",
            "content": "先月中旬頃 数名の友人とオンラインで飲んでいました",
            "Chinese": "上个月中旬左右，我和几个朋友在线上喝酒聊天。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:08:48",
            "content": "そのときに",
            "Chinese": "那个时候……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:08:50",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:09:25",
            "content": "友人が気分を害してしまい",
            "Chinese": "朋友感到不快，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:10:06",
            "content": "雰囲気を壊してしまい",
            "Chinese": "破坏了当时的气氛，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:10:43",
            "content": "フォローできずに終わってしまいました",
            "Chinese": "我也没能帮忙圆场，就这样结束了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:12:05",
            "content": "あなたはご友人をかばうことができなかったことに対して、後悔されているのですね",
            "Chinese": "您对自己没能维护朋友而感到后悔呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:12:16",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:12:42",
            "content": "その時、どんな風に感じたのですか？",
            "Chinese": "当时您有什么样的感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:13:11",
            "content": "それは",
            "Chinese": "那个……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:13:32",
            "content": "友人の態度に対してでしょうか？",
            "Chinese": "是指对朋友的态度吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:14:30",
            "content": "態度も含めて、その場にいた時のあなたのお気持ちを聞かせていただけますか？",
            "Chinese": "包括对她态度的看法，以及您当时在场的心情，可以都告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:15:49",
            "content": "そんなに気になることかな？ということに強く反応して",
            "Chinese": "她对一件我觉得“有那么值得在意吗？”的事情反应很激烈，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:16:13",
            "content": "今までそんな感じの子ではなかったのですが",
            "Chinese": "她以前不是那样的孩子。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:16:33",
            "content": "そのような態度を見たのは初めてだったのですね",
            "Chinese": "您是第一次看到她这样的态度呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:16:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:17:12",
            "content": "それは、あなたもどうすれば良いか戸惑ってしまいますよね",
            "Chinese": "那样的话，您肯定也会不知所措吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:17:23",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:18:08",
            "content": "それは思い悩んでしまいますね",
            "Chinese": "这确实会让人烦恼呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:18:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:18:36",
            "content": "先ほど、仲直りしてたいとおっしゃっておりましたが",
            "Chinese": "您刚才提到想要和好……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:18:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:19:11",
            "content": "ご友人の方はあなたに対しても嫌な思いをされていると感じてらっしゃるのですか？",
            "Chinese": "您觉得您的朋友对您也感到不快吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:19:56",
            "content": "友人が気分を害した原因は",
            "Chinese": "我朋友心情不好的原因是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:20:04",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:20:11",
            "content": "他の友人のことだったのですが",
            "Chinese": "是因为另一位朋友的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:20:51",
            "content": "あなたではないのですね",
            "Chinese": "不是因为您啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:21:01",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:21:33",
            "content": "でも一緒になって と思われたと思います",
            "Chinese": "但我想她肯定觉得我们是一伙的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:22:04",
            "content": "つい笑ってしまい",
            "Chinese": "我一时没忍住笑了出来。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:22:31",
            "content": "ご友人の方はみんなに言われたように感じてらっしゃると思われているのですね",
            "Chinese": "您认为您的朋友感觉像是被大家一起说了，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:22:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:22:58",
            "content": "友人のことを笑ったわけではなく",
            "Chinese": "我并不是在笑她，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:23:03",
            "content": "はい",
            "Chinese": "我明白。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:23:30",
            "content": "話をしている表情だとか",
            "Chinese": "而是因为说话人的表情之类的……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:23:59",
            "content": "怒らせた友人のですね",
            "Chinese": "就是惹她生气的那位朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:24:06",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:24:28",
            "content": "話の内容がおかしくて笑ってしまい",
            "Chinese": "因为谈话内容有些好笑，我就笑了出来，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:24:38",
            "content": "傷つけてしまいました",
            "Chinese": "结果伤害了她。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:24:48",
            "content": "悪気はなかったです",
            "Chinese": "我没有恶意的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:25:41",
            "content": "そうだったんですね。ご友人の方はどこで傷つかれたと思うのでしょうか？",
            "Chinese": "原来是这样。您觉得您的朋友是因为什么而受伤了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:26:03",
            "content": "そうですね",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:27:41",
            "content": "体型と恋愛のこと",
            "Chinese": "是关于体型和恋爱的事情。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:27:50",
            "content": "以前からぽっちゃり体型で",
            "Chinese": "她一直有点微胖，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:27:55",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:28:48",
            "content": "自分から私こんなんだからとか自虐的に話していて",
            "Chinese": "她常常自己说“我就这样啦”之类，自嘲着谈起这些，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:29:19",
            "content": "いつも自虐的なのですか？",
            "Chinese": "她平时就比较自嘲吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:29:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:30:06",
            "content": "冗談だったかもしれませんが",
            "Chinese": "虽然可能只是开玩笑。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:30:24",
            "content": "飲みの会でしたし、盛り上がってしまいますよね",
            "Chinese": "毕竟是酒会，气氛很容易就热烈起来了呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:30:25",
            "content": "可愛くてモテるとは思います",
            "Chinese": "我觉得她可爱又受欢迎。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:30:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:30:37",
            "content": "そうなのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:31:47",
            "content": "でもその友人が好きだった人と",
            "Chinese": "但她喜欢的人，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:32:28",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:32:30",
            "content": "怒らせちゃった人が付き合っていると分かりまして",
            "Chinese": "我发现惹她生气的人，正在和她喜欢的人交往，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:33:21",
            "content": "気分が悪くなったのだと思います",
            "Chinese": "我想她是因为这个才心情不好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:33:29",
            "content": "なるほど、、、",
            "Chinese": "原来如此……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:33:50",
            "content": "怒らせちゃった人は友人が好きだったことは知らないです",
            "Chinese": "那位惹她生气的人并不知道她喜欢对方。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:34:05",
            "content": "ご友人はショックだったんでしょうね",
            "Chinese": "您的朋友一定很受打击吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:34:21",
            "content": "だと思います",
            "Chinese": "我想是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:34:44",
            "content": "悪気はないし、それは困りますね、、、",
            "Chinese": "大家都没有恶意，这就很伤脑筋了呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:34:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:35:24",
            "content": "でも怒っちゃった友人の気持ちも今はわかります",
            "Chinese": "但是我现在也能理解那位生气的朋友的心情了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:35:50",
            "content": "その時は雰囲気で笑ってしまったけど、",
            "Chinese": "虽然当时是随着气氛笑了出来，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:35:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:36:23",
            "content": "今冷静になって考えてみると、見えてくることってありますよね",
            "Chinese": "但现在冷静下来想想，就能看清一些事情了，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:36:32",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:37:14",
            "content": "飲み会の日以来、その子とは連絡は取っていないんですか？",
            "Chinese": "从酒会那天起，您就没和她联系过吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:37:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:37:34",
            "content": "連絡しても",
            "Chinese": "即使联系她……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:38:02",
            "content": "返答なしです",
            "Chinese": "也没有回复。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:38:12",
            "content": "そうでしたか、、、",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:38:17",
            "content": "はい",
