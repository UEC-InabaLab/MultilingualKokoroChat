        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:45:54",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:46:56",
            "content": "失恋と友達から笑われたことで、深く傷つかれていることと思いますよね",
