        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:48:05",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:48:11",
            "content": "コミュニケーションって",
            "Chinese": "沟通这件事，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:48:32",
            "content": "人それぞれ考え方や価値観が違うので",
            "Chinese": "因为每个人的想法和价值观都不同，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:48:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:48:43",
            "content": "難しいですよね",
