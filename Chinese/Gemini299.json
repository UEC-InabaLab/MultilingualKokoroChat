        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:39:50",
            "content": "文で送るより",
            "Chinese": "我想比起发文字……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:40:05",
            "content": "話した方が良いのかなと思いまして",
