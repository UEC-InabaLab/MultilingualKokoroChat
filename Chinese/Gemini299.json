        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:45:12",
            "content": "そうですね",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:45:43",
            "content": "気持ちを整理させる時間が欲しいです",
