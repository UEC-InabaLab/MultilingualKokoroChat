        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:43:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:43:56",
            "content": "もしも、あなたがご友人の立場として、",
