        {
            "role": "カウンセラー",
            "time": "2020/08/08(土) 18:39:12",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/08(土) 18:39:42",
            "content": "話そうよといった内容で",
