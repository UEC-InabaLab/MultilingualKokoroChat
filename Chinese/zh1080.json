    {
      "role": "client",
      "time": "2020-12-31T11:53:55",
      "origin": "こんにちは。こちらこそよろしくお願いします",
      "content": "您好。也请您多多关照。"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T12:01:01",
      "origin": "こんにちは 相談員です。よろしくお願いします。",
      "content": "您好，我是咨询员。请多多指教。"
