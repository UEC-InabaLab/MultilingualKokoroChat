{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 13:51:00",
            "content": "こんにちは、14時から宜しくお願いします。",
            "Chinese": "您好，我们下午两点开始，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 13:51:23",
            "content": "こちらこそよろしくお願いします",
            "Chinese": "彼此彼此，也请您多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:00:05",
            "content": "それでは始めます。",
            "Chinese": "那么，我们开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:00:14",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:00:20",
            "content": "こんにちは、相談員です。",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:00:29",
            "content": "こんにちわ",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:00:42",
            "content": "はじめに、あなたの年齢と性別を教えていただけますか？",
            "Chinese": "首先，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:00:57",
            "content": "14歳女子です",
            "Chinese": "14岁，女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:01:12",
            "content": "教えてくださりありがとうございます。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:01:30",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:02:00",
            "content": "もう全部どうでもいい感じで何もやる気が出ません",
            "Chinese": "总觉得一切都无所谓，什么都提不起劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:02:32",
            "content": "そうなんですね。それはしんどい状況ですね。",
            "Chinese": "是这样啊。这种状况一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:02:49",
            "content": "まあそうです",
            "Chinese": "算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:03:19",
            "content": "そう感じるようになったのには、どんなきっかけがあったのでしょうか？",
            "Chinese": "让您开始有这种感觉，是有什么契机吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:03:44",
            "content": "わかんないけどみんなうざいし",
            "Chinese": "不知道，但就是觉得大家都很烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:04:36",
            "content": "うざいと感じるのですね。",
            "Chinese": "您觉得很烦是吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:04:45",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:05:47",
            "content": "みんなというのはクラスの人たちのことでしょうか？それとも、他にもいたりするのでしょうか？",
            "Chinese": "您说的“大家”，是指班上的同学吗？还是还有其他人？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:06:03",
            "content": "親とか先生とか",
            "Chinese": "父母啊，老师啊之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:07:40",
            "content": "クラスメイトも親も先生もうざいと感じてしまうと、気の休まるところがありませんよね",
            "Chinese": "如果同学、父母和老师都让您觉得很烦，那真是没有可以放松的地方了呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:08:12",
            "content": "クラスメイトはべつにうざくないけど",
            "Chinese": "同学倒不算烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:08:28",
            "content": "そうでしたか、失礼しました。",
            "Chinese": "是吗，抱歉，是我失礼了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:08:53",
            "content": "親と先生がうざいと感じていらっしゃるのですね。",
            "Chinese": "您是觉得父母和老师很烦人呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:09:00",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:09:36",
            "content": "どんなときそう感じますか？",
            "Chinese": "在什么情况下会有这种感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:10:10",
            "content": "勉強しろしか言わない",
            "Chinese": "他们只会说“快去学习”。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:11:03",
            "content": "勉強しろとばかり言われることにうんざりされているのですね。",
            "Chinese": "总是被念叨着“快去学习”，让您感到很厌烦了是吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:11:14",
            "content": "です",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:13:38",
            "content": "あなたとしては、親や先生にどんな風にかかわってほしいと思いますか？",
            "Chinese": "您希望父母和老师用什么样的方式和您相处呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:13:52",
            "content": "ほっといてほしい",
            "Chinese": "希望他们别管我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:14:07",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:14:28",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:14:36",
            "content": "あれこれと言われたくはないのですね。",
            "Chinese": "您不希望他们对您说三道四的，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:14:44",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:15:17",
            "content": "言われなくても自分で考えているのに、と思ったりしますか？",
            "Chinese": "您会不会觉得“就算他们不说，我自己也在考虑”呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:15:27",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:15:36",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:18:03",
            "content": "自分でもやろうと思っているのに、あれこれ言われるとうざいと感じるのは自然なことだと思います。",
            "Chinese": "明明自己也打算要做，却被别人说三道四，会觉得烦是很自然的。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:18:28",
            "content": "ふ〜ん",
            "Chinese": "唔——"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:20:55",
            "content": "あなたが自主的に考えているからこそ、反発する気持ちが出てくるのではないでしょうか？",
            "Chinese": "或许正是因为您在自主思考，才会产生抵触的情绪呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:21:12",
            "content": "わかんないけど",
            "Chinese": "不知道啦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:22:48",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:23:51",
            "content": "そういえば、最初にやる気がしないとおっしゃっていましたね。",
            "Chinese": "说起来，您一开始说提不起干劲是吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:24:24",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:24:38",
            "content": "全部どうでもいい感じとも。",
            "Chinese": "还说感觉什么都无所谓了。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:25:10",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:25:51",
            "content": "そのあたりのことを、もう少し詳しくお聴かせいただけますか？",
            "Chinese": "关于这方面的情况，能再详细地和我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:26:15",
            "content": "まんまだけど",
            "Chinese": "就是字面意思啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:29:14",
            "content": "全部というのは、どんなことがあるのでしょうか？主なものだけでもいいので。",
            "Chinese": "您说的“全部”大致包括哪些事情呢？说几个主要的也可以。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:30:28",
            "content": "勉強とか",
            "Chinese": "学习之类的。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:31:35",
            "content": "楽しいこともなんにもないし",
            "Chinese": "也没什么开心的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:32:08",
            "content": "そうなんですか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:34:19",
            "content": "勉強もどうでもいいし、楽しいこともなんいもないと感じるのですね。",
            "Chinese": "您觉得学习也无所谓，生活里也没有什么让人开心的事。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:34:36",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:35:27",
            "content": "それでは学校に行くのも気が重いのではないでしょうか？",
            "Chinese": "那么，去学校对您来说大概也挺沉重的吧？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:35:49",
            "content": "まあね",
            "Chinese": "算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:36:19",
            "content": "学校には通っていらっしゃいますか？",
            "Chinese": "您现在还去学校吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:36:32",
            "content": "行ってる",
            "Chinese": "有去。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:38:46",
            "content": "学校がつまらなくても、ちゃんと通っていらっしゃるのですね。",
            "Chinese": "即便觉得学校无聊，您还是有按时去上学。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:39:00",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:39:14",
            "content": "クラスメイトとはどんな感じでしょうか？",
            "Chinese": "和同班同学的关系怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:39:41",
            "content": "どんな感じって？普通だけど",
            "Chinese": "什么叫怎么样？就普普通通啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:41:47",
            "content": "普通というのは、普通にお話されたり、一緒に遊んだりするということでしょうか？",
            "Chinese": "所谓普通，是指能正常聊天，也会一起玩之类的吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:44:10",
            "content": "話しはするけどコロナで遊びには行ってない",
            "Chinese": "会聊天，但是因为疫情没出去玩过。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:45:08",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:46:40",
            "content": "コロナで一緒に遊びに行けないと、楽しいことも見つけにくいのかもしれませんね。",
            "Chinese": "因为疫情不能一起出去玩，可能也就不容易找到开心的事情了吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:47:02",
            "content": "まあね",
            "Chinese": "算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:48:01",
            "content": "ここまでのお話をまとめさせていただいてもよろしいですか？",
            "Chinese": "我可以先总结一下我们目前聊到的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:48:08",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:49:55",
            "content": "あなたは全部どうでもいいと感じて何もやる気が出ない。",
            "Chinese": "您觉得一切都无所谓，做什么都提不起劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:51:11",
            "content": "勉強もどうでもいいし、おもしろいことも何もない。",
            "Chinese": "学习也无所谓，生活里也没有什么有趣的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:51:55",
            "content": "それなのに親や先生から勉強しろと言われたりするとうざいと感じる。",
            "Chinese": "可即便如此，一旦被父母或老师催着学习，您就会觉得烦。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:53:12",
            "content": "わたしってダメな人間だね",
            "Chinese": "我真是个没用的人啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:54:20",
            "content": "そんな風に感じていらっしゃるのですね。",
            "Chinese": "您是这样感觉的啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:54:38",
            "content": "なんかそう言われたかんじ",
            "Chinese": "感觉好像被这么说了。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:55:01",
            "content": "まあ自分が言ったことだけど",
            "Chinese": "不过也是我自己说的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:56:16",
            "content": "あなたとしては、どんな風になればいいと思っていますか？",
            "Chinese": "对您而言，觉得变成怎样会更好呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:57:36",
            "content": "大人がほっておいてくれればいい",
            "Chinese": "只要大人们别管我就好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 14:59:28",
            "content": "そう感じているのですね。大人がほっておいてくれたら、どうなると思いますか？",
            "Chinese": "您是这么想的啊。如果大人们都不管您了，您觉得会怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 14:59:41",
            "content": "せいせいする",
            "Chinese": "会觉得轻松很多。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 15:00:05",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 15:03:47",
            "content": "（すっきりとしないままですが、このあたり終わりにして、ご批評を仰ぐということでよろしいでしょうか？）",
            "Chinese": "（虽然还没有理清，但先在这里告一段落，可以请各位给予批评指正吗？）"
        },
        {
            "role": "クライアント",
            "time": "2022/10/16(日) 15:04:02",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 15:05:24",
            "content": "（最後まで主訴を掴めないままでした。どう持っていったら良かったのかのヒントをいただければ幸いです。）",
            "Chinese": "（到最后也没能抓住主要诉求。如果能提示我该如何引导会更好，我将不胜感激。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/16(日) 15:06:24",
            "content": "（これでロールプレイを終わらせていただきます。ありがとうございました。）",
            "Chinese": "（本次角色扮演到此结束。非常感谢。）"
        }
    ],
