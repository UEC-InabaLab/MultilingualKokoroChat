{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 19:52:32",
            "content": "こんばんはよろしくお願いします",
            "Chinese": "晚上好，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 19:52:58",
            "content": "こんばんは！今日はよろしくお願いします。",
            "Chinese": "晚上好！今天就拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 19:54:51",
            "content": "まだ少し早いですが、始めてもよろしいですか？",
            "Chinese": "现在时间还稍早，请问可以开始了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 19:57:33",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 19:57:54",
            "content": "それでは始めます",
            "Chinese": "那么，我们开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 19:58:00",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 19:58:11",
            "content": "こんばんは、相談員です",
            "Chinese": "晚上好，我是咨询师。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 19:58:32",
            "content": "今日はどのようなご相談ですか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 19:58:55",
            "content": "はじめまして、今日はよろしくお願いします",
            "Chinese": "初次见面，今天请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 19:59:15",
            "content": "よろしくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:00:01",
            "content": "人前で話をすると極度に緊張するのですがどうしたらいいですか",
            "Chinese": "一在众人面前讲话就会极度紧张，该怎么办呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:00:26",
            "content": "そうなんですね",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:01:23",
            "content": "緊張すると困りことがあると思いますがいかがですか？",
            "Chinese": "我想紧张的时候会给您带来一些困扰吧，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:02:19",
            "content": "いかがとは？",
            "Chinese": "您指的是？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:04:02",
            "content": "当然のことを聞いてしまってごめんなさいね",
            "Chinese": "刚才问了个有些理所当然的问题，抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:04:09",
            "content": "自分の考えを伝えようと思うのですが、いつも頭の中で考えてから口に出す癖があって疲れます",
            "Chinese": "我想表达自己的想法，但总是习惯先在脑子里想好再说出口，这让我很疲惫。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:04:54",
            "content": "だから言いたいことの半分も伝えられません",
            "Chinese": "所以想说的话连一半都表达不出来。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:05:28",
            "content": "考えてから話すと時間がかかってしまいますものね",
            "Chinese": "确实，先想好再说会很花时间呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:05:35",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:05:57",
            "content": "言いたいことを十分伝えられないと焦ってしまいますよね",
            "Chinese": "无法充分表达想说的内容时，会变得焦急，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:05:58",
            "content": "頭であれこれ考えてしまうんです",
            "Chinese": "脑子里会想东想西。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:06:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:06:51",
            "content": "どんなことをかんがえたりしますか？",
            "Chinese": "您都会想些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:07:45",
            "content": "こう言ったらどう思われるかな？とか、間違いかな？とか変におもわれるのではとか",
            "Chinese": "会想“这么说别人会怎么想？”“是不是说错了？”“会不会被觉得奇怪？”之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:08:39",
            "content": "なるほどですね",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:09:12",
            "content": "そう考えて、無難に答えようとするので、かたい？不自然なコミュニケーションになってしまい、疲れます",
            "Chinese": "因为想了这些，就会想用最稳妥的方式回答，结果沟通就变得很僵硬？不自然，让人很累。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:10:44",
            "content": "人前で話すのがますます苦手意識が強くなります・・・・",
            "Chinese": "在人前说话越来越感到不擅长了……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:10:44",
            "content": "いろいろ心配していると、不自然になってしまうのですね",
            "Chinese": "因为担心各种各样的事情，所以就变得不自然了，是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:11:04",
            "content": "そうなのかもしれません",
            "Chinese": "可能就是这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:12:22",
            "content": "ちなみに、あなたの年齢と性別を教えていただけますか？",
            "Chinese": "顺便问一下，可以告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:13:43",
            "content": "はい、40代女性です",
            "Chinese": "好的，我是40多岁的女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:14:07",
            "content": "教えていただきありがとうございます",
            "Chinese": "感谢您告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:14:50",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:14:51",
            "content": "今はお仕事とかはされていますか？",
            "Chinese": "您现在有在工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:15:14",
            "content": "しています",
            "Chinese": "在工作。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:15:41",
            "content": "若い時から同じ仕事です",
            "Chinese": "从年轻时起就一直是同一份工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:16:19",
            "content": "そうなんですねずっと続けていらっしゃるんですね",
            "Chinese": "是这样啊，您一直坚持做这份工作呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:16:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:17:12",
            "content": "あなたは辛抱強い方なんだと思います",
            "Chinese": "我认为您是一个很有毅力的人。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:17:29",
            "content": "どちらかというとそうかもしれません",
            "Chinese": "要说的话，可能算是吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:17:43",
            "content": "なぜ、そう思われましたか？",
            "Chinese": "为什么您会这么认为呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:20:47",
            "content": "近年仕事を変える人が増えているようですので",
            "Chinese": "因为近年来换工作的人似乎越来越多了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:21:21",
            "content": "そう思いました",
            "Chinese": "所以我就这么想了。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:21:43",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:21:52",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:22:49",
            "content": "はい、しております",
            "Chinese": "是的，有在工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:24:03",
            "content": "ところで、人前で緊張されるとおっしゃいましたが、人前で話すのはどんな場面が多いですか？プレゼンテーションとかでしょうか？",
            "Chinese": "话说回来，您说在人前会紧张，那您主要是在什么场合需要在大家面前说话呢？是像做报告之类的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:26:01",
            "content": "仕事柄、子ども、保護者の前などです",
            "Chinese": "因为工作关系，主要是在孩子和家长面前。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:26:47",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:26:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:28:59",
            "content": "どんなお仕事をされているのですか？学校の先生とかでしょうか？",
            "Chinese": "您是做什么工作的呢？是学校的老师吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:29:16",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:29:39",
            "content": "そうだったんですね",
            "Chinese": "原来是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:30:41",
            "content": "それなら子供達とか、保護者の前で話す機会が多いですよね",
            "Chinese": "那样的话，确实会有很多在孩子或家长面前讲话的机会吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:31:47",
            "content": "多いかどうかはわかりませんが、話す機会が度々あります",
            "Chinese": "我不知道算不算多，但确实时常有说话的机会。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:32:06",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:32:30",
            "content": "子供達や保護者の前で上手く伝えられないときは、どんなお気持ちになりますか？",
            "Chinese": "在孩子们和家长面前无法顺利传达时，您会有什么样的感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:34:48",
            "content": "もっとわかりやすく、簡潔に話せたらよかったとか",
            "Chinese": "会想“要是能说得更简单易懂、更简洁就好了”。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:35:12",
            "content": "自分の思いなどいれたり、ユーモラスに",
            "Chinese": "或者能加入自己的想法，说得更幽默一些。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:35:14",
            "content": "など",
            "Chinese": "之类的。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:35:50",
            "content": "残念な思いですかね・・・・",
            "Chinese": "大概是遗憾的感觉吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:38:31",
            "content": "もっと上手く伝えたかったのにとか、もっと面白く話したかったのにとか思うとガッカリしてしまいますよね",
            "Chinese": "想着“明明想表达得更好”、“明明想说得更有趣”，结果却没做到，会感到很失落吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:38:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:47:44",
            "content": "あなたとしては、どうしたら人前で緊張せずに話せたらいいかということですよね",
            "Chinese": "对您来说，关键在于怎样才能在人前不紧张地说话，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:48:10",
            "content": "でも、いつもお堅い話の仕方ばかりで、無難すぎて自分で話をしていてつまらないなと思ってしまいます。",
            "Chinese": "但是，我总是用很死板的方式说话，太过于平淡无奇，连我自己都觉得说话很无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:49:03",
            "content": "なるほど、砕けた話とかもしてみたいという感じでしょか？",
            "Chinese": "原来如此，您是想尝试一些更轻松随意的谈话方式，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:49:15",
            "content": "はいそのとおりです",
            "Chinese": "是的，就是这样。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:49:49",
            "content": "緊張しないで、自分の意のままに反話すためにはどうしたらいいですか？",
            "Chinese": "为了能不紧张、随心所欲地说话，我该怎么做呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:49:56",
            "content": "何かアドバイスをください",
            "Chinese": "请给我一些建议。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:50:09",
            "content": "そうですね",
            "Chinese": "我想想。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:52:00",
            "content": "緊張しない方法は人によっていろいろありますが",
            "Chinese": "不紧张的方法因人而异，不过……"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:52:07",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 20:52:45",
            "content": "聞いている人がカボチャだと思って話すなんて言う人もいますね",
            "Chinese": "也有人说，可以把听众想象成南瓜再说话。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:53:07",
            "content": "はい、よくききますね",
            "Chinese": "是的，这个我常听说。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 20:57:06",
            "content": "他に方法ありますか？",
            "Chinese": "还有其他方法吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 21:00:16",
            "content": "くだけた話をしたいのでしたら、自虐ネタを使うといいかもしれません",
            "Chinese": "如果您想说些轻松的话，用一些自嘲的段子可能效果不错。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 21:01:15",
            "content": "なるほど～自虐ネタですね～",
            "Chinese": "原来如此～自嘲的段子啊～"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 21:01:21",
            "content": "あまりカッコよくやろうとせずに、笑われて元々みたいな感じですかね",
            "Chinese": "就是不要太想表现得很帅，抱着“被笑了也无所谓”的心态吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 21:01:43",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 21:02:04",
            "content": "自虐ネタいいですね",
            "Chinese": "自嘲的段子听起来不错。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 21:02:33",
            "content": "それと、上手くやろうとせずに、たどだとしくても伝わればいいっていう感じもいいかもしれません",
            "Chinese": "还有，不要总想着要说得多好，抱着“就算说得磕磕巴巴，只要能传达到意思就行”的心态可能也不错。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 21:02:37",
            "content": "いい恰好しようと思うから、つかれるんですね",
            "Chinese": "就是因为总想表现得很好，所以才累的吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 21:02:39",
            "content": "きっと",
            "Chinese": "一定是这样。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 21:02:49",
            "content": "なるほど",
            "Chinese": "我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 21:03:24",
            "content": "次回から、もっと楽に話すことにします",
            "Chinese": "下次开始，我会试着更轻松地去说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/29(木) 21:03:40",
            "content": "そうですね立て板に水みたいにすらすら話せても、聞いてる方には案外残らなかったりします",
            "Chinese": "是啊，就算话说得像行云流水一样流利，听的人也未必能记住多少。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/29(木) 21:04:02",
            "content": "そうみたいですね",
            "Chinese": "好像是这样呢。"
        },
        {
            "role": "クライアント",
