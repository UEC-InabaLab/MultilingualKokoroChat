{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 09:52:49",
            "content": "はじめまして。相談員です。準備が出来ましたら始めさせていただきますね。",
            "Chinese": "您好，初次见面。我是咨询师。如果您准备好了，我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 09:56:07",
            "content": "（こんにちは、よろしくお願いします）",
            "Chinese": "（您好，请多指教。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 09:57:29",
            "content": "お越しいただきありがとうございます。今日はよろしくお願いいたします。",
            "Chinese": "感谢您的到来。今天请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 09:58:42",
            "content": "（はい、お願いします）",
            "Chinese": "（好的，拜托您了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:00:49",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:02:48",
            "content": "職場での人間関係に困ってます",
            "Chinese": "我在职场人际关系上遇到了困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:04:03",
            "content": "そうなのですね。よろしければ年令と性別を教えていただけますか？",
            "Chinese": "是这样啊。如果方便的话，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:04:17",
            "content": "50代、7女性です",
            "Chinese": "50多岁，7女性。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:04:28",
            "content": "7は打ち間違いです",
            "Chinese": "“7”是打错了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:04:42",
            "content": "大丈夫です。ありがとうございます。",
            "Chinese": "没关系。谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:05:11",
            "content": "何とお呼びしたらよろしいでしょうか？",
            "Chinese": "请问该怎么称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:05:52",
            "content": "まきです",
            "Chinese": "我叫Maki。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:06:34",
            "content": "まきさんですね。職場でのことをもう少し詳しく教えていただけますか？",
            "Chinese": "是Maki女士啊。可以再详细地告诉我一些关于职场的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:08:51",
            "content": "はい、中心は一人の人なんですが、私の事を生意気と言っているみたいで（社歴はその人の方が長くて私の方が5才年上だが先輩にあたる）、4人でグループになっている人たちで悪口を言っているみたいなんです",
            "Chinese": "好的，主要是有一个人，她似乎在说我傲慢（她的工龄比我长，虽然我比她大5岁，但算是我的前辈），她们四个人组成一个小团体，好像在背后说我坏话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:09:11",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:10:02",
            "content": "悪口を言われるととても嫌な気持ちになりますよね...",
            "Chinese": "被人说坏话，心情会变得很糟糕吧..."
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:10:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:11:11",
            "content": "職場の方はまきさんが生意気というのは、どのようなことでお感じになっているのでしょうか？",
            "Chinese": "您公司的人说您傲慢，您认为是什么样的事情让他们产生这种感觉的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:12:32",
            "content": "彼女の仕事の一部を引き継いだ時に、思われたみたいです。私、もともとあまりしゃべらないので",
            "Chinese": "好像是在我接手她一部分工作的时候，她开始这么觉得的。我本来话就不多。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:13:27",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:14:35",
            "content": "まきさんが話さない態度をその方は生意気と思っているのでしょうか？",
            "Chinese": "那个人是觉得您不爱说话的态度很傲慢吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:15:10",
            "content": "詳しく話すことはないのでわかりません",
            "Chinese": "我们没怎么详细聊过，所以我不清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:15:27",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:16:42",
            "content": "その方も合わせて4人でまきさんの悪口を言ってくるのですね？",
            "Chinese": "也就是说，包括她在内，总共四个人在说您的坏话是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:17:36",
            "content": "言って来るというか、私には話しかけないけど、目配せしたり厳しい言葉で注意したりします",
            "Chinese": "与其说是说坏话，不如说她们不和我说话，但会互使眼色，用严厉的言辞批评我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:17:56",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:17:58",
            "content": "明らかに悪口言っているなって感じでこそこそ喋ったり",
            "Chinese": "还会窃窃私语，感觉明显是在说我坏话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:18:05",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:18:29",
            "content": "女同士のそういう感じ分かりませんか？",
            "Chinese": "女人之间的那种感觉，您不懂吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:18:46",
            "content": "わかります。わかります！",
            "Chinese": "我理解。我完全理解！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:19:15",
            "content": "女性特有のことってありますよね、、、",
            "Chinese": "女性之间确实有这种特有的事情呢..."
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:20:06",
            "content": "そういう感じです",
            "Chinese": "就是那种感觉。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:20:10",
            "content": "どうしたらいいですか",
            "Chinese": "我该怎么办才好？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:20:48",
            "content": "これは私の経験談になってしまうのですが、",
            "Chinese": "这可能只是我个人的经验之谈，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:21:14",
            "content": "コソコソされることに対して",
            "Chinese": "面对被人在背后窃窃私语这件事，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:21:25",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:21:52",
            "content": "何もしないときりがないと思い",
            "Chinese": "我觉得如果什么都不做的话，会没完没了，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:22:19",
            "content": "複数の人にはきついのですが",
            "Chinese": "要同时面对多人很难，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:23:14",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:23:32",
            "content": "一人の人に(中心になっている人)",
            "Chinese": "所以我就找了其中一个人（那个核心人物），"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:24:14",
            "content": "になぜそんなことをするのか、自分の悪いところがあったら直接伝えてほしいと",
            "Chinese": "问她为什么要这么做，如果我有什么不好的地方，希望她能直接告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:25:05",
            "content": "言った時に相手側も以外とすんなり伝えてくれて和解出来たことがあったのですが",
            "Chinese": "当我这么说了之后，对方意外地很坦率地告诉了我，我们最终和解了。我有过这样的经历。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:25:22",
            "content": "それはまきさんにとって",
            "Chinese": "这样做对您来说，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:25:37",
            "content": "抵抗のあることでしょうか？",
            "Chinese": "这样做会不会有抵-触？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:27:47",
            "content": "4人でこそこそしてるのは、一人の人に話せば泥状無難ですか？",
            "Chinese": "如果四个人都在背后议论，找其中一个人谈就能解决问题吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:27:54",
            "content": "大丈夫",
            "Chinese": "没问题。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:27:56",
            "content": "です",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:28:22",
            "content": "4人がこそこそ話すので、中心の一人に話せば大丈夫なんですね？",
            "Chinese": "她们四个人窃窃私语，所以只要和那个核心人物谈谈就没问题了，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:28:38",
            "content": "話すことはできます",
            "Chinese": "我可以和她谈。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:28:56",
            "content": "よかった！",
            "Chinese": "太好了！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:29:07",
            "content": "その方の",
            "Chinese": "关于那位——"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:29:29",
            "content": "それで悪口こそこそ言われるのは絶対止まるんですね",
            "Chinese": "这样一来，她们就绝对不会再说我坏话了，是吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:29:36",
            "content": "人柄にもよると思うのですが、",
            "Chinese": "我觉得也要看对方的人品，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:29:51",
            "content": "人柄って？",
            "Chinese": "人品？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:29:56",
            "content": "すごく意地悪です",
            "Chinese": "她非常坏心眼。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:30:00",
            "content": "絶対といいきれません...",
            "Chinese": "我不能保证绝对会停止..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:30:31",
            "content": "女性って",
            "Chinese": "女性嘛，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:30:49",
            "content": "そういうことをする時は",
            "Chinese": "当她们这样做时，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:30:50",
            "content": "いうのは簡単ですけど、言って火に油みたいになりたくないので今まで我慢しています",
            "Chinese": "说的倒是简单，但我不想说了之后火上浇油，所以才一直忍耐到现在。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:31:34",
            "content": "確かに難しいとこですよね...",
            "Chinese": "这确实是很难办的地方呢..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:31:55",
            "content": "その方は",
            "Chinese": "那位她——"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:32:07",
            "content": "でも、専門家の方がそう指示されるんだから言う事しか解決策はないってことですよね",
            "Chinese": "不过，既然专家您都这么指示了，那就说明除了说出来以外没有别的解决办法了，对吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:32:48",
            "content": "まきさんの気持ちが大事なことなので",
            "Chinese": "因为Maki女士您的心情才是最重要的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:33:31",
            "content": "まきさん自身が伝えることで",
            "Chinese": "由您亲自去表达，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:33:44",
            "content": "私は仕返ししたいくらい、その人たちの事嫌になってます",
            "Chinese": "我已经讨厌她们到想报复的程度了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:34:13",
            "content": "改善に繋げたいと思われた時が良いと思います。",
            "Chinese": "我觉得当您自己想要通过沟通来改善状况的时候，才是最好的时机。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:34:38",
            "content": "そうなのですね...",
            "Chinese": "是这样啊..."
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:34:45",
            "content": "え、でも言うのが一番いいんですよね？",
            "Chinese": "诶，可是开口去说还是最好的，对吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:35:15",
            "content": "伝えることは良いと思います。",
            "Chinese": "我认为去沟通是一件好事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:35:29",
            "content": "けれども",
            "Chinese": "不过——"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:35:45",
            "content": "専門家の方にそう言って頂けたら、私もう我慢しないではっきり言います。それで悪口が止まるなら",
            "Chinese": "如果您作为专业人士这么说的话，我就不再忍了，直接明明白白地说。只要这样能让她们不再说坏话的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:36:19",
            "content": "まきさんの気持ちがそうしたいと思うようになることが大事だと思います。",
            "Chinese": "我认为重要的是Maki女士您自己发自内心地想这么做。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:36:32",
            "content": "そうしたいって？",
            "Chinese": "想这么做？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:36:57",
            "content": "まきさんの相手に対する許せないという",
            "Chinese": "您对对方“无法原谅”的"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:37:10",
            "content": "気持ちもよくわかります。",
            "Chinese": "这种心情，我也非常理解。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:37:12",
            "content": "カウンセラーさんが言った方が悪口が止まる経験がおありなんですよね？",
            "Chinese": "咨询师您有过说了之后坏话就停止的经历，是吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:37:45",
            "content": "はい。私の時はそうでした。",
            "Chinese": "是的。我当时是这样的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:37:53",
            "content": "私、別に仲良くなりたいわけじゃないので",
            "Chinese": "我并不是想跟她们搞好关系，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:38:11",
            "content": "そうなのですね...",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:38:35",
            "content": "まきさんは相手を許せなくて",
            "Chinese": "您是无法原谅对方，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:38:53",
            "content": "悪口が止まって、仕事時間だけすんなり過ごせればいいんです。でも、反論したりして、火に油を注ぐことになったらって言わずに来たんです",
            "Chinese": "只要她们不再说坏话，我能把工作时间顺顺利利地过下去就行了。不过我担心一反驳就会火上浇油，所以才一直没说。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:39:15",
            "content": "別に許す気はありませんから",
            "Chinese": "我也根本没打算原谅她们。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:39:43",
            "content": "そうですよね...",
            "Chinese": "说的也是呢..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:40:27",
            "content": "相手の方ととことん",
            "Chinese": "和对方彻彻底底地..."
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:40:39",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:41:09",
            "content": "言い合ってみるのはどうでしょう？",
            "Chinese": "互相把话说开怎么样？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:41:17",
            "content": "女性って",
            "Chinese": "女性啊，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:41:31",
            "content": "分かりました。",
            "Chinese": "我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:42:04",
            "content": "やっぱり、言えば、悪口を言う事やめてくれるんですね。",
            "Chinese": "果然，只要说出来，她们就会停止说坏话，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:42:11",
            "content": "ってことですよね",
            "Chinese": "是这个意思吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:42:24",
            "content": "わだかまりがあると我慢し合ってしまうとこってありますよね。",
            "Chinese": "心里有疙瘩的时候，往往会互相忍耐呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:42:46",
            "content": "なあなあにするよりは",
            "Chinese": "与其含糊过去..."
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:42:54",
            "content": "はっきり言ってやります、ずっと意地悪我慢してたけど、悪口言っていることはわかってるって",
            "Chinese": "我会跟她们说清楚，告诉她们我一直在忍耐她们的坏心眼，而且我知道她们在说我坏话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:43:32",
            "content": "言いたいことを言い合うことは私は大事なことだと思います。",
            "Chinese": "我认为把想说的话彼此说开是很重要的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:43:59",
            "content": "専門家にそう言って頂けたって言ってやります",
            "Chinese": "我会跟她们说，这是专家让我这么说的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:44:05",
            "content": "ありがとうございました！",
            "Chinese": "谢谢您！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:44:52",
            "content": "まきさんすみません...",
            "Chinese": "Maki女士，对不起..."
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:44:59",
            "content": "はい",
            "Chinese": "嗯？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:45:24",
            "content": "相手を攻撃するということではなく",
            "Chinese": "我的意思不是要去攻击对方，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:46:05",
            "content": "お互いの心の中にある",
            "Chinese": "而是把彼此心里的"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:46:30",
            "content": "わだかまりをぶつけ合えたらと思ったのですが.",
            "Chinese": "心结拿出来交流一下，是这个意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:46:56",
            "content": "そういうことはまきさんにとっては",
            "Chinese": "这样的做法，对您来说，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:47:32",
            "content": "相手のことを許しがたいことになってしまいますか？",
            "Chinese": "会不会变成更难以原谅对方的事呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:47:33",
            "content": "わだかまりをぶつけるって、今お話したことがわだかまりの全てです",
            "Chinese": "所谓把心结说出来，我刚才说的就是我全部的心结了。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:47:50",
            "content": "許す必要ってありますか？",
            "Chinese": "有必要原諒她们吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:48:23",
            "content": "ないと思います。ただまきさんにとって",
            "Chinese": "我觉得没有必要。只是如果对Maki女士您来说，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:48:46",
            "content": "苦しい状態が続いてしまうのなら",
            "Chinese": "如果痛苦的状态一直持续，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:49:19",
            "content": "わだかまりを吐き出すことがよいという考えもありました。",
            "Chinese": "我才会有把疙瘩都说出来比较好的想法。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:49:29",
            "content": "どっちがいいんですか？",
            "Chinese": "那到底哪种更好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:49:54",
            "content": "難しいところですね...",
            "Chinese": "确实很难下结论……"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:50:15",
            "content": "わだかまりをぶつけるって、ここまで話したことだから攻撃しないってわけには行きませんよね",
            "Chinese": "把疙瘩说出来，既然话都说到这份上了，不可能不去攻击对方吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:50:57",
            "content": "え、だって先生が言った方が解決するって。。。経験もあるって言ったのに",
            "Chinese": "诶，可是老师您不是说，说出来就能解决吗...还说您有经验。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:51:04",
            "content": "ちがうんですか？",
            "Chinese": "难道不是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:51:58",
            "content": "まきさんの気持ちが大事なことなのでこれが正しい間違っているということは",
            "Chinese": "因为Maki女士您的心情是最重要的，所以这件事没有绝对的对错，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:52:24",
            "content": "言えません。私の経験したことが",
            "Chinese": "我不敢断言。我的经历，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:52:39",
            "content": "分かりました",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:52:50",
            "content": "まきさんにとって良いとは限らないですよね...",
            "Chinese": "未必就一定适合您，对吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:53:28",
            "content": "ありがとうございました",
            "Chinese": "非常感谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:54:07",
            "content": "よかったらまきさんにとって良い形になることを考えさせてもらってもいいですか？",
            "Chinese": "如果可以的话，能让我和您一起思考一个对您来说最好的方式吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:56:25",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:56:59",
