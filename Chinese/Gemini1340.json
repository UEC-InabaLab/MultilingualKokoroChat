        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:57:24",
            "content": "受け止めてあげられてないですよね...",
            "Chinese": "没有好好接住，是吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:57:32",
            "content": "ごめんなさい",
            "Chinese": "对不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:58:19",
            "content": "まきさんにとって相手を許せない気持を",
            "Chinese": "对于您来说，那种无法原谅对方的心情——"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:58:53",
            "content": "どうしたらよいか一緒に考えさせてください。",
            "Chinese": "请允许我和您一起想想，怎样才好。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 10:59:00",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:59:10",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 10:59:43",
            "content": "まきさんが煩わしい思いをせずに",
            "Chinese": "为了让您不再受这些烦扰，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 11:00:03",
            "content": "仕事が出来るようになるには",
            "Chinese": "能够顺利工作，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/15(月) 11:01:09",
            "content": "職場に味方になってもらえそうな方はいますか？",
            "Chinese": "在职场里有没有可能成为您支持者的人？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/15(月) 11:02:59",
            "content": "はい、上司が",
