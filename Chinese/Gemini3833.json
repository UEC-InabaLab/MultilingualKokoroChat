{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 14:51:33",
            "content": "こんにちは、15時にスタートさせていただきます。よろしくお願いいたします。",
            "Chinese": "您好，我们将于15点开始。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 14:51:55",
            "content": "（ログインしております。）",
            "Chinese": "（已登录。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 14:52:10",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 14:52:19",
            "content": "ありがとうございます、よろしくお願いいたします。",
            "Chinese": "谢谢您，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 14:59:52",
            "content": "こんにちは。相談員です。よろしくお願いいたします。はじめに年齢と性別、ニックネーム(今回ご相談用の)をお聞かせいたただけますか？",
            "Chinese": "您好。我是咨询师，请多关照。首先，能告诉我您的年龄、性别和昵称（本次咨询用的）吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:00:18",
            "content": "16才、女性、ジュミです。もう死にたいです",
            "Chinese": "16岁，女性，昵称是朱米。我不想活了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:00:59",
            "content": "ジュミさん、そのように今お感じなのですね。",
            "Chinese": "朱米，你现在有这样的感受呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:01:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:01:23",
            "content": "具体的にお聞かせいただけますか。",
            "Chinese": "能具体跟我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:01:49",
            "content": "母が、弟ばかりかわいがって私の事は要らないみたい",
            "Chinese": "妈妈只疼爱弟弟，好像不需要我。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:01:56",
            "content": "です",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:02:25",
            "content": "そのように思われてるのですね。寂しく感じますね。",
            "Chinese": "您是这么觉得的啊。一定感到很孤单吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:03:16",
            "content": "おかあさまのどのような言動から、弟ばかりかわいがってとお感じですか？",
            "Chinese": "是妈妈的哪些言行，让您觉得她只疼爱弟弟呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:03:24",
            "content": "はい。弟がサッカーで遅くなった時は「おつかれさまー」なんて言ってるのに、私がちょっと遅くなったら「もう出て行きなさい」とかいうし",
            "Chinese": "是的。弟弟因为踢足球晚回家时，她会说“辛苦啦”，可我只要晚一点点，她就会说“你给我出去”。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:03:54",
            "content": "弟はサッカーの後、友達と遊んでるのも私知ってるのに",
            "Chinese": "而且我知道，弟弟踢完足球后还跟朋友去玩了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:04:03",
            "content": "そうなんですね。それは、納得いかないですね。",
            "Chinese": "是这样啊。这确实让人难以接受呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:04:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:04:34",
            "content": "今日はどのようなことをお望みかお聞かせいただけますか？",
            "Chinese": "能告诉我您今天希望获得什么帮助吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:05:20",
            "content": "母は私を嫌っているので、もう死にたいって思って",
            "Chinese": "因为妈妈讨厌我，所以我就想着不如死了算了。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:05:36",
            "content": "もうダメですよね",
            "Chinese": "是不是已经不行了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:05:38",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:05:45",
            "content": "いえいえ",
            "Chinese": "不不。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:05:55",
            "content": "ダメではないですよ",
            "Chinese": "没有不行这回事哦。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:05:56",
            "content": "母私なんて、生きてられない",
            "Chinese": "妈……像我这样的人，活不下去。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:06:12",
            "content": "母じゃなくて、私です",
            "Chinese": "不是“妈”，是“我”。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:06:31",
            "content": "そうお感じの今は、とてもおつらいですね。",
            "Chinese": "您现在有这种感觉，一定非常痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:06:47",
            "content": "何もやる気が起きない",
            "Chinese": "什么都提不起劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:06:47",
            "content": "ちなみに、",
            "Chinese": "顺便问一下，"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:06:53",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:07:43",
            "content": "お母さまは、ジュミさんに言葉で嫌いと言われてるのではないですよね？",
            "Chinese": "您妈妈并不是亲口对您说过“讨厌你”这样的话，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:07:54",
            "content": "嫌いって言います",
            "Chinese": "她会说“我讨厌你”。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:08:21",
            "content": "そうなんですね。どのような文句で言われますか、他に？",
            "Chinese": "是这样啊。除了这个，她还会说些什么抱怨的话呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:09:14",
            "content": "何をやってもグズとか母がいつも後を面倒う見なければならないとか",
            "Chinese": "说我做什么事都磨磨蹭蹭的，总要她跟在后面收拾烂摊子之类的。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:09:57",
            "content": "別にいいんですけど",
            "Chinese": "倒也无所谓。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:10:05",
            "content": "そういわれるのですね。ジュミさんはご自身のこと、そう思われますか。どのように思われますか？",
            "Chinese": "她会那样说您啊。朱米您自己也那么看自己吗？您是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:10:44",
            "content": "頑張っても弟より成績とか悪いから、いわれる時はしょうがないかなって",
            "Chinese": "因为就算努力了，成绩之类的还是比弟弟差，所以被她说的时候，我也会觉得没办法吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:11:01",
            "content": "どうせ出来ないのは事実だし",
            "Chinese": "反正我做不好是事实。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:11:33",
            "content": "そのようにお感じなのですね。悲しくなりますね。",
            "Chinese": "您是这么感觉的啊。真让人难过呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:12:04",
            "content": "もう慣れてるから悲しいって言うか、無です",
            "Chinese": "已经习惯了，所以与其说是悲伤，不如说是麻木了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:12:40",
            "content": "無　なのですね。ジュミさんのおかあさまに対してのお気持ちを他に聞かせていただけますか？",
            "Chinese": "是“麻木”啊。能再多告诉我一些您对妈妈的其他感受吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:14:05",
            "content": "母は離婚してから頑張っていると思う。弟がサッカーでレギュラーになって、わりとチームも強いから自慢なんです。私は自慢にならないし。",
            "Chinese": "我觉得妈妈离婚后很努力。弟弟成了足球队的主力，而且球队也比较强，是她的骄傲。而我成不了她的骄傲。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:14:29",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:14:59",
            "content": "おかあさまは",
            "Chinese": "您母亲……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:15:22",
            "content": "女でひとつでご苦労されてるのですね。余裕がないのですね。",
            "Chinese": "她一个女人独自把孩子拉扯大，一定很辛苦吧。所以没什么余力了呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:15:35",
            "content": "余裕・・・",
            "Chinese": "余力……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:16:02",
            "content": "はい、時間的にも金銭的にも。",
            "Chinese": "是的，无论是时间上还是金钱上。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:16:18",
            "content": "仕事して、弟の塾の迎えとか行って忙しいことは忙しいです",
            "Chinese": "她又要上班，又要去接弟弟下补习班，忙是很忙。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:16:58",
            "content": "そうなんですね。フルタイムでお仕事されて、送迎もされてお忙しいですね。",
            "Chinese": "是啊。做着全职工作，还要负责接送，真的很忙碌呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:17:09",
            "content": "でも、私だって高校生なんだから家事とか手伝えないとグズとかいうのはおかしいと思う",
            "Chinese": "但是，我也是高中生了啊，总不能因为没帮忙做家务就被说磨蹭吧，我觉得这很奇怪。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:17:54",
            "content": "そうお感じなのですね。グズと言われるのは嫌ですね。",
            "Chinese": "您是这么觉得的啊。被人说是“磨蹭”确实很难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:17:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:18:12",
            "content": "嫌われてるし要らないんです",
            "Chinese": "我被讨厌了，是不被需要的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:18:41",
            "content": "そう感じてしまうほど、おつらいのですね。",
            "Chinese": "您的痛苦已经到了会让您产生这种感觉的程度了啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:19:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:19:37",
            "content": "出て行けって言われた時も",
            "Chinese": "被她叫“滚出去”的时候也是。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:19:52",
            "content": "出て行ったけど2時間全く探しに来なかった",
            "Chinese": "我真的出去了，但过了两个小时她完全没来找我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:20:07",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:20:09",
            "content": "私の事はどうでもいいんです",
            "Chinese": "她根本就不在乎我。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:20:28",
            "content": "今度試験の結果も悪くて",
            "Chinese": "这次考试的成绩也很差。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:20:52",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:21:08",
            "content": "このまま学校続けても進学とか無理っぽいし",
            "Chinese": "再这样上下去，感觉升学也没什么希望了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:21:27",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:21:32",
            "content": "また、母にこんなこともできないって言われそうだし",
            "Chinese": "感觉又会被妈妈说“连这点事都做不好”。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:21:37",
            "content": "もう死にたいです",
            "Chinese": "我真的很想死了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:22:15",
            "content": "今、本当にどうしたらいいかわからなくなるほど、お辛いのですね。",
            "Chinese": "您现在一定很痛苦，到了真的不知道该怎么办才好的地步了吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:22:21",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:22:38",
            "content": "今日はどのようなことをお望みかお聞かせいただけますか？",
            "Chinese": "能告诉我您今天希望获得什么帮助吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:23:01",
            "content": "うーん",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:23:08",
            "content": "しにたいだけなんです",
            "Chinese": "只是想死而已。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:23:25",
            "content": "ここに居たくない",
            "Chinese": "不想待在这里。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:23:39",
            "content": "今はそのことしか頭にないといった感じですか？",
            "Chinese": "是感觉现在满脑子都只有这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:23:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:24:14",
            "content": "そうなんですね。悩ましいですね。",
            "Chinese": "是这样啊。确实让人很煎熬呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:24:41",
            "content": "リスカとかしたら死ねますか？",
            "Chinese": "如果割腕之类的能死吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:25:03",
            "content": "そこまでお感じなのですね。",
            "Chinese": "您已经想到那个地步了啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:25:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:25:25",
            "content": "そうなんですね、",
            "Chinese": "是这样啊，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:25:36",
            "content": "では、",
            "Chinese": "那么，"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:25:48",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:26:12",
            "content": "今も辛さをもっともっと吐き出してみませんか？言うだけなら、痛くないので。",
            "Chinese": "要不要把现在的痛苦更多更多地倾诉出来呢？只是说出来的话，是不会痛的。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:26:56",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:27:23",
            "content": "やっぱり生活も厳しいので",
            "Chinese": "毕竟生活也很拮据。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:27:27",
            "content": "人に心の内を話すだけで、少しは楽になりますよ。",
            "Chinese": "仅仅是把心里的话说出来，就会轻松一些哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:27:32",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:27:57",
            "content": "母子家庭ですしね",
            "Chinese": "毕竟是单亲家庭嘛。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:28:02",
            "content": "私は学校で流行ってるかバンとか買ってもらってなくて",
            "Chinese": "学校里流行的包包之类的，妈妈都没给我买。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:28:17",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:28:21",
            "content": "バイトもしてるんです。",
            "Chinese": "我还在打工。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:28:35",
            "content": "弟は中学生ってことも有るけど",
            "Chinese": "虽说弟弟还在上初中，但…"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:28:37",
            "content": "バイト、すごいですね！",
            "Chinese": "打工，真了不起啊！"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:28:42",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:28:46",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:29:04",
            "content": "サッカーチームでおそろいのジャンパーとか",
            "Chinese": "足球队统一的外套之类的。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:29:14",
            "content": "かバンとか",
            "Chinese": "还有包包之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:29:17",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:29:28",
            "content": "しょっちゅう作ってて",
            "Chinese": "他们经常在做这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:29:39",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:29:56",
            "content": "納得いかないですね",
            "Chinese": "的确让人难以接受呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:30:01",
            "content": "私はバイト代でみんなと一緒のカバン買ったり",
            "Chinese": "我就用打工赚的钱买和大家一样的包。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:30:13",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:30:15",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:30:36",
            "content": "それで、洗濯もの入れるのが遅くなったり",
            "Chinese": "然后，有时候把要洗的衣服放进去就会晚一点，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:30:47",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:31:12",
            "content": "そうするとグズとか",
            "Chinese": "这样她就会说我磨蹭。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:31:19",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:31:40",
            "content": "グズとは言われたくないですね",
            "Chinese": "真不想被说是“磨蹭”呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:31:52",
            "content": "はい。疲れてるのにあんたの世話もしなきゃいけないとか",
            "Chinese": "是的。她还会说“我都这么累了，还得照顾你”。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:31:52",
            "content": "バイトもしてるのに。",
            "Chinese": "明明你也在打工。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:32:06",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:32:30",
            "content": "バイト代で弟にアイス買ってあげたりしてるのに",
            "Chinese": "明明我还会用打工的钱给弟弟买冰淇淋。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:32:52",
            "content": "いいお姉さんですね。それとジュミさんも疲れてますよね。",
            "Chinese": "真是个好姐姐啊。而且朱米您自己也很累吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:32:54",
            "content": "お姉ちゃんなんだからもっと家事手伝ってって言われた",
            "Chinese": "她跟我说“你是姐姐，就应该多帮忙做家务”。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:33:07",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:33:24",
            "content": "私ばっかり",
            "Chinese": "都是我一个人……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:33:27",
            "content": "お姉ちゃんなんだからは、嫌ですね",
            "Chinese": "“因为你是姐姐所以……”这样的说法，确实让人讨厌呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:33:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:33:45",
            "content": "私ばっかりとなるのは、自然なことです。",
            "Chinese": "会觉得“怎么总是我”，这是很自然的。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:33:58",
            "content": "まあ、ずっといわれてるから",
            "Chinese": "嘛，因为一直被这么说。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:34:01",
            "content": "ジュミさん、",
            "Chinese": "朱米，"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:34:03",
            "content": "慣れてます",
            "Chinese": "我已经习惯了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:34:25",
            "content": "そんな中、本当にいいお姉さんだし、",
            "Chinese": "在这样的情况下，你真的是个好姐姐，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:34:41",
            "content": "バイトして、いろいろ頑張ってますね。",
            "Chinese": "还在打工，各方面都在努力呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:34:49",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:35:08",
            "content": "しかも嫌な言動から、耐えて、ジュミさんはすごいですよ。",
            "Chinese": "而且，您还忍受着那些让人不快的言行，朱米您很了不起哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:35:42",
            "content": "バイトで疲れたり時間的にも成績に影響しますからね。",
            "Chinese": "打工会累，时间上也会影响成绩嘛。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:36:20",
            "content": "家がこんなふうだから仕方ないです",
            "Chinese": "家里这样，也没办法。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:36:51",
            "content": "そのようにお考えなのですね。気を使ってみえるのですね。",
            "Chinese": "您是这么想的啊。您很体谅家里呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:37:26",
            "content": "でも、どんどん文句言われるし",
            "Chinese": "但是，还是不断地被抱怨。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:37:40",
            "content": "それは悔しいですね",
            "Chinese": "那真是很委屈呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:37:45",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:37:51",
            "content": "こんなに頑張っているのに。",
            "Chinese": "明明你已经这么努力了。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:37:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:38:42",
            "content": "ジュミさんは、どのようなことをするのが好きですか？",
            "Chinese": "朱米，你平时喜欢做些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:39:10",
            "content": "ゲームとかかな",
            "Chinese": "游戏之类的吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:39:29",
            "content": "ゲームで気晴らしもされてるのでしょうか？",
            "Chinese": "您会通过玩游戏来排解心情吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:40:29",
            "content": "はい、ゲームだと周りにはいない人とだから気が楽です",
            "Chinese": "是的，因为游戏里的人都不是现实中认识的人，所以感觉很轻松。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:41:11",
            "content": "そうなんですね。自分でそのように工夫してストレス発散されてるのですね。",
            "Chinese": "原来如此。你也会自己想办法来缓解压力呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:41:20",
            "content": "そうなのかなー",
            "Chinese": "是这样吗……"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:41:25",
            "content": "ただやってるだけ",
            "Chinese": "也就是随便玩玩而已。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:42:03",
            "content": "楽しめる時間を自分でとってるかと思います。学校とバイトで忙しい中で。",
            "Chinese": "我觉得你在学校和打工那么忙的情况下，还是为自己留出了享受的时间。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:42:18",
            "content": "お手伝いもですね。",
            "Chinese": "还有帮忙做家务呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:42:29",
            "content": "そうですね、学校とかあってどこもいくよゆうな",
            "Chinese": "是啊，因为要上学什么的，想去哪里都……"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:42:38",
            "content": "どっか行く余裕ないから",
            "Chinese": "根本没时间去别的地方。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:43:04",
            "content": "こんなことしてて生きてる意味あるのかな",
            "Chinese": "这样下去，我活着还有意义吗。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:43:17",
            "content": "母には怒られるし",
            "Chinese": "会被妈妈骂，"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:43:30",
            "content": "弟をひいきされるし",
            "Chinese": "她又偏袒弟弟。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:43:32",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:43:43",
            "content": "悔しいですね",
            "Chinese": "很委屈呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:43:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:44:10",
            "content": "いなくなっても困らないんだと思います",
            "Chinese": "我觉得就算我不在了，他们也不会困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:44:35",
            "content": "おかあさまと弟さんは、ジュミさんのおかげで助かってますよ。",
            "Chinese": "妈妈和弟弟，多亏了朱米才省了很多事哦。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:44:55",
            "content": "そうかなー",
            "Chinese": "是吗……"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:45:13",
            "content": "毎日文句ばっかりですよ",
            "Chinese": "可每天都是抱怨。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:45:34",
            "content": "ジュミさんがいなくなったら、もちろん困るし、悲しいですよ。口ではついついですね、、、",
            "Chinese": "如果朱米不在了，他们当然会困扰，会伤心的。只是嘴上不小心就……"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:46:06",
            "content": "実際私があんまり要領よくないから",
            "Chinese": "实际上我也不太利索。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:46:12",
            "content": "仕方ないんです",
            "Chinese": "也没办法的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:46:38",
            "content": "そうお感じなのですね。ジュミさんから観て、おかあさまの朝から寝るまでの生活ぶりで、どのように感じますか？",
            "Chinese": "您是那样感觉的啊。从朱米的角度看，母亲从早到晚的生活状态，你有什么感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:47:01",
            "content": "まあ、時間は忙しいです",
            "Chinese": "嗯，时间上是很忙。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:47:15",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:47:37",
            "content": "おかあさまもお辛いのでしょうか？",
            "Chinese": "您的妈妈是不是也很辛苦呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:48:04",
            "content": "後、弟の迎えとかサッカーの当番とか、つらいって言うか疲れるって言ってます",
            "Chinese": "还有，接弟弟、足球队轮值什么的，她也不是说辛苦，而是说很累。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:48:30",
            "content": "そうなんですね。日々の疲れがたまってるのですね。",
            "Chinese": "是这样啊。每天的疲劳都在积累呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:48:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:48:45",
            "content": "もしかすると、",
            "Chinese": "也许，"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:48:54",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:49:12",
            "content": "おかあさまは、ジュミさんに甘えてるのではと感じましたが、いかがでしょうか？",
            "Chinese": "我感觉，您妈妈是不是在向您撒娇呢？您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:49:35",
            "content": "大人に甘えられても・・・",
            "Chinese": "被大人撒娇也……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:49:51",
            "content": "そうお感じなのは、ごもっともです。",
            "Chinese": "您有这种感觉是理所当然的。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:49:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:50:36",
            "content": "ジュミさんは、大人は子供に甘えてはいけないと思われますか？甘える人が他にいなくても。",
            "Chinese": "朱米是觉得，大人不应该向孩子撒娇吗？即使没有其他可以撒娇的人。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:51:06",
            "content": "ああ。",
            "Chinese": "啊……"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:51:11",
            "content": "まあわかるけど",
            "Chinese": "嗯，虽然能理解。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:51:16",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:51:31",
            "content": "私は傷つきます",
            "Chinese": "但我会受伤。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:51:45",
            "content": "いえないけど",
            "Chinese": "虽然说不出口。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:52:08",
            "content": "さすが、ジュミさん、ある程度は理解されながらも、傷ついても我慢してるのですね。",
            "Chinese": "不愧是朱米，您在一定程度上理解了妈妈，即使受伤了也还是忍耐着呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/08/20(土) 15:52:57",
            "content": "高校生で立派ですね。",
            "Chinese": "作为高中生，真的很了不起。"
        },
        {
            "role": "クライアント",
            "time": "2022/08/20(土) 15:53:01",
