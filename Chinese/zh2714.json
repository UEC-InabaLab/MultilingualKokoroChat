    {
      "role": "client",
      "time": "2021-11-14T15:22:21",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "counselor",
      "time": "2021-11-14T15:23:32",
      "origin": "自分自身が緊張するように無意識に仕向けてしまいます。",
