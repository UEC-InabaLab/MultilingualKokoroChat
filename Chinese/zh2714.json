    },
    {
      "role": "client",
      "time": "2021-11-14T15:31:46",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "counselor",
      "time": "2021-11-14T15:33:11",
      "origin": "でも一生懸命練習してきたのだと思うし、",
