    },
    {
      "role": "client",
      "time": "2021-11-14T15:35:05",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "client",
      "time": "2021-11-14T15:35:29",
      "origin": "でも成功しないと思う。",
      "content": "但我觉得我不会成功。"
    },
    {
      "role": "client",
      "time": "2021-11-14T15:35:48",
      "origin": "練習でうまくいかないのに。",
      "content": "因为练习的时候都跳不好。"
    },
    {
      "role": "counselor",
      "time": "2021-11-14T15:36:12",
