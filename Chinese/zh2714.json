{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2021-11-14T14:53:40",
      "origin": "本日はよろしくお願いいたします。",
      "content": "今天请多关照。"
    },
    {
      "role": "client",
      "time": "2021-11-14T14:53:46",
      "origin": "こんにちは。本日よろしくおねがいします🙂",
