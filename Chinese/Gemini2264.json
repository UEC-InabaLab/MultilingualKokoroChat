{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 09:51:10",
            "content": "こんにちは。本日、どうぞよろしくお願いいたします。",
            "Chinese": "您好。今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 09:51:30",
            "content": "こんにちは。こちらこそ、よろしくお願い致します。",
            "Chinese": "您好。我也请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 09:52:20",
            "content": "どうもありがとうございます。お時間になりましたら、はじめさせていただきます。",
            "Chinese": "非常感谢您。时间到了我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 09:52:35",
            "content": "はい、よろしくお願い致します。",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:00:13",
            "content": "こんにちは。相談員です。ご相談におこしいただいて、どうもありがとうございます。",
            "Chinese": "您好，我是咨询师。非常感谢您前来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:00:33",
            "content": "ご相談開始にあたって、最初に年齢性別をお聴きしてもよろしいでしょうか。",
            "Chinese": "在开始咨询之前，我可以先请问您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:00:50",
            "content": "15歳　女性です",
            "Chinese": "15岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:01:02",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:01:13",
            "content": "今日はどうなさいましたか。",
            "Chinese": "今天想谈些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:01:45",
            "content": "友達が、クラスの子に意地悪をしています",
            "Chinese": "我的朋友在欺负班上的同学。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:02:36",
            "content": "そうなのですね。それは気になりますね。",
            "Chinese": "是这样啊。那确实让人担心呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:02:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:03:03",
            "content": "ちなみに、学年は中学何年生ですか",
            "Chinese": "顺便问一下，您是初中几年级呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:03:14",
            "content": "3年です",
            "Chinese": "初三。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:03:31",
            "content": "ありあがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:05:03",
            "content": "どんな状況か詳しくお話しお聴きしたいのですが・・・。",
            "Chinese": "我想听您详细谈谈具体是什么样的情况……"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:05:09",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:05:25",
            "content": "お話ししやすいところからお話しひてくださいね。",
            "Chinese": "您从方便开口的地方说起就行。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:05:45",
            "content": "無視をしたり",
            "Chinese": "比如无视她，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:06:15",
            "content": "ええ・・。",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:06:18",
            "content": "その子だけプリント渡さなかったり",
            "Chinese": "或者只不给她发讲义之类的。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:06:26",
            "content": "そんな感じです",
            "Chinese": "大概就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:07:31",
            "content": "そうなのですね。苦しくなりますね。",
            "Chinese": "是这样啊。看着确实让人难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:07:41",
            "content": "嫌です",
            "Chinese": "我很讨厌这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:07:58",
            "content": "そう思われるのですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:08:03",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:08:58",
            "content": "嫌な気持ちをもう少し詳しくお話ししていただいても、いいでしょうか。",
            "Chinese": "您可以再详细地谈谈这种“讨厌”的感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:10:17",
            "content": "うーん…",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:11:31",
            "content": "ごめんなさい。少し、答えにくかったですね。",
            "Chinese": "抱歉，这个问题可能有点难回答。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:12:05",
            "content": "嫌の詳しくが分かりません",
            "Chinese": "我不太明白要怎么详细描述“讨厌”的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:12:43",
            "content": "ごめんなさい。いいかえますね。",
            "Chinese": "抱歉，我换个说法。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:13:09",
            "content": "すみません",
            "Chinese": "不好意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:14:26",
            "content": "いいえ、こちらこそ。お友達がクラスの子に意地悪しているとき、あなたは、お友達に対して、どんな気持ちになりますか。",
            "Chinese": "不，该道歉的是我。当您的朋友欺负班上同学时，您对这位朋友是什么样的感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:14:59",
            "content": "なぜ、そんな事するのかなって思います。",
            "Chinese": "我会想，她为什么要那么做呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:15:39",
            "content": "そう思われるのですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:15:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:16:18",
            "content": "そう思われるのは、つらいですね。",
            "Chinese": "有这样的想法，您心里也一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:16:53",
            "content": "相手の子も可哀想だし、友達には意地悪をして欲しくないです",
            "Chinese": "被欺负的同学很可怜，而且我不希望我的朋友欺负别人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:17:30",
            "content": "そうですね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:17:45",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:18:21",
            "content": "あなたは、お二人のことを大切に思われているのですね。",
            "Chinese": "您很珍视她们两个人呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:19:30",
            "content": "友達は、本当は優しい子だから、意地悪なとこを見るのは嫌です",
            "Chinese": "我的朋友其实是个很善良的人，所以我不想看到她欺负人的一面。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:19:52",
            "content": "そうなのですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:19:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:20:21",
            "content": "そう思われると、本当にお辛い時間を過ごされていますね。",
            "Chinese": "有这样的想法，您这段时间一定过得很煎熬吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:20:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:21:18",
            "content": "この状況はいつごろからですか",
            "Chinese": "这种情况是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:22:04",
            "content": "3年になったくらい",
            "Chinese": "大概是升上初三的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:22:52",
            "content": "そうなのですね。これまで、悩んでいらしたのは、お辛かったですね。",
            "Chinese": "是这样啊。这段时间以来您一直为此烦恼，一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:23:47",
            "content": "そこまで辛いって感じじゃないけと、ちょっと嫌だなぁって思います",
            "Chinese": "虽然还没到痛苦的程度，但还是觉得有点讨厌。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:23:47",
            "content": "これから、あなたが、少しでも楽になれるよう一緒に考えていきたいと思います。",
            "Chinese": "接下来，我希望能和您一起思考，怎样能让您稍微轻松一些。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:23:56",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:24:12",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:25:36",
            "content": "お友達は、本当は優しい子と感じられているのに、意地悪されているのは、悲しいですね。",
            "Chinese": "明明您觉得朋友其实是个很善良的人，却看到她欺负别人，这一定很难过吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:25:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:27:28",
            "content": "お友達が意地悪し始めたとき、あなたが何かかわったように感じたことありますか",
            "Chinese": "在您的朋友开始欺负人时，您有感觉到她有什么变化吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:28:34",
            "content": "友達が変わったかってことですか？",
            "Chinese": "您是问我的朋友有没有变吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:29:48",
            "content": "お友達が、意地悪する前と、し始めてからのお友達の態度、とかこうどうとか・・・。です。",
            "Chinese": "是指您朋友在开始欺负人之前和之后，她的态度或者行为之类的……。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:30:13",
            "content": "私にはいつも通りです。",
            "Chinese": "她对我跟平常一样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:31:14",
            "content": "そうなのですね。わかりにくくて、ごめんなさいね。",
            "Chinese": "是这样啊。我问得不够清楚，抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:31:26",
            "content": "すみません",
            "Chinese": "不好意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:32:15",
            "content": "いえいえ、こちらこそ。",
            "Chinese": "不不，是我该说抱歉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:33:16",
            "content": "意地悪をみること、苦しいですよね。",
            "Chinese": "看到朋友欺负人，确实很让人难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:33:38",
            "content": "ちょっと嫌な気分になります",
            "Chinese": "会觉得有点不舒服。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:33:53",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:33:58",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:34:14",
            "content": "一緒にいても、落ち着かないですよね。",
            "Chinese": "就算待在一起，心里也不踏实吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:35:11",
            "content": "私には意地悪はしないので、大丈夫です",
            "Chinese": "她不会对我使坏，所以没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:35:42",
            "content": "そうなのですね。意地悪の状態は、どんな頻度でされているのでしょうか",
            "Chinese": "原来如此。这种欺负行为的频率大概是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:36:47",
            "content": "クラスと部活が一緒だから、まあまああるかも…",
            "Chinese": "因为我们同班又同社团，可能还挺频繁的……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:37:23",
            "content": "よく、見られる状況なのですね。",
            "Chinese": "也就是说，这是您经常能看到的情况呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:37:36",
            "content": "かもしれません",
            "Chinese": "可能吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:37:48",
            "content": "お友達の気持ちをいろいろ考えると悩ましいですね。",
            "Chinese": "一想到朋友的各种心情，确实很让人纠结呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:37:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:38:20",
            "content": "そして、頻度が多いと、ストレスに感じますね。",
            "Chinese": "而且，频率高了的话，也会感到有压力吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:38:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:40:36",
            "content": "ここで、いったん、お話しをまとめさせていただいても、よろしいでしょうか。",
            "Chinese": "那么，我可以先在这里总结一下我们刚才谈话的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:40:44",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:41:01",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:41:58",
            "content": "お友達が、クラスの子に意地悪をしていまる状況をみて、苦しい思いをされてご相談にいらっしゃいました。",
            "Chinese": "您因为看到朋友欺负班上同学而感到难受，所以前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:42:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:43:13",
            "content": "意地悪の状況をみて、なぜ、そんな事するのかなって思われています。お友達は、本当は優しい子だから、意地悪なとこを見たくないと思われています。",
            "Chinese": "看到她欺负人的情景，您会想“她为什么要这么做呢”。您觉得朋友本来是个善良的人，所以不想看到她欺负人的一面。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:43:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:43:50",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:45:38",
            "content": "あなたは、苦しいなか、よくご相談にいらしてくださいましたね。",
            "Chinese": "您在这么难受的情况下，还能鼓起勇气前来咨询，真的很了不起。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:45:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 10:46:58",
            "content": "意地悪をすることは、よくないとおもわれる中、意地悪をしてしまうお友達のことを考えるのは、葛藤があるかと思います。",
            "Chinese": "您一方面认为欺负人是不对的，另一方面又在为做这件事的朋友着想，心里一定很纠结吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 10:47:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
