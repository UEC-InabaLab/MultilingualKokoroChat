{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:12:25",
            "content": "シナモンさん、よろしくお願いします。遅い時間スタート大丈夫でしょうか？",
            "Chinese": "西纳蒙同学，您好。这么晚开始，没问题吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:12:40",
            "content": "はい",
            "Chinese": "嗯，没问题。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:12:50",
            "content": "早速始めてくださいね",
            "Chinese": "那就请马上开始吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:12:59",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:13:28",
            "content": "こんばんは。相談員です。差し支えなければ、年齢と性別をおしえていただけますか",
            "Chinese": "晚上好。我是咨询员。如果方便的话，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:14:04",
            "content": "14才、女子です",
            "Chinese": "14岁，女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:14:07",
            "content": "教えてくださりありがとうございます。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:14:18",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:14:36",
            "content": "友達があまりできません",
            "Chinese": "我不太能交到朋友。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:14:45",
            "content": "作り方を教えて下さい",
            "Chinese": "请教我怎么交朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:15:42",
            "content": "そうなんですねお困りなんですね",
            "Chinese": "是这样啊，您正为此感到困扰是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:15:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:16:19",
            "content": "今学年は何年生ですか？",
            "Chinese": "您现在是几年级呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:16:31",
            "content": "中1です",
            "Chinese": "初一。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:17:49",
            "content": "今年入学したばかりなんですねちなみに、小学校から一緒のお友達とかはいますか？",
            "Chinese": "您是今年刚入学的啊。顺便问一下，有没有从小学就一起上来的朋友？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:18:24",
            "content": "いないです",
            "Chinese": "没有。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:18:30",
            "content": "受験したので。",
            "Chinese": "因为我参加了升学考试。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:19:51",
            "content": "（中1は13才ですね。すみません間違えました。）",
            "Chinese": "（初一是13岁对吧。不好意思，我搞错了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:19:56",
            "content": "そうだったんですね。頑張ったんですね。誰も知っているお友達もいない中学に通っていて、親しいお友達もいないと、心細くなってしまいますよね。",
            "Chinese": "原来是这样啊。您真的很努力呢。在一所完全没有认识的同学的中学里，又没有亲密的朋友，会觉得孤单、心里没底吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:20:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:20:32",
            "content": "（いえ、13歳ということで続けますね）",
            "Chinese": "（没关系，那就按13岁继续聊吧。）"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:20:45",
            "content": "（お願いします）",
            "Chinese": "（好的，麻烦您了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:22:27",
            "content": "友達といっても、今回の相談は親しいお友達が欲しいという相談でよかったんでしようか？",
            "Chinese": "您说的朋友，是希望交到亲密的朋友，我这样理解对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:22:47",
            "content": "そんな感じです",
            "Chinese": "差不多是这样。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:22:57",
            "content": "でもあんまりいないので",
            "Chinese": "但是我几乎没有朋友。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:23:11",
            "content": "もっと友達ができたらいいなと思ってます",
            "Chinese": "我希望能交到更多的朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:23:52",
            "content": "うん、うん本当は話せる友達がたくさんいたら、ってことですね",
            "Chinese": "嗯嗯，您的意思是，如果能有很多可以聊天的朋友就好了，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:24:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:24:35",
            "content": "どうしたらあなたの希望が叶うのか、一緒に考えましょうね。",
            "Chinese": "我们一起来想想该怎么做，才能实现您的愿望吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:24:47",
            "content": "お願いします",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:25:01",
            "content": "いくつか質問しても大丈夫ですか？",
            "Chinese": "我可以问您几个问题吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:25:08",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:25:42",
            "content": "小学校の頃は、親しいお友達はいましたか？",
            "Chinese": "您上小学的时候，有亲密的朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:26:07",
            "content": "あんまりいなかったです",
            "Chinese": "不太有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:27:18",
            "content": "そうだったんですね。だったら、なおさら今の中学でお友達ができたら、って思いますよね。",
            "Chinese": "原来是这样啊。那您肯定更希望能在现在这所中学交到朋友了吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:27:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:27:56",
            "content": "受験されたってことですけど、今の中学はとっても行きたい中学だったんでしょうか？",
            "Chinese": "您说您参加了升学考试，现在这所中学是您非常想上的学校吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:28:11",
            "content": "まあまあです",
            "Chinese": "还行吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:28:58",
            "content": "そっか・・まあまあというのは、本当はもっと行きたい学校とかがあったのかしら？",
            "Chinese": "这样啊……您说“还行”，是不是其实还有更想去的学校呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:29:24",
            "content": "そういうわけではなくて",
            "Chinese": "也不是那样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:29:51",
            "content": "ええ（続けてくださいね）",
            "Chinese": "嗯（请继续说）。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:30:36",
            "content": "小学校が同じ子がいない学校もいいかなって",
            "Chinese": "我当时觉得，去一所没有小学同学的学校也许也不错。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:30:44",
            "content": "受験しました",
            "Chinese": "所以就去参加考试了。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:30:59",
            "content": "でも思うようにいきません",
            "Chinese": "但事情没有像我想的那样顺利。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:32:28",
            "content": "そう思って受験されたんですね。知っているお友達がいない学校を選んだのは、どんな気持ちからなんでしょう？",
            "Chinese": "原来您是带着这样的想法去参加考试的啊。选择一所没有认识的朋友的学校，是出于一种什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:33:03",
            "content": "あんまり仲が良かったわけではないし",
            "Chinese": "因为和小学同学关系也不是很好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:33:22",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:33:48",
            "content": "自分のことを知らない人ばかりのところもいいかなって思いました",
            "Chinese": "我觉得，去一个没人了解自己的新环境可能也不错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:34:40",
            "content": "そうだったんですね。自分のことを知らない全く新しい環境にしたかったんですね。",
            "Chinese": "原来是这样。您是想换到一个没人了解自己、一个全新的环境里去，是这样吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:34:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:35:34",
            "content": "でも思うようにいきません",
            "Chinese": "但事情并不如我所愿。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:35:39",
            "content": "どうしたらいいですか？",
            "Chinese": "我该怎么办呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:36:24",
            "content": "どうしたらいいか悩んでしまいますよねちなみに、普段お友達には、自分から声をかけたりはしてますか？",
            "Chinese": "是啊，是会烦恼该怎么办呢。顺便问一下，平时您会主动和同学搭话吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:37:12",
            "content": "あんまりかけてません",
            "Chinese": "不怎么主动搭话。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:37:30",
            "content": "あいさつくらいです",
            "Chinese": "最多就是打个招呼。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:38:22",
            "content": "そうだったんですね。挨拶はしているけれど・・その先の言葉が出てこない感じなのかしら？",
            "Chinese": "原来是这样啊。您会打招呼……但之后就不知道该说什么了，是这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:38:39",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:39:28",
            "content": "あなたが、話してみたいようなお友達はいますか？（気が合いそうな感じの）",
            "Chinese": "有您想试着聊聊看的同学吗？（感觉可能会合得来的那种）"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:39:56",
            "content": "はい",
            "Chinese": "有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:40:44",
            "content": "気が合いそうなお友達がいて良かったです。どんなところが気が合いそうな感じがしますか？？",
            "Chinese": "有感觉可能会合得来的同学，这真是太好了。您觉得是哪些地方让您感觉会合得来呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:41:16",
            "content": "楽しそうに話してるところです",
            "Chinese": "就是看他们聊天聊得很开心的样子。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:41:35",
            "content": "うん、うんそうなんですね。",
            "Chinese": "嗯嗯，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:42:25",
            "content": "どんな内容が楽しそうって思うのでしょうか？",
            "Chinese": "您觉得他们聊的什么内容看起来很开心呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:43:02",
            "content": "内容はわかりません",
            "Chinese": "具体内容我不知道。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:43:35",
            "content": "楽しそうだなって見てるだけなので",
            "Chinese": "因为我只是在旁边看着，觉得他们很开心的样子。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:44:11",
            "content": "遠巻きに見て楽しそうだなって、見てるんですね。今、部活とかは入っていますか？",
            "Chinese": "您是远远地看着，觉得他们聊得很开心，是这样啊。您现在有参加什么社-团活动吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:45:15",
            "content": "入ってるけどあんまり行ってないです",
            "Chinese": "参加了，但不怎么去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:46:00",
            "content": "そうなんですね・・どんな部活なんでしょうか？",
            "Chinese": "是这样啊……是什么社团呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:46:15",
            "content": "演劇です",
            "Chinese": "话剧社。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:46:45",
            "content": "演劇部なんですね。素敵ですね。",
            "Chinese": "是话剧社啊，真棒呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:47:01",
            "content": "でも行ってないです",
            "Chinese": "但我没怎么去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:47:39",
            "content": "どんなことで行ってないのか、よかったら教えてもらえますか？",
            "Chinese": "如果方便的话，能告诉我您为什么不常去吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:48:09",
            "content": "つまらないからです",
            "Chinese": "因为很无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:48:53",
            "content": "そうなんですね・・つまらなく感じてしまうんですね。どうしてそう思うのかしら？",
            "Chinese": "是这样啊……您觉得很无聊是吗。为什么会这么觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:49:22",
            "content": "どうしたら友達できますか？",
            "Chinese": "到底要怎样才能交到朋友？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:49:27",
            "content": "作り方を教えて下さい",
            "Chinese": "请告诉我方法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:52:15",
            "content": "あなたは、友達と楽しそうに話がしたいって思っているんですよねあなたの興味があることや、好きなことをきっかけにお友達に話かけられたらどうかな、と思うのですが、",
            "Chinese": "您是想和朋友开心地聊天，对吧。我想，如果能以您感兴趣或者喜欢的事物为契机，去和同学搭话，您觉得怎么样呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:52:47",
            "content": "どんなことが興味があって、好きなことがあったら教えてもらえますか？",
            "Chinese": "能告诉我您对什么感兴趣，或者喜欢什么吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:53:10",
            "content": "それをヒントに考えたいと思います。",
            "Chinese": "我想以此为线索，和您一起想个办法。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:53:49",
            "content": "テレビドラマとか",
            "Chinese": "比如电视剧之类的。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:54:00",
            "content": "芸能人とかです",
            "Chinese": "还有明星之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:54:07",
            "content": "うん、うん他には？",
            "Chinese": "嗯嗯，还有其他的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/28(水) 21:54:22",
            "content": "そんなにありません",
            "Chinese": "不太多了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:54:33",
            "content": "教えてくださりありがとうございます。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/28(水) 21:55:57",
            "content": "最近見たテレビドラマのことを話題にして、お友達に話かけてみたらどうかな？と思うのですが、どう思いますか？",
            "Chinese": "拿最近看的电视剧当话题，去和同学搭话，您觉得怎么样？"
        },
        {
            "role": "クライアント",
