{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:21:04",
            "content": "（こんばんは。よろしくお願いいたします。）",
            "Chinese": "（晚上好。请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:21:45",
            "content": "(こんばんは。宜しくお願いします)",
            "Chinese": "（晚上好。请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:30:05",
            "content": "こんばんは。相談員です。ご相談にいらしてくださり、ありがとうございます。はじめに、年齢と性別、今日ご相談したいことを教えてください。",
            "Chinese": "晚上好。我是咨询员。感谢您前来咨询。首先，请告诉我您的年龄、性别以及今天想咨询的事情。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:30:40",
            "content": "12歳、男、いじめられてます。",
            "Chinese": "12岁，男，在被欺负。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:31:08",
            "content": "教えてくれて、ありがとうございます。そうなんですね。",
            "Chinese": "谢谢你告诉我。原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:31:18",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:31:51",
            "content": "つらい気持ちで相談に来てくださったんですね。",
            "Chinese": "你是怀着痛苦的心情来咨询的吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:32:06",
            "content": "そうだよ。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:32:40",
            "content": "いつからいじめられていますか？",
            "Chinese": "从什么时候开始被欺负的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:33:03",
            "content": "ことしのはじめから。",
            "Chinese": "从今年年初开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:33:35",
            "content": "そうだったんですね。ずっと苦しい気持ちで過ごしてきたんですね。",
            "Chinese": "原来是这样。你一直都过得很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:33:53",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:34:35",
            "content": "学校へは、行っていますか？",
            "Chinese": "你还去上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:34:48",
            "content": "いってるよ。",
            "Chinese": "去的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:35:30",
            "content": "そうなんですね。いじめてくるのは、どんな子ですか？",
            "Chinese": "是这样啊。欺负你的是什么样的孩子呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:36:12",
            "content": "クラスの男から。",
            "Chinese": "班里的男生。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:37:13",
            "content": "同じクラスの子なんですね。毎日、がんばって学校に行っているんですね。",
            "Chinese": "是同班同学啊。你每天都努力去上学，真不容易。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:37:46",
            "content": "行きたくないけど、お母さんに心配かけたくないから。",
            "Chinese": "虽然不想去，但不想让妈妈担心。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:38:27",
            "content": "そうなんですね。お母さんのことを思っているんですね。",
            "Chinese": "是这样啊。你很为妈妈着想呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:38:36",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:38:55",
            "content": "とても優しいんですね。",
            "Chinese": "你真的很体贴。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:39:10",
            "content": "ありがと。",
            "Chinese": "谢谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:40:23",
            "content": "お母さんに心配かけないように、と教えてくれましたね。他の家族の人は、あなたがつらい思いをしていることを知っていますか？",
            "Chinese": "你刚才告诉我，是为了不让妈妈担心。那其他的家人知道你现在很痛苦吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:40:42",
            "content": "お母さんしかいないから。",
            "Chinese": "因为我只有妈妈。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:41:18",
            "content": "そうだったんですね。たったひとりの家族だからこそ、心配かけたくないと思っているんですね。",
            "Chinese": "原来是这样。正因为是唯一的家人，所以才更不想让她担心吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:41:34",
            "content": "うん、そうだよ。",
            "Chinese": "嗯，是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:42:19",
            "content": "ずっとひとりでつらい気持ちを持って、頑張ってきているんですね。",
            "Chinese": "你一直一个人忍受着痛苦，坚持到现在，真的很努力。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:42:33",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:43:08",
            "content": "あなたはとても頑張り屋さんなんですね。学校の先生は、あなたにどんなことをしてくれていますか？",
            "Chinese": "你真的很努力呢。学校的老师为你做了些什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:43:57",
            "content": "先生はいじめる奴らと仲が良いから嫌い。",
            "Chinese": "老师和欺负我的那些家伙关系很好，所以我讨厌他。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:44:33",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:44:45",
            "content": "そうだよ。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:45:26",
            "content": "いつも学校ではどんなふうにして過ごしていますか？",
            "Chinese": "你平时在学校都怎么度过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:45:49",
            "content": "絵を描いてるよ。",
            "Chinese": "我在画画。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:46:34",
            "content": "そうなんですね。絵を描くことが好きなんですね。",
            "Chinese": "是这样啊。你喜欢画画呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:47:07",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:48:27",
            "content": "絵を描くことのほかに、どんなことをしていますか？",
            "Chinese": "除了画画，还会做些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:49:07",
            "content": "絵を描いてるだけ。",
            "Chinese": "只是在画画。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:49:40",
            "content": "そうなんですね。絵を描いているとき、どんなことを考えていますか？",
            "Chinese": "是这样啊。画画的时候，你在想些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:49:58",
            "content": "お父さんのこと。",
            "Chinese": "爸爸的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:50:30",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:50:38",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:53:06",
            "content": "（ロールプレイ中にすみませんが、少しお尋ねしてよろしいでしょうか？）",
            "Chinese": "（不好意思，在角色扮演中打扰一下，可以问个问题吗？）"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:53:21",
            "content": "(はい)",
            "Chinese": "（好的。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:53:49",
            "content": "（昨日と似た内容でお話になられているのは、意図があって、ということでよろしいでしょうか？）",
            "Chinese": "（您今天聊的内容和昨天很相似，请问这是您有意为之的吗？）"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:54:22",
            "content": "(同じかたですか？)",
            "Chinese": "(是同一个人吗？)"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:54:29",
            "content": "（はい）",
            "Chinese": "（是的）"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:54:49",
            "content": "(わかりました。かえます。)",
            "Chinese": "(我明白了。我换个话题。)"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:55:20",
            "content": "（ありがとうございます。ではここから続けさせていただきます）",
            "Chinese": "（谢谢您。那么我从这里继续。）"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:55:32",
            "content": "(はい)",
            "Chinese": "（好的。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:56:06",
            "content": "お父さんは、今、どうしていますか？",
            "Chinese": "你爸爸现在怎么样了？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:56:35",
            "content": "他の女の人といる。",
            "Chinese": "他和别的女人在一起。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:57:06",
            "content": "そうだったんですね。お父さんに会いたいですね。",
            "Chinese": "原来是这样。你想见爸爸吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:57:42",
            "content": "うん。会いたいけど、お母さんが会えないって。なんで。",
            "Chinese": "嗯。我想见，但妈妈说不能见。为什么呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:58:24",
            "content": "お母さんは、なんと言っていますか？",
            "Chinese": "妈妈是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:59:00",
            "content": "お父さんは。新しい家族ができたんだって。",
            "Chinese": "（妈妈说）爸爸已经有了新的家庭。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 21:59:28",
            "content": "会えないの？",
            "Chinese": "见不到了吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 21:59:57",
            "content": "そうなんですね。でもあなたのお父さんなんだから、会いたいですね。",
            "Chinese": "是这样啊。但他毕竟是你的爸爸，你肯定想见他吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:00:27",
            "content": "会いたいし。いじめるやつを倒してほしい。",
            "Chinese": "想见他，也希望他能帮我打倒欺负我的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:00:54",
            "content": "ええ、お父さんに助けて欲しいんですね。",
            "Chinese": "嗯，你希望爸爸能帮助你。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:01:02",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:01:43",
            "content": "お母さんに、あなたの気持ちを話してみたことはありますか？",
            "Chinese": "你有试着把你的感受跟妈妈说吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:02:08",
            "content": "お母さんはいつも、いない。",
            "Chinese": "妈妈总是不在。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:02:34",
            "content": "そうなんですね。お母さんは、いつもどこに行っていますか？",
            "Chinese": "是这样啊。妈妈一般都去哪里呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:02:35",
            "content": "寝てる。",
            "Chinese": "在睡觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:02:42",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:02:59",
            "content": "なんか、夜のお仕事だって。",
            "Chinese": "好像是做晚上的工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:03:23",
            "content": "そうなんですね。お母さんは頑張って働いているんですね。",
            "Chinese": "是这样啊。妈妈很努力地在工作呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:03:33",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:03:53",
            "content": "あなたは、いつも夜はどんなふうに過ごしていますか？",
            "Chinese": "你平时晚上都是怎么过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:04:35",
            "content": "お弁当、食べてから。寝るよ。",
            "Chinese": "吃完便当，就睡觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:05:02",
            "content": "そうなんですね。ひとりで頑張って留守番しているんですね。",
            "Chinese": "原来如此。你一个人努力看家，真不容易。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:05:14",
            "content": "うん。さみしい。",
            "Chinese": "嗯。好寂寞。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:05:43",
            "content": "ええ、ひとりで過ごすのは、さみしいですね。お母さんもあなたも、とても頑張っているんですね。",
            "Chinese": "嗯，一个人过确实会很寂寞。你和妈妈都非常努力呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:06:08",
            "content": "そうだよ。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:07:12",
            "content": "あなたとお母さんは、お互いのことをとても思いやっているんですね。今、さみしい気持ちを教えてくれました。あなたは、本当はどうしたいですか？",
            "Chinese": "你和妈妈都非常体谅对方呢。你刚才告诉我你感到寂寞。那你真正想做的是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:07:53",
            "content": "お母さんにいじめられてることを言いたいけど。",
            "Chinese": "我想跟妈妈说我被欺负的事，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:08:11",
            "content": "ええ。言ったら、どうなりそうですか？",
            "Chinese": "嗯。如果说了，你觉得会怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:08:49",
            "content": "あさしか、会えないから、むずかしい。",
            "Chinese": "因为只有早上才能见到，所以很难说。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:09:35",
            "content": "そうなんですね。ゆっくり話す時間がないんですね。",
            "Chinese": "是这样啊。没有时间可以好好聊聊。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:09:44",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:10:26",
            "content": "お母さんがお仕事お休みの日には、あなたとお母さんは、どんなふうに過ごしていますか？",
            "Chinese": "妈妈休息的日子，你们会怎么一起度过呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:11:17",
            "content": "絵を描いたりしてる。",
            "Chinese": "画画之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:11:57",
            "content": "ふたりで一緒に過ごしているんですね。",
            "Chinese": "你们会两个人一起度过呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:12:10",
            "content": "少しだけ。",
            "Chinese": "只有一小会儿。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/22(金) 22:12:31",
            "content": "ええ、お母さんはいそがしいんですね。",
            "Chinese": "嗯，妈妈很忙呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:12:45",
            "content": "うん。よくわからない。",
            "Chinese": "嗯。我也不太清楚。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:13:20",
            "content": "話したいけど。いないし。時間ないし。",
            "Chinese": "想和她说，但她不在，也没时间。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/22(金) 22:13:42",
            "content": "どうしたいい？",
            "Chinese": "我该怎么办？"
        },
        {
            "role": "カウンセラー",
