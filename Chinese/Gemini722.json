{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 09:55:09",
            "content": "おはようございます。よろしくお願いします。",
            "Chinese": "早上好。請多關照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 09:59:51",
            "content": "おはようございます。",
            "Chinese": "早上好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:00:08",
            "content": "本日はよろしくお願いします。",
            "Chinese": "今天請多關照。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:00:21",
            "content": "よろしくお願いします。",
            "Chinese": "請多關照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:00:40",
            "content": "時間になったので始めますね。",
            "Chinese": "時間到了，我們開始吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:00:45",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:01:14",
            "content": "おはようございます。相談員です。本日はどういったご相談でしょうか。",
            "Chinese": "早上好。我是諮詢員。今天您想諮詢些什麼呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:01:29",
            "content": "この頃仕事に行きたくないのです。",
            "Chinese": "最近我不太想去上班。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:01:45",
            "content": "そうなのですね。",
            "Chinese": "是這樣啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:01:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:02:03",
            "content": "なぜそう思うのでしょうか。",
            "Chinese": "您為什麼會這麼想呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:02:17",
            "content": "つまらないと感じるのです。",
            "Chinese": "我覺得很無聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:02:31",
            "content": "なるほど。",
            "Chinese": "原來如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:02:59",
            "content": "つまらないとやる気も出ませんよね。",
            "Chinese": "如果覺得無聊，確實自然就提不起幹勁了呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:03:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:03:40",
            "content": "なぜつまらないのですか？",
            "Chinese": "為什麼會覺得無聊呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:04:21",
            "content": "う～ん、楽しいと感じられなくて",
            "Chinese": "嗯……感覺不到樂趣。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:04:28",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:05:09",
            "content": "必要とされている気がしないのです。",
            "Chinese": "我感覺自己不被需要。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:05:26",
            "content": "そうなのですね。",
            "Chinese": "是這樣啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:06:06",
            "content": "パートに転向してから同じ仕事なのですが、つまらなくて",
            "Chinese": "轉為兼職後，工作內容還是一樣的，但就是覺得很無聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:06:20",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:07:48",
            "content": "ただ、時間に行って、時間になったら帰っている感じです。",
            "Chinese": "感覺就是到點上班，到點下班而已。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:08:05",
            "content": "なるほど。",
            "Chinese": "原來如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:08:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:08:36",
            "content": "それでは作業感がありますね。",
            "Chinese": "那樣的話，確實會有一種機械化作業的感覺呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:09:09",
            "content": "パートに転向とおっしゃっていましたが、",
            "Chinese": "您剛才提到轉為了兼職，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:09:35",
            "content": "もともとは正社員か何かで別のおしごとを？",
            "Chinese": "那您原先是正式員工之類的，做著其他工作嗎？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:10:23",
            "content": "仕事は同じで、職場も同じです。時間を短くしました。体の負担を減らしたくて。",
            "Chinese": "工作內容和工作地點都沒變，只是縮短了工作時間，因為想減輕身體的負擔。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:10:43",
            "content": "そうなのですね。",
            "Chinese": "是這樣啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:11:01",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:11:10",
            "content": "以前はつまらないと感じていなかったのですか？",
            "Chinese": "您以前並不覺得無聊嗎？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:11:34",
            "content": "はい忙しくて",
            "Chinese": "是的，因為很忙。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:11:42",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:12:25",
            "content": "忙しさの中にも充実感がありました。が、体を治したくて。",
            "Chinese": "雖然很忙，但忙碌中也很有充實感。不過，我還是想把身體養好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:12:58",
            "content": "そうなのですね。",
            "Chinese": "是這樣啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:13:17",
            "content": "無理に話さなくても良いですが、",
            "Chinese": "如果您不想說也沒關係，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:13:56",
            "content": "お体のほうはすぐには治らないような状態なのですか？",
            "Chinese": "您的身體情況是那種短期內不太容易恢復的嗎？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:14:24",
            "content": "右手に",
            "Chinese": "我的右手……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:14:30",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:14:42",
            "content": "右手の親指にちからがはいらなくなって",
            "Chinese": "右手的大拇指使不上勁了，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:15:03",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:15:05",
            "content": "文字が書けなくなってしまい。仕事になりません",
            "Chinese": "導致無法寫字，工作也就沒法做了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:15:19",
            "content": "それはおつらいですね。。。",
            "Chinese": "那一定很難受吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:15:39",
            "content": "右手の使い過ぎと言われました。根本的な治療はありません。",
            "Chinese": "醫生說是右手使用過度。沒有能根治的方法。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:15:50",
            "content": "なるほど。",
            "Chinese": "原來如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:16:24",
            "content": "休ませて自然と経過を見るしかないのでしょうか。。。",
            "Chinese": "只能讓它休息，順其自然地觀察恢復情況了嗎……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:16:33",
            "content": "そうなのです。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:17:00",
            "content": "それで仕事時間を短くし、",
            "Chinese": "所以您就縮短了工作時間，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:17:47",
            "content": "仕事内容も簡単な作業なのですか？",
            "Chinese": "工作內容也變得簡單一些了嗎？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:19:16",
            "content": "はい。病院もいろいろ行ってみたのですが、結果は同じで。仕事は簡単な作業ではありませんが、責任は大きくはないです。",
            "Chinese": "是的。我也去了好幾家醫院，但結果都一樣。工作內容本身不簡單，但責任沒有以前那麼重了。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:19:40",
            "content": "体の負担は少なくなりました。",
            "Chinese": "身體的負擔確實是減輕了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:19:40",
            "content": "そうなのですね。。。",
            "Chinese": "是這樣啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:20:47",
            "content": "ご相談者様は仕事に対し、忙しくとも責任感がありやりがいがある状態をお望みなのですね。",
            "Chinese": "看來您是希望工作即使忙碌，也能從中感受到責任和價值，是這樣嗎？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:22:29",
            "content": "今は、どっちつかずで。仕事はつまらなく感じるし、文字は思うように書けないし・・・で。",
            "Chinese": "現在就處於一種不上不下的狀態。工作覺得無聊，字也寫得不順心……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:22:56",
            "content": "やはり、体を治して戻りたいです。",
            "Chinese": "我還是想治好身體，回到以前的狀態。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:23:05",
            "content": "そのはざまにいる状態はつらいですよね。。。",
            "Chinese": "處在這種夾縫中的狀態，一定很難受吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:23:10",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:23:51",
            "content": "ご相談者様としては「今後こうなってほしい」という希望は、",
            "Chinese": "對您而言，關於「今後希望變成什麼樣」的期望，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:24:21",
            "content": "「体を直して元の状態に復帰」でしょうか。",
            "Chinese": "是「養好身體，恢復到原來的狀態」嗎？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:26:11",
            "content": "それとも別の希望がありますか？",
            "Chinese": "還是說有別的期望呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:26:12",
            "content": "戻りたい気もしますが、また、指に力が入らなくなるのは、困るので、今の形で、仕事に向かう気持ちを持ちたいです。",
            "Chinese": "雖然也想回到過去，但又怕手指再次使不上勁，那樣會很麻煩。所以，我希望能保持現狀，同時調整好自己面對工作的狀態。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:26:22",
            "content": "なるほど。",
            "Chinese": "原來如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:26:35",
            "content": "では、",
            "Chinese": "那麼，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:27:29",
            "content": "「現状維持で仕事に向かうが、つまらないと感じたくない。」といった感じでしょうか。",
            "Chinese": "是不是可以理解為，您希望「維持現狀繼續工作，但不想再感到無聊」呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:27:42",
            "content": "はい。そうしたいです。",
            "Chinese": "是的，我希望能這樣。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:28:20",
            "content": "そう目標を考えられるのは素晴らしいですね。",
            "Chinese": "您能這樣去思考目標，真是太棒了。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:28:48",
            "content": "あろ瓦当ございます。",
            "Chinese": "謝謝您。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:28:57",
            "content": "ありがとうございます。",
            "Chinese": "謝謝您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:29:04",
            "content": "ではつまらなくなくなるように一緒に考えていきましょう。",
            "Chinese": "那麼，我們一起來想一想，怎樣才能不再感到無聊吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:29:29",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:29:57",
            "content": "「必要とされていないと感じる」とのことでしたが、",
            "Chinese": "您提到「感覺自己不被需要」，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:30:35",
            "content": "ほかの従業員さんに実際にそういわれるようなことはありましたか？",
            "Chinese": "其他的同事有實際對您說過這樣的話嗎？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:30:44",
            "content": "いえありません",
            "Chinese": "不，沒有。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:30:57",
            "content": "そうなのですね。",
            "Chinese": "是這樣啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:31:29",
            "content": "では「なんとなくそう感じる」といった感じでしょうか。",
            "Chinese": "那麼，是「總覺得是這樣」的感覺嗎？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:31:59",
            "content": "はい。自分の折り合いなのかもしれません。",
            "Chinese": "是的。也許是我自己心態的問題。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:32:21",
            "content": "そうなのですね。では逆に、",
            "Chinese": "是這樣啊。那麼反過來說，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:33:11",
            "content": "ご相談者様の仕事の結果「ありがとう」など感謝されるようなことはありますか？",
            "Chinese": "您有沒有因為工作成果而被感謝，比如被說「謝謝」之類的情況呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:34:16",
            "content": "はい。言ってもらっています。",
            "Chinese": "有的，他們會對我說。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:34:36",
            "content": "それは素敵ですね！",
            "Chinese": "那真是太好了！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:34:58",
            "content": "感謝されるとうれしいですよね。",
            "Chinese": "被人感謝確實會很開心呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:37:42",
            "content": "というか…今年の仕事の結果ではなく、昨年度までの仕事の結果を通してみられているので、今の私に対する評価ではないと思います。なので、今は価値があるのかなあ？",
            "Chinese": "該怎麼說呢……他們不是針對我今年的工作成果，而是透過我去年及之前的工作成果來看待我，所以我覺得那不是對現在的我的評價。因此，我會想，現在的我還有價值嗎？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:38:20",
            "content": "昨年度というと、",
            "Chinese": "您說的去年是指，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:38:34",
            "content": "体調崩す前でしょうか？",
            "Chinese": "是在您身體出狀況之前嗎？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:38:39",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:39:05",
            "content": "なるほど、",
            "Chinese": "原來如此，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:39:37",
            "content": "では今の仕事内容でその感謝の実感はあまりないと。。。",
            "Chinese": "那麼就是說，以現在的工作內容，您不太能實際感受到那種感謝……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:39:57",
            "content": "そう感じてしまうのです。",
            "Chinese": "我就是會這麼覺得。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:40:27",
            "content": "そうなのですね。",
            "Chinese": "是這樣啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:40:35",
            "content": "では、",
            "Chinese": "那麼，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:41:35",
            "content": "もし今の職場からご相談者様がいなくなってしまったとして、",
            "Chinese": "如果您離開了現在的工作崗位，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:41:55",
            "content": "周りの方はどう感じるでしょう？",
            "Chinese": "周圍的人會怎麼想呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:42:11",
            "content": "想像できそうですか？",
            "Chinese": "您可以想像一下嗎？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:43:52",
            "content": "どうかなあ…びっくりしてしまうかもしれませんが、本人の希望ならしかたないとおもうのでは？",
            "Chinese": "這個嘛……他們可能會很驚訝，但如果是我本人的意願，大概也會覺得沒辦法吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:44:45",
            "content": "仕事の回りなどはどうでしょう。",
            "Chinese": "工作運轉方面呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:45:30",
            "content": "「ご相談者様がいないと手が回らなくなる」などはなさそうですか？",
            "Chinese": "會不會有「沒有您在就忙不過來」之類的情況呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:46:33",
            "content": "なんとかなるのではないかな？",
            "Chinese": "應該總有辦法解決的吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:47:02",
            "content": "そう感じるのですね。",
            "Chinese": "您是這麼感覺的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:48:17",
            "content": "では発想をひっくり返してみて、",
            "Chinese": "那咱們換個思路想想，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:49:03",
            "content": "ご相談者様は「仕事を変える」という選択肢は考えられますか？",
            "Chinese": "您有考慮過「換工作」這個選項嗎？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:49:22",
            "content": "そうですね。それも考えています。",
            "Chinese": "嗯，這個我也在考慮。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:49:35",
            "content": "そうなのですね。",
            "Chinese": "是這樣啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:49:52",
            "content": "もし、",
            "Chinese": "如果，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:50:48",
            "content": "「ご相談者様がいなくても平気」という考えが現実だとしたら、",
            "Chinese": "「沒有您也沒關係」這個想法是現實的話，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:51:10",
            "content": "そもそも仕事をかえるというのもありな気がしました。",
            "Chinese": "我覺得那乾脆換一份工作也是個不錯的選擇。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:53:12",
            "content": "仕事を変えるとなると「今の状態で仕事に向かう」と異なってしまいますが、、、",
            "Chinese": "不過，換工作的話，就和「在現在的狀態下繼續工作」不一樣了……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:53:45",
            "content": "そうですね。少し環境を変えるほうが、過去の自分にとらわれずに済むかもしれません。",
            "Chinese": "是的。稍微改變一下環境，或許就能不再被過去的自己所束縛了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:54:09",
            "content": "今の職場に対して、",
            "Chinese": "對於現在的職場，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:54:43",
            "content": "何か未練的なものはあるのでしょうか。",
            "Chinese": "您有什麼留戀之類的嗎？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:55:15",
            "content": "環境を変えるというのもある種気分転換になると思います。",
            "Chinese": "我覺得換個環境，在某種程度上也能轉換心情。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:57:39",
            "content": "未練はないですが、チャレンジすることの怖さはやはりありますが、無気力よりいい気がします。ただ、が書けるようにはなりたいので、今年度は頑張ってみます。仕事を探しながら",
            "Chinese": "雖然沒有留戀，但挑戰新事物還是會害怕，不過感覺總比無精打采要好。只是，我還是希望能恢復寫字能力，所以今年我會一邊找工作，一邊努力看看。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:58:00",
            "content": "文字がかけるように",
            "Chinese": "希望能恢復寫字能力。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:58:12",
            "content": "そう前向きな考えは素敵ですね。",
            "Chinese": "您能這麼積極地思考，真是太好了。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 10:58:27",
            "content": "ありがとうございます！",
            "Chinese": "謝謝您！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:58:30",
            "content": "現状は正直おつらいと思います。",
            "Chinese": "說實話，我認為您現在的狀況一定很辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:58:37",
            "content": "ですが、",
            "Chinese": "但是，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:59:14",
            "content": "「いまのじょうたいにやりがいを見つける」というより",
            "Chinese": "與其「在現在的狀態中找到價值感」，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 10:59:56",
            "content": "「未来のやりがいへの準備期間」と考えてみてはいかがでしょう。",
            "Chinese": "不如試著把它看作是「為未來的價值感做準備的時期」，您覺得怎麼樣？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 11:00:45",
            "content": "そうですね。",
            "Chinese": "說得對。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 11:01:16",
            "content": "少し気持ちは前向き、楽になりましたか？",
            "Chinese": "心情有沒有變得積極、輕鬆一些了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 11:01:36",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 11:02:09",
            "content": "それはよかったです＾＾",
            "Chinese": "那太好了＾＾"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 11:02:53",
            "content": "お体のことは医者ではないので私はコメントできませんが、",
            "Chinese": "關於您身體的事情，因為我不是醫生所以無法發表意見，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 11:04:06",
            "content": "お体ご自愛下さい。それでいつつ気持ちを前向きにもってみてください。",
            "Chinese": "但請您多保重身體。同時，也請試著保持積極的心情。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 11:04:17",
            "content": "ありがとうございます",
            "Chinese": "謝謝您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 11:04:34",
            "content": "きっとご相談者様ならやれると思います！",
            "Chinese": "我相信您一定能做到的！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 11:04:59",
            "content": "お時間になりますが、ほかになにかございますか？",
            "Chinese": "時間差不多了，您還有其他問題嗎？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 11:05:23",
            "content": "大丈夫です。",
            "Chinese": "沒有了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 11:05:54",
            "content": "それではこれで失礼します。また何かありましたらお越しください。",
            "Chinese": "那麼今天就到這裡。如果還有什麼事，歡迎隨時再來。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 11:06:10",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/17(火) 11:06:38",
            "content": "(ロールプレイありがとうございました。)",
            "Chinese": "（感謝您參與角色扮演。）"
        },
        {
            "role": "クライアント",
            "time": "2020/11/17(火) 11:07:02",
            "content": "こちらこそありがとうございました。　失礼します。",
