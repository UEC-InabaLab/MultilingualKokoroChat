{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:23:46",
            "content": "はじめまして宜しくお願い致します。",
            "Chinese": "初次见面，请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:25:19",
            "content": "こちらこそよろしくお願い致します。",
            "Chinese": "我也请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:25:58",
            "content": "ありがとうございます。はじめに年齢、性別を宜しくお願い致します。",
            "Chinese": "谢谢您。首先，请告知您的年龄和性别。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:30:18",
            "content": "14歳、女です",
            "Chinese": "14岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:30:39",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:30:51",
            "content": "今日の相談したいことよろしくお願いいたします。",
            "Chinese": "关于今天想咨询的事情，请您说说看。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:31:23",
            "content": "学校に行く勇気が持てなくて、悩んでます…",
            "Chinese": "我提不起去学校的勇气，一直在烦恼……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:31:47",
            "content": "相談ありがとうございます。",
            "Chinese": "感谢您的咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:32:29",
            "content": "学校に行く勇気が持てなくて悩んでいるのですね",
            "Chinese": "您是因为没有勇气去学校而感到烦恼，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:32:37",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:33:44",
            "content": "そのことについて、もう少し詳しくお話し聴いても大丈夫ですか❔",
            "Chinese": "关于这件事，可以再听您详细说一说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:34:31",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:34:40",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:36:08",
            "content": "学校に行くのに勇気が持てなくてなったのはいつ頃くらいからですか❔",
            "Chinese": "大概是从什么时候开始，您变得没有勇气去学校的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:36:31",
            "content": "半年前くらいです",
            "Chinese": "大概是半年前。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:37:01",
            "content": "半年くらい前からなんですね。",
            "Chinese": "原来是从半年前左右开始的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:37:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:38:47",
            "content": "学校に行く時はどんなお気持ちであることが多いですか？",
            "Chinese": "去学校的时候，您通常是什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:39:19",
            "content": "行きたくないなって気持ちです",
            "Chinese": "就是不想去的心情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:40:05",
            "content": "行きたくないお気持ちのほうが、強いのですね。",
            "Chinese": "不想去的心情更强烈一些呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:40:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:41:35",
            "content": "そのことについて、周りに相談できる家族、お友達はいますか❔",
            "Chinese": "关于这件事，您身边有可以商量的家人或朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:42:22",
            "content": "両親には話しました。",
            "Chinese": "我跟父母说了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:43:02",
            "content": "ご両親にはお話しできたんですね",
            "Chinese": "您已经和父母谈过了啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:43:09",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:43:59",
            "content": "ご両親にお話し出来てどうでしたか❔",
            "Chinese": "和父母谈了之后感觉怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:44:29",
            "content": "どうしようかなって感じですね",
            "Chinese": "就是有点不知该怎么办的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:45:19",
            "content": "どうしようかなっていうのは学校に行くことについてですか❔",
            "Chinese": "您说的“该怎么办呢”，是关于去上学这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:45:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:46:41",
            "content": "学校に行くのはしんどいお気持ちのほうが強いですか❔",
            "Chinese": "是不是觉得去上学很痛苦的心情更强烈呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:47:08",
            "content": "しんどいですね",
            "Chinese": "很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:48:04",
            "content": "しんどい気持ちがとても強くてしんどいんですね",
            "Chinese": "痛苦的心情非常强烈，让您感到很煎熬，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:51:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:51:49",
            "content": "お辛いときに相談していただいてありがとうございます。",
            "Chinese": "谢谢您在这么痛苦的时候还来向我咨询。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:52:18",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:53:04",
            "content": "しんどい時でも学校に行くことの方がおおいですか？",
            "Chinese": "即使在痛苦的时候，去上学的情况也比较多吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:53:30",
            "content": "今は行ってないです",
            "Chinese": "现在没有去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:53:54",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:54:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:54:28",
            "content": "行けないのもお辛いですよね",
            "Chinese": "不能去上学，心里也很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:54:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:55:00",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:55:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:55:56",
            "content": "学校に行きたいお気持ちもありますか❔",
            "Chinese": "您也有想去学校的心情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:56:06",
            "content": "そうですね",
            "Chinese": "嗯，有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:56:23",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:57:12",
            "content": "そのことについて、ご両親に相談は出来ましたか❔",
            "Chinese": "关于这件事，您有和父母商量过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 21:58:07",
            "content": "え、はい",
            "Chinese": "呃，嗯，有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 21:59:58",
            "content": "相談できるのはいいですね。相談して少しでも気持ちが楽になればいいですが、その時はどうでしたか❔",
            "Chinese": "能够商量是件好事。如果商量后心情能轻松一点就好了，那当时您感觉怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:00:22",
            "content": "複雑な気分でした",
            "Chinese": "心情很复杂。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:01:14",
            "content": "複雑な気持ちになられたんですね。余計に悩んでしまいますよね",
            "Chinese": "让您心情变得复杂了呢。反而会更烦恼吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:01:26",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:02:35",
            "content": "今日相談に来られて相談出来てないことなどはないですか❔大丈夫ですか",
            "Chinese": "今天来咨询，还有没有没能说出口的事情呢？都还好吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:03:35",
            "content": "どうやったら学校行けるかなと思います。",
            "Chinese": "我在想，要怎么做才能去上学呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:04:03",
            "content": "そうですよね。悩んでしまいますよね",
            "Chinese": "是啊，这确实很让人烦恼。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:04:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:04:43",
            "content": "周りに少しでも話せるお友達はいますか❔",
            "Chinese": "身边有没有哪怕能稍微聊聊的朋友呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:05:29",
            "content": "仲のいい友達はいます",
            "Chinese": "有关系好的朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:05:57",
            "content": "仲のいいお友達いるんですね",
            "Chinese": "有关系好的朋友啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:06:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:07:05",
            "content": "悩みについては、お友達には話し辛いですか❔",
            "Chinese": "关于烦恼的事情，很难和朋友开口吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:07:29",
            "content": "そうですね詳しくは話していないです",
            "Chinese": "嗯，没有详细说过。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:07:52",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:08:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:08:37",
            "content": "お友達学校に来てないのは心配されたりしてないですか❔",
            "Chinese": "朋友们会担心您没去上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:09:12",
            "content": "たまに家に来てくれたりします",
            "Chinese": "他们偶尔会来家里看我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:09:53",
            "content": "それは、嬉しいですね。",
            "Chinese": "那真让人高兴呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:09:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:10:45",
            "content": "友達学校に行くのに誘ってくれることもありますか❔",
            "Chinese": "朋友会邀请您一起去上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:11:34",
            "content": "まあそうですね今はそっとしといてくれる感じですかね",
            "Chinese": "也算有吧，不过现在更多是让我静一静的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:12:26",
            "content": "とても、理解のあるいい、お友達なんですね。",
            "Chinese": "他们真是非常理解您的好朋友呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:13:26",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:14:17",
            "content": "普通にお友達と遊びにいくこともありますか❔",
            "Chinese": "平时也会和朋友出去玩吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:14:32",
            "content": "たまに行きます",
            "Chinese": "偶尔会去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:15:36",
            "content": "いいですね。気分転換になりますね",
            "Chinese": "很好啊，也能转换一下心情呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:16:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:16:55",
            "content": "どんな所に遊びにいくことが多いですか❔",
            "Chinese": "通常会去什么地方玩呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:17:19",
            "content": "映画とかですかねでも家で遊ぶことが多いです",
            "Chinese": "比如看电影之类的吧。不过在家里玩的时候比较多。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:18:30",
            "content": "そうなんですね。映画もいいですけど気兼ねなく、お家で、遊べるほうがいいですよね。",
            "Chinese": "这样啊。看电影也不错，但在家玩更轻松自在呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:18:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:19:26",
            "content": "学校のお話もすることもありますか❔",
            "Chinese": "你们会聊学校里的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:20:29",
            "content": "最近はそんなにしてないです",
            "Chinese": "最近不怎么聊了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:20:45",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:21:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:21:44",
            "content": "話しにくいこともありますよね。",
            "Chinese": "有些事确实很难开口吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:22:42",
            "content": "ありますね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:23:01",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:23:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:24:43",
            "content": "今回相談しに来ていただいて少しでも気持ちが楽になれたらいいですが。どうでしょうか❔",
            "Chinese": "这次您来咨询，如果能让您的心情稍微轻松一些就好了。您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:25:43",
            "content": "うーん微妙です",
            "Chinese": "嗯……有点微妙。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/04(土) 22:26:01",
            "content": "まだどうしたらいいかわからないですね",
            "Chinese": "还是不知道该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/04(土) 22:27:46",
            "content": "そうですよね。解らず悩んでるのは、とても、お辛いですよね。ご期待に応えることができず申し訳ありません",
