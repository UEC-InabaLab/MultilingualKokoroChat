{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 19:51:10",
            "content": "（こんばんは、今日はありがとうございます。お時間になりましたら、始めさせていただきます。）",
            "Chinese": "（晚上好，感谢您今天前来。时间到了我们就开始吧。）"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 19:52:57",
            "content": "(こんばんは。よろしくお願いいたします。)",
            "Chinese": "（晚上好，请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:00:13",
            "content": "こんばんは、相談員です。今日はご相談に来ていただき、ありがとうございます。始めに年齢と性別を教えてください。",
            "Chinese": "晚上好，我是咨询师。感谢您今天前来咨询。首先，请告知您的年龄和性别。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:00:31",
            "content": "15歳、男",
            "Chinese": "15岁，男。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:01:07",
            "content": "ありがとうございます。では今日のご相談内容を教えてください。",
            "Chinese": "谢谢您。那么请告诉我您今天想咨询的内容。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:01:35",
            "content": "苦しまない死に方教えて",
            "Chinese": "请告诉我一种不会痛苦的死法。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:02:21",
            "content": "そうなんですね、それほど辛い思いなんですね。",
            "Chinese": "是这样啊，看来您真的非常痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:02:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:03:10",
            "content": "今はどちらにいますか？",
            "Chinese": "您现在在哪里呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:03:23",
            "content": "家",
            "Chinese": "在家。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:03:53",
            "content": "そうなんですね、お部屋にいるのですか？",
            "Chinese": "是这样啊，您在房间里吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:04:01",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:04:37",
            "content": "お一人ですか？",
            "Chinese": "您是一个人吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:05:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:07:04",
            "content": "いつもこの時間はお一人ですか？",
            "Chinese": "您平时这个时间都是一个人吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:07:38",
            "content": "ご飯は食べましたか？",
            "Chinese": "您吃过饭了吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:07:42",
            "content": "部屋に1人",
            "Chinese": "一个人在房间里。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:09:23",
            "content": "お腹は空いていませんか？",
            "Chinese": "您不饿吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:09:43",
            "content": "ご飯は食べた",
            "Chinese": "吃过饭了。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:09:52",
            "content": "死に方教えて",
            "Chinese": "教我怎么死。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:10:07",
            "content": "そうなんですね、それは良かったです。",
            "Chinese": "是这样啊，那太好了。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:11:24",
            "content": "やっぱり死んだ方がいいよね",
            "Chinese": "果然还是死了比较好吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:12:41",
            "content": "なにか嫌なことがあったのでしょうか？少しお話をお聞きしたいのですが、いいですか？",
            "Chinese": "是不是遇到了什么让您很难受的事情？我想多听您说一说，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:13:18",
            "content": "話したくない",
            "Chinese": "不想说。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:13:26",
            "content": "方法だけ教えて欲しい",
            "Chinese": "我只想知道方法。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:14:01",
            "content": "そうなのですね、死にたくなるくらい苦しいことがあったのですね。",
            "Chinese": "这样啊，看来是发生了让您痛苦到想死的事情了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:20:06",
            "content": "学校は通っていますか？",
            "Chinese": "您现在在上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:20:28",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:21:04",
            "content": "そうなのですね、学年を教えてください。",
            "Chinese": "这样啊，请告诉我您读几年级。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:21:36",
            "content": "中3",
            "Chinese": "初三。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:22:14",
            "content": "ありがとうございます。ではご相談者様は、受験生ですか？",
            "Chinese": "谢谢您。那么，您是面临升学考试的考生吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:22:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:22:36",
            "content": "さっきからずっと質問してくるね",
            "Chinese": "你从刚才开始就一直在问问题呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:22:44",
            "content": "こっちの質問には答えないのに",
            "Chinese": "却不回答我的问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:23:38",
            "content": "失礼いたしました。ご相談者様のことを、よく知りたいからです。",
            "Chinese": "非常抱歉。因为我想更好地了解您。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:24:21",
            "content": "そうなんだ。そろそろ質問答えてくれますか？",
            "Chinese": "是这样啊。差不多该回答我的问题了吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:30:38",
            "content": "そのような辛い気持ちの方に、どのようにして差し上げたらいいのか相談者は考えています。",
            "Chinese": "我正在思考，对于像您这样心情痛苦的人，我能为您做些什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:32:18",
            "content": "そこまで追い詰められたご相談者様と、それ以外のことを考えていきたいと思います。",
            "Chinese": "我想与被逼到如此地步的您一起探讨其他可能性。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:32:37",
            "content": "それ以外って？",
            "Chinese": "“其他可能性”是指什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:37:31",
            "content": "どうしてそこまで考えてしまったのか、お話していただけないと分かりませんが、なにか死ぬ以外の方法を、相談員と考えてみませんか？",
            "Chinese": "您不告诉我的话，我无法理解您为什么会想到那一步。但是，要不要和我一起思考一下，除了死之外还有没有其他方法呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:37:49",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:38:29",
            "content": "そういって下さりありがとうございます。",
            "Chinese": "谢谢您愿意这么说。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:39:18",
            "content": "いつくらいからそのようなことを考えてしまうようになったのですか？",
            "Chinese": "大概从什么时候开始会有这样的想法呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:39:47",
            "content": "半年くらい前",
            "Chinese": "大概半年前。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:40:34",
            "content": "そうだったのですね。それはとてもお辛いことがあったと思います。",
            "Chinese": "原来是这样啊。我想那一定是非常痛苦的经历。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:42:38",
            "content": "学校から帰ってからは、いつも何をされているのですか？",
            "Chinese": "放学回家后，您通常都做些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:43:15",
            "content": "部屋でYouTube見てます",
            "Chinese": "在房间里看YouTube。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:43:59",
            "content": "そうなのですね。どんなチャンネルを見ているのですか？",
            "Chinese": "是这样啊。都看些什么频道呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:44:55",
            "content": "なんでそんなこと聞くの？",
            "Chinese": "为什么要问这种事？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:45:50",
            "content": "ご相談者様が普段どんなことをしているのか、興味があったからです。",
            "Chinese": "因为我想了解您平时都在做些什么。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:46:28",
            "content": "色々見てます",
            "Chinese": "什么都看。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:47:39",
            "content": "そうなんですね。それは楽しそうですね。学校ではどんなご様子なのですか",
            "Chinese": "是这样啊。听起来很有趣呢。您在学校的情况怎么样呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:49:11",
            "content": "話したくなければ、無理におはなししなくても構いません。",
            "Chinese": "如果您不想谈，也不用勉强自己。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:50:39",
            "content": "そんなにYouTube楽しいと思って見てないです。何となく見てます",
            "Chinese": "我并不是觉得YouTube很有趣才看的，只是随便看看。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:51:35",
            "content": "そうなのですね。お家にいるときは、ほかにもどんな過ごし方をしているのですか？",
            "Chinese": "是这样啊。在家的时候，还会做些其他什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:52:12",
            "content": "ご飯食べて寝てって感じです",
            "Chinese": "大概就是吃饭睡觉吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:53:23",
            "content": "そうなのですね。今は布団に入るとホカホカして気持ちいいですよね。",
            "Chinese": "是这样啊。现在这个天气钻进被窝里暖暖的，很舒服吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:53:47",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:54:22",
            "content": "ご相談者様は趣味などおありですか？",
            "Chinese": "您有什么兴趣爱好吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:54:36",
            "content": "ないです",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:57:51",
            "content": "そうなのですね。YouTubeを見ていて何か機になることとか物などはありますか？",
            "Chinese": "是这样啊。看YouTube的时候，有什么让您感兴趣的事情或东西吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 20:58:55",
            "content": "気になるっていうのは？",
            "Chinese": "您说的“感兴趣”是指什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 20:59:53",
            "content": "見ていて面白いな、とか、やってみたいな、とか思うことはありませんか？",
            "Chinese": "就是有没有觉得看起来很有趣，或者想自己试试看的事情？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 21:01:18",
            "content": "ないです",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 21:02:36",
            "content": "答えて下さりありがとうございます。もっとお話をお聞きしたいのですが、お時間が来てしまいました。",
            "Chinese": "感谢您的回答。我很想继续多听您说，但我们的时间已经到了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 21:03:11",
            "content": "（ありがとうございました。とても勉強になりました。）",
            "Chinese": "（非常感谢。我受益良多。）"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 21:04:05",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 21:04:33",
            "content": "(こちらこそありがとうございます。)",
            "Chinese": "（我也要谢谢您。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 21:04:43",
            "content": "辛くなったらいつでもここに来てください。相談員はお待ちしています。",
            "Chinese": "感到痛苦的时候，随时都可以来这里。我们会在这里等您。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 21:05:00",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/02(金) 21:05:51",
            "content": "それではこれで終わらせていただきます。ありがとうございました。",
            "Chinese": "那么本次咨询就到此结束。非常感谢您。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/02(金) 21:06:11",
            "content": "(終了メッセージ送っていただいて大丈夫です。)",
            "Chinese": "（您可以发送结束信息了。）"
        }
    ],
