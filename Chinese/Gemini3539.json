{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:21:26",
            "content": "こんばんは。相談者役をさせていただきます。よろしくお願い致します。",
            "Chinese": "晚上好。我来担任来访者的角色。请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:22:40",
            "content": "こんばんは。本日はよろしくお願いいたします。お時間になりましたら始めさせていただきます。",
            "Chinese": "晚上好。今天请多关照。时间到了我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:22:57",
            "content": "ありがとうございます。承知しました。",
            "Chinese": "谢谢您。我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:30:24",
            "content": "こんばんは。相談員です。本日はお越しいただきありがとうございます。初めに年齢と性別を教えていただけますか。",
            "Chinese": "晚上好。我是咨询师。感谢您今天前来。首先，请问可以告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:30:47",
            "content": "16歳　女性",
            "Chinese": "16岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:31:20",
            "content": "ありがとうございます。本日はどうされましたか。",
            "Chinese": "谢谢。您今天遇到了什么情况呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:31:39",
            "content": "今屋上にいます",
            "Chinese": "我现在在天台上。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:32:25",
            "content": "どうして屋上にいるのですか。",
            "Chinese": "您为什么会在天台上呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:33:00",
            "content": "イヤになって",
            "Chinese": "因为觉得很烦。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:33:09",
            "content": "なんか全てイヤ",
            "Chinese": "总觉得一切都让人厌烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:34:29",
            "content": "急に全てがイヤになったんですか。",
            "Chinese": "您是突然对一切都感到厌烦了吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:34:46",
            "content": "いつも",
            "Chinese": "一直都是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:35:38",
            "content": "よければお話しできる範囲でいいのでもう少し詳しく教えていただけますか。",
            "Chinese": "如果您不介意的话，可以在您方便说的范围内，再稍微详细地告诉我一些吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:36:12",
            "content": "時々死にたくなって",
            "Chinese": "有时候会想死。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:36:26",
            "content": "高いところに行きます",
            "Chinese": "就会去高的地方。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:36:35",
            "content": "楽しくないし",
            "Chinese": "既不开心，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:37:19",
            "content": "つまらないから",
            "Chinese": "又觉得无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:38:03",
            "content": "楽しくないことやつまらないことはなんですか。",
            "Chinese": "让您感到不开心和无聊的事情是些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:38:17",
            "content": "いろいろ",
            "Chinese": "各种各样的事情。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:39:02",
            "content": "学校も部活も楽しくない",
            "Chinese": "学校和社团活动都不开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:40:16",
            "content": "学校も部活もなんですね。ちなみに部活は何をされているのですか。",
            "Chinese": "原来是学校和社团活动都不开心啊。顺便问一下，您参加的是什么社团呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:40:38",
            "content": "バトミントン部",
            "Chinese": "羽毛球社。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:41:31",
            "content": "そうでしたか。バトミントンは長いことされているのですか。",
            "Chinese": "是这样啊。您打羽毛球很久了吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:41:45",
            "content": "高校に入ってから",
            "Chinese": "上了高中之后才开始的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:42:58",
            "content": "そうなんですね。高校から新しいことに挑戦するのは凄いですね。何かきっかけがあったんですか。",
            "Chinese": "是这样啊。从高中开始挑战新事物，真的很了不起呢。是有什么契机吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:43:08",
            "content": "なんとなく",
            "Chinese": "没什么特别的理由。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:43:19",
            "content": "できそうかなと",
            "Chinese": "就觉得好像自己还行吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:43:36",
            "content": "でも先輩がいばってるし",
            "Chinese": "但是学长学姐们很嚣张，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:43:54",
            "content": "だから目を付けられないようにしてる",
            "Chinese": "所以我为了不被他们盯上，一直都很小心。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:44:25",
            "content": "それでも一歩踏み出すのは素晴らしいと思います。",
            "Chinese": "即便如此，您能迈出这一步，我觉得非常了不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:44:42",
            "content": "先輩からですか。",
            "Chinese": "是来自学长学姐们吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:44:48",
            "content": "なんとなくだから",
            "Chinese": "因为当初就是随便选的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:44:59",
            "content": "先輩ウザい",
            "Chinese": "学长学姐们很烦人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:45:56",
            "content": "どういったところがウザいんですか。",
            "Chinese": "具体是哪些方面让您觉得烦人呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:46:33",
            "content": "うるさいし、存在がめんどくさい",
            "Chinese": "他们很吵，而且存在本身就很麻烦。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:47:13",
            "content": "何か屋上に来ると死にたくなる",
            "Chinese": "不知道为什么，一到天台就想死。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:48:00",
            "content": "自分なんかいなくてもいいのかな",
            "Chinese": "我是不是不存在也无所谓呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:48:47",
            "content": "いえ、そんなことはありませんよ。",
            "Chinese": "不，绝不是这样的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:49:05",
            "content": "でもいいところなんかないし",
            "Chinese": "可我没什么优点。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:49:39",
            "content": "なぜ、そう思われるんんですか。",
            "Chinese": "为什么您会这样想呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:50:50",
            "content": "よくわからない",
            "Chinese": "我也不太清楚。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:50:57",
            "content": "ずっとそうだから",
            "Chinese": "因为一直都是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:51:25",
            "content": "ずっとそう思われていたのですか。",
            "Chinese": "您一直都是这么想的吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:52:15",
            "content": "たぶん",
            "Chinese": "大概吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:52:54",
            "content": "自分がイヤになる",
            "Chinese": "会变得讨厌自己。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:55:08",
            "content": "イヤになることは誰しもが思ったことはあるのではないかなと私は思います。",
            "Chinese": "我觉得，讨厌自己的这种情绪，不论是谁都曾有过吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:55:39",
            "content": "誰しも、、",
            "Chinese": "谁都有过吗……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:56:03",
            "content": "でも私なんか",
            "Chinese": "但是我这种人……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:56:32",
            "content": "目立たないし",
            "Chinese": "既不起眼，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:56:45",
            "content": "中途半端だし",
            "Chinese": "又做什么都半途而废，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:57:17",
            "content": "誰も分かってくれない",
            "Chinese": "谁都不理解我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 20:58:37",
            "content": "身近な方が、あなたのことをわかってくれないのですか。",
            "Chinese": "是身边的人不理解您吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 20:59:20",
            "content": "だからイヤになった",
            "Chinese": "所以才觉得烦了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:01:01",
            "content": "わかってくれないが、わかってほしいと思っている身近な方はどなたですか。",
            "Chinese": "在身边的人当中，您最希望谁能理解您呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:01:28",
            "content": "みんな",
            "Chinese": "所有人。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:02:10",
            "content": "家に帰りたくない",
            "Chinese": "我不想回家。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:02:57",
            "content": "家に帰りたくない。何かご家庭でありましたか。",
            "Chinese": "不想回家。是家里发生什么事了吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:03:55",
            "content": "いつもひとりだから",
            "Chinese": "因为我总是一个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:04:37",
            "content": "おひとりで住まわれているのですか？",
            "Chinese": "您是一个人住吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:04:56",
            "content": "家族で住んでますよ",
            "Chinese": "我和家人一起住啊，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:05:34",
            "content": "でも話せないし",
            "Chinese": "但是和他们说不上话，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:06:18",
            "content": "自分なんかどうでもいいし",
            "Chinese": "他们觉得我怎么样都无所谓。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:07:15",
            "content": "無理にとは言いませんのでお話しできることがあれば教えていただけませんか？",
            "Chinese": "我不会勉强您，如果有什么可以说的，能告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:07:43",
            "content": "お父さんもお母さんも忙しいから",
            "Chinese": "因为爸爸妈妈都很忙，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:08:18",
            "content": "たぶん私のこと嫌いだと思う",
            "Chinese": "我想他们大概是讨厌我吧，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:08:30",
            "content": "お父さんもお母さんも",
            "Chinese": "爸爸妈妈都讨厌我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:08:53",
            "content": "ありがとうございます。なぜそう思われるのですか。",
            "Chinese": "谢谢您告诉我这些。为什么您会这样想呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:09:02",
            "content": "わからない",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:10:35",
            "content": "わからないが、そう思われているのではないかということですか？",
            "Chinese": "您的意思是，虽然不知道具体原因，但您感觉是这样，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:10:45",
            "content": "？？",
            "Chinese": "？？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:11:00",
            "content": "何のことかわからないです",
            "Chinese": "我不明白您在说什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:12:06",
            "content": "理由はわからないが、ご両親から嫌われているのではないかと思われているのですか？",
            "Chinese": "我的意思是，虽然不知道原因，但您感觉自己是不是被父母讨厌了呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:13:07",
            "content": "私やっぱり嫌われてるのかな",
            "Chinese": "我果然还是被讨厌的吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:13:57",
            "content": "なぜそう思うのですか？",
            "Chinese": "为什么您会这样想呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:14:13",
            "content": "言いたくない",
            "Chinese": "我不想说。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:14:58",
            "content": "疲れた",
            "Chinese": "我累了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:17:51",
            "content": "今日、お時間いただいてここにお越しくださったので何か少しでもいいので吐き出してみませんか？",
            "Chinese": "既然您今天特意抽出时间来到这里，要不要试着把心里的事说出来一些呢，哪怕只是一点点也好。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:18:12",
            "content": "さっきから話してるし",
            "Chinese": "我从刚才不就一直在说吗。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:18:29",
            "content": "これからどうしようかな",
            "Chinese": "接下来该怎么办呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:18:49",
            "content": "帰りたくないよ",
            "Chinese": "我不想回家啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:21:20",
            "content": "今は学校帰りですか？",
            "Chinese": "您现在是放学回家的路上吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:21:29",
            "content": "そう",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:21:56",
            "content": "今日も部活には行かれましたか？",
            "Chinese": "今天也去参加社团活动了吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:22:05",
            "content": "行ったよ",
            "Chinese": "去了啊，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:22:26",
            "content": "ダルいけど",
            "Chinese": "虽然觉得很没劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:23:47",
            "content": "それでもいくのは尊敬します。私だったら耐えられていないと思います。",
            "Chinese": "即使那样还坚持去，我真的很佩服您。如果是我，可能就坚持不了了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:24:29",
            "content": "でも私なんか",
            "Chinese": "但是我这种人……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:25:18",
            "content": "私なんかと思うことはないのではないかなと私は思います、",
            "Chinese": "我觉得，您完全不必这么想自己。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:25:31",
            "content": "別にいいじゃん",
            "Chinese": "反正无所谓吧，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:26:52",
            "content": "誰も分かってくれない",
            "Chinese": "反正谁都不理解我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/25(水) 21:28:01",
            "content": "お話を聞かせて頂いて、あなたはとても頑張っているし素晴らしいところがあるとおもいます。",
            "Chinese": "听了您的话，我觉得您非常努力，有很多了不起的地方。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/25(水) 21:28:59",
            "content": "わからないし、言われたことない。",
            "Chinese": "我不知道……也从来没有人对我说过。"
        },
