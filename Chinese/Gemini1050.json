{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:56:11",
            "content": "本日のテーマはカウンセリング「恋愛」です",
            "Chinese": "今天的心理咨询主题是“恋爱”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:56:32",
            "content": "宜しくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:56:47",
            "content": "初めまして、相談員です。",
            "Chinese": "初次见面，我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:57:14",
            "content": "宜しくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:57:16",
            "content": "はじめに、あなたの年齢と性別を教えてもらえますか？",
            "Chinese": "首先，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:58:12",
            "content": "７０代、女性です",
            "Chinese": "70多岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:58:23",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:58:42",
            "content": "あなたのことは、なんとお呼びしたらいいですか？",
            "Chinese": "请问我该怎么称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:59:08",
            "content": "美穂子です",
            "Chinese": "我叫美穗子。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:59:20",
            "content": "美穂子さんですね。",
            "Chinese": "是美穗子女士，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:59:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:00:21",
            "content": "それでは美穂子さん、今日ご相談されたい内容を教えてもらえますか？",
            "Chinese": "好的，美穗子女士，能告诉我您今天想咨询的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:00:59",
            "content": "老後の生活に波が立っています",
            "Chinese": "我的晚年生活起了波澜。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:01:37",
            "content": "そうなんですね…それは不安になってしまいますよね…",
            "Chinese": "是这样啊……那您一定很不安吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:01:54",
            "content": "はい、そうなんです",
            "Chinese": "是的，正是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:02:05",
            "content": "もう少し詳しく教えていただけますか？",
            "Chinese": "您能说得更详细一些吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:02:55",
            "content": "以前までは、お互いに生きがいをたくさんもっていました。",
            "Chinese": "以前，我们彼此都有许多人生的寄托。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:03:29",
            "content": "でも、最近は・・・",
            "Chinese": "但是，最近……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:03:35",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:04:36",
            "content": "夫が、ハンサムなので、他の女性に、なびいています",
            "Chinese": "因为我丈夫长得很帅，所以正被其他女性所吸引。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:05:29",
            "content": "そうなんですね…夫さんがハンサムだと、女性としてそれは気になりますよね…",
            "Chinese": "是这样啊……丈夫英俊的话，作为妻子确实会很在意的……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:06:07",
            "content": "あまり、気にしていなかったのですが、最近、夫がひどいのです",
            "Chinese": "我原本不太在意，但最近丈夫的行为太过分了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:06:27",
            "content": "何かあったのですか？",
            "Chinese": "发生什么事了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:07:59",
            "content": "むかしから、健康にも気遣い、ラジオ体操に参加していたのですが、最近、夫は、ラジオ体操で出会った独身女性の話をするようになりました",
            "Chinese": "我们以前就很注重健康，会去参加广播体操，但最近，我丈夫开始谈论起在广播体操上遇到的单身女性。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:08:10",
            "content": "それだけでは、ないのですよ",
            "Chinese": "还不止这些呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:08:26",
            "content": "そうなんですね…",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:08:36",
            "content": "はい、",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:09:00",
            "content": "それは心配になりますよね…",
            "Chinese": "那您肯定很担心吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:09:15",
            "content": "ほかには、どのようなことがあったのですか？",
            "Chinese": "除此之外，还发生了什么其他的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:09:39",
            "content": "最初は、あまり気にしていませんでした",
            "Chinese": "一开始我并没有太在意。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:10:02",
            "content": "鼻歌をうたうようになりました",
            "Chinese": "他开始哼起小曲来。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:10:18",
            "content": "クラス会では、文通することも",
            "Chinese": "在体操活动上，他们甚至还开始通信。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:11:01",
            "content": "夫さんの様子に変化がみられてきたんですね…",
            "Chinese": "您丈夫的情况开始出现变化了呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:11:15",
            "content": "はい、そうなんです",
            "Chinese": "是的，正是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:11:53",
            "content": "そういった変化の積み重ねがあると、それは気になるし、不安にもなりますよね…",
            "Chinese": "这些变化一点点累积起来，确实会让人挂心，也会感到不安……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:12:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:12:39",
            "content": "きっと、毎日もやもやした気持ちを抱えていらしたんですね…",
            "Chinese": "您想必每天都怀着郁闷的心情吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:12:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:13:11",
            "content": "最初は、ほほえましくおもっていましたのに",
            "Chinese": "一开始，我还觉得挺温馨的呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:13:38",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:13:58",
            "content": "腹が立ちます",
            "Chinese": "现在我很生气。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:14:10",
            "content": "そうでしたか…",
            "Chinese": "原来如此……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:14:21",
            "content": "はい、そうなんです",
            "Chinese": "是的，正是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:14:28",
            "content": "美穂子さんがそう感じるのも、無理ないと思いますよ",
            "Chinese": "您会有这样的感受，也是情有可原的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:14:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:15:11",
            "content": "夫を多めに見ることも大事だと思うのですが・・・",
            "Chinese": "我也觉得对丈夫多些包容很重要，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:15:30",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:15:59",
            "content": "はい、イライラ、ムカムカ",
            "Chinese": "是的，又烦又气。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:17:08",
            "content": "そうですよね…",
            "Chinese": "是啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:17:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:17:20",
            "content": "つらいお気持ちを話してくださって、ありがとうございます",
            "Chinese": "感谢您愿意分享您痛苦的心情。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:17:30",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:17:39",
            "content": "美穂子さんとしては、今後どうしたいと思いますか？",
            "Chinese": "那么，美穗子女士，您今后有什么打算呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:18:26",
            "content": "今は、三角関係なので、なんとかしたいです",
            "Chinese": "现在是三角关系，所以我想想办法解决。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:19:00",
            "content": "三角関係をなんとかしたいのですね。",
            "Chinese": "您是想设法解决这个三角关系，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:19:38",
            "content": "でも、夫を許してみてもよいのかな、とも考えています",
            "Chinese": "但是，我也在想，是不是可以试着原谅丈夫。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:19:50",
            "content": "なるほど…",
            "Chinese": "原来如此……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:20:06",
            "content": "どうしたら、よろしいでしょうか",
            "Chinese": "您觉得我该怎么办才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:21:14",
            "content": "きっとたくさん気持ちをこらえてこられたんですよね…",
            "Chinese": "您一定压抑了很多情绪吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:21:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:21:43",
            "content": "私は、嫉妬しているのかもしれません",
            "Chinese": "也许是我在吃醋。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:21:46",
            "content": "そんな気持ちを、とても冷静にお話してくださって、ありがとうございます。",
            "Chinese": "感谢您能如此冷静地分享您的这些感受。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:22:06",
            "content": "そう感じていらっしゃるのですね…",
            "Chinese": "您是这样感受的啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:23:10",
            "content": "美穂子さんは夫さんと元の関係に戻りたいとお考えなんですね",
            "Chinese": "美穗子女士，您是想和丈夫回到原来的关系，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:23:53",
            "content": "夫は、夫婦として、生活しています。ところが、",
            "Chinese": "我丈夫和我还是像夫妻一样生活着。但是，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:24:09",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:24:17",
            "content": "その女性が、家に来たり、するのです",
            "Chinese": "那个女人会来我们家。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:24:33",
            "content": "そうなんですね…！",
            "Chinese": "是这样啊……！"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:24:35",
            "content": "やがると、夫が",
            "Chinese": "结果，我丈夫竟然——"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:24:51",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:25:22",
            "content": "嫉妬深い場ばあさまだ、といいます",
            "Chinese": "他就说我是个嫉妒心很重的老太婆。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:25:43",
            "content": "そんなことを言われるのですね…",
            "Chinese": "他竟然对您说这种话……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:25:53",
            "content": "それは傷つきますよね…",
            "Chinese": "这太伤人了……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:25:57",
            "content": "はい、そうなんです",
            "Chinese": "是的，正是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:26:27",
            "content": "そんなことがあったのなら、美穂子さんが起こるのも無理ないと思います",
            "Chinese": "发生了这样的事，您会生气也是可以理解的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:26:40",
            "content": "はい、そうなんです",
            "Chinese": "是的，正是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:27:35",
            "content": "お辛かったですね…",
            "Chinese": "您一定很辛苦吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:27:43",
            "content": "はい、",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:28:04",
            "content": "婆さんには、参りました",
            "Chinese": "被他叫“老太婆”，我真是受不了了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:28:05",
            "content": "これまで、とても頑張ってこられましたね…",
            "Chinese": "一直以来，您真的辛苦了……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:28:13",
            "content": "はい、",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:28:22",
            "content": "相手の女性はどのような方なのですか？",
            "Chinese": "对方是位什么样的女性呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:28:48",
            "content": "ラジオ体操で、出会った方です",
            "Chinese": "是在广播体操时认识的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:29:13",
            "content": "最近知り合った方ということですか？",
            "Chinese": "也就是说，是最近才认识的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:29:28",
            "content": "はい、そうですね",
            "Chinese": "是的，算是这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:30:14",
            "content": "夫さんの今回のような様子は、以前にもあったのですか？",
            "Chinese": "您丈夫像这次这样，以前也发生过吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:30:56",
            "content": "これで終了させていただきますね。ありがとうございました。",
            "Chinese": "那么本次咨询就到此结束了。非常感谢您。"
        }
    ],
