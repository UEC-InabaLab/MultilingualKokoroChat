{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:21:17",
            "content": "（こんにちは。今日はよろしくお願いいたします。時間になったら始めさせていただきますね。）",
            "Chinese": "（您好。今天请多关照。时间到了我们就正式开始。）"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:21:37",
            "content": "（よろしくお願いします。本日希望のケースなどはございますか？）",
            "Chinese": "（请多指教。请问今天有特别希望讨论的案例吗？）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:22:22",
            "content": "（特にないので、よろしくお願いいたします。）",
            "Chinese": "（没什么特别的，就拜托您了。）"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:22:32",
            "content": "（かしこまりました。）",
            "Chinese": "（好的，明白了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:30:12",
            "content": "こんにちは、相談員です。年齢、性別、相談内容を教えていただけますか。",
            "Chinese": "您好，我是咨询师。可以告诉我您的年龄、性别和咨询内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:30:34",
            "content": "16　男",
            "Chinese": "16岁，男。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:31:08",
            "content": "生きてる意味がわかりません",
            "Chinese": "我不明白活着的意义。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:31:41",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:32:51",
            "content": "そう思われているんですね。もう少し詳しく教えてもらえますか。",
            "Chinese": "您是这么想的啊。能再详细说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:33:36",
            "content": "なんで迷惑がかかるのに学校に行かないといけないんですか",
            "Chinese": "明明会给别人添麻烦，为什么还非得去上学呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:33:40",
            "content": "自分が",
            "Chinese": "我自己……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:34:47",
            "content": "今は高校生ですか？",
            "Chinese": "您现在是高中生吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:35:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:35:53",
            "content": "なんで迷惑がかかると思うんですか？",
            "Chinese": "为什么会觉得自己在添麻烦呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:36:30",
            "content": "自分が相手を不幸にさせているから",
            "Chinese": "因为我让对方不幸了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:37:12",
            "content": "そう思っているんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:37:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:38:41",
            "content": "相手を不幸にさせているというのは、どういう事からでしょうか？",
            "Chinese": "您说会让对方不幸，具体是指什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:39:29",
            "content": "学校にいるだけで迷惑がかかる",
            "Chinese": "只是待在学校里就会给别人添麻烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:40:48",
            "content": "そうなんですね。どうして迷惑がかかると思っているんですか？",
            "Chinese": "是这样啊。为什么您会觉得会添麻烦呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:41:22",
            "content": "自分が不幸にさせているから",
            "Chinese": "因为是我在让他们不幸。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:42:05",
            "content": "そう思われているんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:43:21",
            "content": "どんな事で不幸にさせていると思われるんですか？",
            "Chinese": "您觉得是在什么事情上让对方变得不幸了呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:43:43",
            "content": "学校にいること",
            "Chinese": "只是待在学校这件事。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:44:06",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:45:14",
            "content": "あなたが学校にいるとなんで不幸になるんでしょうか？",
            "Chinese": "为什么您在学校就会让别人不幸呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:45:57",
            "content": "自分が不幸にさせているから",
            "Chinese": "因为是我让他们不幸。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:46:42",
            "content": "そう思われるんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:47:19",
            "content": "どのような不幸でしょうか？",
            "Chinese": "具体是怎样的不幸呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:47:55",
            "content": "相手の迷惑",
            "Chinese": "给对方添麻烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:48:44",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:49:27",
            "content": "どのような迷惑なんでしょうか？",
            "Chinese": "具体是怎样的麻烦呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:49:58",
            "content": "迷惑は迷惑です",
            "Chinese": "麻烦就是麻烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:51:35",
            "content": "そうなんですね。迷惑は誰にかけているんでしょうか？",
            "Chinese": "是这样啊。您觉得是在给谁添麻烦呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:51:44",
            "content": "みんな",
            "Chinese": "大家。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:52:40",
            "content": "どうしてそのように思われるんですか？",
            "Chinese": "为什么您会这么想呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:52:59",
            "content": "自分が不幸にさせているから",
            "Chinese": "因为是我让大家不幸。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:53:42",
            "content": "そう思うんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:53:46",
            "content": "やっぱり自分は生きちゃダメなんですかね",
            "Chinese": "果然，我不该活着吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:54:46",
            "content": "そんな事はないと思いますよ。",
            "Chinese": "我觉得并非如此。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:55:12",
            "content": "なんで、自分が不幸にさせているのに",
            "Chinese": "为什么呢，明明是我让大家不幸。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:56:39",
            "content": "みんなから何か言われたんでしょうか。",
            "Chinese": "是大家对您说了什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:57:28",
            "content": "自分は生きる価値ないんだな",
            "Chinese": "我真是没有活着的价值啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 15:57:36",
            "content": "邪魔ってよく言われるのに",
            "Chinese": "明明经常被说是碍事。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:59:06",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 15:59:51",
            "content": "クラスメイトから邪魔と言われるんでしょうか。",
            "Chinese": "是被同班同学说碍事吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:00:10",
            "content": "リスカしたら死ねるかな",
            "Chinese": "割腕的话能死掉吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:00:22",
            "content": "みんなから言われます",
            "Chinese": "大家都这么说。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:01:11",
            "content": "そうなんですね。それはとても辛いですね。",
            "Chinese": "是这样啊。这一定非常痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:02:20",
            "content": "いつ頃からそのような事を言われたのでしょうか？",
            "Chinese": "您是从什么时候开始被这样说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:03:00",
            "content": "今年から",
            "Chinese": "从今年开始。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:03:05",
            "content": "深く切ったら死ねますか？",
            "Chinese": "如果割得深一点能死吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:04:46",
            "content": "切ってみたいです",
            "Chinese": "我想试试割腕。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:04:56",
            "content": "そこまで考えるほど辛いと思われているんですね。",
            "Chinese": "您感到如此痛苦，以至于会这么想啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:08:21",
            "content": "なんで教えてくれないんですか",
            "Chinese": "为什么不肯告诉我呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:09:58",
            "content": "そのような気持ちになるなら、無理して学校に行かなくてもと思うんですが、あなたはどう思いますか？",
            "Chinese": "如果您都有了那样的想法，我觉得或许可以不用勉强自己去上学，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:10:10",
            "content": "もう生きていたくありません",
            "Chinese": "我不想再活下去了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:11:48",
            "content": "それは学校に行くのが辛いから、そう思われているんじゃないんですか。",
            "Chinese": "您会这么想，会不会是因为去学校太痛苦了呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:12:24",
            "content": "あーやっぱり迷惑かけてる",
            "Chinese": "啊——我果然还是在给人添麻烦。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:12:37",
            "content": "もう死ぬしかないな",
            "Chinese": "看来只能去死了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:13:27",
            "content": "そのように思うんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:14:33",
            "content": "まだあったばかりですけど、あなたには生きてほしいと思います。",
            "Chinese": "虽然我们才刚见面，但我希望您能活下去。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:15:06",
            "content": "信用できません",
            "Chinese": "我无法相信。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:15:22",
            "content": "生きてるだけで辛いのに",
            "Chinese": "明明光是活着就已经很痛苦了。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:15:34",
            "content": "なんでそこまでして苦しめるの",
            "Chinese": "为什么还要这样折磨我？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:17:37",
            "content": "あなたを苦しめるつもりはないですよ。辛いなら家でゆっくり休みをとったほうがいいと思いますよ。",
            "Chinese": "我并不是想让您痛苦。如果感到难受，我觉得在家好好休息会更好。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:17:51",
            "content": "できません",
            "Chinese": "做不到。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:18:00",
            "content": "簡単に言わないで",
            "Chinese": "别说得那么轻松。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:20:27",
            "content": "そうですね。簡単な事ではないですよね。ただこのままだと、あなたの心が壊れてしまうのではと心配です。",
            "Chinese": "是的，您说得对。这不是一件容易的事。只是我担心再这样下去，您的心会崩溃的。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:20:38",
            "content": "もう壊れてもいいです",
            "Chinese": "就算崩溃了也无所谓。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:20:57",
            "content": "どうせ生きても仕方がないから",
            "Chinese": "反正活着也没什么意义。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:22:02",
            "content": "そう思われるんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:22:47",
            "content": "これからの事をあなたと一緒に考えていきたいと思っています。",
            "Chinese": "我希望能和您一起思考未来的事情。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:23:16",
            "content": "死にたい",
            "Chinese": "我想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:24:18",
            "content": "そう思うほど苦しいんですね。",
            "Chinese": "您是痛苦到有这种想法了啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:25:51",
            "content": "学校に行かなくてもいいとなったら、あなたの気持ちはどうなりますか？",
            "Chinese": "如果可以不用去上学了，您的心情会怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:26:00",
            "content": "変わりません",
            "Chinese": "不会改变。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:26:46",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:27:37",
            "content": "家に居ても辛いと感じるのでしょうか？",
            "Chinese": "即使待在家里也会感到痛苦吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:27:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:28:12",
            "content": "もう限界です",
            "Chinese": "已经到极限了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:29:55",
            "content": "あなたには生きてほしい。嫌な事があった場合にはいつでも相談に来てほしいと思います。今後のことを一緒に考えていきましょう。",
            "Chinese": "我希望您能活下去。如果遇到不愉快的事情，希望您随时可以来咨询。让我们一起思考未来的事情吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:30:11",
            "content": "さようなら",
            "Chinese": "再见。"
        },
        {
            "role": "クライアント",
            "time": "2023/08/30(水) 16:30:33",
            "content": "（ロープレお疲れ様でした。このまま終了の流れでお願いします。）",
            "Chinese": "（这次角色扮演辛苦了。请就按这样的流程结束吧。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/08/30(水) 16:31:14",
            "content": "またお話に来てくださいね。今日はこれで終わりにさせていただきます。",
            "Chinese": "欢迎您随时再来聊。今天就到此结束了。"
        }
    ],
