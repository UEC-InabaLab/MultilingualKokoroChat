{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:00:29",
            "content": "相談員です。本日はご相談にお越しいただきありがとうございます。はじめにご年齢と性別を教えていただけますか？",
            "Chinese": "我是咨询员。感谢您今天前来咨询。首先，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:00:55",
            "content": "13才　女性",
            "Chinese": "13岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:01:30",
            "content": "ありがとうございます。本日はどのようなご相談でしたか？",
            "Chinese": "谢谢您。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:01:51",
            "content": "家にいたくない",
            "Chinese": "我不想待在家里。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:02:53",
            "content": "そうなんだね。教えてくれてありがとうね。なにか訳でもあるのかな？",
            "Chinese": "是这样啊。谢谢你告诉我。是不是有什么原因呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:03:26",
            "content": "嫌だから",
            "Chinese": "因为很讨厌。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:04:16",
            "content": "そっか。。何か嫌なことがあったんだね。よかったら話してくれるかな？",
            "Chinese": "这样啊……是发生了什么讨厌的事情吧。如果你愿意的话，能和我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:04:35",
            "content": "殴られたことある",
            "Chinese": "被打过。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:05:21",
            "content": "え！そうだったんだね。誰にされたのか話せるかな？？",
            "Chinese": "啊！原来是这样。能告诉我被谁打的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:05:48",
            "content": "お父さん",
            "Chinese": "爸爸。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:06:48",
            "content": "そうだったんだね。お父さんだとかなり力が入っていて、相当痛かったよね。。",
            "Chinese": "这样啊。被爸爸打的话力气会很大，一定很疼吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:07:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:07:56",
            "content": "うんうん。その時、ケガはなかったの？",
            "Chinese": "嗯嗯。那时候，有受伤吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:08:20",
            "content": "最近は大丈夫",
            "Chinese": "最近还好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:09:33",
            "content": "そうなんだね。最近は、、というと、前からこういうことはあったのかな？",
            "Chinese": "是这样啊。你说“最近还好”，那是不是说以前也发生过这样的事情？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:10:00",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:11:13",
            "content": "そうだったんだね。そうすると家にお父さんがいると、いつもとてもコワい思いをしてきたんだね。。",
            "Chinese": "原来如此。那这么说来，只要爸爸在家，你一直以来都感到很害怕吧…"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:11:27",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:13:07",
            "content": "うんうん。そうだよね。。ちなみに、ニックネームでもかまわないから、なんてお呼んだらよいかな？",
            "Chinese": "嗯嗯，是啊。顺便问一下，用昵称也可以，我该怎么称呼你呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:13:19",
            "content": "ゆい",
            "Chinese": "由衣。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:14:35",
            "content": "ゆいさん、ありがとう。ところで、どのくらい前からお父さんのこういうことは始まったのかな？",
            "Chinese": "由衣，谢谢你。对了，爸爸的这种行为大概是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:15:18",
            "content": "小学校の5年くらいから",
            "Chinese": "大概从小学五年级开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:16:44",
            "content": "そんなに前からだったんだね。。こわい思いの中、よくしんぼうしてきたんだね。",
            "Chinese": "原来从那么早就开始了啊……在恐惧中，你一直忍耐到现在，很不容易吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:16:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:18:49",
            "content": "うんうん。お父さんは、どういった時にゆいさんに暴力をふるうのかな？",
            "Chinese": "嗯嗯。爸爸一般在什么样的时候会对由衣动手呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:19:22",
            "content": "お酒飲んだとき",
            "Chinese": "喝了酒的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:21:28",
            "content": "そうなんだね。酔っぱらって暴力をふるうんだね。。",
            "Chinese": "是这样啊。喝醉了就施暴啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:21:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:23:17",
            "content": "うんうん。そんな時は家にいたくないよね。。ちなみにお父さんはお酒は週に何日ぐらい飲んでいるのかな？",
            "Chinese": "嗯嗯。那种时候你肯定不想待在家里吧……顺便问一下，爸爸一周大概喝几天酒呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:24:08",
            "content": "3回くらい",
            "Chinese": "大概三次。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:25:47",
            "content": "そうなんだね。。じゃあ、1週間に3日はお父さんはゆいさんを殴っているの？",
            "Chinese": "这样啊……那是不是说，一个星期里有三天爸爸都会打由衣呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:26:30",
            "content": "毎回は殴らない",
            "Chinese": "并不是每次都会打。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:26:47",
            "content": "機嫌の悪い時だけ",
            "Chinese": "只有心情不好的时候才打。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:30:13",
            "content": "そうだったんだね。。小５から始まったってあったけど、ゆいさんのお父さんに対する気持ちって、昔と今とどう変わったか、教えてくれるかな？",
            "Chinese": "原来如此……你说是从五年级开始的，不过，你对爸爸的感受，和以前相比有什么变化吗？可以跟我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:30:48",
            "content": "よく分かんない",
            "Chinese": "不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:31:42",
            "content": "そっか。。そうだよね。昔のお父さんは、ゆいさんにとってはどんなお父さんでしたか？",
            "Chinese": "这样啊……是啊。以前的爸爸，对由衣来说是个怎样的爸爸呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:32:20",
            "content": "3年くらい前に家にきた",
            "Chinese": "大概三年前来到家里。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:33:43",
            "content": "そうだったんだね。じゃあ、今のお父さんは、ゆいさんの本当のお父さんではないってことかな？",
            "Chinese": "原来如此。也就是说，现在的这位爸爸，并不是由衣的亲生父亲，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:33:52",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:35:57",
            "content": "そうだったんだね。じゃあ、3年くらい前に来た時から、お父さんはゆいさんにとっては今とそんなに変わらない感じなのかな？",
            "Chinese": "原来如此。那么，从大概3年前他来的时候起，爸爸在由衣心中的感觉和现在差不多吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:36:20",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:38:24",
            "content": "そうだったんだね。。その時からゆいさんはお父さんのいる家には帰りたくなかったってことなのかな？",
            "Chinese": "明白了……也就是说从那时候起，由衣就不想回有爸爸在的家了，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:38:58",
            "content": "そうですね",
            "Chinese": "是的吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:39:37",
            "content": "もう消えてしまいたい",
            "Chinese": "我真想消失算了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:39:46",
            "content": "うんうん。そうだよね。ゆいさんにとっては知らない大人の男の人が家にいるんだもんね。",
            "Chinese": "嗯嗯，是啊。对由衣来说，就像一个不认识的成年男人待在家里一样，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:40:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:41:54",
            "content": "そうだよね。。そういう気持ちになるよね。。ちなみに、ゆいさんのお母さんは、ゆいさんが殴られている時は、どうしているの？",
            "Chinese": "是啊……有那样的感觉很正常……顺便问一下，当由衣被打的时候，你的妈妈在做什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:42:49",
            "content": "家にいないことがほとんど",
            "Chinese": "大多不在家。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:43:56",
            "content": "そうなのね。お母さんはそういう時は何をされているんですか？",
            "Chinese": "是这样啊。那样的时候，你妈妈在做什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:44:12",
            "content": "お仕事",
            "Chinese": "工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:45:03",
            "content": "そうだったんだね。じゃあ、お母さんはゆいさんがお父さんから何をされているか、知らないっってことかな？",
            "Chinese": "是这样啊。那么，妈妈不知道你被爸爸做了什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:45:41",
            "content": "あまり知らないと思う",
            "Chinese": "我觉得她不太清楚。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:46:07",
            "content": "お母さんが家にいる時",
            "Chinese": "当妈妈在家的时候——"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:46:27",
            "content": "うんうん。聴いていますよ。",
            "Chinese": "嗯嗯，我在听着。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:46:28",
            "content": "お母さんを叩いてる",
            "Chinese": "他打妈妈。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:47:38",
            "content": "そういうことだったんだね。2人ともが、お父さんから暴力を受けているんだね。。",
            "Chinese": "原来是这样啊。你们两个人，都被爸爸施暴了呢…"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:47:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:48:40",
            "content": "もう消えたい",
            "Chinese": "已经想消失了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:50:33",
            "content": "そうだったんだね。。2人で怖い思いをしているんだね。ゆいさんはお母さんには、お父さんからされていることを話したりしないの？",
            "Chinese": "我明白了……你们两个人都在承受恐惧。由衣，你有没有把爸爸对你做的事告诉妈妈呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:50:54",
            "content": "話したことない",
            "Chinese": "没说过。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:51:32",
            "content": "お母さんと同じ状況なのに？話さないのはどうしてかな？",
            "Chinese": "明明你和妈妈处境相同，为什么不告诉她呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:51:53",
            "content": "言うなって言われてる",
            "Chinese": "他说不许说。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:53:08",
            "content": "うんうん。そうだよね。言ったらもっと怖い思いをするかも、、って思っちゃうよね。。",
            "Chinese": "嗯嗯，我懂。如果说出来，可能会让你更害怕……你会这么想吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:53:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:55:49",
            "content": "ここまでのゆいさんのお話をお聴きして、私はこれは「児童虐待」になると思っています。",
            "Chinese": "听到目前为止由衣的叙述，我认为这已经属于“儿童虐待”。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:56:14",
            "content": "そうなんですか",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 20:57:14",
            "content": "そうなんです。18歳以下の児童の場合はこれに当たります。",
            "Chinese": "是的。对于未满18岁的儿童，这就属于儿童虐待。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 20:59:27",
            "content": "どうなりますか",
            "Chinese": "那会怎么样呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:01:51",
            "content": "児童相談所虐待対応ダイヤル「１８９」がフリーダイヤルであるんですが、ゆいさんがご自身で電話するとなると、とても勇気がいると思いますが、ゆいさん自身はどう思うかな？https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/kodomo/kodomo_kosodate/dial_189.html",
            "Chinese": "有一个儿童咨询所虐待应对热线“189”，是免费电话。不过要由由衣自己打电话，可能需要很大的勇气。由衣你自己怎么看呢？https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/kodomo/kodomo_kosodate/dial_189.html"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:02:58",
            "content": "見つかったら殴られるんじゃないか怖い",
            "Chinese": "我怕被发现的话会被打。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:03:41",
            "content": "もうすぐお父さん帰ってくる",
            "Chinese": "爸爸马上就要回来了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:03:49",
            "content": "うんうん。そうだよね。そんな怖い思いはしなくて良いからね。",
            "Chinese": "嗯嗯，是啊。你不需要承受那样的恐惧了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:04:25",
            "content": "そっか。。ではこちらからフリーダイヤルで連絡は入れても良いかな？",
            "Chinese": "这样啊……那么由我们这边通过免费热线联系，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:04:38",
            "content": "どうなりますか",
            "Chinese": "那会怎样呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:05:03",
            "content": "ゆいさんのお近くの児童相談所へ連絡が行きます。",
            "Chinese": "会联系到由衣附近的儿童咨询所。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:05:11",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:05:26",
            "content": "そして、専門家の人が対応されます。",
            "Chinese": "然后会由专业人员来处理。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:05:47",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:06:05",
            "content": "ゆいさんとお母さんを守るための第1歩です。",
            "Chinese": "这是为了保护由衣和你妈妈的第一步。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:06:37",
            "content": "助けてくれるんですか",
            "Chinese": "他们会帮我们吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:07:47",
            "content": "ゆいさんとお母さんを助けるためです！このダイヤルはそのためのものです！",
            "Chinese": "就是为了帮助由衣和你妈妈的！这个热线就是为此设置的！"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:08:01",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:08:27",
            "content": "少なくとも、児童虐待については、こちらも通報の義務があります。",
            "Chinese": "至少就儿童虐待而言，我们这边也有通报的义务。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:08:40",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:09:03",
            "content": "殴られないですか",
            "Chinese": "不会被打吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:10:43",
            "content": "ゆいさんの安全を第一に対応してもらいます。そういう可能性があるということをきちんと伝えます。最善の注意を払ってもらいます。",
            "Chinese": "我们会请他们把由衣的安全放在第一位。我会把存在这种风险如实告知他们，请他们采取最谨慎的应对。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:11:05",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:12:48",
            "content": "今、ゆいさんにできることを提案したいのですが、まだお父さん帰ってこないかな？",
            "Chinese": "我想给由衣建议一些你现在可以做的事情，请问爸爸还没回来吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:12:59",
            "content": "まだです",
            "Chinese": "还没。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:14:53",
            "content": "急ぎますね。お父さんがお酒を飲んで、機嫌が悪そうな時は、できるだけ家にいないようにするとか、お母さんが帰ってくるまで、家以外のお友達の家か、ご親戚の家に行くとか避難していてほしいでのすが、出来そうですか？",
            "Chinese": "那我抓紧时间说。当你爸爸喝了酒、看起来心情不好的时候，我希望你尽可能不要待在家里，比如在妈妈回来之前，去朋友家或者亲戚家避一避，可以做到吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:15:47",
            "content": "んーコンビニに行くくらいかな",
            "Chinese": "嗯——大概只能去便利店。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:16:20",
            "content": "夜たまに行く",
            "Chinese": "有时晚上会去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:16:44",
            "content": "うーん。そっか。。思いつく逃げ場ってあるかな？",
            "Chinese": "嗯……这样啊……有没有什么你能想到的可以暂时避开的地方？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:16:57",
            "content": "ない",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:17:34",
            "content": "そうだよね。。ゆいさんの部屋に鍵は付いている？",
            "Chinese": "也是……由衣的房间有锁吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:17:46",
            "content": "ついてない",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:18:37",
            "content": "ほかに、鍵のついている部屋ってないかな？",
            "Chinese": "家里还有其他带锁的房间吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:18:57",
            "content": "ない",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:19:20",
            "content": "じゃあ、トイレかお風呂場かな？",
            "Chinese": "那么，厕所或者浴室呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:19:39",
            "content": "トイレはついてる",
            "Chinese": "厕所是有锁的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:20:24",
            "content": "そうなんだね。そういう時はトイレに閉じこもっていられそう？",
            "Chinese": "这样啊。那遇到那样的情况时，能躲在厕所里吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:21:20",
            "content": "隠れたら余計殴られそう",
            "Chinese": "如果躲起来的话，感觉会被打得更惨。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:23:11",
            "content": "それもそうだよね。。ゆいさんが思う、「軽傷で済む方法」ってあるのかな？",
            "Chinese": "这也有道理……在你看来，有没有什么“能尽量减轻伤害”的办法？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:23:25",
            "content": "分かんない",
            "Chinese": "不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:24:38",
            "content": "そうだよね。。分からないよね。。専門家の人に緊急で対応していただくように伝えます。",
            "Chinese": "是啊……确实很难知道该怎么办……我会转达，请专业人员紧急介入处理。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:24:52",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:25:55",
            "content": "そろそろお父さんが帰ってきてしまうと思うので、今日は一旦ここまでにしても大丈夫ですか？早急に通報もしたいので。",
            "Chinese": "我想你爸爸差不多要回来了，今天先到这里可以吗？我也希望能尽快进行通报。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:26:09",
            "content": "はい",
            "Chinese": "可以。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:26:46",
            "content": "大丈夫です",
            "Chinese": "没问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:26:49",
            "content": "今日は、本当に怖い思いをしている中、よくぞ勇気を出して相談にきてくれて、ありがとうね。",
            "Chinese": "今天，你在非常害怕的情况下，依然鼓起勇气前来咨询，非常感谢你。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:27:16",
            "content": "話聞いてくれてありがとうございます",
            "Chinese": "谢谢您听我倾诉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:27:27",
            "content": "とんでもないです！一刻も早く、ゆいさんを助けたいと思います。",
            "Chinese": "别客气！我希望能尽快帮助由衣。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:27:41",
            "content": "お願いします",
            "Chinese": "拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:27:46",
            "content": "だから、もう少し待っていてね。",
            "Chinese": "所以，再稍微等一下哦。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:27:51",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:29:04",
            "content": "では、今日の相談は以上で一旦終わりますが、また何かお話したくなったら、すぐに相談にくださいね。",
            "Chinese": "那么，今天的咨询就暂时到此结束，如果之后还想聊什么，随时可以来找我。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:29:14",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:29:22",
            "content": "またきます",
            "Chinese": "我还会再来的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:29:37",
            "content": "うんうん。待ってますね。",
            "Chinese": "嗯嗯。我等着你。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:30:17",
            "content": "それでは、ここで終了いたしますね。",
            "Chinese": "那么，就到这里结束啦。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:30:24",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:30:30",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:31:16",
            "content": "こちらこそありがとうございました。",
            "Chinese": "我也要谢谢你。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:31:29",
            "content": "(お疲れ様でした！)",
            "Chinese": "(您辛苦了！)"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:32:12",
            "content": "（お疲れ様でした。こんなにお時間がかかって、本当にごめんなさい！でもとっても良い勉強をさせていただきました）",
            "Chinese": "（辛苦了。花了这么多时间，真的非常抱歉！不过我也学到了很多。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/20(木) 21:32:26",
            "content": "（ありがとうございました！）",
            "Chinese": "（非常感谢！）"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:32:35",
            "content": "(こちらこらとても勉強になりました。有難うございました！)",
            "Chinese": "(我这边也收获良多。非常感谢！)"
        },
        {
            "role": "クライアント",
            "time": "2021/05/20(木) 21:32:49",
            "content": "(それでは失礼いたします)",
