{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 20:53:03",
            "content": "(こんばんは、本日はよろしくお願いいたします）",
            "Chinese": "（晚上好，今天请多多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 20:55:33",
            "content": "（こんばんは、よろしくお願いいたします。）",
            "Chinese": "（晚上好，请多多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:00:12",
            "content": "こんばんは、相談員です。よろしくお願いします。はじめに、年齢、性別、相談内容を教えてください。",
            "Chinese": "晚上好，我是咨询员。请多关照。首先，请告诉我您的年龄、性别以及咨询内容。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:00:48",
            "content": "16さい女です",
            "Chinese": "16岁，女生。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:00:54",
            "content": "消えてしまいたいです",
            "Chinese": "我很想就这样消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:00:57",
            "content": "お返事ありがとうございます。",
            "Chinese": "谢谢您的回复。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:01:44",
            "content": "消えてしまいたい、、・何があったのか、教えてくれますか？",
            "Chinese": "您说想要消失……发生了什么事呢？能告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:02:12",
            "content": "何から話したらいいですか？",
            "Chinese": "我该从哪里说起呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:02:56",
            "content": "そうですね、、。まずは高校1年生ですか？",
            "Chinese": "这样啊……。首先，您是高一吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:03:25",
            "content": "高2です",
            "Chinese": "高二。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:03:38",
            "content": "教えてくれてありがとうございます。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:04:19",
            "content": "いつから、消えてしまいたいと思うようになったの？",
            "Chinese": "您是从什么时候开始想要消失的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:05:18",
            "content": "最近です",
            "Chinese": "最近。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:05:51",
            "content": "そうなんですね、辛い気持ちを抱えているのですね。",
            "Chinese": "这样啊，您正承受着痛苦的心情呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:06:24",
            "content": "一人で抱えてきたの？",
            "Chinese": "您一直独自承受着吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:07:13",
            "content": "両親には話しました",
            "Chinese": "我跟父母说过了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:08:18",
            "content": "そうなんですね、あなたに味方してくれるご両親がいて心強いですね。",
            "Chinese": "这样啊，有支持您的父母在身边，真是令人安心呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:08:40",
            "content": "味方？",
            "Chinese": "支持我？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:08:53",
            "content": "全然そうじゃないと思います",
            "Chinese": "我完全不这么认为。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:09:03",
            "content": "そうだったんだね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:09:17",
            "content": "私の気持ちなんてわかってない",
            "Chinese": "他们根本不懂我的感受。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:09:28",
            "content": "そう感じるんだね。",
            "Chinese": "您是这样感觉的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:09:46",
            "content": "どんなふうに言われたのかな？",
            "Chinese": "他们是怎么对您说的呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:10:26",
            "content": "叱られたりしたのかな？",
            "Chinese": "是被责备了吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:10:55",
            "content": "気にする必要はないと",
            "Chinese": "他们说没必要在意。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:11:28",
            "content": "気にする必要はないって言われたんだね、、、気持ちに寄り添ってもらえなかったんだね。",
            "Chinese": "他们说没必要在意啊……看来他们没能体谅您的心情呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:11:37",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:11:53",
            "content": "そっか、、、それは寂しいよね。",
            "Chinese": "这样啊……那一定很孤单吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:12:19",
            "content": "今日は、ここにきてもらえてよかった、",
            "Chinese": "今天您能来到这里真是太好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:12:48",
            "content": "少しでもあなたの気持ちが軽くなるように",
            "Chinese": "希望能让您的心情稍微轻松一些。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:12:49",
            "content": "消えてもいいですか？",
            "Chinese": "我可以消失吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:12:58",
            "content": "消えたいんです",
            "Chinese": "我就是想消失。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:13:06",
            "content": "いなくなりたいんです",
            "Chinese": "我想要消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:13:17",
            "content": "うんうん（聞いています）",
            "Chinese": "嗯嗯（我在听）。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:13:30",
            "content": "辛いんだね",
            "Chinese": "这一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:13:36",
            "content": "いい方法ないですか？",
            "Chinese": "有什么好方法吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:13:44",
            "content": "消える方法",
            "Chinese": "消失的方法。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:14:03",
            "content": "そこまで考えているのですね。",
            "Chinese": "您已经想到这一步了啊。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:14:18",
            "content": "未来に希望はないです",
            "Chinese": "我对未来不抱希望。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:14:35",
            "content": "消えて楽になりたいです",
            "Chinese": "我想消失，想解脱。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:14:52",
            "content": "そんなふうに感じているんだね。あなたが少しでも軽くなるように一緒に考えさせてください。",
            "Chinese": "您是这样感觉的啊。请让我和您一起想想办法，希望能稍微减轻您的负担。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:15:04",
            "content": "解決できますか？",
            "Chinese": "能解决吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:15:34",
            "content": "少しでも、少しずつでも軽くしていきましょう。",
            "Chinese": "让我们一点一点地，慢慢地减轻您的负担吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:15:38",
            "content": "ただただ消えたいんです",
            "Chinese": "我只、只想消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:15:49",
            "content": "苦しいんだね、、、。",
            "Chinese": "这一定很痛苦吧……。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:16:08",
            "content": "今は、どこからお話ししてくれているの？",
            "Chinese": "您现在是在哪里和我交谈呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:16:12",
            "content": "いなくなってもいいですか？",
            "Chinese": "我可以消失吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:16:33",
            "content": "私は、そうなってほしくない。",
            "Chinese": "我不希望您那样做。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:16:44",
            "content": "公園のベンチ",
            "Chinese": "在公园的长椅上。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:16:45",
            "content": "あなたを助けたい。",
            "Chinese": "我想帮助您。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:17:01",
            "content": "そうなんだね、雨とか降ってない？",
            "Chinese": "这样啊，下雨了吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:17:11",
            "content": "寒くないですか？",
            "Chinese": "您不冷吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:17:17",
            "content": "誰も助けてくれないし、助けてほしいとも思わない",
            "Chinese": "没人会帮我，我也不想要别人帮忙。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:17:44",
            "content": "ただ消えたいだけです",
            "Chinese": "我只是想消失而已。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:17:46",
            "content": "そう思うのは、どうしてかな？",
            "Chinese": "您为什么会这样想呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:18:11",
            "content": "生きづらいからです",
            "Chinese": "因为活得很艰难。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:18:34",
            "content": "そっか、、、。どんなふうに生きづらいの？",
            "Chinese": "这样啊……。具体是哪些方面让您感到艰难呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:18:58",
            "content": "人との関わりがうまくいかない",
            "Chinese": "和人相处总是搞不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:19:10",
            "content": "そうだったんだね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:19:21",
            "content": "それは、苦しいよね。",
            "Chinese": "那一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:19:35",
            "content": "空気が読めないみたいです",
            "Chinese": "我好像不会察言观色。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:19:54",
            "content": "それは、難しいよね。最近って、言ってくれたけど、、",
            "Chinese": "这确实很难啊。您之前说这是最近的事……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:20:13",
            "content": "学校で、何かあったのかな？",
            "Chinese": "是在学校发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:20:44",
            "content": "友達がわたしの悪口言ってるのが聞こえちゃって",
            "Chinese": "我不小心听到朋友在背后说我的坏话。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:20:57",
            "content": "うんうん、",
            "Chinese": "嗯嗯，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:21:10",
            "content": "それは、嫌な気持ちになるよね。",
            "Chinese": "那肯定会很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:21:10",
            "content": "みんなやっぱりわたしのこと嫌いなんだと思います",
            "Chinese": "我想大家果然还是讨厌我。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:21:26",
            "content": "嫌ってゆうか納得した",
            "Chinese": "与其说是讨厌，不如说我接受了这个事实。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:21:27",
            "content": "そんな？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:22:17",
            "content": "どうせわたしは嫌われ者",
            "Chinese": "反正我就是个讨人嫌的家伙。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:22:25",
            "content": "消えた方がいい",
            "Chinese": "还是消失算了。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:22:48",
            "content": "生きているとみんなに迷惑かける",
            "Chinese": "活着只会给大家添麻烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:22:50",
            "content": "そう感じてしまっているんだね、、、辛いよね。納得したというのは、どんなことなんだろう、、、？よかったら教えてくれるかな？",
            "Chinese": "您是这样感觉的啊……一定很痛苦吧。您说的“接受了”，是指什么呢？如果方便的话，能告诉我吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:23:06",
            "content": "迷惑、、、、？",
            "Chinese": "添麻烦……？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:23:38",
            "content": "空気が読めないし、人を傷つける発言をするし。",
            "Chinese": "我不懂察言观色，也总说出会伤人的话。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:23:58",
            "content": "友達が逃げていく",
            "Chinese": "朋友们都会疏远我。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:24:18",
            "content": "そっか、、、そんなことがあったんだね。",
            "Chinese": "这样啊……原来发生过这样的事情啊。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:24:18",
            "content": "最後はひとりぼっち",
            "Chinese": "最后只剩下我一个人。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:24:38",
            "content": "だから消えたいんです",
            "Chinese": "所以我才想消失。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:24:46",
            "content": "いなくなりたいんです",
            "Chinese": "我想要消失。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:24:55",
            "content": "きっとみんなも願ってます",
            "Chinese": "大家一定也在希望我消失。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:25:07",
            "content": "わたしが消えた方がみんな喜ぶ",
            "Chinese": "我消失了大家都会高兴。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:25:09",
            "content": "そんなことないよ。中学生の頃はお友達関係はどうでしたか？",
            "Chinese": "并不是这样的。您初中时的朋友关系怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:25:31",
            "content": "中学のときも友達はいませんでした",
            "Chinese": "初中的时候也没有朋友。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:25:46",
            "content": "空気が読めないから",
            "Chinese": "因为我不会察言观色。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:25:51",
            "content": "そうだったんだね、、。寂しかったね。",
            "Chinese": "是这样啊……一定很孤单吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:26:14",
            "content": "そっか、、そう思うんだね。",
            "Chinese": "这样啊……您是这么想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:26:44",
            "content": "あなたが一番悩んでいることは、空気が読めないことかな？",
            "Chinese": "您最困扰的事情，是不是不会察言观色呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:26:54",
            "content": "消えたら楽になると思うんです",
            "Chinese": "我觉得消失了就能解脱了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:27:13",
            "content": "楽？",
            "Chinese": "解脱？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:27:45",
            "content": "私は、あなたに消えてほしくない。",
            "Chinese": "我不希望您消失。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:28:29",
            "content": "人との関わりがうまくいかないこと",
            "Chinese": "是和别人相处不好的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:28:48",
            "content": "うんうん、一緒に、気持ちが少しでの軽くなれる方法を考えましょう。",
            "Chinese": "嗯嗯，让我们一起想办法，让您的心情能稍微轻松一些。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:28:54",
            "content": "それが何年も続いていることです",
            "Chinese": "而且这种情况已经持续好几年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:29:10",
            "content": "そうなんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:29:15",
            "content": "では、",
            "Chinese": "那么，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:29:43",
            "content": "今日は、人間関係がうまくいくように",
            "Chinese": "今天，为了能让您的人际关系顺利一些，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:30:00",
            "content": "一緒に考えるというのはどうですか？",
            "Chinese": "我们一起想想办法，怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:30:58",
            "content": "うまくいくようになりますか？",
            "Chinese": "真的会变顺利吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:31:23",
            "content": "そうだね、、心配だよね。",
            "Chinese": "是啊……您一定很担心吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:31:34",
            "content": "でも、ここで",
            "Chinese": "但是，在这里，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:31:45",
            "content": "例えばだけど、",
            "Chinese": "比如说，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:32:09",
            "content": "相手に伝える言葉の練習とかしてみませんか？",
            "Chinese": "您愿意尝试练习一下如何向对方表达吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:33:46",
            "content": "なにが正解なのかわかりません",
            "Chinese": "我不知道什么才是正确的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:34:05",
            "content": "あなたが、誰かを傷つけてしまうということに辛い思いをしていたように見えたので考えてみましたが、、いかがですか？",
            "Chinese": "我注意到您似乎因为可能伤害他人而感到痛苦，所以才这样提议的，您觉得如何？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:34:19",
            "content": "正解、、、？",
            "Chinese": "正确……？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:34:31",
            "content": "みんながエッ？って顔をします",
            "Chinese": "大家都会露出“诶？”那样的表情。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:34:56",
            "content": "例えばどんな時？",
            "Chinese": "比如在什么情况下呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:35:10",
            "content": "どんなふうに伝えてみたのかな？",
            "Chinese": "您当时是怎么表达的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:35:14",
            "content": "わたしの発言が相手を傷つけてるみたいです",
            "Chinese": "好像我的发言伤害到了对方。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:35:33",
            "content": "どんなふうかはわかりません",
            "Chinese": "但具体哪里不妥我也不清楚。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:35:44",
            "content": "わたしは何気なく言っているので",
            "Chinese": "因为我都是无意中说出口的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:35:50",
            "content": "名あるほど、、、。どんな言葉を伝えたんだろう。",
            "Chinese": "原来如此……。您当时说了些什么话呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:36:10",
            "content": "なるほど　です、ごめんなさいね。",
            "Chinese": "是“原来如此”的意思，不好意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:37:10",
            "content": "あなたは、相手に気を遣える人のように相談員は感じるのだけれど、、、。",
            "Chinese": "但是，我感觉您是一个很会为对方着想的人啊……"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:37:19",
            "content": "どんな、、、忘れました",
            "Chinese": "说了什么……我忘了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:37:34",
            "content": "そっか、、。",
            "Chinese": "这样啊……。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:37:40",
            "content": "では、",
            "Chinese": "那么，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:38:39",
            "content": "どんなきっかけで今回は空気が読めなかったなーって感じてるのかな？",
            "Chinese": "您觉得这次是什么契机让您觉得自己没读懂气氛的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:40:01",
            "content": "自分ではわかりません。周りが空気読めないね！って言ってます",
            "Chinese": "我自己也不知道。是周围的人说我“真不会看气氛啊！”"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:40:20",
            "content": "そうなんだね、、、。",
            "Chinese": "这样啊……。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:40:39",
            "content": "自分でもわからないと不安だし、辛いよね。",
            "Chinese": "自己也不清楚的话，一定很不安，也很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:41:09",
            "content": "空気を読むってのがよくわかりません",
            "Chinese": "我不太懂“察言观色”是什么意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:41:10",
            "content": "ご両親が、気にするな。と言っていたのはどうしてなのだろう。",
            "Chinese": "您父母说‘别在意’，您觉得这是为什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:41:40",
            "content": "そうだよね、、空気を読むのって相談員も難しいですよ。",
            "Chinese": "说的是呢……察言观色这件事，对我来说也很难哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:41:56",
            "content": "あなただけじゃないです。",
            "Chinese": "这并不是只有您才会这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:42:25",
            "content": "意外とみんなも難しいと思うことですよ。",
            "Chinese": "其实很多人也会觉得这很难的。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:42:36",
            "content": "ネットで調べたら発達障害って出てきました",
            "Chinese": "我在网上查了一下，查到了“发育障碍”这个词。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:43:02",
            "content": "だから、あなたは悪くない。調べたんですね。",
            "Chinese": "所以，这不是您的错。您已经查过了啊。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:43:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:43:39",
            "content": "でも、そうかどうかはわからないよね、、。",
            "Chinese": "但是，是否真的是那样还不确定呢……。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:43:58",
            "content": "ご両親には伝えてみたの？",
            "Chinese": "有跟父母说吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:44:22",
            "content": "自分が周りから言われてることがたくさん当てはまってる気がします",
            "Chinese": "我感觉周围人说的很多情况都和我对得上。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:44:38",
            "content": "そっか、そうなんだね、、、",
            "Chinese": "是吗，原来是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:44:49",
            "content": "まだ伝えていません",
            "Chinese": "还没有告诉他们。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:44:57",
            "content": "これって病気なんですか？",
            "Chinese": "这算是一种病吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:45:14",
            "content": "治るんですか？",
            "Chinese": "能治好吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:45:33",
            "content": "そうなんですね。んーどうなんだろう、、。",
            "Chinese": "是这样啊。嗯——这个嘛……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:45:55",
            "content": "私は、医師ではないのでわからないけど、、、",
            "Chinese": "我不是医生，所以不太清楚，不过……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:45:59",
            "content": "でも",
            "Chinese": "但是，"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:46:12",
            "content": "病院に行った方がいいんですか？",
            "Chinese": "我是不是该去医院看看？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:46:32",
            "content": "でももう消えるならどっちでもいっか",
            "Chinese": "不过反正都要消失了，怎样都无所谓了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:46:45",
            "content": "いきずらいことを、どのように対処していくか。それが大切だと思いますよ。",
            "Chinese": "该如何去应对生活中感到的困难，我觉得这才是最重要的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:47:00",
            "content": "そんなことないですよ。",
            "Chinese": "没有那回事哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:47:29",
            "content": "あなたは、私にもとても気を遣ってくれているもの。",
            "Chinese": "您对我说话也很体贴周到啊。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:47:41",
            "content": "どこらへんがですか？",
            "Chinese": "从哪里看出来的？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:47:47",
            "content": "自分ではわかりません",
            "Chinese": "我自己感觉不到。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:47:59",
            "content": "自分のことが全然わかりません",
            "Chinese": "我完全不了解自己。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:48:01",
            "content": "こうやって、ここにきてちゃんと話してくれる勇気もみっています。",
            "Chinese": "您能这样来到这里，勇敢地和我交谈，这份勇气我也看到了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:48:17",
            "content": "そうだよね、自分では見えないよね。",
            "Chinese": "是啊，自己是看不到自己的呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:48:30",
            "content": "消える方法って教えてもらえますか？",
            "Chinese": "能告诉我消失的方法吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:49:31",
            "content": "あなたは、一番どうなったら良いと思うかな？",
            "Chinese": "您觉得，怎样对您来说才是最好的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:49:49",
            "content": "みんなから必要とされてないみたいだから、いなくなりたいです",
            "Chinese": "我好像不被任何人需要，所以想消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:50:24",
            "content": "みんなから必要だと思われたら嬉しいんだね。",
            "Chinese": "如果大家觉得需要您，您会很开心吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:50:45",
            "content": "そんな日は来るはずないけど",
            "Chinese": "虽然那样的一天不可能到来。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:50:54",
            "content": "ずっとひとりぼっちだったし",
            "Chinese": "因为我一直都是孤身一人。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:50:59",
            "content": "そんなことないよ。",
            "Chinese": "不一定是那样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:51:13",
            "content": "仲良くなる人って、",
            "Chinese": "能成为好朋友的人，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:51:23",
            "content": "似たもの同士だったりする。",
            "Chinese": "往往都是彼此相似的人。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:51:24",
            "content": "陰で悪口言われる人生",
            "Chinese": "在背后被人说坏话的人生。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:51:45",
            "content": "そうだよね、それは辛いよね。",
            "Chinese": "是啊，这一定很痛苦吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:52:08",
            "content": "相手に伝える方法ではなくて、",
            "Chinese": "比起思考和别人沟通的方法，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:52:52",
            "content": "病院に連れて行ってもらうようにご両親に伝えてみるほうが、あなたは少し安心するのかな？",
            "Chinese": "让父母带您去医院看看，这样会不会让您稍微安心一点呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:53:11",
            "content": "どうしたい？",
            "Chinese": "您想怎么做呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:53:21",
            "content": "やっぱ行ったほうがいいですか？",
            "Chinese": "果然还是去医院比较好吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:53:30",
            "content": "わたし病気ですか？",
            "Chinese": "我是生病了吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:53:57",
            "content": "両親は気にするなって言ってるけど",
            "Chinese": "可是父母说不用在意。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:54:34",
            "content": "医師でないと診断はわからないの。ごめんね。あなたが、ひとまずその方が安心するのなら、",
            "Chinese": "不是医生的话是无法做出诊断的。抱歉。如果您觉得那样做能让您暂时安心一些的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:55:03",
            "content": "連れて行ってもらうのも一つの方法だと思うけど、、、。どうかな。",
            "Chinese": "我觉得让父母带您去也是一个方法……您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:56:01",
            "content": "病院に行ったら治りますか？",
            "Chinese": "去了医院就能治好吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:56:09",
            "content": "友達できますか？",
            "Chinese": "能交到朋友吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:56:37",
            "content": "そうだね、友達できるといいね。",
            "Chinese": "是啊，能交到朋友就好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:56:45",
            "content": "例えば、",
            "Chinese": "比如说，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:57:18",
            "content": "同じようなことで、悩んでいる人たちが集まってお話しするところもありますよ。",
            "Chinese": "也有一些地方，是让和您有同样烦恼的人聚在一起交流的。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 21:58:30",
            "content": "みんな消えたがってるんですか？",
            "Chinese": "大家也都想消失吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 21:59:28",
            "content": "そうではなくて、同じ悩みを持っている人たちが色々悩みを話したり、情報を共有したり。自助グループがありますよ。",
            "Chinese": "不是那样的，是有同样烦恼的人们聚在一起，诉说各种烦恼，共享信息。有这样的互助小组哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 22:00:38",
            "content": "調べて行ってみるのも一つだと思うのだけど、、どうかな？",
            "Chinese": "我觉得您可以去了解一下并尝试参加，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 22:00:57",
            "content": "高校生でも大丈夫なんですか？",
            "Chinese": "高中生也可以参加吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/26(日) 22:01:31",
            "content": "大人じゃないですけど参加できますか？",
            "Chinese": "我还不是成年人，可以参加吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/26(日) 22:01:55",
            "content": "そうですね、、調べてみます。",
