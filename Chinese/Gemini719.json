{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 19:51:25",
            "content": "こんばんは。本日はよろしくお願いします。",
            "Chinese": "晚上好。今天请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 19:51:34",
            "content": "宜しくお願い致します",
            "Chinese": "好的，也请您多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 19:52:24",
            "content": "20時スタートでよろしいでしょうか。それとも早めに始めますか？",
            "Chinese": "晚上8点开始可以吗？还是提前开始呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 19:53:09",
            "content": "どちらでも大丈夫です。決めて頂けたらと思います。",
            "Chinese": "都可以，麻烦您来决定。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 19:53:28",
            "content": "では始めてしまいましょうか。",
            "Chinese": "那我们就开始吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 19:53:46",
            "content": "はい、宜しくお願い致します",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 19:54:10",
            "content": "では始めます。",
            "Chinese": "那么，我们开始了。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 19:54:18",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 19:54:44",
            "content": "こんばんは。相談員です。本日はどのようなご相談でしょうか。",
            "Chinese": "晚上好，我是咨询师。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 19:55:27",
            "content": "こんばんは。実は友達関係で悩んでいます。",
            "Chinese": "晚上好。其实我在朋友关系方面有些困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 19:55:41",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 19:56:09",
            "content": "具体的にお話を伺ってもよろしいでしょうか。",
            "Chinese": "可以请您具体说一下吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 19:56:44",
            "content": "専門学校の時の友達四人で年に４回ぐらい会うのですが、",
            "Chinese": "我和专科学校时的三个朋友，一年大概会见四次面，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 19:56:51",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 19:57:25",
            "content": "その話題が家族自慢や近所の悪口や",
            "Chinese": "但聊天的话题总是炫耀家人或者说邻居的坏话，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 19:57:32",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 19:58:46",
            "content": "義両親やきょうだいのことが話題になり内容の無い話が嫌で仕方がありません。",
            "Chinese": "还会聊到公婆和兄弟姐妹的事，这些没有内容的话题让我实在受不了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 19:59:16",
            "content": "そうなのですね。。。",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 19:59:30",
            "content": "もうすぐ会う時期になります。憂鬱で仕方がありません",
            "Chinese": "马上又要到见面的时间了。我感到非常郁闷。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 19:59:58",
            "content": "いやだと思うのに会うのはおつらいですね。。。",
            "Chinese": "明明很讨厌却还要见面，这一定很难受吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:00:09",
            "content": "そうなんです",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:00:55",
            "content": "ご相談者様としては、友達に会いたくないと感じるのですか？",
            "Chinese": "从您的角度来说，您是不想和这些朋友见面吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:01:34",
            "content": "そうでもないのです",
            "Chinese": "也不完全是。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:01:59",
            "content": "子供が小さいときは",
            "Chinese": "孩子还小的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:02:05",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:02:22",
            "content": "家族ぐるみで会ったりしてきましたので、",
            "Chinese": "我们都是拖家带口地见面，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:02:32",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:02:59",
            "content": "手が離れても仲良くしていきたいとは思っています",
            "Chinese": "所以即使现在孩子们都长大了，我还是希望能和她们保持良好的关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:03:14",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:03:28",
            "content": "仲良くはしたいけど、",
            "Chinese": "虽然想和睦相处，但是……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:03:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:03:52",
            "content": "話の内容が嫌だと思うのですね。",
            "Chinese": "但是讨厌聊天的话题，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:04:06",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:04:31",
            "content": "自慢話が多いのです",
            "Chinese": "她们炫耀的话题太多了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:04:31",
            "content": "お友達が嫌いならともかく、仲良くしていきたいのにそれではおつらいですね。",
            "Chinese": "如果讨厌朋友也就算了，但您明明想好好相处，这样真是很难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:04:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:05:15",
            "content": "お友達の自慢話を聞いていて、ご相談者様はどう感じるのですか。",
            "Chinese": "听着朋友们的炫耀，您是什么感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:06:22",
            "content": "うちの子供は大学中退した子もいるし、卑下を感じます",
            "Chinese": "我的孩子里有大学中途退学的，所以我感到自卑。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:06:43",
            "content": "そうなのですね。。。",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:07:50",
            "content": "それでは話を聞いていてつらくなってしまいますよね。",
            "Chinese": "那听着那些话，确实会变得很难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:08:32",
            "content": "はい、せっかく会っても落ち込んで帰らないといけないのです",
            "Chinese": "是的，难得见一次面，结果每次都得垂头丧气地回家。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:08:50",
            "content": "それは悲しいですね。",
            "Chinese": "这真让人难过。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:09:03",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:09:06",
            "content": "お友達は、",
            "Chinese": "您的朋友们，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:09:43",
            "content": "ご相談者様が悲しんでいるというのは気づいてそうですか？",
            "Chinese": "她们有察觉到您因此感到难过吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:10:48",
            "content": "気付いていないと思います。いつも私は聞き役になるので",
            "Chinese": "我觉得她们没注意到。因为我总是当倾听者。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:11:48",
            "content": "おつらいのに、お友達の話を聞いていてえらいですね。",
            "Chinese": "明明自己很难受，却还能倾听朋友们的话，您真的很了不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:12:04",
            "content": "大変だと思います。",
            "Chinese": "我想这一定很辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:12:27",
            "content": "だからこそ会うのがおつらいのですね。。。",
            "Chinese": "正因为如此，见面才会那么辛苦吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:12:52",
            "content": "はい、ありがとうございます。でも",
            "Chinese": "是的，谢谢您。但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:13:00",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:14:12",
            "content": "長い付き合いの友達たちです。つながりは大切にしていきたいと思っています。",
            "Chinese": "她们都是相识多年的朋友。我还是想珍惜这份情谊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:14:39",
            "content": "そのお気持ちは素敵ですね。",
            "Chinese": "您的这份心意非常可贵。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:14:51",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:15:15",
            "content": "少しお話をまとめさせていただいてもよろしいでしょうか。",
            "Chinese": "我可以稍微总结一下您说的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:15:23",
            "content": "お願いします",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:16:29",
            "content": "ご相談者様はお友達と会って話すのがつらい(話の内容的に)と感じていらっしゃる。",
            "Chinese": "您觉得和朋友们见面聊天很辛苦（主要是因为聊天内容）。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:16:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:17:09",
            "content": "でもそのお友達が嫌いなわけではなく、付き合い自体は大切にしていきたいと感じている。",
            "Chinese": "但您并不是讨厌这些朋友，并且希望能够珍惜这份交往。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:17:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:17:27",
            "content": "ということでお間違いないでしょうか。",
            "Chinese": "我的理解对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:18:08",
            "content": "そうです。",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:18:20",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:18:26",
            "content": "では、",
            "Chinese": "那么，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:18:51",
            "content": "どうすればつらくなくなるか一緒に考えていきましょう。",
            "Chinese": "我们一起来想想，怎样才能让您不那么辛苦。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:19:01",
            "content": "宜しくお願いします",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:19:36",
            "content": "いくつか「こうしたらどうですか」と例を挙げてみるので、",
            "Chinese": "我会举几个“您看这样如何？”的例子，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:19:43",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:19:56",
            "content": "率直に思ったことを教えてください。",
            "Chinese": "请坦率地告诉我您的想法。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:20:07",
            "content": "わかりました",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:20:44",
            "content": "まず「ご相談者様が悲しいことがお友達に伝わっていない」とのことでしたが、",
            "Chinese": "首先，您提到“您的朋友们没有察觉到您感到难过”这件事，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:20:52",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:21:41",
            "content": "「そういう話題は悲しくなる」とお友達にお伝えしてみた場合、どういう反応が返ってきそうですか？",
            "Chinese": "如果您试着告诉朋友们“聊这些话题会让我难过”，您觉得她们可能会有什么反应呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:23:37",
            "content": "なぜ？と尋ねられて、自分の子供たちのことを言わないといけなくなり肩身が狭くなると思います。",
            "Chinese": "我想她们会问“为什么？”，那样我就不得不说起自己孩子的事，会觉得很抬不起头。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:23:55",
            "content": "そう思うのですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:24:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:24:25",
            "content": "必ず予想通りになるとは限りませんが、",
            "Chinese": "虽然事情不一定会和您预想的一样，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:24:51",
            "content": "この提案はあまりよくなさそうですね。",
            "Chinese": "看来这个提议似乎不太合适呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:25:27",
            "content": "いえいえ、そういう方法もありますよね",
            "Chinese": "不不，这也是一种方法呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:25:47",
            "content": "そういっていただきありがとうございます。",
            "Chinese": "谢谢您能这么说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:25:56",
            "content": "では次に、",
            "Chinese": "那么接下来，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:26:22",
            "content": "「聞き専になる」とのことでしたが、",
            "Chinese": "您提到自己总是“专职倾听者”，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:26:29",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:27:00",
            "content": "ご相談者様も何か自慢話というか、話題を出してみるというのはどうでしょうか。",
            "Chinese": "您自己也试着提出一些话题，即便是带点炫耀性质的话题，您觉得怎么样呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:27:49",
            "content": "聞くばかりではなく、自分も話してみる。そうした時のお友達の反応はいかがでしょうか？",
            "Chinese": "不只是听，也试着自己说说看。那样的话，朋友们的反应会如何呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:28:46",
            "content": "そうですよね。自分でも何か話題を考えて行くのです。",
            "Chinese": "是啊。我自己也会准备一些话题带过去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:28:54",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:30:21",
            "content": "でもまず自慢のようなことを自分から言うことは控えています。私が話題にするとしたら",
            "Chinese": "但是我通常会克制自己，不说类似炫耀的话。如果由我来提供话题的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:30:30",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:32:18",
            "content": "十分歳をとっていますので、今後どのような生き方をしたいかなどの希望的なことを話題にすることにしています",
            "Chinese": "因为我们都上年纪了，我会选择聊一些积极的话题，比如今后想怎样生活之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:32:39",
            "content": "それは素敵ですね！",
            "Chinese": "这个话题很棒啊！"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:32:50",
            "content": "そのような話はあまり続きません。",
            "Chinese": "但这样的话题通常持续不了多久。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:33:01",
            "content": "そうなのですね。。。",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:33:06",
            "content": "話題が途切れて白けます",
            "Chinese": "话题中断后，场面就冷掉了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:33:23",
            "content": "愚痴のほうが盛り上がる雰囲気なのですね。。。",
            "Chinese": "看来还是抱怨的话题更能炒热气氛呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:33:44",
            "content": "おっしゃっるとおりです",
            "Chinese": "您说得对。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:34:02",
            "content": "教えていただきありがとうございます。",
            "Chinese": "谢谢您告诉我这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:34:37",
            "content": "ではご相談者様は話題を出すが、うまくヒットしないのですね。",
            "Chinese": "就是说，虽然您提出了话题，但并不能很好地引起共鸣，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:35:16",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:35:47",
            "content": "では少し考え方を変えてみましょうか。",
            "Chinese": "那我们稍微换个思路试试看吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:35:58",
            "content": "お願いします",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:36:24",
            "content": "よく「過去と他人は変えられない」と言ったりするのですが、",
            "Chinese": "人们常说“过去和他人是无法改变的”，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:36:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:36:47",
            "content": "相手に何かアプローチするのではなく、",
            "Chinese": "我们不从对方入手，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:37:21",
            "content": "ご相談者様自身が変わってみるという方針で提案をしてみようかと思います。",
            "Chinese": "而是试着从您自身做出改变，我想从这个方向来给您提些建议。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:37:39",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:38:07",
            "content": "そもそもお友達はなぜ「自慢」や「愚痴」をいうのでしょうか。",
            "Chinese": "说到底，您的朋友们为什么要“炫耀”或“抱怨”呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:38:34",
            "content": "このことについてご相談者様はどう感じますか。",
            "Chinese": "关于这一点，您是怎么看的？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:40:37",
            "content": "長い付き合いの友達で、久しぶりに会い、会えなかった時間の出来事を話したいのだと思います",
            "Chinese": "我们是相识多年的朋友了，很久才见一次，我想她们是想聊聊这段没见面的时间里发生的事情吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:40:50",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:41:22",
            "content": "情報共有をしたいと感じているのでしょうかね。",
            "Chinese": "也许是想互相分享一下近况吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:42:24",
            "content": "そうですね。それもあるしみんなの反応を楽しんでいるところもあるかも知れません",
            "Chinese": "是啊。有这方面的原因，可能也有一部分是在享受大家的反应。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:42:49",
            "content": "そう思うのですね。",
            "Chinese": "您是这么认为的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:42:57",
            "content": "ちなみにですが、",
            "Chinese": "顺便问一下，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:43:06",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:44:10",
            "content": "誰にでもいいのですが、ご相談者様が「愚痴」や「自慢」をしたくなる時とはどんな気持ちの時でしょうか。",
            "Chinese": "对谁都可以，当您自己想“抱怨”或“炫耀”的时候，通常是出于一种什么样的心情呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:44:26",
            "content": "ストレスが溜まっているなど、、、",
            "Chinese": "比如压力大的时候之类的……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:44:56",
            "content": "そういった感じのお答えでいいのですが。",
            "Chinese": "像这样的回答就可以了。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:46:14",
            "content": "自慢は基本しません。話題に上ったときに伝える程度です。愚痴は言いたくても",
            "Chinese": "我基本上不炫耀。只会在话题提到的时候顺便说说。至于抱怨，即使想说，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:46:28",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:48:16",
            "content": "言っていないかも知れません。よほど信頼出来る雰囲気を感じたときぐらいしか言えないかも知れないです",
            "Chinese": "我也可能不会说出口。大概只有在感觉到氛围非常值得信赖、让人有安全感的时候，我才能说出来。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:48:32",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:49:09",
            "content": "ご相談者様はとても忍耐強いのですね。",
            "Chinese": "您真是很有忍耐力呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:49:43",
            "content": "ありがとうございます。でもそんなことはないです。",
            "Chinese": "谢谢您。但其实不是那样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:49:53",
            "content": "そうなのですか？",
            "Chinese": "是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:50:35",
            "content": "何かのときに全く別な方法で放出しています。例えば",
            "Chinese": "我会在某些时候用完全不同的方式来释放压力。比如，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:50:43",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:51:41",
            "content": "歩きながら地面に愚痴を言ったり、本を読んで辛さを",
            "Chinese": "一边走路一边对着地面抱怨，或者通过读书把痛苦"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:51:49",
            "content": "励みに変えたり",
            "Chinese": "转化为动力，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:51:58",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:52:15",
            "content": "本から勇気を貰ったり",
            "Chinese": "从书中获得勇气，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:52:39",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:52:40",
            "content": "そんなつまらないことをしています",
            "Chinese": "做的都是些这样不起眼的小事。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:52:59",
            "content": "いえいえ",
            "Chinese": "不不，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:53:10",
            "content": "そんなことないと思いますよ。",
            "Chinese": "我觉得完全不是那样哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:53:32",
            "content": "ご自分なりの発散方法をしっかりお持ちなのですね。",
            "Chinese": "您有自己一套很好的释放方式呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:53:58",
            "content": "はい、そうかも知れません",
            "Chinese": "嗯，也许是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:54:27",
            "content": "もしかしたら、お友達の「自慢話」はご相談者様のそれと同じかもしれませんね。",
            "Chinese": "也许，您朋友的“炫耀”，和您的这些方式在本质上是一样的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:55:24",
            "content": "？",
            "Chinese": "？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:55:42",
            "content": "お友達なりの発散方法が、「自慢」や「愚痴」なのではないでしょうか。",
            "Chinese": "“炫耀”和“抱怨”，会不会就是您朋友们排解情绪的方式呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:56:29",
            "content": "ほんとですね。確かにそうかも知れません。",
            "Chinese": "真的啊。说不定确实是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:56:40",
            "content": "ご相談者様が本に勇気をもらうように、",
            "Chinese": "就像您从书中获得勇气一样，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/15(日) 20:57:29",
            "content": "お友達は「愚痴」の共感で勇気をもらているかもしれませんが、いかがでしょう？",
            "Chinese": "您的朋友们，或许也是通过“抱怨”得到共鸣来获得勇气的，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/15(日) 20:59:15",
            "content": "はい、そう思います。そう思うと友達の話の聞き役も大事な役目だと思えてきました。",
            "Chinese": "是的，我这么认为。这么一想，我觉得当朋友的倾听者也是一个很重要的角色。"
