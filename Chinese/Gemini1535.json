{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:21:39",
            "content": "（こんにちは。どうぞよろしくお願いいたします。）",
            "Chinese": "（您好。请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:24:38",
            "content": "こんにちは。本日はよろしくお願いいたします。",
            "Chinese": "您好。今天就拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:25:12",
            "content": "（お返事ありがとうございます。どうぞよろしくお願いいたします。）",
            "Chinese": "（感谢您的回复。请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:26:29",
            "content": "（スタートは１１：３０でよろしいでしょうか？）",
            "Chinese": "（我们11:30开始可以吗？）"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:28:03",
            "content": "はい。11時30分でお願いいたします。",
            "Chinese": "好的。麻烦您11点30分开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:28:14",
            "content": "（了解いたしました）",
            "Chinese": "（明白了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:30:09",
            "content": "（それでは始めます。よろしくお願いいたします。）",
            "Chinese": "（那么我们开始了。请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:30:21",
            "content": "よろしくお願いいたします",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:30:47",
            "content": "こんにちは。相談員です。今日は相談にお越しいただきありがとうございます。",
            "Chinese": "您好。我是咨询师。感谢您今天前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:31:06",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:31:17",
            "content": "こんにちは。よろしければ、最初に年齢と性別を教えていただけますでしょうか。",
            "Chinese": "您好。方便的话，可以先告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:31:34",
            "content": "21歳男です",
            "Chinese": "21岁，男性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:32:02",
            "content": "ありがとうございます。そして、どのようにお呼びすればよろしいでしょうか？",
            "Chinese": "感谢您。请问该怎么称呼您？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:32:48",
            "content": "吉村とお呼びください",
            "Chinese": "请叫我吉村。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:33:06",
            "content": "吉村さん、お返事ありがとうございます。",
            "Chinese": "吉村先生，感谢您的回复。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:33:10",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:33:20",
            "content": "今日はどのようなご相談でしょうか",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:34:19",
            "content": "後回しにする癖を改善したいです",
            "Chinese": "我想改掉拖延的毛病。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:34:30",
            "content": "今大学生ですが",
            "Chinese": "我现在是大学生，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:34:36",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:35:14",
            "content": "課題も提出日の前日にならないと焦らなくて、全然手をつけていない",
            "Chinese": "作业也总是要拖到截止日期的前一天才开始着急，之前完全没有着手。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:35:24",
            "content": "ことが多いです",
            "Chinese": "这种情况很多。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:35:48",
            "content": "なるほど、私も身に覚えがありますが、焦りますね。",
            "Chinese": "原来如此，我也有同感，确实会感到焦虑呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:35:49",
            "content": "甘えと言われればその通りですが",
            "Chinese": "如果说这是在放纵自己，那确实如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:35:57",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:36:10",
            "content": "社会に出てから絶対苦労するだろうなと思います",
            "Chinese": "我觉得进入社会后肯定会很辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:36:47",
            "content": "はい、これからが大変だろうとご心配なのですね。",
            "Chinese": "是的，您是担心今后会很辛苦，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:37:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:37:48",
            "content": "どのような課題に対してもそうでしょうか？",
            "Chinese": "是对所有作业都这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:38:09",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:39:31",
            "content": "そうなのですね。前日になるまで、どのようにお過ごしか教えていただけますか？",
            "Chinese": "是这样啊。能告诉我到前一天为止，您都是怎么度过的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:40:28",
            "content": "アルバイトを週5とかで入れてます",
            "Chinese": "我一周做五天左右的兼职。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:40:53",
            "content": "アルバイトを週5！大学に通われながらそれは大変です！！！",
            "Chinese": "一周兼职五天！一边上大学一边打工，真是太辛苦了！！！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:41:41",
            "content": "課題をする時間を工面するのが大変そうですね。",
            "Chinese": "看来要挤出时间来做作业很不容易呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:41:51",
            "content": "一人暮らしなので、遊ぶよりはアルバイトで貯金することが多いです",
            "Chinese": "因为我一个人住，所以比起玩乐，更多时候会选择打工存钱。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:42:18",
            "content": "アルバイトで貯金、素晴らしいです。",
            "Chinese": "通过打工来存钱，非常了不起。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:42:32",
            "content": "でも時間を言い訳にすると",
            "Chinese": "但要是把时间当成借口的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:42:39",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:42:47",
            "content": "社会人になってから余計苦労しそうです",
            "Chinese": "感觉工作以后会更辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:43:24",
            "content": "おっしゃる通り、社会人もお忙しい方多いですもんね。",
            "Chinese": "您说得对，毕竟很多上班族也很忙。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:43:55",
            "content": "そう思います",
            "Chinese": "我也这么觉得。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:44:15",
            "content": "それに比べて自分はまだまだ子供だと",
            "Chinese": "相比之下，我觉得自己还很幼稚，"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:44:21",
            "content": "痛感します",
            "Chinese": "深有体会。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:45:12",
            "content": "そう思われるのですね、私は大学に通いながら週5でアルバイトも十分素晴らしいと思いますが…",
            "Chinese": "您是这么想的啊，不过我觉得一边上大学一边每周做5天兼职已经非常了不起……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:45:36",
            "content": "アルバイトでもお仕事なので、半分は社会人なのかと…",
            "Chinese": "兼职也是工作，从某种意义上说已经算是半个社会人了……"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:45:51",
            "content": "そうですかね？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:46:17",
            "content": "はい、そう思います。21歳でそれだけをこなされるの、凄いと思います。",
            "Chinese": "是的，我是这么认为的。21岁就能做到这些，我觉得很了不起。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:46:56",
            "content": "もっとできる",
            "Chinese": "我还能做得更多，"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:47:05",
            "content": "と思える自分でいたいです",
            "Chinese": "我希望自己能相信可以做得更多。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:47:50",
            "content": "そっか、確かにもっとできると希望を持ちたいですよね＞",
            "Chinese": "这样啊，确实，希望自己能做到更多，这种心情是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:48:04",
            "content": "はい！",
            "Chinese": "是的！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:48:18",
            "content": "本当に素晴らしいと思います。",
            "Chinese": "我真的觉得您非常了不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:48:35",
            "content": "自分の自由な時間少なそうですよね。",
            "Chinese": "您的自由时间似乎很少呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:48:39",
            "content": "いえ恐縮です",
            "Chinese": "哪里，您过奖了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:49:30",
            "content": "バイトが入っている1日って、どんなスケジュールで動かれているのですか？",
            "Chinese": "有兼职的日子，您一天的日程是怎么安排的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:50:24",
            "content": "働くのは1日4〜6時間です",
            "Chinese": "我一天工作4到6个小时。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:51:00",
            "content": "はい、結構長いですよね。授業の後にですか？",
            "Chinese": "好的，时间挺长的呢。是下课之后去吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:51:31",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:51:50",
            "content": "それは、大変！私ならクタクタになりそうです。",
            "Chinese": "那可真辛苦！要是我肯定会累趴下的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:52:34",
            "content": "授業もバイトも無い日ってあるのですか？",
            "Chinese": "有既没课也没有兼职的日子吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:53:20",
            "content": "両方ない日は週1か2週間に1回あります",
            "Chinese": "两样都没有的日子，一周或两周有一次。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:53:40",
            "content": "ただ時間の使い方が下手で",
            "Chinese": "只是我不太会利用时间。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:53:46",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:53:50",
            "content": "無駄にしてることが多いです",
            "Chinese": "经常把时间浪费掉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:54:25",
            "content": "そうなのですね、どんな過ごし方をされているか教えていただいてもいいですか？",
            "Chinese": "是这样啊，能跟我说说您通常是怎么度过的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:55:46",
            "content": "ネットでドラマ、サッカー、野球、",
            "Chinese": "在网上看电视剧、足球、棒球，"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:55:51",
            "content": "筋トレ",
            "Chinese": "健身，"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:56:06",
            "content": "時間が余って少し勉強",
            "Chinese": "时间有富余了就稍微学习一下。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:56:12",
            "content": "という感じです",
            "Chinese": "大概就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:56:13",
            "content": "おー、色々やられてますね！",
            "Chinese": "哇，做的事情挺多的啊！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:56:40",
            "content": "教えていただき、ありがとうございます。",
            "Chinese": "感谢您的分享。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:56:41",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:57:06",
            "content": "私はあまり無駄な時間に思えないのですが、どうでしょう？",
            "Chinese": "我不太觉得这是在浪费时间，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:57:44",
            "content": "かなり楽しんでると思います",
            "Chinese": "我觉得自己挺享受的。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:57:54",
            "content": "ただ優先順位",
            "Chinese": "只是优先顺序……"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:58:05",
            "content": "が間違えてると思います",
            "Chinese": "我觉得是搞错了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:58:15",
            "content": "そっか、それですね！優先順位…",
            "Chinese": "原来如此，问题就在优先顺序啊！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:58:28",
            "content": "どのようにできたらいいと思いますか？",
            "Chinese": "您觉得怎样安排会更好呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 11:59:15",
            "content": "そうですね…",
            "Chinese": "这个嘛……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 11:59:20",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 12:00:09",
            "content": "平日はあまり時間が取れないと思うので",
            "Chinese": "我觉得工作日很难抽出时间，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 12:00:15",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 12:00:35",
            "content": "休日に頑張るしかないかなと、",
            "Chinese": "所以可能只能在周末努力了，"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 12:01:02",
            "content": "無計画だったので、",
            "Chinese": "因为之前一直没有计划，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 12:01:16",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 12:01:34",
            "content": "30分なら30分、向き合うことが必要だったかもしれないです",
            "Chinese": "也许当时需要哪怕只有30分钟也好，静下心来面对它。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 12:02:03",
            "content": "なるほど、時間を前もって決めておくのは良いかもしれないですね！",
            "Chinese": "原来如此，提前规划好时间也许是个好办法呢！"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 12:02:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/28(日) 12:02:52",
            "content": "ということは、課題の前日はかなり睡眠時間を削って課題をやられてたということですか？",
            "Chinese": "也就是说，在截止日前一天您会大幅压缩睡眠时间来做作业，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/28(日) 12:03:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
