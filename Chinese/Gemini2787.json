{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 09:52:15",
            "content": "相談者役をさせて頂きます。よろしくお願いいたします。",
            "Chinese": "我来扮演来访者。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 09:53:12",
            "content": "10時からよろしくお願いします",
            "Chinese": "我们从10点开始，麻烦您了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 09:53:29",
            "content": "ありがとうございます。よろしくお願いいたします。",
            "Chinese": "谢谢您。请多多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:00:10",
            "content": "それでは始めます",
            "Chinese": "那么，我们开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:00:17",
            "content": "よろしくお願いします",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:00:34",
            "content": "こんにちは、相談員です",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:00:45",
            "content": "よろしくお願いします",
            "Chinese": "您好，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:01:09",
            "content": "はじめにあなたの年齢と性別を教えていただけますか？",
            "Chinese": "首先，能请您告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:01:31",
            "content": "15歳　女性",
            "Chinese": "15岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:01:44",
            "content": "教えてくださりありがとうございます",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:01:51",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:02:13",
            "content": "15歳といいますと中学3年生でしょうか？",
            "Chinese": "15岁的话，应该是初三吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:02:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:02:43",
            "content": "そうなんですね今日はどのようなご相談ですか？",
            "Chinese": "这样啊。今天您想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:02:57",
            "content": "親がわかってくれない",
            "Chinese": "父母不理解我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:03:09",
            "content": "それは悲しいですね",
            "Chinese": "那确实让人难过呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:03:16",
            "content": "はい、、",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:03:34",
            "content": "どんなことを一番解ってほしいですか？",
            "Chinese": "您最希望他们理解您哪方面的事呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:03:58",
            "content": "全部",
            "Chinese": "全部。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:04:09",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:04:32",
            "content": "わかってもらえないことばかりなんですね",
            "Chinese": "感觉好像什么事都得不到理解，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:05:10",
            "content": "何から話していいかわからない",
            "Chinese": "不知道该从哪里说起。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:06:01",
            "content": "うーんそれは辛いね",
            "Chinese": "嗯，那确实很不容易呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:06:55",
            "content": "親からもっと勉強しろとばかり言われて",
            "Chinese": "父母总是只会对我说“要多用功”。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:07:18",
            "content": "一方的に",
            "Chinese": "单方面地。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:07:28",
            "content": "嫌になりました",
            "Chinese": "我已经厌烦了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:08:08",
            "content": "そうかー勉強しろとばかり言われていたら嫌になるのももっともだと思います",
            "Chinese": "是啊，如果总是被催着学习，会感到厌烦也是理所当然的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:08:23",
            "content": "わかってもらえないと感じているのはお母さんですか？それともお父さんですか？",
            "Chinese": "您感觉不理解您的是妈妈，还是爸爸呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:08:58",
            "content": "どちらかというとお母さんかなお父さんもだけど",
            "Chinese": "要说的话，妈妈可能多一点，不过爸爸也是。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:09:10",
            "content": "そうなんだ",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:09:16",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:09:46",
            "content": "お母さんの方が勉強しろって言ってくるんですね",
            "Chinese": "看来主要是妈妈在催您学习，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:09:59",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:10:45",
            "content": "そう言われたときは、どんな風に感じますか？",
            "Chinese": "被那样说的时候，您心里是怎样的感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:11:22",
            "content": "いやだけど、自分の成績が伸びないから",
            "Chinese": "虽然很讨厌，但也是因为我自己的成绩没有提高。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:11:37",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:11:58",
            "content": "でも一方的に言われるのは腹立つ",
            "Chinese": "但被单方面地说教还是很让人生气。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:12:53",
            "content": "自分の成績が伸びないから仕方ないと思いつつも一方的に言われるのは嫌なんですね",
            "Chinese": "您一方面觉得因为自己成绩没提高所以没办法，另一方面又很讨厌被单方面地说教，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:13:00",
            "content": "はい、、",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:13:32",
            "content": "動画作りばかりしてるから",
            "Chinese": "因为我老是在做视频。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:13:35",
            "content": "私が",
            "Chinese": "是我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:13:44",
            "content": "そうなんですね",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:14:06",
            "content": "動画作り禁止と言われて",
            "Chinese": "他们说不准我做视频。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:14:19",
            "content": "ムカつく",
            "Chinese": "真让人火大。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:14:37",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:14:45",
            "content": "はい、、",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:15:11",
            "content": "一方的に禁止されたら腹が立ってしまいますよね",
            "Chinese": "被单方面地禁止，确实会让人气愤呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:15:27",
            "content": "腹立ちます",
            "Chinese": "是的，很生气。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:16:07",
            "content": "そうかーあなたとしては、どうなったらいいと思いますか？",
            "Chinese": "这样啊。对您来说，您觉得怎样才算比较好呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:16:30",
            "content": "どうなったら？よくわからない",
            "Chinese": "怎么样才好？我也不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:16:57",
            "content": "そうでしたか",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:17:21",
            "content": "受験生だし",
            "Chinese": "毕竟是考生。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:18:02",
            "content": "勉強しないといけないけど",
            "Chinese": "虽然必须学习，但——"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:18:19",
            "content": "動画作りはしたい",
            "Chinese": "但我也想做视频。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:18:21",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:19:01",
            "content": "勉強しなければいけないことは解っているけど、動画も作りたいんですよね",
            "Chinese": "您明白必须学习，但也想继续做视频，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:19:25",
            "content": "私、今通院していて",
            "Chinese": "我现在在医院就诊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:19:35",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:20:03",
            "content": "お医者さんから無理しないように言われているから",
            "Chinese": "因为医生让我不要勉强自己。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:20:19",
            "content": "そうでしたか",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:20:58",
            "content": "もしよろしければ、どんなことで通院されているのか、教えていただけますでしょうか？",
            "Chinese": "如果可以的话，能和我说说您是因为什么原因在就诊吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:21:20",
            "content": "気分の上がり下がりが激しくて",
            "Chinese": "因为情绪起伏很大。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:21:27",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:21:32",
            "content": "親が心配して",
            "Chinese": "父母很担心。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:21:45",
            "content": "そうでしたか",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:22:17",
            "content": "病院に行ったら、双極性障害2型と言われました",
            "Chinese": "去医院后，被诊断为双相情感障碍Ⅱ型。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:22:56",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:23:03",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:24:20",
            "content": "今は薬飲んだり、定期的に通院しています",
            "Chinese": "现在在吃药，并定期去复诊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:24:36",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:25:32",
            "content": "無理しないように気を付ける必要があるのですね",
            "Chinese": "那就需要注意不要勉强自己呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:26:06",
            "content": "お医者さんからはストレスのかかる事は気をつけてねと",
            "Chinese": "医生也提醒我，要注意避免有压力的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:26:20",
            "content": "なるほどですね",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:27:54",
            "content": "あなたにとってはどんなことが一番ストレスに感じますか？",
            "Chinese": "对您来说，什么事情让您感到压力最大呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:28:43",
            "content": "自分のやりたい事ができない事",
            "Chinese": "做不了自己想做的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:28:57",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:29:13",
            "content": "そのことをお母さんにも解って欲しいですよね",
            "Chinese": "您也希望妈妈能理解这一点，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:29:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:31:33",
            "content": "もしかすると、お母さんはあなたが勉強と動画作りの両方をやることがストレスになると勘違いしているのかもしれないと思ったのですが、いかがですか？",
            "Chinese": "我在想，会不会是妈妈误会了，以为您同时兼顾学习和做视频会给您带来压力呢？您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:32:33",
            "content": "そうじゃなくて、動画作りばかりしていて、勉強しないからだと思います",
            "Chinese": "不是那样的，我觉得是因为我光顾着做视频不学习。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:32:50",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:33:14",
            "content": "勉強の方はあまりやられていないのでしょうか？",
            "Chinese": "那学习方面，您现在是不是做得不太多呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:33:27",
            "content": "身が入らない",
            "Chinese": "无法集中精神。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:33:42",
            "content": "基礎がわかっていないから",
            "Chinese": "因为基础没打好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:34:05",
            "content": "うーんそうなんだ",
            "Chinese": "嗯，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:34:26",
            "content": "はい、、",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:34:41",
            "content": "それは困りますよね",
            "Chinese": "那确实很伤脑筋呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:35:22",
            "content": "やっぱり私が悪いんですね",
            "Chinese": "果然还是我的错吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:36:17",
            "content": "うーん基礎がわからないとやる気が起きないのも解りますよ",
            "Chinese": "嗯，基础没掌握好而提不起干劲，这点我能理解。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:36:53",
            "content": "だから基礎がわからない私がいけないんですよね",
            "Chinese": "所以，不懂基础的我是不好的，对吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:37:19",
            "content": "そう感じているのですね",
            "Chinese": "您是这样感觉的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/30(火) 10:37:53",
            "content": "だってカウンセラーさんが困りますよねって、、",
            "Chinese": "因为您刚才说了“那确实很伤脑筋”……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:38:36",
            "content": "そうかごめんなさいね",
            "Chinese": "啊，是这样啊，对不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/30(火) 10:38:43",
