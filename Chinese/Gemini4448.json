{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 09:51:16",
            "content": "（おはようございます。今日はよろしくお願いします。）",
            "Chinese": "（早上好。今天请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 09:51:49",
            "content": "(おはようございますよろしくお願い致します)",
            "Chinese": "（早上好，请多多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 09:52:12",
            "content": "（時間前ですが、定時からスタートしますか？）",
            "Chinese": "（虽然还没到时间，我们从预定时间开始吗？）"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 09:53:23",
            "content": "(時間前からスタートしてもいいんですか？)",
            "Chinese": "（可以提前开始吗？）"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 09:54:15",
            "content": "(まだ、ラインコ3回目で　よくわからなくて　申し訳ありません)",
            "Chinese": "（这是我第三次进行线上咨询，还不太清楚流程，非常抱歉。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 09:54:46",
            "content": "（合意があれば、いつもスタートから１時間でお願いしていますが。）",
            "Chinese": "（如果双方同意，我们通常是从开始计时，进行一小时的咨询。）"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 09:55:36",
            "content": "(そうなんですね、定時からお願いしてもいいんですか？)",
            "Chinese": "（是这样啊，那可以从预定时间开始吗？）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 09:55:50",
            "content": "（承知しました。）",
            "Chinese": "（好的，明白了。）"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 09:56:05",
            "content": "(ありがとうございますよろしくお願い致します)",
            "Chinese": "（谢谢您，那就拜托了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:00:04",
            "content": "おはようございます。相談員です。まず初めによろしかったら年齢、性別、相談内容についてお聞かせ下さい。",
            "Chinese": "早上好，我是咨询师。首先，如果您方便的话，能请您告诉我您的年龄、性别和想咨询的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:00:14",
            "content": "31歳　主婦生きてるだけで苦しいんです。どうしたら楽になりますか？",
            "Chinese": "31岁，家庭主妇。我光是活着就觉得很痛苦。要怎么做才能轻松一点呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:01:26",
            "content": "そうなんですね。お辛いんですね。",
            "Chinese": "是这样啊。您一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:01:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:03:43",
            "content": "相談に来ていただきありがとうございます。よかったらそう思わる気持ちをもう少し聞かせてもらえますか。",
            "Chinese": "感谢您前来咨询。如果您愿意的话，能否再详细说说您的这种感受？"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:03:59",
            "content": "常に死にたい気持ちで、、ご飯を食べてても、、TVを見てても、、、いつも死にたいけど死ねない",
            "Chinese": "我总是有想死的念頭……吃饭的时候是这样……看电视的时候也是……一直想死，却又死不了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:05:39",
            "content": "そうなんですね。それはいたたまれないですよね。どのようなことがおありだったか、お話しすることは出来ますか？",
            "Chinese": "是这样啊。那确实让人难以承受。您能说说都发生了些什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:05:59",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:07:08",
            "content": "何かあったというか、、、眠れないし子供のことも悩みですし睡眠薬を飲んでも眠れないし　昔から生きていたくはなかったんです",
            "Chinese": "与其说是发生了什么……我睡不着，也为孩子的事烦恼，吃了安眠药也还是睡不着，而且从很久以前开始，我就不想活了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:08:57",
            "content": "すごく苦しくなるよなうことがおありだったのですね。一緒に考えられたらと思いますが、いかがでしょうか。",
            "Chinese": "您一定是经历了一些让您非常痛苦的事情吧。如果可以的话，我希望能和您一起想想办法，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:09:16",
            "content": "はいありがとうございます",
            "Chinese": "好的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:10:11",
            "content": "どういったことでそのような気持ちになられたのか聴かせてもらえますか？",
            "Chinese": "能和我说说，是什么事情让您产生了这样的感受吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:10:37",
            "content": "色々あります",
            "Chinese": "有很多事。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:10:43",
            "content": "例えば",
            "Chinese": "比如说……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:10:50",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:11:17",
            "content": "子供のことで悩んでも、主人は向き合ってくれません",
            "Chinese": "我为孩子的事情烦恼，但我丈夫却不肯正视这个问题。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:12:00",
            "content": "喧嘩をしても、ちゃんと話ができなくて改善もしない",
            "Chinese": "即使吵架，也没法好好沟通，问题也得不到改善。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:12:12",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:12:24",
            "content": "私だって大変なのに",
            "Chinese": "我也很辛苦啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:12:38",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:12:54",
            "content": "薬を飲んでも眠れないからだるくて",
            "Chinese": "吃了药也睡不着，所以浑身乏力。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:13:05",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:13:06",
            "content": "家事もつらい",
            "Chinese": "做家务也很辛苦。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:13:16",
            "content": "ご飯を作るのもしんどい",
            "Chinese": "做饭也很吃力。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:13:24",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:13:36",
            "content": "でも、子供を育てるのが本当にしんどいんです",
            "Chinese": "但是，养育孩子真的非常吃力。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:13:51",
            "content": "もう　疲れて",
            "Chinese": "我已经……太累了。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:13:56",
            "content": "苦しいんです",
            "Chinese": "很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:13:59",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:14:08",
            "content": "わかってもらえますか？",
            "Chinese": "您能理解吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:15:44",
            "content": "お話ししていただきありがとうございます。そのような状況でいらしたら、そう思わるのは無理もないですよね。",
            "Chinese": "感谢您告诉我这些。在这样的情况下，您有这样的想法是完全可以理解的。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:16:05",
            "content": "そうなんです",
            "Chinese": "是的，就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:16:47",
            "content": "貴方は、パートナーの方を真剣に向き合おうとされていらっしゃるのに、そういう状況ではやりきれないですよね。",
            "Chinese": "您明明想和您的伴侣认真地去面对和沟通，但在这种情况下，确实会让人觉得撑不下去吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:17:14",
            "content": "パートナーの方と　でした。",
            "Chinese": "我是说，和您的伴侣。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:17:23",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:17:30",
            "content": "大丈夫です",
            "Chinese": "没关系。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:17:35",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:18:00",
            "content": "どうしたら　全部楽になりますか？",
            "Chinese": "我要怎么做，才能让一切都变得轻松一些呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:19:41",
            "content": "楽になられたいと思われるくらい、つらく追い詰められたお気持ちなんですね。",
            "Chinese": "您已经痛苦到、被逼到想要寻求解脱的地步了呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:19:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:20:55",
            "content": "眠れていないとお聞きしましたが、食事はちゃんと摂られていらっしゃいますか？",
            "Chinese": "我听您说睡不着，那有好好吃饭吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:21:35",
            "content": "私はほとんど食べられてはいません食べるのが苦痛で",
            "Chinese": "我基本上吃不下什么，因为吃饭对我来说很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:21:47",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:22:24",
            "content": "そうなんですね。それほどお辛い状況でいらっしゃるのですね。",
            "Chinese": "是这样啊。您现在的情况已经到了如此痛苦的地步了。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:22:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:23:11",
            "content": "ご飯作っても　上の子はご飯をあまり食べてくれなくて",
            "Chinese": "就算我做了饭，大儿子也不怎么吃。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:23:18",
            "content": "それも悩みで",
            "Chinese": "这也是我的一个烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:23:23",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:23:46",
            "content": "大きくならないんじゃないかと　心配で",
            "Chinese": "我很担心他会不会长不大。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:24:06",
            "content": "つらいんです",
            "Chinese": "很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:25:00",
            "content": "そうなんですね。それは心配になられますよね。貴方はお子さんのことを思って、一生懸命食事を作られたいらっしゃるのですね。",
            "Chinese": "是这样啊。那确实会让人担心呢。您是真心为孩子着想，才那么努力地做饭的吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:25:27",
            "content": "お子さんは、何人いらしゃるのですか？",
            "Chinese": "您有几个孩子呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:25:43",
            "content": "2人です",
            "Chinese": "两个。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:26:16",
            "content": "教えていただきありがとうございます。お二人はおいくつでいらしゃるのですか？",
            "Chinese": "谢谢您告诉我。两个孩子分别多大了呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:26:45",
            "content": "1歳と4歳の息子です",
            "Chinese": "是1岁和4岁的两个儿子。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:27:21",
            "content": "私はちゃんと育てられるんでしょうか？",
            "Chinese": "我真的能好好把他们养大吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:28:39",
            "content": "そうだったのですね、一番手に掛かる時期でいらっしゃるのですね。そんな中でも貴方は、ちゃんとお食事とか作られて頑張っていらっしゃると思いますが、いかがですか？",
            "Chinese": "原来是这样，正是在最需要人照顾的年纪呢。即便如此，您还是努力地为他们做饭，我觉得您已经做得很好了，您自己觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:29:55",
            "content": "ちゃんとやらなきゃって思うんですけど、、、でも、できてない気がします",
            "Chinese": "我总想着必须要把每件事都做好……但总感觉自己并没有做到。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:31:02",
            "content": "そう思われていらっしゃるのですね。どんなところが出来ていないと思われますか？",
            "Chinese": "您是这么想的啊。您觉得是哪些方面没有做好呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:31:20",
            "content": "全てです",
            "Chinese": "所有方面。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:31:47",
            "content": "お料理も上手に作れない",
            "Chinese": "饭菜也做不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:31:58",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:32:00",
            "content": "家事も身体がだるくて",
            "Chinese": "身体很乏力，家务也做不好。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:32:06",
            "content": "ちゃんとできてない",
            "Chinese": "都没能好好完成。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:32:09",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:32:23",
            "content": "とにかく、いつもつらくて死にたい",
            "Chinese": "总之，我一直都很痛苦，很想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:34:05",
            "content": "とても苦しいと思われていらっしゃる状況なんですね。それは、お辛いですよね。",
            "Chinese": "您现在正处于一个感觉非常痛苦的状况中呢。那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:34:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:34:53",
            "content": "ご家族は、パートナーの方と、お子さんと4人家族でいらっしゃるのですか？",
            "Chinese": "您家是和伴侣、还有两个孩子，一共四口人吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:35:02",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:36:29",
            "content": "それでは、貴方の言われているように、パートナーの方にも子育て協力してもらいたいと思われるのは、もっともなことだと思います。",
            "Chinese": "那么，就像您说的那样，希望伴侣也能在育儿方面多加协助，这是非常理所当然的想法。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:37:00",
            "content": "はいでも、向き合ってはもらえません",
            "Chinese": "是的，但是他不肯正视这个问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/01/16(月) 10:38:23",
            "content": "そうなんですね。それはやりきれないですよね。周りにどなたか相談にのっていただける方は、いらっしゃいますか？",
            "Chinese": "是这样啊。那确实让人感到无力。您身边有可以商量或倾诉的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:38:44",
            "content": "いません",
            "Chinese": "没有。"
        },
        {
            "role": "クライアント",
            "time": "2023/01/16(月) 10:38:53",
            "content": "いったと",
            "Chinese": "就算说了……"
        },
        {
