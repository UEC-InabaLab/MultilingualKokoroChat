        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:41:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:42:36",
            "content": "例えばですが友達としてめちゃ好きというのもありだとおもいます",
