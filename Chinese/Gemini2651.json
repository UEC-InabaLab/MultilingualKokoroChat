            "role": "クライアント",
            "time": "2021/11/04(木) 15:42:48",
            "content": "言ってます",
            "Chinese": "我有这么说过。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:43:01",
            "content": "ふざけてキスしたり",
            "Chinese": "也开玩笑似的亲过吻。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:43:06",
            "content": "もういってたんですね",
            "Chinese": "原来你已经这么做了啊。"
        },
