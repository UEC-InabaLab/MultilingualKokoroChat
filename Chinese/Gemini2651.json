        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:50:32",
            "content": "少しでも悩んだらいつでも相談してほしいです",
            "Chinese": "只要有一点困惑，随时都可以来咨询我。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:50:41",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:51:12",
            "content": "ありがとうございました",
            "Chinese": "非常感谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:51:19",
            "content": "少しでも気持ちがましになると嬉しいです",
            "Chinese": "如果能让你的心情好受一点，我会很高兴。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:51:24",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:51:32",
            "content": "こちらこそありがとうございました。",
            "Chinese": "我也要谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:51:45",
            "content": "またよろしくお願いいたします。",
            "Chinese": "期待下次再见。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:51:48",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
