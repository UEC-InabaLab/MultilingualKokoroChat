{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 14:55:10",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 14:55:29",
            "content": "こんにちは＾＾宜しくお願いいたします",
            "Chinese": "您好＾＾请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 14:55:35",
            "content": "お待たせいたしました。",
            "Chinese": "让您久等了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 14:55:49",
            "content": "本日よろしくお願いいたします。",
            "Chinese": "今天请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 14:56:10",
            "content": "もう初めていただいて大丈夫です。",
            "Chinese": "现在可以开始了，没关系。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 14:56:20",
            "content": "よろしければ、ですが＾＾",
            "Chinese": "如果可以的话＾＾"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 14:56:32",
            "content": "はじめに年齢性別今日の相談したいことよろしくお願いいたします。",
            "Chinese": "首先请您告知您的年龄、性别，以及今天想咨询的内容。谢谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 14:56:41",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 14:57:02",
            "content": "14、男です。",
            "Chinese": "14岁，男。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 14:57:17",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 14:57:52",
            "content": "最近、好きになった人がいるんですが",
            "Chinese": "最近我喜欢上了一个人。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 14:58:04",
            "content": "男なんです",
            "Chinese": "他是男生。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 14:58:13",
            "content": "恋の相談ですね",
            "Chinese": "是关于恋爱的咨询呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 14:58:18",
            "content": "そいつに告ろうかと",
            "Chinese": "我在想要不要向他表白。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 14:58:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 14:58:52",
            "content": "男の子同士なんですね",
            "Chinese": "原来是男生之间的感情呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 14:58:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 14:59:36",
            "content": "そのことは同じクラスですか",
            "Chinese": "那个人是同班同学吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 14:59:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:00:30",
            "content": "クラスでなかよしのお友達ですか？",
            "Chinese": "在班里是关系很好的朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:00:48",
            "content": "はい、同じグループです",
            "Chinese": "是的，在同一个小团体。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:01:19",
            "content": "よく一緒に遊ぶんですか？",
            "Chinese": "你们经常在一起玩吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:01:42",
            "content": "同じグループなんで、いつも一緒にいる感じです",
            "Chinese": "因为在同一个小团体，所以感觉总是在一起。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:02:03",
            "content": "どんなことして遊ぶことが多いでしょうか？",
            "Chinese": "你们通常会一起做些什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:02:31",
            "content": "いつも一緒なんですね",
            "Chinese": "看来你们总是一起呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:02:50",
            "content": "ただ話したりするかんじで、前はカラオケ行ったり",
            "Chinese": "一般就是聊聊天，以前也去过卡拉OK。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:03:42",
            "content": "楽しそうですね。よくカラオケ行くんですか？",
            "Chinese": "听起来很开心呢。你们经常去唱K吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:03:53",
            "content": "よくではないです",
            "Chinese": "也称不上经常。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:03:55",
            "content": "たまに",
            "Chinese": "偶尔。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:04:13",
            "content": "最近はコロナだからあまりしない",
            "Chinese": "最近因为疫情，就很少去了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:04:38",
            "content": "普段はただ話すだけが多いんでしょうか？",
            "Chinese": "平时主要就是聊天比较多吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:05:20",
            "content": "だいたい遊ぶのは話してます",
            "Chinese": "大部分时候一起玩就是聊天。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:05:37",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:05:57",
            "content": "彼女同士も仲が良いんで最近は遠出したりもしました",
            "Chinese": "我们各自的女朋友之间关系也很好，最近还一起去远一点的地方玩了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:06:20",
            "content": "今回は友達に告白の相談でよかったですか？",
            "Chinese": "这次是想咨询向朋友表白的事，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:06:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:06:47",
            "content": "彼女同士？というと",
            "Chinese": "“女朋友之间”？您的意思是……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:07:10",
            "content": "彼女同士です。相手にも、俺にも彼女がいます",
            "Chinese": "是的，对方有女朋友，我也有女朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:07:27",
            "content": "そうだったんですね",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:07:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:08:32",
            "content": "お互い彼女もいるけど告白してお付き合いしたいということですか？",
            "Chinese": "虽然你们各自都有女朋友，但你还是想表白并和他交往，是这个意思吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:08:53",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:09:13",
            "content": "友達のままではなｊく",
            "Chinese": "不想只做朋友，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:09:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:10:12",
            "content": "もしお付き合い出来たら彼女さんとはどうするか考えてますか？",
            "Chinese": "如果真的开始交往，你有想过要如何处理你和女朋友的关系吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:10:28",
            "content": "別れます",
            "Chinese": "我会分手。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:10:38",
            "content": "そうなんですね",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:11:10",
            "content": "周りの友達に相談されましたか",
            "Chinese": "有向周围的朋友咨询过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:11:24",
            "content": "いえ、誰にも言ってません",
            "Chinese": "没有，谁也没说。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:12:00",
            "content": "なかなか相談できないですよね",
            "Chinese": "这种事确实很难跟人商量呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:12:41",
            "content": "ネットでは告ると死ぬ結果になるとか書いてあって",
            "Chinese": "网上说告白了的话结果会很惨。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:12:52",
            "content": "告白するならどんな感じでしようとか",
            "Chinese": "如果要表白，你有想过要以什么样的方式进行吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:13:03",
            "content": "かんがえてますか",
            "Chinese": "有在考虑吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:13:33",
            "content": "わからない、まだそこまでは",
            "Chinese": "不知道，还没想到那一步。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:13:49",
            "content": "ネット検索すると悩みますよね",
            "Chinese": "在网上一查确实会更纠结呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:13:59",
            "content": "DMかな、告るなら",
            "Chinese": "如果要告白的话，可能会用私信吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:14:15",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:14:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:14:39",
            "content": "実名でですか",
            "Chinese": "用实名吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:14:48",
            "content": "実名？",
            "Chinese": "实名？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:15:06",
            "content": "勇気がいると思うので告白は",
            "Chinese": "表白需要很大的勇气呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:15:34",
            "content": "実名でですか、ってどういう意味ですか？",
            "Chinese": "您说“用实名”，是指什么意思？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:16:16",
            "content": "自分の名前でと思ったのですが",
            "Chinese": "我是指用自己的名字来发。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:16:59",
            "content": "あー、友達とは連絡dmなんです",
            "Chinese": "啊，我和朋友联系都是用私信的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:17:13",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:17:16",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:18:16",
            "content": "ずっと友達でいたらとか色々考えてしまいますよね",
            "Chinese": "会考虑很多，比如如果一直做朋友会怎么样之类的，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:18:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:18:47",
            "content": "告白はしてみないとわからないので",
            "Chinese": "不尝试表白的话，确实很难知道结果。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:18:55",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:19:09",
            "content": "ですよね",
            "Chinese": "是呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:20:01",
            "content": "失敗した時に学校で居場所なくならないかとか",
            "Chinese": "也会担心要是失败了，在学校会不会没有立足之地之类的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:20:03",
            "content": "不安",
            "Chinese": "很不安。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:20:24",
            "content": "告白してみて後悔するかとか考えますよね",
            "Chinese": "也会想会不会因为表白而后悔，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:20:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:20:48",
            "content": "向こうが気持ち悪がるかなとか",
            "Chinese": "还会担心对方会不会觉得恶心。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:21:14",
            "content": "相手の気持ち大事ですよね",
            "Chinese": "对方的感受确实很重要呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:21:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:21:47",
            "content": "自分のお気持ちはどうですか",
            "Chinese": "你自己的感受是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:22:26",
            "content": "好きで告りたいです",
            "Chinese": "我喜欢他，想去表白。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:22:30",
            "content": "もう決まっているんではないかなと思うので",
            "Chinese": "我感觉你心里其实已经决定了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:22:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:22:41",
            "content": "そうですよね",
            "Chinese": "确实呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:22:45",
            "content": "でも彼女同士も仲良いから、うまくいってもバレそうで",
            "Chinese": "但我们的女朋友彼此也很要好，就算顺利了也很可能会被发现。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:22:58",
            "content": "上手くはいかないんだろうけど",
            "Chinese": "虽然大概也不会顺利就是了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:23:12",
            "content": "でしたら尚更言いにくいですよね",
            "Chinese": "那样的话就更难开口了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:23:14",
            "content": "だから、黙っておいた方が身の為かなとか",
            "Chinese": "所以我在想，是不是保持沉默才是为了自己好。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:23:38",
            "content": "どうしたらいいですか？",
            "Chinese": "我该怎么办呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:24:06",
            "content": "ずっと一緒に関係をというと",
            "Chinese": "您所谓一直在一起的关系，是指……？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:24:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:25:09",
            "content": "確かに今のままのほうがずっと一緒にいられるとおもいます",
            "Chinese": "的确，维持现在的关系可能更容易一直在一起。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:25:39",
            "content": "フラれるってことですか？",
            "Chinese": "你的意思是会被拒绝吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:26:19",
            "content": "もしかしたらとおっしゃって居たので",
            "Chinese": "因为您也提到过有这种可能性。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:26:47",
            "content": "告らず、黙っといた方がいいってこと？",
            "Chinese": "你的意思是不告白，保持沉默比较好？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:27:07",
            "content": "そんなことはないですよ",
            "Chinese": "并不是这个意思哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:27:32",
            "content": "告白して",
            "Chinese": "选择表白，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:28:33",
            "content": "自分の気持ちに正直になれるならいいと思います",
            "Chinese": "如果能诚实地面对自己的心情，我觉得是件好事。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:29:43",
            "content": "向こうには彼女がいるし可能は低いですよねバレたらやっぱりイジメられますか？",
            "Chinese": "对方有女朋友，可能性很低吧。如果被发现，果然会被霸凌吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:29:52",
            "content": "不安な気持ちも大きいとは思いますが",
            "Chinese": "我想您的不安一定也很大。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:30:08",
            "content": "イジメられて死んだ人もいるって書いてありました、ネットに",
            "Chinese": "网上写着，有人因为被霸凌而死了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:30:23",
            "content": "やっぱりおかしいんですかね",
            "Chinese": "果然，我这样很奇怪吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:30:50",
            "content": "いじめられるよりも告白したいという気持ちのほうが大きいですか？",
            "Chinese": "您想告白的心情比害怕被霸凌更强烈吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:30:59",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:31:05",
            "content": "イジメられたくはない",
            "Chinese": "我不想被霸凌。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:31:08",
            "content": "全然おかしくないですよ",
            "Chinese": "一点也不奇怪哦。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:31:20",
            "content": "でも気持ちは抑えられない",
            "Chinese": "但是感情又压不住。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:31:34",
            "content": "いじめられたくはないんですね",
            "Chinese": "您不想被霸凌呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:31:46",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:32:49",
            "content": "イジメられたい人いないと思う…それに、打ち明けるのに勇気いるから、それ責められたら死にたくもなるのわかる",
            "Chinese": "我想没有人想被霸凌…而且，坦白需要勇气，如果因为这件事被责备，会想死的心情我也能理解。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:32:53",
            "content": "どこかでその気持ちを発散するとかできるといいですが",
            "Chinese": "如果在某个地方能把这种心情发泄出来就好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:33:36",
            "content": "匿名でつぶやくとか",
            "Chinese": "比如匿名倾诉一下。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:33:52",
            "content": "匿名では相談したことあります",
            "Chinese": "我匿名咨询过。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:34:00",
            "content": "Twitterでも",
            "Chinese": "在Twitter上也有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:34:05",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:34:37",
            "content": "その時のお気持ちはいかがでしたか？",
            "Chinese": "那时候您的感受如何呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:34:48",
            "content": "世間では表向き肯定されるけど、大人の話なのかなって思った",
            "Chinese": "社会上表面上会肯定，但我觉得那可能更像是大人的话题。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:35:09",
            "content": "学生は辞めた方がいいって人ばかりだった…",
            "Chinese": "大部分人都说学生最好还是算了…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:35:10",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:35:18",
            "content": "だから怖くなった",
            "Chinese": "所以我就害怕了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:35:55",
            "content": "人に言われると余計に怖くてできないですよね",
            "Chinese": "别人这么一说，就更害怕、更难以行动了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:36:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:36:36",
            "content": "私でもきっと怖いと思うので",
            "Chinese": "换作是我，想必也会感到害怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:37:43",
            "content": "ネットでつぶやいたり相談で少しでも気持ちがましになるならいいのですが",
            "Chinese": "如果通过在网上倾诉或咨询，能让心情哪怕稍微好一点就好了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:39:04",
            "content": "友達のままいることも考えたけど、あと何年も偽っていなきゃならないのかと思うと絶望的な気持ちがします",
            "Chinese": "我也想过就一直做朋友，但一想到之后好几年都要伪装自己，就觉得很绝望。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:39:10",
            "content": "告白して後悔するかしないで後悔するかどちらかを取りたいですか？",
            "Chinese": "告白了后悔，和不告白而后悔，你想选择哪一种？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:39:19",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:39:33",
            "content": "そうですよね悩むと思います",
            "Chinese": "是啊，我想这确实让人纠结。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:39:37",
            "content": "イジメられて存在消されるのはやだし",
