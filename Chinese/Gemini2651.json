        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:46:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:47:47",
            "content": "後悔しても告白したい気持ちが抑えられないのであれば告白してもいいと思います",
