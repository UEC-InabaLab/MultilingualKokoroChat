        {
            "role": "カウンセラー",
            "time": "2021/11/04(木) 15:44:28",
            "content": "いいですね",
            "Chinese": "那很好啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/04(木) 15:44:36",
            "content": "無人島に一緒にいくならお前とって",
