{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:00:14",
            "content": "こんばんは。本日はロールプレイよろしくお願いします。",
            "Chinese": "晚上好。今天的角色扮演，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:00:31",
            "content": "よろしくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:00:54",
            "content": "では早速ロールプレイをお願い致します。",
            "Chinese": "那么，我们马上开始角色扮演吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:01:21",
            "content": "お願いします",
            "Chinese": "好的，拜托了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:01:25",
            "content": "こんばんは。相談員です。本日はどういった相談でしょうか？",
            "Chinese": "晚上好。我是咨询师。今天您想咨询什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:01:40",
            "content": "こんばんは",
            "Chinese": "晚上好。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:01:50",
            "content": "今日は友人との関係についてです",
            "Chinese": "今天想谈谈我和朋友的关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:01:50",
            "content": "こんばんは。",
            "Chinese": "晚上好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:02:10",
            "content": "そうなのですね。友人関係でお悩みなのですね。",
            "Chinese": "原来如此。您在为朋友关系而烦恼呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:02:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:02:19",
            "content": "喧嘩をしました",
            "Chinese": "我们吵架了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:03:10",
            "content": "どういったところでしんどさを感じておられるのか伺ってもよろしいでしょうか？",
            "Chinese": "可以请您谈谈，是哪些方面让您感到困扰吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:03:46",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:03:55",
            "content": "先週なのですが",
            "Chinese": "是上周的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:04:07",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:04:10",
            "content": "友人とカフェでお話しをしておりまして",
            "Chinese": "我和朋友在咖啡馆聊天，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:04:19",
            "content": "えぇ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:04:44",
            "content": "お互いの仕事への価値観の話をしていました",
            "Chinese": "我们聊了彼此对工作的价值观。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:05:11",
            "content": "そうでしたか",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:05:21",
            "content": "その友人は少し手を抜いてもいいという考えがあります",
            "Chinese": "那位朋友认为工作上可以稍微偷点懒也没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:05:50",
            "content": "そうなのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:06:13",
            "content": "私は仕事をしっかりしないといけないとおもい",
            "Chinese": "而我认为工作就应该踏踏实实做好，"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:06:22",
            "content": "そこで意見の言い合いがはじまりました",
            "Chinese": "于是我们就开始争论起来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:06:25",
            "content": "えぇ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:07:08",
            "content": "そこまだ深く話すつもりじゃなかったのですがだんだんと喧嘩のような会話になってしまい",
            "Chinese": "本来没打算聊得那么深入，但渐渐地就变成了像吵架一样的对话，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:07:22",
            "content": "なるほど",
            "Chinese": "我明白。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:07:28",
            "content": "最終的にはもういいといい私が先に出て行ってしまいました",
            "Chinese": "最后我说了句“算了”，然后就先走了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:07:44",
            "content": "後からいいすぎたとはおもっていたのですが",
            "Chinese": "事后我也觉得话说得有点重了，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:07:54",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:08:02",
            "content": "連絡が取りづらい状態です",
            "Chinese": "现在很难联系上对方。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:08:14",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:08:44",
            "content": "どうしていいのかわかりません",
            "Chinese": "我不知道该怎么办才好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:08:55",
            "content": "そうですよね。",
            "Chinese": "是啊，我能理解。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:09:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:09:35",
            "content": "友達とはいえお互いの価値観の違いから生じた喧嘩ですから気まづい状態ですよね。",
            "Chinese": "虽说是朋友，但因为彼此价值观不同而吵架，现在的状况一定很尴尬吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:09:43",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:10:02",
            "content": "今日はあなたのありのままのお気持ちをお話しいただければと思います。",
            "Chinese": "今天，希望您能坦率地聊聊您真实的想法。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:10:32",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:10:44",
            "content": "もちろんです。",
            "Chinese": "不用客气。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:11:08",
            "content": "そのご友人の方とはどういう風に付き合っていきたいとお考えですか？",
            "Chinese": "您希望今后与那位朋友以怎样的方式相处呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:11:33",
            "content": "このまま切磋琢磨し、友人としても楽しめる関係を望んでいます",
            "Chinese": "我希望能继续保持既能作为朋友愉快相处，又能互相切磋、共同进步的关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:11:45",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:12:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:12:24",
            "content": "このまま、ということは以前から切磋琢磨し合う関係だったのですか？",
            "Chinese": "您说“继续保持”，也就是说以前你们就是互相切磋、共同进步的关系吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:12:42",
            "content": "そうですねお互い職種が同じなので",
            "Chinese": "是的，因为彼此的职业相同。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:12:58",
            "content": "なるほど。そうでしたか。",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:13:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:13:26",
            "content": "あなたにとっても大切な存在だったのですね。",
            "Chinese": "看来她对您来说也是一个很重要的存在呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:13:45",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:14:02",
            "content": "価値観以外は仲の良い関係だったと私はおもいます",
            "Chinese": "我认为除了价值观不同之外，我们的关系一直很好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:14:09",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:14:33",
            "content": "交友関係も深いお付き合いだったのですね。",
            "Chinese": "你们的交情很深厚呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:14:55",
            "content": "学校で一番仲がよかったとおもいます",
            "Chinese": "我想我们在学校时是关系最好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:15:34",
            "content": "そうでしたか。それは大切な存在ですね。",
            "Chinese": "是这样啊。那真是个很重要的人呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:15:39",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:16:11",
            "content": "以前に今回の喧嘩のようなものはありましたか？",
            "Chinese": "以前有过类似这次的争吵吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:16:29",
            "content": "いえ、仕事の愚痴はありましたが喧嘩にはなりませんでした",
            "Chinese": "没有，虽然会抱怨工作上的事，但没有吵过架。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:16:39",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:16:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:17:03",
            "content": "それでは今回がお二人にとって初めての喧嘩ということなのですね。",
            "Chinese": "那么也就是说，这次是你们两人第一次吵架了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:17:19",
            "content": "大きな喧嘩はそうですね",
            "Chinese": "嗯，这么大的争吵是第一次。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:17:30",
            "content": "プライベートもここまではなかったです",
            "Chinese": "私下里也没到过这种程度。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:17:45",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:18:01",
            "content": "それは心苦しい思いをされましたね。",
            "Chinese": "那您心里一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:18:26",
            "content": "いいすぎましたが一番心に残ってます",
            "Chinese": "虽然我说得过分了，但这件事一直让我耿耿于怀。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:18:46",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:19:03",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:19:10",
            "content": "言いすぎたというのはどういうことを言ってしまったのか教えていただけますか？",
            "Chinese": "您能告诉我，您说的“话说重了”是指说了些什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:19:29",
            "content": "その考え方ではだめだ",
            "Chinese": "“你那种想法不行”，"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:19:30",
            "content": "とか",
            "Chinese": "之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:19:36",
            "content": "えぇ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:19:37",
            "content": "変えたほうがよいとか",
            "Chinese": "还有“最好改一改”之类的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:19:47",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:19:52",
            "content": "それだと周りに迷惑がかける",
            "Chinese": "“那样会给周围的人添麻烦”"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:19:55",
            "content": "などでしょうか",
            "Chinese": "大概就是这些吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:20:11",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:20:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:21:15",
            "content": "何に対して迷惑だとおっしゃられたのですか？",
            "Chinese": "您是针对什么说会添麻烦的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:21:31",
            "content": "その考えでは",
            "Chinese": "是针对那种想法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:21:37",
            "content": "えぇ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:21:52",
            "content": "適当な考えというか仕事はどれだけサボれるか",
            "Chinese": "就是那种敷衍了事的想法，或者说，工作能偷懒就偷懒。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:21:55",
            "content": "というかです",
            "Chinese": "类似这样的想法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:22:04",
            "content": "なるほど",
            "Chinese": "明白了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:22:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:22:28",
            "content": "仕事に対する責任感についておっしゃられたのですね",
            "Chinese": "您是对她工作的责任感发表了看法，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:22:45",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:22:58",
            "content": "言ってみて相手の反応はいかがでしたか？",
            "Chinese": "您说了之后，对方的反应怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:23:30",
            "content": "なんでそんなに怒るの？と",
            "Chinese": "她说：“你干嘛那么生气？”"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:23:37",
            "content": "軽い反応でした",
            "Chinese": "反应很轻描淡写。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:23:39",
            "content": "そうでしたか",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:23:45",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:23:51",
            "content": "その反応を見てどう感じましたか？",
            "Chinese": "看到她的反应，您有什么感觉？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:24:13",
            "content": "あ、そんな感じなんだと",
            "Chinese": "啊，原来她是这种感觉啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:24:16",
            "content": "思いました",
            "Chinese": "我当时是这么想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:24:20",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:24:26",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:24:37",
            "content": "諦めに近いような感覚でしょうか？",
            "Chinese": "是接近于放弃的感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:24:59",
            "content": "怒りから諦めに変わった感じでしょうか",
            "Chinese": "大概是从生气变成了失望吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:25:07",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:25:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:25:51",
            "content": "仕事に対して責任感が無いような発言は聞いていてもしんどいですよね。",
            "Chinese": "听到那种对工作没有责任感的言论，确实会让人很难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:25:59",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:26:11",
            "content": "真面目にやってきた人への侮辱と思いました",
            "Chinese": "我觉得那对认真工作的人是一种侮辱。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:26:28",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:26:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:27:03",
            "content": "友人の方を思って言っておられたのに伝わっていないなと感じるのは心苦しいですよね。",
            "Chinese": "明明是为朋友着想才说的，却感觉对方完全没领会，这确实很让人难过呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:27:19",
            "content": "そうですね、、",
            "Chinese": "是啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:27:27",
            "content": "しっかりしてほしかったなと",
            "Chinese": "我只是希望她能认真一点。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:27:43",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:27:50",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:29:26",
            "content": "言いすぎたなと思うとおっしゃっていましたが、そのことについては相手にお気持ちを伝えてみようと思われますか？",
            "Chinese": "您刚才说觉得自己话说重了，关于这一点，您有想过向对方传达您的想法吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:29:51",
            "content": "伝えようとはしたのですが勇気が出ず、、",
            "Chinese": "我有想过要表达，但一直鼓不起勇气……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:29:59",
            "content": "なるほど。",
            "Chinese": "明白了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:30:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:30:33",
            "content": "何と伝えようと考えておられたのですか？",
            "Chinese": "您原本打算说些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:31:21",
            "content": "言いすぎたごめんね",
            "Chinese": "“我说得太过分了，对不起。”"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:31:27",
            "content": "といおうとしてました",
            "Chinese": "我本来想这么说的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:31:40",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:31:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:32:14",
            "content": "素直なお気持ちを伝えようと思われている姿勢はとても素敵なことだと思います。",
            "Chinese": "我认为您愿意坦诚表达真实感受的态度非常可贵。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:32:22",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:32:56",
            "content": "送るときに勇気が出ないというのは何が一番気になるのでしょうか？",
            "Chinese": "您说发信息的时候没有勇气，最担心的是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:33:10",
            "content": "やはり",
            "Chinese": "果然还是……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:33:16",
            "content": "えぇ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:33:17",
            "content": "返信でしょうか",
            "Chinese": "对方的回复吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:33:19",
            "content": "あいての",
            "Chinese": "对方的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:33:23",
            "content": "なるほど",
            "Chinese": "明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:33:48",
            "content": "相手がどういった反応なのか気になりますよね。",
            "Chinese": "会很在意对方的反应呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:34:00",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:34:04",
            "content": "怖いです",
            "Chinese": "我很害怕。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:34:17",
            "content": "いいすぎたと思ってますので",
            "Chinese": "因为我觉得自己话说得太重了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:35:05",
            "content": "素直な気持ちを打ち明けた後の相手の反応が気になって足がすくむ思いは誰にでもあると思います。",
            "Chinese": "我想任何人都会有那种因为担心坦白心声后对方的反应而畏缩不前的时候。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:35:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:35:49",
            "content": "どういう反応が一番嫌ですか？",
            "Chinese": "您最害怕遇到什么样的反应？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:35:56",
            "content": "やはり",
            "Chinese": "还是……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:35:59",
            "content": "無視ですかね",
            "Chinese": "被无视吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:36:01",
            "content": "えぇ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:36:08",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:36:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:36:38",
            "content": "無視は悲しいですよね。",
            "Chinese": "被无视会很难过呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:36:57",
            "content": "辛いですね",
            "Chinese": "是啊，很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:37:11",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:37:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:37:24",
            "content": "ではこのメッセージを送らなかったとすればどういうお気持ちになられますか？",
            "Chinese": "那么，如果您不发这条信息，您又会有什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:37:58",
            "content": "後悔するかもしれません",
            "Chinese": "我可能会后悔。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:38:05",
            "content": "このまま疎遠になるかもしれないので",
            "Chinese": "因为这样下去我们可能会就此疏远。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:38:06",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:38:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:38:31",
            "content": "疎遠になってしまうとなると後悔してしまうかもしれませんね。",
            "Chinese": "如果就此疏远，确实可能会后悔呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:38:42",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:38:55",
            "content": "大切なものを失うかもしれません",
            "Chinese": "我可能会失去很重要的东西。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:39:29",
            "content": "そうお考えになるほど友人の方を思っていらっしゃるのですね。",
            "Chinese": "您能这么想，说明您非常珍视这位朋友呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:40:00",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:41:05",
            "content": "疎遠になるのと無視されるのは両方辛いことではあると思いますが、どちらが耐えられそうですか？",
            "Chinese": "被疏远和被无视，我想两者都很痛苦，但您觉得哪一个您更能承受一些呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:41:26",
            "content": "疎遠が辛いです",
            "Chinese": "被疏远更痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:41:33",
            "content": "なるほど。",
            "Chinese": "明白了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:41:37",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:41:56",
            "content": "大切な友人の方と疎遠になってしまうのは辛いですよね。",
            "Chinese": "和重要的朋友疏远，确实很痛苦呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:42:19",
            "content": "辛いです",
            "Chinese": "很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:43:43",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:43:52",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:43:57",
            "content": "言いすぎてしまったことに関して連絡する方がまだ耐えられると思われたのですね。",
            "Chinese": "也就是说，比起疏远，您觉得就话说重了这件事去联系对方，还更能承受一些，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:44:09",
            "content": "おもいます",
            "Chinese": "是的，我认为是。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:44:21",
            "content": "なるほど。",
            "Chinese": "明白了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:44:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:45:48",
            "content": "あなたは疎遠になるくらいなら連絡を取りたいと思われたのでその強いお気持ちも友人の方に伝えて見るのはどうお考えですか？",
            "Chinese": "既然您觉得与其疏远不如主动联系，那么把这份强烈的心情也传达给朋友，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:46:35",
            "content": "たしかに",
            "Chinese": "确实。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:46:45",
            "content": "えぇ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:46:45",
            "content": "伝えてみてもよいとおもいます",
            "Chinese": "我觉得可以试着传达一下。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:46:49",
            "content": "しかし",
            "Chinese": "但是。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:46:54",
            "content": "どのような文",
            "Chinese": "该用什么样的措辞呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:46:54",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:47:00",
            "content": "を送ったらよいわかりません",
            "Chinese": "我不知道该怎么写。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:47:12",
            "content": "なるほど。",
            "Chinese": "明白了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:47:16",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:47:44",
            "content": "最初はどういう文章を送りたいとお考えでしたか？",
            "Chinese": "您最初是想发什么样的内容呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:48:14",
            "content": "言いすぎましたごめんなさい",
            "Chinese": "“我说得太过分了，对不起。”"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:48:17",
            "content": "です",
            "Chinese": "就是这个。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:48:26",
            "content": "なるほど。",
            "Chinese": "明白了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:48:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:48:48",
            "content": "それもあなたのお気持ちが入っていて素晴らしいと思います。",
            "Chinese": "我觉得这句话也包含了您的心情，非常好。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:48:57",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:49:21",
            "content": "追加でどういう文章を入れようと思われますか？",
            "Chinese": "您想再追加一些什么内容吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:49:33",
            "content": "箇条書きでも構いませんよ。",
            "Chinese": "列成条目也可以哦。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:49:59",
            "content": "言いすぎましたごめんなさいまた連絡くれるとうれしいです",
            "Chinese": "“我说得太过分了，对不起。如果你能再联系我，我会很高兴。”"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:50:02",
            "content": "ですかね",
            "Chinese": "大概是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:50:08",
            "content": "他は思いつかないです",
            "Chinese": "我想不到别的了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:50:31",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:50:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:51:29",
            "content": "また連絡くれると嬉しいですという最後の文章はとてもあなたの友達を思いやる気持ちが込められているように感じました。",
            "Chinese": "“如果你能再联系我，我会很高兴。”这最后一句话，我感觉非常好地表达了您为朋友着想的心情。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:51:44",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/12(金) 20:52:19",
            "content": "これを送ってみると考えるとどう感じますか？",
            "Chinese": "如果试着把这个发出去，您感觉怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/12(金) 20:52:33",
            "content": "また連絡くれるかなと",
            "Chinese": "我会想“她会再联系我吗？”"
        },
        {
