{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:00:08",
            "content": "こんにちは相談員です。よろしくお願いいたします。",
            "Chinese": "您好，我是咨询师。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:00:26",
            "content": "よろしくお願いします。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:00:49",
            "content": "最初に年齢と性別を教えていただけますか？",
            "Chinese": "首先，能请您告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:01:09",
            "content": "25歳　女です。",
            "Chinese": "25岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:01:22",
            "content": "お返事ありがとうございます。",
            "Chinese": "感谢您的回复。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:01:37",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:02:32",
            "content": "誰とも喋らず1日が終わる毎日で、寂しいです...",
            "Chinese": "每天都过着不和任何人说话的日子，感觉很寂寞..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:02:57",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:03:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:04:14",
            "content": "誰とも喋らないでいると一人ぼっちという感じになってしまうのでしょうね・・・",
            "Chinese": "一直不和任何人说话，难免会感觉孤单吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:04:39",
            "content": "そうなんです。孤独です。",
            "Chinese": "是的，很孤独。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:05:04",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:05:35",
            "content": "誰とも喋らない日々はどのくらい続いているのですか？",
            "Chinese": "这样不和任何人说话的日子，持续了多久了呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:06:07",
            "content": "1年位です。",
            "Chinese": "大概一年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:07:07",
            "content": "とても長い間孤独を抱えてこられたんですね・・・",
            "Chinese": "您独自承受孤独已经很长时间了呢…"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:07:16",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:08:23",
            "content": "深い寂しさだったのでしょうね",
            "Chinese": "那想必是一种很深的寂寞吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:08:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:08:59",
            "content": "その間お一人で暮らして来られたのでしょうか？",
            "Chinese": "那么，这段时间您都是一个人生活吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:09:24",
            "content": "はい。今一人暮らししてます。",
            "Chinese": "是的，我现在一个人住。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:09:49",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:10:33",
            "content": "1年間もお一人で寂しさを抱えて暮らして来られたのは大変なことだったと思います。",
            "Chinese": "一个人怀着寂寞生活了长达一年，我想一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:10:43",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:10:56",
            "content": "日々どのようにして過ごして来られたのでしょう？",
            "Chinese": "这些日子您都是怎么度过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:11:40",
            "content": "寂しいなーと思いながら、過ごしてきました。",
            "Chinese": "一直想着“好寂寞啊”，就这样熬过来的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:12:02",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:12:21",
            "content": "お仕事とかはなさっているのですか？",
            "Chinese": "您有在工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:12:33",
            "content": "はい。",
            "Chinese": "有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:12:52",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:13:17",
            "content": "もしよろしければ、どんなお仕事をなさっているのか教えていただけますか？",
            "Chinese": "如果方便的话，能告诉我您从事什么工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:13:37",
            "content": "事務職です。",
            "Chinese": "是文职工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:13:54",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:14:40",
            "content": "毎日出勤するのですか？それとも、自宅でのオンラインでの勤務なのでしょうか？",
            "Chinese": "您是每天都去公司上班，还是在家线上办公呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:15:06",
            "content": "私は、毎日出勤してます。",
            "Chinese": "我每天都去公司上班。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:15:28",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:16:02",
            "content": "そうすると、毎日職場の人とのやり取りはありそうですね・・・",
            "Chinese": "这样的话，每天应该都会和公司的同事有交流吧..."
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:17:02",
            "content": "やり取り？仕事上の、業務連絡的な事はあります。",
            "Chinese": "交流？工作上业务联络之类的是有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:18:25",
            "content": "やり取りと言ったのは、職場での業務上の会話とか、休憩時間の会話とかがあるのでは？　と思ったのですが・・・",
            "Chinese": "我说的交流，是想问比如工作上的对话，或者休息时间的聊天，这些有没有呢..."
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:19:31",
            "content": "業務上の会話はありますが、お昼は1人で食べています。",
            "Chinese": "工作上的对话是有的，但午饭我都是一个人吃。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:19:52",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:20:45",
            "content": "お昼休みは誰とも会話することなくということのようですね。",
            "Chinese": "看来午休时间您也不和任何人说话呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:20:55",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:23:13",
            "content": "会社の中にはお話し相手になってくれそうな人はいないのでしょうか？",
            "Chinese": "公司里没有看起来可以聊聊的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:23:29",
            "content": "はい。",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:24:47",
            "content": "会社でもお仕事以外の事では誰とも話さず、お家でもお一人だと、本当に誰とも話さない日々になってしまうんですね。",
            "Chinese": "在公司除了工作的事不和任何人说话，在家又是一个人，那就真的成了每天都不和任何人说话的日子了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:25:04",
            "content": "そうなんです。",
            "Chinese": "是这样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:25:17",
            "content": "それは寂しい限りですね。",
            "Chinese": "那真是太寂寞了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:25:31",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:26:04",
            "content": "1年ぐらい前からというお話しでしたが、それ以前はどのような暮らしだったのですか？",
            "Chinese": "您说这种情况是从大约一年前开始的，在那之前您的生活是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:27:54",
            "content": "今の会社に転職して2年目なのですが、前の会社では同年代の子もいて話が出来ました。",
            "Chinese": "我跳槽到现在的公司是第二年了，在之前的公司有同龄人，可以一起聊天。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:28:24",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:29:17",
            "content": "前の会社の時は、同年代の子たちと会話を楽しんでおられたんですね。",
            "Chinese": "在之前的公司时，您和同龄人聊天很开心呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:29:30",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:30:27",
            "content": "今の会社では同じ職場の人たちとは年齢が離れすぎていて話ずらいということみたいですね。",
            "Chinese": "在现在的公司，看来是因为和同事们的年龄差距太大，所以很难聊到一起呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:30:56",
            "content": "そうですね。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:32:22",
            "content": "それですっかり孤立した感じになっているのでしょうね・・・",
            "Chinese": "所以就感觉完全被孤立了是吧..."
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:32:28",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:33:20",
            "content": "転職して2年とのお話しですが、事務のお仕事自体は順調に進んでいるのですか？",
            "Chinese": "您说跳槽过来两年了，那文职工作本身还顺利吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:34:03",
            "content": "そうですね。単調ですが。",
            "Chinese": "还算顺利吧，就是比较单调。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:34:27",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:36:30",
            "content": "お仕事が単調とのことですが、ご自身的にはお仕事について何か考えるところがおありなのでしょうか？",
            "Chinese": "您提到工作比较单调，您自己对工作有什么想法或考虑吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:36:54",
            "content": "今は無いですね。",
            "Chinese": "目前没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:37:46",
            "content": "お仕事は今のままで構わないということのようですね。",
            "Chinese": "看来您觉得工作方面保持现状就可以是吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:38:07",
            "content": "内容は、そうです。",
            "Chinese": "工作内容上是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:39:37",
            "content": "そうすると、ご自身としては、今の状態がどうなるといいなと思っておいでなのでしょうか？",
            "Chinese": "那么，您自己希望现在的状态能有什么样的改变呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:40:21",
            "content": "孤独な環境が、無くなれば良いなと思います。",
            "Chinese": "我希望这种孤独的环境能消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:41:20",
            "content": "それは、職場で？それともご自宅での暮しで？",
            "Chinese": "这是指在职场，还是在家里的生活？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:41:35",
            "content": "両方です。",
            "Chinese": "两方面都是。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:43:06",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:44:04",
            "content": "どちらにしても孤独を解消するためには、つながりができる必要があると思うのですが、ご自分ではどう思われますか？",
            "Chinese": "无论是哪方面，为了消除孤独，我觉得有必要建立一些联系，您自己怎么看呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:44:16",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:46:01",
            "content": "あるいは、職場以外でもつながりができると孤独から抜け出て行けそうな気もするのですが、いかがでしょうか？",
            "Chinese": "或者说，如果在公司以外的地方也能建立联系，或许也能走出孤独，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:46:13",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:47:22",
            "content": "職場で、あるいは職場以外でつながりを作ってみるということについては、どう思われますか？",
            "Chinese": "对于在职场内或职场外尝试建立联系这件事，您觉得如何？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:48:11",
            "content": "ただ、元々自分から話しかけるのは苦手です。",
            "Chinese": "不过，我本来就不擅长主动跟人搭话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:48:37",
            "content": "そうなんですね。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:50:00",
            "content": "前の会社では、同じ年ごろの子がいたので、話ができたということだったのですね。",
            "Chinese": "在之前的公司，是因为有年龄相仿的人，所以才能够聊上天是吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:50:16",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:51:21",
            "content": "今の会社でこのまま誰とも話をしないでいると、この先どうなっていくのでしょう？",
            "Chinese": "如果在现在的公司继续这样不和任何人说话，今后会变成怎样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:51:58",
            "content": "孤独になります。",
            "Chinese": "会变得很孤独。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:53:27",
            "content": "なんとかそうならないためにはどうしたらいいでしょうか？",
            "Chinese": "为了尽量不变成那样，该怎么做才好呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:54:20",
            "content": "分からないです...",
            "Chinese": "我也不清楚……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:54:58",
            "content": "いまのままでは辛すぎるような気がするのですが・・・",
            "Chinese": "我感觉照现在这样下去，对您来说太辛苦了……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:55:20",
            "content": "はい。それで、相談にきました...",
            "Chinese": "是的。所以，我才来咨询……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:56:30",
            "content": "よくお聞きするはペットを飼ってみるとおいうこともあるようですよ。",
            "Chinese": "经常听说养个宠物也是一种方法哦。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/21(日) 15:57:28",
            "content": "一人暮らしなので、難しいです...",
            "Chinese": "因为我一个人住，所以有点困难..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/21(日) 15:58:15",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
