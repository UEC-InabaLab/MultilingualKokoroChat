{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:01:13",
            "content": "こんにちは、相談員です。",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:01:21",
            "content": "最初に、年齢・性別・今日お話ししたいことを教えて頂けますか？",
            "Chinese": "首先，能请您告诉我您的年龄、性别以及今天想聊些什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:02:07",
            "content": "こんにちは。50才女性です。",
            "Chinese": "您好。我是50岁的女性。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:02:39",
            "content": "今日は、仕事のことで相談です。",
            "Chinese": "今天想就工作上的事进行咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:03:04",
            "content": "教えてくださってありがとうございます。",
            "Chinese": "谢谢您告诉我这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:03:22",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:03:38",
            "content": "もう少し詳しく教えて頂けますか？",
            "Chinese": "能再详细说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:03:51",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:04:30",
            "content": "お仕事のどのようなことについてご相談でしょうか？",
            "Chinese": "您想就工作中的哪些方面进行咨询呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:04:57",
            "content": "今の職場は、女性が多く長年いる女性と同じ意見じゃないといじめられるという現状に困っています。",
            "Chinese": "我现在的职场女性较多，如果意见不与那些在职多年的女性一致就会遭到排挤，这种现状让我很困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:05:35",
            "content": "なるほど…それは困りますね。",
            "Chinese": "原来如此…那确实很令人困扰呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:06:02",
            "content": "あなたはこれまでに、",
            "Chinese": "您之前是否……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:06:40",
            "content": "長年いる女性と同じ意見じゃなく、いじめにあったことなどはございましたか？",
            "Chinese": "您之前是否因为与长期在职的女性意见不同而遭受过排挤？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:07:04",
            "content": "はい、あります。",
            "Chinese": "是的，有过。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:07:30",
            "content": "そうだったんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:07:40",
            "content": "嫌な思いをされたんですね。",
            "Chinese": "您一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:08:02",
            "content": "とても辛かったです。",
            "Chinese": "非常痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:08:25",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:08:46",
            "content": "辛いと感じますよね...",
            "Chinese": "是会觉得很痛苦的..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:09:00",
            "content": "もし、差し支えなければ、",
            "Chinese": "如果方便的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:09:32",
            "content": "どんな状況だったのか教えて頂けますか？",
            "Chinese": "能跟我说说当时是怎样的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:09:48",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:10:18",
            "content": "実際にどんな状況でしたか？",
            "Chinese": "实际上是怎样的情况呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:10:39",
            "content": "その方は、10年以上勤務していて全ての業務を知り尽くしています。",
            "Chinese": "那位同事在这里工作了十多年，对所有业务都了如指掌。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:10:55",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:11:39",
            "content": "私は、他の企業で長年勤務していて、転職により今の会社に2年前に来ました。",
            "Chinese": "我此前在其他公司工作多年，因跳槽于两年前来到现在的公司。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:12:00",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:12:40",
            "content": "入社当時から厳しい方なのですが、他の方には優しくて気が利く方と呼ばれています。",
            "Chinese": "她从我进公司时起就对我非常严厉，但别人都说她是个又温柔又体贴的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:13:00",
            "content": "なるほど...",
            "Chinese": "原来如此..."
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:13:31",
            "content": "あるとき、年齢がお若い方がいたので、社会人経験者としてアドバイスしていたら、",
            "Chinese": "有一次，有位比较年轻的同事在，我作为职场前辈给她提了些建议，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:13:53",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:14:30",
            "content": "｢あ、始まった｣と言われ、周りの人に聞こえるように、また自慢だよと。",
            "Chinese": "结果她就说“啊，又开始了”，还故意让周围的人听到，说我又在炫耀了。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:14:50",
            "content": "決して自慢ではなく、",
            "Chinese": "我绝不是在炫耀，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:14:59",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:15:15",
            "content": "あくまで個人の参考意見でした。",
            "Chinese": "只是提供个人的参考意见而已。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:15:38",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:16:12",
            "content": "良い悪いは関係ないと感じていましたが、その方には自慢していると受け取ったようです。",
            "Chinese": "我觉得这无所谓好坏，但她似乎认为我是在炫耀。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:16:36",
            "content": "なるほどですね...",
            "Chinese": "是这样啊..."
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:16:59",
            "content": "この2年で3回目でした。",
            "Chinese": "这两年里已经是第三次了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:17:10",
            "content": "！",
            "Chinese": "！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:17:22",
            "content": "２年で３回も！",
            "Chinese": "两年里竟然有三次！"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:17:59",
            "content": "そうなんです。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:18:29",
            "content": "なるほど...",
            "Chinese": "原来如此..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:18:52",
            "content": "それは仕事もやりづらいですね…",
            "Chinese": "那工作起来也很不顺心吧…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:19:08",
            "content": "一緒に仕事をしている方に相談しようにも、",
            "Chinese": "即使想向一起工作的同事倾诉，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:19:15",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:19:41",
            "content": "私以外は良い人なので話ができません",
            "Chinese": "但其他人都觉得她很好，我无法开口。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:20:18",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:20:40",
            "content": "相談できない状況もおつらいですね。",
            "Chinese": "无法倾诉的状况也让您很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:20:59",
            "content": "そうなんです。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:21:06",
            "content": "あなたは、今の状況を",
            "Chinese": "关于您现在的情况，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:21:19",
            "content": "職場以外の方に相談したりはできていますか？",
            "Chinese": "有和公司以外的人聊过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:22:04",
            "content": "今はコロナの影響で、みんなに大変なので話せないです。",
            "Chinese": "现在受新冠疫情影响，大家都不容易，所以我也不好开口。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:22:26",
            "content": "なるほど...",
            "Chinese": "原来如此..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:22:41",
            "content": "今は話せていないのですね。",
            "Chinese": "就是说现在没能和别人倾诉是吗。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:22:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:23:11",
            "content": "ここまでお話を聴かせて頂きましたが、",
            "Chinese": "听您说到这里，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:23:50",
            "content": "この状況について、",
            "Chinese": "关于这个情况，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:24:22",
            "content": "あなたはどうしたくて、本日ご相談に来られましたか？",
            "Chinese": "您希望怎么做，所以今天才来咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:27:00",
            "content": "その方を無視して自分の仕事をしたいのです。私以外の方との話を全て聞いているので怖いですが･･･",
            "Chinese": "我想无视她，专心做好自己的工作。但她会听所有其他人的对话，这让我有些害怕……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:27:36",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:27:46",
            "content": "ではあなたは、",
            "Chinese": "那么您的意思是，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:28:50",
            "content": "その方を気にせず、仕事がしたいということですね。",
            "Chinese": "不去在意她，专心工作，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:29:11",
            "content": "はい、ただ･･･",
            "Chinese": "是的，不过……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:29:27",
            "content": "うん...",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:30:19",
            "content": "先ほどもお伝えしましたが、その方に仕事の不明点などを聞かないとならず、完全ムシは難しいのです。",
            "Chinese": "正如刚才所说，有些工作上的不明之处必须向她请教，所以完全无视她很难。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:31:09",
            "content": "なるほどですね...それは難しい状況ですね。",
            "Chinese": "是这样啊...那情况确实很棘手呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:31:45",
            "content": "そうなんです。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:32:24",
            "content": "あなたが今の職場で、",
            "Chinese": "您在现在的职场，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:32:41",
            "content": "その方と一緒に仕事をしていて",
            "Chinese": "与她一起工作时，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:33:03",
            "content": "やりづらいのは、",
            "Chinese": "感到不顺心的地方，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:33:17",
            "content": "先ほどお話し頂いたことのほかにも",
            "Chinese": "除了刚才提到的事以外，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:33:23",
            "content": "何かありますか？",
            "Chinese": "还有别的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:34:07",
            "content": "はい、あります。",
            "Chinese": "是的，有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:34:18",
            "content": "どんなことですか？",
            "Chinese": "是什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:36:07",
            "content": "同じ職場にお気に入りの女性がいます。その女性に仕事をお願いするのですが、その女性がミスを連発し、そのフォローを私がするという悪循環。",
            "Chinese": "同一职场里有一位她偏爱的女同事。她会把工作交给那位女同事，但那位女同事频频出错，最后都由我来收拾残局，形成了恶性循环。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:37:12",
            "content": "なるほど...仕事をお願いするのは、あなたですか？それともその方ですか？",
            "Chinese": "原来如此...把工作交给那位女同事的是您，还是那位资深同事？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:37:37",
            "content": "長年勤務されている方です。",
            "Chinese": "是那位资深同事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:38:05",
            "content": "なるほど...",
            "Chinese": "原来如此..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:38:17",
            "content": "それは納得できないですね。",
            "Chinese": "那确实让人难以接受呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:38:27",
            "content": "お気に入りの女性も、長年勤務されている方のお気に入りです。わたしは嫌いです。",
            "Chinese": "那个受她偏爱的女同事，就是那个资深同事跟前的红人。我很讨厌她。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:39:17",
            "content": "なるほど…そうなんですね。あなたがそう思うのも当然だと思います。",
            "Chinese": "原来如此…是这样啊。您会这么想，我觉得也很正常。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:40:12",
            "content": "その時あなたは、",
            "Chinese": "那个时候，您"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:40:19",
            "content": "どんなお気持ちですか？",
            "Chinese": "是怎样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:42:14",
            "content": "そーですね･･･かかわりたくない。です。",
            "Chinese": "嗯……不想与她们有任何牵扯。就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:42:33",
            "content": "そうですよね...",
            "Chinese": "是啊..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:43:06",
            "content": "例えば、違う部署に異動願を出すなど",
            "Chinese": "比如说，申请调到别的部门之类的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 17:43:24",
            "content": "あなたができそうなことはありますか？",
            "Chinese": "有什么您觉得可以做到的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 17:45:17",
            "content": "異動は考えましたが、コロナで人員削減していて無理だし･･･長年勤務している方の上司に言うこと。でしょうか。",
