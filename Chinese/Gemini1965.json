{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 18:55:18",
            "content": "本日はロールプレイよろしくお願いいたします。時間になりましたら始めさせていただきます。",
            "Chinese": "今天的角色扮演，还请多多指教。时间一到，我们便正式开始。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 18:55:43",
            "content": "こちらからこそ、よろしくお願いいたします。",
            "Chinese": "我才是，请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:00:13",
            "content": "こんばんは。相談員です。まず年齢、性別、お名前を教えてください。",
            "Chinese": "晚上好。我是咨询员。请先告诉我您的年龄、性别和姓名。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:00:46",
            "content": "こんばんは。50代、女性、かぶちゃんです",
            "Chinese": "晚上好。50多岁，女性，我叫卡布酱。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:01:08",
            "content": "かぶちゃんですね。本日はよろしくお願いいたします。",
            "Chinese": "是卡布酱对吧。今天请多指教。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:01:17",
            "content": "よろしくお願いいたします",
            "Chinese": "请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:01:42",
            "content": "どのようなことをお話になられたくて来てくださいましたか？",
            "Chinese": "您今天来是想谈些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:02:15",
            "content": "なんだか、疲れやすくて、ミスが多いのです",
            "Chinese": "总觉得很容易疲劳，而且经常出错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:02:58",
            "content": "なるほど…どのようなミスをされてすしまうのでしょうか？",
            "Chinese": "原来如此……会出现哪些方面的错误呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:03:16",
            "content": "発注ミスしたり",
            "Chinese": "比如下单出错了，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:03:27",
            "content": "締め切りに間に合わなかったり",
            "Chinese": "或者赶不上截止日期，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:03:48",
            "content": "間違えて対応してしまうんです",
            "Chinese": "还会做出错误的应对。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:04:52",
            "content": "そうなのですね。そのようなミスをしてしまったときはかぶちゃんはどんなお気持ちになりますか？",
            "Chinese": "这样啊。当发生那些错误时，卡布酱您心里会有什么样的感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:05:19",
            "content": "つらくなります",
            "Chinese": "会很难受。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:05:26",
            "content": "悲しくなります",
            "Chinese": "会感到悲伤。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:06:00",
            "content": "そうですよね。辛くて悲しいお気持ちになりますよね…自信をなくしてしまったりもするかもしれませんね。",
            "Chinese": "是啊，会感到辛苦又难过……也可能会因此失去自信吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:06:29",
            "content": "はい、自信なんてありません",
            "Chinese": "是的，我根本没有自信。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:08:17",
            "content": "そうなのですね。自信がないのですね…",
            "Chinese": "是这样啊。您没有自信了呢…"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:08:34",
            "content": "はい・・・",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:09:05",
            "content": "自分を認められていないって感じでしょうか？",
            "Chinese": "会不会觉得很难肯定自己呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:09:34",
            "content": "そうですね。ミスが多いですからね。",
            "Chinese": "是的。因为我总是犯错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:10:31",
            "content": "なるほど…疲れているときにミスをしてしまうとのことでしたが、特にどんな時に疲れを感じますか？",
            "Chinese": "我明白了……您提到在疲劳时更容易出错，那特别是在什么情况下会感到疲劳呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:11:02",
            "content": "睡眠不足のときと",
            "Chinese": "睡眠不足的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:11:10",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:11:26",
            "content": "コミュニケーションがうまくとれないときでしょうか",
            "Chinese": "还有沟通不顺利的时候吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:12:54",
            "content": "そうなのですね。たしかに寝不足だと頭も働かないですし",
            "Chinese": "是这样啊。确实，睡眠不足时脑子也转不动，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:13:05",
            "content": "そうなんですよ",
            "Chinese": "就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:13:31",
            "content": "コミュニケーションが滞ると疲れがでますよね。",
            "Chinese": "沟通受阻时也会让人感到疲惫呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:13:52",
            "content": "そうなのです。どっと疲れがでます",
            "Chinese": "是的。会一下子感觉很累。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:13:53",
            "content": "コミュニケーションは仕事上の人間関係においてでしょうか。",
            "Chinese": "您说的沟通，是指工作上的人际关系吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:14:10",
            "content": "はい！",
            "Chinese": "是的！"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:14:36",
            "content": "人間関係というより",
            "Chinese": "与其说是人际关系，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:14:45",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:14:53",
            "content": "自分の伝えたいことが",
            "Chinese": "是我自己想表达的事情"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:15:03",
            "content": "うまく伝えられない",
            "Chinese": "无法很好地传达出去，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:15:18",
            "content": "とか",
            "Chinese": "之类的，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:15:31",
            "content": "時々、声につまります",
            "Chinese": "有时候声音会哽住，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:15:39",
            "content": "言葉につまります",
            "Chinese": "说话也会卡壳。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:15:56",
            "content": "そうなのですね…もどかしい思いをされているのかと思います。",
            "Chinese": "是这样啊……我想您一定觉得很憋屈、很着急吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:16:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:16:53",
            "content": "自分の伝えたいことが伝わりにくいのは仕事のことだけでしょうか？",
            "Chinese": "难以表达自己想说的话，这种情况只发生在工作上吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:17:04",
            "content": "プライベートではいかがでしょうか。",
            "Chinese": "在私下生活里怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:17:15",
            "content": "仕事以外もありますよ",
            "Chinese": "工作以外也会这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:18:19",
            "content": "そうなのですね。人はどうですか？家族なら大丈夫とか…どんな人に対してもですか？",
            "Chinese": "是这样啊。那么，是针对特定的人吗？比如对家人就没问题……还是对所有人都这样？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:19:08",
            "content": "最近はどんな人に対しても、ですかね",
            "Chinese": "最近，好像对任何人都这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:20:34",
            "content": "そうですか…どんな人にも…ということはコミュニケーションをとるたびに気を使いますよね…",
            "Chinese": "是吗…对所有人都这样…那也就是说每次沟通都得格外费心神吧…"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:20:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:21:12",
            "content": "お疲れになる理由はそこにあるのかもしれないと思うのですが、いかがでしょうか。",
            "Chinese": "我在想，您容易感到疲惫的原因，或许就在这里，您觉得呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:21:37",
            "content": "いろんな人とのコミュニケーション疲れなのかなと思います。",
            "Chinese": "我想，或许是和各种人沟通所导致的疲劳吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:21:51",
            "content": "そうなのですかね・・・",
            "Chinese": "是这样吗……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:22:12",
            "content": "自分ても",
            "Chinese": "我自己也…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:22:19",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:22:26",
            "content": "原因がよくわからないのです",
            "Chinese": "不太清楚原因。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:22:54",
            "content": "自分ができない人とも思うのです",
            "Chinese": "也会觉得自己是个能力不足的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:23:51",
            "content": "そうですよね。ミスをするたび、コミュニケーションが上手くいかなかったりするたびそういったお気持ちになりますよね。",
            "Chinese": "是啊。每次出错、每次沟通不顺时，都会有那样的感受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:24:09",
            "content": "そうなのですよ",
            "Chinese": "就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:24:46",
            "content": "そういったお気持ちになるのもよくわかりますし、自然だと思います。",
            "Chinese": "我非常理解您有那样的感受，而且我认为这很自然。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:25:18",
            "content": "自然なことなのですね",
            "Chinese": "原来这是很自然的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:25:35",
            "content": "そうだと思いますよ。ミスをすれば自分のせいで周りの方に迷惑をかけてしまったと思うでしょうし…",
            "Chinese": "我觉得是的。一旦出错，难免会觉得自己给周围的人添了麻烦……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:25:50",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:26:17",
            "content": "仕事関係で迷惑かけてますね",
            "Chinese": "在工作上确实给大家添了麻烦。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:26:30",
            "content": "家族にも・・・",
            "Chinese": "对家人也是……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:26:43",
            "content": "親戚にも迷惑かけてるな",
            "Chinese": "也给亲戚添麻烦了啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:27:19",
            "content": "そう思うとどんどんお辛い気持ちになっていきますよね。かぶちゃんは今の状況で一番改善したいと思うところはどこでしょうか？",
            "Chinese": "这样想的话，心里会越来越难受吧。卡布酱，您在现在的情况下，最想改善的是哪一点呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:27:35",
            "content": "ミスをなくしたいというところでしょうか。",
            "Chinese": "是希望减少错误吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:27:54",
            "content": "はい、ミスを減らしたいです",
            "Chinese": "是的，我想减少错误。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:28:43",
            "content": "ありがとうございます。そうですよね。それではどうすればミスが減らせそうか一緒に考えていきましょう。",
            "Chinese": "谢谢您。是啊。那么，我们一起来想想怎样才能减少错误吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:28:55",
            "content": "お願いします",
            "Chinese": "拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:29:38",
            "content": "はい。かぶちゃんがミスをするときは疲れている以外ではどんな状況のときが多いですか？",
            "Chinese": "好的。卡布酱，您犯错的时候，除了疲劳之外，还经常是在什么情况下呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:29:55",
            "content": "焦ってるとき",
            "Chinese": "着急的时候，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:30:14",
            "content": "不安なことがあるとき",
            "Chinese": "或者心里不安的时候，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:30:38",
            "content": "です",
            "Chinese": "就是这些时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:30:48",
            "content": "なるほど…焦っているときはミスをしやすいですよね。不安なときもそうですよね。",
            "Chinese": "原来如此……着急的时候确实容易出错。不安的时候也是。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:31:04",
            "content": "そうなのですか？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:31:52",
            "content": "焦ったり、不安なときに共通していることは【今】に集中できていない。というところなんです。",
            "Chinese": "着急或不安时的共同点，就是没能专注于【当下】。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:32:07",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:32:16",
            "content": "たしかにそうですね。",
            "Chinese": "确实是这样呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:32:26",
            "content": "焦っているときは早くしあげなきゃと考えているでしょうし",
            "Chinese": "着急的时候，会想着“必须快点完成”，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:32:44",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:32:55",
            "content": "不安なときはこれで大丈夫だろうか…といことが頭をよぎっていると思います。",
            "Chinese": "不安的时候，脑海里则会闪过“这样做真的没问题吗……”之类的念头。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:33:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:33:48",
            "content": "この２つの考えは未来へ気持ちがいってしまっています。",
            "Chinese": "这两种想法，都是把心思放在了未来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:34:01",
            "content": "過去の場合もあります。",
            "Chinese": "有时候也会跑到过去。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:34:15",
            "content": "そうなのですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:34:46",
            "content": "過去の場合は前こんな感じでやったらミスをしたな…と不安になったり",
            "Chinese": "比如想到“之前像这样做了结果出错了……”而感到不安，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:34:58",
            "content": "たしかに",
            "Chinese": "确实。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:35:59",
            "content": "このような考え方、かぶちゃんも思い当たることが少しはあるのかな？と思います。",
            "Chinese": "这样的思维方式，我想卡布酱您可能也多少有些体会吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:36:20",
            "content": "思い当たります",
            "Chinese": "我有体会。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:37:01",
            "content": "そうですよね。焦りや不安な気持ちが出てくることはごく自然なことですし",
            "Chinese": "是啊。产生焦虑或不安的情绪是非常自然的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:37:13",
            "content": "とめることはできないと思います。",
            "Chinese": "而且我认为是无法阻止的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:37:32",
            "content": "ええ～そんなあ～",
            "Chinese": "欸～是这样吗～"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:37:47",
            "content": "そしたら、どうしたらいいですか？",
            "Chinese": "那该怎么办才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:38:14",
            "content": "その気持ちにどう対処をしていくかが重要だと思うのですが、いかがでしょうか。",
            "Chinese": "我认为关键在于如何应对这种情绪，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:38:27",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:39:09",
            "content": "対処の方法がわかっていれば、焦りや不安な気持ちになっても",
            "Chinese": "如果知道了应对方法，即使感到焦虑或不安，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:39:34",
            "content": "でてきたな～という感じで対応できるのかなと思います。",
            "Chinese": "我想也就能以“啊，它又来了”这样的感觉去应对了吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:40:07",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:40:46",
            "content": "はい。肝心な対処の方法ですが、",
            "Chinese": "是的。关于关键的应对方法，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:41:44",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:41:58",
            "content": "焦りに対しては自分を冷静な状態にもっていくことが理想です。",
            "Chinese": "对于焦虑，理想的做法是让自己恢复冷静。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:42:14",
            "content": "冷静？",
            "Chinese": "冷静？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:42:31",
            "content": "どうやってやるんですか？",
            "Chinese": "要怎么做呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:43:05",
            "content": "冷静というか普段の焦っていない状態の自分にもっていくという感じでしょうか。",
            "Chinese": "与其说是冷静，不如说是让自己回到平时不着急的状态。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:43:39",
            "content": "一番簡単にできることは【深呼吸】をする。ということです。",
            "Chinese": "最简单易行的方法，就是【深呼吸】。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:43:51",
            "content": "そうなのですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:44:12",
            "content": "そんなことで焦らなくなるのか。と思われるかもしれませんが、",
            "Chinese": "您可能会想“这么简单就能不焦虑了吗？”，但是，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:44:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:45:06",
            "content": "人間リラックスしているときって呼吸が深いんです。逆をいうと焦っているときは呼吸が浅くなってしまっていることが多いです。",
            "Chinese": "人在放松的时候，呼吸是深沉的。反过来说，焦虑的时候呼吸往往会变浅。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:45:24",
            "content": "たしかに",
            "Chinese": "确实。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:46:10",
            "content": "ですので、かぶちゃんがいま焦ってる！と気づかれたときにまず深呼吸を何回かしてみてください。",
            "Chinese": "所以，当卡布酱您察觉到“我现在很焦虑！”的时候，请先试着做几次深呼吸。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:46:27",
            "content": "はい、わかりました",
            "Chinese": "好的，我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:47:09",
            "content": "そうすると焦っている気持ちから少しスイッチが切り替えられるのではと思います。",
            "Chinese": "这样做的话，我想就能从焦虑的心情中稍微转换一下状态了。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:47:27",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:48:31",
            "content": "スイッチが切り替えられたら、【今】やるべきことに集中してみると何か変わるのでは…と思うのですがいかがでしょうか？",
            "Chinese": "状态转换过来之后，再试着专注于【当下】应该做的事情，情况或许就会有所改变……您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:49:00",
            "content": "今に集中ですね",
            "Chinese": "专注于当下，是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:50:04",
            "content": "そうです！はじめはなれないので難しいかもしれませんが、そういった意識を持つことだけでも変化があると思います。",
            "Chinese": "是的！一开始可能因为不习惯会觉得难，但我觉得，仅仅是拥有这样的意识，也会带来改变。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/31(月) 19:50:20",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/31(月) 19:52:23",
            "content": "不安に対しても今考えても解決しそうにないことはひとまず置いておく。どうしても不安なお気持ちのときは紙に書き出してみるというのもオススメです。",
            "Chinese": "对于不安，暂时先把现在想也解决不了的事情放在一边。如果实在感到不安，我推荐您试着把它们写在纸上。"
        },
