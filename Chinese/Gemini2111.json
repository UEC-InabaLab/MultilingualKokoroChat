{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:20:59",
            "content": "こんばんは。本日はよろしくお願い致します。",
            "Chinese": "晚上好。今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:27:44",
            "content": "よろしくおねがいします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:27:52",
            "content": "時間になりましたら始めさせていただきますね。",
            "Chinese": "时间一到我们就开始。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:28:05",
            "content": "了解しました",
            "Chinese": "明白了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:28:24",
            "content": "何かやってみたいテーマはありますか?",
            "Chinese": "您有什么想尝试的主题吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:29:04",
            "content": "特に考えていませんでした",
            "Chinese": "我暂时没有特别考虑过。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:29:49",
            "content": "そうなんですね。いじめか引きこもりで設定していいですか?",
            "Chinese": "这样啊。那设定成霸凌或闭门不出的主题可以吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:30:12",
            "content": "はい。やってみましょう",
            "Chinese": "好的，我们试试吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:30:21",
            "content": "ではよろしくおねがいします",
            "Chinese": "那么请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:30:48",
            "content": "こんばんは。相談員です。差し支えなければ年齢と性別を教えてください",
            "Chinese": "晚上好。我是咨询员。如果方便的话，请告诉我您的年龄和性别。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:31:35",
            "content": "中1女子",
            "Chinese": "初一女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:32:12",
            "content": "教えていただきありがとうございます。今日はどの様なご相談ですか？",
            "Chinese": "谢谢您告诉我。今天想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:32:44",
            "content": "学校に行きたくない",
            "Chinese": "我不想上学。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:32:55",
            "content": "どうしたらいい?",
            "Chinese": "我该怎么办？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:33:05",
            "content": "教えて欲しい",
            "Chinese": "希望能告诉我该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:33:17",
            "content": "そうなのですね。一緒に考えて行きましょう",
            "Chinese": "是这样啊。我们一起来想想办法吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:33:36",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:34:40",
            "content": "学校に行きたくないとのことだけど、何かきっかけになることがあったのかな？",
            "Chinese": "您说不想去学校，是有什么具体原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:34:58",
            "content": "給食の時間が嫌",
            "Chinese": "我讨厌午餐时间。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:35:12",
            "content": "嫌いなものが多い",
            "Chinese": "我不喜欢吃的东西很多。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:35:32",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:36:00",
            "content": "先生が残すのはダメって言うから食べているけど、本当は残したい",
            "Chinese": "老师说不可以剩饭，所以我硬着头皮吃，但其实很想剩下。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:36:41",
            "content": "うんうん。頑張ってたべているんだね。",
            "Chinese": "嗯嗯。你一直在努力吃下去啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:37:04",
            "content": "それは体のため",
            "Chinese": "那是为了身体好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:37:29",
            "content": "そう考えているのですね。",
            "Chinese": "你是这样想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:37:29",
            "content": "お母さんもいつも同じ事をいうから",
            "Chinese": "因为妈妈也总是说同样的话。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:37:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:37:59",
            "content": "給食は毎日の事だから憂うつになるよね",
            "Chinese": "午餐是每天都有的，所以会觉得很郁闷吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:38:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:39:04",
            "content": "でも、お母さんや先生がちゃんと食べないといけないというから、残さず食べようと",
            "Chinese": "但是因为妈妈和老师都说要好好吃饭，所以你就想着不能剩下，要努力吃完。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:39:13",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:39:19",
            "content": "努力しているのだね",
            "Chinese": "你一直在努力呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:39:47",
            "content": "でも、そのせいで遅くなる",
            "Chinese": "但因此我吃得很慢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:39:59",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:40:22",
            "content": "食べ終わるのが一番最後になる",
            "Chinese": "我总是最后一个吃完。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:40:58",
            "content": "そうなんだね。遅くなったら何か言ってくる人がいたりするのかな？",
            "Chinese": "这样啊。吃得慢的话，会有人说些什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:41:36",
            "content": "一部の男子何人かが言う",
            "Chinese": "有几个男生会说。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:42:20",
            "content": "そうなんだね。一生懸命たべているのに嫌な思いになってしまうよね",
            "Chinese": "这样啊。明明你已经很努力在吃，却还是会觉得很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:42:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:43:02",
            "content": "その男子には何をいわれるのかな？",
            "Chinese": "那些男生会对你说些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:44:01",
            "content": "「とろい」「ダサい」「明日から給食無しでいいと思います」",
            "Chinese": "“慢吞吞的”、“真土”、“我看你明天开始不用吃午餐了”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:44:51",
            "content": "えーそんなことを言ってくるんだ",
            "Chinese": "诶——他们居然会说这种话。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:45:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:45:27",
            "content": "それを言われてどんな気持ちになるの？",
            "Chinese": "听到这些，你心里是什么感受？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:45:54",
            "content": "嫌な気持ちになる",
            "Chinese": "感觉很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:47:05",
            "content": "そうだよね。一生懸命嫌いなものも食べているのにそんな事を言われるなんて",
            "Chinese": "是啊。明明很努力地在吃不喜欢的东西，却被说这种话。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:47:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:47:26",
            "content": "嫌な気持ちになって当たり前だと思うよ",
            "Chinese": "会觉得难受是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:47:38",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:48:08",
            "content": "何か言い返したりしたの？",
            "Chinese": "你有没有反驳过什么？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:48:18",
            "content": "何も言わないよ",
            "Chinese": "我什么都不说。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:48:49",
            "content": "だって先生も他の子も笑ってるし",
            "Chinese": "因为老师和其他同学也都在笑。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:49:26",
            "content": "そうなんだね。嫌な思いになったけど、何もいわなかったんだね。苦しいね。",
            "Chinese": "这样啊。你心里很难受，但什么都没说呢。一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:49:41",
            "content": "仕方ないから、一緒に私も笑ってる",
            "Chinese": "没办法，我也只好跟着一起笑。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:50:15",
            "content": "先生も他の子も笑ってるなんて…",
            "Chinese": "老师和其他同学居然也在笑……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:50:28",
            "content": "人気ある子達だし、先生も気にいってるから",
            "Chinese": "因为他们是受欢迎的学生，老师也很喜欢他们。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:50:28",
            "content": "ひどいね",
            "Chinese": "太过分了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:50:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:50:55",
            "content": "言われるのはそんな感じ",
            "Chinese": "大概就是被说这些话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:51:54",
            "content": "そうなんだね。すごく悲しい気持ちになるね",
            "Chinese": "是这样啊。听起来真的很让人伤心呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:52:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:53:03",
            "content": "あなたの事をなんてお呼びしたらいいですか？",
            "Chinese": "请问该怎么称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:53:19",
            "content": "なみです",
            "Chinese": "我叫奈美。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:53:33",
            "content": "ありがとうございます。",
            "Chinese": "谢谢你。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:54:05",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:54:22",
            "content": "なみさんはこのことをおうちの人にお話しましたか？",
            "Chinese": "奈美，这件事你有和家里人说过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:54:44",
            "content": "話さない",
            "Chinese": "没说。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:54:58",
            "content": "お母さんに知られたくない",
            "Chinese": "我不想让妈妈知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:55:50",
            "content": "うんうん。じゃあ一人で悲しい気持ちを抱えているんだね",
            "Chinese": "嗯嗯。那你一直一个人扛着这种难过的心情啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:56:00",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:56:23",
            "content": "今日は話してもらってありがとう",
            "Chinese": "谢谢你今天愿意告诉我这些。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:56:36",
            "content": "いえ",
            "Chinese": "不客气。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:57:13",
            "content": "勇気をだしてくれたんだね",
            "Chinese": "你鼓起了很大的勇气呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:57:29",
            "content": "うん…",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 20:58:32",
            "content": "さっきお母さんには知られたくない　ていってたけど、何か理由なあるのかな？",
            "Chinese": "你刚才说不想让妈妈知道，是有什么原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 20:59:42",
            "content": "私が心配かけるような事を言うと、すぐ学校に連絡してしまう",
            "Chinese": "只要我说会让她担心的事情，她就会立刻联系学校。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 21:01:09",
            "content": "そうだったんだね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 21:01:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 21:01:50",
            "content": "この給食時間の出来事はいつ頃からなの？",
            "Chinese": "午餐时间的这件事是从什么时候开始的？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 21:02:26",
            "content": "連休明け位",
            "Chinese": "大概是长假之后。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 21:02:59",
            "content": "そっか。毎日のように言ってくるの？",
            "Chinese": "这样啊。他们几乎每天都说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 21:03:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 21:04:34",
            "content": "後、時々けられる",
            "Chinese": "而且，有时候还会被踢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 21:04:58",
            "content": "そんなことまで…",
            "Chinese": "居然还做这种事……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 21:05:15",
            "content": "ひどいよ",
            "Chinese": "太过分了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 21:05:29",
            "content": "蹴られるのは毎日じゃないから…",
            "Chinese": "但也不是每天都被踢……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 21:06:14",
            "content": "一回でも蹴るなんて絶対にしてはいけないことだよ",
            "Chinese": "哪怕只有一次，踢人也是绝对不可以做的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 21:06:34",
            "content": "しかも男子が女子に",
            "Chinese": "更何况是男生对女生。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 21:07:16",
            "content": "でもやめてとか言ったらもっとひどくなりそうで怖い",
            "Chinese": "但如果我说‘别这样’，可能会变得更严重，所以很害怕。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 21:07:46",
            "content": "それに笑いながらけってくるから、冗談かも",
            "Chinese": "而且他们是笑着踢的，可能是在开玩笑吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 21:08:05",
            "content": "そう思っているんだね。",
            "Chinese": "你是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/29(火) 21:08:06",
            "content": "その時は先生はいないけど",
            "Chinese": "不过那时老师不在场。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/29(火) 21:08:14",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
