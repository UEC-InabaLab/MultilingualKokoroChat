{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 17:57:35",
            "content": "こんばんは。よろしくお願いします。",
            "Chinese": "晚上好。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:01:57",
            "content": "(すいません。遅くなりました。）こんばんは、相談員です。年齢、性別、相談内容を教えていただけますか。",
            "Chinese": "（不好意思，我来晚了。）晚上好，我是咨询师。可以告诉我您的年龄、性别和想咨询的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:02:28",
            "content": "(大丈夫ですよ。よろしくお願いします)",
            "Chinese": "（没关系。麻烦您了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:02:47",
            "content": "（ありがとうございます。）",
            "Chinese": "（谢谢您。）"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:03:39",
            "content": "17歳女居場所がありません",
            "Chinese": "17岁，女，没有我的容身之处。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:04:15",
            "content": "そうなんですね。もう少し詳しく教えてもらえますか。",
            "Chinese": "是这样啊。可以再详细说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:05:02",
            "content": "えっとどう説明したらいいのかわかんないです",
            "Chinese": "那个……我不知道该怎么说。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:05:07",
            "content": "すいません",
            "Chinese": "对不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:05:35",
            "content": "いいえ、あやまらなくて大丈夫ですよ。",
            "Chinese": "没关系，不用道歉的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:07:26",
            "content": "居場所がないという事ですが、学校や家庭で何かあったのですか？",
            "Chinese": "您说没有容身之处，是在学校或家里发生了什么事吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:09:10",
            "content": "話せる範囲からでいいですよ。",
            "Chinese": "从您方便说的部分开始说就好。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:09:52",
            "content": "家だと空気悪いし、学校は友達がいないです",
            "Chinese": "家里气氛很差，在学校又没有朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:10:14",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:12:01",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:13:13",
            "content": "家で空気が悪いという事ですが、どうしてそう思われるのでしょうか？",
            "Chinese": "您说家里气氛很差，为什么会有这样的感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:13:51",
            "content": "仲が悪いからです。",
            "Chinese": "因为关系不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:14:20",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:16:03",
            "content": "仲が悪いというのは、誰と誰が悪いんですか？",
            "Chinese": "您说的关系不好，是指谁和谁的关系不好呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:16:42",
            "content": "母と姉です",
            "Chinese": "我妈妈和我姐姐。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:17:05",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:19:37",
            "content": "そういう状況だと家に居たくなくなることもありますよね。",
            "Chinese": "在那种情况下，确实会不想待在家里呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:20:01",
            "content": "はい。自分はいない方がいいんじゃないかと思っています",
            "Chinese": "是的。我甚至觉得，也许没有我比较好。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:20:47",
            "content": "そのように思われているんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:22:32",
            "content": "ご家族はお母さんとお姉さんとあなたの３人暮らしですか？",
            "Chinese": "您是和妈妈、姐姐三个人一起住吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:22:50",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:23:04",
            "content": "あと近くに祖母がいます",
            "Chinese": "另外，奶奶也住在附近。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:23:24",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:26:31",
            "content": "あなたは、お母さんとお姉さんが仲良くなればいいと思われているんでしょうね。",
            "Chinese": "您应该希望妈妈和姐姐能相处得好吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:27:43",
            "content": "いえ。どっちの意見も気持ちが分かるので仕方ないかなと思っています。おかしいですかね？",
            "Chinese": "不是的。两边的想法和心情我都能理解，所以觉得这也是没办法的事。这样很奇怪吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:29:07",
            "content": "いいえ、おかしくないですよ。あなたは両方の気持ちがわかるんですね。",
            "Chinese": "不，一点也不奇怪。您能理解双方的心情呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:33:00",
            "content": "なんとなくですけど",
            "Chinese": "只是大概的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:34:52",
            "content": "それでも、両方の気持ちがわかるのは、あなたが家族思いなんですね。",
            "Chinese": "即便如此，能理解双方的心情，说明您很为家人着想呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:35:48",
            "content": "そうなんですかね。間に挟まれて2人の意見を聞いているからかもしれません",
            "Chinese": "是这样吗？也许是因为我夹在中间，听着她们两方的意见吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:38:36",
            "content": "それもあるかもしれませんが、あなたが家族の事を思って話を聞いているからだと思いますよ。",
            "Chinese": "可能也有这个原因，但我想更是因为您关心家人，才会去倾听她们说话。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:38:54",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:40:25",
            "content": "学校では友達がいないという事ですが、どのように過ごされていますか。",
            "Chinese": "您说在学校没有朋友，那您在学校都是怎么过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:40:46",
            "content": "本を読んでいます",
            "Chinese": "我就看书。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:41:03",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:42:45",
            "content": "学校に行くのが辛いとか、そういうことはありますか？",
            "Chinese": "会觉得去上学很痛苦之类的吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:43:24",
            "content": "できたら行きたくないです。",
            "Chinese": "可以的话，我不想去。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:44:14",
            "content": "そう思われているんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:44:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:45:10",
            "content": "それでも、頑張って学校に通っているんですね。",
            "Chinese": "即使如此，您还是努力坚持去上学了呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:45:33",
            "content": "家にいたくないなら行ってるだけです",
            "Chinese": "只是因为不想待在家里才去的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:45:58",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:48:27",
            "content": "家にいたくない気持ちがあるのも当然ですよね。",
            "Chinese": "不想待在家里的这种心情也是很正常的呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:48:43",
            "content": "そうなんですかね？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:50:21",
            "content": "居心地が悪いと、そう思うのではないでしょうか。",
            "Chinese": "因为待着不舒服，所以才会这么想，不是吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:50:37",
            "content": "そうですね",
            "Chinese": "说得也是。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:52:57",
            "content": "あなたとしては、両方の意見もわかるという事ですが、できれば仲良くなってほしいと思われているんじゃないですかね。",
            "Chinese": "您虽然能理解两边的意见，但或许内心还是希望她们能和好相处吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:53:15",
            "content": "わからないです。",
            "Chinese": "我也不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:54:12",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:56:33",
            "content": "家が気をつかわず、安心できる場所になるといいですよね。",
            "Chinese": "如果家能成为一个不用顾虑太多、可以安心待着的地方就好了呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:56:59",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 18:58:34",
            "content": "あなたの事を応援していますので、何かあったらいつでも相談に来てくださいね。",
            "Chinese": "我会支持您的，如果有什么事，随时都可以来找我聊。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 18:59:05",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 19:00:24",
            "content": "貴重なお話を聞かせていただきありがとうございました。今日はこれで終わりにさせていただいてよろしいでしょうか。",
            "Chinese": "感谢您愿意和我分享这些宝贵的事情。今天先到这里可以吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/21(木) 19:01:54",
            "content": "今日はこれで終わりにさせていただきます。終了メッセージを送らせていただきます。",
            "Chinese": "那今天就先到这里。我这就给您发送结束信息。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/21(木) 19:02:01",
            "content": "はい",
            "Chinese": "好的。"
        }
    ],
