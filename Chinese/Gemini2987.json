        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:39:28",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:39:38",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:39:59",
            "content": "山田さんも同じ様に無視している感じですか",
