{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 12:53:51",
            "content": "「本日よろしくお願いいたします。」",
            "Chinese": "“今天请多多关照。”"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 12:55:56",
            "content": "よろしくお願いします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 12:56:48",
            "content": "何かリクエスト希望あれば気軽に相談してくださいね宜しくお願い致します。",
            "Chinese": "如果有任何请求或希望，请随时向我咨询。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 12:57:31",
            "content": "「時間になりましたら始めますね宜しくお願い致します。」",
            "Chinese": "“时间到了我们就开始吧。请多关照。”"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 12:57:49",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 12:57:53",
            "content": "よろしくお願いします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 12:58:12",
            "content": "こちらこそよろしくお願いします",
            "Chinese": "我也请您多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:00:30",
            "content": "本日は相談に来てくれてありがとうございます。はじめに年齢、性別、宜しくお願い致します。",
            "Chinese": "感谢您今天前来咨询。首先，请告诉我您的年龄和性别。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:00:50",
            "content": "１６歳　男です",
            "Chinese": "16岁，男。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:01:35",
            "content": "ありがとうございます。本日の相談内容と呼んでも大丈夫なお名前も宜しくお願い致します。",
            "Chinese": "谢谢您。也请告诉我今天想咨询的内容，以及我可以怎么称呼您。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:02:40",
            "content": "山田です。学校ですぐ感情的になる人がいて悩んでます。",
            "Chinese": "我叫山田。学校里有个人很容易情绪化，这让我很困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:03:14",
            "content": "山田さん相談ありがとうございます。",
            "Chinese": "山田先生，感谢您的咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:04:21",
            "content": "学校で感情的になる人がいてその人のことで相談に来られたんですね",
            "Chinese": "是因为学校里有一个容易情绪化的人，您为此事而来咨询的，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:04:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:05:07",
            "content": "その方についてもう少し詳しく聴いても大丈夫ですか",
            "Chinese": "我可以再详细了解一下关于那个人的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:06:10",
            "content": "はい！急に怒りだしたり、話もしていないのに話しに割り込んできたりします",
            "Chinese": "好的！他会突然发火，而且我们明明没在跟他讲话，他也会插话进来。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:06:23",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:07:04",
            "content": "急に話に割り込んできてしまう人がいるんですね",
            "Chinese": "原来有个人会突然插话进来啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:07:32",
            "content": "はい、周りの人も変なやつだと言っていて",
            "Chinese": "是的，周围的人也都说他是个怪人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:07:38",
            "content": "急に怒り出されるとビックリしませんでしたか",
            "Chinese": "他突然发火的时候，您没吓一跳吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:07:50",
            "content": "ビックリします",
            "Chinese": "会吓一跳。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:08:35",
            "content": "そうですよね急にだとよりビックリしたりすると思うので",
            "Chinese": "是啊，突然发生的话会更让人吓一跳。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:09:05",
            "content": "その人は同じクラスの人ですか",
            "Chinese": "那个人是同班同学吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:09:19",
            "content": "同じクラスです",
            "Chinese": "是同班同学。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:09:32",
            "content": "そうなんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:09:58",
            "content": "今まで話したりすることはありましたか",
            "Chinese": "您之前和他交谈过吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:10:46",
            "content": "クラスメイトなので、話しかけられたらするくらいです。仲が凄いいいわけでもないです、、、",
            "Chinese": "因为是同班同学，所以也只有在他主动搭话时才会说上几句。我们的关系也并非特别好……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:10:58",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:11:39",
            "content": "急に怒ったり、大きな声を",
            "Chinese": "他会突然生气，或者大声……"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:11:44",
            "content": "出されると",
            "Chinese": "说话的时候……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:11:53",
            "content": "その人は普段からよく人の話に入ってくる人ですか",
            "Chinese": "他平时就是个经常插话的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:11:54",
            "content": "ビクビクしちゃうんです",
            "Chinese": "我就会变得提心吊胆。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:12:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:12:24",
            "content": "他の人と話してる時に",
            "Chinese": "在和别人说话的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:12:32",
            "content": "ビクビクしちゃいますよね",
            "Chinese": "是啊，确实会让人提心吊胆呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:12:37",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:12:41",
            "content": "自分の話をしてきます",
            "Chinese": "他就会开始讲自己的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:12:51",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:13:15",
            "content": "誰の話でも入ってきちゃうんですか",
            "Chinese": "无论是谁在说话，他都会插话进来吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:13:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:13:24",
            "content": "みてると",
            "Chinese": "我看……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:13:33",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:13:39",
            "content": "その時感心を持った人に",
            "Chinese": "他好像是对当时感兴趣的人……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:13:46",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:13:53",
            "content": "行ってる感じがします",
            "Chinese": "感觉他就会凑过去。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:14:03",
            "content": "そうなんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:14:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:14:44",
            "content": "その人はクラスに友達や仲良くしてる人はいますか",
            "Chinese": "那个人在班里有朋友或关系好的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:15:48",
            "content": "よく、1人でいるのをみますが、、、多分。自分から無理やり、話しにいくので",
            "Chinese": "我经常看到他一个人……不过大概是因为他会硬凑过去跟人说话，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:16:13",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:16:15",
            "content": "誰かしらとはいるのは、みます",
            "Chinese": "所以也能看到他跟某个人待在一起。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:16:22",
            "content": "そうな",
            "Chinese": "是这样……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:16:41",
            "content": "そうなんですね。失礼いたしました。",
            "Chinese": "是这样啊。不好意思，我失言了。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:17:07",
            "content": "でも",
            "Chinese": "但是，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:17:15",
            "content": "誰かしらとはいるんですね",
            "Chinese": "就是说他还是会和某些人待在一起的，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:17:16",
            "content": "やっぱり他の人も",
            "Chinese": "果然其他人也……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:17:23",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:17:25",
            "content": "嫌そうです",
            "Chinese": "看起来都很不喜欢他。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:17:36",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:18:10",
            "content": "その人嫌われてるの自分で気づいてはいない感じですか",
            "Chinese": "感觉他自己并没有意识到自己被讨厌了，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:18:53",
            "content": "どうなんでしょうか？一度、急に大声をだしたので",
            "Chinese": "这个我就不清楚了。有一次，他突然大声嚷嚷，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:19:15",
            "content": "大声ですか",
            "Chinese": "大声嚷嚷吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:19:18",
            "content": "そんな事したら嫌われるよって、",
            "Chinese": "我跟他说，“你这样做会被人讨厌的哦”，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:19:26",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:19:32",
            "content": "勇気を出して",
            "Chinese": "鼓起勇气……"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:19:44",
            "content": "言ったんですが",
            "Chinese": "这么说了，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:19:46",
            "content": "言ってあげたんですか",
            "Chinese": "您还特意告诉他了吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:19:50",
            "content": "は？",
            "Chinese": "“哈？”"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:19:57",
            "content": "みたいな感じで",
            "Chinese": "就是那种反应。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:20:20",
            "content": "反応がちょっと怖いですよね",
            "Chinese": "这个反应有点吓人呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:20:24",
            "content": "わかってなさそうでした",
            "Chinese": "他看起来好像没明白。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:20:38",
            "content": "周りのお友達大丈夫でしたか",
            "Chinese": "周围的朋友还好吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:21:02",
            "content": "他の人が、先生にも言ったみたいなんですが",
            "Chinese": "好像其他人也跟老师说过了，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:21:20",
            "content": "わかってないのが一番迷惑ですよね",
            "Chinese": "他不自知这一点是最让人困扰的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:21:20",
            "content": "その子は、変わらないです",
            "Chinese": "那个人一点也没变。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:21:29",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:21:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:21:58",
            "content": "注意されても変わらないのは困りますよね",
            "Chinese": "被人提醒了也不改，这确实很伤脑筋呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:22:22",
            "content": "はい、困るし、ちょっと",
            "Chinese": "是的，既伤脑筋，又有点……"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:22:27",
            "content": "怖いです",
            "Chinese": "害怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:23:13",
            "content": "ちょっと、いやだいぶ変わっていますし怖いですよね",
            "Chinese": "有点……不，是相当奇怪，所以会感到害怕吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:23:34",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:23:55",
            "content": "頻繫にあるなら余計にそうだと思うので",
            "Chinese": "如果这种事经常发生，我想就更会这么觉得了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:24:37",
            "content": "クラスでそのことについて話し合いとかは難しそうですか",
            "Chinese": "在班级里就这件事进行讨论，会很困难吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:25:27",
            "content": "そうですね。先生に言ってもなにもしてくれないですし。無視してる人達も多い",
            "Chinese": "是的。跟老师说了也没用。很多人也都在无视他。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:25:30",
            "content": "ので",
            "Chinese": "所以……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:25:41",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:25:43",
            "content": "難しいと思います。。。",
            "Chinese": "我觉得很难……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:26:09",
            "content": "それは、とても困りましたね",
            "Chinese": "那真是很伤脑筋了。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:26:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:26:54",
            "content": "他にクラスで困ったことはありますか",
            "Chinese": "在班级里还有其他让您困扰的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:28:04",
            "content": "他には特にないです",
            "Chinese": "其他倒没什么特别的了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:28:21",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:29:03",
            "content": "その子の親御さんはどんなかたかは知りませんか",
