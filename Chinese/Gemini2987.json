        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:30:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:30:46",
            "content": "急に怒って来るのは、どんな話の時がおおいでしょうか",
            "Chinese": "他突然发火，大多是在谈论什么样的话题时呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:32:54",
            "content": "うるさいとか、なんか気にいらない事があったのか",
            "Chinese": "可能是嫌吵，或者有什么事让他不爽了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:33:05",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:33:18",
            "content": "思うようにならないからなのか",
            "Chinese": "也可能是因为事情没有如他所愿。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:33:29",
            "content": "そんな時が多いんですね",
            "Chinese": "这种情况比较多是吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:33:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:34:10",
            "content": "いわゆる自己中心的な人なんでしょうか",
            "Chinese": "他是那种所谓的以自我为中心的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:34:36",
            "content": "そうですね。なんか、空気よめないやつ",
            "Chinese": "是的。就是那种，不会察言观色的家伙。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:34:39",
            "content": "みたいな",
            "Chinese": "类似这种。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:34:42",
            "content": "感じです",
            "Chinese": "感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:35:13",
            "content": "大変ですねそれは、周りが",
            "Chinese": "那周围的人可就辛苦了。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/18(火) 13:35:49",
            "content": "そうなんです",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:35:57",
            "content": "クラスでどうしようもないみたいですし",
            "Chinese": "而且在班级里好像也拿他没办法。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/18(火) 13:36:29",
            "content": "余計に大声出されても困りますし",
