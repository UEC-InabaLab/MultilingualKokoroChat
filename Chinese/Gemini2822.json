{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 13:51:02",
            "content": "本日はよろしくお願いいたします",
            "Chinese": "今天请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 13:52:15",
            "content": "お時間になりましたら始めさせていただきます。",
            "Chinese": "时间到了我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 13:57:23",
            "content": "よろしくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:01:16",
            "content": "こんにちわ相談員です。本日はありがとうございます。始めに年齢と性別を教えていただけますでしょうか。",
            "Chinese": "您好，我是咨询师。感谢您今天花时间前来。首先，可以告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:01:32",
            "content": "14　男",
            "Chinese": "14岁，男。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:02:11",
            "content": "ありがとうございます。本日はどのようなご相談でしょうか",
            "Chinese": "谢谢。今天您有什么想咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:02:18",
            "content": "テストがだるいです",
            "Chinese": "考试好烦啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:02:53",
            "content": "テストがだるいのですね。わかります",
            "Chinese": "觉得考试很烦是吗？我明白。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:03:43",
            "content": "もう時期テストが近いのでしょうか",
            "Chinese": "是不是快要考试了？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:04:04",
            "content": "そろそろですかね",
            "Chinese": "差不多吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:04:36",
            "content": "今は何年生でしょうか",
            "Chinese": "你现在是几年级呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:04:47",
            "content": "中２",
            "Chinese": "初二。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:05:23",
            "content": "中2なのですね。勉強にたいへんですか",
            "Chinese": "原来是初二啊。学习很辛苦吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:05:33",
            "content": "それなりに",
            "Chinese": "还行吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:06:12",
            "content": "なるほど。もうテストが勉強しているのでしょうか",
            "Chinese": "原来如此。考试已经在学习了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:06:30",
            "content": "テストが勉強しているとは",
            "Chinese": "“考试在学习”是什么意思？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:06:47",
            "content": "テスト勉強の間違いです",
            "Chinese": "是“备考”的口误。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:07:00",
            "content": "ごめんなさいね",
            "Chinese": "不好意思啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:07:08",
            "content": "ぼちぼち",
            "Chinese": "就陆陆续续地在学吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:08:23",
            "content": "テストがだるいということですが、何が一番いやと思っていることとかありますか",
            "Chinese": "你说觉得考试很烦，那最讨厌的是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:08:32",
            "content": "全部です",
            "Chinese": "全部。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:09:12",
            "content": "全部なのですね。それは勉強のことだけでしょうか",
            "Chinese": "全都是啊。那只是指学习方面吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:09:33",
            "content": "どういう意味でしょうか",
            "Chinese": "什么意思？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:09:50",
            "content": "他にあるんですか",
            "Chinese": "还有别的吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:10:24",
            "content": "勉強がだるいという事以外になにかあるのかなと思いまして",
            "Chinese": "我是想，除了觉得学习很烦之外，是不是还有别的原因呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:10:48",
            "content": "わかりませんね",
            "Chinese": "不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:11:58",
            "content": "そうなのですね。わからないのですね。わからないということはどういう意味なのでしょうか",
            "Chinese": "是这样啊。你不太清楚是吗？这个“不太清楚”是什么意思呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:12:26",
            "content": "そのままの意味ですけど",
            "Chinese": "就是字面意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:13:05",
            "content": "なるほど、勉強が苦手なのかな？",
            "Chinese": "原来如此，是不是不太擅长学习呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:13:31",
            "content": "どうなんでしょうね",
            "Chinese": "谁知道呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:13:38",
            "content": "多分そうなんじゃないですか",
            "Chinese": "大概是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:13:59",
            "content": "うんうん。そうなのですね。",
            "Chinese": "嗯嗯，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:15:02",
            "content": "勉強するのが嫌い？",
            "Chinese": "讨厌学习吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:15:18",
            "content": "まあ嫌いっちゃ嫌いです。",
            "Chinese": "嗯，要说讨厌也算是讨厌吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:16:32",
            "content": "そうですよね。なかなか好きな人少ないとかもしれないですよね。何か好きな事ありますか",
            "Chinese": "是啊。可能喜欢学习的人确实不多吧。你有什么喜欢做的事情吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:17:16",
            "content": "少ないですよね。です",
            "Chinese": "确实不多呢。是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:17:40",
            "content": "なんで急にその質問になったんですか",
            "Chinese": "为什么突然问这个问题？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:19:41",
            "content": "勉強が嫌い、でも何か得意な事とかあるならどんなことなのかなと思いまして",
            "Chinese": "我是想，虽然你讨厌学习，但会不会有什么擅长的事情呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:20:42",
            "content": "得意なことと好きなことって違くないですか",
            "Chinese": "擅长的事和喜欢的事不一样吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:21:00",
            "content": "不自然すぎます",
            "Chinese": "太不自然了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:23:01",
            "content": "まさに、そのとうり。言葉がうまく表現できなくてごめんなさいね得意って書きたかったのです",
            "Chinese": "确实，你说得对。我没能好好表达，不好意思，我本来想说的是“擅长”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:24:03",
            "content": "相談員がこれでは駄目ですね。ごめんなさいね",
            "Chinese": "作为咨询师这样可不行呢。不好意思啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:24:22",
            "content": "いや、自虐されてもこっちが困るんですけど",
            "Chinese": "呃，你这样自嘲，我这边也很为难啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:24:46",
            "content": "あなたの事情はどうでも良いです",
            "Chinese": "我不在乎你的情况。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:26:42",
            "content": "はい。そのとうりです。テストがだるいって言ってましたが、学校は行ってますか。",
            "Chinese": "好的，你说得对。你说考试很烦，那你平时去上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:26:52",
            "content": "はい",
            "Chinese": "去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:31:33",
            "content": "行ってるのですね。先ほど勉強がだるい以外何かあるのか分からないとおっしゃていましたが、今日のお悩みは勉強がだるいということ、のみでしょうか",
            "Chinese": "你有去上学是吧。刚才你说除了觉得学习烦之外，也不清楚还有没有别的原因，那今天的烦恼就只是“觉得学习很烦”这一点吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:32:37",
            "content": "多分",
            "Chinese": "大概吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:34:03",
            "content": "そうなのですね。勉強がだるいというのは、わかります。ほんとにだるいとおもいますよね。",
            "Chinese": "是这样啊。我明白觉得学习很烦的感觉。确实会觉得很没劲，对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:35:03",
            "content": "中2なら周りから、勉強のことを言われることが多いのではないでしょうか",
            "Chinese": "上初二的话，周围的人会经常跟你提学习的事情吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:35:27",
            "content": "どうしてそうなるんですか",
            "Chinese": "为什么会这么说？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:35:33",
            "content": "意味がわかりません",
            "Chinese": "我不明白。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:37:12",
            "content": "言われたこととかないでしょうか？",
            "Chinese": "没有人对你说过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:37:24",
            "content": "ありませんよ",
            "Chinese": "没有啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:37:32",
            "content": "何決めつけてるんですか",
            "Chinese": "你凭什么擅自下定论？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:40:09",
            "content": "決めつけた質問に感じましたか？",
            "Chinese": "让你觉得我的问题很武断吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:40:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:42:43",
            "content": "そうなのですね。勉強がどうしてだるいと思われているのでしょうか",
            "Chinese": "是这样啊。那你为什么会觉得学习很烦呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:43:13",
            "content": "どうしてと言われても自分でもわかりません",
            "Chinese": "你问我为什么，我自己也不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:44:40",
            "content": "普段はどれくらいの時間、家で勉強していますか",
            "Chinese": "你平时在家大约学习多长时间呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:45:03",
            "content": "少しくらい",
            "Chinese": "就一小会儿吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:45:43",
            "content": "少しって何時間？何分くらいなのでしょうか",
            "Chinese": "“一小会儿”是几个小时？还是几分钟呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:46:36",
            "content": "どうしても言わないとダメですか",
            "Chinese": "非得说不可吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:47:12",
            "content": "大丈夫です。言いたくないことは言わなくていいですよ。",
            "Chinese": "没关系的。不想说的事情可以不说的。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:47:21",
            "content": "じゃあいいです",
            "Chinese": "那就好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:48:54",
            "content": "テストがだるいって、どうだるいのか教えていただきたかったので、時間を聴いただけですから",
            "Chinese": "我只是想了解一下你说的“考试很烦”具体是怎样的一种烦，所以才问了时间。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:49:42",
            "content": "まず、あなたは何がしたいのですか？",
            "Chinese": "首先，你到底想做什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:51:04",
            "content": "あなたが何を言いたかったのか、そこがわからないので、聞きたかったのです。",
            "Chinese": "因为我不明白你想表达什么，所以才想问清楚。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:54:53",
            "content": "そろそろ時間なのでこれで失礼します",
            "Chinese": "时间差不多了，我先告辞了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:55:09",
            "content": "聴けなくて申し訳ありませんでした。ありがとうございます。",
            "Chinese": "没能好好倾听，非常抱歉。谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:56:59",
            "content": "次回またお話出来ればとおもいます。テスト頑張って下さい。では失礼いたします",
            "Chinese": "希望下次还有机会和您聊。考试加油。那么我先告辞了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:58:28",
            "content": "＊クライエント役ありがとうございました。離脱ですね。また評価よろしくお願いいたします",
            "Chinese": "*感谢您扮演来访者。您要离开了是吧。麻烦您之后给个评价。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/07(火) 14:58:37",
            "content": "失礼いたします",
            "Chinese": "我先告辞了。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/07(火) 14:58:40",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        }
    ],
