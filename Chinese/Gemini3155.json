{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 10:54:55",
            "content": "こんにちは。11時からよろしくお願い致します。",
            "Chinese": "您好。从11点开始，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 10:55:10",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:00:27",
            "content": "それでは始めます。",
            "Chinese": "那么，我们开始吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:00:45",
            "content": "こんにちは、相談員です。",
            "Chinese": "您好，我是咨询员。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:01:55",
            "content": "こんにちわ",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:02:28",
            "content": "初めにあなたの年齢と性別を教えていただけますか？",
            "Chinese": "首先，能请您告知一下您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:02:42",
            "content": "状況が45歳です",
            "Chinese": "我今年45岁。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:02:51",
            "content": "女性です",
            "Chinese": "女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:03:02",
            "content": "教えてくださりありがとうございます",
            "Chinese": "感谢您的告知。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:03:45",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:04:01",
            "content": "転職先が決まらず悩んでます",
            "Chinese": "我因为找不到新工作而烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:04:27",
            "content": "それは悩ましいですね",
            "Chinese": "这确实很令人烦恼呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:04:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:05:16",
            "content": "どのような経緯で転職することになったのですか？",
            "Chinese": "您是出于什么原因决定换工作的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:05:34",
            "content": "体調がすぐれず転職しました",
            "Chinese": "因为身体状况不佳，所以换了工作。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:06:16",
            "content": "(転職することにしました)",
            "Chinese": "（是决定换工作了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:06:51",
            "content": "そうだったんですね",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:07:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:07:33",
            "content": "今までの職場ではしんどい思いをされてきたのですね",
            "Chinese": "看来您在之前的工作单位经历了很多辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:07:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:08:05",
            "content": "これからはもっと楽なところで働きたいですよね",
            "Chinese": "今后想在更轻松一点的地方工作，是吧？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:08:32",
            "content": "ええできればそうおもいまます",
            "Chinese": "嗯，如果可以的话，我也是这么想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:08:53",
            "content": "そうですよね今までは、どんなところがしんどかったですか？",
            "Chinese": "是啊。至今为止，工作的哪些方面让您觉得辛苦呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:09:17",
            "content": "２４時間営業なので夜勤がきつかったです",
            "Chinese": "因为是24小时营业，所以夜班很辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:10:11",
            "content": "そうだったんですね夜勤は身体にこたえますよね",
            "Chinese": "原来如此。夜班对身体的负担确实很重呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:10:27",
            "content": "ええそうですね",
            "Chinese": "是的，确实如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:12:11",
            "content": "それで、無理をされて体調を崩されたのですね",
            "Chinese": "所以您是因为勉强自己，才导致身体状况不佳的吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:12:20",
            "content": "今のお身体の具合はいかがでしょうか？",
            "Chinese": "请问您现在的身体状况如何呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:12:44",
            "content": "はい　そう思います。大分良くなりました。ありがとうございます。",
            "Chinese": "是的，我也是这么认为的。已经好很多了。谢谢您的关心。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:13:44",
            "content": "そうですか大分良くなったということで安心しました",
            "Chinese": "是吗？听到您好多了，我也就放心了。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:14:01",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:15:36",
            "content": "今は転職先が決まらないということですが",
            "Chinese": "您是说现在还没找到新工作，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:15:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:16:13",
            "content": "候補にあがっている所とかはありますでしょうか？",
            "Chinese": "有没有一些正在考虑的备选单位呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:16:45",
            "content": "履歴書送っても面接までいかないんです",
            "Chinese": "即使寄了简历，也进入不了面试阶段。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:17:35",
            "content": "書類審査が通らないということでしょうか？",
            "Chinese": "意思是说简历筛选没通过吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:17:42",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:17:53",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:18:02",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:19:06",
            "content": "それはがっかりしますよね",
            "Chinese": "那确实会让人很沮丧呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:19:14",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:19:30",
            "content": "募集要項とかと照らして問題なくてもなんですか？",
            "Chinese": "即使对照招聘要求来看没有问题，也是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:19:39",
            "content": "はいそうです",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:20:58",
            "content": "どうしてなんだろう？って思いますよね",
            "Chinese": "您也会想“这是为什么呢？”，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:21:13",
            "content": "ええ本当に、、",
            "Chinese": "嗯，真的是……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:21:48",
            "content": "お仕事はどちらで探されていますか？",
            "Chinese": "您主要通过哪些渠道找工作呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:22:07",
            "content": "ネットやハローワークです",
            "Chinese": "通过网络和公共职业介绍所。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:22:17",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:22:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:24:49",
            "content": "ハローワークでは担当者の方に相談されましたでしょうか？",
            "Chinese": "在公共职业介绍所，您和负责的工作人员商量过吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:25:00",
            "content": "はいしました",
            "Chinese": "是的，咨询过。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:25:49",
            "content": "そうなんですねどのようなお話をされましたか？",
            "Chinese": "是吗？都聊了些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:26:46",
            "content": "担当の人は今は若い人もかなり仕事探しているので応募要件にあっても年齢が難しいのかもって言ってました",
            "Chinese": "负责人说，现在找工作的年轻人也很多，所以即使符合应聘条件，年龄方面可能也比较困难。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:27:31",
            "content": "そうでしたか",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:27:37",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:30:45",
            "content": "そう言われたときどう思いましたか？",
            "Chinese": "听到这些话时，您是怎么想的？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:31:05",
            "content": "年齢は変えられないのでなんとも(笑)",
            "Chinese": "年龄是没法改变的，所以也无可奈何（笑）。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:31:20",
            "content": "そうですよね",
            "Chinese": "说得也是呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:31:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:33:28",
            "content": "でも、年齢のことを言っていられない人手不足の業種もあると思いますので",
            "Chinese": "但是，我想也有些行业因为人手短缺，顾不上年龄问题。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:33:42",
            "content": "そうですね",
            "Chinese": "这倒也是。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:35:12",
            "content": "どうやって、あなたとマッチングする所を見つけていくかですよね",
            "Chinese": "关键在于，如何才能找到与您匹配的岗位，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:35:26",
            "content": "はい　そうですね！",
            "Chinese": "是的，没错！"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:37:03",
            "content": "ハローワークの方のお話で、何かヒントになりそうなことはありませんでしたか？",
            "Chinese": "和公共职业介绍所的人交流时，有没有得到什么有用的提示呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:37:55",
            "content": "特には感じなかったですね、みんな忙しそうで、はい次、はい次みたいな感じでした",
            "Chinese": "倒也没什么特别的感觉，大家看起来都很忙，就是那种“好的，下一个，下一个”的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:38:13",
            "content": "そうだったんですか",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:38:19",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:38:25",
            "content": "ちょっとがっかりしますよね",
            "Chinese": "这会让人有些失望吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:38:46",
            "content": "そうなんです。頼りにならなくて",
            "Chinese": "是啊，感觉靠不住。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:40:17",
            "content": "いいアドバイスをもらえないとそう感じてしまいますよね",
            "Chinese": "得不到好的建议，确实会产生那样的感觉呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:40:29",
            "content": "はい　そうなんです",
            "Chinese": "是的，就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:40:55",
            "content": "民間の転職紹介機関には行かれたことはありますか？",
            "Chinese": "您去过民间的求职中介机构吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:41:40",
            "content": "はい　派遣にもとうろくはしています",
            "Chinese": "是的，我也在派遣公司注册了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:42:03",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:42:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:42:16",
            "content": "そこでは、どんな感じでしょうか？",
            "Chinese": "在那边情况怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:43:02",
            "content": "とりあえず書類預かりましょう、何かあったら連絡しますという感じです",
            "Chinese": "就是那种“我们先收下您的资料，有合适的职位再联系您”的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:43:58",
            "content": "そこでも、あまり相談に乗ってもらえなかったんですね",
            "Chinese": "在那边也没能好好地聊一聊，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:44:32",
            "content": "はい　そんな感じでした",
            "Chinese": "是的，就是那种感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:46:35",
            "content": "なかなか相談にのってもらえず、もどかしいですね",
            "Chinese": "一直得不到有效的咨询，真是令人着急又无奈啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:46:55",
            "content": "はい　本当に、困っちゃいます",
            "Chinese": "是的，真的很伤脑筋。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:47:43",
            "content": "そうですよね困ってしまいますよね",
            "Chinese": "是啊，确实会很困扰呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:48:06",
            "content": "ところで、あなたはどんなお仕事を探されていますか？",
            "Chinese": "另外，您在找什么样的工作呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:48:50",
            "content": "とりあえず夜勤がなくて立ち仕事でないものです",
            "Chinese": "首先是没有夜班，并且不是站着做的工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:49:29",
            "content": "身体に負担がかからないお仕事がいいですよね",
            "Chinese": "对身体负担小的工作比较好，是吧？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:49:45",
            "content": "ええ　年齢が年齢なので",
            "Chinese": "嗯，毕竟到这个年纪了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:52:11",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:52:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:55:40",
            "content": "お給料とかには拘りがありますか？",
            "Chinese": "对薪水方面有什么特别的要求吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:55:56",
            "content": "いいえ、特には",
            "Chinese": "不，没什么特别的要求。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:56:06",
            "content": "そうなんですね",
            "Chinese": "了解了。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/18(金) 11:56:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/18(金) 11:56:53",
