{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 20:51:43",
            "content": "相談者役をさせていただきます。よろしくお願いします。",
            "Chinese": "我来扮演来访者的角色。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 20:52:01",
            "content": "（　 こんばんは。　カウンセラー役です。　）（　本日は、２１時からロープレよろしくお願いします。　）",
            "Chinese": "（晚上好。我扮演咨询师的角色。）（今天从21点开始进行角色扮演，请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 20:52:21",
            "content": "（よろしくお願いします。）",
            "Chinese": "（请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 20:52:43",
            "content": "（よろしくお願いします。）",
            "Chinese": "（请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:00:20",
            "content": "はじめまして相談員です。こんばんは。相談しに来てくださりありがとうございます。はじめに年齢と性別を教えてもらえますか。",
            "Chinese": "初次见面，我是咨询师。晚上好。感谢您前来咨询。首先，可以告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:00:32",
            "content": "25歳　女性",
            "Chinese": "25岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:00:49",
            "content": "教えていただき、ありがとうございます。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:00:55",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:01:18",
            "content": "本日ご相談になりたいことについて、教えていただけますか？",
            "Chinese": "今天您想咨询的内容，可以和我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:01:36",
            "content": "心身の不調",
            "Chinese": "身心不适。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:01:43",
            "content": "きついです",
            "Chinese": "很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:02:18",
            "content": "心身の不調ですね。具体的に、もう少し教えていただけますか。",
            "Chinese": "是身心方面的不适，对吗？可以再具体一点告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:02:45",
            "content": "職場がきついです",
            "Chinese": "工作单位让我很难受。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:03:02",
            "content": "気が抜けない",
            "Chinese": "一刻都不敢放松。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:03:17",
            "content": "職場がきつくて、おつらいんですね。",
            "Chinese": "工作很辛苦，让您感到很难受，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:03:27",
            "content": "まあ、はい",
            "Chinese": "嗯，算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:04:05",
            "content": "気が抜けない、というのは、人間関係のことでしょうか？それともお仕事の内容でしょうか？",
            "Chinese": "您说“一刻都不敢放松”，是指人际关系方面吗？还是工作内容方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:04:30",
            "content": "両方",
            "Chinese": "两方面都有。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:05:02",
            "content": "両方なんですね。それは、しんどいですよね。",
            "Chinese": "两方面都有啊。那一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:05:08",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:05:42",
            "content": "お仕事で、どんな時にきついと感じられるのでしょうか。",
            "Chinese": "在工作中，您在什么情况下会觉得辛苦呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:06:10",
            "content": "パワハラが日常で",
            "Chinese": "职场霸凌已成为日常。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:06:20",
            "content": "ええ、",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:06:29",
            "content": "頼れる先輩は辞めるし",
            "Chinese": "可以依靠的前辈也辞职了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:06:49",
            "content": "そうなんですね。。",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:06:51",
            "content": "人が抜けて仕事がきついです",
            "Chinese": "人手不足，工作很辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:07:41",
            "content": "それは、本当に仕事的にも人間関係的にもきついですね。",
            "Chinese": "那样的话，无论在工作上还是人际关系上都确实很难熬呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:07:52",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:08:24",
            "content": "パワハラを行うのは、上司でしょうか？それとも同僚、部下でしょうか？",
            "Chinese": "进行霸凌的是上司吗？还是同事、下属呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:08:43",
            "content": "職場全体かな",
            "Chinese": "大概是整个职场的氛围吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:09:05",
            "content": "職場全体なんですね。。。",
            "Chinese": "是整个职场啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:09:29",
            "content": "先程、心身の不調とのことでしたが、",
            "Chinese": "刚才您提到身心不适，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:09:52",
            "content": "お身体の具合は、いかがでしょうか。",
            "Chinese": "您的身体状况如何呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:10:05",
            "content": "良くないです",
            "Chinese": "不太好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:10:40",
            "content": "そうですよね。食欲とか、睡眠は、いかがでしょう。",
            "Chinese": "是的。您的食欲和睡眠情况如何呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:10:58",
            "content": "食べるけど美味しくないし",
            "Chinese": "虽然能吃但食之无味，"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:11:03",
            "content": "眠れない",
            "Chinese": "也无法入睡。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:11:53",
            "content": "ええ、そうでしたか。。それが、長く続くと身体も心もきつくなりますよね。",
            "Chinese": "嗯，是这样啊……如果长期这样，身心都会很难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:12:07",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:12:22",
            "content": "いつ頃から、体調が悪くなってきたのでしょうか。",
            "Chinese": "大概从什么时候开始，您的身体状况变差的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:12:40",
            "content": "2ヶ月ぐらい前から",
            "Chinese": "大约两个月前开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:13:03",
            "content": "そうなんですね。教えていただき、ありがとうございます。",
            "Chinese": "是这样啊。谢谢您告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:13:09",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:13:43",
            "content": "2ヶ月ぐらい前から、とのことですが、なにかきっかけでもあったのでしょうか。",
            "Chinese": "您说大约是两个月前开始，有什么契机吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:14:07",
            "content": "パワハラが怖くて",
            "Chinese": "因为害怕职场霸凌，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:14:26",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:14:29",
            "content": "でもせっかく就職できたから",
            "Chinese": "但好不容易才找到工作，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:14:39",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:14:52",
            "content": "頑張ってきたけど",
            "Chinese": "一直在撑着努力，"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:15:04",
            "content": "報われない",
            "Chinese": "却得不到回报。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:15:35",
            "content": "はい、報われないと、そう感じていらっしゃるんですね。",
            "Chinese": "嗯，您感觉自己的努力没有得到回报，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:15:49",
            "content": "疲れた",
            "Chinese": "太累了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:16:32",
            "content": "そんなに、おつらい状況なのに、今日こうしてご相談にきてくれたんですね。",
            "Chinese": "在如此艰难的处境下，您今天仍前来咨询，真的很不容易。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:16:41",
            "content": "まあ、、",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:17:36",
            "content": "報われないなと感じるのは、どういった時になるのでしょうか。",
            "Chinese": "您感到“得不到回报”通常是在什么情况下呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:17:57",
            "content": "いつもです",
            "Chinese": "一直都是。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:19:05",
            "content": "そうでしたか。。パワハラがひどい状況ならば、あなたがそのように感じるのも無理がないことだと思います。",
            "Chinese": "是这样啊……在职场霸凌如此严重的情况下，您有这样的感受是很自然的。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:19:47",
            "content": "疲れてよくわからないし、",
            "Chinese": "太疲惫了，很多事情都理不清，"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:20:00",
            "content": "もうどうしていいかわからない",
            "Chinese": "也不知道该怎么办了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:20:21",
            "content": "ええ、そうなんですね。",
            "Chinese": "嗯，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:21:27",
            "content": "本日のご相談内容は、パワハラが怖くて、でもせっかく就職できたから頑張ってきたけど報われない、それをどうすればいいか、ということで合っていますでしょうか？",
            "Chinese": "今天想要咨询的是：一方面害怕职场霸凌，但又因为好不容易就业而一直在努力，却得不到回报；想知道该怎么办。这样的理解对吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:21:50",
            "content": "というか",
            "Chinese": "或者说，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:21:58",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:22:04",
            "content": "よくわからないから",
            "Chinese": "因为我什么都搞不清楚了。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:22:08",
            "content": "いろいろと",
            "Chinese": "各种事情……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:22:40",
            "content": "色々とよくわからない感じなんですね。",
            "Chinese": "您现在感到很多事情都理不清头绪呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:22:43",
            "content": "これからどうしていいか考えられないし、",
            "Chinese": "甚至无法思考接下来该怎么办，"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:22:49",
            "content": "消えたくなる",
            "Chinese": "有时真想消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:23:42",
            "content": "はい、消えたくなるとは、死んでしまいたいというお気持ちがあるのでしょうか？",
            "Chinese": "您说“想消失”，是否意味着有轻生的念头呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:24:02",
            "content": "ときどき思います",
            "Chinese": "偶尔会这么想。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:24:36",
            "content": "そうでしたか、おつらい状況の中、これまで頑張ってこられたんですね。",
            "Chinese": "是这样啊，在如此艰难的处境中，您一直坚持到现在真的很不容易。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:25:08",
            "content": "今は、死にたいというお気持ちになられていますか？",
            "Chinese": "那此刻，您有想要轻生的念头吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:25:48",
            "content": "生きている意味がわからない",
            "Chinese": "我不知道活着的意义。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:26:25",
            "content": "生きている意味がわからない、そのようにお考えになっているんですね",
            "Chinese": "您现在感到“不明白活着的意义”，是这样想的吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:27:09",
            "content": "もしよかったら、私と一緒に、",
            "Chinese": "如果您愿意的话，能否和我一起，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:27:55",
            "content": "なぜ死なないほうがいいのか、というテーマについて、考えてみませんか？",
            "Chinese": "思考一下“为什么不应该选择死亡”这个主题呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:28:51",
            "content": "そんなこと言われても、",
            "Chinese": "就算您这么说……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:29:02",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:29:02",
            "content": "わからない。",
            "Chinese": "我还是不明白。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:29:23",
            "content": "ええ、そうですよね。",
            "Chinese": "嗯，是啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:30:10",
            "content": "やっぱり一人でやっていくしかないですよね。",
            "Chinese": "果然还是只能一个人扛下去吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:31:12",
            "content": "そのようにお考えになっていらしゃるんですね。",
            "Chinese": "您是这样认为的呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:31:27",
            "content": "失礼ですが、ご家族は、いらっしゃいますか？",
            "Chinese": "冒昧问一下，您有家人吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:32:02",
            "content": "両親がいるけど連絡は取ってないです",
            "Chinese": "父母还在，但没有联系。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:32:34",
            "content": "そうなんですね。教えていただき、ありがとうございます。",
            "Chinese": "是这样啊。谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:33:24",
            "content": "つらい状況にいらっしゃると思うのですが、ご両親に相談してみよう、という気持ちにはなれないですよね。",
            "Chinese": "我想您正处在很辛苦的状况中，可能也不太想试着和父母谈谈，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:33:43",
            "content": "あんまり話したくない",
            "Chinese": "不太想跟他们说。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:34:53",
            "content": "たしかに、パワハラとか、つらいとかは、なかなか両親であっても相談しづらいですよね。",
            "Chinese": "确实，像职场霸凌这样痛苦的事情，即使是父母也很难开口倾诉呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:35:29",
            "content": "もともと疎遠だし",
            "Chinese": "本来关系就很疏远。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:35:58",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:37:27",
            "content": "それでも、もしあなたが自死で亡くなったら、あなたを大切に想っているすべての人、そしてあなたに関わる多くの人が、自死の日を境に、暗くて重たい、想像を絶する痛みを強制的に持たされることになる、と思うのですが、いかがですか。",
            "Chinese": "即便如此，如果您选择轻生，所有珍视您的人以及与您相关的大多数人，都将从您离世那天起，被迫承受一种黑暗、沉重、难以想象的痛苦。关于这点，您怎么看？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:38:18",
            "content": "それって私以外の人のことだけ言ってますよね？",
            "Chinese": "您这说的，好像只是在谈论我以外的人，对吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:39:16",
            "content": "そうですね。ここは、あなた以外のことを話しています。",
            "Chinese": "是的，这里我说的是除您之外的事情。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:39:46",
            "content": "私の話を聞いてくれるところではないんですか？",
            "Chinese": "这里不是听我倾诉的地方吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:40:56",
            "content": "もちろん、あなたのことが中心です。今のは、例として話をさせていただきました。不快にさせてしまい、申し訳ないです。",
            "Chinese": "当然，您是中心。刚才那段只是举个例子。让您感到不舒服，非常抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:41:37",
            "content": "先が見えないし",
            "Chinese": "看不到未来，"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:42:12",
            "content": "眠れないし",
            "Chinese": "也睡不着，"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:42:33",
            "content": "限界です",
            "Chinese": "已经到极限了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:42:34",
            "content": "あなたは、そんな先が見えない、つらい状況でもこれまで頑張ってこられたんですよね。",
            "Chinese": "即使在这样看不到希望的艰难处境中，您一直坚持到现在，真的很不容易。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:43:03",
            "content": "よくわからない",
            "Chinese": "我也说不清。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:43:42",
            "content": "そうなんですね。今一番のお悩みは、眠れないことによる、体調不良なのでしょうか。",
            "Chinese": "是这样啊。现在最困扰您的是因为失眠导致的身体不适吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:44:07",
            "content": "だからわからない",
            "Chinese": "都说了我不清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:44:41",
            "content": "そうですか、わからないんですね。。。",
            "Chinese": "这样啊，确实很难理清……"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:45:04",
            "content": "コロナ禍で先が見えないし",
            "Chinese": "疫情之下前景也看不清，"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:45:16",
            "content": "会社もどうなるかわからないし",
            "Chinese": "公司将来会怎样也不知道，"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:45:47",
            "content": "疲れた",
            "Chinese": "太累了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:45:58",
            "content": "ええ、色々なことが不安なんですね。",
            "Chinese": "嗯，很多事情都让您感到不安。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:46:25",
            "content": "睡眠不足で、頭が回らない、あまり考えられない、とかそんな感じなのでしょうか？",
            "Chinese": "是不是因为睡眠不足，脑子转不动、很难思考，类似这样的感觉？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:47:01",
            "content": "通勤中にふらっとしたり",
            "Chinese": "通勤时会突然头晕，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:47:13",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:47:33",
            "content": "いつも頭が働かない",
            "Chinese": "总是无法集中精神。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:48:02",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:48:30",
            "content": "心がちょっと疲れているのかもしれませんね。",
            "Chinese": "也许心也有些疲惫了。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:49:14",
            "content": "限界",
            "Chinese": "到极限了。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:49:21",
            "content": "消えたい",
            "Chinese": "想消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:49:50",
            "content": "ええ、そんな限界な感じなんですね。病院には、もう通院されましたか？",
            "Chinese": "嗯，您有一种到了极限的感觉啊。您已经去医院就诊了吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:49:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:50:31",
            "content": "主治医の先生は、何と仰っていますでしょうか。",
            "Chinese": "您的主治医生是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:51:27",
            "content": "うつの傾向があると言われました",
            "Chinese": "医生说我有抑郁倾向。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:51:58",
            "content": "そうなんですね。そんな個人情報を教えていただき、ありがとうございます。",
            "Chinese": "是这样啊。感谢您愿意告诉我这些个人情况。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:52:44",
            "content": "それでは、今は、抑うつの薬や睡眠導入剤などを服用されているのでしょうか？",
            "Chinese": "那么，现在您有在服用抗抑郁药或助眠药之类的吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:53:35",
            "content": "はい",
            "Chinese": "有。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:55:29",
            "content": "そうでしたか。服用は、２週間くらい続けてみて、合わないようならば、先生に伝えて薬を変えることをしたほうがいいかもしれませんね。医師ではないので、詳しいことはわからないのですが。",
            "Chinese": "是这样啊。您可以先持续服用两周左右，如果觉得不合适，最好和医生沟通换药。当然，我不是医生，所以无法给出专业建议。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:57:46",
            "content": "もうわからない",
            "Chinese": "我已经不知道了。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:57:51",
            "content": "どうしていいか",
            "Chinese": "该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:58:08",
            "content": "ええ、そうなんですね。",
            "Chinese": "嗯，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 21:58:34",
            "content": "まずは、主治医の指示に従ったほうがいいと思いますが、いかがでしょうか。",
            "Chinese": "我想首先还是遵从主治医生的指示比较好，您觉得如何？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 21:59:47",
            "content": "はい、、",
            "Chinese": "好的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 22:00:01",
            "content": "そろそろお時間となりますが、今日は、ご相談されてみて、いかがでしたでしょうか。",
            "Chinese": "时间差不多了，今天咨询下来，您感觉怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 22:00:25",
            "content": "疲れました",
            "Chinese": "觉得累了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 22:00:47",
            "content": "そうでしたか、お力になれず申し訳ないです。",
            "Chinese": "是这样啊，没能帮上您的忙，非常抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 22:00:57",
            "content": "いいです",
            "Chinese": "没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 22:01:09",
            "content": "お話を聞かせていただき、ありがとうございました。今日はこのあたりにしたいと思うのですが、いかがでしょうか？",
            "Chinese": "感谢您的倾诉。今天我想就先到这里，您觉得可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 22:01:16",
            "content": "わかりました",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 22:01:34",
            "content": "カウンセリングは、これで終わりになりますが、もしかすると、またいつか、ひどく気分が落ち込んでしまったとか、そんな困ったことがあるかもしれません。そんなときは遠慮なく、また、いらしてください。",
            "Chinese": "本次咨询就到这里。将来如果有一天心情特别低落，或者遇到其他困扰，请不要犹豫，随时再来。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 22:01:44",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 22:01:45",
            "content": "それでは、「終了メッセージ」をお送りします",
            "Chinese": "那么，我将为您发送“结束信息”。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/03/22(火) 22:01:57",
            "content": "（ロープレありがとうございました。）",
            "Chinese": "（感谢参与角色扮演。）"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 22:01:58",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2022/03/22(火) 22:02:15",
            "content": "（ありがとうございました）",
            "Chinese": "（非常感谢。）"
        }
