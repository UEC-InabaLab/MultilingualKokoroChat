        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:38:01",
            "content": "20才の夫婦では本当大変だったと想像します、",
            "Chinese": "我能想象，20岁的小夫妻当时一定非常辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:38:50",
            "content": "そうですよね、貴方の言われるようにしんどかったでしょうね。",
            "Chinese": "是啊，正如您所说，想必当时一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:39:10",
            "content": "あとは母との関係性ですかね、、",
            "Chinese": "还有就是和妈妈的关系吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:39:21",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:39:39",
            "content": "どんな関係でしょうか？",
            "Chinese": "是怎样的关系呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:39:44",
            "content": "反対を押し切って結婚しましたから、",
            "Chinese": "因为她是不顾母亲的反对结的婚，"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:40:07",
            "content": "でも支援を受けていましたよ、",
            "Chinese": "但后来也接受了家里的支援。"
