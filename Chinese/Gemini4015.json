        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:53:09",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:53:39",
            "content": "子どものころから気に入られようと頑張っていたのだなと、",
