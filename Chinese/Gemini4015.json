            "role": "クライアント",
            "time": "2022/09/22(木) 11:01:40",
            "content": "きっとそうですね、、",
            "Chinese": "大概是吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 11:01:53",
