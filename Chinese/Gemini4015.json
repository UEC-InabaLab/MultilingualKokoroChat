        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:34:19",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:34:24",
            "content": "気に入らないのでしょう、、",
            "Chinese": "她应该是看不惯我吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:34:37",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:34:59",
            "content": "はい、",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:36:21",
            "content": "子育てされていた、時代も環境も違うとお聞きしましたが、具体的にはどのような違いなんでしょうか？",
            "Chinese": "您提到养育孩子的时代和环境都不同，具体来说有哪些差异呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:37:22",
            "content": "10年違うのと地域が違います、あとは収入ですかね、、",
