{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 09:53:01",
            "content": "（おはようございます。今日はよろしくお願いします。）",
            "Chinese": "（早上好。今天请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 09:53:19",
            "content": "よろしくお願いします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 09:53:42",
            "content": "（時間前ですが、定時からスタートしますか？）",
            "Chinese": "（虽然还没到时间，但要从预定时间开始吗？）"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 09:53:59",
            "content": "お任せします。",
            "Chinese": "听您的安排。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 09:54:37",
            "content": "（それでは、これかこら１時間でお願いします。）",
            "Chinese": "（好的，那么接下来一个小时，拜托了。）"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 09:54:48",
            "content": "了解しました。",
            "Chinese": "明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 09:55:35",
            "content": "おはようございます。相談員です。まず初めによろしかったら年齢、性別、相談内容についてお聞かせ下さい。",
            "Chinese": "早上好。我是咨询员。首先，如果方便的话，请您告诉我您的年龄、性别，以及咨询的内容。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 09:56:18",
            "content": "おはようございます、40代、女性です、相談内容は、",
            "Chinese": "早上好，我四十多岁，女性，想咨询的内容是……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 09:56:29",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 09:56:41",
            "content": "姉との関係についてです、",
            "Chinese": "是关于我和姐姐的关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 09:58:25",
            "content": "そうなんですね。お姉さまとの関係ということで、具体的にはどのようなことでご相談でしょうか？",
            "Chinese": "这样啊。您说是关于和姐姐的关系，具体是想咨询哪方面的问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 09:59:11",
            "content": "4つ上に姉がいるのですが、最近疎遠にしています、",
            "Chinese": "我有一个大我四岁的姐姐，最近我们变得有些疏远了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 09:59:22",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 09:59:34",
            "content": "もうお互い大人なので、",
            "Chinese": "毕竟我们都已经是成年人了，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 09:59:42",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 09:59:50",
            "content": "ベタベタする必要はありませんが、",
            "Chinese": "虽然也没必要总是黏在一起，"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:00:04",
            "content": "このままでいいのかな、",
            "Chinese": "但总会想，这样下去真的好吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:00:05",
            "content": "そう思われていらっしゃるのですね。",
            "Chinese": "您是这么想的呀。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:00:28",
            "content": "とたまに思ったりします、",
            "Chinese": "偶尔会这么想。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:00:39",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:00:45",
            "content": "はい、",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:01:45",
            "content": "それは、気になられますよね。このままでいいのかなと思われますよね。",
            "Chinese": "这确实会让人在意呢。会想“这样下去真的好吗”。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:01:56",
            "content": "はい、",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:02:43",
            "content": "いつ頃からそのようにお感じになられたのでしょうか？",
            "Chinese": "您是从什么时候开始有这种感觉的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:03:12",
            "content": "この数日です、",
            "Chinese": "就是这几天。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:03:29",
            "content": "明日、兄夫婦が遊びに来るので、",
            "Chinese": "因为明天我哥和嫂子要来玩，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:03:39",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:03:44",
            "content": "思い出しました、",
            "Chinese": "我就想起了这件事。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:03:54",
            "content": "そうなんですね。",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:03:58",
            "content": "はい、",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:05:04",
            "content": "お姉さんとの間でそのように感じられる何かきっかになるようなことは、ございましたか？",
            "Chinese": "您和姐姐之间，有没有发生过什么事，成为了您产生这种感觉的契机呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:05:48",
            "content": "はい、今年の新年の集まりで、",
            "Chinese": "有的，在今年新年聚会的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:05:57",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:06:20",
            "content": "酔っ払って子どもたちの前でおでこを叩かれました。",
            "Chinese": "她喝醉了，当着孩子们的面敲了我的额头。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:06:51",
            "content": "姉は冗談のつもりだと思うのですが、",
            "Chinese": "我想姐姐应该只是开个玩笑，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:07:08",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:07:22",
            "content": "とても腹が立ち、それから距離を取っています、",
            "Chinese": "但我非常生气，从那之后就和她保持着距离。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:08:05",
            "content": "そんな事が、おありだったのですね。それは、腹が立ちますよね。",
            "Chinese": "原来发生过那样的事啊。那确实会很生气呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:08:11",
            "content": "はい、",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:09:19",
            "content": "どうしてお姉さまは、そのような事をされたか、考えられると事は、おありですか？",
            "Chinese": "您认为姐姐为什么会那么做呢？您有没有想过可能的原因？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:09:59",
            "content": "母から聞いた話しですが、",
            "Chinese": "我是听我妈说的，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:10:07",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:10:54",
            "content": "わたしが冗談で旦那のことを悪く言ったことに対してツッコミを入れたと、、",
            "Chinese": "（她说）是因为我开玩笑地说了我丈夫的坏话，她才“吐槽”我的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:11:10",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:11:12",
            "content": "わたしの旦那のことなのに、",
            "Chinese": "明明是我自己的丈夫，"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:11:23",
            "content": "何が悪いのか、",
            "Chinese": "这有什么不对的吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:11:41",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:13:06",
            "content": "その話をお母さまからお聞きになられて、どんなお気持ちになられましたか？",
            "Chinese": "当您从母亲那里听到这些之后，您心里是什么感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:13:31",
            "content": "自分のことを棚に上げて、",
            "Chinese": "（我觉得）她这是严于律人，宽于待己，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:13:38",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:13:42",
            "content": "とさらに腹が立ちました、",
            "Chinese": "我就更生气了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:15:27",
            "content": "そう思われたのですね。自分の事を棚に上げてとお聞きしましたが、お姉さまも旦那さんの事を、お母さまに話されていらしゃるのでしょうか？",
            "Chinese": "您是这样想的啊。您刚才说她“严于律人，宽于待己”，是指姐姐也会跟母亲说她丈夫的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:16:32",
            "content": "姉は旦那さんに頭が上がらないので、悪くいいません、",
            "Chinese": "姐姐很怕她丈夫，所以不会说他的坏话。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:16:52",
            "content": "そうなんですね。",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:17:11",
            "content": "でも、他の人、自分が気に入らない人に対しては全否定します、",
            "Chinese": "但是，对于其他人，尤其是她看不顺眼的人，她会全盘否定。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:17:28",
            "content": "そうなんですか。",
            "Chinese": "是这样吗。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:18:17",
            "content": "それは、貴方としては、納得いかないですよね。",
            "Chinese": "这在您看来，确实是难以接受的吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:18:32",
            "content": "はい、",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:19:04",
            "content": "ご兄弟は、何人でいらしゃるのでしょうか？",
            "Chinese": "您家兄弟姐妹一共有几位呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:19:27",
            "content": "３人兄妹です",
            "Chinese": "我们兄妹三人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:20:23",
            "content": "そうでらっしゃるんですね。お兄さまとは、どのような関係でいらしゃるのでしょうか？",
            "Chinese": "是这样啊。那您和哥哥的关系怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:20:41",
            "content": "私ですか？",
            "Chinese": "我吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:20:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:21:02",
            "content": "良好です、",
            "Chinese": "关系很好。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:21:25",
            "content": "兄はあまり自己主張しないタイプなので、",
            "Chinese": "哥哥是不太爱表达自己想法的类型，"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:22:04",
            "content": "いつも中立でいたがります、",
            "Chinese": "总是想保持中立。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:22:04",
            "content": "そうなんですね。お兄さまとお姉さまの関係は、どのような感じでいらしゃるのでしょうか？",
            "Chinese": "这样啊。那哥哥和姐姐的关系怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:22:22",
            "content": "兄はシスコンです、",
            "Chinese": "我哥是个“姐控”。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:22:36",
            "content": "姉には服従しています、",
            "Chinese": "对姐姐言听计从。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:23:01",
            "content": "昔からそうでしたね、",
            "Chinese": "从小时候起就是这样了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:23:06",
            "content": "そうなんですね。それは、貴方としては、やりきれないですよね。",
            "Chinese": "是这样啊。对您来说，这确实让人感到无奈吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:23:51",
            "content": "そうですね、、",
            "Chinese": "是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:24:14",
            "content": "そう思います。",
            "Chinese": "我理解您的感受。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:25:34",
            "content": "貴方と、お姉さまのこういった関係は、いつ頃からそう感じられるようになられたのでしょうか？",
            "Chinese": "您和姐姐的这种关系，是从什么时候开始让您有这种感觉的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:26:08",
            "content": "わたしが結婚してからですかね、、",
            "Chinese": "应该是我结婚之后吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:26:27",
            "content": "そうなんですか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:26:37",
            "content": "独身のころは可愛がってくれていました、",
            "Chinese": "我单身的时候，她还挺疼我的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:26:50",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:26:59",
            "content": "甥っ子たちともよく遊びましたし、",
            "Chinese": "我也经常和外甥们一起玩，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:27:12",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:27:17",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:28:42",
            "content": "貴方のご結婚が、お姉さまにどのような影響があられたとお感じになりますか？",
            "Chinese": "您觉得您的婚姻，对姐姐产生了什么样的影响呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:28:58",
            "content": "そうですね、、",
            "Chinese": "这个嘛……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:29:06",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:29:27",
            "content": "わたしと姉は真逆の人生を歩んでいるように感じています、",
            "Chinese": "我感觉我和姐姐走在截然相反的人生道路上。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:29:46",
            "content": "そう思われていらっしゃるのですね。",
            "Chinese": "您是这么想的呀。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:29:56",
            "content": "彼女は20才でできちゃった結婚",
            "Chinese": "她20岁奉子成婚，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:30:14",
            "content": "そうなんですね。",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:30:35",
            "content": "わたしは31才で式を挙げて結婚",
            "Chinese": "而我，是31岁才举办婚礼结婚的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/09/22(木) 10:30:55",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/09/22(木) 10:31:19",
            "content": "はい、",
