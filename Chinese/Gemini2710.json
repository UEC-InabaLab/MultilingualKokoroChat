{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:01:44",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:04:24",
            "content": "こんにちは。",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:04:37",
            "content": "遅くなってしまい申し訳ありません。",
            "Chinese": "让您久等了，十分抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:04:41",
            "content": "今日はよろしくおねがいします",
            "Chinese": "今天就拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:04:53",
            "content": "よろしくお願い致します。",
            "Chinese": "也请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:05:07",
            "content": "早速始めさせていただきますね。",
            "Chinese": "那么我们马上开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:05:12",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:05:26",
            "content": "こんにちは。相談員です。",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:05:53",
            "content": "初めに年齢と性別を伺っても良いでしょうか？",
            "Chinese": "首先，可以请教您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:06:14",
            "content": "48歳 女です。",
            "Chinese": "48岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:06:31",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:06:49",
            "content": "今日はどういった相談でお越しになられましたか？",
            "Chinese": "今天您是想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:07:09",
            "content": "転職の事で相談に来ました。",
            "Chinese": "我是来咨询关于换工作的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:07:20",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:07:41",
            "content": "今日はあなたのありのままのお気持ちを話していただければと思います。",
            "Chinese": "今天希望您能畅所欲言，说出真实的想法。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:07:54",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:08:12",
            "content": "とんでもございません。",
            "Chinese": "不客气。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:08:42",
            "content": "転職はいつごろから考えておられますか？",
            "Chinese": "您是从什么时候开始考虑换工作的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:09:10",
            "content": "１０年程前です。",
            "Chinese": "大约是10年前。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:09:19",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:09:25",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:09:32",
            "content": "それは何かきっかけがあったのですか？",
            "Chinese": "是有什么契机吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:10:22",
            "content": "１０年前に自営をしまして１０年後には辞めたいと決めてました。",
            "Chinese": "10年前我开始自己经营事业，当时就决定了10年后要辞掉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:10:41",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:10:48",
            "content": "でも辞めたら生活はしていかなくてはいけませんし",
            "Chinese": "但如果不做了，生活还是得继续下去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:10:55",
            "content": "えぇ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:11:11",
            "content": "かといって働かない訳にもいかず",
            "Chinese": "但也不能不工作。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:11:32",
            "content": "また新たに自営をと…。",
            "Chinese": "所以想着要不要再重新开始自己创业…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:11:38",
            "content": "そう思い悩んでおられたのですね。",
            "Chinese": "原来您一直在为此烦恼啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:11:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:12:20",
            "content": "新しい自営のお仕事は何か具体的に決まっているのでしょうか？",
            "Chinese": "关于新的创业工作，有什么具体的计划了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:13:50",
            "content": "そうですね。まだはっきりとはしてないのですが、家でできる仕事がしたいんですね。",
            "Chinese": "嗯，还没有很明确，但我想做可以在家做的工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:14:07",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:14:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:15:01",
            "content": "今のお仕事は家でできないということなのでしょうか？",
            "Chinese": "也就是说，您现在的工作无法在家进行，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:15:42",
            "content": "できません。今の仕事は接客業なので。",
            "Chinese": "不能，因为现在的工作是接待服务行业。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:15:55",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:16:06",
            "content": "必ず対面です",
            "Chinese": "必须是面对面的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:16:17",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:17:27",
            "content": "家でできる仕事をしたいと思うきっかけとかはあったのですか？",
            "Chinese": "想做可以在家做的工作，是有什么契机吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:18:48",
            "content": "両親が年老いていき病気で在宅に近い状況なので、できれば家でできたらと思ってます。",
            "Chinese": "父母年事已高，因病需要居家照顾，所以希望能在家工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:19:04",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:19:09",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:19:33",
            "content": "そういった状況でしたら、家で仕事ができた方がいいですね。",
            "Chinese": "在这种情况下，能在家工作确实会更好呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:19:44",
            "content": "そうなんです。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:19:55",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:20:27",
            "content": "具体的に次のお仕事に向けて何か準備などはされていますか？",
            "Chinese": "为了下一份工作，您具体有在做什么准备吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:21:15",
            "content": "まだこれからです。準備はしてません。",
            "Chinese": "还没有，还没开始准备。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:21:37",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:22:31",
            "content": "何処をリサーチすれば良いのかもわかりませんし、思いだけが先に進むんです。",
            "Chinese": "我也不清楚该从哪里着手调研，只有想法在往前跑。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:22:49",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:23:11",
            "content": "気持ちと状況が追いついていないと焦ってしまいますよね。",
            "Chinese": "当心情和实际情况跟不上的时候，会感到很焦虑吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:23:50",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:24:19",
            "content": "何かアドバイスをくれそうな人は周りにいそうですか？",
            "Chinese": "您身边有能给您一些建议的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:24:53",
            "content": "周りにはいません。",
            "Chinese": "身边没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:25:07",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:25:48",
            "content": "それは思い悩んでしまいますね。",
            "Chinese": "那确实会让人烦恼呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:27:09",
            "content": "はい、在宅ワークは、やった事がないので、不安ですから。",
            "Chinese": "是的，因为我没做过在家办公的工作，所以很不安。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:27:27",
            "content": "そうですか。",
            "Chinese": "这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:27:43",
            "content": "やったことがないとさらに不安にもなりますよね。",
            "Chinese": "没做过的话确实会更不安呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:27:43",
            "content": "不安というよりも成功するかしないか…でしょうか。",
            "Chinese": "与其说是不安，不如说是担心能不能成功吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:27:57",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:28:32",
            "content": "成功というのはどういう状況になると成功したと思われますか？",
            "Chinese": "您认为什么样的情况算是成功呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:28:43",
            "content": "収入です",
            "Chinese": "收入。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:28:52",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:29:12",
            "content": "利益があり粗利が出るですね。",
            "Chinese": "就是有利润，能产生毛利。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:29:40",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:30:15",
            "content": "今の状態とどれくらい差があると思われますか？",
            "Chinese": "您觉得和现在的状态有多大差距呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:31:15",
            "content": "何の差でしょうか?",
            "Chinese": "什么样的差距呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:32:02",
            "content": "言葉足らずで申し訳ありません。",
            "Chinese": "抱歉我表达不够清楚。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:32:08",
            "content": "いえいえ",
            "Chinese": "不会不会。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:32:17",
            "content": "詳しく聞きたいので",
            "Chinese": "我想详细了解一下。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:32:26",
            "content": "成功したと思える収入と現状の差ということです。",
            "Chinese": "我是指您认为成功的收入和现状之间的差距。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:33:08",
            "content": "それはやった事がないので想像はつきませんね…。",
            "Chinese": "这个因为没做过，所以也想象不出来呢…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:33:18",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:34:35",
            "content": "一度計算して数値化すると具体的なプランが見えるかなと思ったのですが、どう思われますか？",
            "Chinese": "我想如果计算一下，用数值来表示，或许能看到更具体的计划，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:34:39",
            "content": "自営は掛けみたいなものですしやはり、やってみないとわからないんですよね～。",
            "Chinese": "自己创业就像一场赌博，不试试看是不会知道的～"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:34:49",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:35:17",
            "content": "やってみないとわからないことって多いですものね。",
            "Chinese": "的确有很多事情不亲自尝试是不会明白的呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:35:33",
            "content": "一度計算して数値化とは例えばどんな事ですか?教えて下さい。",
            "Chinese": "您说的“计算一下，用数值来表示”具体是指什么呢？可以告诉我吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:37:15",
            "content": "ざっくりとした計算ですが成功したと思われる収入ー現在の収入＝差となるので具体的な仕事内容を決める上で役に立つこともあるのかなと思ったのですがいかがですか？",
            "Chinese": "这是一个粗略的计算，就是您认为成功的收入减去现在的收入等于差额。我想这或许在决定具体工作内容时会有所帮助，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:38:24",
            "content": "そうですね。そんな方法もいいかもしれません。",
            "Chinese": "嗯，这个方法可能也不错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:40:24",
            "content": "何か考える上での着眼点の一つになればと思いますが、他にあなたがやってみようと思われることはありますか？",
            "Chinese": "如果这能成为您思考时的一个切入点就好了。除此之外，您还有其他想尝试的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:41:21",
            "content": "今の所、就職して通勤というのは考えていません。",
            "Chinese": "目前，我没有考虑找份工作然后通勤上班。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:41:46",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:41:55",
            "content": "両親の事を思うと、在宅ワークしか選択がないなと。",
            "Chinese": "考虑到父母的情况，我觉得只有在家工作这一个选项了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:42:14",
            "content": "そういうふうに考えておられるのですね。",
            "Chinese": "您是这样想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:42:23",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/13(土) 11:42:47",
            "content": "在宅ワークでどういった内容のお仕事を考えておられますか？",
            "Chinese": "对于在家工作，您考虑过什么样的工作内容呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/13(土) 11:42:55",
            "content": "いい年ですし次は親を守ってあげないといけません",
