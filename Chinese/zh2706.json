{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2021-11-12T20:00:14",
      "origin": "こんばんは。本日はロールプレイよろしくお願いします。",
      "content": "晚上好。今天的角色扮演，请多关照。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:00:31",
      "origin": "よろしくお願いします",
      "content": "请多关照。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:00:54",
      "origin": "では早速ロールプレイをお願い致します。",
      "content": "那么，我们马上开始角色扮演吧。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:01:21",
      "origin": "お願いします",
      "content": "好的，拜托了。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:01:25",
      "origin": "こんばんは。相談員です。本日はどういった相談でしょうか？",
      "content": "晚上好。我是咨询师。今天您想咨询什么呢？"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:01:40",
      "origin": "こんばんは",
      "content": "晚上好。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:01:50",
      "origin": "今日は友人との関係についてです",
      "content": "今天想谈谈我和朋友的关系。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:01:50",
      "origin": "こんばんは。",
      "content": "晚上好。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:02:10",
      "origin": "そうなのですね。友人関係でお悩みなのですね。",
      "content": "原来如此。您在为朋友关系而烦恼呢。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:02:15",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:02:19",
      "origin": "喧嘩をしました",
      "content": "我们吵架了。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:03:10",
      "origin": "どういったところでしんどさを感じておられるのか伺ってもよろしいでしょうか？",
      "content": "可以请您谈谈，是哪些方面让您感到困扰吗？"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:03:46",
      "origin": "はい",
      "content": "好的。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:03:55",
      "origin": "先週なのですが",
      "content": "是上周的事。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:04:07",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:04:10",
      "origin": "友人とカフェでお話しをしておりまして",
      "content": "我和朋友在咖啡馆聊天，"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:04:19",
      "origin": "えぇ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:04:44",
      "origin": "お互いの仕事への価値観の話をしていました",
      "content": "我们聊了彼此对工作的价值观。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:05:11",
      "origin": "そうでしたか",
      "content": "是这样啊。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:05:21",
      "origin": "その友人は少し手を抜いてもいいという考えがあります",
      "content": "那位朋友认为工作上可以稍微偷点懒也没关系。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:05:50",
      "origin": "そうなのですね",
      "content": "是这样啊。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:06:13",
      "origin": "私は仕事をしっかりしないといけないとおもい",
      "content": "而我认为工作就应该踏踏实实做好，"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:06:22",
      "origin": "そこで意見の言い合いがはじまりました",
      "content": "于是我们就开始争论起来。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:06:25",
      "origin": "えぇ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:07:08",
      "origin": "そこまだ深く話すつもりじゃなかったのですがだんだんと喧嘩のような会話になってしまい",
      "content": "本来没打算聊得那么深入，但渐渐地就变成了像吵架一样的对话，"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:07:22",
      "origin": "なるほど",
      "content": "我明白。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:07:28",
      "origin": "最終的にはもういいといい私が先に出て行ってしまいました",
      "content": "最后我说了句“算了”，然后就先走了。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:07:44",
      "origin": "後からいいすぎたとはおもっていたのですが",
      "content": "事后我也觉得话说得有点重了，"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:07:54",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:08:02",
      "origin": "連絡が取りづらい状態です",
      "content": "现在很难联系上对方。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:08:14",
      "origin": "なるほど",
      "content": "原来如此。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:08:44",
      "origin": "どうしていいのかわかりません",
      "content": "我不知道该怎么办才好。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:08:55",
      "origin": "そうですよね。",
      "content": "是啊，我能理解。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:09:23",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:09:35",
      "origin": "友達とはいえお互いの価値観の違いから生じた喧嘩ですから気まづい状態ですよね。",
      "content": "虽说是朋友，但因为彼此价值观不同而吵架，现在的状况一定很尴尬吧。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:09:43",
      "origin": "そうですね",
      "content": "是啊。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:10:02",
      "origin": "今日はあなたのありのままのお気持ちをお話しいただければと思います。",
      "content": "今天，希望您能坦率地聊聊您真实的想法。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:10:32",
      "origin": "ありがとうございます",
      "content": "谢谢您。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:10:44",
      "origin": "もちろんです。",
      "content": "不用客气。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:11:08",
      "origin": "そのご友人の方とはどういう風に付き合っていきたいとお考えですか？",
      "content": "您希望今后与那位朋友以怎样的方式相处呢？"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:11:33",
      "origin": "このまま切磋琢磨し、友人としても楽しめる関係を望んでいます",
      "content": "我希望能继续保持既能作为朋友愉快相处，又能互相切磋、共同进步的关系。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:11:45",
      "origin": "なるほど。",
      "content": "原来如此。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:12:11",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:12:24",
      "origin": "このまま、ということは以前から切磋琢磨し合う関係だったのですか？",
      "content": "您说“继续保持”，也就是说以前你们就是互相切磋、共同进步的关系吗？"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:12:42",
      "origin": "そうですねお互い職種が同じなので",
      "content": "是的，因为彼此的职业相同。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:12:58",
      "origin": "なるほど。そうでしたか。",
      "content": "原来如此，是这样啊。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:13:04",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:13:26",
      "origin": "あなたにとっても大切な存在だったのですね。",
      "content": "看来她对您来说也是一个很重要的存在呢。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:13:45",
      "origin": "そうですね",
      "content": "是的。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:14:02",
      "origin": "価値観以外は仲の良い関係だったと私はおもいます",
      "content": "我认为除了价值观不同之外，我们的关系一直很好。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:14:09",
      "origin": "なるほど。",
      "content": "原来如此。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:14:33",
      "origin": "交友関係も深いお付き合いだったのですね。",
      "content": "你们的交情很深厚呢。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:14:55",
      "origin": "学校で一番仲がよかったとおもいます",
      "content": "我想我们在学校时是关系最好的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:15:34",
      "origin": "そうでしたか。それは大切な存在ですね。",
      "content": "是这样啊。那真是个很重要的人呢。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:15:39",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:16:11",
      "origin": "以前に今回の喧嘩のようなものはありましたか？",
      "content": "以前有过类似这次的争吵吗？"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:16:29",
      "origin": "いえ、仕事の愚痴はありましたが喧嘩にはなりませんでした",
      "content": "没有，虽然会抱怨工作上的事，但没有吵过架。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:16:39",
      "origin": "そうでしたか。",
      "content": "是这样啊。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:16:48",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:17:03",
      "origin": "それでは今回がお二人にとって初めての喧嘩ということなのですね。",
      "content": "那么也就是说，这次是你们两人第一次吵架了。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:17:19",
      "origin": "大きな喧嘩はそうですね",
      "content": "嗯，这么大的争吵是第一次。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:17:30",
      "origin": "プライベートもここまではなかったです",
      "content": "私下里也没到过这种程度。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:17:45",
      "origin": "そうでしたか。",
      "content": "是这样啊。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:18:01",
      "origin": "それは心苦しい思いをされましたね。",
      "content": "那您心里一定很难受吧。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:18:26",
      "origin": "いいすぎましたが一番心に残ってます",
      "content": "虽然我说得过分了，但这件事一直让我耿耿于怀。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:18:46",
      "origin": "なるほど。",
      "content": "原来如此。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:19:03",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:19:10",
      "origin": "言いすぎたというのはどういうことを言ってしまったのか教えていただけますか？",
      "content": "您能告诉我，您说的“话说重了”是指说了些什么吗？"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:19:29",
      "origin": "その考え方ではだめだ",
      "content": "“你那种想法不行”，"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:19:30",
      "origin": "とか",
      "content": "之类的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:19:36",
      "origin": "えぇ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:19:37",
      "origin": "変えたほうがよいとか",
      "content": "还有“最好改一改”之类的，"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:19:47",
      "origin": "なるほど",
      "content": "原来如此。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:19:52",
      "origin": "それだと周りに迷惑がかける",
      "content": "“那样会给周围的人添麻烦”"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:19:55",
      "origin": "などでしょうか",
      "content": "大概就是这些吧。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:20:11",
      "origin": "そうなのですね。",
      "content": "是这样啊。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:20:24",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:21:15",
      "origin": "何に対して迷惑だとおっしゃられたのですか？",
      "content": "您是针对什么说会添麻烦的呢？"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:21:31",
      "origin": "その考えでは",
      "content": "是针对那种想法。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:21:37",
      "origin": "えぇ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:21:52",
      "origin": "適当な考えというか仕事はどれだけサボれるか",
      "content": "就是那种敷衍了事的想法，或者说，工作能偷懒就偷懒。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:21:55",
      "origin": "というかです",
      "content": "类似这样的想法。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:22:04",
      "origin": "なるほど",
      "content": "明白了。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:22:08",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:22:28",
      "origin": "仕事に対する責任感についておっしゃられたのですね",
      "content": "您是对她工作的责任感发表了看法，是吗？"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:22:45",
      "origin": "そうですね",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:22:58",
      "origin": "言ってみて相手の反応はいかがでしたか？",
      "content": "您说了之后，对方的反应怎么样？"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:23:30",
      "origin": "なんでそんなに怒るの？と",
      "content": "她说：“你干嘛那么生气？”"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:23:37",
      "origin": "軽い反応でした",
      "content": "反应很轻描淡写。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:23:39",
      "origin": "そうでしたか",
      "content": "是这样啊。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:23:45",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:23:51",
      "origin": "その反応を見てどう感じましたか？",
      "content": "看到她的反应，您有什么感觉？"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:24:13",
      "origin": "あ、そんな感じなんだと",
      "content": "啊，原来她是这种感觉啊。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:24:16",
      "origin": "思いました",
      "content": "我当时是这么想的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:24:20",
      "origin": "なるほど。",
      "content": "原来如此。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:24:26",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:24:37",
      "origin": "諦めに近いような感覚でしょうか？",
      "content": "是接近于放弃的感觉吗？"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:24:59",
      "origin": "怒りから諦めに変わった感じでしょうか",
      "content": "大概是从生气变成了失望吧。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:25:07",
      "origin": "なるほど。",
      "content": "原来如此。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:25:23",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-11-12T20:25:51",
      "origin": "仕事に対して責任感が無いような発言は聞いていてもしんどいですよね。",
      "content": "听到那种对工作没有责任感的言论，确实会让人很难受呢。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:25:59",
      "origin": "そうですね",
      "content": "是啊。"
    },
    {
      "role": "client",
      "time": "2021-11-12T20:26:11",
      "origin": "真面目にやってきた人への侮辱と思いました",
      "content": "我觉得那对认真工作的人是一种侮辱。"
    },
