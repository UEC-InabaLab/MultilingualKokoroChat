{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:02:05",
            "content": "★こんにちは。スタートして大丈夫でしようか?",
            "Chinese": "★您好。现在可以开始了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:02:20",
            "content": "大丈夫です",
            "Chinese": "可以的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:02:36",
            "content": "では、始めます。",
            "Chinese": "好的，那我们开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:02:41",
            "content": "よろしくお願い致します",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:03:14",
            "content": "こんにちは。相談員です。今日は相談に来てくださってありがとうございます。",
            "Chinese": "您好，我是咨询师。感谢您今天前来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:03:39",
            "content": "初めに、性別と年齢を教えていただけますか?",
            "Chinese": "首先，请问可以告诉我您的性别和年龄吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:03:48",
            "content": "高1女子です助けてください",
            "Chinese": "我是高一女生，请救救我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:04:02",
            "content": "どうされましたか?",
            "Chinese": "您遇到什么情况了？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:04:15",
            "content": "お話しできますか?",
            "Chinese": "您能和我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:04:18",
            "content": "知らない男の人に裸の写真送ってしまいました",
            "Chinese": "我把裸照发给了一个不认识的男人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:04:36",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:04:45",
            "content": "どうしたらいいですか",
            "Chinese": "我该怎么办才好？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:04:56",
            "content": "慌てるのも無理はありません。",
            "Chinese": "您感到慌乱是很自然的。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:05:05",
            "content": "どうしよう",
            "Chinese": "我该怎么办……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:05:28",
            "content": "一緒にどうすれば良いか考えて行きたいので、",
            "Chinese": "我想和您一起思考接下来该怎么做，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:05:52",
            "content": "一度、大きく深呼吸してみて下さい。",
            "Chinese": "请您先深呼吸一下。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:06:07",
            "content": "はいしました",
            "Chinese": "好的，我做了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:06:27",
            "content": "お話し、できそうかな?",
            "Chinese": "感觉能说了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:06:40",
            "content": "はい、なんかすみません",
            "Chinese": "嗯，感觉有点不好意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:07:06",
            "content": "全然大丈夫ですよ。",
            "Chinese": "完全没关系的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:07:36",
            "content": "とうしていいかわからない、あなたの気持ち、もっともです。",
            "Chinese": "不知道该怎么办才好，您的这种心情我非常理解。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:07:54",
            "content": "不安ですよね。",
            "Chinese": "确实很令人不安呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:08:11",
            "content": "はい、誰にも言えないし",
            "Chinese": "是的，也不敢跟任何人说。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:08:25",
            "content": "うんうん、",
            "Chinese": "嗯嗯，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:08:46",
            "content": "ここに来るのも勇気が要ったことと思います。",
            "Chinese": "我想您能来到这里也是鼓起了很大的勇气。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:09:01",
            "content": "よく話に来てくれましたね。",
            "Chinese": "您能来倾诉真是太好了。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:09:22",
            "content": "はい怒られても仕方がないけど、なんかあったらもっと怖くて",
            "Chinese": "是的，虽然被骂也是没办法的事，但我更怕万一出什么事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:10:08",
            "content": "あなた自身が、しまった、と思っているのだから、もう、反省はそれで十分だと思います。",
            "Chinese": "既然您自己已经意识到‘糟糕了’，那么您的反省已经足够了。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:10:18",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:10:29",
            "content": "これからどうしていくかを考えて行きましょうね。",
            "Chinese": "我们一起想想接下来该怎么做吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:10:35",
            "content": "おねがいします",
            "Chinese": "拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:11:06",
            "content": "写真を送ったのは、いつ頃のことですか?",
            "Chinese": "您是什么时候发照片的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:11:20",
            "content": "一昨日です",
            "Chinese": "前天。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:11:37",
            "content": "つい最近なんですね。",
            "Chinese": "是最近才发生的事呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:11:49",
            "content": "はい…",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:12:05",
            "content": "今日まで、不安な気持ちでいっぱいだったよね。",
            "Chinese": "到今天为止，心里一定充满了不安吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:12:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:12:28",
            "content": "食事や睡眠はとれていますか?",
            "Chinese": "饮食和睡眠还好吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:12:40",
            "content": "いや、あんまりとれてないかも",
            "Chinese": "不，可能不太好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:13:05",
            "content": "そっか、そっか・・・。",
            "Chinese": "这样啊，这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:13:39",
            "content": "気持ちが焦っていると、冷静に判断することが難しくなるかもしれないので、",
            "Chinese": "心里一着急，可能就很难冷静地做出判断，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:14:06",
            "content": "話しをしていて、苦しくなったりしたら、言ってくださいね。",
            "Chinese": "如果谈话过程中觉得难受，请随时告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:14:12",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:15:10",
            "content": "初めに知らない人に、ということでしたが、どんな経過でそうなったか教えてくれますか?",
            "Chinese": "您提到是发给不认识的人，请问具体是怎么发生的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:15:30",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:15:47",
            "content": "話しやすいところからでいいですよ。",
            "Chinese": "从您方便说的地方开始就行。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:15:54",
            "content": "出会い系アプリで知り合った男の人なんですけど",
            "Chinese": "是在交友软件上认识的一个男人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:16:09",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:16:10",
            "content": "その人、すごく面白くて優しくて",
            "Chinese": "他那个人，特别有趣，也很温柔。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:16:18",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:16:39",
            "content": "アプリで出会ってからは、もう一ヶ月くらい経つかな",
            "Chinese": "从在软件上认识到现在，已经有一个月左右了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:16:52",
            "content": "そうなんだね",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:16:58",
            "content": "私がその人を好きになっちゃって",
            "Chinese": "我喜欢上他了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:17:09",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:17:23",
            "content": "告白したら、俺も好きって言ってくれて",
            "Chinese": "我告白后，他也说喜欢我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:17:31",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:17:39",
            "content": "でも、コロナだしなかなか会えないから、",
            "Chinese": "但因为疫情，很难见面，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:17:52",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:18:03",
            "content": "まずお互いを知る為に写真を交換しようってなって",
            "Chinese": "然后就说为了先互相了解一下，交换照片吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:18:18",
            "content": "そうなんだ",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:18:29",
            "content": "その前から顔はお互い写真見てて",
            "Chinese": "之前我们就互相看过彼此的脸照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:18:37",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:19:00",
            "content": "顔以外の、自分の部屋とか家の近所の写真とか",
            "Chinese": "除了脸以外，还有自己房间啊，家附近的照片之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:19:12",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:19:25",
            "content": "その人に色々見てもらいたくて、色々、ホント色々写真送ってて",
            "Chinese": "我想让他多看看我的各种样子，就发了很多很多，真的很多照片。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:19:41",
            "content": "会ってないけど会ってるみたいにしたくて",
            "Chinese": "虽然没见面，但想弄得像在见面一样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:19:44",
            "content": "そうなんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:20:00",
            "content": "好きになったら、知りたいし、知ってほしいよね。",
            "Chinese": "喜欢上一个人的话，就会想了解对方，也想让对方了解自己呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:20:00",
            "content": "その人も、色々写真送ってくれてて",
            "Chinese": "他也会发各种照片给我。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:20:16",
            "content": "はい、楽しかったし嬉しかったし",
            "Chinese": "嗯，当时很开心也很高兴。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:20:22",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:20:48",
            "content": "で、一昨日、もっと私のことを知りたいって裸の写真がほしいって言われて",
            "Chinese": "然后，前天，他说想更了解我，想要我的裸照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:21:00",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:21:19",
            "content": "嫌われたくなくて送ったら、いきなり連絡つかなくなって　（泣）",
            "Chinese": "我因为不想被他讨厌就发了，结果他就突然联系不上了（哭）。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:21:33",
            "content": "裸の写真も色々なやつ、送っちゃった",
            "Chinese": "裸照也发了好几种……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:21:52",
            "content": "そうだったんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:21:59",
            "content": "はい…",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:22:06",
            "content": "とても、混乱しましたね。",
            "Chinese": "您当时一定非常混乱吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:22:23",
            "content": "ずっともう連絡取れなくなったから、私、騙されたんですよね",
            "Chinese": "一直都联系不上了，我是不是被骗了？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:23:25",
            "content": "写真を送って、三日ですよね。その間、連絡がつかないというのは、どんな風にですか?",
            "Chinese": "您发了照片之后，已经三天了对吧。这期间，是怎样一种联系不上的状态呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:24:26",
            "content": "いつもなら、アプリで朝からおはよーとかやり取りするのに返事がなくておかしいなって思ったら、「ユーザーが存在しません」って退会？したっぽくて",
            "Chinese": "平时我们早上就会在软件上互道早安之类的，但他没有回，我觉得奇怪，一看显示“用户不存在”，好像是退会了？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:24:53",
            "content": "でも…",
            "Chinese": "但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:25:14",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:26:02",
            "content": "私のもういっこのアドレスでそのアプリに登録してみたら、その人の顔写真見つけちゃって私が教えてもらってた名前と違う名前で登録されてた",
            "Chinese": "我用另一个邮箱在那个软件又注册了一下，发现了他的脸照，但用的是和告诉我的不一样的名字注册的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:26:49",
            "content": "そうだったんですね。ショックだったね。",
            "Chinese": "是这样啊。您一定很受打击吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:27:25",
            "content": "はい…似てるだけかな？とか、やっぱあの人かなとかもう訳分かんない",
            "Chinese": "是的……我当时就在想，是只是长得像呢？还是就是他呢？脑子一片混乱。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:27:47",
            "content": "彼女募集中とか書いてあったし（泣）",
            "Chinese": "还写着“征女友”（哭）。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:28:14",
            "content": "そっか…不安だし、焦るし、どうしていいかわからないよね。",
            "Chinese": "这样啊……又不安，又着急，完全不知道该怎么办才好呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/30(金) 13:28:19",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/30(金) 13:29:05",
            "content": "ちなみに、あなたが送った写真や文章で、",
            "Chinese": "顺便问一下，在您发送的照片和文字中，"
        },
        {
