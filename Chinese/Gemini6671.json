{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 19:50:53",
            "content": "（こんばんは。どうぞよろしくお願いいたします。20時になりましたら、始めさせていただきます。）",
            "Chinese": "（晚上好。请多关照。我们会在20点准时开始。）"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 19:51:39",
            "content": "(こちらこそよろしくお願いします。扱いたいテーマとかありますでしょうか？)",
            "Chinese": "（也请您多关照。请问您有什么想谈论的主题吗？）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 19:52:42",
            "content": "（ありがとうございます。特にはありませんので、どんなテーマでも大丈夫です。よろしくお願いいたします。）",
            "Chinese": "（谢谢您。我没有什么特别的主题，任何主题都可以。请多多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 19:53:15",
            "content": "(承知しました)",
            "Chinese": "（明白了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:00:37",
            "content": "こんばんは。今日はご相談にいらしてくださりありがとうございます。初めに年齢、性別、ご相談内容を教えていただけますか？",
            "Chinese": "晚上好。感谢您今天前来咨询。首先，可以请您告诉我您的年龄、性别和咨询内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:01:07",
            "content": "１４、女",
            "Chinese": "14岁，女。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:01:53",
            "content": "友達から仲間外れされてどうしたいいですか？",
            "Chinese": "我被朋友排挤了，该怎么办才好？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:02:48",
            "content": "教えてくださりありがとう。お友達から仲間外れにされているんですね。それは毎日辛いですよね。いつ頃からそのようなことになっているのですか？",
            "Chinese": "感谢您告诉我。您被朋友排挤了，是吗？每天一定很痛苦吧。这种情况是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:03:31",
            "content": "半年前から",
            "Chinese": "从半年前开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:04:55",
            "content": "もう半年も経つのですね。これまでよく頑張ってきましたね。半年前に何かきっかけがあったのでしょうか？",
            "Chinese": "已经半年了呢。这段时间您一定很努力地撑过来了吧。半年前有什么契机吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:05:27",
            "content": "理由は分からない",
            "Chinese": "我不知道原因。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:06:56",
            "content": "理由はわからないのに、急に仲間外れにされてしまったんですね。それは寂しいですね。それでも毎日学校に行かれているのですか？",
            "Chinese": "在不知道原因的情况下，突然就被排挤了，是吗？那一定很寂寞吧。即使如此，您还是每天都去学校吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:07:21",
            "content": "毎日行ってる",
            "Chinese": "每天都去。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:08:26",
            "content": "その状況でも毎日学校に行かれているんですね。それはすごいことだと思います。学校ではそのお友達とは全くお話しされないのですか？",
            "Chinese": "在那种情况下您还能每天都去学校，我觉得这很了不起。在学校里，您和那些朋友完全不说话吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:09:10",
            "content": "うーん",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:09:24",
            "content": "そんなことはないかな",
            "Chinese": "也不是完全不说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:09:39",
            "content": "たまにはお話しされるんですね？",
            "Chinese": "偶尔还是会说话的，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:09:47",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:10:27",
            "content": "そうなんですね。それは良かったです。ではどんな時に仲間外れにされていると感じられるのですか？",
            "Chinese": "是这样啊，那太好了。那么，您是在什么时候会感到被排挤呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:12:25",
            "content": "教室移動する時とか",
            "Chinese": "比如换教室的时候。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:13:09",
            "content": "かな",
            "Chinese": "之类的吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:13:49",
            "content": "なるほど、教室移動する時とかに感じるのですね。なぜそのように感じられるとご自身では思われますか？",
            "Chinese": "原来如此，您是在换教室之类的时候会有这种感觉呢。您自己认为是什么原因呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:14:29",
            "content": "なんとなく",
            "Chinese": "说不上来，就是一种感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:16:14",
            "content": "なんとなくそんな気がするのですね。そう思うと寂しくなってしまいますよね。先ほど半年くらい前から仲間外れにされている、と教えていただきましたが、それ以前にはそのようなことはなかったのですか？",
            "Chinese": "就是凭感觉这么觉得的，是吗？这样想的话，确实会感到寂寞呢。您刚才提到是从半年前开始被排挤的，那在这之前没有发生过类似的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:19:20",
            "content": "特にはないと思う",
            "Chinese": "我觉得应该没有。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:20:07",
            "content": "それまで楽しかった",
            "Chinese": "在那之前都挺开心的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:21:09",
            "content": "そうなんですね、特にはないんですね。それまでは楽しかったんですね。そうですよね、仲良しのお友達と一緒にお話しできたり笑ったりすることは楽しいですもんね。",
            "Chinese": "是这样啊，之前没有过呢。在那之前都很开心啊。是啊，能和好朋友一起聊天欢笑，确实是件很开心的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:21:32",
            "content": "今はそうではなくなってしまって、楽しくなくなってしまったんですね。",
            "Chinese": "现在却不再是那样了，变得不开心了呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:21:33",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:22:20",
            "content": "たまにはお話しすることもある、と教えていただきましたが、どんな時にお話しすることがあるのですか？",
            "Chinese": "您提到偶尔还是会说话的，那是在什么时候呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:23:34",
            "content": "あいさつとか",
            "Chinese": "比如打招呼。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:23:46",
            "content": "話しかけたりしたら",
            "Chinese": "或者我主动搭话的话。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:24:02",
            "content": "ただ、そっけないし",
            "Chinese": "但是，她们态度很冷淡。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:25:25",
            "content": "かなしい",
            "Chinese": "我很伤心。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:25:40",
            "content": "そうなんですね、あいさつしたり、話しかけたら話してくれるけど、素っ気ないんですね。それは悲しいですよね。",
            "Chinese": "是这样啊。打招呼或者您主动搭话时，她们会回应，但态度很冷淡。这确实令人难过呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:25:55",
            "content": "理由もわからないんですものね。",
            "Chinese": "而且还不知道原因呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:26:16",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:26:34",
            "content": "お友達にそのことを聞いたことはありますか？",
            "Chinese": "您有问过朋友们这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:26:52",
            "content": "聞いたことはない・・・",
            "Chinese": "没有问过……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:27:18",
            "content": "もし聞いたとしたら、どんな風に答えが返ってくると思われますか？",
            "Chinese": "如果问了的话，您觉得她们会怎么回答呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:27:40",
            "content": "分からない",
            "Chinese": "不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:28:33",
            "content": "そうなんですね。このままこの状態が続くと毎日学校に行くのがもっと辛くなってしまいますよね？",
            "Chinese": "是这样啊。如果这种情况一直持续下去，每天去上学可能会变得更痛苦吧？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:28:58",
            "content": "そうなってしまうのかな",
            "Chinese": "会变成那样吗……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:29:22",
            "content": "今は毎日どんな気持ちで学校に通われていますか？",
            "Chinese": "现在您每天是怀着怎样的心情去学校的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:30:33",
            "content": "うーん",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:31:10",
            "content": "きっとあまり楽しくはないですよね？",
            "Chinese": "想必不是很开心吧？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:31:17",
            "content": "その子たちとしゃべらなくても話す子はいるんだけど、さみしい",
            "Chinese": "虽然不和她们说话，也有其他可以说话的同学，但还是觉得寂寞。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:31:49",
            "content": "なるほど、他に話す子はいるけれど、やはり寂しいんですね。",
            "Chinese": "原来如此，虽然有其他可以说话的人，但您还是会感到寂寞，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:31:58",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:32:23",
            "content": "今までのように仲良くしたいですよね？",
            "Chinese": "您还是希望能像以前那样和她们友好相处，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:32:33",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:33:05",
            "content": "その仲良しのお友達は何人かのグループですか？",
            "Chinese": "那些好朋友是一个小团体吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:33:26",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:34:30",
            "content": "その中であなたの話を聞いてくれそうなお友達はいると思いますか？",
            "Chinese": "在她们当中，您觉得有可能会听您倾诉的朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:35:48",
            "content": "いないと思う",
            "Chinese": "我觉得没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:36:13",
            "content": "そうなんですね、いないと思うんですね。なぜいないと思うのですか？",
            "Chinese": "是这样啊，您觉得没有。为什么会这么认为呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:39:58",
            "content": "うーん",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:40:06",
            "content": "いないから",
            "Chinese": "因为就是没有啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:40:30",
            "content": "なるほど、そうなんですね。",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:43:59",
            "content": "他にお話しする子がいたとしても、その仲良しのグループの子たちのことが気になりますよね？",
            "Chinese": "即使有其他可以说话的同学，您还是很在意那个好朋友团体里的同学，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:44:27",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:44:37",
            "content": "やっぱりさみしいから",
            "Chinese": "因为还是会觉得寂寞。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:45:25",
            "content": "そうですよね、仲良しだったわけですから、寂しく感じますよね？寂しいと感じていることを伝えてみてはどうでしょう？",
            "Chinese": "是啊，毕竟曾经关系那么好，感到寂寞是很正常的。试着把您感到寂寞的心情告诉她们，怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:46:25",
            "content": "いえない",
            "Chinese": "说不出口。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:46:41",
            "content": "言えないんですね、なぜ言えないのでしょう？",
            "Chinese": "说不出口是吗。是什么原因让您说不出口呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:47:16",
            "content": "なぜ？",
            "Chinese": "为什么？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:47:23",
            "content": "分からないそんなの",
            "Chinese": "这种事我怎么知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:48:50",
            "content": "難しいですよね。例えば、たぶん言っても聞いてもらえない、とか、言うことがちょっと怖い、とか。",
            "Chinese": "这确实很难呢。比如，您是不是觉得“即使说了她们可能也不会听”，或者“说出来有点害怕”之类的。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:49:09",
            "content": "言いたくない",
            "Chinese": "我不想说。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:49:50",
            "content": "言いたくないんですね。",
            "Chinese": "您是不想说，是吗。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:50:01",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:50:55",
            "content": "このままだとさみしい気持ちが続いてしまいそうですが、それはいかがですか？",
            "Chinese": "但这样下去的话，您寂寞的心情可能会一直持续下去，对于这一点您怎么看？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:51:54",
            "content": "うーん",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:52:06",
            "content": "しょうがないかな",
            "Chinese": "可能也没办法吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:52:35",
            "content": "寂しくても仕方がない、ということですか？",
            "Chinese": "您的意思是，即使寂寞也没办法，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:52:51",
            "content": "そうなるね",
            "Chinese": "算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:53:29",
            "content": "あなたはそのままでいいのですか？大丈夫ですか？",
            "Chinese": "您真的觉得维持现状就可以了吗？您还好吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:54:05",
            "content": "大丈夫かどうかは分からないけど",
            "Chinese": "我不知道算不算没问题，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:54:56",
            "content": "大丈夫かどうかわからないけど、仕方がない、と思っている、ということでしょうか？",
            "Chinese": "也就是说，您不确定自己是否没问题，但还是觉得没办法，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:55:16",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/01(月) 20:56:04",
            "content": "あなたは本当はどうなりたいですか？",
            "Chinese": "您内心真正希望变成怎样呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:56:29",
            "content": "どうなりたい？",
            "Chinese": "变成怎样？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/01(月) 20:56:40",
            "content": "わからない",
            "Chinese": "我不知道。"
        },
