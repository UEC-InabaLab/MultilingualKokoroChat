{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:00:04",
            "content": "こんばんは相談員です。よろしくお願いいたします。",
            "Chinese": "晚上好，我是咨询师。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:00:26",
            "content": "こんばんは。よろしくお願いいたします。",
            "Chinese": "晚上好。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:00:40",
            "content": "最初に年齢と性別を教えていただけますか？",
            "Chinese": "首先，能否请您告知您的年龄和性别？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:01:01",
            "content": "15歳、女性です。",
            "Chinese": "15岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:01:18",
            "content": "お返事ありがとうございます。",
            "Chinese": "谢谢您的回答。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:01:27",
            "content": "学年も教えていただけますか？",
            "Chinese": "能否也请您告知您的年级？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:02:26",
            "content": "中3です。",
            "Chinese": "初三。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:02:37",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:02:49",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:03:53",
            "content": "将来のことで親とけんかしてしまいました。",
            "Chinese": "因为将来的事情，我和父母吵架了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:04:22",
            "content": "そうだったんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:05:02",
            "content": "あなたの将来への思いはどのようなものなんですか？",
            "Chinese": "您对自己的将来有什么想法呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:05:53",
            "content": "特にやりたいことがないんです。",
            "Chinese": "我没有什么特别想做的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:06:13",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:06:53",
            "content": "そのことについて親御さんとケンカしたとのお話しでしたが、なんと言われたのですか？",
            "Chinese": "您提到因为这件事和父母吵架了，他们说了些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:08:50",
            "content": "将来のことを考えてないなんておかしいと言われました。",
            "Chinese": "他们说我“不考虑未来很奇怪”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:09:20",
            "content": "そんなこと言ってもねぇ・・・",
            "Chinese": "就算这么说也……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:10:04",
            "content": "中３で将来のことを考えていない人は一杯いるような気がしますけど・・・",
            "Chinese": "我觉得在初三还没有开始考虑将来的人应该有很多……"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:11:13",
            "content": "気に入らないみたいです。",
            "Chinese": "他们好像就是不满意。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:11:29",
            "content": "そうだったんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:11:57",
            "content": "その時の話し相手は、お父さんだったんですか？それともお母さん？",
            "Chinese": "当时和您说话的是父亲还是母亲呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:12:28",
            "content": "お母さんです。",
            "Chinese": "是妈妈。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:12:39",
            "content": "そうだんたんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:13:10",
            "content": "お母さんは、中３の時、将来についてどんな思いを持っていたか話してくれましたか？",
            "Chinese": "您妈妈有没有和您说过，她初三的时候对未来有什么想法呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:13:56",
            "content": "いいえ、そういう話にはなりませんでした。",
            "Chinese": "没有，没有聊到那方面。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:14:24",
            "content": "なるほど。一度聞いてみてもいいかもしれませんね。",
            "Chinese": "原来如此。或许可以找机会问问看呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:15:38",
            "content": "なんか聞きにくいです。",
            "Chinese": "总觉得不太好开口。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:15:55",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:16:54",
            "content": "いずれにせよ、お母さんに、将来のことを考えていないなんて、おかしいと言われて、腹が立っているのでしょうか？それとも、しょげているのですか？",
            "Chinese": "不管怎样，被妈妈说“不考虑将来很奇怪”，您是感到生气呢？还是感到沮丧呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:17:46",
            "content": "腹が立っています。",
            "Chinese": "我很生气。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:18:03",
            "content": "そうなんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:18:28",
            "content": "決めつけられたようで、嫌だったという感じでしょうか？",
            "Chinese": "感觉像是被武断地下了结论，所以很不舒服吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:19:34",
            "content": "いえ、わかってもらえないんだなという気持ちです。",
            "Chinese": "不，是觉得她不理解我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:20:00",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:20:22",
            "content": "その時の気持を教えてくれてありがとう。",
            "Chinese": "谢谢您告诉我当时的心情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:21:04",
            "content": "あなたとしては、本当は何を分かってもらいたかったのかしら？",
            "Chinese": "您真正希望被理解的是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:22:24",
            "content": "先がわからないという不安ですかね。",
            "Chinese": "大概是看不清未来的那种不安吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:22:54",
            "content": "そうなんだ。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:23:22",
            "content": "あなた自身が不安だったんだね・・・",
            "Chinese": "原来是您自己感到不安啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:24:13",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:24:43",
            "content": "先が分からないと不安になるよね・・・",
            "Chinese": "看不清前路，确实会让人不安呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:24:59",
            "content": "無理ないよ。",
            "Chinese": "这很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:26:14",
            "content": "どうしたらいいんですかね？",
            "Chinese": "我该怎么办才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:27:50",
            "content": "自分としては、すぐにしなければならないこととか、すぐに決めなければならないこととかはあるの？",
            "Chinese": "就您自己而言，现在有没有必须立刻去做、或必须马上决定的事情？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:28:51",
            "content": "そういうわけではないんですが、親は気に入らないみたいなので。",
            "Chinese": "倒也不是那样，不过父母似乎不太满意。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:30:37",
            "content": "なるほど。親が気に入らないことが嫌なんですね。",
            "Chinese": "原来如此。您是不希望父母不满意，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:31:53",
            "content": "また、嫌なことを言われるのが嫌です。",
            "Chinese": "我不想再听到那些让我不舒服的话了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:32:21",
            "content": "そうなんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:32:35",
            "content": "どんなこと言われそうなの？",
            "Chinese": "您觉得他们可能会说些什么？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:33:18",
            "content": "おかしいとか。",
            "Chinese": "比如“你很奇怪”之类的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:33:52",
            "content": "そんなこと言われたら、辛くなってしまうよね。",
            "Chinese": "被那样说，确实会很难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:34:33",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:35:40",
            "content": "少し話が違うけど、クラスメートの人たちは、将来のことって何か考えているのかな？",
            "Chinese": "话题稍微有点跳，但您的同学们对将来有什么想法吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:36:53",
            "content": "うーん、どうなのかわからないです。",
            "Chinese": "嗯……我不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:37:15",
            "content": "そうなんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:37:40",
            "content": "今度、休み時間にでも聞いてみるといいかもしれないね。",
            "Chinese": "下次或许可以趁休息时间问问他们。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:39:05",
            "content": "そんなことを聞くと変な人と思われそうです。",
            "Chinese": "问这种问题，可能会被当成怪人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:40:24",
            "content": "確かに、突然大真面目な顔つきで聞いたらビックリされるかもしれないね。",
            "Chinese": "确实，如果突然一脸严肃地问，可能会让人吓一跳呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:40:38",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:40:47",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:41:42",
            "content": "もし、うまいタイミングがみつかったら、さりげなく聞いてみるのも一つかもしれないなと思ったの。",
            "Chinese": "我只是觉得，如果找到合适的时机，不经意地问一下，或许也是一个方法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:42:14",
            "content": "将来のこと考えている人もいるかもしれないし、将来のことなんて考えてない人もいるかもしれないし・・・",
            "Chinese": "可能有人在考虑将来的事，也可能有人完全没在考虑……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:42:32",
            "content": "いろいろじゃないかなと思ったので・・・",
            "Chinese": "我想，大家的情况应该各种各样吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:42:48",
            "content": "それはですね。",
            "Chinese": "这嘛……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:43:03",
            "content": "はい",
            "Chinese": "嗯？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:43:16",
            "content": "なにか？",
            "Chinese": "有什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:44:01",
            "content": "それはそうですね。と打ちたかっただけです。すみません。",
            "Chinese": "我只是想打“说的也是呢”，抱歉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:44:21",
            "content": "大丈夫です。分かりましたよ。",
            "Chinese": "没关系。我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:45:04",
            "content": "いずれにせよ、いろいろあっていいんじゃないかと思うんですけど・・・",
            "Chinese": "不管怎么说，我觉得每个人有不同的想法不也挺好的吗……"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:45:44",
            "content": "そうなんですかね。",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:46:24",
            "content": "あなたご自身はその点はどう思うの？",
            "Chinese": "您自己是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:47:05",
            "content": "先がわからないのは不安です。",
            "Chinese": "看不清未来让我很不安。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:48:45",
            "content": "ということは、本当は、将来のことを考えたいと思っているということですね。",
            "Chinese": "也就是说，其实您是想考虑将来的事情的，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:49:57",
            "content": "それはよくわかりません。",
            "Chinese": "这个我不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:51:11",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:52:23",
            "content": "今は先のことが分からないのはとにかく不安なんですね。",
            "Chinese": "总之，现在看不清未来这件事让您很不安，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:52:59",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:54:57",
            "content": "お母さんから将来のことを考えていないなんておかしいと言われて不安になってしまっているということのようですね。",
            "Chinese": "听起来像是，被妈妈说了“不考虑将来很奇怪”之后，您就变得不安起来了。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:55:10",
            "content": "そうですね。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:56:12",
            "content": "お母さんからそう言われて、あなたとしては、その時どんな言葉を返したんですか？",
            "Chinese": "当妈妈那么说时，您当时又是怎么回应的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:56:50",
            "content": "何も言い返せませんでした。",
            "Chinese": "我什么都没能反驳。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:57:24",
            "content": "そうだったんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:57:52",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:58:43",
            "content": "そうすると、お母さんの言ったおかしいという言葉が、ぐざりと心に刺さったままになっているという感じなのでしょうね。",
            "Chinese": "这样的话，妈妈说的“很奇怪”这句话，就像一根刺一样扎在您心里了吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 21:59:07",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 21:59:55",
            "content": "それは苦しいね。",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:00:31",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:00:41",
            "content": "何も言い返せなかったということもさらに重くのしかかって来るみたいで、一層辛くなっているのでは？",
            "Chinese": "什么都没能反驳这件事，是不是也像一块大石压在心上，让您更加难受了呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:01:18",
            "content": "そうなんですかね。",
            "Chinese": "也许是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:01:43",
            "content": "ご自分としてはどう感じているの？",
            "Chinese": "您自己感觉如何呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:02:21",
            "content": "将来のことがわからないので、私",
            "Chinese": "因为我对将来的事不了解，所以我"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:02:34",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:02:41",
            "content": "が悪いんだと思います",
            "Chinese": "觉得是我的错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:03:20",
            "content": "そう思っているんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:03:47",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:04:11",
            "content": "そうすると、将来のことが分かるようになればいいのかな？",
            "Chinese": "这么说来，如果能知道将来的事就好了，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:04:39",
            "content": "そうですね。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:05:09",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:05:30",
            "content": "ひとつだけ提案してもいいですか？",
            "Chinese": "我可以提一个小小的建议吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:05:53",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:06:43",
            "content": "将来の起こりそうなことが少しでも分かれば大分助けになりそうな気がするけど、どう？",
            "Chinese": "如果能对将来可能发生的事情哪怕了解一点点，我觉得也会有很大帮助，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:08:03",
            "content": "よくわからないです。",
            "Chinese": "我不太明白。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:09:07",
            "content": "例えば、どんな人がどんなことをしていたのかが分かれば、そういう生き方もあるんだとヒントになるかもと思うけど。",
            "Chinese": "比如，如果能了解一下不同的人都在做些什么，也许能给您一些启发，让您知道“原来还有这样的活法啊”。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:10:17",
            "content": "そういう意味なんですね。",
            "Chinese": "原来是这个意思啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:10:59",
            "content": "はい。小さな人物紹介欄が新聞や雑誌に載っていたりしますよ。",
            "Chinese": "是的。报纸或杂志上常会有一些小的人物介绍专栏哦。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:11:30",
            "content": "わかりました。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:11:32",
            "content": "そんなものを見てみると、ご自分のこれからを考えるヒントになるかもしれませんよ。",
            "Chinese": "看一看这些内容，也许能为您思考今后的方向提供一些灵感。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:11:50",
            "content": "あなたの将来探しを応援していますね。",
            "Chinese": "我会支持您寻找自己的未来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:12:06",
            "content": "気になることが出てきたら、また相談にいらしてください。",
            "Chinese": "如果又有什么在意的事情，欢迎随时再来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:12:12",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:12:24",
            "content": "今日のご相談はここまででよろしいですか？",
            "Chinese": "今天的咨询先到这里可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:12:30",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:12:51",
            "content": "今日はご相談にいらしてくださりありがとうございます。",
            "Chinese": "非常感谢您今天前来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/17(日) 22:13:00",
            "content": "では失礼いたします。",
            "Chinese": "那我就先告辞了。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/17(日) 22:13:12",
            "content": "失礼いたします。",
