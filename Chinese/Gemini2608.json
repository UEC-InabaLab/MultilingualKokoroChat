{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:21:13",
            "content": "こんにちは。本日はよろしくお願いいたします。",
            "Chinese": "您好。今天请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:21:51",
            "content": "よろしくお願いします！",
            "Chinese": "请多多关照！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:21:57",
            "content": "お時間になったら始めさせていただきます。よろしくお願いいたします。",
            "Chinese": "时间一到我们就开始。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:22:12",
            "content": "了解しました(^^)",
            "Chinese": "明白了(^^)"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:26:10",
            "content": "もしかして昨日クライアント役をやってくださいましたか？",
            "Chinese": "您昨天是不是担任了来访者的角色？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:26:47",
            "content": "！しました(^^)",
            "Chinese": "！是的(^^)"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:27:09",
            "content": "相談内容は、変えようと思ってましたが、大丈夫ですか？",
            "Chinese": "我本来想把咨询内容换一下，可以吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:27:38",
            "content": "昨日はありがとうございました。お気遣いありがとうございます。大丈夫です。是非よろしくお願いいたします。",
            "Chinese": "昨天非常感谢您。也谢谢您的体谅。没关系，那就拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:30:36",
            "content": "こんにちは。本日はお越しいただきありがとうございます。",
            "Chinese": "您好。今天感谢您的到来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:30:45",
            "content": "はじめにあなたの年齢と性別をお聞かせいただけますか？",
            "Chinese": "首先，能否请您告知您的年龄和性别？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:31:35",
            "content": "10代です。女子です。",
            "Chinese": "十几岁。是女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:31:45",
            "content": "ありがとうございます。本日はどのようなご相談ですか？",
            "Chinese": "谢谢您。今天想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:32:25",
            "content": "今年から大学生ですが、友達が一人もできません。",
            "Chinese": "我今年刚上大学，但一个朋友也没交到。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:32:39",
            "content": "どうしたら良いでしょうか？",
            "Chinese": "我该怎么办呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:32:47",
            "content": "お昼も一人だし、",
            "Chinese": "午饭也是一个人吃，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:32:57",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:32:58",
            "content": "グループトークも一人で",
            "Chinese": "小组讨论也都是我一个人，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:33:09",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:33:15",
            "content": "周囲は",
            "Chinese": "周围的人"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:33:19",
            "content": "グループや",
            "Chinese": "都组成了小组或者"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:33:32",
            "content": "パートナーが出来上がって、",
            "Chinese": "找到了搭档，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:33:44",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:33:45",
            "content": "入るすきもないです。",
            "Chinese": "完全没有我能加入的余地。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:34:24",
            "content": "なるほど。進学してから思うように人間関係が作れずにいるんだね。それは本当に辛かったね。",
            "Chinese": "原来如此。升学之后，人际关系没能像想象中那样顺利建立起来呢。这真的让你很难过吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:34:37",
            "content": "周りとも比較してしまうよね。",
            "Chinese": "也会不自觉地和周围人比较呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:34:47",
            "content": "うん、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:34:55",
            "content": "コロナで",
            "Chinese": "因为疫情，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:35:07",
            "content": "テレワーク多かったし、",
            "Chinese": "远程课也很多，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:35:40",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:35:58",
            "content": "このままの四年間かと思うと",
            "Chinese": "一想到大学四年都要这样度过，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:36:11",
            "content": "気が重いです。",
            "Chinese": "心情就很沉重。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:37:12",
            "content": "そうだったんだね。10か月もそういう状態で我慢してきて、先を思うと気持ちが暗くなってしまうのも無理ないよね。",
            "Chinese": "是这样啊。在这种状态下忍耐了10个月，一想到未来，心情变得灰暗也是难免的呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:37:39",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:38:32",
            "content": "これまで、どうやって一人で頑張ってきたのかな？",
            "Chinese": "到目前为止，你是怎样一个人撑过来的呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:38:50",
            "content": "何かで気を紛らわせたりしてきたのかな？",
            "Chinese": "有没有用什么方式来分散注意力呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:39:24",
            "content": "ランチの時には、音楽聞いてた。一人でごはん食べた",
            "Chinese": "吃午饭的时候会听音乐。一个人吃饭。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:39:40",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:40:03",
            "content": "あとは、ずっと一人。",
            "Chinese": "其他时候，就一直是一个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:40:40",
            "content": "そうかあ。本当に耐えてここまできたんだね。",
            "Chinese": "这样啊。你真的是一直在忍耐着走到现在呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:41:01",
            "content": "う",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:41:04",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:41:18",
            "content": "これまでこういうことを誰かに相談することはできたかな？",
            "Chinese": "到目前为止，有跟谁聊过这些事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:41:20",
            "content": "アルバイト",
            "Chinese": "打工"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:41:27",
            "content": "したり、",
            "Chinese": "之类的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:41:27",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:41:45",
            "content": "気を紛らわしてはいるし、",
            "Chinese": "也算是在分散注意力，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:42:06",
            "content": "本読んだり",
            "Chinese": "看看书，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:42:14",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:42:21",
            "content": "お母さんに聞いてもらうけど、",
            "Chinese": "也会跟妈妈说说，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:42:34",
            "content": "大学にいくと、一人。",
            "Chinese": "但一到大学，就还是一个人。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:42:51",
            "content": "勉強しにいく場所って、",
            "Chinese": "我知道大学是去学习的地方，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:42:59",
            "content": "わかってるけど、",
            "Chinese": "我明白，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:43:25",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:43:42",
            "content": "一人は",
            "Chinese": "一个人待着"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:43:49",
            "content": "嫌じゃないけど、",
            "Chinese": "我并不讨厌，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:44:09",
            "content": "みんながグループでいる部屋の中に一人がつらくなる。",
            "Chinese": "但在大家都成群结队的房间里，只有我一个人就会觉得很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:45:36",
            "content": "なるほど。一人でいるのが辛いというより、グループに入っていない自分という状況が辛い、という感じかな？",
            "Chinese": "原来如此。与其说是独处本身难受，不如说是“自己没在任何小组里”这种处境让你难受，是这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:45:45",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:46:23",
            "content": "全然おもしろくない",
            "Chinese": "一点意思都没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:46:56",
            "content": "そうなんだね。確かに楽しいとは思いにくいよね。",
            "Chinese": "是啊。确实很难觉得开心呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:47:03",
            "content": "でもあなたはとても冷静に自分や周りの状況が見えているね。",
            "Chinese": "但是，你很冷静地看清了自己和周围的状况呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:47:22",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:47:31",
            "content": "そうかなあ？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:48:56",
            "content": "そう思うよ。何が何だかわからないけど寂しくて嫌！みたいな感じになってしまうことも多いからね。",
            "Chinese": "我是这么认为的哦。因为很多人会陷入那种“不知道为什么，就是很寂寞很难受！”的状态。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:49:10",
            "content": "外にもバイトという世界を持ったり自分の好きな本を読んだり、ちゃんと自分の世界もしっかり持てているよね。",
            "Chinese": "你还在校外有打工的世界，也会读自己喜欢的书，你已经很好地拥有了自己的世界了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:49:33",
            "content": "最初は、本当に嫌だったし、",
            "Chinese": "一开始，真的很讨厌，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:49:53",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:50:13",
            "content": "私は嫌われてるかもと思って、",
            "Chinese": "还觉得自己可能被人讨厌，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:50:25",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:50:46",
            "content": "怖かった。",
            "Chinese": "很害怕。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:50:55",
            "content": "今もそうだけど。",
            "Chinese": "现在也还是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:51:04",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:52:13",
            "content": "確かに、怖いと感じてしまうよね。",
            "Chinese": "确实，会感到害怕呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:52:20",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:53:40",
            "content": "これまで話を聞いていて、本当によく一人で耐えてきたんだなあと思いました。コロナということもあって不安は更に膨らんだと思うよ。",
            "Chinese": "听你说到现在，我觉得你真的一个人忍受了很多。再加上疫情，不安应该更被放大了吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:53:48",
            "content": "クラス替えもないし、",
            "Chinese": "大学又不像高中那样分班，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:53:55",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:54:17",
            "content": "男子もグループ組んでるんだ。",
            "Chinese": "连男生们也都结成了小团体。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:54:34",
            "content": "そうなんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:54:35",
            "content": "なんか",
            "Chinese": "总觉得"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:54:50",
            "content": "グループ組んでないとおかしいみたい。",
            "Chinese": "不结成小组好像就很奇怪。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:55:12",
            "content": "へー。それは誰が言ったの？",
            "Chinese": "哦—。这是谁说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:55:23",
            "content": "みんながそうだから。",
            "Chinese": "因为大家都是那样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:56:09",
            "content": "なるほど。直接そう言われたのかな？",
            "Chinese": "原来如此。是有人直接对你这么说了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:56:19",
            "content": "ううん、",
            "Chinese": "没有，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:56:39",
            "content": "言ってないし、",
            "Chinese": "没人这么说，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:56:58",
            "content": "みんな私と会話しないから、わからないけど、",
            "Chinese": "大家也不跟我说话，所以我也不知道，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:57:08",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:57:16",
            "content": "みんなグループでしか行動しないから。",
            "Chinese": "因为大家都只以小组为单位行动。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:57:26",
            "content": "私がおかしいのかな。",
            "Chinese": "是不是我很奇怪呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:57:28",
            "content": "でも、",
            "Chinese": "但是，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:57:52",
            "content": "ずっとグループでいることは、向いてないから、",
            "Chinese": "我不太适合一直待在小组里，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:57:57",
            "content": "でも、",
            "Chinese": "但是，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 10:58:15",
            "content": "そんな私がおかしいのかなあ、と思ってしまったりします。",
            "Chinese": "我又会想，这样的我是不是很奇怪。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:59:48",
            "content": "そうかあ。あなたは自分をしっかり持っているし、自分が一人でいることの方が向いていることもちゃんと理解しているんだね。",
            "Chinese": "这样啊。你很有主见，也清楚地明白自己更适合独处。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 10:59:55",
            "content": "でも大勢のそういう意見を聞くと気持ちが傾いてしまうよね。",
            "Chinese": "但一听到大多数人都是那样，心里还是会动摇呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:00:01",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:00:54",
            "content": "ここまでお話ししてきて、今気持ちはどうかな？少し落ち着いているかな？波立っているかな？",
            "Chinese": "聊到现在，你现在心情怎么样？是平静一些了？还是仍然很纷乱？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:01:34",
            "content": "不安がいっぱい",
            "Chinese": "还是很不安。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:02:03",
            "content": "そうだよね。少し一緒に整理してみようと思うのだけどどうかな？",
            "Chinese": "是啊。我想和你一起稍微整理一下思绪，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:03:09",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:03:58",
            "content": "ありがとう。",
            "Chinese": "谢谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:05:09",
            "content": "あなたは、今のスタイルが自分に合っていると分かっている",
            "Chinese": "你知道，现在的生活方式是适合自己的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:05:18",
            "content": "一人でいることが苦しいわけではない。",
            "Chinese": "一个人待着本身并不痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:05:28",
            "content": "けれど、周りの意見（空気）がそれを許していないように感じているのが苦しい。",
            "Chinese": "只是，让你感到痛苦的是，你觉得周围的意见（氛围）似乎不允许你这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:06:04",
            "content": "というお話しだと私は受け取っているんだけど、どうかな？",
            "Chinese": "我是这样理解你刚才说的话的，你觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:06:09",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:07:33",
            "content": "ちょっと難しい話になっちゃうけど",
            "Chinese": "接下来可能要说一点比较难懂的话题了，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:07:43",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:08:16",
            "content": "グループに属さないというのは、人間は本能的に恐怖を感じるものなんだって。人間は群れで生きる動物だからね。",
            "Chinese": "据说，不属于某个群体会让人本能地感到恐惧。毕竟人类是群居动物。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:08:42",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:08:54",
            "content": "そして多数派は少数派を責めることもしやすいらしい。責めることで自分たちは安全だと安心したいんだよね。",
            "Chinese": "而且，多数派也更容易指责少数派。他们通过指责别人，来获得“自己是安全的”这种安心感。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:09:21",
            "content": "うん。わかる。",
            "Chinese": "嗯。我明白。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:09:38",
            "content": "私も友達は欲しい。",
            "Chinese": "我也想要朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:09:52",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:12:40",
            "content": "だから、現状であなたみたいにしっかりと自分を持っていて一人でいることを周りは少し理解が追い付かないのではないかな？",
            "Chinese": "所以，对于像你这样有主见、选择独处的人，周围的人可能一时无法理解吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:13:09",
            "content": "うん、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:14:48",
            "content": "そうかもだけど、ずっとこのままも考えてしまいます。",
            "Chinese": "可能是这样，但我也担心会一直这样下去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:15:52",
            "content": "そうだよね。まず周りの言葉や態度というのは、自分ではコントロールできるものではないよね。ちょっと「ああ、理解が追い付かないんだな。」位に思って一呼吸置いてみる。",
            "Chinese": "是啊。首先，周围人的言语和态度，不是我们自己能控制的。试着这样想：“啊，他们只是无法理解而已”，然后深呼吸一下。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:16:07",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:17:24",
            "content": "そしてもし",
            "Chinese": "然后，如果"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:17:31",
            "content": "あなたの大切な友達にあなたと同じように悩んでいる人がいたら",
            "Chinese": "你有一个重要的朋友，正和你一样为此烦恼，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:17:44",
            "content": "今あなたはなんて声をかけるかな？",
            "Chinese": "你会对她说什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:18:37",
            "content": "私なら、",
            "Chinese": "如果是我，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:19:01",
            "content": "夜ラインしたり、お昼にラインしてあげたりする。",
            "Chinese": "我会在晚上或者午休时给她发消息。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:19:43",
            "content": "そうだよね。そして「私どうしたらいい？」と聞かれたらどう答えるかかな？",
            "Chinese": "是啊。那如果她问你“我该怎么办才好？”，你会怎么回答呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:20:32",
            "content": "私がついてるから、一緒にいなくても大丈夫と言ってあげる。",
            "Chinese": "我会告诉她：“有我在，即使不一直在一起也没关系。”"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:21:34",
            "content": "そうかあ、",
            "Chinese": "这样啊，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:22:39",
            "content": "仕方ないよね、",
            "Chinese": "这也是没办法的事呢，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:23:23",
            "content": "大学に友達欲しいけど、頑張っていくしかないよね。",
            "Chinese": "虽然想在大学交朋友，但也只能努力下去了呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:24:31",
            "content": "なるほど。そう感じるんだね。",
            "Chinese": "原来如此。你是这么感觉的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:24:49",
            "content": "うん。でも、",
            "Chinese": "嗯。但是，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:25:07",
            "content": "頑張ってみようと思ってきた。",
            "Chinese": "我开始想要努力试试了。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:25:34",
            "content": "きのあう友達いないもん。",
            "Chinese": "因为没有合得来的朋友嘛。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:25:47",
            "content": "グループには向いてないし、",
            "Chinese": "我也不适合待在小团体里，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:26:06",
            "content": "私が大人なんだね。",
            "Chinese": "原来是我更成熟啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:26:06",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:26:24",
            "content": "そういう部分も大きいと思うよ。そして",
            "Chinese": "我觉得很大程度上是这样的。而且，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:26:59",
            "content": "人間、まず自分の気持ちを整理したら次は行動なんだよね。",
            "Chinese": "人呢，整理好自己的心情之后，下一步就是行动了。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:27:23",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:27:34",
            "content": "そうなの？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:28:23",
            "content": "うん。あなたが言うように、無理する必要は決してないよね。",
            "Chinese": "嗯。就像你说的，完全没有必要勉强自己。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:28:28",
            "content": "でもクラスメイトに対して敵意が無いんだったら",
            "Chinese": "但是，如果你对同学们没有敌意的话，"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:28:35",
            "content": "うん。ない。",
            "Chinese": "嗯，没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:28:56",
            "content": "笑顔で挨拶する。目を見て話す。何か連絡があったらちゃんとする。",
            "Chinese": "微笑着打招呼，看着对方的眼睛说话，有需要联系的事情就认真对待。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:29:04",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:29:31",
            "content": "これをしっかり守るということだけでも、相手は壁を下げるものなんだよ。",
            "Chinese": "只要能坚持做到这些，对方也会放下戒备的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:29:55",
            "content": "どうかな？できそうかな？",
            "Chinese": "怎么样？觉得自己能做到吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:30:29",
            "content": "わかった。",
            "Chinese": "我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:30:41",
            "content": "怖いけど、やってみます。",
            "Chinese": "虽然有点害怕，但我会试试的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:31:14",
            "content": "あなたはちゃんと自分の気持ちを感じることができているから大丈夫だよ。",
            "Chinese": "你能够很好地感受自己的心情，所以没问题的。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 11:31:59",
            "content": "ありがとう。",
            "Chinese": "谢谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 11:32:08",
            "content": "今日は時間になってしまったのでここまでになってしまうのだけど、話をしてみて今どうかな？",
            "Chinese": "今天时间差不多了，只能聊到这里。聊完之后，你现在感觉怎么样？"
