{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 19:53:48",
            "content": "こんばんは。今日はよろしくお願いいたします。",
            "Chinese": "晚上好，今天请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 19:53:57",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 19:54:33",
            "content": "ご準備はいかがでしょうか？",
            "Chinese": "您准备好了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 19:54:46",
            "content": "大丈夫です。",
            "Chinese": "没问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 19:55:07",
            "content": "では、始めさせていただきます。",
            "Chinese": "那么，我就开始了。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 19:55:25",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 19:55:40",
            "content": "こんばんは。相談員です。",
            "Chinese": "晚上好，我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 19:55:58",
            "content": "こんばんは。よろしくお願いいたします。",
            "Chinese": "晚上好，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 19:56:39",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 19:56:53",
            "content": "夫のことで悩んでいます",
            "Chinese": "我正为丈夫的事情烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 19:57:38",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 19:58:06",
            "content": "ご主人のどんなところにお悩みですか？",
            "Chinese": "您在为丈夫的哪方面感到烦恼呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 19:58:26",
            "content": "夫が浮気しているようなんです",
            "Chinese": "我丈夫好像出轨了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 19:58:58",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 19:59:44",
            "content": "それはお辛いですよね・・",
            "Chinese": "那一定很难受吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 19:59:57",
            "content": "そうですね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:00:15",
            "content": "それはいつ頃お気づきになったのですか？",
            "Chinese": "您大概是什么时候察觉到的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:00:42",
            "content": "1月ほど前です",
            "Chinese": "大约一个月前。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:01:01",
            "content": "そうでしたか・・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:01:51",
            "content": "それはびっくりなさったでしょうね・・",
            "Chinese": "您当时一定很震惊吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:02:22",
            "content": "前から何回かあったので、ショックです",
            "Chinese": "因为以前也有过好几次，所以很受打击。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:02:36",
            "content": "そうでしたか・・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:03:16",
            "content": "それはそうですよね・・・",
            "Chinese": "那是当然的……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:03:49",
            "content": "今回はどのように気づかれたのでしょうか？",
            "Chinese": "这次您是怎么发现的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:04:49",
            "content": "様子がおかしいんですよ",
            "Chinese": "他的行为有些异常。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:05:08",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:05:15",
            "content": "携帯を常に持ち歩いたりして。",
            "Chinese": "比如手机总是随身带着。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:05:24",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:06:02",
            "content": "それは気になりますよね",
            "Chinese": "那确实会让人在意呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:06:20",
            "content": "そうなんです",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:07:19",
            "content": "携帯を離さないのですね。それ以外にもなにか気になることはありますか？",
            "Chinese": "手机不离身是吧。除此之外，还有其他让您在意的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:08:08",
            "content": "普段、食事の準備や片付けはしない人なのに、急にやりだしたりしてます",
            "Chinese": "他平时是不做饭、不收拾的人，但最近却突然开始做了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:08:31",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:09:00",
            "content": "普段と違うことをされると気になりますよね",
            "Chinese": "他做一些和平时不一样的行为，确实会让人在意呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:09:18",
            "content": "そうですね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:12:05",
            "content": "前にも同じようなことがあって、発覚したんです",
            "Chinese": "以前也发生过类似的事情，然后就被我发现了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:12:18",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:12:42",
            "content": "またかぁ、って感じです",
            "Chinese": "有种“又来了啊”的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:12:54",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:13:23",
            "content": "今回も何となくそんな感じがするのでしょうか？",
            "Chinese": "这次您也隐约有这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:13:44",
            "content": "そうですね。態度もよそよそしいので…",
            "Chinese": "是的。而且他的态度也很疏远……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:13:56",
            "content": "そうでしたか・・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:14:40",
            "content": "前回のことを考えると、そう思ってしまいますよね",
            "Chinese": "想到上次的事情，会这么想也是难免的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:14:58",
            "content": "そうですね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:15:51",
            "content": "ずっと部屋にとじこもって、パソコンしたり携帯いじってりで会話もないです…",
            "Chinese": "他一直把自己关在房间里，要么玩电脑要么玩手机，我们之间也没有交流……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:16:42",
            "content": "そうでしたか・・それは同じ家にいるのに寂しいですよね",
            "Chinese": "是这样啊……明明在同一个屋檐下，却感觉很寂寞呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:16:53",
            "content": "そうですね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:17:36",
            "content": "お休みの日なども同じような感じでしょうか？",
            "Chinese": "休息日也是差不多的感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:18:06",
            "content": "ずっとです。家にいるときはずっと携帯にぎりしめています。",
            "Chinese": "一直都是。只要在家，他就一直握着手机不放。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:18:24",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:19:20",
            "content": "一日中では、こちらも話かけづらいですよね",
            "Chinese": "他一整天都这样的话，您这边也不好搭话呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:20:05",
            "content": "話しかけると怒りだすので、用事がないときは話さないようにしています",
            "Chinese": "我一和他说话他就发火，所以没事的时候我尽量不和他说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:21:08",
            "content": "怒られるとこちらも話しかけづらいですよね",
            "Chinese": "被他发火的话，您这边确实也不好搭话呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:21:38",
            "content": "そうなんですよね",
            "Chinese": "的确是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:22:14",
            "content": "お食事などはどのようにされていますか？",
            "Chinese": "吃饭之类的通常是怎么样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:23:03",
            "content": "食事は基本一緒にたべます",
            "Chinese": "我们基本上是一起吃饭的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:23:27",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:25:05",
            "content": "食事中はご主人もお話されるのでしょうか？",
            "Chinese": "用餐时，您先生也会聊天吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:25:43",
            "content": "こちらが話しかけないとほとんど話さないです。味が口に合わないときだけ、文句をいいます。",
            "Chinese": "除非我主动开口，否则他几乎不说话。只有饭菜不合口味时，他才会抱怨。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:26:04",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:26:43",
            "content": "それは余計話しかけづらくなりますよね",
            "Chinese": "那会让人更不好搭话了呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:27:39",
            "content": "はい。食事のときくらいはって思うんですが…",
            "Chinese": "是啊。我也想至少吃饭的时候能说说话，可是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:28:15",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:28:44",
            "content": "食事中くらいは、話したいですよね",
            "Chinese": "至少在吃饭的时候，还是想聊聊天的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:29:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:31:44",
            "content": "それはお辛いですよね",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:32:34",
            "content": "どうしていいかわかりません",
            "Chinese": "我不知道该怎么办才好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:32:52",
            "content": "前回も、と仰っていましたが、その時と同じようなご主人の態度なのですよね・・",
            "Chinese": "您提到之前也发生过，当时您先生的态度也是类似的，对吗……？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:34:13",
            "content": "浮気のうたがいがあると、態度にあらわれるんです",
            "Chinese": "只要有出轨的嫌疑，他的态度就会表现出来。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:34:39",
            "content": "そうなんですね",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:34:53",
            "content": "会話にかぎっては、さらに無口になるというか…",
            "Chinese": "尤其是在对话方面，会变得更加沉默……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:35:06",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:35:55",
            "content": "それは悲しくなってしまいますよね",
            "Chinese": "那确实会让人感到难过呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:36:25",
            "content": "ご家族はほかにはいらっしゃいますか？",
            "Chinese": "您家里还有其他家人吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:36:39",
            "content": "子供が一人います",
            "Chinese": "我有一个孩子。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:36:52",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:37:07",
            "content": "今、おいくつでしょうか？",
            "Chinese": "孩子现在多大了？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:37:23",
            "content": "年長さんです",
            "Chinese": "孩子现在上大班。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:37:40",
            "content": "そうでしたか",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:38:11",
            "content": "ご主人とお子様のご関係はどうでしょうか？",
            "Chinese": "您丈夫和孩子的关系怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:38:54",
            "content": "夫は子どもには優しいです。よく遊んでいます",
            "Chinese": "我丈夫对孩子很温柔，经常陪他玩。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:39:40",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:42:09",
            "content": "休日などはお子様とお出かけしたりされるのでしょうか？",
            "Chinese": "休息日他会带孩子外出吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:43:14",
            "content": "今はコロナの影響がありほとんどでかけてないですが、庭でボールや鬼ごっことかして遊んでくれます。",
            "Chinese": "现在因为疫情影响基本不怎么出门，但他会在院子里陪孩子玩球或者捉迷藏。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:44:13",
            "content": "そうなんですねお子様とは遊んでくれるのですね",
            "Chinese": "是这样啊，他会陪孩子玩呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:44:49",
            "content": "子どもに対してはとても優しくていいお父さんだと思います",
            "Chinese": "我觉得他对孩子非常温柔，是个好父亲。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:45:03",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:46:05",
            "content": "お子さんの面倒をよく見てくれるのですね",
            "Chinese": "他很会照顾孩子呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:46:21",
            "content": "そうですね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:46:33",
            "content": "ご主人はどんな人柄でしょうか？",
            "Chinese": "您先生是个怎样性格的人呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:47:04",
            "content": "物静かな人です。",
            "Chinese": "他是个很安静的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:47:30",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/06/17(水) 20:47:31",
            "content": "だけど、女の人がとにかく大好きで…",
            "Chinese": "但是，他就是特别喜欢女人……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:49:13",
            "content": "そうでしたか・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/06/17(水) 20:50:14",
