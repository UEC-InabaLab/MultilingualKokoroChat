{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:22:10",
            "content": "こんばんは！今日はよろしくお願いします！",
            "Chinese": "晚上好！今天请多多指教！"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:23:22",
            "content": "こんばんは、よろしくお願いします",
            "Chinese": "晚上好，请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:23:55",
            "content": "時間前ですがはじめますか？？",
            "Chinese": "时间还没到，我们现在开始吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:24:07",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:24:36",
            "content": "わかりました！でははじめますねー。",
            "Chinese": "好的！那我们就开始吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:25:20",
            "content": "こんばんは！初めまして、相談員です。今日はどうされましたか？？",
            "Chinese": "晚上好！初次见面，我是咨询师。今天您想聊些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:25:39",
            "content": "こんばんはよろしくお願いします",
            "Chinese": "晚上好，请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:25:55",
            "content": "よろしくお願いします。",
            "Chinese": "也请您多多指教。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:26:05",
            "content": "妹が許せないのです",
            "Chinese": "我实在无法原谅我妹妹。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:26:23",
            "content": "妹が許せないのですね。。",
            "Chinese": "您无法原谅您妹妹呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:26:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:26:57",
            "content": "何があったのかお話しできますか？？",
            "Chinese": "您能跟我说说发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:27:10",
            "content": "はい",
            "Chinese": "可以。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:27:38",
            "content": "妹と絶縁しています",
            "Chinese": "我和妹妹已经断绝关系了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:27:50",
            "content": "ええはい。",
            "Chinese": "嗯，明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:28:25",
            "content": "それはとても悲しいですよね。。",
            "Chinese": "那确实让人很难过呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:28:49",
            "content": "そうでもないです",
            "Chinese": "倒也不是那样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:29:38",
            "content": "そうだったのですね。。どうしてそう思われるのでしょうか？",
            "Chinese": "是这样啊。您为什么会这么觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:31:21",
            "content": "ここ数年妹が病気で入院しているのですが、先月余命宣告されました",
            "Chinese": "这几年我妹妹因病住院，上个月被告知时日无多了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:31:40",
            "content": "ええはい",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:31:54",
            "content": "親戚が知らせてくれました",
            "Chinese": "是亲戚告诉我的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:32:18",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:32:45",
            "content": "妹のお見舞いには、一度も行っていません",
            "Chinese": "我一次都没有去探望过妹妹。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:33:07",
            "content": "一度も行かれてないんですね。。",
            "Chinese": "您一次都没有去探望过呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:33:21",
            "content": "はい、そうなんです",
            "Chinese": "是的，就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:34:22",
            "content": "なんで行かれなかったのですか？",
            "Chinese": "您为什么没有去探望呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:35:15",
            "content": "妹は、母が施設に入所させるのに反対でした",
            "Chinese": "我妹妹反对把母亲送进养老院。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:35:51",
            "content": "そのために、、、",
            "Chinese": "因为这个……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:35:58",
            "content": "ええはい。。",
            "Chinese": "嗯，我懂……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:36:27",
            "content": "私は、母の介護をしていました",
            "Chinese": "一直是我在照顾母亲。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:36:32",
            "content": "そして",
            "Chinese": "然后……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:36:38",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:37:45",
            "content": "恋人の海外赴任が決まり、母を施設に入所させて、結婚することにしました、",
            "Chinese": "我的恋人决定派驻海外，于是我决定让母亲住进养老院，然后结婚。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:38:06",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:38:43",
            "content": "存命だった父も賛成してくれました",
            "Chinese": "当时还在世的父亲也同意了。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:39:10",
            "content": "しかし、妹が大反対しました",
            "Chinese": "但是，妹妹强烈反对。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:39:18",
            "content": "ええはい",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:40:29",
            "content": "私が結婚のために、母を入所しようとすると、激しく起こり、私を罵倒しました",
            "Chinese": "我为了结婚，准备让母亲入住养老院时，她勃然大怒，还辱骂我。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:41:10",
            "content": "でも、",
            "Chinese": "但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:41:18",
            "content": "ええはい",
            "Chinese": "嗯，我在听。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:42:18",
            "content": "私が結婚をしようとすると、妹は、私の結婚を破断にしました",
            "Chinese": "我正准备结婚时，妹妹搅黄了我的婚事。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:43:15",
            "content": "妹は、母を入所させたくないのです",
            "Chinese": "妹妹就是不想让母亲住进养老院。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:44:35",
            "content": "そうだったんですね、、それは本当にお辛いですよね、、、",
            "Chinese": "原来是这样……那对您来说真的很辛苦、很难受啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:44:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:45:44",
            "content": "ずっとあなたは頑張られていたのに本当に悲しいですよね。。。",
            "Chinese": "您一直那么努力，却遇到这种事，真的太令人难过了。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:46:37",
            "content": "HAI",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:48:07",
            "content": "だから妹さんがどうしても許せない・・・それは本当に憎くて仕方ないですよね。。",
            "Chinese": "所以您无论如何都无法原谅妹妹……这确实让人感到无比憎恨呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:49:16",
            "content": "はい、ソレダケデハ　ナイデス",
            "Chinese": "是的，但不只是这样。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:49:26",
            "content": "すみません",
            "Chinese": "不好意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:49:42",
            "content": "ええはい。お聞かせください。",
            "Chinese": "嗯，好的。请您继续说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:49:55",
            "content": "いえいえ大丈夫ですよ。。",
            "Chinese": "不不，没关系的……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:51:02",
            "content": "母が、要介護のとき、妹は2人目の出産で、介護は手伝いませんでっした。無理もないのは分かります。",
            "Chinese": "母亲需要照护的时候，妹妹正在生第二个孩子，没有来帮忙。我理解她也是没办法。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:51:20",
            "content": "ええはい。。",
            "Chinese": "嗯，我明白……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:53:13",
            "content": "あの、一人で話ししていたので、どうぞ、進めてくださいませ",
            "Chinese": "那个，刚才一直是我一个人在说，请您继续引导吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:54:31",
            "content": "お気になさらないでいいですよ。このお時間はあなたのお時間なのでどうぞお話しください。",
            "Chinese": "请不要在意。这段时间是属于您的，请畅所欲言。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:56:02",
            "content": "もう、話をすることは、ほとんど、ありません",
            "Chinese": "我差不多已经没什么可说的了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:57:08",
            "content": "そうだったのですね。わかりました。。",
            "Chinese": "是这样啊，我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:57:23",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 19:57:41",
            "content": "ずっと頑張られていたんですね・・",
            "Chinese": "您一直都在努力撑着啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 19:58:07",
            "content": "そうなのでしょうか",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:00:06",
            "content": "私はお聴きした感じそう思いますよ。。",
            "Chinese": "从您所说的来看，我是这么觉得的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:00:48",
            "content": "それに",
            "Chinese": "而且……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:02:39",
            "content": "妹さんにも気を使ってらっしゃったのでとてもお優しい方だと思いますがいかがでしょうか？",
            "Chinese": "您也曾体谅过您的妹妹，我觉得您是一位非常善良的人，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:03:22",
            "content": "気は使っていません",
            "Chinese": "我没有体谅她。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:05:58",
            "content": "すいません言い方が悪かったです。あなたの時間を削ってまでずっと頑張られていたのでとてもお優しい方だと感じましたがいかがでしょうか？？",
            "Chinese": "抱歉，我的表达方式不太好。我的意思是，您牺牲自己的时间一直努力着，让我觉得您非常善良，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:07:11",
            "content": "そうですね",
            "Chinese": "说得也是。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:07:54",
            "content": "ちなみにこの出来事は最近のお話でしょうか？",
            "Chinese": "顺便问一下，这些事情是最近发生的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:08:43",
            "content": "最近の話ですが、絶縁になってから7年が立ちます",
            "Chinese": "虽然是最近的事，但我们断绝关系已经7年了。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:09:30",
            "content": "7年間、一度もあっていません",
            "Chinese": "7年里，一次都没见过面。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:11:43",
            "content": "そうだったのですね・・最後はどんなお話をして会わなくなったのですか？",
            "Chinese": "是这样啊……最后一次见面时说了什么，之后就不再见面了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:13:47",
            "content": "結婚破断にされて、母の介護も手伝わずに、何も会話していません。喧嘩で終わりました",
            "Chinese": "她搅黄了我的婚事，也不帮忙照顾母亲，我们之间再也没什么好说的。最后是以吵架收场的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:14:44",
            "content": "妹は、先程言いましたが、余命宣告を受けています",
            "Chinese": "我妹妹，就像刚才说的，已经被告知时日无多了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:15:14",
            "content": "喧嘩別れが最後だったのですね。。それはとても許せませんよね。あなたはずっと頑張っていたのに。。。",
            "Chinese": "最后一次是以吵架收场的啊……那真的很难原谅呢。明明您一直那么努力……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:15:33",
            "content": "ええはい",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:15:34",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:17:07",
            "content": "最後まで、妹に会わないと、夫や親戚にどう思われるかも、気になります",
            "Chinese": "如果到最后都不去见妹妹，我也很在意丈夫和亲戚会怎么看我。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:18:42",
            "content": "そうだったのですね。。許せなくても会いに行かなければ周りの方の反応が怖いですよね。。。",
            "Chinese": "原来如此。即使无法原谅，但如果不见面，又会担心周围人的反应，是这样吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:19:28",
            "content": "怖いというより、どうしたら良いのかなと、思いまして",
            "Chinese": "与其说是害怕，不如说我是在想究竟该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:20:11",
            "content": "そうだったのですね。では今のあなたはどうしたいですか？",
            "Chinese": "是这样啊。那么，您自己内心更倾向于怎么做呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:21:05",
            "content": "妹さんは余命宣告を受けていますが、介護もせず、結婚を破断にされたとゆう事ですが、",
            "Chinese": "您的妹妹时日无多，但她既没有帮忙照顾母亲，还搅黄了您的婚事，在这种情况下，"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:21:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:22:15",
            "content": "お会いできます？",
            "Chinese": "您能去见她吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:22:47",
            "content": "わからないので、悩んでいます",
            "Chinese": "我不知道，所以很纠结。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:23:15",
            "content": "妹に会わないでいて、公開しないのか・・・？",
            "Chinese": "如果不去见妹妹，将来会不会后悔呢……？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:23:29",
            "content": "後悔です",
            "Chinese": "是“后悔”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/18(金) 20:24:11",
            "content": "そうですよね、、後悔するのかが分からないので悩みますよね。。",
            "Chinese": "是啊……正因为不知道会不会后悔，所以才会犹豫不决，对吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:24:25",
            "content": "そうなんです",
            "Chinese": "是的，就是这样。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/18(金) 20:25:25",
            "content": "葬式はどうしたらよいかとかも",
            "Chinese": "还有葬礼该怎么办之类的事。"
        },
        {
