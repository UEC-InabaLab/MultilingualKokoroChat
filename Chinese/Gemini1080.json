{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:52:38",
            "content": "お疲れ様です！こちらは「カウンセラー・いじめ相談」です。どうぞよろしくお願いします",
            "Chinese": "您好！这里是“霸凌问题咨询”。请多指教。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:53:55",
            "content": "こんにちは。こちらこそよろしくお願いします",
            "Chinese": "您好。也请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:01:01",
            "content": "こんにちは 相談員です。よろしくお願いします。",
            "Chinese": "您好，我是咨询员。请多多指教。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:01:22",
            "content": "よろしくお願いします",
            "Chinese": "请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:01:29",
            "content": "はい、お願いします。",
            "Chinese": "好的，请讲。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:01:36",
            "content": "ご相談頂くにあたって、性別、年齢、また今日はなんとお呼びすれば良いか、",
            "Chinese": "在开始咨询前，可以请您告诉我您的性别、年龄，以及今天我该怎么称呼您吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:01:40",
            "content": "答えられる範囲で教えていただいてもいいでしょうか？",
            "Chinese": "在您方便回答的范围内告诉我就可以。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:01:46",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:02:14",
            "content": "じょし",
            "Chinese": "女生。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:02:42",
            "content": "14",
            "Chinese": "14岁。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:03:23",
            "content": "そうだったんですね。教えてくれてありがとうございます。",
            "Chinese": "是这样啊。谢谢你告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:04:12",
            "content": "今日はどんなご相談でしたか？",
            "Chinese": "今天想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:05:08",
            "content": "学校でムシされたりいやなことされます",
            "Chinese": "在学校会被人无视，还会被做一些让人难受的事。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:05:22",
            "content": "だから学校行きたくなくて",
            "Chinese": "所以我不想去学校。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:05:32",
            "content": "なるほど、そうだったんですね…",
            "Chinese": "原来是这样啊…"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:05:34",
            "content": "休んだりする",
            "Chinese": "所以有时会请假。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:05:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:05:51",
            "content": "無視されるの、嫌だよね。。",
            "Chinese": "被人无视，确实很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:06:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:06:18",
            "content": "嫌なことがあって、学校行きたくなくなるの、全然おかしくないと思いますよ。",
            "Chinese": "因为发生了不愉快的事而不想去上学，我觉得这很正常。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:06:28",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:07:17",
            "content": "教室のこととか、想像すると…嫌になるよね。",
            "Chinese": "一想到教室里的事情...就觉得很烦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:07:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:07:35",
            "content": "学校は好きだった？",
            "Chinese": "你以前喜欢学校吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:07:47",
            "content": "きらいです",
            "Chinese": "讨厌。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:07:57",
            "content": "そうなんだね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:08:56",
            "content": "きらいだし辛かったから、学校には行きたくないんですよね。",
            "Chinese": "因为既讨厌又痛苦，所以才不想去学校的，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:09:01",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:09:17",
            "content": "普段はおうちですか？",
            "Chinese": "平时都待在家里吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:09:48",
            "content": "休んだ日は家にいます",
            "Chinese": "请假的日子会待在家里。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:10:03",
            "content": "そうなんですね。家にいると少しは安心できる？",
            "Chinese": "是这样啊。待在家里会让你感到安心一点吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:10:46",
            "content": "安心っていうか楽です",
            "Chinese": "与其说是安心，不如说是轻松。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:11:03",
            "content": "なるほど、そうなんだね",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:12:18",
            "content": "家だと安全だもんね、行きたくないのも当然だと思います",
            "Chinese": "在家里很安全嘛，不想去学校也是理所当然的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:12:29",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:12:58",
            "content": "今は、どんな風に悩んでる…？学校に行けって言われちゃったりしたのかな",
            "Chinese": "现在，你主要在为哪些事烦心呢……？是不是有人会对你说“必须去上学”之类的话？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:13:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:13:24",
            "content": "休むと言われる",
            "Chinese": "一说要请假就会被念叨。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:13:28",
            "content": "うん、うん",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:13:37",
            "content": "それは親から…？",
            "Chinese": "是父母说的吗…？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:13:58",
            "content": "親からもだし",
            "Chinese": "父母会这么说，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:14:03",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:14:12",
            "content": "ばあちゃんからも",
            "Chinese": "奶奶也会。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:14:16",
            "content": "言われる",
            "Chinese": "都会说我。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:14:18",
            "content": "そうなんだ、、",
            "Chinese": "这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:14:37",
            "content": "辛いから休みたいのに、そんな風に言われたらもっと嫌になるよね。。",
            "Chinese": "明明是因为痛苦才想休息，却被那样说，会更讨厌吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:14:51",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:15:13",
            "content": "つらかったよね…。",
            "Chinese": "你一定很难过吧..."
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:15:23",
            "content": "いじめられてんのか？とか…",
            "Chinese": "他们会问“你是不是被欺负了？”之类的话…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:15:27",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:15:32",
            "content": "言い返せ",
            "Chinese": "“顶回去”。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:15:35",
            "content": "とか",
            "Chinese": "之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:15:37",
            "content": "なるほど、、",
            "Chinese": "原来如此……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:15:41",
            "content": "…",
            "Chinese": "…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:16:02",
            "content": "できてたら…休んでないよっ…って感じだよね",
            "Chinese": "感觉就是...“如果我做得到...我就不会请假了啊”...对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:16:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:16:20",
            "content": "じゃあ、親やおばあちゃんが",
            "Chinese": "那么，如果你的父母和奶奶"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:16:28",
            "content": "ちゃんと何がつらいのかとか聞いてくれると",
            "Chinese": "能好好听听你到底为什么痛苦，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:16:37",
            "content": "今よりは少し楽になれそう？",
            "Chinese": "会不会比现在好受一点？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:16:47",
            "content": "いや…",
            "Chinese": "不…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:16:50",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:17:01",
            "content": "言われたり",
            "Chinese": "他们只会说"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:17:08",
            "content": "うん、うん",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:17:29",
            "content": "やられる方が弱いからだって",
            "Chinese": "是因为被欺负的人自己太弱了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:17:38",
            "content": "言うだけだし",
            "Chinese": "他们只会这么说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:18:06",
            "content": "そうか…話したところで、聞いてくれないんだね",
            "Chinese": "这样啊…就算说了，他们也听不进去，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:18:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:18:39",
            "content": "先生も優等生ばかり話聞くしね",
            "Chinese": "老师也只听优等生的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:18:46",
            "content": "嘘",
            "Chinese": "怎么会这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:18:50",
            "content": "ひどいね",
            "Chinese": "太过分了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:19:12",
            "content": "優等生はいいこ→信頼度たかい",
            "Chinese": "在他们眼里，优等生=好孩子→所以可信度高。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:19:31",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:19:46",
            "content": "調子いいこといって",
            "Chinese": "他们只会说些好听的话，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:19:55",
            "content": "なあなあで終わるし",
            "Chinese": "然后事情就不了了之了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:20:11",
            "content": "なるほど…こっちの話は聞いてもらえない？",
            "Chinese": "我明白了……所以他们不听你这边的说法吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:20:21",
            "content": "思い過ごしっていわれる",
            "Chinese": "他们会说是我“想多了”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:20:29",
            "content": "ええ？？",
            "Chinese": "咦？怎么会？？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:20:40",
            "content": "気のせいとか",
            "Chinese": "或者说是我的错觉之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:20:43",
            "content": "それは嫌になっても仕方ないよ",
            "Chinese": "那样的话，你会感到厌烦也是理所当然的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:20:51",
            "content": "考えすぎとか",
            "Chinese": "还说我“想太多了”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:21:06",
            "content": "その気持ちが",
            "Chinese": "那种心情，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:21:08",
            "content": "うん、嫌になる",
            "Chinese": "嗯，让人很烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:21:16",
            "content": "もしも少しでも届いたら。。って思うよね",
            "Chinese": "你会想...要是能传达到一点点也好...对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:21:21",
            "content": "ちゃんと聞いてほしいよね",
            "Chinese": "你希望他们能好好听你说，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:21:34",
            "content": "うん…",
            "Chinese": "嗯…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:21:41",
            "content": "教えてくれて本当にありがとね",
            "Chinese": "真的很谢谢你告诉我这些。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:21:42",
            "content": "むりだけどね",
            "Chinese": "虽然不可能就是了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:22:22",
            "content": "実際に話をしようとしても、",
            "Chinese": "就算真的想跟他们说，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:22:28",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:22:33",
            "content": "こっちも相手のこと信頼してないから",
            "Chinese": "因为你也不信任对方，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:22:43",
            "content": "言葉もあんまり出てこなかったりするよね。。",
            "Chinese": "所以很多话也说不出口了，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:23:01",
            "content": "はい…",
            "Chinese": "是的…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:23:15",
            "content": "今まで無視されたり嫌なことあって、辛くて学校休んでるのに…それを相談しようとして、",
            "Chinese": "一直以来被无视、被欺负，因为太痛苦而请假不去上学…你好不容易想找人商量，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:23:42",
            "content": "聞いて欲しかったのに、親もおばあちゃんも、先生も思い過ごしだ、とか",
            "Chinese": "希望他们能听你说，结果不管是父母、奶奶，还是老师，都说是你想多了，或者"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:23:58",
            "content": "言い返せ、とか…ぜんぜん心に寄り添ってくれないんだよね",
            "Chinese": "让你反击回去...完全没有体谅你的心情，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:24:11",
            "content": "うゎ",
            "Chinese": "哇…"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:24:23",
            "content": "ほんとそのとおり",
            "Chinese": "真的就是那样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:24:34",
            "content": "それは本当に嫌だと思うよ。つらかったよね",
            "Chinese": "我觉得那真的很难受。你一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:24:37",
            "content": "全くわかってくんない",
            "Chinese": "他们完全不理解。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:24:44",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:24:53",
            "content": "なんというか、これは私の考えだけど",
            "Chinese": "怎么说呢，这只是我的想法，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:25:04",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:25:57",
            "content": "すごく、一緒に「宣誓！」ってやりたい。",
            "Chinese": "我非常想和你一起进行一个“宣誓！”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:26:24",
            "content": "宣誓！私はこれだけつらかった！話を聞いてもらえないのも言い返せと言われるのも嫌だ！",
            "Chinese": "宣誓！我就是这么痛苦！我讨厌他们不听我说话，也讨厌他们叫我反击回去！"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:26:40",
            "content": "ほんと",
            "Chinese": "真的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:26:42",
            "content": "だから行きたくないんだ。つらいんだ。",
            "Chinese": "所以我才不想去上学。我真的很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:26:47",
            "content": "少しでも届かせたいよね。。。。。",
            "Chinese": "希望能传达到一点点也好啊…"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:26:56",
            "content": "いえたらいいのに",
            "Chinese": "要是能说出口就好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:27:05",
            "content": "もしよかったら、手紙にするのもありかもしれない",
            "Chinese": "如果可以的话，写成信也许是个方法。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:27:23",
            "content": "それか、紙に宣誓を書いて、部屋の扉に貼って出てこない！とか",
            "Chinese": "或者，把宣誓写在纸上，贴在房门上，然后不出来！之类的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:27:43",
            "content": "あぁ…",
            "Chinese": "啊…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:27:45",
            "content": "聞いてもらいたい本気さを見せつけてやる…みたいのもいいかもしれないね",
            "Chinese": "让他们看看你有多认真地想被倾听...这样或许也不错呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:28:02",
            "content": "どう思う…？",
            "Chinese": "你觉得呢…？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:28:40",
            "content": "部屋のドアに貼っときたいけど鍵ないからなあ",
            "Chinese": "虽然想贴在房门上，但是门没有锁啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:29:03",
            "content": "ほうきとかカバンで封鎖できるかも",
            "Chinese": "也许可以用扫帚或者书包把门堵住。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:29:04",
            "content": "鍵があったらやってやりたい",
            "Chinese": "要是有锁的话，我真想这么做。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:29:25",
            "content": "こうやって今話してて",
            "Chinese": "像现在这样聊着聊着，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:29:32",
            "content": "「やってやりたい！」って思えたよね",
            "Chinese": "你是不是也产生了“真想这么做！”的想法？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:29:33",
            "content": "用それでも入ってこられたから…",
            "Chinese": "因为就算那样他们也还是会进来…"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:29:51",
            "content": "うん、思えました",
            "Chinese": "嗯，我是这么想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:30:05",
            "content": "私は、今日話しててあなたの心って強いなって感じたよ。",
            "Chinese": "今天和你聊了之后，我感觉你的内心很强大哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:30:14",
            "content": "やってやりたい！と思えない人もいるはずだから",
            "Chinese": "因为应该也有人连“真想这么做！”的想法都产生不了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:30:37",
            "content": "そうかなあ?",
            "Chinese": "是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:31:03",
            "content": "やってやりたい、と思うけど、むりかな、みたいに",
            "Chinese": "虽然想这么做，但又觉得，可能不行吧，类似这样。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:31:05",
            "content": "まあ、そうかもしれないけど…",
            "Chinese": "嗯，也许是这样吧…"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:31:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:31:15",
            "content": "ちょっと冷静になっちゃう感じ、ある？",
            "Chinese": "会有一种，稍微冷静下来的感觉，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:31:39",
            "content": "冷静っていうか…",
            "Chinese": "与其说是冷静…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:31:46",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:32:02",
            "content": "やってみてだめだったし",
            "Chinese": "因为试过了，但不行。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:32:16",
            "content": "そうか、そうだよね。",
            "Chinese": "是吗，说得也是。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:32:28",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:32:44",
            "content": "でも…それってもしかすると",
            "Chinese": "但是…那或许"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:33:02",
            "content": "あなたが、まわりより少しはやく、大人になったからなのかもしれないね",
            "Chinese": "是因为你比周围的人更早一点成熟了吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:33:21",
            "content": "??大人ですか？",
            "Chinese": "??成熟了吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:33:47",
            "content": "そう。子どものままだったら…やってみてだめで、諦めよう…ってならないんじゃないかな",
            "Chinese": "是的。如果还是小孩子的话…可能就不会在尝试失败后，想着“放弃吧…”了，不是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:34:25",
            "content": "でも昔から諦め早いからなあ…",
            "Chinese": "但是我从小就很容易放弃啊…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:34:45",
            "content": "諦めが早いのって",
            "Chinese": "容易放弃，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:35:00",
            "content": "判断力があるからなのかもしれないよ…？",
            "Chinese": "说不定是因为你很有判断力哦…？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:35:21",
            "content": "そうなんですか？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:35:39",
            "content": "これ以上続けても無駄だ、って、実際に見る前に思えるわけだから",
            "Chinese": "因为你能在实际看到结果前就想到“再继续下去也是白费力气”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:35:49",
            "content": "そうすると…あなたは賢いから…",
            "Chinese": "这样的话…因为你很聪明…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:36:02",
            "content": "きっと、立ち向かえるよ。気持ちを、伝えられるよ",
