{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:00:17",
            "content": "（本日は、ありがとうございます。 よろしくお願い致します。 定刻になったら、始めさせて頂きますね。）",
            "Chinese": "（今天非常感谢您。请多关照。时间一到，我们就开始吧。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:00:28",
            "content": "こんにちは、相談員です。 本日はご相談にお越し下さり、ありがとうございます。  はじめに、年齢、性別、ご相談内容を聞かせていただけますか？",
            "Chinese": "您好，我是咨询师。非常感谢您今天前来咨询。首先，可以请您告诉我您的年龄、性别和咨询的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:01:10",
            "content": "よろしくお願いします。17歳、女子、学校行くのがつまらない。です。",
            "Chinese": "请多关照。17岁，女生，觉得上学很无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:01:51",
            "content": "有難うございます。学校へ行くのつまらないのですね。それは、お辛いですね。",
            "Chinese": "谢谢您。是觉得上学很无聊是吗？那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:01:59",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:02:54",
            "content": "もう少し詳しく聞かせたいただきたいのですが、宜しければ、どう言った理由でつまらないのか聞かせていただけませんでしょうか？",
            "Chinese": "我想了解得更详细一些，如果方便的话，能告诉我您觉得无聊的具体原因是什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:03:17",
            "content": "理由は、よく分からない",
            "Chinese": "原因，我也不太清楚。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:03:23",
            "content": "いじめられてもいない",
            "Chinese": "也没有被人欺负。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:03:38",
            "content": "よく分からないのですね。",
            "Chinese": "您自己也不太清楚是吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:03:43",
            "content": "でも、学校が面倒くさい",
            "Chinese": "但是，就是觉得上学很麻烦。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:03:47",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:04:00",
            "content": "行き違い、失礼致しました。",
            "Chinese": "抱歉，刚才可能有些误解。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:04:08",
            "content": "全然大丈夫",
            "Chinese": "完全没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:04:29",
            "content": "学校が面倒くさいと感じられてるているのですね。",
            "Chinese": "您是感觉上学很麻烦是吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:04:35",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:04:40",
            "content": "面倒い",
            "Chinese": "好麻烦。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:04:45",
            "content": "だるい",
            "Chinese": "好累，提不起劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:04:57",
            "content": "有難うございます。それは、いつ頃からでしょうか？",
            "Chinese": "谢谢。这种感觉大概是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:05:18",
            "content": "うーん3年になってからかな",
            "Chinese": "嗯……大概是升上高三之后吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:06:07",
            "content": "３年生になってからなのですね。",
            "Chinese": "是从高三开始的啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:06:12",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:06:50",
            "content": "なるほど、学校には行けているのでしょうか？",
            "Chinese": "我明白了。现在还能正常去上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:07:01",
            "content": "いちを行ってる",
            "Chinese": "算是有在去。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:07:05",
            "content": "サボってはいない",
            "Chinese": "也没有逃课。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:08:12",
            "content": "学校へは行けているのですね。つまらないとお感じになっているのにそこは素晴らしいですね＾＾",
            "Chinese": "您还是坚持去学校了呢。在感觉无聊的情况下还能做到这一点，真的很了不起啊＾＾"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:08:27",
            "content": "ありがとう",
            "Chinese": "谢谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:09:26",
            "content": "例えば、今後の進路はどうお考えですか？",
            "Chinese": "比如说，您对未来的发展有什么想法吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:09:51",
            "content": "受験は、する…と思う",
            "Chinese": "升学考试……我想我会参加的……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:10:05",
            "content": "周りもやってるし",
            "Chinese": "因为周围的同学们也都在准备。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:10:42",
            "content": "なるほど、進学をお考えなのですね。",
            "Chinese": "这样啊，您是考虑要继续升学是吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:10:48",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:11:03",
            "content": "ありがとうございます＾＾",
            "Chinese": "谢谢您＾＾"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:11:32",
            "content": "うん(emoji)",
            "Chinese": "嗯(emoji)"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:11:59",
            "content": "今後の何かやりたい事や、将来なりたい自分というの漠然とでも良いので何かありますでしょうか？",
            "Chinese": "对于未来，您有没有什么想做的事，或者想成为怎样的人呢？即使是模糊的想法也没关系。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:12:36",
            "content": "うーんこれってモノが今はないかな…",
            "Chinese": "嗯——现在好像没有一个明确的东西……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:13:51",
            "content": "そうなのですね。有難うございます＾＾今はないと言う事でしたが、その前は何か没頭されていた事があったり知るのでしょうか？",
            "Chinese": "是这样啊，谢谢您＾＾您说现在没有，那以前有过什么让您沉浸其中的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:14:14",
            "content": "うんあった",
            "Chinese": "嗯，有的。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:14:20",
            "content": "部活ずっとやってて",
            "Chinese": "我之前一直在参加社团活动。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:14:31",
            "content": "それがめちゃくちゃ楽しかった",
            "Chinese": "那个真的超级开心。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:14:33",
            "content": "毎日",
            "Chinese": "每一天都很开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:14:43",
            "content": "ありがとうございます＾＾部活をされていたのですね。",
            "Chinese": "谢谢您＾＾原来您一直在参加社团活动啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:14:48",
            "content": "そー",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:15:25",
            "content": "それが、毎日楽しくて、、、ちなみに何の競技をされていたのでしょうか？",
            "Chinese": "每天都过得很开心……顺便问一下，您参加的是什么竞技项目呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:15:37",
            "content": "競技…と言うか",
            "Chinese": "与其说是“竞技”……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:15:42",
            "content": "吹奏楽",
            "Chinese": "是管乐团。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:16:02",
            "content": "吹奏楽ですか＾＾失礼しました。",
            "Chinese": "是管乐团啊＾＾抱歉，是我失礼了。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:16:13",
            "content": "大丈夫(emoji)",
            "Chinese": "没关系(emoji)"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:17:15",
            "content": "部活が楽しくて毎日毎日素敵ですね＾＾吹奏楽ですと、お仲間との絆も強かったのではないでしょうか？",
            "Chinese": "社团活动每天都那么开心，真好啊＾＾既然是管乐团，想必您和伙伴们的羁绊也很深厚吧？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:17:26",
            "content": "そーなの",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:17:34",
            "content": "毎日友達と一緒で",
            "Chinese": "每天都和朋友们在一起，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:17:42",
            "content": "練習辛くても",
            "Chinese": "即使练习很辛苦，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:17:46",
            "content": "毎日楽しかった",
            "Chinese": "但每天都很开心。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:17:56",
            "content": "2年で引退で",
            "Chinese": "高二的时候退出了社团，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:18:07",
            "content": "つまらなくなった",
            "Chinese": "然后就变得无聊了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:18:34",
            "content": "そうなのですね。毎日一つの目標に向かって友達と毎日楽しく、充実されていたのですね",
            "Chinese": "是这样啊。那段时间您每天和朋友们为了一个共同的目标而努力，过得既开心又充实吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:18:45",
            "content": "そーなのそーなの",
            "Chinese": "对对对！"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:18:51",
            "content": "目標があって",
            "Chinese": "因为有目标，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:19:00",
            "content": "みんなで練習するのが",
            "Chinese": "大家一起练习这件事，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:19:08",
            "content": "今思うとめちゃくちゃ楽しかったなって",
            "Chinese": "现在回想起来，真的超级开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:19:35",
            "content": "思いを有難うございます＾＾それが、急に無くなるのはぽっかり穴が空いてしまった様な感覚なのでしょうか？",
            "Chinese": "谢谢您分享这些心情＾＾当那些一下子没了时，会不会感觉心里像是被掏空了一块呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:19:48",
            "content": "そーかも…",
            "Chinese": "可能是吧……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:20:04",
            "content": "なんか毎日つまらなくなっちゃだて",
            "Chinese": "总觉得每天都变得无聊了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:20:19",
            "content": "なるほど、それはそうなっても仕方ないですよね",
            "Chinese": "我明白了，发生那样的事，会感到无聊也是难免的。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:20:25",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:21:20",
            "content": "毎日、充実されていた物目標、あるものが無くなってしまって何に、向かっていっていいか分からな感覚でしょうか？",
            "Chinese": "每天让您感到充实的目标突然没有了，是不是有一种不知道该朝什么方向努力的感觉？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:21:30",
            "content": "うんそーかも",
            "Chinese": "嗯，可能是这样。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:21:33",
            "content": "とりあえず",
            "Chinese": "暂时嘛，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:21:36",
            "content": "受験だから",
            "Chinese": "因为要升学考试，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:21:42",
            "content": "塾行ってるけど",
            "Chinese": "我有在上补习班，但——"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:21:49",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:21:50",
            "content": "毎日勉強勉強勉強勉強",
            "Chinese": "每天就是学学学学，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:21:57",
            "content": "で",
            "Chinese": "然后——"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:22:00",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:22:04",
            "content": "なんか",
            "Chinese": "就是感觉，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:22:10",
            "content": "目標が遠いし",
            "Chinese": "目标又很遥远，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:22:14",
            "content": "でも",
            "Chinese": "但是，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:22:16",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:22:20",
            "content": "今からやらなきゃ",
            "Chinese": "现在不开始做的话，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:22:25",
            "content": "絶対間に合わないから",
            "Chinese": "就肯定来不及了，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:22:35",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:22:35",
            "content": "勉強しなきゃだし",
            "Chinese": "所以必须学习，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:22:54",
            "content": "やる事(勉強)はいっぱいあるのに",
            "Chinese": "明明要做的事（学习）一大堆，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:23:03",
            "content": "やる気がしないって言うか",
            "Chinese": "却又提不起劲儿，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:23:28",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:23:38",
            "content": "でも",
            "Chinese": "可是，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:23:43",
            "content": "受験は、焦る",
            "Chinese": "对升学考试，又很焦虑，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:24:00",
            "content": "間に合わなかったらどーしよーとも思う",
            "Chinese": "也会想“要是来不及了可怎么办”。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:24:28",
            "content": "焦ってしまうのですね",
            "Chinese": "您会感到焦虑是吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:24:34",
            "content": "そー",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:24:40",
            "content": "焦る",
            "Chinese": "很焦虑。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:25:06",
            "content": "そうなのですね。なぜ、勉強をしないと行けないのかなぜ、大学に行かないと行けないのかがないと、中々やる気が出てこないですよね。",
            "Chinese": "是这样啊。如果没有一个明确的“为什么要学习”、“为什么要上大学”的理由，确实很难提起干劲呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:25:24",
            "content": "そーかも",
            "Chinese": "可能是这样。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:25:38",
            "content": "とりあえず勉強してる感じだから",
            "Chinese": "因为现在就只是“先学着再说”的感觉，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:25:39",
            "content": "かも",
            "Chinese": "大概是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:25:58",
            "content": "もう一度、聞かせて頂きたいのですが",
            "Chinese": "我想再问您一次，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:26:04",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:26:33",
            "content": "吹奏楽部の時は目標があったりしたのでしょうか＾＾",
            "Chinese": "在管乐团的时候，是不是有明确的目标呢？＾＾"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:26:45",
            "content": "そー",
            "Chinese": "有的。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:27:00",
            "content": "目標が細かくあって",
            "Chinese": "目标都划分得很细，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:27:07",
            "content": "どんな、目標か聞かせていただいて良いでしょうか＾＾",
            "Chinese": "可以和我说说都是些什么样的目标吗？＾＾"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:27:08",
            "content": "3ヶ月後に",
            "Chinese": "比如三个月后，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:27:14",
            "content": "うん",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:27:23",
            "content": "3ヶ月後にコンクールとか",
            "Chinese": "三个月后有比赛之类的，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:27:30",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:27:34",
            "content": "それが終わったら",
            "Chinese": "那个结束之后，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:27:43",
            "content": "ええ、ええ",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:27:49",
            "content": "また2〜3ヶ月後に文化祭があって…",
            "Chinese": "再过两三个月又有文化节……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:27:51",
            "content": "とか",
            "Chinese": "之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:28:05",
            "content": "ええ、なるほど",
            "Chinese": "嗯，原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:28:12",
            "content": "ここまでに仕上げなきゃ",
            "Chinese": "必须在某个时间点之前完成到位，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:28:19",
            "content": "って言う目標が",
            "Chinese": "这样的目标，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:28:24",
            "content": "細かくあって",
            "Chinese": "细细地分成很多，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:28:27",
            "content": "それに向かって",
            "Chinese": "然后朝着那些目标，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:28:38",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:28:40",
            "content": "みんなで曲決めて練習したり",
            "Chinese": "大家一起定曲目、一起练习，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:28:44",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:28:50",
            "content": "って言うのが",
            "Chinese": "这样的过程，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:28:55",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:28:56",
            "content": "スッゴく楽しかった",
            "Chinese": "特别特别开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:29:54",
            "content": "素敵ですね＾＾もちろん、吹奏楽自体のお好きだったのでしょうが何か目標に向かってみんなで取り組んでいけたのが凄く楽しかったんですね。",
            "Chinese": "真好啊＾＾当然，您肯定也喜欢管乐团本身，但更让您开心的，是和大家一起为了一个目标而努力的过程，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:30:07",
            "content": "そーなの",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:30:22",
            "content": "みんなで同じ思いで頑張ってる時が",
            "Chinese": "大家怀着同样的心情一起努力的时候，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:30:34",
            "content": "辛い事も乗り越えられると言うか",
            "Chinese": "会觉得连辛苦都能扛过去，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:30:40",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:30:54",
            "content": "達成した時もみんなで喜べるし",
            "Chinese": "达成目标的时候，也能和大家一起分享喜悦，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:31:02",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:31:06",
            "content": "頑張ったかいがある",
            "Chinese": "会觉得“努力真值得”，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:31:13",
            "content": "って充実感がすっごくあった",
            "Chinese": "那种充-实感特别强。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:31:31",
            "content": "なるほど、素敵ですね＾＾",
            "Chinese": "明白了，真的很美好呢＾＾"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:32:14",
            "content": "これは、私の主観ですが凄く素敵な高校生活を送られたんだなとお見受けしています＾＾",
            "Chinese": "这可能是我个人的看法，但我感觉您度过了一段非常美好的高中生活呢＾＾"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:32:26",
            "content": "ありがとう",
            "Chinese": "谢谢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:32:40",
            "content": "2年までは、本当に毎日楽しかった",
            "Chinese": "到高二为止，真的每天都很开心。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:32:58",
            "content": "でも、今受験で",
            "Chinese": "但是，现在要升学考试了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:33:04",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:33:18",
            "content": "受験って一人一人っていうか",
            "Chinese": "升学考试这种事，说到底就是各自为战，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:33:29",
            "content": "みんなで頑張るって感じじゃないし",
            "Chinese": "不是大家一起加油的那种感觉，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:33:42",
            "content": "みんな敵っていうか",
            "Chinese": "有点像大家都是对手，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:33:45",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:33:55",
            "content": "ピリピリしてるし",
            "Chinese": "气氛也很紧张，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:34:05",
            "content": "でも",
            "Chinese": "但是，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:34:17",
            "content": "1人受験をやめる勇気もない",
            "Chinese": "我也没有勇气一个人放弃考试。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:34:27",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:34:53",
            "content": "みんな敵、そうお感じになられているのですね",
            "Chinese": "您会觉得“大家都是对手”，是这样的感受啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:35:01",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:35:17",
            "content": "塾は",
            "Chinese": "在补习班里，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:35:20",
            "content": "成績で",
            "Chinese": "按成绩，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:35:23",
            "content": "クラスとか",
            "Chinese": "分班啦，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:35:25",
            "content": "席とか",
            "Chinese": "排座位啦，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:35:28",
            "content": "決まるし",
            "Chinese": "都是按成绩决定的，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:35:45",
            "content": "なるほどそれは、お辛いし、寂しいですよね",
            "Chinese": "原来如此，那确实很辛苦，也会感到孤单吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:35:52",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:36:01",
            "content": "部活の連帯感みたいなのがなくて",
            "Chinese": "没有了社团活动那种团结一心的感觉，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:36:06",
            "content": "寂しい",
            "Chinese": "很孤单。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:36:08",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:36:19",
            "content": "仕方がないって分かってるんだけど",
            "Chinese": "虽然我也懂这是没办法的事，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:36:25",
            "content": "寂しいとお感じになられているのですね",
            "Chinese": "但您还是会感到孤单啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:36:31",
            "content": "そー",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:36:38",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:36:44",
            "content": "有難うございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:36:57",
            "content": "これまでも、目標を持って頑張ってこられた相談者さんです。",
            "Chinese": "您一直以来都是一个为了目标而努力的人。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:37:04",
            "content": "(emoji)",
            "Chinese": "(emoji)"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:37:18",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:37:27",
            "content": "今は、受験のために受験をやっている状態",
            "Chinese": "现在有点像是“为了考试而考试”的状态，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:37:38",
            "content": "そーなの",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:38:00",
            "content": "何の為に、大学へ入るか何の為に知見を身につけるか",
            "Chinese": "为了什么要上大学，为了什么要学习知识——"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:38:22",
            "content": "これを、考えてみては如何でしょうか？＾＾",
            "Chinese": "试着思考一下这个问题怎么样？＾＾"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:38:31",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:38:40",
            "content": "そーかも",
            "Chinese": "可能是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:39:01",
            "content": "そして、それを今まで２年時間を共有した友達に",
            "Chinese": "然后，把这些想法和过去两年里一起奋斗的朋友们——"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:40:03",
            "content": "共有してみては如何でしょうか？同じ、目標を持って頑張ってこられたお仲間です。共感し合えるところ何かもあるのではないかと感じました＾＾",
            "Chinese": "分享一下怎么样？他们是和您为了同一个目标努力过的伙伴。我觉得你们之间一定有很多可以产生共鸣的地方＾＾"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:40:18",
            "content": "そっか〜",
            "Chinese": "这样啊～"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:40:26",
            "content": "部活引退してから",
            "Chinese": "退出社团之后，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:40:33",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:40:43",
            "content": "あんまり時間が合わなくて",
            "Chinese": "大家时间不太对得上，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:40:49",
            "content": "中々会えてなかったし",
            "Chinese": "也很难见上面，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:40:54",
            "content": "ええ、ええ",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:40:58",
            "content": "みんな忙しそうだから",
            "Chinese": "大家看起来都很忙，"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:41:12",
            "content": "そーいう話も出来てなかったな",
            "Chinese": "也就没怎么聊过这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:42:03",
            "content": "そうなのですね＾＾もし、相談者さんに友達からご連絡が来たらどうですか？嬉しいですか？",
            "Chinese": "是这样啊＾＾如果您的朋友主动联系您，您会怎么样呢？会开心吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:42:12",
            "content": "めちゃくちゃ嬉しい",
            "Chinese": "会超级开心的！"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:42:40",
            "content": "もしかしたら、その友達も相談者さんや周りに",
            "Chinese": "也许，您的朋友们也在顾虑您和周围的人，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/11(木) 10:43:20",
            "content": "気を遣って、同じ寂しい気持ちでも連絡していないと言うことがあるかもしれませんね＾＾",
            "Chinese": "所以即使怀着同样孤单的心情，也没有主动联系，或许有这种情况呢＾＾"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:43:28",
            "content": "そーかな？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:43:34",
            "content": "そー思う？",
            "Chinese": "你也这么觉得吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:43:42",
            "content": "相談員さんも",
            "Chinese": "咨询师您也是这么觉得的吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/11(木) 10:43:50",
            "content": "忙しいところ連絡来たら嬉しい？",
