{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:41:51",
            "content": "こちら、「カウンセラー・希死念慮」です。よろしくお願いします",
            "Chinese": "这里是“心理咨询师・自杀意念”专线。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:42:34",
            "content": "わかりました。よろしくお願いします。",
            "Chinese": "明白了。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:49:26",
            "content": "こんにちは 相談員です。よろしくお願いします。",
            "Chinese": "您好，我是咨询员。请多关关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:49:35",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:49:46",
            "content": "もう死にたい",
            "Chinese": "我已经不想活了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:50:12",
            "content": "なるほど…そう思われるほど、お辛く思われれているのですね、",
            "Chinese": "我明白了……能让您产生这样的想法，心里一定非常难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:50:24",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:50:46",
            "content": "教えてくれてありがとうございますどんなことがあったのか…詳しく聞いてもいいですか？",
            "Chinese": "谢谢您告诉我。能详细地和我说说发生了什么事吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:50:55",
            "content": "お答えになれる範囲で構いませんよ",
            "Chinese": "您在自己能够回答的范围内说就可以了，没关系的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:51:57",
            "content": "母も父も私を家族と思ってないの",
            "Chinese": "妈妈和爸爸都不把我当家人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:52:14",
            "content": "うん、うん",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:52:37",
            "content": "続けてくださいね言える範囲で、大丈夫ですから",
            "Chinese": "请继续说吧，在您能说的范围内就好，没关系的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:52:38",
            "content": "お兄ちゃんやおねえちゃんばかり",
            "Chinese": "他们眼里只有哥哥和姐姐。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:52:41",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:53:22",
            "content": "私は家族の中で一番成績よくないから",
            "Chinese": "因为我在家里成绩最差。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:53:30",
            "content": "うん、うん。",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:54:03",
            "content": "お兄ちゃんもお姉ちゃんもいい大学行ってる",
            "Chinese": "哥哥和姐姐都上了好大学。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:54:42",
            "content": "そうだったんですね自分だけ低い…そう考えると、辛くなってしまいますよね、",
            "Chinese": "是这样啊。一想到只有自己不如他们……确实会很难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:55:07",
            "content": "私は二人のようじゃないから",
            "Chinese": "我不像他们俩那样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:55:29",
            "content": "そうだったんですね。今日は少しでも気持ちが楽になるように…",
            "Chinese": "是这样啊。希望今天能让您的心情哪怕轻松一点……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:55:36",
            "content": "一緒に、ぜひ考えさせて欲しいです。",
            "Chinese": "请允许我和您一起思考，一起面对。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:55:53",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:56:06",
            "content": "今日は、なんて呼べばいいですか？本名じゃなくても構いませんよ",
            "Chinese": "今天我该怎么称呼您呢？不用真名也可以。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:56:24",
            "content": "さよです",
            "Chinese": "我叫Sayo。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:56:46",
            "content": "さよさんですね。ありがとうございます今は学生さんですか？",
            "Chinese": "是Sayo小姐啊。谢谢您。您现在是学生吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:56:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:57:59",
            "content": "そうだったんですね、ありがとうございます。寒くなってきてますね。今はちゃんと暖かくされてますか？",
            "Chinese": "是这样啊，谢谢您。天气变冷了呢。您现在有注意保暖吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:58:23",
            "content": "今、外お兄ちゃんもお姉ちゃんも両親が希望した大学いったの",
            "Chinese": "我现在在外面。哥哥和姐姐都去了父母所期望的大学。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:58:48",
            "content": "そうなんですね。希望した大学に行った…",
            "Chinese": "是这样啊。去了他们期望的大学……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:59:01",
            "content": "家にはいたくない",
            "Chinese": "我不想待在家里。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:59:11",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:59:22",
            "content": "家だと、色々と、考えてしまいますものね。",
            "Chinese": "在家里的话，是容易胡思乱想呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:59:40",
            "content": "居場所がないもん",
            "Chinese": "因为没有我的容身之处。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:00:11",
            "content": "そうなんだ…それは辛いよね。いたくないよね。",
            "Chinese": "是这样啊……那真的很难受呢。难怪会不想待在家里。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:00:33",
            "content": "お母さんもお父さんも冷たい目で見るし",
            "Chinese": "妈妈和爸爸也都用冷漠的眼神看我。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:00:36",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:00:43",
            "content": "嫌い",
            "Chinese": "我讨厌他们。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:01:00",
            "content": "そうなんだね。冷たい目で見られて居場所がなかったら…",
            "Chinese": "是这样啊。如果被用冷漠的眼神看待，又没有容身之处的话……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:01:09",
            "content": "つらくなるのも全然おかしいことじゃないと思います",
            "Chinese": "会感到痛苦，是完全正常的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:01:12",
            "content": "私人形じゃないし",
            "Chinese": "我又不是人偶。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:01:13",
            "content": "つらかったよね",
            "Chinese": "一定很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:01:14",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:01:25",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:01:29",
            "content": "ご両親は",
            "Chinese": "您的父母是……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:01:51",
            "content": "家に帰りたくないし",
            "Chinese": "我不想回家。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:02:02",
            "content": "そうだよね。ご両親は、行って欲しかった大学に行けなかったから冷たくしてる？",
            "Chinese": "是啊。您的父母是因为您没能去他们期望的大学，所以才对您这么冷淡吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:02:15",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:02:37",
            "content": "おまえはバカだからって",
            "Chinese": "他们说“因为你是个笨蛋”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:02:43",
            "content": "ええ？？",
            "Chinese": "诶？？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:02:49",
            "content": "そんな風に言われたら嫌だよね、、",
            "Chinese": "被那样说，肯定会很难受的吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:03:34",
            "content": "この大学にも入れないのかって",
            "Chinese": "说我“连这所大学都考不上吗”。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:05:58",
            "content": "私はどうしょうもない子って",
            "Chinese": "说我是个无可救药的孩子。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:08:11",
            "content": "今までもいうことはきがないと、どうしょうもない子って",
            "Chinese": "以前也是，只要我不听话，他们就说我是个无可救药的孩子。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:08:55",
            "content": "私どうしょうかな?",
            "Chinese": "我该怎么办呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:09:03",
            "content": "行くところないし",
            "Chinese": "我也没有地方可去。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:10:31",
            "content": "死んだ方がいいと思う",
            "Chinese": "我觉得我还是死了比较好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:48:35",
            "content": "（システム復旧確認メッセージ）",
            "Chinese": "（系统恢复确认信息）"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:49:01",
            "content": "（テストです。LINEは届いていますか？",
            "Chinese": "（这是测试。能收到LINE消息吗？）"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:49:45",
            "content": "OKです",
            "Chinese": "收到了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:50:01",
            "content": "ありがとうございます。間も無く再開します",
            "Chinese": "谢谢您。马上重新开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:53:15",
            "content": "再開します-------",
            "Chinese": "重新开始-------"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:53:24",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:53:41",
            "content": "そう思ってしまうくらい、つらいんですよね",
            "Chinese": "是痛苦到让您不由得产生那种想法了，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:53:51",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:54:30",
            "content": "みんな私がいなくてもいいと思ってるよ",
            "Chinese": "大家都觉得，没有我也无所谓。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:55:26",
            "content": "怖いよね。1人になった気持ちになっちゃうよね。",
            "Chinese": "这很可怕吧。会感觉自己变得孤零零的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:55:40",
            "content": "一人だもん",
            "Chinese": "我就是一个人嘛。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:56:36",
            "content": "そんなにつらかったのに、こうやって相談してくれたんだね勇気があると思う。改めて、教えてくれてありがとうございます",
            "Chinese": "经历了那么多痛苦，您还能像这样来咨询，我觉得您很有勇气。再次感谢您愿意告诉我这些。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:56:51",
            "content": "勇気?",
            "Chinese": "勇气？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:57:27",
            "content": "うん…。辛いと、誰かに話すの、怖くなったりしないかな",
            "Chinese": "嗯……。难受的时候，跟别人倾诉，不会觉得害怕吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:57:48",
            "content": "うーん(+_+)",
            "Chinese": "嗯……(+_+)"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:58:12",
            "content": "わかんない",
            "Chinese": "不知道。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:58:35",
            "content": "私帰るとこないし",
            "Chinese": "我没有地方可以回去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:58:41",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:59:37",
            "content": "年末てコロナで………",
            "Chinese": "年底了，又赶上新冠疫情……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:59:54",
            "content": "友達にも会えない",
            "Chinese": "连朋友也见不到。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:00:15",
            "content": "そうだよね、居場所がないのは嫌だよね、追い詰められてしまうよね。。",
            "Chinese": "是啊，没有容身之处真的很难受，会感觉自己被逼到了绝境……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:00:41",
            "content": "いいなぁ",
            "Chinese": "真好啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:00:45",
            "content": "みんな",
            "Chinese": "大家……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:01:07",
            "content": "おうちの人たちが",
            "Chinese": "家里的人……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:01:15",
            "content": "普通に、受け止めてくれたらいいのに、って思う？",
            "Chinese": "您会想“如果他们能普通地接纳我就好了”，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:01:23",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:01:31",
            "content": "そうだよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:01:47",
            "content": "よかったら…おうちに居場所を持てるように",
            "Chinese": "如果可以的话……为了让您在家里能有一个容身之处，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:01:58",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:02:04",
            "content": "一緒に何か方法を考えさせて欲しいです。どうかな…？",
            "Chinese": "希望能让我和您一起想些办法。您觉得怎么样…？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:02:24",
            "content": "うん、いいよ",
            "Chinese": "嗯，可以。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:02:31",
            "content": "ありがとう。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:02:54",
            "content": "ご両親からは、それからずっと冷たくされちゃうの？",
            "Chinese": "从那以后，您的父母就一直对您很冷淡吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:03:29",
            "content": "小さい時からだよ",
            "Chinese": "从小时候起就是了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:03:45",
            "content": "出来損ないだから",
            "Chinese": "因为我是个失败品。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:04:10",
            "content": "そうか、そんな前から…つらかったよね。。",
            "Chinese": "这样啊，从那么早就开始了……一定很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:04:32",
            "content": "大学に入る前も、成績のこととか言われてた",
            "Chinese": "是在上大学之前，也总是因为成绩的事被说吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:04:38",
            "content": "って感じかな…？",
            "Chinese": "是这种感觉吗……？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:04:47",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:05:20",
            "content": "ずっと怒られていた",
            "Chinese": "一直被责骂。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:05:27",
            "content": "うん、うん。",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:05:52",
            "content": "こんな成績情けないって",
            "Chinese": "说我“这种成绩真丢人”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:06:45",
            "content": "こんな成績、って。。そんな風に言われたらそれは嫌になっても仕方ないよ。。しかもずっと、、",
            "Chinese": "“考出这种成绩”……总是被这么说，会感到厌烦也是理所当然的。而且还是一直都这样……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:07:04",
            "content": "さよさんは",
            "Chinese": "Sayo小姐您呢，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:07:06",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:07:48",
            "content": "どうかな…勉強は好き？",
            "Chinese": "该怎么说呢……您喜欢学习吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:07:55",
            "content": "嫌い",
            "Chinese": "讨厌。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:08:09",
            "content": "そうだよね、ずっと怖かったもんね。",
            "Chinese": "是啊，毕竟一直以来都很害怕嘛。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:08:38",
            "content": "一生懸命勉強したよ",
            "Chinese": "但我还是很努力地学习了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:08:47",
            "content": "そうなんだねそれでもずっと、勉強してきたんだね",
            "Chinese": "是这样啊。即便如此，您也还是一直坚持学习了呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:09:02",
            "content": "嫌いだったし、怖かったのに。負けなかったんだね。",
            "Chinese": "明明那么讨厌、那么害怕，但您并没有放弃呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:09:45",
            "content": "でもお兄ちゃんやお姉ちゃんと違うもん",
            "Chinese": "可我还是跟哥哥姐姐不一样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:11:08",
            "content": "うん…どれだけ頑張っても…",
            "Chinese": "嗯……无论我怎么努力……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:11:21",
            "content": "あのレベルの大学にはいけないの",
            "Chinese": "我考不上那种水平的大学。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:11:44",
            "content": "お兄さんやお姉さんも、さよさんには冷たい？",
            "Chinese": "您的哥哥和姐姐对您也很冷淡吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:12:06",
            "content": "少しね",
            "Chinese": "有一点吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:12:31",
            "content": "そうなの？",
            "Chinese": "是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:12:35",
            "content": "お姉ちゃんもお兄ちゃんもいいなりだから",
            "Chinese": "因为姐姐和哥哥对父母都言听计从。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:12:45",
            "content": "なるほど…ご両親の？",
            "Chinese": "原来如此……是听父母的话吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:12:51",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:13:38",
            "content": "そうなんだ…。",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:13:48",
            "content": "二人共ご自慢の子供だから",
            "Chinese": "因为他们俩都是父母引以为傲的孩子。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:13:53",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:14:12",
            "content": "私は居づらいの",
            "Chinese": "让我在家里感到很不自在。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:14:57",
            "content": "辛いよね…ご両親は、勉強以外でもずっと冷たい？",
            "Chinese": "那一定很难受吧……您的父母在学习以外的方面，也一直对您很冷淡吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:16:07",
            "content": "まあね",
            "Chinese": "算是吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:16:37",
            "content": "だから嫌なの!",
            "Chinese": "所以我才讨厌啊！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:17:03",
            "content": "そうだよね。死にたいと思うから、嫌なんだよね",
            "Chinese": "是啊。就是因为讨厌，所以才会想到死，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:17:22",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:18:23",
            "content": "こんな家にいたくないよ",
            "Chinese": "我不想待在这样的家里。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:19:09",
            "content": "うん、そうだよね…",
            "Chinese": "嗯，是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:19:33",
            "content": "さよさんは今",
            "Chinese": "Sayo小姐现在是"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:19:47",
            "content": "高校3年生？",
            "Chinese": "高三吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:20:21",
            "content": "すみません。ここで終了させていただきます",
