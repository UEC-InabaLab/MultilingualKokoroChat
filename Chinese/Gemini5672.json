{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 12:52:11",
            "content": "（こんにちは。今日はよろしくお願いいたします。もし可能であれば若年層の相談者役をしていただけるとありがたいです。）",
            "Chinese": "（您好。今天请多关照。如果可以的话，能请您扮演一位年轻的来访者吗？）"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 12:53:16",
            "content": "（よろしくお願い致します。わかりました。ちなみに若年層というと、年代的には何歳ぐらいがよろしいですか？）",
            "Chinese": "（请多关照。我明白了。顺便问一下，您说的年轻人，是指大概哪个年龄段呢？）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 12:55:21",
            "content": "（中学生か高校生ぐらいでお願いできればと思います。）",
            "Chinese": "（希望能请您扮演初中生或高中生的角色。）"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 12:56:24",
            "content": "（承知しました。中学生から高校生くらいの年代で考えますね。）",
            "Chinese": "（明白了。我就按初中到高中这个年龄段来设想。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 12:56:50",
            "content": "（ありがとうございます。）",
            "Chinese": "（谢谢您。）"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 12:57:13",
            "content": "（こちらからありがとうございます。よろしくお願い致します。）",
            "Chinese": "（我也要谢谢您。请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:00:12",
            "content": "こんにちは、相談員です。年齢、性別、相談内容を教えてくれますか？",
            "Chinese": "您好，我是咨询员。能告诉我您的年龄、性别和咨询内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:00:36",
            "content": "14歳　女性",
            "Chinese": "14岁，女性"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:00:47",
            "content": "もう死にたい",
            "Chinese": "我真的不想活了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:02:10",
            "content": "とても辛い事があったんですね。よかったら少し詳しく教えてもらえますか？",
            "Chinese": "是发生了非常痛苦的事情吧。如果您愿意的话，能再详细地告诉我一些吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:02:33",
            "content": "友達が私のこと",
            "Chinese": "朋友把我的事……"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:02:45",
            "content": "嘘をついて",
            "Chinese": "撒谎，"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:02:54",
            "content": "周りに言いふらす",
            "Chinese": "到处跟人乱说。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:02:57",
            "content": "つらい",
            "Chinese": "好痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:03:38",
            "content": "そうなんですね。それはとても辛いですね。",
            "Chinese": "是这样啊。那真的很痛苦呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:04:18",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:04:18",
            "content": "友達というのはクラスメイトでしょうか？",
            "Chinese": "你说的朋友是同班同学吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:04:26",
            "content": "そう",
            "Chinese": "是。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:05:47",
            "content": "その友達というのは、あまり仲の良い友達ではないんですね。",
            "Chinese": "那么，这位朋友应该和你的关系不是特别好吧？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:06:06",
            "content": "どうかな",
            "Chinese": "不好说。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:06:15",
            "content": "でも嫌だ",
            "Chinese": "但我很讨厌这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:07:26",
            "content": "そうですよね。どのような嘘をつかれるのでしょうか？",
            "Chinese": "是啊。她都撒了些什么样的谎呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:07:50",
            "content": "いろいろある",
            "Chinese": "有很多。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:08:08",
            "content": "友達、発達障害らしくて",
            "Chinese": "那个朋友，好像有发育障碍。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:08:42",
            "content": "生まれつきみたいらしい",
            "Chinese": "好像是天生的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:08:52",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:09:10",
            "content": "でも私が追い込んで",
            "Chinese": "但是（她说）是我逼得她……"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:09:30",
            "content": "精神病んだとみんなに言いふらした",
            "Chinese": "……精神出了问题，她到处跟人这么说。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:10:07",
            "content": "もう死にたい",
            "Chinese": "我真的不想活了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:11:12",
            "content": "そう思われているんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:11:43",
            "content": "これってAIですか？",
            "Chinese": "这是AI吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:12:04",
            "content": "いえ、人間です。",
            "Chinese": "不，是人类。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:12:19",
            "content": "わかりました",
            "Chinese": "明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:12:57",
            "content": "言いふらしている事は嘘なんですよね。",
            "Chinese": "她到处说的那些事都是谎言，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:13:36",
            "content": "え、どういうこと？",
            "Chinese": "嗯？什么意思？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:14:31",
            "content": "あなたが追い込んで精神が病んだということです。",
            "Chinese": "就是说“是你把她逼得精神出了问题”这件事。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:14:54",
            "content": "私信用されてないんだ",
            "Chinese": "原来你是不相信我啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:15:33",
            "content": "そんなことは、ないです。ただ確認をしたかっただけです。",
            "Chinese": "没有这回事。我只是想确认一下。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:15:46",
            "content": "だって話したのに",
            "Chinese": "可是我都已经说过了啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:16:07",
            "content": "そうですね。ごめんなさいね。",
            "Chinese": "你说得对。真的很抱歉。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:17:33",
            "content": "発達障害の子は周りのクラスメイトとは上手くコミュニケーションがとれているんですか？",
            "Chinese": "那位有发育障碍的同学，和周围的同学沟通得顺利吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:17:56",
            "content": "まあまあ",
            "Chinese": "还行吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:18:19",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:19:12",
            "content": "追い込んだなんて嘘を言われるととても気づつきますよね。",
            "Chinese": "被人造谣说“是你逼的”，一定非常难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:19:38",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:20:58",
            "content": "クラスメイトはその嘘について、どう思われているんでしょうか。",
            "Chinese": "同学们对这个谎言是怎么看的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:21:17",
            "content": "信じてるんじゃないかな",
            "Chinese": "他们应该都信了吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:21:29",
            "content": "私、責められたし",
            "Chinese": "而且，我还被他们指责了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:22:51",
            "content": "そうだったんですね。周りから責められたりしたんですね。それはとても辛かったと思います。",
            "Chinese": "是这样啊，您还被周围的人指责了。那一定非常痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:23:25",
            "content": "もう死にたい",
            "Chinese": "我真的不想活了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:24:08",
            "content": "それほど辛い気持ちになっているんですね。",
            "Chinese": "你的心情已经痛苦到这种程度了啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:26:34",
            "content": "嘘ついた友達には、あなたからなんでそういうことを言うのかと聞いたりしたんでしょうか？",
            "Chinese": "您有没有问过那个撒谎的朋友，她为什么要那么说呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:27:00",
            "content": "LINEで話したけど",
            "Chinese": "我在LINE上跟她聊过，但是……"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:27:22",
            "content": "一方的に訳の分からないこと言われて",
            "Chinese": "她单方面说了一堆莫名其妙的话，"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:27:33",
            "content": "話にならなかった",
            "Chinese": "根本就没法沟通。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:28:58",
            "content": "そうなんですね。話にならなかったんですね。それでは、あなたも困ってしまいますよね。",
            "Chinese": "是这样啊，没法沟通是吗。这样的话，您也会很困扰吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:29:37",
            "content": "もうどこにも行くところがない",
            "Chinese": "我已经无处可去了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:30:24",
            "content": "そう思われているんですね。",
            "Chinese": "您现在是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:31:43",
            "content": "相手が嘘を言ってるのであなたはなにも悪くないと思います。",
            "Chinese": "因为是对方在说谎，所以我认为您没有任何过错。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:32:41",
            "content": "誰も分かってくれないから",
            "Chinese": "因为没有人理解我，"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:34:15",
            "content": "先生に話しても",
            "Chinese": "就算跟老师说了，"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:34:35",
            "content": "発達障害だから仕方ないと言われ",
            "Chinese": "也被说“因为她有发育障碍，所以没办法”，"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:34:48",
            "content": "保健室の先生にも",
            "Chinese": "保健室的老师也……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:35:07",
            "content": "（聞いていますよ）",
            "Chinese": "（我在听）"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:35:16",
            "content": "そう思われたあなたにも原因があるんじゃないかと",
            "Chinese": "（他们）对我说“会被人这么想，你自己是不是也有原因呢？”，"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:35:44",
            "content": "うまくやっていこうとしか言われなかった",
            "Chinese": "他们只跟我说要“好好相处”。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:36:59",
            "content": "そうなんですね。先生も保健室の先生もあなたの事をわかってくれなかったんですね。それはとても悲しいですね。",
            "Chinese": "是这样啊。老师和保健室的老师都没能理解您。这真的非常令人难过呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:39:00",
            "content": "仲のいい友達とかには嘘だとわかってもらえていないんでしょうか？",
            "Chinese": "关系好的朋友也没能理解那是谎言吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:39:37",
            "content": "その子にも悪口言ってるから",
            "Chinese": "因为她也对我的好朋友说我坏话了，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:42:01",
            "content": "そうだったんですね。それはひどいですよね。",
            "Chinese": "是这样啊。那真是太过分了。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:43:17",
            "content": "もういやだ",
            "Chinese": "我真的受够了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:43:17",
            "content": "クラスメイトはその嘘をついた友達が発達障害という事は知っているのでしょうか？",
            "Chinese": "同学们知道那个撒谎的朋友有发育障碍这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:43:27",
            "content": "知ってます",
            "Chinese": "知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:44:25",
            "content": "それでも周りの人が嘘だとわかってくれないんですね。",
            "Chinese": "即便如此，周围的人还是不相信那是谎言啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:44:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:46:21",
            "content": "それは本当に辛い気持ちになりますね。",
            "Chinese": "那真的会让人觉得很痛苦呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:46:54",
            "content": "だからもう死にたい",
            "Chinese": "所以我真的不想活了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:48:49",
            "content": "あなたが悪いわけではないので、私はあなたに死んでほしくないと思います。",
            "Chinese": "这不是您的错，我不希望您结束自己的生命。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:49:25",
            "content": "そうですか",
            "Chinese": "是吗。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:51:33",
            "content": "はい、仲の良いお友達には相手が嘘を言っている事を伝えれば少しづつわかってもらえると思うのですが、どう思われますか？",
            "Chinese": "是的，如果您告诉好朋友对方在说谎，我想他们会慢慢理解的。您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:51:58",
            "content": "言いにくい",
            "Chinese": "不太好说。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:52:57",
            "content": "私付き合ってた彼がいて",
            "Chinese": "我之前有一个交往的男朋友，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:53:13",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:53:31",
            "content": "その友達が彼に近づいて",
            "Chinese": "那个朋友接近了他，"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:53:41",
            "content": "彼が浮気して",
            "Chinese": "然后他出轨了，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/03(日) 13:53:59",
            "content": "（はい、聞いていますよ）",
            "Chinese": "（嗯，我在听。）"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:54:01",
            "content": "私彼とは別れて",
            "Chinese": "我和他分手了，"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:54:19",
            "content": "今は友達が彼と付き合っていて",
            "Chinese": "现在那个朋友和他在一起了，"
        },
        {
            "role": "クライアント",
            "time": "2023/09/03(日) 13:54:45",
            "content": "彼に私の悪口言ってるみたい",
            "Chinese": "她好像还在他面前说我的坏话。"
        },
        {
            "role": "カウンセラー",
