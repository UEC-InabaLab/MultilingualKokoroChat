        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:15:07",
            "content": "わかりました。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:15:35",
            "content": "お住いの地域にもありうると思いますので一度連絡してみるのも一つですと思います。",
