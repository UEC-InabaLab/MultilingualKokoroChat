        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:14:37",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:14:54",
            "content": "ユースプラザと呼ばれています。",
            "Chinese": "它叫做“青年广场”。"
