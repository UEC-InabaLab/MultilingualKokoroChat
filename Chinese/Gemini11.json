        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:11:08",
            "content": "もう行きたくない",
            "Chinese": "已经不想再去了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:11:53",
