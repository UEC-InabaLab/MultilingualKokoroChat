{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:02:22",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:02:29",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:02:34",
            "content": "相談員です。",
            "Chinese": "我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:02:44",
            "content": "よろしくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:02:48",
            "content": "よろしくお願いいたします。",
            "Chinese": "也请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:03:20",
            "content": "初めに恐縮ですが、性別と年代と教えていただけますか？",
            "Chinese": "首先不好意思，请问可以告诉我您的性别和年龄段吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:03:34",
            "content": "21歳、男性",
            "Chinese": "21岁，男性。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:03:47",
            "content": "よろしくお願いいたします。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:03:53",
            "content": "よろしくお願いします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:04:08",
            "content": "今日のご相談はどんなことでしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:04:28",
            "content": "これから先どうしていいかわかりません",
            "Chinese": "我不知道今后该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:04:43",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:04:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:04:53",
            "content": "それはお困りですね。",
            "Chinese": "那您一定很困扰吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:04:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:05:23",
            "content": "今はどんなことをなさっているんでしょうか？",
            "Chinese": "现在您主要在做些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:05:53",
            "content": "大学に行っていましたが、今は行ってないんです",
            "Chinese": "我之前在上大学，但现在没有去了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:06:11",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:06:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:06:44",
            "content": "どんな学部に行ってたんでしょうか？",
            "Chinese": "您当时读的是哪个学院呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:07:02",
            "content": "経済学部です",
            "Chinese": "经济学院。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:07:18",
            "content": "そうだったんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:07:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:07:52",
            "content": "学び始めた時は興味があったんでしょうかね。",
            "Chinese": "刚开始学习的时候，您对它有兴趣吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:08:31",
            "content": "いや、名の通った大学で入れるならば、で入りました",
            "Chinese": "不，因为是有名的大学，想着只要能进就进了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:08:51",
            "content": "なるほどそうだったんですね。",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:08:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:09:29",
            "content": "名の通った大学に入ったってすごいことだな、と私は思いますけど。・・・",
            "Chinese": "我个人觉得，能考进名校已经很了不起了……"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:09:47",
            "content": "自分も最初はそう思いました",
            "Chinese": "一开始我自己也是这么想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:10:02",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:10:07",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:10:19",
            "content": "運良く入れたけど、",
            "Chinese": "虽然是靠运气进去的，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:10:29",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:10:32",
            "content": "上手くやっていけませんでした",
            "Chinese": "但我没能很好地适应。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:10:45",
            "content": "そうだったんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:10:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:11:03",
            "content": "それは大変でしたね。",
            "Chinese": "那一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:11:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:11:27",
            "content": "情けないし、恥ずかしいです",
            "Chinese": "觉得自己很没用，也很丢脸。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:11:41",
            "content": "例えばどんな点でうまくやっていけないなと感じたりしたのでしょうか。",
            "Chinese": "比如说，您是在哪些方面感觉没能适应呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:12:02",
            "content": "もともと人と話すの、苦手で",
            "Chinese": "我本来就不擅长和人说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:12:20",
            "content": "はい　そうだったんですね",
            "Chinese": "嗯，原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:12:24",
            "content": "入ったら何とかなると思ってました",
            "Chinese": "我以为上了大学就会好起来。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:12:37",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:12:54",
            "content": "そうしたら・・",
            "Chinese": "结果呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:14:29",
            "content": "みんな、しっかり目標や夢があって、どんどんやっているのに、自分は何をしたらいいかわからなかった",
            "Chinese": "大家都有明确的目标和梦想，干劲十足，而我却不知道自己该做什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:14:52",
            "content": "そうだったんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:14:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:15:09",
            "content": "中身空っぽなんです",
            "Chinese": "我感觉自己内心空空如也。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:15:27",
            "content": "そう思ってしまっているんですね。",
            "Chinese": "您是这样想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:15:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:15:46",
            "content": "そう思うだけで悲しいよね。",
            "Chinese": "光是这么想就很难过呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:16:12",
            "content": "何年まで通っていたんですか？",
            "Chinese": "您读到几年级了？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:16:14",
            "content": "だんだん何の為に勉強してるのかも分からなくて、大学休みがちになり",
            "Chinese": "渐渐地，我甚至搞不清自己为何而学，开始经常不去学校了。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:16:21",
            "content": "留年もしました",
            "Chinese": "还留级了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:16:36",
            "content": "そうだったんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:16:48",
            "content": "親に申し訳ないです",
            "Chinese": "我觉得很对不起父母。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:17:27",
            "content": "何のために学んでいるのかわからなくなると方向感覚を失ったみたいに途方に暮れてしまったんじゃないかな。",
            "Chinese": "当您不知道为何而学时，就像失去了方向感一样，会感到不知所措吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:17:43",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:17:55",
            "content": "消えてしまいたい",
            "Chinese": "真想就这样消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:18:16",
            "content": "今はそんな気持ちになってしまっているんですね。",
            "Chinese": "您现在是这样的心情啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:18:21",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:18:26",
            "content": "辛いよね。",
            "Chinese": "很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:18:40",
            "content": "いなくなった方が親もホッとするんじゃないかな",
            "Chinese": "要是我不在了，父母也许反而会松一口气吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:19:03",
            "content": "そこまで考えてしまうんだ。",
            "Chinese": "您已经想到这一步了啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:19:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:19:22",
            "content": "でも勇気ないから死ねません",
            "Chinese": "但是我没有勇气，所以死不了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:19:42",
            "content": "すっかり深い底に沈んでしまったみたいな感じなんだね。",
            "Chinese": "感觉就像整个人完全沉入了深深的海底一样呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:19:47",
            "content": "出来もしない、情けないやつです",
            "Chinese": "连死都做不到，我真是个没用的家伙。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:20:11",
            "content": "でもこうやって今日は相談に来てくれたよ。",
            "Chinese": "但是，您今天还是来这里咨询了呀。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:20:25",
            "content": "どうしたらいいかわからない",
            "Chinese": "我不知道该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:20:33",
            "content": "わたしはあなたが来てくれたことが嬉しいな。",
            "Chinese": "您能来和我谈，我感到很高兴。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:20:51",
            "content": "あなたのことはなんてお呼びしたらいいのかな？",
            "Chinese": "我该怎么称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:21:08",
            "content": "学です",
            "Chinese": "我叫学。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:21:39",
            "content": "学さんすこしここで一緒に考えてみたいけどいいかな？",
            "Chinese": "学，我想在这里和您一起想想，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:21:47",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:22:00",
            "content": "こちらこそありがとうね。",
            "Chinese": "我也该谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:22:27",
            "content": "すみません。よろしくお願いします。",
            "Chinese": "不好意思，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:23:08",
            "content": "学さん、何をしたらいいか分からなくなっているって言ってたけど、もしかして、昔、何かやりたい事ってあったかな？",
            "Chinese": "学，您说不知道该做什么，那或许，您以前有过什么想做的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:23:31",
            "content": "昔はパイロットになりたかったです",
            "Chinese": "我以前想当飞行员。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:23:44",
            "content": "すごい。",
            "Chinese": "好厉害。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:24:00",
            "content": "すごくないですよ",
            "Chinese": "没什么了不起的。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:24:16",
            "content": "思っただけなんで",
            "Chinese": "只是想想而已。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:24:53",
            "content": "そう？わたしは、パイロットってかっこいいなと思ってしまうけど、学さんはパイロットのどんなところに憧れたの？",
            "Chinese": "是吗？我觉得飞行员很帅气，学，您是憧憬飞行员的哪一点呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:25:21",
            "content": "同じです。みんながかっこいいと思うものだから",
            "Chinese": "一样。因为大家都觉得飞行员很帅气。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:25:35",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:26:21",
            "content": "学さんにとってはパイロットのどんなところがかっこよく見えたのですか？",
            "Chinese": "对学您来说，飞行员的哪些方面让您觉得帅呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:27:08",
            "content": "みんながすごい、いいな、って言われる仕事だからです",
            "Chinese": "因为那是大家都说“好厉害”、“真好啊”的工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:27:43",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:27:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:28:42",
            "content": "今はもしかしてパイロットになるという夢は、どんな感じでしょうか？",
            "Chinese": "那现在，对于成为飞行员这个梦想，您是怎样的感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:29:06",
            "content": "全く無理です大学すら卒業できないのに",
            "Chinese": "根本不可能。我连大学都毕不了业。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:29:53",
            "content": "今は大学に行っていないのでそう思ってしまうんですね。",
            "Chinese": "因为现在没有去上大学，所以您会这么想吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:30:24",
            "content": "先の事を考えると、吐きそうになります",
            "Chinese": "一想到未来的事情，我就想吐。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:31:20",
            "content": "それは辛いですね。",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:31:59",
            "content": "どうしたらいいか",
            "Chinese": "我该怎么办……"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:32:04",
            "content": "情けないです",
            "Chinese": "觉得自己很没用。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:32:13",
            "content": "先のことが見えなくなってしまってということですよね。",
            "Chinese": "也就是说，您已经看不清未来了，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:32:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:32:43",
            "content": "大学に行かなくなってからはどんな風に日々を過ごしていたのでしょうか。",
            "Chinese": "不去上大学之后，您每天是怎么度过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:33:22",
            "content": "親に申し訳ないので、掃除したり、料理をしたり、走ったり",
            "Chinese": "因为觉得对不起父母，所以会打扫卫生、做饭、跑步之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:34:09",
            "content": "もしかして実家にいらっしゃるのですか。",
            "Chinese": "您是住在家里吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:34:15",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:34:54",
            "content": "なんどかできることをなさっているんですよね。",
            "Chinese": "您也在做一些力所能及的事情呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:35:28",
            "content": "これくらいしないと",
            "Chinese": "至少得做这些。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:35:44",
            "content": "大学行けてないので",
            "Chinese": "因为我没去上大学。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:35:53",
            "content": "でも学さんなりに考えていらっしゃる。",
            "Chinese": "但是，您也在以自己的方式思考着。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:36:29",
            "content": "大学に行けていないとおっしゃってますけど、退学手続きとはかしてしまったのでしょうか？",
            "Chinese": "您说没去上大学了，那退学手续是已经办了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:36:40",
            "content": "それが、",
            "Chinese": "这个嘛……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:36:49",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:36:55",
            "content": "まだなんです",
            "Chinese": "还没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:37:05",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:37:12",
            "content": "親は大学卒業して欲しいんですよ",
            "Chinese": "父母还是希望我能大学毕业。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:37:37",
            "content": "なるほど。今は何年生になるんですか？",
            "Chinese": "原来如此。那您现在应该是几年级了？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:37:47",
            "content": "2年です",
            "Chinese": "大二。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:38:07",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:38:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:38:54",
            "content": "経済学部だったと思いますが、もしかして、他の学部で興味のあるところとかありそうですか？",
            "Chinese": "我记得您读的是经济学院，那有没有可能对其他学院感兴趣呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:39:17",
            "content": "もう大学に行ける自信がありません",
            "Chinese": "我已经没有再去上大学的自信了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:40:25",
            "content": "そんな思い抱えてしまってくるしいですよね。それはさきほど出ていた人と話がうまくできないということがネックになっているのでしょうか？",
            "Chinese": "抱着这样的想法一定很痛苦吧。这和刚才提到的不擅长与人交谈有关，是造成这个瓶颈的原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:40:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:41:21",
            "content": "もしかしたら、人と話せるようになったら、状況は変わりそうでしょうか。",
            "Chinese": "如果能够与人顺利交谈，情况会不会有所改变呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:41:31",
            "content": "そうですね",
            "Chinese": "也许吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:41:43",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:41:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:42:07",
            "content": "それならひとつ提案してみてもいいですか？",
            "Chinese": "那么，我可以提一个建议吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:42:14",
            "content": "お願いします",
            "Chinese": "好的，请说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:43:02",
            "content": "人と話をできるようになる社会人スクールみたいなところがあったりしますよ。",
            "Chinese": "有一些面向社会人士的培训班，可以帮助提升与人交流的能力。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:43:34",
            "content": "そんなところに通ってみるという方法があるような気がするのですが、いかがでしょうか？",
            "Chinese": "我觉得，或许可以尝试去那样的地方，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:43:43",
            "content": "電車乗るのもギリギリです",
            "Chinese": "我连坐电车都很勉强。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:44:02",
            "content": "それは辛いですよね。",
            "Chinese": "那一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:44:10",
            "content": "すみません",
            "Chinese": "对不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:44:59",
            "content": "最近のそんなスクールの中にはそのスクールに行かなくてもWebで自宅で学習できる仕組みを持っている所もあるんですよ。",
            "Chinese": "最近，这类培训班里也有一些无需到场，通过网络在家就能学习的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:45:51",
            "content": "実は、この頃コミュニケーションが苦手です。という人が増えているんです。そんな人たちのためのスクールなんですよ。",
            "Chinese": "其实，最近不擅长沟通的人越来越多了。这正是为这些人开设的培训班。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:46:03",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:46:28",
            "content": "考えてみるのも一つかと思いますが、いかがでしょうか。",
            "Chinese": "我觉得这也可以作为一个选项来考虑一下，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:46:44",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:46:53",
            "content": "すみません",
            "Chinese": "对不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:47:01",
            "content": "そうですよね。",
            "Chinese": "是啊，我理解。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:47:20",
            "content": "急に言われてもピンとこないですよね。",
            "Chinese": "突然跟您这么说，您可能也一下子反应不过来吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:47:25",
            "content": "せっかく提案していただいたのにすみません",
            "Chinese": "您特意为我提了建议，我却这样，真不好意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:47:36",
            "content": "大丈夫ですよ。",
            "Chinese": "没关系的。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:47:44",
            "content": "うまくやれる自信ないです",
            "Chinese": "我没有信心能做好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:48:31",
            "content": "なるほど。私がおもったことは学さんは大学受験の時に猛勉強して、念願の大学に入ったでしょう。",
            "Chinese": "原来如此。我是这么想的，学，您在高考时拼命学习，不也考上了心仪的大学吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:48:56",
            "content": "念願だったのか",
            "Chinese": "算是心愿吗……"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:49:17",
            "content": "親は喜んでましたよ",
            "Chinese": "父母倒是很高兴。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:49:37",
            "content": "でも世間的には難関を突破したということですよね。それは学さんが学ぶ力を持っているという証拠だと思いますよ。",
            "Chinese": "但在世人看来，您是突破了难关的，对吧。我认为这就是您拥有学习能力的证明。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:49:53",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:50:36",
            "content": "ところが入ってみて、ひととコミュニケーションすることがあまりうまくいかず、今学校で苦労してしまっているのが現状ですよね。",
            "Chinese": "但是入学之后，与人沟通不太顺利，导致您现在在学校遇到了困难，这是目前的状况，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:50:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:51:12",
            "content": "運良く入れただけだったんですよ",
            "Chinese": "我只是运气好才考上的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:51:17",
            "content": "でも、それなりに、ご実家でお掃除をしたり、お料理をしたり、走ったりできることをやっていらっしゃる。",
            "Chinese": "但是，您也一直在家里做着打扫、做饭、跑步这些力所能及的事情。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:51:28",
            "content": "それだけです",
            "Chinese": "也只有这些了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:52:10",
            "content": "確かに、そうかもしれない。けれど運も実力のうちという人もいますけど。",
            "Chinese": "确实，也许是这样。但也有人说运气也是实力的一部分。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:52:35",
            "content": "同世代の人が当たり前にできていることができてない",
            "Chinese": "同龄人理所当然能做到的事情，我都做不到。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:52:41",
            "content": "恥ずかしいです",
            "Chinese": "我觉得很丢脸。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:53:18",
            "content": "もしかして、人は人学さんは学さんという考えもあるかもしれませんけれど。",
            "Chinese": "或许，也可以有这样的想法：别人是别人，您是您自己。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:53:30",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:53:58",
            "content": "走っている時はどんな気持ちですか？",
            "Chinese": "跑步的时候，您是什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:54:20",
            "content": "もっと早く走れたのに、",
            "Chinese": "明明可以跑得更快的，"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:54:23",
            "content": "とか",
            "Chinese": "之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:54:31",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:54:48",
            "content": "いいですね",
            "Chinese": "挺好的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:54:50",
            "content": "あの人の方が上手く走れている",
            "Chinese": "那个人跑得比我好。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:54:56",
            "content": "とか",
            "Chinese": "之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:55:05",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:55:19",
            "content": "人の走りを観察しているのですね。",
            "Chinese": "您在观察别人跑步呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:55:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:55:52",
            "content": "気になります",
            "Chinese": "我很在意。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:56:28",
            "content": "どんな風に気になるんですか？",
            "Chinese": "具体会在意些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:56:53",
            "content": "あの人の方がタイム早いなとか",
            "Chinese": "比如会想“那个人的成绩比我快啊”之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:57:13",
            "content": "なるほど",
            "Chinese": "我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:57:34",
            "content": "自分は辛くてサボってるけど、あの人は今日も頑張っているとか",
            "Chinese": "自己觉得辛苦就偷懒了，但那个人今天也在努力，之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:58:17",
            "content": "そうなんでね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:58:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 16:59:14",
            "content": "でももしかして学さんも最後まで学さんなりに走り切っているのではないでしょうか？",
            "Chinese": "但是，学您不也是用自己的方式坚持跑到了最后吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 16:59:43",
            "content": "でも、まだまだだな、と思います",
            "Chinese": "但是，我觉得还差得远呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:00:06",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:00:44",
            "content": "その人はもしかしてずうっと前からはしりこんで来たのでそんなに早く走れるのかもしれませんね。",
            "Chinese": "那个人或许是因为从很久以前就开始坚持跑步，所以才能跑得那么快吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:00:56",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:01:26",
            "content": "そうだと思います",
            "Chinese": "我也这么觉得。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:01:35",
            "content": "その人の流れの中で起こっていることのような気がするのですが。",
            "Chinese": "我感觉那是发生在那个人自身的人生轨迹中的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:01:55",
            "content": "学さんも学さんの流れの中で走り始めた。",
            "Chinese": "学您也是在您自己的人生轨迹中开始跑步的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:02:15",
            "content": "そうしてご自分のペースで走っている。",
            "Chinese": "然后按照自己的节奏在跑。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:02:56",
            "content": "他の人と同じタイムでなくてもいいのではないかなと私は思うのですが、いかがでしょうか？",
            "Chinese": "我在想，不一定非要和别人跑出一样的成绩，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:03:26",
            "content": "自分がサボっていて、情けないです",
            "Chinese": "是我自己在偷懒，所以觉得很没用。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:03:47",
            "content": "さぼっているってどんなことですか？",
            "Chinese": "您说的“偷懒”具体是指什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:03:50",
            "content": "もっと頑張ればいいのに、頑張れない",
            "Chinese": "明明可以更努力，却努力不起来。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:04:19",
            "content": "みんな当たり前に行けてるのに、大学も行けてない",
            "Chinese": "大家都能理所当然地去上学，我却连大学都去不了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:05:03",
            "content": "そこはこのランニングと同じかもしれないという気もするのですが。",
            "Chinese": "我感觉，这一点可能和跑步的情况是一样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:05:58",
            "content": "今　学さんにとってネックになっていることを解決してまた進みだすということもありなのではないでしょうか？",
            "Chinese": "现在，先把对您来说是瓶颈的问题解决掉，然后再重新前进，这不也是一种选择吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:05:59",
            "content": "？",
            "Chinese": "？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:06:19",
            "content": "どう解決したら良いですか？",
            "Chinese": "要怎么解决才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:06:59",
            "content": "一つはさっきお話ししたコミュニケーションのスクールに通ってみるというのもありかもしれませんね。",
            "Chinese": "一个方法是，或许可以试试去我刚才提到的沟通培训班。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:07:16",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:07:46",
            "content": "今の学さんお気持ちについてご両親にはお話ししてみたのでしょうか？",
            "Chinese": "关于您现在的心情，您和父母谈过了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:08:09",
            "content": "親は何も言いません",
            "Chinese": "父母什么也不说。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:08:20",
            "content": "だけど大学は卒業して欲しいんです",
            "Chinese": "但是他们希望我大学毕业。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:08:48",
            "content": "親とはほとんど話しません",
            "Chinese": "我跟父母基本上不怎么说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:09:01",
            "content": "そうなんですね。誰か相談にのってくれそうな人は思い当たりますか？",
            "Chinese": "是这样啊。那您能想到有什么可以商量的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:09:17",
            "content": "いません",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:09:30",
            "content": "そうなんですね。",
            "Chinese": "我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 17:09:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 17:10:10",
            "content": "学さんご自身は大学を卒業するということについてはどう思っているのでしょうか？",
            "Chinese": "那么学您自己，对于大学毕业这件事是怎么想的呢？"
