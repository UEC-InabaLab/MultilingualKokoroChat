        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 22:03:21",
            "content": "本日はありがとうございました",
            "Chinese": "今天非常感谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 22:03:57",
            "content": "ありがとうございました。今後のあなたのこと応援しています。",
