{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:00:26",
            "content": "こんばんは。相談員です。はじめにご年齢と性別を教えていただけますか？",
            "Chinese": "晚上好。我是咨询师。可以先告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:00:45",
            "content": "こんばんは、20代後半の女性です",
            "Chinese": "晚上好，我是一位二十多岁后半段的女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:01:20",
            "content": "ありがとうございます。本日はどのようなご相談ですか。",
            "Chinese": "谢谢您。今天想咨询哪些方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:01:42",
            "content": "仕事でうまくいかなくなった途端、モチベーションが維持できなくなるので相談したいです。",
            "Chinese": "一旦工作不顺利，我就很难维持动力，所以想就此进行咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:02:14",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:02:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:02:43",
            "content": "モチベーションが維持できなくなった時は、どんなお気持ちになるのですか？",
            "Chinese": "当难以维持动力时，您心里会有什么感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:03:13",
            "content": "悪い未来を考えて、暗い気持ちになってしまいます",
            "Chinese": "我会想到糟糕的未来，心情也随之变得很低落。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:04:08",
            "content": "そうなのですね。悪い未来を考えると気持ち的に暗くなるんですね。",
            "Chinese": "原来如此。一想到不好的未来，心情就会变得低落呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:04:16",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:04:52",
            "content": "それは気持ち的にしんどいですよね。",
            "Chinese": "那在情绪上会感到很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:05:06",
            "content": "そうですね、しんどくなります",
            "Chinese": "是的，会觉得很辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:05:56",
            "content": "ええ。仕事のどんなときに暗い気持ちになるのですか？",
            "Chinese": "嗯。您在工作的什么时刻会感到心情低落呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:06:19",
            "content": "成約が決まらない時です営業の仕事をしているのですが",
            "Chinese": "是签不了单的时候。我做的是销售工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:06:29",
            "content": "ええ、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:06:32",
            "content": "成約が立て続けに決まらないと",
            "Chinese": "如果连续签不了单的话，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:06:37",
            "content": "暗い気持ちになっていきます",
            "Chinese": "心情就会越来越低落。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:06:52",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:06:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:07:32",
            "content": "成約が決まらないとしんどいですよね。",
            "Chinese": "签不了单的话会很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:08:17",
            "content": "そうですね、1人目、2人目が決まらなくても3人目で決めれば、いいんですが3人目も決まらなくなってくると、暗い気持ちになります",
            "Chinese": "是的，第一个、第二个签不了单，如果第三个能签下来也还好，但如果第三个也签不下来了，心情就会变得很低落。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:09:13",
            "content": "ええ。そうやって連続で決まらないと落ち込んだりするのも無理はないと思います。",
            "Chinese": "嗯。像这样连续签不了单而感到沮丧，这也是人之常情。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:09:32",
            "content": "成約が立て続けに決まらなかったりして、暗い気持ちになるのはいつ頃からですか？",
            "Chinese": "因为连续签不了单而心情低落，这种情况是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:09:48",
            "content": "今の仕事して初めからですね",
            "Chinese": "从开始做现在这份工作时就是这样了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:09:54",
            "content": "最初からそうでした",
            "Chinese": "从一开始就是。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:10:04",
            "content": "繁忙期は",
            "Chinese": "繁忙期的时候，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:10:11",
            "content": "ほぼ二分の一で決まり続けるので",
            "Chinese": "基本上能以一半左右的概率连续签单，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:10:12",
            "content": "はい、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:10:16",
            "content": "メンタル的にいけるんですけど",
            "Chinese": "心理上还能撑得住，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:10:20",
            "content": "閑散期はそうもいかなくて",
            "Chinese": "但在淡季就不太行了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:10:26",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:10:37",
            "content": "成約決めてる他の人とかみると",
            "Chinese": "看到其他同事签了单，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:10:40",
            "content": "焦りますし",
            "Chinese": "我就会很焦虑，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:10:46",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:10:52",
            "content": "なんで私ばっか決まらないの？おかしくない？って",
            "Chinese": "就会想“为什么就我签不了单？这不正常吧？”"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:10:56",
            "content": "思って苦しくなります",
            "Chinese": "这样想着就会觉得很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:11:42",
            "content": "そうなんですね。自分ばかり決まらないと思うと焦るし、苦しくなりますよね。。。",
            "Chinese": "是这样啊。想到只有自己签不了单，就会感到焦虑和痛苦吧……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:11:49",
            "content": "はい、苦しくなります",
            "Chinese": "是的，会很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:12:09",
            "content": "ちなみに今のお仕事はどれくらいされてるんですか？",
            "Chinese": "顺便问一下，您现在这份工作做了多久了？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:12:21",
            "content": "もう少しで2年たちます",
            "Chinese": "快满两年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:13:19",
            "content": "はい。約2年もの間、成約が決まらなかったりした時は苦しい思いをされてきたんですね。。。",
            "Chinese": "嗯。在这将近两年的时间里，每当签不了单的时候，您都承受着痛苦的情绪呢……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:13:29",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:14:14",
            "content": "暗い気持ちになったりするのは、",
            "Chinese": "您感到心情低落，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:14:32",
            "content": "成約が決まらなかったりするとき以外にもありますか？",
            "Chinese": "除了签不了单的时候，还有其他情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:15:07",
            "content": "うーん、人間関係であったりはしますけど、それくらいですかね",
            "Chinese": "嗯……人际关系上也会有，但差不多就这些吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:15:30",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:15:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:15:42",
            "content": "教えていただきありがとうございます。",
            "Chinese": "谢谢您的分享。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:15:55",
            "content": "今日のご相談ではどんなことを一番お望みですか？",
            "Chinese": "在今天的咨询中，您最希望达成什么目标呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:16:56",
            "content": "自分がうまくいかないときでも、安定したメンタルが欲しいです辛い状況でも、土台をしっかりさせたいです",
            "Chinese": "我希望即使在不顺利的时候，也能保持稳定的心态。即使在艰难的情况下，也想打好坚实的心理基础。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:18:15",
            "content": "はい。うまくいかないときや辛い状況でも、安定したメンタルを手にしたいということですね。",
            "Chinese": "好的。也就是说，即使在不顺利或艰难的情况下，您也希望拥有稳定的心态，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:18:25",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:18:59",
            "content": "かしこまりました。あなたにとって大事なことなので、一緒に考えていきましょうね。",
            "Chinese": "明白了。这对您来说很重要，我们一起来想一想吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:19:12",
            "content": "はい、お願いします",
            "Chinese": "好的，拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:19:30",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:20:12",
            "content": "ちなみに営業のお仕事を選ばれたきっかけみたいなものはあるのですか？",
            "Chinese": "顺便问一下，您选择做销售工作的契机是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:20:26",
            "content": "お金を稼ぎたかったからです",
            "Chinese": "因为我想多赚点钱。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:20:31",
            "content": "やりたいことのために",
            "Chinese": "为了做我想做的事，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:20:35",
            "content": "お金が必要だったので",
            "Chinese": "我需要钱。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:20:40",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:20:42",
            "content": "インセンティブ制度で",
            "Chinese": "因为有提成制度，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:20:51",
            "content": "かつ、toCであれば",
            "Chinese": "而且是面向个人客户（toC）的话，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:21:02",
            "content": "続けられると思ったので",
            "Chinese": "我觉得自己能坚持下去，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:21:04",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:21:04",
            "content": "選びました",
            "Chinese": "所以就选择了这份工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:21:17",
            "content": "やりたいことのために頑張っておられるんですね。",
            "Chinese": "您是为了自己想做的事情而努力着呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:21:23",
            "content": "はい、そうですね",
            "Chinese": "是的，是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:22:39",
            "content": "そのやりたいことを始めるタイミングは検討されてたりしますか？",
            "Chinese": "那您有考虑过什么时候开始做那件想做的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:22:59",
            "content": "来年の3月には始めたいと思ってます！！",
            "Chinese": "我打算明年3月就开始！！"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:23:29",
            "content": "お！そうなんですね。",
            "Chinese": "哦！是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:23:38",
            "content": "はい、もう決めてます",
            "Chinese": "是的，我已经决定了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:24:08",
            "content": "そうなんですね。じゃあ今はそれに向けて何か勉強されたりって感じですか？",
            "Chinese": "原来如此。那现在是在为此做一些学习之类的准备吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:24:14",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:24:19",
            "content": "毎日必死に勉強もしてます",
            "Chinese": "我每天也都在拼命学习。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:24:26",
            "content": "でも",
            "Chinese": "但是，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:24:32",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:24:40",
            "content": "今の仕事でうまくいかないとき、モチベーションが保てないとき",
            "Chinese": "当现在的工作不顺利、难以保持动力的时候，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:24:49",
            "content": "本当にやりたいことを仕事にできたとしても",
            "Chinese": "即使将来能把真正想做的事当成工作，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:24:55",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:25:04",
            "content": "そのときも、うまくいかないたび、悪い考え方になってしまうのは",
            "Chinese": "到那时每当不顺利的时候，还是会陷入消极的想法，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:25:07",
            "content": "嫌なので",
            "Chinese": "我不想那样，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:25:13",
            "content": "今のうちに、治しておきたいって",
            "Chinese": "所以想趁现在就把这种状态调整过来。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:25:15",
            "content": "思ってます",
            "Chinese": "我是这么想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:25:31",
            "content": "そうなんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:25:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:25:44",
            "content": "毎日勉強を頑張っておられてて、",
            "Chinese": "您每天都在努力学习，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:26:37",
            "content": "やりたいことを始める前に、うまくいかない時でもメンタルを保つための方法を学びたいということなんですね。",
            "Chinese": "并且希望在开始做想做的事情之前，学会如何在不顺利时也能保持心态平稳的方法，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:26:50",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:27:41",
            "content": "今のうちに練習できれば、やりたいことを始めたときに",
            "Chinese": "如果能趁现在练习好，当您开始做想做的事情时，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:28:15",
            "content": "悪い考えになりそうな時でも、メンタルを保てそうですね。",
            "Chinese": "即便快要陷入消极想法时，也更能稳住心态呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:28:23",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:29:15",
            "content": "お話聴いてると、来年の3月に向けて一生懸命頑張ってる様子が伺えます。",
            "Chinese": "听您这么说，我能感受到您为了明年3月的目标在非常努力地奋斗。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:29:42",
            "content": "ありがとうございます本当に、自分でも一生懸命になってるます",
            "Chinese": "谢谢您。真的，我自己也觉得非常努力。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:30:16",
            "content": "ええ。伝わってきますよ。ちなみにそのやりたいことはいつぐらいから志を持っておられるんですか？",
            "Chinese": "嗯，我能感受得到。顺便问一下，您是从什么时候开始有这个想做的事的志向的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:30:35",
            "content": "志は、高校生の時くらいです",
            "Chinese": "这个志向从高中时就有了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:31:12",
            "content": "ええ。10年近く志を持っておられるんですね。",
            "Chinese": "嗯。也就是说您已经怀抱这个志向将近十年了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:31:24",
            "content": "そうですね、それくらい経ちましたね",
            "Chinese": "是的，差不多那么久了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:31:46",
            "content": "そのやりたいことって、あなたにとってどんなイメージのものですか？",
            "Chinese": "那件您想做的事，在您心中是怎样的形象呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:32:31",
            "content": "私の支えですねとても力強くて、希望を感じられる、叶えたいと心から思えるイメージです",
            "Chinese": "是我的精神支柱。它非常强大，能让我感受到希望，是我发自内心想要实现的梦想。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:33:01",
            "content": "そうなんですね。とても大事にされてきてるんですね。",
            "Chinese": "是这样啊。您一直以来都非常珍视它呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:33:11",
            "content": "そうですね、",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:34:06",
            "content": "聴いていると素敵な志やイメージだとどんどん感じてきます。",
            "Chinese": "听您说着，我越发觉得这是一个非常美好的志向和愿景。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:34:17",
            "content": "ありがとうございます、嬉しいです",
            "Chinese": "谢谢您，我很开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:34:37",
            "content": "はい。では話が少し戻ってしまいますが、",
            "Chinese": "好的。那么，我们再回到刚才的话题。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:35:11",
            "content": "成約が立て続けに決まらなかったりして、暗い気持ちになった時は、いつもどうされていますか。",
            "Chinese": "当您因为连续签不了单而心情低落时，通常会怎么做呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:35:52",
            "content": "いつも、自分に大丈夫大丈夫、最後まで結果はわからないから、とか焦らなくていい、比べなくて大丈夫…って言い聞かせている感じです",
            "Chinese": "我通常会对自己说“没关系没关系，结果不到最后是不知道的”、“不用着急”、“不用跟别人比，没事的”……算是这样不断地劝慰自己吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:36:27",
            "content": "ええ。自分を安心させようと、言い聞かせてるんですね。",
            "Chinese": "嗯。您在努力说服自己，让自己安心下来呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:36:34",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:37:52",
            "content": "はい。言い聞かせたあとは心は少し軽くなったりとか、どう感じますか？",
            "Chinese": "好的。在这样安慰自己之后，心里会感觉轻松一些吗？还是有别的感受？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:38:03",
            "content": "言い聞かせた後は",
            "Chinese": "在安慰过自己之后，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:38:11",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:38:15",
            "content": "あんまり効果はなくて",
            "Chinese": "效果不太明显，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:38:22",
            "content": "もう1人の自分は",
            "Chinese": "另一个自己会说，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:38:23",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:38:50",
            "content": "いや大丈夫じゃない、このまま成績悪かったらどうしよ、って言う感じで",
            "Chinese": "“不，才不是没关系，要是业绩一直这么差该怎么办”，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:38:57",
            "content": "焦らないことが怖いんですよね",
            "Chinese": "不焦虑反而让我害怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:39:08",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:39:10",
            "content": "焦った方が安心する？って言ったらいいんでしょうか",
            "Chinese": "该怎么说呢，反而是焦虑一点会让我更安心？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:39:31",
            "content": "自分が全然制約できなくて",
            "Chinese": "当我完全签不了单，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:39:34",
            "content": "ダメだった時",
            "Chinese": "表现不好的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:39:38",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:39:42",
            "content": "落ち込むから、その準備をしなきゃ！みたいに",
            "Chinese": "因为会很沮丧，所以必须为此做好心理准备！就像这样，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:39:48",
            "content": "結果を軽く決めつけて",
            "Chinese": "我会轻易地预设一个坏结果，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:39:57",
            "content": "傷つかないよう準備をする、って感じです",
            "Chinese": "像是在为不受伤害而提前做准备。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:40:23",
            "content": "そうなんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:40:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:41:25",
            "content": "もう一人の自分が、ダメだった時の自分を傷つけないように準備する、",
            "Chinese": "另一个自己，为了不让失败时的自己受伤而做好准备，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:41:33",
            "content": "という感じですか？",
            "Chinese": "是这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:41:39",
            "content": "そんな感じですね",
            "Chinese": "就是那种感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:41:58",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:42:03",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:43:07",
            "content": "落ち込みたくないとか、傷つきたくない、と思うと、自分を守ろうとするもう一人の自分がいたりするんですね。",
            "Chinese": "当不想沮丧、不想受伤的时候，就会出现另一个想要保护自己的自己呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:43:15",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:44:04",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:44:46",
            "content": "では、あなたはメンタルを保つために",
            "Chinese": "那么，为了保持心态稳定，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:45:13",
            "content": "こんなことだったらできそうかな、というのはどんなことがありそうですか？",
            "Chinese": "您觉得有什么是自己或许可以做到的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:45:21",
            "content": "そーですねー、",
            "Chinese": "这个嘛……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:45:31",
            "content": "もっとその",
            "Chinese": "更多地去，那个……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:45:34",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:45:35",
            "content": "もう1人の自分の声を",
            "Chinese": "倾听另一个自己的声音，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:45:40",
            "content": "聞いてあげることですかね",
            "Chinese": "或许是应该这么做吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:45:53",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:46:28",
            "content": "そうなんですね。もう1人の自分はどんな声をあげている感じですか？",
            "Chinese": "是这样啊。那另一个自己发出了什么样的声音呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:46:43",
            "content": "もう頑張りたくないって思ってます",
            "Chinese": "它在说“我不想再努力了”。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:46:50",
            "content": "早く楽にさせてほしいとか",
            "Chinese": "“想快点轻松下来”，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:46:56",
            "content": "これ以上無理とか",
            "Chinese": "“已经到极限了”，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:46:57",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:47:16",
            "content": "もういいじゃんこれ以上はって",
            "Chinese": "“已经够了，不要再勉强了”，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:47:24",
            "content": "言ってるイメージです",
            "Chinese": "大概是在说这些吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:47:58",
            "content": "そうなんですね。これまでずっと頑張ってこられたんですね。",
            "Chinese": "是这样啊。您一直以来都非常努力呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:48:17",
            "content": "そうですね結構無理してきたと思います",
            "Chinese": "是的，我觉得自己还挺勉强自己的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:48:50",
            "content": "その声をあまり聴かないでずっと突っ走ってきたんですね。。。",
            "Chinese": "您没怎么倾听那个声音，而是一路硬撑着走过来了呢……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:49:11",
            "content": "聞く時ももちろんあったんですけど",
            "Chinese": "当然，也有倾听的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:49:18",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:49:19",
            "content": "最近は聞けてなかったです",
            "Chinese": "但最近没能好好倾听。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:49:21",
            "content": "勢いで",
            "Chinese": "有点想靠着一股劲头，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:49:26",
            "content": "乗り越えようとしてるところはありました",
            "Chinese": "把事情硬扛过去。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:50:00",
            "content": "そうなんですね。勢いで乗り越えようと無理して頑張ってきたんですね。。。",
            "Chinese": "是这样啊。您一直勉强自己，想靠着一股劲头去努力克服困难呢……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:50:07",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:51:00",
            "content": "そのもう一人の自分からすると、しんどい気持ちがあるのに、",
            "Chinese": "对另一个自己来说，明明感觉很辛苦，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:51:40",
            "content": "勢いで無理してて、最近は聞けてなかったんですね。",
            "Chinese": "您却靠着一股劲勉强着，最近也没能倾听它的声音呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:51:50",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:52:40",
            "content": "そのもう一人の自分の声にあなたは気づきましたが、",
            "Chinese": "现在您已经注意到了另一个自己的声音，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:53:00",
            "content": "その自分になんて言ってあげたいですか。",
            "Chinese": "您想对那个自己说些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:53:10",
            "content": "そーですね",
            "Chinese": "这个嘛，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:53:16",
            "content": "しんどいよね、ごめんねって",
            "Chinese": "想对它说“你很辛苦吧，对不起”，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:53:24",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:53:50",
            "content": "言葉をかけてあげたいです、後は、どうしたいかを聞いてあげたいです",
            "Chinese": "我想对它说这样慰劳的话，然后，还想问问它到底想怎么做。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:53:59",
            "content": "どうしたいかって聞いたときに",
            "Chinese": "当问它“你想怎么做”的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:54:04",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:54:09",
            "content": "私が不安に思ってる不安に対して",
            "Chinese": "对于我所担心的不安，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:54:23",
            "content": "悪いことは悪いことが起こったときに考えたらいい、じゃなくて",
            "Chinese": "我想要的答案不是“等坏事发生了再想就行了”，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:54:33",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:54:37",
            "content": "もしうまくいかなくて悪いことが起こったとしてもこうするから大丈夫っていう",
            "Chinese": "而是“即使不顺利，发生了糟糕的情况，我们也可以这样做，所以没关系”这样的保证。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:54:48",
            "content": "安心が欲しいって言う気持ちです",
            "Chinese": "我想要的是这样一种安心感。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:54:59",
            "content": "何かあったらその時考えるじゃ",
            "Chinese": "因为“到时候再说”这种话，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:55:06",
            "content": "遅いからって",
            "Chinese": "往往就已经晚了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:55:12",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/15(日) 21:55:19",
            "content": "そんな気持ちですね",
            "Chinese": "就是这种心情吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/15(日) 21:55:29",
            "content": "素敵なお気遣いですね。",
            "Chinese": "这份体贴真是太棒了。"
