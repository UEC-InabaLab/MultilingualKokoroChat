{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 18:51:26",
            "content": "今日はよろしくお願いします。",
            "Chinese": "今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 18:51:47",
            "content": "こちらこそ宜しくお願い致します",
            "Chinese": "彼此彼此，也请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 18:53:18",
            "content": "もし可能でしたら、希死念慮のあるクライエント役をしていただけたらと思います。",
            "Chinese": "如果可以的话，希望您能扮演一位有自杀意念的来访者。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 18:53:46",
            "content": "了解いたしました",
            "Chinese": "明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 18:55:53",
            "content": "よろしくお願いいたします。",
            "Chinese": "那就拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:00:01",
            "content": "こんにちは、相談員です。お話をお伺いする前に年齢と性別を可能な範囲で教えていただけますか？",
            "Chinese": "您好，我是咨询师。在开始咨询前，可以请您在方便的范围内告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:00:29",
            "content": "52歳、男性",
            "Chinese": "52岁，男性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:00:49",
            "content": "ありがとうございます。今日はどのようなご相談でしょうか。",
            "Chinese": "谢谢您。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:01:45",
            "content": "もう死んでしまった方が",
            "Chinese": "也许死了会..."
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:02:03",
            "content": "楽なんじやないかと考えたりします",
            "Chinese": "我有时会想，是不是会更轻松一些。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:02:41",
            "content": "そうお考えになられるほど、お辛い状況なのですね。",
            "Chinese": "您会这么想，说明您现在的处境一定非常痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:02:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:03:35",
            "content": "どのようなことがおありなのか、もう少し詳しく教えていただけますか？",
            "Chinese": "能否再详细说说，发生了些什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:04:15",
            "content": "嫁さんも家を出ていってしまって、",
            "Chinese": "我妻子离家出走了，"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:04:36",
            "content": "毎日会社に行くのもつらいんです",
            "Chinese": "每天去公司也很煎熬。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:05:11",
            "content": "そのようなことがおありだったのですね。",
            "Chinese": "原来发生了这样的事啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:06:23",
            "content": "パートナーさんが、家を出られたのには、どのようなことがあったのか、話せる範囲で構いませんので、お聞かせいただけますか？",
            "Chinese": "关于您的伴侣离家出走，能请您在方便的范围内告诉我发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:07:04",
            "content": "ちょっと手を出してしまって",
            "Chinese": "我一时冲动动了手，"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:07:28",
            "content": "それで怒って出ていってしまったんですね",
            "Chinese": "然后她就生气地离家出走了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:08:34",
            "content": "そのようなことがおありだったのですね。それは、最近のことなのでしょうか？",
            "Chinese": "原来发生了这样的事啊。这是最近发生的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:08:48",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:09:13",
            "content": "もう半年前くらいのことです",
            "Chinese": "大概是半年前的事了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:11:19",
            "content": "なるほどです。お辛いことですね。手を出されたということですが、初めてのことだったのでしょうか？",
            "Chinese": "我明白了。这一定很难过吧。您说您动手了，这是第一次吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:12:08",
            "content": "そうですね、そんなことはこれまであまりありませんでした",
            "Chinese": "嗯，以前基本没有过这种事。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:12:33",
            "content": "喧嘩はよくしてましたが…",
            "Chinese": "虽然我们经常吵架…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:13:47",
            "content": "ええ。そういうことはあまりなかったということなのですね。その時、どんな考えが頭に浮かんでいましたか？",
            "Chinese": "嗯。就是说以前基本没有过动手的情况是吗。当时，您脑海里在想些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:14:39",
            "content": "その時ははっきりとは分からなかったのですが、",
            "Chinese": "当时我也不太清楚，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:14:54",
            "content": "ええ。（お聴きしていますね）",
            "Chinese": "嗯。（我在认真听。）"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:15:21",
            "content": "後からとりかえしがつかないことをしてしまったと思いました",
            "Chinese": "事后我觉得自己做了无法挽回的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:17:34",
            "content": "そのようにお感じになったのですね。そう思うとショックですし、時間を巻き戻したい気持ちになりますね。",
            "Chinese": "您是这么感觉的啊。这么想的话会很受打击，也会想让时间倒流吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:18:02",
            "content": "はい、もうどうしたらいいのか",
            "Chinese": "是的，我已经不知道该怎么办了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:18:18",
            "content": "もう消えてしまいたいです",
            "Chinese": "真想就这样消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:19:37",
            "content": "そうなのですね。とてもおつらいですね。そのようなことになったのは、喧嘩がきっかけだったのでしょうか？",
            "Chinese": "是这样啊。您一定非常痛苦。事情会发展到这一步，是因为吵架吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:20:30",
            "content": "実は私は酒を飲むのが大好きなんですね",
            "Chinese": "其实我非常喜欢喝酒。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:20:40",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:21:07",
            "content": "唯一の生き甲斐といっていいと思います",
            "Chinese": "可以说是我唯一的精神寄托了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:21:59",
            "content": "そうなのですね。とても、お好きなのですね。",
            "Chinese": "是这样啊。您真的很喜欢喝酒呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:22:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:22:12",
            "content": "それで",
            "Chinese": "然后……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:22:20",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:22:49",
            "content": "その時も叩いたことはあまり覚えてないんですね",
            "Chinese": "当时动手打人的事，我也不太记得了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:23:28",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:24:06",
            "content": "そんことが原因なのかなと…",
            "Chinese": "我想，也许这就是原因吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:25:21",
            "content": "お酒を飲まれると…ご自分を見失ってしまわれる位いお飲みになることがあるということでしょうか？",
            "Chinese": "您的意思是，您喝酒的时候，有时会喝到失去自我的程度吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:25:52",
            "content": "そうですね、お恥ずかしながら",
            "Chinese": "是的，说来惭愧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:26:38",
            "content": "いえいえ、お話してくださってありがとうございます。",
            "Chinese": "不会不会，感谢您告诉我这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:27:29",
            "content": "お酒を巡って、喧嘩をされることもあったということですか？",
            "Chinese": "就是说，你们也会因为喝酒的事吵架吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:28:24",
            "content": "確かによくありました",
            "Chinese": "确实经常有。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:28:53",
            "content": "でもここまでのことは無かったです",
            "Chinese": "但从没有到过这种地步。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:30:30",
            "content": "そうだったのですね。その時にそこまでお酒を飲まれたのには、何かおありだったのでしょうか？",
            "Chinese": "原来是这样。那次您喝了那么多酒，是有什么特别的原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:31:09",
            "content": "コロナになって飲みに行けなくなって",
            "Chinese": "因为新冠疫情，不能出去喝酒了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:31:24",
            "content": "イライラしてたのはあると思います",
            "Chinese": "我觉得可能因此感到烦躁。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:31:26",
            "content": "ええ。ええ。",
            "Chinese": "嗯。嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:32:32",
            "content": "なるほどです。コロナ禍で、外で飲むことが難しくなり、ストレスも溜まっていたということなのですね。",
            "Chinese": "我明白了。也就是说，因为新冠疫情，很难在外面喝酒，所以也积攒了压力，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:32:49",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:32:52",
            "content": "まあ",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:32:58",
            "content": "そうですね",
            "Chinese": "是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:33:09",
            "content": "お話を少しまとめさせて頂いでもよろしいでしょうか。",
            "Chinese": "我可以稍微总结一下您说的话吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:33:19",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:34:31",
            "content": "何か言葉をさえぎってしまったのではないでしょうか？",
            "Chinese": "我是不是把您的话打断了？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:34:53",
            "content": "いや",
            "Chinese": "没有，"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:34:59",
            "content": "いいんです",
            "Chinese": "没关系的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:35:52",
            "content": "今お感じになっていらっしゃることをお聞かせいただけますか？",
            "Chinese": "能和我说说您现在的感受吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:36:33",
            "content": "自分は生きてる価値なんか無いな",
            "Chinese": "我觉得自己活着毫无价值，"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:36:48",
            "content": "ということですね",
            "Chinese": "大概就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:39:25",
            "content": "価値がないと感じてしまわれるのは、本当に悲しくて、寂しいと思います。でも、そのようなお気持ちの中で、今日はお話にいらしてくださったのですね。",
            "Chinese": "觉得自己没有价值，这一定是一件非常悲伤和孤独的事。但是，在这样的心情下，您今天还是来这里和我谈话了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:39:53",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:41:27",
            "content": "あなたは、お酒を召し上がるのが、唯一の楽しみで、時には自分を見失うこともあったものの、コロナ禍のストレスもあり、パートナーさんに手を出してしまい、家を出で行かれた。ということでしょうか？",
            "Chinese": "您是说，喝酒是您唯一的乐趣，虽然有时会因此失去自我，但加上新冠疫情的压力，您对伴侣动了手，导致她离家出走了。是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:42:14",
            "content": "まあ、そうですね",
            "Chinese": "嗯，差不多是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:42:53",
            "content": "今は、パートナーさんと連絡などはどのような感じなのでしょうか？",
            "Chinese": "现在，您和伴侣的联系情况怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:43:18",
            "content": "まったく取れてないですね",
            "Chinese": "完全没有联系。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:45:21",
            "content": "そうなのですか。それは、どうしていいかわからなくなってしまいますね。",
            "Chinese": "这样啊。那确实会让人不知所措呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:45:35",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:47:50",
            "content": "会社に行かれるのも、お辛い状況だと思いますが、どなたかパートナーさんとの間に入って下さるような方はいらっしゃるのでしょうか？",
            "Chinese": "去公司上班想必也很痛苦吧，有没有什么人可以帮您在和伴侣之间调解一下呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:48:32",
            "content": "誰も思いあたらないですね",
            "Chinese": "我想不出有谁。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:49:31",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:49:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:50:08",
            "content": "他にご家族はいらっしゃるのでしょうか？",
            "Chinese": "您还有其他的家人吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:51:06",
            "content": "娘がいますが、もう家を働いてます",
            "Chinese": "有个女儿，不过她已经独立出去工作了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:51:26",
            "content": "↑家を出て　です",
            "Chinese": "啊，是“离开家独立”的意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:52:29",
            "content": "そうなのですね。娘さんとは連絡が取れたりするのでしょうか？",
            "Chinese": "这样啊。和女儿还能联系上吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:52:54",
            "content": "まあ、取れないことはないですが",
            "Chinese": "嗯，也不是联系不上……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/15(火) 19:53:06",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:53:24",
            "content": "私とは関わりたくと思ってると思います",
            "Chinese": "我想她应该不太想和我来往。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/15(火) 19:53:54",
            "content": "酒で家族に迷惑をかけてきた人間ですからね",
            "Chinese": "毕竟我是个一直因喝酒给家人添麻烦的人。"
