{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 18:56:49",
            "content": "（こんばんは。今日はどうぞよろしくお願い致します。）",
            "Chinese": "（晚上好。今天请多多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 18:59:42",
            "content": "こんばんは～今日はよろしくお願い致します。",
            "Chinese": "晚上好～今天请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:00:17",
            "content": "（はじめさせて頂きますね。）",
            "Chinese": "（那我就开始了。）"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:00:21",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:00:43",
            "content": "こんばんは。相談員です。",
            "Chinese": "晚上好。我是咨询师。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:00:47",
            "content": "今日はどのようなご相談でしょうか。",
            "Chinese": "今天您想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:01:34",
            "content": "こんばんは",
            "Chinese": "晚上好。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:02:59",
            "content": "自分は、社会人野球をしていて、プロをめざしているのですが",
            "Chinese": "我现在打社会人棒球，目标是成为职业选手，不过……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:03:24",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:03:40",
            "content": "年齢も今年28歳になり",
            "Chinese": "而且我今年也28岁了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:03:48",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:04:21",
            "content": "自分としては、今年にかけていたのですが",
            "Chinese": "对我自己来说，我把赌注都压在了今年。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:04:34",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:05:12",
            "content": "大きな大会も終わって",
            "Chinese": "大型比赛也结束了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:05:27",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:06:38",
            "content": "今年は、野球をしていて一番悔しくて不甲斐ない年になってしまって・・・・",
            "Chinese": "结果今年成了我打棒球以来最懊悔、也最不争气的一年……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:07:09",
            "content": "そうなのですね、、",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:07:16",
            "content": "今までで一番辛い精神状態で",
            "Chinese": "我现在处于有史以来最痛苦的精神状态。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:08:12",
            "content": "仕事のこと、野球のこと、身体のこと、、、、チームのことなどいろいろ考えていたら",
            "Chinese": "工作的事、棒球的事、身体的事……还有球队的事，各种事情都涌上心头……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:08:33",
            "content": "それはとてもお辛いですよね、、。はい、、。",
            "Chinese": "那一定非常痛苦吧……嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:08:52",
            "content": "夜もなかなか寝つけなかったりして悪循環です",
            "Chinese": "晚上也难以入睡，陷入了恶性循环。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:08:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:10:01",
            "content": "それは、体も疲れてしまって悪循環でしんどいですよね、、",
            "Chinese": "这样身体也会很累，陷入恶性循环，一定很难受吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:10:07",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:11:00",
            "content": "寝ようとしても、いろんなことが頭の中に浮かんできて、寝づらいことが多くなってきました",
            "Chinese": "就算想睡，各种念头也会在脑海里浮现，越来越难以入睡了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:11:27",
            "content": "そうですかあ、、。それは本当辛いですよね、、。",
            "Chinese": "是这样啊……那真的很难受呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:11:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:11:37",
            "content": "一番",
            "Chinese": "最……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:11:48",
            "content": "気になってしまうことはどのことでしょうか、、。",
            "Chinese": "让您最在意的是哪一件事呢……？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:11:48",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:13:06",
            "content": "一番といわれてもあれなんですが",
            "Chinese": "要说最在意的哪一件，其实也有点难以一下子说清。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:13:18",
            "content": "はい、、。",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:14:32",
            "content": "今年の春、監督が代わって、その監督とトラブルのようなことがあって",
            "Chinese": "今年春天，换了新教练，和那位教练之间发生了类似矛盾的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:14:44",
            "content": "そうなのですね、、。",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:15:48",
            "content": "トラブルというか、チームのこと、そして自分の考えを伝えた後ぐらいから",
            "Chinese": "与其说是矛盾，不如说是在我传达了关于球队和自己的想法之后……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:15:58",
            "content": "はい、、",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:16:03",
            "content": "試合で結果を出すことができなくて",
            "Chinese": "比赛里就没能打出成绩。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:16:23",
            "content": "はい、、",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:16:41",
            "content": "そのあたりから、試合でもあまり使ってもらえなくなってしまいました",
            "Chinese": "从那时候开始，比赛时也就不怎么让我上场了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:17:13",
            "content": "そうなんですね、、。それはなんだかとても悔しいですよね、、。",
            "Chinese": "是这样啊……那真是非常不甘心吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:18:48",
            "content": "今年は、自分自身今まで以上に野球に集中して、時間も気持ちもかけてきただけに、とても辛かったです",
            "Chinese": "今年我比以往更专注于棒球，投入了大量时间和心力，所以格外难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:20:01",
            "content": "そうですよね。それは本当お辛いですよね、、。",
            "Chinese": "是啊。那真的很难受呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:20:21",
            "content": "ご自分の考えというのは、どういったことをお伝えされたのでしょうか。",
            "Chinese": "您说的自己的想法，具体是指什么内容呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:21:56",
            "content": "チームの練習とか、メンバーのこととか、自分は抑えのピッチャーとして今までもまかされてきたので、その役を責任をもって全力でばんばるといようなことなどです",
            "Chinese": "比如球队的练习、队员的事情，还有我一直以来都担任终结投手，所以也表示会负起责任，全力以赴地完成这个角色。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:23:37",
            "content": "そうなのですね、、。全力でがんばると伝えた後に結果を出すことができなくて、とても苦しかったですね、、。",
            "Chinese": "是这样啊……在表达了会全力以赴之后却没能打出成绩，那一定非常煎熬吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:24:01",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:24:30",
            "content": "結果を出すことができなくなったのは、何かきっかけなどありましたか？",
            "Chinese": "后来无法打出成绩，是有什么契机或原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:24:59",
            "content": "いや特に何があったわけではないですが",
            "Chinese": "不，倒也不是发生了什么特别的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:25:07",
            "content": "はい、、",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:26:38",
            "content": "たしかに、監督とのことがあったので、監督のことが気にならないといったら、嘘になりますね・・・・",
            "Chinese": "不过，确实因为和教练发生了那些事，要说完全不在意教练，那也是骗人的……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:28:08",
            "content": "そうですかあ、、。少し気になりますよね、、。監督のことはどのように思われていますか？",
            "Chinese": "是这样啊……多少还是会在意的吧……您对教练是怎样的看法呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:30:54",
            "content": "自分の言うことが正しいというか、あまり周囲の意見を聞く方ではないように感じます・・・・",
            "Chinese": "总觉得他更坚持自己说的就是对的，似乎不太愿意倾听周围人的意见……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:32:16",
            "content": "そうですかぁ。その様に感じていらっしゃるのですね。監督との関係は今どのような感じですか？",
            "Chinese": "是这样啊，您是那样感受到的。那您和教练目前的关系是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:32:48",
            "content": "挨拶程度で、話もできていない状態です。",
            "Chinese": "也就点头打个招呼的程度，几乎谈不上交流。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:33:55",
            "content": "そうですかぁ。それは、少し気まずく感じますね、、。",
            "Chinese": "这样啊，那确实会让人觉得有些尴尬呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:34:09",
            "content": "そうなんです。きまずいのです",
            "Chinese": "是的，就是很尴尬。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:34:42",
            "content": "それは、少ししんどいですよね、、。",
            "Chinese": "那确实会有些难受呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:35:23",
            "content": "年齢も年齢なだけに、これからどうしていくかも自分と向き合っていかなくてはと思うのですが",
            "Chinese": "毕竟也到了这个年纪，我觉得必须正视自己，考虑今后该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:35:31",
            "content": "はい、、。",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:36:06",
            "content": "今年が全力投球できなかったというか、不完全燃焼で、",
            "Chinese": "今年可以说没能全力以赴，有种不完全燃烧的感觉，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:36:17",
            "content": "はい、、。",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:37:14",
            "content": "もう辞めようとかの結論には、自分の中ではでてこないのですが",
            "Chinese": "我心里倒也没有得出“干脆放弃吧”这样的结论。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:37:22",
            "content": "はい、、",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:37:27",
            "content": "なにしろ、年齢も年齢なだけに",
            "Chinese": "只是，毕竟年纪摆在那儿。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:37:35",
            "content": "はい、、。",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:39:20",
            "content": "それから、肘を2回手術していたり、年齢のことなど考えていくと、自分の中でもいろいろ考えて、来年も続けていけるのかとか",
            "Chinese": "还有，我肘部做过两次手术，再考虑到年龄的问题，心里就会想很多，比如明年还能不能继续下去之类的。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:39:31",
            "content": "身体がもつのかとか",
            "Chinese": "身体还能不能撑得住。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:40:16",
            "content": "監督とのことなども考えて、複雑な心境です",
            "Chinese": "再加上和教练的关系等等，心情很复杂。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:40:28",
            "content": "そうですか。これからのこと、身体のことを考えると少し焦ってしまいますよね、、。",
            "Chinese": "是这样啊。一想到今后和身体的情况，难免会有些焦虑吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:40:43",
            "content": "それに、監督のことも気がかりですよね、、。",
            "Chinese": "而且，教练的事也让人挂心吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:42:23",
            "content": "これまで、お話しを聞かせて頂いて、私が思ったことを少しお伝えさせて頂いても大丈夫でしょうか、、。",
            "Chinese": "听了您这么多，我可以稍微说一下我的想法吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:42:24",
            "content": "はい、そうなんです",
            "Chinese": "是的，就是这样。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:43:56",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:44:11",
            "content": "よろしくお願いします",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:44:28",
            "content": "はい、、。あなたは、年齢のこともあるので、今年、野球のことに時間も気持ちもかけてこられました。",
            "Chinese": "好的……因为年龄的关系，您今年在棒球上投入了大量的时间和精力。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:45:33",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:47:08",
            "content": "今年の春には、監督が代わってその後から、試合で結果を出すことができなく、試合でもあまり使ってもらえなくなったこともあり、監督さんとは少しきまずい思いをされています。",
            "Chinese": "今年春天换了教练之后，您在比赛中没能拿出成绩，上场机会也变少了，因此和教练之间关系有些尴尬。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:47:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:48:54",
            "content": "そのことや、これから先のこと、仕事のこと、身体のことを考えるととても辛く、夜も寝ずらくなられています。",
            "Chinese": "考虑到这些事，以及未来的事、工作的事、身体的事，您感到非常痛苦，晚上也难以入睡。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:49:20",
            "content": "そのとおりです",
            "Chinese": "完全是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:49:46",
            "content": "そこで、私が思ったことなのですが、",
            "Chinese": "基于此，我有一个想法，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:49:52",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/30(月) 19:50:41",
            "content": "あなたは、今年という時間の枠を決められて、とてもとても全力疾走されたと思うのです。",
            "Chinese": "您为自己设定了“今年”这个时间框架，并且我认为您已经非常、非常努力地全力冲刺了。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/30(月) 19:51:09",
            "content": "はい、そうですね",
            "Chinese": "是的，是这样。"
        },
        {
            "role": "カウンセラー",
