{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 14:51:41",
            "content": "(こんにちは。本日はよろしくお願いいたします。）",
            "Chinese": "（您好，今天请多多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 14:52:27",
            "content": "（時間になったら、始めさせて頂きます。）",
            "Chinese": "（时间到了，我们就正式开始。）"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 14:52:45",
            "content": "（よろしくお願いいたします。本日ご希望のケース等は、ございますでしょうか？）",
            "Chinese": "（请多关照。请问今天您有希望练习的案例吗？﻿）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 14:54:09",
            "content": "（特にありません。色々経験をさせていただいている所です。）",
            "Chinese": "（没有特别的要求。我正在积累各种经验。）"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 14:54:34",
            "content": "（かしこまりました。）",
            "Chinese": "（明白了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 14:55:01",
            "content": "（お心遣いありがとうございます。）",
            "Chinese": "（感谢您的关心。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:00:14",
            "content": "こんにちは。本日は相談に来ていただきありがとうございます。よろしければ年齢、性別を教えてください。",
            "Chinese": "您好。感谢您今天前来咨询。如果方便的话，请告诉我您的年龄和性别。"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:01:18",
            "content": "13　男",
            "Chinese": "13岁，男。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:01:33",
            "content": "ありがとうございます。本日はどのようなご相談ですか。",
            "Chinese": "谢谢您。今天您想咨询哪方面的问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:01:58",
            "content": "学校に行きたくありません",
            "Chinese": "我不想去上学。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:02:47",
            "content": "そうなんですね。学校に行きたくないのですね。",
            "Chinese": "是这样啊。您是不想去上学，对吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:03:06",
            "content": "それはつらいですね。",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:03:35",
            "content": "これはAIが対応しているのですか？",
            "Chinese": "是AI在回复我吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:04:01",
            "content": "いいえ。相談員が対応をしています。",
            "Chinese": "不是的，是咨询员在为您服务。"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:04:30",
            "content": "相談員がAIですか？",
            "Chinese": "咨询员是AI吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:05:37",
            "content": "人が相談員をしております。",
            "Chinese": "是真人在担任咨询员。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:05:52",
            "content": "今は学校に行っているのですか。",
            "Chinese": "您现在有去上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:06:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:06:56",
            "content": "そうなんですね。どういう時に学校に行きたくないと思われるのですか。",
            "Chinese": "是这样啊。您在什么情况下会觉得不想去上学呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:07:10",
            "content": "いつも",
            "Chinese": "一直都这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:07:26",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:08:12",
            "content": "学校に行きたくないと思う時、どんなことが思い浮かぶのですか。",
            "Chinese": "当您不想去上学的时候，会想到些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:08:40",
            "content": "よくわかりません",
            "Chinese": "我不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:08:49",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:09:34",
            "content": "学校に行きたくないと思うことをどなたかに話したことはありますか。",
            "Chinese": "您有跟谁说过不想上学这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:09:45",
            "content": "いいえ",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:10:36",
            "content": "そうなんですね。自分でいろいろと考えられているのですね。",
            "Chinese": "是这样啊。您自己一个人思考了很多事情呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:11:16",
            "content": "いつぐらいからそう思われるようになったのですか。",
            "Chinese": "您大概是从什么时候开始有这种想法的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:11:31",
            "content": "最近",
            "Chinese": "最近。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:11:48",
            "content": "最近なんですね。",
            "Chinese": "是最近开始的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:12:34",
            "content": "学校に行きたくないと思うきっかけはありましたか。",
            "Chinese": "有什么契机，让您产生了不想去上学的念头吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:13:05",
            "content": "クラスの人からどう思われてるかわからないから",
            "Chinese": "因为不知道班上的同学是怎么看我的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:13:23",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:14:16",
            "content": "クラスの人からどう思われているのかわからないのが、不安に思ったり怖く思ったりしているんですね。",
            "Chinese": "因为不清楚同学们是怎么看您的，所以您会感到不安，甚至有些害怕，是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:15:41",
            "content": "学校でどんな時にそう思うようになったのですか。",
            "Chinese": "在学校里，您是在什么情况下开始有这种感觉的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:16:07",
            "content": "いつも",
            "Chinese": "一直都是。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:16:42",
            "content": "いつも感じるんですね。それはお辛いですね。",
            "Chinese": "您总是有这种感觉啊。那一定很辛苦吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:17:34",
            "content": "クラスに話せる友達はいるのですか。",
            "Chinese": "班里有能聊得来的朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:17:51",
            "content": "一応います",
            "Chinese": "勉强算有吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:18:00",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:18:51",
            "content": "その友達には相談はしているのですか。",
            "Chinese": "有跟那位朋友聊过这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:19:01",
            "content": "いいえ",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:19:17",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:20:02",
            "content": "その友達に相談はできそうですか？",
            "Chinese": "觉得能和那位朋友聊聊吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:20:09",
            "content": "できません",
            "Chinese": "不行。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:20:23",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:20:52",
            "content": "もしその友達に相談したとしたら、どうなると思うのですか。",
            "Chinese": "如果跟那位朋友商量了，您觉得会怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:21:12",
            "content": "分かりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:21:36",
            "content": "わからないんですね。",
            "Chinese": "您不知道会怎么样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:22:48",
            "content": "クラスの人たちから、どんなことを思われているとお考えなのですか。",
            "Chinese": "您觉得同学们可能会怎么看您呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:23:46",
            "content": "さっきわからないって言いませんでしたか？",
            "Chinese": "我刚才不是说了不知道吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:24:40",
            "content": "そうなんですね。わかりました。",
            "Chinese": "是这样啊。我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:26:11",
            "content": "ここまで、クラスの人からどう思われているのかわからないことから、学校に行きたくないと思うようになったというご相談でした。",
            "Chinese": "总结一下目前为止的内容，您是因为不知道班上的同学怎么看您，所以才不想去上学。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:27:04",
            "content": "クラスに友達はいるが、その相談はできないという状態で、大丈夫でしょうか。",
            "Chinese": "班里虽然有朋友，但您无法和他们商量这件事，我这样理解对吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:27:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:27:33",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:28:45",
            "content": "周りからどう思われているのか、おひとりで悩まれてきて、不安に思ったり、怖い気持ちにもなったと思います。",
            "Chinese": "您一直独自烦恼着周围人对您的看法，我想您一定感到很不安，也很害怕吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:29:43",
            "content": "お辛かったですね。",
            "Chinese": "一定很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:31:21",
            "content": "でも、おひとりで悩まれているだけでなく、こちらの相談に来られたことに、相談者様の勇気を感じました。",
            "Chinese": "但是，您没有选择独自烦恼，而是来到这里咨询，我感受到了您的勇气。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:32:48",
            "content": "きっと今の状態から変わりたいと思われているのではないでしょうか。",
            "Chinese": "您或许也希望能改变现在的状况，是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:32:58",
            "content": "いかがですか。",
            "Chinese": "您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:33:15",
            "content": "分かりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:33:28",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:35:30",
            "content": "もし、クラスの人からどう思われているのかという問題がなければ、学校へ行きたいと思いますか。",
            "Chinese": "如果没有“同学们怎么看我”这个烦恼，您会想去上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:35:48",
            "content": "もう行っているのですが",
            "Chinese": "可是，我现在就在上学啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:36:00",
            "content": "そうですね。",
            "Chinese": "说得也是。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:37:31",
            "content": "不安な気持ちや辛い気持ちがあっても、学校に通っていることは、とても頑張っていることと思います。",
            "Chinese": "即使心里感到不安和难受，您也仍然坚持去上学，我觉得您已经非常努力了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:39:57",
            "content": "悩みを打ち明ける相手として、どなたか思い浮かぶ方はいませんか。",
            "Chinese": "您有没有想到可以倾诉烦恼的人呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:40:08",
            "content": "いません",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:40:20",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:42:31",
            "content": "相談者様は、これからどのようになったらよいとお考えですか。",
            "Chinese": "您觉得，接下来情况变成什么样会比较好呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:42:58",
            "content": "分かりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:44:00",
            "content": "ずっとこのままクラスの人からどう思われているのかと考えていくのか。",
            "Chinese": "是要一直这样在意同学们怎么看您，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:44:54",
            "content": "それとも何かを変えていきたい、変わりたいとお考えなのですか。",
            "Chinese": "还是说，希望做出一些改变，让自己有所改变呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:45:07",
            "content": "分かりません",
            "Chinese": "不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:45:20",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:46:09",
            "content": "ご自分の中で思いがうまくまとまらない感じですか。",
            "Chinese": "是不是感觉自己心里的想法，还不太能理得清楚呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:46:29",
            "content": "一応",
            "Chinese": "算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:46:53",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:47:59",
            "content": "もやもやしている気持ちがあるのですか。",
            "Chinese": "是不是心里有种说不清道不明的烦闷感呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:48:17",
            "content": "どうなんでしょうね",
            "Chinese": "这个嘛，我也说不准。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:48:26",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:50:48",
            "content": "友達からどう思われているのかわからないことから、学校に行きたくない気持ちがあるのに、どうしたらよいのか思いがうまくまとまらない状態なのですね。",
            "Chinese": "您因为不知道朋友们怎么看您，所以产生了不想去上学的心情，但同时又不知道该怎么办，想法也理不清楚，是这样的状态对吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:51:54",
            "content": "ご自分の思いを言葉にすることは難しいですか。",
            "Chinese": "把自己的想法用语言表达出来，对您来说会有些困难吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/06/25(日) 15:52:04",
            "content": "まあはい",
            "Chinese": "算是吧，是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:52:46",
            "content": "確かにどう思われるか、受け入れてもらえるかと考えると、思いを言葉にするのは難しいと思います。",
            "Chinese": "确实，一想到别人会怎么看、会不会接纳自己，要把内心的想法说出来就会变得很困难吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:54:21",
            "content": "でも今、つらい思いをしながらも、学校を休むことなくいかれている相談者様は、学校を休みたいと思う心と戦っているのだと思います。",
            "Chinese": "但是，您现在即使心里很难受，也没有缺席，我想您是在和“想要请假不去学校”的心情作斗争吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:55:18",
            "content": "それだけでも素晴らしいことと感じました。",
            "Chinese": "光是这一点，我就觉得您非常了不起了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/06/25(日) 15:56:10",
            "content": "いかがですか。",
            "Chinese": "您觉得呢？"
