{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 19:51:39",
            "content": "（本日相談者役をさせて頂きます。よろしくお願い致します。）",
            "Chinese": "（今天我扮演来访者角色。请多指教。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 19:56:17",
            "content": "カウンセラー役をさせていただきます。よろしくお願いします。",
            "Chinese": "我扮演咨询师角色。请多指教。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 19:56:39",
            "content": "ありがとうございます。よろしくお願いします。",
            "Chinese": "谢谢您。请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 19:57:26",
            "content": "時間になれば声かけさせていただきます。",
            "Chinese": "到时间我会提醒您。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 19:57:37",
            "content": "わかりました。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:00:05",
            "content": "本日は来てくださりありがとうございます。ここではどんなことでも話してくださいね。",
            "Chinese": "感谢您今天前来。在这里您可以畅所欲言。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:00:54",
            "content": "何を話せばいいんですか？",
            "Chinese": "我该说些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:01:04",
            "content": "よくわからない",
            "Chinese": "我不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:02:09",
            "content": "まず初めに年齢、性別、ご相談内容を教えていただけますか？",
            "Chinese": "首先，能告诉我您的年龄、性别和想咨询的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:02:30",
            "content": "13歳女性",
            "Chinese": "13岁，女性。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:02:42",
            "content": "好きな人とつきあいたい",
            "Chinese": "想和喜欢的人交往。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:03:14",
            "content": "なるほど。好きな子がいるんですね。",
            "Chinese": "原来如此。您有喜欢的人了啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:03:25",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:04:17",
            "content": "その方とは現在の仲はどんな感じですか？",
            "Chinese": "您和对方现在的关系怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:04:38",
            "content": "特に何もない",
            "Chinese": "没什么特别的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:06:04",
            "content": "そうなんですね。　特に何もないというのは、具体的にどうゆうことか教えていたただいてもいいですか？",
            "Chinese": "是这样啊。能具体和我说说“没什么特别的”是指什么情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:06:43",
            "content": "部活で話すだけだから",
            "Chinese": "因为只是在社团活动时说说话。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:07:12",
            "content": "告白したいけど",
            "Chinese": "虽然想告白……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:07:20",
            "content": "びっくりされる",
            "Chinese": "但会让对方吃惊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:07:46",
            "content": "ちなみに何部ですか？",
            "Chinese": "顺便问一下，您参加的是什么社团？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:08:11",
            "content": "バスケです",
            "Chinese": "篮球社。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:08:17",
            "content": "告白したいんですね。　なぜびっくりされると？",
            "Chinese": "您想告白啊。为什么会觉得对方会吃惊呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:08:27",
            "content": "わかりました。",
            "Chinese": "我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:08:39",
            "content": "かわいい後輩としか見てない",
            "Chinese": "对方只把我当成可爱的学妹。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:09:32",
            "content": "先輩なんですね。普段どのような会話をするのですか？",
            "Chinese": "原来对方是学长/学姐啊。你们平时都聊些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:10:08",
            "content": "練習のことぐらい",
            "Chinese": "大概就是练习的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:10:52",
            "content": "そうなんですね。　もっとほかのことについても話したいですよね。",
            "Chinese": "是这样啊。您也希望能多聊一些其他的事情，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:10:58",
            "content": "まあ",
            "Chinese": "算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:11:25",
            "content": "先輩のどんなところが好きですか？",
            "Chinese": "您喜欢学长/学姐的哪些地方呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:11:46",
            "content": "優しいところ",
            "Chinese": "她很温柔。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:12:27",
            "content": "優しいんですね。素敵です！",
            "Chinese": "很温柔啊。真好！"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:12:34",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:13:17",
            "content": "告白したいとのことですが、自分の中では何か決めていますか？",
            "Chinese": "您提到想告白，那您自己心里有什么计划吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:13:30",
            "content": "嫌われなくない",
            "Chinese": "不想被讨厌。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:13:44",
            "content": "だから怖い",
            "Chinese": "所以很害怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:14:13",
            "content": "それはつらいですよね。",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:14:26",
            "content": "びっくりされる",
            "Chinese": "会让对方吃惊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:15:12",
            "content": "びっくりされるというのが怖いということですか？4",
            "Chinese": "您的意思是，害怕会让对方吃惊吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:15:38",
            "content": "そうかも",
            "Chinese": "可能是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:16:49",
            "content": "そうですよね。　もっとスキンシップをとるというのはどうですか？",
            "Chinese": "是啊。那多一些亲近的互动怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:17:02",
            "content": "？？",
            "Chinese": "？？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:18:30",
            "content": "今のままだと告白したらびっくりせれると思うのですね。",
            "Chinese": "您是觉得如果维持现状去告白的话，会让对方吃惊，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:18:50",
            "content": "告白したいとは言ってない",
            "Chinese": "我并没有说想告白。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:19:08",
            "content": "つきあいたいとは言ったけど",
            "Chinese": "我是说了想交往。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:19:45",
            "content": "失礼いたしました。付き合いたいとのことですね。",
            "Chinese": "非常抱歉。是想交往，对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:20:31",
            "content": "なぜ付き合いたいと思いなのでしょうか？",
            "Chinese": "为什么会想要交往呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:20:45",
            "content": "好きだから",
            "Chinese": "因为喜欢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:20:57",
            "content": "そばにいたいから",
            "Chinese": "因为想在她身边。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:21:17",
            "content": "それほど魅力的な方なんですね。",
            "Chinese": "看来对方是那么有魅力的人啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:21:52",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:21:59",
            "content": "そばにいたいというのは素敵なことですね。",
            "Chinese": "想待在对方身边是件很美好的事呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:22:22",
            "content": "そうかな",
            "Chinese": "是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:23:33",
            "content": "そうですよ。その想いも好きな方に届いたらきっとうれしいと思います。",
            "Chinese": "是啊。这份心意如果能传达给您喜欢的人，对方一定会很高兴的。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:23:50",
            "content": "でもびっくりされる",
            "Chinese": "但是会让对方吃惊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:24:43",
            "content": "なぜそう思いますか？",
            "Chinese": "为什么会这么想呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:24:53",
            "content": "いいたくない",
            "Chinese": "不想说。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:26:37",
            "content": "そうですか。　ここではどんなことを話していただいても大丈夫ですよ。",
            "Chinese": "这样啊。在这里，您说什么都是可以的。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:26:57",
            "content": "嫌われなくないから",
            "Chinese": "因为不想被讨厌。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:27:10",
            "content": "嫌われたくないから",
            "Chinese": "因为不想被讨厌。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:28:02",
            "content": "私はあなたのことを嫌いになんてならないですよ。",
            "Chinese": "我是不会讨厌您的。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:28:26",
            "content": "？？",
            "Chinese": "？？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:29:08",
            "content": "失礼しました。　部活の先輩に嫌われたくないということですね。",
            "Chinese": "抱歉。您的意思是，不想被社团的学长/学姐讨厌，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:29:15",
            "content": "そう",
            "Chinese": "对。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:29:37",
            "content": "話が食い違っていました。すみません",
            "Chinese": "我们刚才有些误解，抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:29:52",
            "content": "大丈夫です",
            "Chinese": "没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:30:07",
            "content": "びっくりされると嫌われるということでしょうか？",
            "Chinese": "您的意思是，担心让对方吃惊会导致被讨厌吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:30:26",
            "content": "そうなったら耐えられない",
            "Chinese": "如果变成那样，我会受不了的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:32:05",
            "content": "お話していると相手の方への気持ちが強いと感じます。",
            "Chinese": "听您说下来，我感觉您对对方的感情非常强烈。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:32:34",
            "content": "きっとその気持ちがあれば嫌われることないと思いますよ",
            "Chinese": "我想，只要有这份心意，您一定不会被讨厌的。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:32:34",
            "content": "だから悩んでます",
            "Chinese": "所以我才烦恼啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:32:48",
            "content": "何でそんなことわかるの",
            "Chinese": "你怎么会知道那种事？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:33:40",
            "content": "すごくまっすぐな気持ちを持たれているのでそう感じました。",
            "Chinese": "因为我感受到您有非常真挚的心意，所以这么觉得。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:34:00",
            "content": "本当に好きなんですね。",
            "Chinese": "您是真的真的很喜欢对方呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:34:48",
            "content": "まあ",
            "Chinese": "算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:35:38",
            "content": "付き合いたいということですが、そのためにはどうしていきたいですか？",
            "Chinese": "您想和对方交往，那么为了实现这个目标，您想怎么做呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:36:40",
            "content": "女の子なのに",
            "Chinese": "明明是女孩子……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:36:54",
            "content": "いつも",
            "Chinese": "总是……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:37:00",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:37:07",
            "content": "女の子が好きになるから",
            "Chinese": "因为我总是会喜欢上女孩子。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:38:08",
            "content": "なるほど。お相手さんは女性ということでしょうか？",
            "Chinese": "原来如此。对方是女性吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:38:20",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:39:03",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:39:10",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:39:51",
            "content": "それでも好きという気持ちは本当に素敵です。",
            "Chinese": "即使如此，这份喜欢的心情也真的很美好。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:40:27",
            "content": "お母さんはおかしいと言った",
            "Chinese": "妈妈说这很奇怪。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:40:53",
            "content": "そうだったんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:41:21",
            "content": "私はすごく素敵だと思いますよ。",
            "Chinese": "我倒觉得非常美好。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:41:40",
            "content": "なんで？",
            "Chinese": "为什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:42:32",
            "content": "お相手さんに対する気持ちがすごく強いからそう思いましたよ。",
            "Chinese": "因为我感到您对对方的感情非常强烈，所以才这么认为。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:42:46",
            "content": "迷惑になる",
            "Chinese": "会给人添麻烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:43:03",
            "content": "お相手さんにですか？",
            "Chinese": "是给对方吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:43:36",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:44:23",
            "content": "なぜそう思いますか？",
            "Chinese": "为什么会这么想呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/12(金) 20:44:41",
            "content": "気持ち悪いから",
            "Chinese": "因为很恶心。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/12(金) 20:45:33",
            "content": "そんなことないですよ。素敵な恋ですよ。",
            "Chinese": "才没有那种事。这是一段很美好的恋情。"
        },
