{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:12:05",
            "content": "おはようございます。よろしくお願いします。",
            "Chinese": "早上好。请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:23:11",
            "content": "このままお待ちしていれば大丈夫でしょうか…？",
            "Chinese": "这样继续等待就可以了吗…？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:25:37",
            "content": "開始の合図があるかと思いますので、もう少しお待ちくださいませ。",
            "Chinese": "应该会有开始的提示，请再稍等片刻。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:26:00",
            "content": "ありがとうございます。承知しました。",
            "Chinese": "谢谢您。我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:26:34",
            "content": "私はカウンセラー部門でのエントリーとなっていますので、よろしくお願いいたします。",
            "Chinese": "我是以咨询师部门的身份参加的，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:58:17",
            "content": "改めまして、おはようございます。テーマ「恋愛」（カウンセリング）11時30分終了予定となります。",
            "Chinese": "再次向您问好，早上好。本次主题为“恋爱”（咨询），预计于11点30分结束。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:58:56",
            "content": "それでは、ここからロールプレイお願い致します。",
            "Chinese": "那么，从现在开始请进行角色扮演。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:59:09",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 10:59:26",
            "content": "こんにちは、相談員です。はじめに、年齢と性別を教えていただいても大丈夫でしょうか？",
            "Chinese": "您好，我是咨询师。首先，方便告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 10:59:39",
            "content": "20歳女性です。",
            "Chinese": "20岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:00:04",
            "content": "ありがとうございます。今日は、どのようなご相談でしょうか？",
            "Chinese": "谢谢您。今天您有什么想咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:00:14",
            "content": "恋愛のことで…",
            "Chinese": "是关于恋爱方面的事…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:00:31",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:00:43",
            "content": "お力になりたいと思いますので、",
            "Chinese": "我很希望能帮到您，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:01:06",
            "content": "お話できる範囲で大丈夫なので、詳しくお聴きできますか？",
            "Chinese": "在您方便的范围内就好，可以跟我详细说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:01:12",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:01:33",
            "content": "実は…彼がいるんですけど、",
            "Chinese": "其实…我有一个男朋友，但是…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:01:45",
            "content": "ええ（続けてくださいね）",
            "Chinese": "嗯（请继续说）"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:01:52",
            "content": "違う人を好きになってしまって…悩んでます。",
            "Chinese": "但我喜欢上了另一个人……很苦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:02:07",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:02:16",
            "content": "それは悩んでしまいますよね…",
            "Chinese": "那确实会让人纠结……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:02:28",
            "content": "はい。どうしたらいいか…",
            "Chinese": "是的。该怎么办才好…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:02:59",
            "content": "どうしたら…と思いますよね。",
            "Chinese": "是啊，会想“该怎么办才好”呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:03:18",
            "content": "ひどい話ですよね(泣)",
            "Chinese": "我这样是不是很过分（哭）"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:03:19",
            "content": "一緒に考えていきたいと思いますよ。",
            "Chinese": "我愿意和您一起慢慢想一想。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:03:26",
            "content": "よろしくお願いします。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:03:43",
            "content": "ご自身を責めてしまう気持ちも、おありなんですね…",
            "Chinese": "您也有责备自己的心情呢…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:03:54",
            "content": "それも、苦しいですよね…",
            "Chinese": "这也一定很痛苦吧…"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:04:06",
            "content": "そうですね。今の彼とは一応将来のことも話していたので",
            "Chinese": "是的。和现在的男友多少也谈过将来的事，所以……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:04:19",
            "content": "うん、うん。",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:04:38",
            "content": "ただ、気持ちに歯止めが効かなくて辛いです。",
            "Chinese": "只是我控制不住自己的感情，很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:05:08",
            "content": "ええ。そうなんですね。",
            "Chinese": "嗯。是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:05:12",
            "content": "気持ちって、自分ではどうにもならない時もありますよね…",
            "Chinese": "感情这种事，有时候自己也无能为力呢…"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:05:21",
            "content": "はい…",
            "Chinese": "是的…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:06:00",
            "content": "あなたとしては…今後はどうなっていければ、気持ちが楽になりそうでしょうか？",
            "Chinese": "对您来说……今后怎样发展，您会觉得心里更轻松一些呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:06:24",
            "content": "今の彼とは別れようかと考えてしまっています。",
            "Chinese": "我在考虑和现在的男朋友分手。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:06:33",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:06:49",
            "content": "新しい彼と、今後は過ごしていきたい感じ？",
            "Chinese": "是想和新的人今后在一起吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:07:11",
            "content": "それも不安なんですけど…",
            "Chinese": "但我也很不安…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:07:20",
            "content": "うん、うん。",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:07:24",
            "content": "新しい彼からは告白されたばかりで。",
            "Chinese": "新的人才刚跟我告白。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:07:34",
            "content": "そっか、そうだったんですね。",
            "Chinese": "哦，原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:08:05",
            "content": "多分、今の彼のこと、心から好きではなくなっていたのかな。",
            "Chinese": "我想，我可能已经不是发自内心地喜欢现在的男朋友了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:08:25",
            "content": "うん、うん。そのような感じもあるのですね。",
            "Chinese": "嗯，嗯。您也有这样的感觉呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:08:40",
            "content": "だから、違う人を好きになってしまったのかな、と思います。",
            "Chinese": "所以，我想我才会喜欢上别人吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:09:02",
            "content": "そうなんだね。そのような気持ちになることもあると思いますよ。",
            "Chinese": "原来如此。我觉得有这样的感受也是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:09:23",
            "content": "そうでしょうか。",
            "Chinese": "是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:09:36",
            "content": "私はひどい女だなーとか思います。",
            "Chinese": "我会觉得自己真是个很糟糕的女人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:09:59",
            "content": "そのように感じているんですね。",
            "Chinese": "您是这样感觉的啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:10:16",
            "content": "なんとなく、そう感じてしまってます。",
            "Chinese": "不知怎的，就会这么觉得。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:11:08",
            "content": "ずっと付き合ってきたから、",
            "Chinese": "因为我们交往很久了，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:11:34",
            "content": "他の人と急に…というのは気が引けるような気持ちもありますよね。",
            "Chinese": "一下子和别的人……会让人有点过意不去的感觉，对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:11:43",
            "content": "でも、",
            "Chinese": "但是，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:11:55",
            "content": "気持ちって、本当に複雑だから…",
            "Chinese": "感情这种事，真的很复杂…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:12:09",
            "content": "そこが、難しいところだし、",
            "Chinese": "这也是它的难处，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:12:16",
            "content": "苦しくもなりますよね。",
            "Chinese": "也会让人感到痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:12:21",
            "content": "はい…",
            "Chinese": "是的…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:12:33",
            "content": "今は…二人とは、どのような関係なんですか？",
            "Chinese": "现在……您和两位各是什么样的关系呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:12:51",
            "content": "えっと、二人とは？",
            "Chinese": "呃，“两位”是指？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:12:56",
            "content": "彼ですか？",
            "Chinese": "是说男朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:13:08",
            "content": "今の彼と新しい人？",
            "Chinese": "现在的男朋友和新认识的那个人？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:13:10",
            "content": "はい。今までの彼と、新しい彼と、",
            "Chinese": "是的。以前的男朋友，和新的人，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:13:18",
            "content": "すみません！",
            "Chinese": "不好意思！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:13:23",
            "content": "今は、どんな関係なのかな？って。",
            "Chinese": "我是想问，现在分别是什么样的关系呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:13:43",
            "content": "謝らないで、大丈夫ですよ。",
            "Chinese": "不用道歉，没关系的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:13:48",
            "content": "今の彼とは2年くらいになりますが、なんとなくなーなーです。",
            "Chinese": "和现在的男朋友交往大概两年了，但关系有点得过且过。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:14:02",
            "content": "一緒に、上京して来たけど、",
            "Chinese": "虽然是一起到东京来的，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:14:11",
            "content": "うん、うん。",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:14:18",
            "content": "仕事も直ぐに辞めてしまって…",
            "Chinese": "但他很快就把工作辞了…"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:14:45",
            "content": "結婚の話もしてましたが、この先不安です。",
            "Chinese": "虽然也谈过结婚的事，但对未来感到很不安。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:14:55",
            "content": "そうなんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:15:07",
            "content": "同居もされていたのかな？",
            "Chinese": "你们是同居的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:15:44",
            "content": "私は学生で彼は社会人なので、彼のアパートには行ったりします。同居はしてません。新しい彼とはまだ出会ったばかりです。",
            "Chinese": "我是学生，他是上班族，所以我会去他的公寓，但没有同居。和新的人才刚认识。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:15:55",
            "content": "なるほどですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:16:23",
            "content": "このまま結婚するのは…と思ってはいました。",
            "Chinese": "我也一直在想，这样就结婚的话……会有些犹豫。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:16:42",
            "content": "学生さんだと、将来のこともいろいろ考えますものね。",
            "Chinese": "作为学生，会对未来的事考虑很多呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:16:53",
            "content": "いろいろなこと、不安になりますよね。",
            "Chinese": "很多事情都会让人不安，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:17:03",
            "content": "はい。彼とは温度差はありますね…",
            "Chinese": "是的。我和他之间确实有温差…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:17:31",
            "content": "そっか。温度差も…",
            "Chinese": "这样啊。温度差也…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:18:02",
            "content": "今の段階から食い違いがあると、",
            "Chinese": "如果从现在这个阶段就有分歧，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:18:29",
            "content": "将来のことを考えると、",
            "Chinese": "一想到将来，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:18:48",
            "content": "抵抗も出てくることも、もっともですね。",
            "Chinese": "会产生抗拒心理也是理所当然的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:19:06",
            "content": "そのような中で、新しい彼と出会った？",
            "Chinese": "是在这种情况下，遇到了新的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:19:43",
            "content": "そうです？",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:19:56",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:20:14",
            "content": "新しい彼とは、どのような出会いでしたか？",
            "Chinese": "和新的那位是怎样认识的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:20:50",
            "content": "バイト先の友達の友達で、みんなで遊びに行き出会いました。",
            "Chinese": "是打工处朋友的朋友，大家一起出去玩时认识的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:21:20",
            "content": "うん、うん。",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:22:32",
            "content": "最初、一緒に遊んでみてどうでしたか？",
            "Chinese": "最开始一起玩的时候，您感觉如何？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:23:15",
            "content": "寒いといったら上着をかけてくれたり、男らしくてトキメキましたm(_ _)m",
            "Chinese": "我一说冷，他就把外套披在我身上，很有男子气概，让我心动了。m(_ _)m"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:23:23",
            "content": "おお…！",
            "Chinese": "哦哦…！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:23:36",
            "content": "紳士な感じ。",
            "Chinese": "很有绅士风度呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:23:49",
            "content": "心温まりますね。",
            "Chinese": "很暖心呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:24:18",
            "content": "嬉しかったです。年も同じだから何となく楽というか。",
            "Chinese": "我很高兴。而且因为同龄，感觉相处起来很轻松。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:24:32",
            "content": "そっか、そっか。",
            "Chinese": "这样啊，这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:24:47",
            "content": "でも、まだお付き合いはしてません。彼がいるから。",
            "Chinese": "不过我们还没交往，因为我现在有男朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:25:13",
            "content": "そうゆうことだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:25:20",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:25:28",
            "content": "教えてくれて、ありがとうです。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:25:34",
            "content": "いえいえ",
            "Chinese": "不客气。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:25:56",
            "content": "どうしよう…ってなってます。",
            "Chinese": "我现在就是“该怎么办啊…”的状态。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:26:12",
            "content": "アドバイスいただけたらと。",
            "Chinese": "希望能得到您的建议。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:26:14",
            "content": "ええ、迷いますよね…",
            "Chinese": "嗯，是会犹豫纠结的呢…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:26:43",
            "content": "しっかりとお力になりたいと思うのですが、その前に、",
            "Chinese": "我很想尽力帮助您，但在那之前，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:26:58",
            "content": "もう一つ、聞かせてほしくて。",
            "Chinese": "我还想再问一个问题。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:27:01",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:27:31",
            "content": "新しい彼とは、どのくらいの付き合いになりますか？",
            "Chinese": "您和新的人认识多久了？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:27:46",
            "content": "まだ、知り合ったばかりです。",
            "Chinese": "才刚认识不久。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:27:55",
            "content": "1ヶ月くらいかな",
            "Chinese": "大概一个月左右吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:28:01",
            "content": "なるほど、そうなんだね。",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:28:09",
            "content": "それであればね、",
            "Chinese": "如果是那样的话，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:28:10",
            "content": "付き合ってとは言われました。",
            "Chinese": "他对我说了“交往吧”。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:28:22",
            "content": "彼がいるのは知ってますが。",
            "Chinese": "虽然他知道我有男朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:28:39",
            "content": "うん、うん。",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:28:53",
            "content": "何だか、凹みます。",
            "Chinese": "总觉得有点沮丧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:29:03",
            "content": "あなたは、新しい彼といるのが今は楽しいんだよね。",
            "Chinese": "现在和新的那位在一起，您是觉得很开心的，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:29:14",
            "content": "こんな状態になってしまって。",
            "Chinese": "竟然变成了这样的状况。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:29:16",
            "content": "凹む？…ですか？",
            "Chinese": "“沮丧”？……是这个意思吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:29:28",
            "content": "申し訳ないというか…",
            "Chinese": "该说是很抱歉吗…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:29:34",
            "content": "うん、うん。",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:29:42",
            "content": "そっか、そうだよね…",
            "Chinese": "这样啊，是呢…"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:29:43",
            "content": "新しい彼とはただ新鮮だからかも。",
            "Chinese": "和新的人在一起，可能只是因为新鲜感。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:29:54",
            "content": "それもあるかもしれないね。",
            "Chinese": "可能也有这个原因呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 11:30:04",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 11:30:06",
            "content": "それなら、もしかしたら",
            "Chinese": "那样的话，或许…"
