{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:52:31",
            "content": "よろしくお願いします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:53:51",
            "content": "私はいつ始められても大丈夫です。よろしくお願いします。",
            "Chinese": "我随时都可以开始，请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:55:02",
            "content": "こんばんは。",
            "Chinese": "晚上好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:55:16",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:55:24",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:56:02",
            "content": "もう始めてもよろしいでしょうか？",
            "Chinese": "现在可以开始了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:56:10",
            "content": "はいお願いします。",
            "Chinese": "好的，请开始吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:56:31",
            "content": "ではお願いいたします。",
            "Chinese": "那么，就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:56:43",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:56:45",
            "content": "こんばんは。相談員です。",
            "Chinese": "晚上好，我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:56:57",
            "content": "こんばんは。",
            "Chinese": "晚上好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:57:00",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:57:15",
            "content": "私は自分に自信が持てなくて",
            "Chinese": "我对自己没有自信……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:57:38",
            "content": "はい、そうなのですね。",
            "Chinese": "嗯，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:58:11",
            "content": "はじめに性別と年齢をお聞きしてもよろしいでしょうか？",
            "Chinese": "首先，可以请问您的性别和年龄吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:58:33",
            "content": "頑張らなきゃいけないといつも思ってしまいます。30代女性です。",
            "Chinese": "我总是觉得自己必须努力。我是30多岁的女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:58:59",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 19:59:23",
            "content": "頑張らなきゃいけないと思うときは具体的にどんな時でしょうか？",
            "Chinese": "具体来说，您在什么时候会觉得自己必须努力呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 19:59:40",
            "content": "仕事も家庭も",
            "Chinese": "工作和家庭都……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:00:03",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:00:37",
            "content": "お仕事でもご家庭でも、いつも頑張っていらっしゃるのですね。",
            "Chinese": "无论是在工作还是在家庭中，您都一直很努力呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:00:55",
            "content": "役に立つ職員で痛いとか、おお母さんでいようとか",
            "Chinese": "比如想成为有用的员工，想当个好妈妈之类的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:01:26",
            "content": "無理して躓いてしまうことが多いです。",
            "Chinese": "很多时候，我都会因为勉强自己而受挫。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:01:35",
            "content": "いたいですね。",
            "Chinese": "是啊，就是想这样。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:01:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:01:59",
            "content": "そうなのですね。いつもフルパワーで頑張っていらっしゃる感じなのですなね。",
            "Chinese": "是这样啊。感觉您一直都在全力以赴地努力着呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:04:03",
            "content": "疲れるのですが、やらなきゃいけないと思うのです。特に特技もないし",
            "Chinese": "虽然很累，但总觉得非做不可。而且我也没有什么特别的专ൊക്കെ。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:06:13",
            "content": "gomennnasai,hennkanndekinakunarimasita.soreha,tukaretesimaimasuyone.",
            "Chinese": "对不起，我的输入法出问题了。那样确实会很累呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:06:38",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:07:55",
            "content": "gokateideha,donnnakotoga komatteimasuka?",
            "Chinese": "在家庭方面，有什么让您困扰的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:08:52",
            "content": "外食もなく、パンなども手作りです",
            "Chinese": "没有外食，连面包都是亲手制作的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:10:18",
            "content": "sounanodesune,tezukuriha,ategakakatteimasuyone",
            "Chinese": "是这样啊，手工制作确实很费工夫呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:11:13",
            "content": "はい。手がかかります。時間も",
            "Chinese": "是的，很费工夫，也很花时间。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:11:52",
            "content": "soudesuyone.gokazokuha ,nannninn irassyaimasuka?",
            "Chinese": "是啊。您家有几口人呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:12:19",
            "content": "私含めて4人です。",
            "Chinese": "包括我在内，一共4个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:13:03",
            "content": "soudesitaka.kazokukouseiwo ,osiete itdakemasuka?",
            "Chinese": "原来如此。可以请您说明一下家庭成员的构成吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:13:45",
            "content": "夫と娘と息子と私です。",
            "Chinese": "丈夫、女儿、儿子和我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:14:28",
            "content": "sounanodesumne.okosannha ,oikutudesyouka?",
            "Chinese": "原来如此。您的孩子多大了呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:15:06",
            "content": "小学生です。高学年です。",
            "Chinese": "在上小学，是高年级。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:16:47",
            "content": "sounanodesune.gokateideha,gokateideha,donnnakotogakomatteirassyaimasuka?",
            "Chinese": "原来如此。在家庭方面，您遇到什么困扰呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:18:01",
            "content": "頑張ろうと思うので疲れます。",
            "Chinese": "因为总想着要努力，所以很累。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:18:50",
            "content": "gnnbaroutoomouto,sugokutukaretesimaimasuyone.",
            "Chinese": "一想着要努力，就会觉得特别累呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:19:24",
            "content": "本当は私はずぼらですし、作りたいときにしか作りたくないし、時には外食で楽したい気持ちもありますが…つい頑張ってしまいます。",
            "Chinese": "其实我很懒散，只想在想做的时候才做，有时候也想在外面吃饭放松一下……但不知不觉就还是会努力去做。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:20:29",
            "content": "sorekurai,tedukuride,gannbatteirassyarunodesune.",
            "Chinese": "您连这些都亲手制作，真是很努力呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:21:14",
            "content": "kyuujitunadoha,odekadesitatokihaikagadesuka?",
            "Chinese": "节假日之类外出的时候是怎么样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:21:17",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:23:18",
            "content": "dannnasannha,fudannha,osyokujinokotonitaisite,nanikaiwaeteimasuka?",
            "Chinese": "您的丈夫平时对于吃饭这件事，有说过什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:24:14",
            "content": "わりと時間が一定で出かけるのも、アスレチックやサイクリングなどが多いので夕方には帰り、家庭で食事します。",
            "Chinese": "我们出门的时间比较固定，而且大多是去运动场玩或骑自行车之类的，所以傍晚就回家了，在家里吃饭。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:25:15",
            "content": "kyuujituha,karadawougokasite,iede osyokujinasarunodesune.",
            "Chinese": "节假日您们会活动身体，然后在家吃饭，是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:25:35",
            "content": "何も言いません。仕事自体は好きな仕事なので。",
            "Chinese": "他什么也不说。工作本身是我喜欢的工作。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:26:07",
            "content": "誰かに",
            "Chinese": "被别人……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:26:20",
            "content": "hai",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:27:00",
            "content": "何か言われるというのではなく、自分が頑張りすぎているのです。家族は好きでやっていると思っていると思います。",
            "Chinese": "并不是被谁说了什么，而是我自己努力过头了。我想家人都以为我是因为喜欢才这么做的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:27:32",
            "content": "soudesitaka.",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:28:29",
            "content": "ottosannto,gaisyokunokotonituiite,hanasitakotohaarimasuka?",
            "Chinese": "您和您先生谈过关于在外面吃饭的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:30:32",
            "content": "子どもも、夫も家庭の食事で満足しているので何も言いません。外で食べる？と聞くと、庭に椅子を持っていこうとするくらい、外食という習慣はないです。",
            "Chinese": "孩子和丈夫都对家里的饭菜很满意，所以什么也不说。如果我问他们“要不要在外面吃？”，他们就会想把椅子搬到院子里去，我们家就是这么没有在外吃饭的习惯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:31:48",
            "content": "soreha,asa,ihiru,banntohitoride,gannbatteirassyaimasune.",
            "Chinese": "这样的话，早、中、晚三餐都是您一个人在努力呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:32:22",
            "content": "dzennzujibunndeyaranakerebaikenainoha",
            "Chinese": "全都得自己来做的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:32:33",
            "content": "sinndoidesuyone",
            "Chinese": "确实很辛苦呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:33:42",
            "content": "そうですね。特別手の込んだものは作りませんが、自分でもよく作るなあと思います。",
            "Chinese": "是啊。虽然我不会做什么特别复杂的菜，但连我自己都觉得我做得真不少。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:34:44",
            "content": "家族に共感してほしいとかではなく、がんばる自分を解放したいのです。",
            "Chinese": "我并不是希望家人理解我，而是想要解放这个拼命努力的自己。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:34:52",
            "content": "syufuha,oyasumiganaidesukara,tukaretesimaukotomoarimasuyone",
            "Chinese": "家庭主妇没有休息日，所以有时会感到疲惫呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:35:34",
            "content": "疲れますね。",
            "Chinese": "确实很累啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:36:22",
            "content": "gohannwotukuritudeketeirukotoha,taihennnakotodatoomimasu",
            "Chinese": "我认为一直坚持做饭是一件非常辛苦的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:37:11",
            "content": "gokateiigaideha,otohadonnnakotodeganbatteirassyaimasuka?",
            "Chinese": "除了家庭之外，您在工作上又在努力些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:38:37",
            "content": "仕事も他の人が動こうとすると、私がやるよと言ってしまったり・・・です。",
            "Chinese": "工作上也是，当别人正要行动时，我就会说“我来做吧”……之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:39:40",
            "content": "sorehakakaekomisugirutotukaretesimaimasuyone",
            "Chinese": "把所有事情都揽在自己身上，会很累的吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:40:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:40:59",
            "content": "imamadenoohanasiwo okikisite,ohanasiwomatomesaseteitadaitemoyorosiidesyouka?",
            "Chinese": "听了您刚才说的话，我可以为您总结一下吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:41:22",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:42:09",
            "content": "anataha,gokatei,syokubadeitumogannbaranakerebaikenaitoomotteirassyaimasu",
            "Chinese": "您认为自己在家庭和职场中都必须一直努力。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:43:08",
            "content": "oosigotomosinagara,mainiti,tedukurinosyokujiwotukuttari,",
            "Chinese": "您一边工作，一边每天亲手准备饭菜，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:43:53",
            "content": "syokubademo,hokanokatanosigotowotetudattarisiteimasu",
            "Chinese": "在职场上也会帮助其他同事工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:45:05",
            "content": "soredemo,gojibunnhazuboradeari,gaisyokuwositerakusitaina,toomotteirassyaimasune.",
            "Chinese": "即使如此，您还是觉得自己很懒散，希望能通过在外吃饭来放松一下。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:46:03",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:46:28",
            "content": "sositegannbarisugirugojibunnwokaihousitaitoomottairrasyaimasu",
            "Chinese": "而且您希望能够解放这个过度努力的自己。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:47:28",
            "content": "はいでも自分に自信が持てないのでつい頑張ろうとします。",
            "Chinese": "是的，但因为对自己缺乏自信，所以总是不自觉地想要努力。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:49:01",
            "content": "gojibunnnijisinngamotenaitoomowareteirunodesune",
            "Chinese": "您觉得自己缺乏自信呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:49:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:50:12",
            "content": "imamadenoohanasiwookikisitewatasinoomottakotowootutaesitemoyososiidesyouka?",
            "Chinese": "听了您刚才的话，我可以和您说说我的想法吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/09(土) 20:50:28",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/09(土) 20:51:30",
            "content": "anataha,osigoto,gokateidetotemoyokuganbatteirassyarutoomoimasu",
            "Chinese": "我认为您在工作和家庭中都非常努力。"
        },
        {
