{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 19:52:54",
            "content": "こんばんは、よろしくお願いします。",
            "Chinese": "晚上好，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 19:53:49",
            "content": "（こんばんは。よろしくお願いいたします。）",
            "Chinese": "（晚上好。请多多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 19:55:33",
            "content": "（もし可能であれば、希死念慮の高いクライエント役をしていただけますと、助かります。もし難しければ、フリーで大丈夫です。いかがでしょうか。）",
            "Chinese": "（如果可以的话，能否请您扮演一位有较强自杀意念的来访者？这会对我有很大帮助。如果觉得有困难，自由发挥也可以。您觉得怎么样？）"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 19:56:23",
            "content": "（分かりました。出来るだけ頑張ります。）",
            "Chinese": "（明白了。我会尽力而为。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 19:56:58",
            "content": "（ありがとうございます。無理言いましてすみませんが、よろしくお願いします。）",
            "Chinese": "（谢谢您。不好意思提出这样的要求，就拜托您了。）"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 19:57:29",
            "content": "（いえいえ。よろしくお願いいたします。）",
            "Chinese": "（哪里哪里，请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:00:08",
            "content": "こんばんは、相談員です。相談に来ていただき、ありがとうございます。",
            "Chinese": "晚上好，我是咨询员。感谢您前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:00:22",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:00:46",
            "content": "まず初めに、年齢と性別を教えてもらうことはできますか。",
            "Chinese": "首先，可以请您告知一下年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:01:24",
            "content": "はい。54歳　女性です。",
            "Chinese": "好的。54岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:01:46",
            "content": "教えていただき、ありがとうございます。",
            "Chinese": "谢谢您告知。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:01:55",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:02:02",
            "content": "本日はどのようなご相談でしょうか。",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:02:48",
            "content": "仕事のことで",
            "Chinese": "是关于工作上的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:03:15",
            "content": "はい、お仕事のことですね",
            "Chinese": "嗯，是关于工作上的事，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:03:26",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:03:59",
            "content": "よければ、どのようなことがあったのか、教えてもらえますか？",
            "Chinese": "如果方便的话，能跟我说说发生了什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:05:00",
            "content": "職場のチームの人は、みんな私の悪口を言っています。",
            "Chinese": "我们团队里的人，大家都在说我的坏话。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:05:32",
            "content": "そうだったのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:06:03",
            "content": "こそこそ話をしていても私には、わかります。",
            "Chinese": "即使他们窃窃私语，我也能察觉到。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:06:30",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:06:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:07:17",
            "content": "悪口言われてると思うと、すごく悲しいですよね、、",
            "Chinese": "一想到自己被说坏话，就会感到非常难过吧……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:07:57",
            "content": "はい。悲しいです。",
            "Chinese": "是的。很难过。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:08:27",
            "content": "チームの人は、どんな感じのことを言っているのでしょうか？",
            "Chinese": "团队里的人都在说些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:09:41",
            "content": "私のミスをした事や新人の指導員をしているのですがその事についてもいろいろ言っています。",
            "Chinese": "他们会拿我犯的错，以及我作为新人指导员这件事说三道四。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:10:03",
            "content": "そうでしたか、、",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:11:28",
            "content": "色々と言われると、しんどくなりますよね",
            "Chinese": "被人说三道四的，确实会很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:12:13",
            "content": "最近は、いつも私の事を話ています。",
            "Chinese": "最近他们总是在谈论我。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:12:54",
            "content": "そうだったのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:12:54",
            "content": "何でそんなに私の事ばかり話すんだろうと思います。",
            "Chinese": "我就在想，他们为什么老是说我的事呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:13:38",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:14:03",
            "content": "いつも何か言われていると思うと、気が滅入ってしまいますよね、、",
            "Chinese": "一想到总感觉有人在说自己，心情就会很低落吧……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:14:25",
            "content": "はい。仕事に行きたくありません。",
            "Chinese": "是的。我不想去上班了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:14:41",
            "content": "そのようにも感じておられるのですね",
            "Chinese": "您已经有这样的感觉了啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:14:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:15:05",
            "content": "そう思われるのも無理ないと思います",
            "Chinese": "我觉得您会这么想也是人之常情。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:15:47",
            "content": "ちなみに、いつ頃からそのような状況なのでしょうか？",
            "Chinese": "顺便问一下，这种情况大概是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:18:19",
            "content": "去年の５月に異動があり、知らない人達では無いのですが直ぐに意地の悪い事をされました。",
            "Chinese": "去年5月我调动了岗位，虽然同事们不是不认识的人，但很快我就遭到了他们的恶意对待。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:19:03",
            "content": "そうだったのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:19:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:19:53",
            "content": "意地悪されると嫌になってしまいますよね、、",
            "Chinese": "被人恶意对待，会让人觉得很讨厌吧……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:20:18",
            "content": "本当に辛いです。",
            "Chinese": "真的很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:20:44",
            "content": "本当にそうですよね",
            "Chinese": "确实是这样呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:21:06",
            "content": "でも自分が悪い",
            "Chinese": "但是，是我不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:21:23",
            "content": "そのようにもお感じなのですね",
            "Chinese": "您是这样感觉的啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:21:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:21:47",
            "content": "どういったところで、そのように感じておられるのでしょうか？",
            "Chinese": "是什么地方让您有这种感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:23:50",
            "content": "指導の仕方が悪いのかもそれに私はミスをするとドキドキしてしまうしそしてみんなイヤな顔をして見ます。",
            "Chinese": "可能我的指导方式不好，而且我一犯错就会心慌，大家也都会露出不悦的表情看着我。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:24:17",
            "content": "私がみんな悪い",
            "Chinese": "都是我不好。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:24:35",
            "content": "全部私のせい",
            "Chinese": "全都是我的错。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:25:06",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:25:28",
            "content": "自分自身をつい責めてしまう感じなのですね、、",
            "Chinese": "感觉您会不自觉地责备自己呢……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:25:53",
            "content": "だから、みんな私の事をこそこそ話ています",
            "Chinese": "所以大家才会在背后议论我。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:26:19",
            "content": "そう思われるのですね",
            "Chinese": "您是这么认为的啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:26:40",
            "content": "実際そうです",
            "Chinese": "实际上就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:27:40",
            "content": "そう思うと、本当につらくて、どうしたらいいのか分からなくなってしまいますよね",
            "Chinese": "这么一想，真的会很痛苦，也会不知道该怎么办才好吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:28:23",
            "content": "全部　私のせいなので仕方ない",
            "Chinese": "全都是我的错，所以也没办法。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:28:56",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:29:18",
            "content": "そうなんです",
            "Chinese": "就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:30:09",
            "content": "ちなみに、指導の仕方が悪いのかもということですが、どのようなところでそうお感じになるのでしょうか？",
            "Chinese": "另外，您提到或许是指导方式不好，具体是哪些方面让您有这种感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:32:23",
            "content": "聴覚障害のある方の指導員をしていますが「そんなやり方じゃダメだよ」など怒鳴られます。その後私の事を話ています。",
            "Chinese": "我是一名听障人士的指导员，但会被人吼“那种做法不行！”之类的话。之后他们就会议论我。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:33:12",
            "content": "そのようなこともあったのですね",
            "Chinese": "还发生过这样的事啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:33:32",
            "content": "私の言い方が悪いと思っています。",
            "Chinese": "我觉得是我的表达方式不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:33:57",
            "content": "そう思われるのですね",
            "Chinese": "您是这么认为的啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:34:21",
            "content": "はい。全部わが悪いとおもいます。",
            "Chinese": "是的。我觉得全都是我的错。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:35:29",
            "content": "全部自分が悪い・・そのように思うと本当に苦しいですよね、、",
            "Chinese": "“全部都是自己的错”……这么想的话，真的很痛苦吧……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:36:09",
            "content": "苦しい",
            "Chinese": "很痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:36:45",
            "content": "時々死にたいと思います",
            "Chinese": "有时候会想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:37:11",
            "content": "そのようにもお感じなのですね",
            "Chinese": "您已经有这样的感觉了啊……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:37:56",
            "content": "ロープを買ってしまいました",
            "Chinese": "我已经买了绳子。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:38:10",
            "content": "そうだったのですね",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:39:02",
            "content": "家の部屋に家族にわからない様に隠してあります。",
            "Chinese": "我把它藏在家里了，没让家人发现。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:39:27",
            "content": "そうでしたか",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:40:08",
            "content": "もしかすると、ご自身の中で、具体的にいつ実行しようかなど、何か考えておられたりするのでしょうか？",
            "Chinese": "或许，您心里有没有想过，比如具体什么时候实施之类的计划呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:40:34",
            "content": "あまり",
            "Chinese": "不怎么……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:40:44",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:40:54",
            "content": "考えていません",
            "Chinese": "没有具体考虑过。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:41:09",
            "content": "そうでしたか",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:42:32",
            "content": "でも先日気が付いたら何故か歩いて隣の市まで行ってました",
            "Chinese": "但是前几天，等我回过神来，不知怎么已经走到了隔壁的市。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:42:56",
            "content": "そのようなこともあったのですね",
            "Chinese": "还发生过这样的事啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:43:57",
            "content": "どうやって行ったか覚えていません",
            "Chinese": "我不记得是怎么过去的了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:44:48",
            "content": "自分でも気づかないで身体が動いてしまうくらい、思い詰めておられる感じなのですね",
            "Chinese": "看来您已经忧思过度到，身体在自己都没察觉的情况下就不由自主地行动起来了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:46:15",
            "content": "無意識に動いてしまうくらい思い詰めていると、本当にくたくたに疲れ果ててしまいますよね",
            "Chinese": "思虑过度到身体会无意识地行动起来，真的会让人筋疲力尽吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:46:59",
            "content": "ちなみに、このお話はこれまで誰かにされたことはありますか？",
            "Chinese": "顺便问一下，这些话您至今为止有跟谁说过吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:48:34",
            "content": "自分では、そんなつもりはないです職場の友人に診断書で休むように勧められました。私の事を言ってると話をしてもそんな事ないというんです。みんなで言っているのに。",
            "Chinese": "我本没有那个打算。是职场的朋友建议我开诊断书休息一下。我跟她说大家都在议论我，她却说没有那种事。明明大家都在说。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:49:32",
            "content": "そのようにもお感じなのですね",
            "Chinese": "您是这么感觉的啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:50:14",
            "content": "みんなで私の事をいろいろ言ってるんです。",
            "Chinese": "大家都在说我各种各样的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:51:04",
            "content": "みんなが言っていると思うと、本当に嫌になりますよね",
