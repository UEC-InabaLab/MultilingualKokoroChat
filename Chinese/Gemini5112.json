        },
        {
            "role": "クライアント",
            "time": "2023/05/23(火) 20:51:40",
            "content": "でも自分が悪いので仕方ないです。",
            "Chinese": "但因为是我的错，所以也没办法。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/23(火) 20:51:54",
            "content": "そうなんですね",
