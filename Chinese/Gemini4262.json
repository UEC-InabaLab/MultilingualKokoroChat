        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:54:53",
            "content": "そうだったのですね・・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:55:09",
            "content": "これから、まっすぐに進路に向かっていきたい時に",
