        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:41:28",
            "content": "ご両親はどのような意見なのですか？",
            "Chinese": "您父母是什么态度呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:41:44",
            "content": "仕方ない",
            "Chinese": "觉得没办法吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:42:14",
            "content": "そうだったのですね",
            "Chinese": "明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:43:03",
            "content": "ご自身の進みたい道があって、ご両親も積極的でないにしても、容認してくださっているのですね",
