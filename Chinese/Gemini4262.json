{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 12:51:43",
            "content": "（本日相談者役をさせて頂きます。よろしくお願い致します。）",
            "Chinese": "（今天由我来扮演来访者。请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 12:52:10",
            "content": "（こんにちは。13時から始めさせていただきます。よろしくお願いいたします）",
            "Chinese": "（您好。我们将于13点开始。请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 12:52:39",
            "content": "（承知しました。ありがとうございます。）",
            "Chinese": "（明白了。谢谢您。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 12:53:01",
            "content": "（よろしくお願いいたします）",
            "Chinese": "（请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:00:03",
            "content": "こんにちは、相談員です。今日はご相談に来てくださりありがとうございます。初めに、性別・年齢を教えていただけますか？",
            "Chinese": "您好，我是咨询员。感谢您今天前来咨询。首先，可以请您告诉我性别和年龄吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:00:20",
            "content": "17歳　女性",
            "Chinese": "17岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:00:40",
            "content": "教えてくださりありがとうございます。本日はどのようなご相談でしょうか？",
            "Chinese": "感谢您的告知。今天您想咨询哪些方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:00:53",
            "content": "先が見えない",
            "Chinese": "感觉前路迷茫。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:01:15",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:01:30",
            "content": "先が見えないというのは、とても不安が大きいと思います",
            "Chinese": "感到前路迷茫，一定让您非常不安吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:02:09",
            "content": "ちなみに、校種と学年を教えてもらえますか？",
            "Chinese": "顺便问一下，可以告诉我您所在的学校类型和年级吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:02:28",
            "content": "高校3年生です",
            "Chinese": "我是高三学生。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:02:46",
            "content": "教えてくださりありがとうございます",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:03:37",
            "content": "卒業を控えていらっしゃるのですね",
            "Chinese": "您马上就要毕业了呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:04:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:04:18",
            "content": "どのようなことから、先が見えないと感じているのか、聞かせていただけますか？",
            "Chinese": "能告诉我，是什么原因让您感到前路迷茫吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:05:05",
            "content": "受験勉強していて",
            "Chinese": "正在备考。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:05:30",
            "content": "はい（聞いていますので、続けてお話しくださいね）",
            "Chinese": "嗯（我在听，请您继续说。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:06:08",
            "content": "これでいいのか分からなくなった",
            "Chinese": "不知道这样做是不是对的了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:06:17",
            "content": "そうだったのですね",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:07:05",
            "content": "勉強しているときに、迷いがでてきたのですね",
            "Chinese": "是在学习的时候，开始感到迷茫了是吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:07:19",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:07:36",
            "content": "これでいいのか、ということでしたが、",
            "Chinese": "关于您说的“这样到底好不好”，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:08:22",
            "content": "どんなことを考えるようになったのか、聞かせてもらえますか？",
            "Chinese": "能跟我说说您都开始思考哪些事情了吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:09:14",
            "content": "これからのことですね",
            "Chinese": "关于今后的事情吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:09:36",
            "content": "これからのこと・・・とても大切なことですよね",
            "Chinese": "关于今后……确实是很重要的事情呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:10:02",
            "content": "受験を前に、これでいいのかと迷われていらっしゃるということは",
            "Chinese": "在升学考试前，您会为“这样到底好不好”而迷茫，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:10:29",
            "content": "それだけ、あなたが真摯に自分の人生に向き合っていらっしゃるからこそなのではないかと感じます",
            "Chinese": "我感觉这正说明您在非常认真地面对自己的人生。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:11:26",
            "content": "うーん、そうなんですかね",
            "Chinese": "嗯……是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:11:27",
            "content": "具体的に、考えていることについて教えてもらえますか？",
            "Chinese": "能具体说说，您在思考些什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:12:01",
            "content": "工芸学科に入りたい",
            "Chinese": "想进工艺学科。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:12:09",
            "content": "大学の",
            "Chinese": "大学的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:12:20",
            "content": "そうなのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:12:50",
            "content": "自分の希望がしっかりあるのですね",
            "Chinese": "您有很明确的志向呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:13:07",
            "content": "まあ、、",
            "Chinese": "嗯，算是吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:13:18",
            "content": "どこに悩まれている感じですか？",
            "Chinese": "让您纠结的是哪些部分呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:13:36",
            "content": "これでいいのかなと",
            "Chinese": "就是不知道这样到底好不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:13:43",
            "content": "そうなのですね",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:14:37",
            "content": "工芸学科に入りたい希望はあるけれど、本当に、この進路でいいのだろうか、という迷いがあるということで、理解があっていますか？",
            "Chinese": "也就是说，虽然您希望进入工艺设计系，但又在犹豫这条路到底是不是真的好，我的理解对吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:15:09",
            "content": "それもあるし",
            "Chinese": "这也是一方面，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:15:41",
            "content": "ええ（聞いてきますので、そのままお話しくださいね）",
            "Chinese": "嗯（我在听，您就这样继续说下去就好。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:15:42",
            "content": "他の学科を受けた方がいいのか",
            "Chinese": "我在想是不是应该考别的专业。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:16:05",
            "content": "ええ（お話し続けてくださいね）",
            "Chinese": "嗯（请继续说。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:16:05",
            "content": "でも工芸学科しか考えられない",
            "Chinese": "但除了工艺学科，我无法考虑其他方向。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:17:06",
            "content": "工芸学科というご希望をしっかりお持ちだけれど",
            "Chinese": "虽然您有很明确的愿望想上工艺学科，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:17:27",
            "content": "他の学科にした方がいいのか、迷われているのですね",
            "Chinese": "但又在犹豫是不是选其他专业更好，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:17:49",
            "content": "というか",
            "Chinese": "或者说，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:18:10",
            "content": "はい（聞いていますので、お話し続けてくださいね）",
            "Chinese": "好的（我在听，您继续说。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:18:11",
            "content": "他の学科はすべり止めで、",
            "Chinese": "其他学科只是保底。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:18:39",
            "content": "はい（お話続けてくださいね）",
            "Chinese": "好的（请继续说。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:19:14",
            "content": "とにかくやる気が出ないです",
            "Chinese": "总之就是提不起干劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:19:26",
            "content": "そうだったのですね",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:20:09",
            "content": "受験を前にやる気がでないというのは、焦りもでてくるのではないかと思います",
            "Chinese": "我想，在考试前提不起干劲，也会让您感到焦虑吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:20:39",
            "content": "ちなみに、工芸学科の受験科目はどんなものなのですか？",
            "Chinese": "顺便问一下，工艺学科的考试科目有哪些呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:21:01",
            "content": "数学と英語",
            "Chinese": "数学和英语。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:21:16",
            "content": "教えてくださりありがとうございます",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:21:57",
            "content": "その2科目については、どんな感じですか？やる気がでる、でないとか？",
            "Chinese": "对这两门科目，您感觉如何？有动力还是提不起劲？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:22:07",
            "content": "まあまあ",
            "Chinese": "还行吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:22:21",
            "content": "そうだったのですね",
            "Chinese": "好的，我了解了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:23:02",
            "content": "もしよければ、どうして工芸学科を目指されているのか、聞かせてもらえますか？",
            "Chinese": "如果可以的话，能跟我说说为什么想报考工艺学科吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:23:26",
            "content": "物作りがしたくて",
            "Chinese": "因为我想动手创作。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:23:39",
            "content": "そうなのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:23:48",
            "content": "デザインとか",
            "Chinese": "比如做设计之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:24:11",
            "content": "素敵ですね",
            "Chinese": "很棒呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:24:51",
            "content": "今は空間デザインと言って、街づくりをしたいです。あと絵も学びたい。",
            "Chinese": "我现在想做的是空间设计，参与到城市规划营造中。另外也想学习绘画。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:25:06",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:25:15",
            "content": "わあ、すごく夢があるのですね",
            "Chinese": "哇，真是很有梦想呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:25:44",
            "content": "しっかりご自分のこれからやってみたいことを、考えられていて",
            "Chinese": "您对自己今后想做的事，考虑得非常清晰。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:25:53",
            "content": "はい。みんなに楽しんでもらったり、",
            "Chinese": "是的。希望能让大家乐在其中，"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:26:10",
            "content": "くつろげる場所づくりをしたい",
            "Chinese": "也想打造一个可以让人放松身心的场所。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:26:22",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:27:02",
            "content": "しっかりとした、自分のビジョンというか、目標であったり夢をお持ちなんですね。",
            "Chinese": "您有自己很明确的愿景，或者说是目标和梦想呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:27:19",
            "content": "そんなでもないですけど",
            "Chinese": "也没有那么夸张啦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:28:06",
            "content": "とても楽しそうだし、ワクワクするな、と感じました",
            "Chinese": "我感到那听起来很有趣、也让人很期待。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:28:14",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:29:16",
            "content": "でも",
            "Chinese": "不过……"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:29:26",
            "content": "親がうるさくて",
            "Chinese": "父母很唠叨。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:29:50",
            "content": "そうなのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:30:12",
            "content": "親御さんは、どんなことを言ってくる感じなのでしょうか？",
            "Chinese": "父母大致会说些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:30:33",
            "content": "最初工芸学科に入りたいと話したら",
            "Chinese": "一开始我说想上工艺学科，"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:30:38",
            "content": "反対されて",
            "Chinese": "他们反对了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:31:03",
            "content": "そうだったのですね・・・（聞いていますので、続けてくださいね）",
            "Chinese": "原来如此……（我在听，请您继续说。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:31:43",
            "content": "今は大丈夫だけど、いろいろ決めつけてくるから話したくない",
            "Chinese": "现在倒还好，但他们总爱先入为主地下结论，所以我不想跟他们谈。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:31:59",
            "content": "決めつけを・・・",
            "Chinese": "擅自下定论……"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:32:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:32:51",
            "content": "信頼してくれていないと感じていれば、話したくないお気持ちになるのも、自然なことだと思います",
            "Chinese": "如果感觉不被信任，不想和他们交流也是很自然的心情。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:33:17",
            "content": "今は、大丈夫なのですね",
            "Chinese": "现在情况还算可以，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:33:28",
            "content": "あの人たち",
            "Chinese": "那两个人……"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:33:47",
            "content": "あ、あの人たちっていうのは両親です",
            "Chinese": "啊，“那两个人”就是我父母。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:33:53",
            "content": "今は、まあまあ",
            "Chinese": "现在，还好吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:34:00",
            "content": "はい（お聞きしていますので、続けてくださいね）",
            "Chinese": "好的（我在听，您继续说。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:34:20",
            "content": "両親、本当にイヤ",
            "Chinese": "我真的很讨厌我父母。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:34:30",
            "content": "そうだったのですね",
            "Chinese": "我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:34:50",
            "content": "父は公務員をしていて、本当につまらない人間だし",
            "Chinese": "我爸是公务员，真的是个很无趣的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:35:07",
            "content": "ええ（お話続けてくださいね）",
            "Chinese": "嗯（请继续说。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:35:11",
            "content": "母は世間知らずだし",
            "Chinese": "我妈又不懂世事，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:35:23",
            "content": "そうなのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:35:32",
            "content": "あんな人になりたくない",
            "Chinese": "我不想成为他们那样的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:35:43",
            "content": "そうだったのですね・・・",
            "Chinese": "原来是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:37:00",
            "content": "価値観が古すぎる",
            "Chinese": "他们的价值观太老旧了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:37:19",
            "content": "そうなのですね",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:37:59",
            "content": "あなたとは、価値観や考えなどいろいろ合わないところがあるのですね",
            "Chinese": "您和他们在价值观和想法上有很多合不来的地方呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:38:15",
            "content": "合わないことしかない",
            "Chinese": "完全合不来。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:38:27",
            "content": "そうだったのですね・・・分かり合えないというのは、悔しいし悲しいですよね",
            "Chinese": "是这样啊……无法互相理解，会让人觉得既不甘心又难过吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:39:07",
            "content": "母からはお父さんみたいに安定した公務員がいいわよ、と言われて、",
            "Chinese": "我妈对我说，“像你爸一样当个稳定的公务员多好啊”，"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:39:26",
            "content": "押し付けられそうになったから",
            "Chinese": "感觉她想把这种想法强加给我，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:39:31",
            "content": "ええ（お聞きしていますので、続けてくださいね）",
            "Chinese": "嗯（我在听，请您继续。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:39:37",
            "content": "なるべく話したくない",
            "Chinese": "所以我尽量不想跟他们谈。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:39:47",
            "content": "そうだったのですね",
            "Chinese": "我理解了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:40:13",
            "content": "自分の人生を、親であっても、人から押し付けられたくないですよね",
            "Chinese": "不想自己的人生被别人强加安排，即使是父母也不行，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/23(水) 13:40:30",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:40:51",
            "content": "話したくないと思われるも、無理もないと思います",
            "Chinese": "我觉得您不想和他们说话也是情有可原的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/23(水) 13:41:17",
            "content": "今は、工芸学科に進学したいことについては、",
