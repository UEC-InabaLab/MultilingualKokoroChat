{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:49:25",
            "content": "（カウンセラーです）こんにちは、カウンセラーです。よろしくお願いいたします。今日はどのようなご相談でしょうか？",
            "Chinese": "（我是咨询师）您好，我是咨询师。请多关照。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:49:34",
            "content": "死にたいです",
            "Chinese": "我想死。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:49:45",
            "content": "辛いです",
            "Chinese": "很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:49:56",
            "content": "そう思っているんですね。おつらいですね",
            "Chinese": "您是这么想的啊。一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:50:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:50:31",
            "content": "話せる範囲でいいので、私で良ければ事情を聞かせていただけますか？",
            "Chinese": "如果您不介意的话，可以在您方便说的范围内，和我说说具体情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:50:39",
            "content": "生きている意味がわかりません",
            "Chinese": "我不明白活着的意义。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:50:51",
            "content": "誰も信じられません",
            "Chinese": "我谁也无法相信。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:51:09",
            "content": "そうなんですね。そう思っていらっしゃるんですね。切ないですね。",
            "Chinese": "原来如此，您一直是这么感受的啊，确实很心酸呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:51:43",
            "content": "切ないというか・・・ただただつらいです",
            "Chinese": "与其说是心酸……不如说就是无比痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:52:03",
            "content": "そうなんですね。よろしければ、年代と性別を教えていただけますか？",
            "Chinese": "我明白了。如果方便的话，能告诉我您的年龄段和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:52:33",
            "content": "言わなきゃだめですか？どうせ死ぬのに・・・",
            "Chinese": "一定要说吗？反正我都要死了……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:53:17",
            "content": "言いたくないと思っていらっしゃるんですね。それほどつらい思いをされているんですね。",
            "Chinese": "您是不想说吧。您正承受着如此痛苦的煎熬啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:53:17",
            "content": "今日で終わりにしたいと思います",
            "Chinese": "我想今天就结束一切。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:53:37",
            "content": "年末年始で誰もいないし",
            "Chinese": "年末年初也没人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:53:49",
            "content": "今はどちらからご相談に入られていますか？",
            "Chinese": "您现在是在哪里和我联系的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:54:00",
            "content": "私ひとりいなくなっても誰も悲しまないし",
            "Chinese": "就算我一个人消失了，也不会有任何人伤心。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:54:06",
            "content": "自宅です",
            "Chinese": "我在家里。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:54:18",
            "content": "ひとりでいます",
            "Chinese": "我一个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:54:20",
            "content": "暖かくされていますか？",
            "Chinese": "您那边有注意保暖吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:54:27",
            "content": "誰も助けてくれません",
            "Chinese": "没有人愿意帮助我。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:54:50",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:55:08",
            "content": "今年一年しんどすぎました",
            "Chinese": "这一整年太难熬了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:55:14",
            "content": "どうにもなりません",
            "Chinese": "已经无能为力了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:55:24",
            "content": "そう思われているのはとてもおつらいと思います。でも、今日ここに来てくださったんですね。",
            "Chinese": "您这样想一定非常痛苦。但是，您今天还是来到了这里，不是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:55:53",
            "content": "はい、誰かと話したいと思って",
            "Chinese": "是的，我想找个人说说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:56:21",
            "content": "きてくださってありがとうございます。どんなことがあったんでしょうか？",
            "Chinese": "感谢您能来。是发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:56:23",
            "content": "でも困りますよね",
            "Chinese": "但是这会让您为难吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:56:30",
            "content": "こんな話。",
            "Chinese": "这种话题。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:56:39",
            "content": "迷惑かけてすみません",
            "Chinese": "给您添麻烦了，对不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:56:41",
            "content": "いいえ、困りませんよ",
            "Chinese": "不，不会为难的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:56:47",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:56:51",
            "content": "迷惑ではありません",
            "Chinese": "一点也不麻烦。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:57:01",
            "content": "これで終わりでいいです",
            "Chinese": "就到此为止吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:57:07",
            "content": "さようなら",
            "Chinese": "再见。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:57:35",
            "content": "おつらいお話をするのはしんどいと思います。でも、少しでもお力になりたいので、もう少しお話し続けてみませんか？",
            "Chinese": "我知道诉说这些痛苦的经历很辛苦。但是，我希望能尽力帮助您，可以再多聊一会儿吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:58:23",
            "content": "めいわくでないのですか？今まで誰も話を聞いてくれません。あなたもきっと同じではないですか？",
            "Chinese": "真的不麻烦吗？至今为止，从没有人愿意听我说话。您肯定也和他们一样吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:59:10",
            "content": "今まで、おつらい思いをされてきたと思いますが、私はお話しして欲しいです。",
            "Chinese": "我想您至今为止一定经历了很多痛苦，但我真心希望您能和我说一说。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:59:46",
            "content": "なにを話せばいいのでしょう？話してもなにもかわりませんでした",
            "Chinese": "我该说什么好呢？就算说了也什么都改变不了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:00:19",
            "content": "家族も職場も全部だめです",
            "Chinese": "家庭、工作，全都一团糟。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:00:47",
            "content": "そうだったんですね。苦しかったですね。どんなことがあったんでしょうか？",
            "Chinese": "是这样啊，真的很煎熬。都发生了些什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:01:05",
            "content": "コロナで仕事がなくなりました。",
            "Chinese": "因为新冠疫情，我失业了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:01:11",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:01:36",
            "content": "持病も悪化しました",
            "Chinese": "慢性病也加重了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:01:54",
            "content": "私ががんばらないといけないのに",
            "Chinese": "明明应该由我来撑着。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:02:00",
            "content": "もう無理なんです",
            "Chinese": "但我已经撑不下去了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:02:21",
            "content": "頑張れません",
            "Chinese": "我撑不住了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:02:32",
            "content": "身体も心もつらいです",
            "Chinese": "身心俱疲。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:03:01",
            "content": "いろいろなことがあって、本当におつらいと思います。",
            "Chinese": "发生了这么多事，想必您真的非常痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:03:07",
            "content": "将来がみえません",
            "Chinese": "我看不到未来。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:03:19",
            "content": "もう楽になりたいです",
            "Chinese": "我想解脱了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:03:34",
            "content": "死んでもいいですよね？",
            "Chinese": "我可以去死，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:04:09",
            "content": "しにかたを教えてください",
            "Chinese": "请告诉我怎么死。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:04:40",
            "content": "もう楽になりたいです",
            "Chinese": "我想解脱了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:05:17",
            "content": "だんだん眠くなってきました",
            "Chinese": "我渐渐有些困了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:05:26",
            "content": "さようなら",
            "Chinese": "再见。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:08:50",
            "content": "ありがとうございました・・・",
            "Chinese": "谢谢您……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:48:41",
            "content": "（システムエラーが続いていました。）今、どういう状況でしょうか？",
            "Chinese": "（刚才一直出现系统-错误。）您现在的情况怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:50:36",
            "content": "お返事ありがとうございます。迷惑で返信に困っているのかなと思いました",
            "Chinese": "谢谢您的回复。我以为您是觉得我麻烦，不知道该怎么回。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:50:54",
            "content": "ご心配おかけしてすみませんでした。",
            "Chinese": "让您担心了，十分抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:51:22",
            "content": "いえ、心配はしていません",
            "Chinese": "不，我并不担心。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:51:39",
            "content": "ただ困らせたな、と思って",
            "Chinese": "只是觉得又让您为难了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:51:48",
            "content": "いつもみんなを困らせているので",
            "Chinese": "因为我总是让大家为难。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:52:02",
            "content": "今回もそうかなと思ってました",
            "Chinese": "这次大概也一样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:52:28",
            "content": "そう思われているんですね。そう思うのはなぜなんでしょうか？",
            "Chinese": "您是这么觉得的啊。能说说为什么会这样想吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:53:02",
            "content": "私が相談するとみんなそういう反応をするからです",
            "Chinese": "因为我找别人商量的时候，大家都是那种反应。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:53:31",
            "content": "結局は自分で決めるしかないでしょ、って",
            "Chinese": "说“到头来还不是只能靠自己决定”。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:53:49",
            "content": "だから死ぬのを決めたほうが楽かもと思いました",
            "Chinese": "所以我想，也许决定去死会更轻松一点。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:54:08",
            "content": "そうなんですね。相談するのも嫌になってしまいますよね。",
            "Chinese": "是这样啊。那您肯定会变得不想再找人商量了吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:54:44",
            "content": "嫌になる、というか、結局私の気持ちはわかってもらえないのかな、って思います。",
            "Chinese": "与其说是不想，不如说是觉得，反正到最后我的心情也没人能理解吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:54:59",
            "content": "もう頑張れません",
            "Chinese": "我已经撑不下去了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:55:15",
            "content": "病気も悪化しているし",
            "Chinese": "病情也在恶化。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:55:18",
            "content": "今まで、がんばってこられたのですね。",
            "Chinese": "您一直以来，都很努力了呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:55:37",
            "content": "死にものぐるいでした",
            "Chinese": "是拼了命。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:55:43",
            "content": "もう無理です",
            "Chinese": "我撑不住了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:55:56",
            "content": "身体も心も",
            "Chinese": "无论是身体还是心。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:56:09",
            "content": "そうでしたか。そんなにがんばってこられたんですね。",
            "Chinese": "原来如此，您一直都那么努力。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:56:34",
            "content": "仕事もなくなったいまどうやって生きていったらいいのでしょうか？",
            "Chinese": "现在连工作都没了，我该怎么活下去呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:56:56",
            "content": "生活費はどうされていますか？",
            "Chinese": "您的生活费是怎么解决的？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:57:18",
            "content": "障害年金をもらっています",
            "Chinese": "我领取残疾津贴。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:57:39",
            "content": "でもそれだけでは暮らせません",
            "Chinese": "但是光靠那个活不下去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:57:45",
            "content": "そうなんですね。ご病気もあるし、本当にしんどいと思います。",
            "Chinese": "是这样啊。您还生着病，想必真的非常辛苦。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:57:52",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:58:16",
            "content": "もう無理しないほうがいいのかもしれませんね",
            "Chinese": "也许我真的不该再硬撑下去了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:58:23",
            "content": "経済的な面では、どなたかにご相談されたことはありますか？",
            "Chinese": "在经济方面，您有向其他人寻求过帮助吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:58:37",
            "content": "もちろんあります",
            "Chinese": "当然有。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:58:43",
            "content": "でもダメでした",
            "Chinese": "但是没用。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:58:57",
            "content": "コロナで思うようにいきません",
            "Chinese": "因为疫情，很多事都不顺利。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:59:13",
            "content": "具体的にはどちらにご相談にいかれたんでしょうか？",
            "Chinese": "具体来说，您都去哪些机构咨询过了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:59:53",
            "content": "役所、ケーズワーカー、生活困窮者支援などです",
            "Chinese": "政府机关、社工、生活困难者支援机构等等。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:00:01",
            "content": "でもダメでした",
            "Chinese": "但是都没用。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:00:28",
            "content": "お金のことはたくさん相談しましま",
            "Chinese": "关于钱的事情我咨询了很多次。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:00:41",
            "content": "しました、です",
            "Chinese": "是“咨询过”的意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:00:48",
            "content": "そうなんですね。コロナの影響で本当に苦しい思いをされているんですね。",
            "Chinese": "是这样啊，疫情的影响确实让您非常难熬。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:01:21",
            "content": "コロナだけではありませんコロナの前から厳しかったのは事実です",
            "Chinese": "不仅仅是疫情，事实上在疫情之前就已经很艰难了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:01:38",
            "content": "誰も助けてくれません",
            "Chinese": "没有人愿意帮助我。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:01:50",
            "content": "昔からずっとそうでした",
            "Chinese": "从很久以前一直都是这样。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:02:09",
            "content": "若い頃はまだ頑張れましたが",
            "Chinese": "年轻的时候还能咬牙撑着。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:02:24",
            "content": "ええ、、",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:02:28",
            "content": "自殺未遂も何度かしました",
            "Chinese": "我也自杀未遂过好几次。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:02:48",
            "content": "なのて、死ぬことは怖くないです",
            "Chinese": "所以，我不怕死。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:03:02",
            "content": "つらかったですね・・・",
            "Chinese": "您一定很痛苦吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:03:05",
            "content": "子どもがひとりいるので",
            "Chinese": "因为我有一个孩子。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:03:13",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:03:24",
            "content": "そこが気がかりですが",
            "Chinese": "这点让我有些放心不下。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:03:32",
            "content": "ええ、、",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:03:39",
            "content": "こともは私のことが嫌いだと思います",
            "Chinese": "我觉得孩子讨厌我。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:03:49",
            "content": "話すらしてくれません",
            "Chinese": "连话都不愿和我说。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:04:12",
            "content": "誰も私の話を聞いてくれません",
            "Chinese": "没有人愿意听我说话。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:04:28",
            "content": "死ぬしかないです。楽になりたいです",
            "Chinese": "我只有死路一条了。我想解脱。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:05:11",
            "content": "乗員でもらった薬をたくさんのむのもいいかとおもいはじめました",
            "Chinese": "我开始觉得，把从医院拿来的药大把大把地吃下去也不错。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:05:21",
            "content": "病院、です",
            "Chinese": "是医院。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:05:58",
            "content": "そうなんですね。おつらいお気持ちが伝わってきます。私は今日あなたがここにきてくださって、お話をしてくれたことで、あなたに生きていて欲しいと思っています",
            "Chinese": "是这样啊。我能感受到您痛苦的心情。今天您能来到这里，和我说了这么多，这让我希望您能活下去。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:06:06",
            "content": "のんでいいですか？",
            "Chinese": "我可以吃药吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:06:26",
            "content": "今のみました",
            "Chinese": "我刚刚已经吃了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:06:51",
            "content": "私のことなにもわからないのになぜそんなこというのですか？",
            "Chinese": "你明明什么都不了解我，为什么要说那种话？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:07:32",
            "content": "あなたになにができるのですか？",
            "Chinese": "你又能做什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:07:44",
            "content": "いいえ、飲んではいけません。今まで頑張って生きてこられた大切な命です。もっとあなたのお話を聞いて、お力になりたいと思っています御自宅の住所を教えていただけますか？",
            "Chinese": "不，不可以吃。这是您努力活到现在的宝贵生命。我想更多地听您倾诉，希望能帮到您。可以告诉我您家的地址吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:07:56",
            "content": "のみました。",
            "Chinese": "我已经吃了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:08:28",
            "content": "お家はどこですか？",
            "Chinese": "您家在哪里？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:08:39",
            "content": "追加でのみますね。",
            "Chinese": "我再多吃点。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:08:44",
            "content": "いいたくありません",
            "Chinese": "我不想说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:08:46",
            "content": "何を飲みましたか？",
            "Chinese": "您服用了什么药？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:09:14",
            "content": "どのくらい飲みましたか？",
            "Chinese": "大概服用了多少？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:09:18",
            "content": "睡眠導入ざいです",
            "Chinese": "是安眠药。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:09:51",
            "content": "朝から1時間おきに5じょうずつです",
            "Chinese": "从早上开始，每隔一小时吃5片。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:10:04",
            "content": "あと精神安定剤ものみました",
            "Chinese": "另外也吃了镇静剂。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:10:10",
            "content": "玄関の鍵を開けられますか？",
            "Chinese": "您能把大门的锁打开吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:10:29",
            "content": "無理ですね",
            "Chinese": "不行了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:10:36",
            "content": "ヘッドに寝てます",
            "Chinese": "我正躺在床上。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:10:49",
            "content": "このまま楽になれると思うと嬉しいです",
            "Chinese": "想到能就这样解脱，我就很开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:11:02",
            "content": "電話番号を教えていただけますか？",
            "Chinese": "可以告诉我您的电话号码吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:11:10",
            "content": "最後に話を聞いてくれてありがとうございました",
            "Chinese": "谢谢您最后愿意听我说。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:11:20",
            "content": "さようなら",
            "Chinese": "再见了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:11:49",
            "content": "お子さんに未練はないんでしょうか？",
            "Chinese": "对孩子就真的没有留恋吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:13:35",
            "content": "まだ、聞かれていますか？",
            "Chinese": "还在吗？还能听到吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:14:33",
            "content": "こどもは私のことが嫌いだと思うので、いなくなったほうがよろこぶとおもいます",
            "Chinese": "我觉得孩子讨厌我，所以要是我不在了，他反而会更高兴吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:14:50",
            "content": "保険金がはいったほうが",
            "Chinese": "要是能拿到保险金，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:15:06",
            "content": "今より幸せかと",
            "Chinese": "应该会比现在幸福。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:15:09",
            "content": "お子さんと最後に会ったのはいつですか？",
            "Chinese": "您和孩子最后一次见面是什么时候？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:15:18",
            "content": "昨日です",
            "Chinese": "昨天。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:15:35",
            "content": "昨日はどんな会話をしたんですか？",
            "Chinese": "昨天你们聊了些什么？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:15:38",
            "content": "話もしてくれません",
            "Chinese": "他连话都不愿和我说。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:15:49",
            "content": "だから未練はありません",
            "Chinese": "所以我没有留恋。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:15:57",
            "content": "他にご家族は？",
            "Chinese": "您还有其他家人吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:16:01",
            "content": "もう十分にやりました",
            "Chinese": "我已经尽力了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:16:05",
            "content": "さようなら",
            "Chinese": "再见了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:17:25",
            "content": "子どもとふたりくらしです",
            "Chinese": "我和孩子两个人生活。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:17:32",
            "content": "私はあなたに生きてほしいです。今飲んだ薬を吐き出してください。もっとおはなしをさせてください",
            "Chinese": "我希望您能活下去。请把刚吃的药吐出来。请让我再和您多聊一会儿。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:17:36",
            "content": "子どもにのこせるのはこれくらいです",
            "Chinese": "能留给孩子的也就只有这些了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:18:01",
            "content": "はきだすくらいなら最初からのんでません",
            "Chinese": "要是会吐出来，我一开始就不会吃了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:18:25",
            "content": "たった一人のお子さんが、あなたを失って、かなしまないはずはありません",
            "Chinese": "您唯一的孩子，在失去您之后，不可能不伤心的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:18:27",
            "content": "迷惑かけてすみませんでした",
            "Chinese": "给您添麻烦了，非常抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:18:40",
            "content": "もう終わりでいいてす",
            "Chinese": "就这样结束吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:18:47",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:18:56",
            "content": "最後に話せてよかったです",
            "Chinese": "能在最后跟您说说话，真是太好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:19:06",
            "content": "お子さんに連絡はつきますか？",
            "Chinese": "能联系上您的孩子吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:20:25",
            "content": "（ありがとうございました）",
