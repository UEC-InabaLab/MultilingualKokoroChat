{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 09:51:24",
            "content": "ゴーヤンさん、こんにちは。本日はよろしくお願いします。",
            "Chinese": "戈扬，您好。今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:03:43",
            "content": "ごめんなさい、遅くなりました！",
            "Chinese": "不好意思，来晚了！"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:03:49",
            "content": "よろしくお願い致します！",
            "Chinese": "还请多多关照！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:04:19",
            "content": "はい。ではこれから始めさせていただきます。",
            "Chinese": "好的。那么我们现在就开始。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:04:27",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:04:58",
            "content": "こんにちは。ご相談ありがとうございます。始めに性別と年齢を教えてください",
            "Chinese": "您好。感谢您的咨询。首先请告诉我您的性别和年龄。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:05:55",
            "content": "23歳女です",
            "Chinese": "23岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:06:19",
            "content": "ありがとうございます。本日はどのようなご相談ですか？",
            "Chinese": "谢谢您。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:07:02",
            "content": "もう生きてなくてもいいかなぁって",
            "Chinese": "我在想，或许不活着也可以了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:08:07",
            "content": "ええ・・もう少し詳しくお話ししていただけますか",
            "Chinese": "嗯...您能再详细说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:08:55",
            "content": "私はいつも選ばれないんです",
            "Chinese": "我总是那个不被选中的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:09:26",
            "content": "そうでしたか。選ばれないとは？",
            "Chinese": "原来如此。您说的“不被选择”，具体是指什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:10:15",
            "content": "友達といても",
            "Chinese": "和朋友在一起时..."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:10:23",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:10:28",
            "content": "私はいつも仲間外れで",
            "Chinese": "我总是被排挤在外。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:10:44",
            "content": "ええ。それは、辛いですね",
            "Chinese": "嗯。那一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:11:00",
            "content": "もう存在してる価値がないかと",
            "Chinese": "我觉得自己已经没有存在的价值了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:11:37",
            "content": "そう思われるんですね。",
            "Chinese": "您是这样想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:11:56",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:12:21",
            "content": "他には、どういう時にそう思われるのですか",
            "Chinese": "除此之外，您在什么情况下也会这么想呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:12:28",
            "content": "うーん",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:12:39",
            "content": "家にいる時とか",
            "Chinese": "比如在家里的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:13:28",
            "content": "家でもそう感じるのですね。もう少し具体的にお話ししてもらってもいいですか",
            "Chinese": "在家里也会有这样的感觉啊。可以再具体说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:13:45",
            "content": "お母さんもお父さんも家にいないし",
            "Chinese": "妈妈和爸爸都不在家，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:13:54",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:13:55",
            "content": "帰ってきてもご飯食べるだけで",
            "Chinese": "就算回来了也只是吃个饭而已，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:14:03",
            "content": "私の話なんて全く聞いてくれないし",
            "Chinese": "完全不会听我说话，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:14:11",
            "content": "なんか生きている意味あるのかなぁって",
            "Chinese": "就会想，我活着还有什么意义呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:14:27",
            "content": "話を聞いてもらえないのは、寂しいですね",
            "Chinese": "得不到倾听，确实会很寂寞呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:15:03",
            "content": "ご家族は３人なのですか？",
            "Chinese": "您的家庭是三口人吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:15:16",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:15:56",
            "content": "今は学生さんですか？",
            "Chinese": "您现在是学生吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:16:15",
            "content": "いえ",
            "Chinese": "不是。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:16:32",
            "content": "お勤めされてるのでしょうか",
            "Chinese": "您是在工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:16:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:16:44",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:17:53",
            "content": "最初に話してくれた選ばれないについて、もう少し詳しく教えてもらってもいいですか？",
            "Chinese": "关于您一开始提到的“不被选择”，您能再详细说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:18:11",
            "content": "何をいえばいいですか？",
            "Chinese": "我该说些什么好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:18:56",
            "content": "どういう時にどういう様子なのか知りたいと・・",
            "Chinese": "我想了解一下是在什么样的情况下、具体是怎样的情形……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:19:40",
            "content": "友達といてもいつも仲間外れなんです",
            "Chinese": "和朋友在一起的时候，我总是被排挤。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:20:10",
            "content": "はい。そうでしたか・・・それは寂しいですね",
            "Chinese": "嗯。是这样啊……那一定很寂寞吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:20:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:21:24",
            "content": "仲間はずれというのは、例えばどういう状況か、教えていただいてもいいですか",
            "Chinese": "您能举例说明一下被排挤的具体情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:21:38",
            "content": "3人でいても",
            "Chinese": "即使是三个人在一起..."
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:21:44",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:21:49",
            "content": "だいたい私じゃない人の話になって",
            "Chinese": "话题大多都会围绕着不是我的那个人展开，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:21:57",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:22:06",
            "content": "ご飯とかも",
            "Chinese": "吃饭的时候也是，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:22:13",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:22:26",
            "content": "結局私じゃない人の意見になって",
            "Chinese": "最后也都是听另一个人的意见，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:22:42",
            "content": "選ばれた事がないんです",
            "Chinese": "从来没有被选中过。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:23:10",
            "content": "教えてくれて、ありがとうございます",
            "Chinese": "谢谢您愿意告诉我这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:24:13",
            "content": "いつも選ばれないというのは悲しいですね",
            "Chinese": "总是不被选择，这确实很令人难过。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:24:21",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:25:22",
            "content": "ところで、あなたのお名前はなんとお呼びしたら良いですか？",
            "Chinese": "对了，我该如何称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:25:53",
            "content": "くーです",
            "Chinese": "叫我小空吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:26:27",
            "content": "ありがとうございます。",
            "Chinese": "好的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:29:01",
            "content": "くーさん、これからどうなったらいいとお考えですか",
            "Chinese": "小空，您希望未来能变成什么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:29:17",
            "content": "死にたいです",
            "Chinese": "我想死。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:29:31",
            "content": "もう生きてる価値はあんまりないかなぁって思いました",
            "Chinese": "我觉得活着已经没什么价值了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:29:51",
            "content": "死にたいと思うほど・・・なのですね。",
            "Chinese": "已经到了让您想要去死……的程度了啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:29:57",
            "content": "いつも選ばれないので",
            "Chinese": "因为总是不被选择。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:31:00",
            "content": "すごく辛いんですね。",
            "Chinese": "那一定非常痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:31:38",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:31:45",
            "content": "でも、くーさんがこれまで生きてこられたのは、どんな思いがあったのですか",
            "Chinese": "但是，支撑小空您活到现在的，是怎样的想法呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:31:57",
            "content": "うーん",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:32:15",
            "content": "わかりません…",
            "Chinese": "我不太清楚……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:32:17",
            "content": "なんとなく",
            "Chinese": "就是一种说不清的感觉，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:32:20",
            "content": "生きてたって",
            "Chinese": "就这么活下来了，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:32:24",
            "content": "感じですかね",
            "Chinese": "大概是这种感觉吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:33:09",
            "content": "はい・・・気持ちを聞かせてくれてありがとう",
            "Chinese": "好的……谢谢您愿意分享您的感受。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:35:14",
            "content": "ここまでの話をまとめさせていただいていいですか？",
            "Chinese": "我可以总结一下我们到目前为止的谈话内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:36:27",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:37:17",
            "content": "くーさんは、友達からいつも選ばれないし、家にいても話を聞いてもらえないし、もう生きてなくてもいいかなと思っておられる",
            "Chinese": "小空您的情况是，您总是感觉不被朋友选择，在家里也没人听您说话，所以觉得或许不活着也可以了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:41:03",
            "content": "違っていたら教えてください",
            "Chinese": "如果有什么不对的地方，请您指正。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:41:08",
            "content": "あってます",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:41:28",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:42:19",
            "content": "一人で抱えないで、今日、ここに相談してくれてありがとうございます",
            "Chinese": "谢谢您没有一个人扛着，今天能来这里和我谈。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:43:33",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:44:30",
            "content": "くーさんが孤独を感じながらも、今日まで生きてこられたのは、どんな思いがあったのか教えてください",
            "Chinese": "即便感到孤独，小空您依然活到了今天。可以和我说说，是怎样的想法支撑着您吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:45:01",
            "content": "なんとなくって",
            "Chinese": "就是“说不清”的感觉，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:45:07",
            "content": "先程伝えました…",
            "Chinese": "我刚才说过了……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:45:14",
            "content": "ごめんなさい、生きてきた意味",
            "Chinese": "对不起，活到现在的意义，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:45:16",
            "content": "分からなくて",
            "Chinese": "我不明白，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:45:29",
            "content": "なんで生きてきたんだろう？",
            "Chinese": "我到底为什么要活着呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:45:35",
            "content": "やっぱり死んだ方がいいですかね？",
            "Chinese": "是不是果然还是死了比较好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:45:45",
            "content": "はい、何度も聞いてごめんなさい",
            "Chinese": "好的，很抱歉反复问您同一个问题。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:46:15",
            "content": "いえ",
            "Chinese": "没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:46:16",
            "content": "私は生きていてほしいです",
            "Chinese": "我希望您能活下去。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:46:47",
            "content": "なぜですか？",
            "Chinese": "为什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:47:39",
            "content": "今、２３歳。これからまだまだ人生、新しい未来があると思うんですけど・・・",
            "Chinese": "您现在才23岁。我觉得您的人生还有很长的路要走，还有崭新的未来……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:48:04",
            "content": "そうですか",
            "Chinese": "是吗。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:48:24",
            "content": "ええ、私はそう思います",
            "Chinese": "是的，我是这么认为的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 10:50:12",
            "content": "くーさん、未来がこうなったらいいな〜というイメージは？",
            "Chinese": "小空，您对未来有没有“要是能变成这样就好了”之类的想象呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:50:29",
            "content": "あまりないです",
            "Chinese": "不怎么有。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 10:50:45",
