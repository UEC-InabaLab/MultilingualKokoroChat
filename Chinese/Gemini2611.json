{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:25:02",
            "content": "こんにちは。本日はどうぞよろしくお願いします。",
            "Chinese": "您好。今天请多多指教。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:25:45",
            "content": "よろしくお願いします。",
            "Chinese": "请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:26:06",
            "content": "お時間になりましたら始めさせていただきますね。",
            "Chinese": "时间到了，我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:26:16",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:30:13",
            "content": "こんにちは。相談員です。最初に年齢と性別を教えてください。",
            "Chinese": "您好，我是咨询员。首先请告诉我您的年龄和性别。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:30:31",
            "content": "22歳　男性です",
            "Chinese": "22岁，男性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:31:00",
            "content": "ありがとうございます。本日はどのようなお悩みですか？",
            "Chinese": "谢谢您。今天您有什么烦恼呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:31:10",
            "content": "最近無気力なんです",
            "Chinese": "最近提不起劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:31:33",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:31:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:32:08",
            "content": "それはお困りですね。",
            "Chinese": "那一定很困扰吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:32:23",
            "content": "お話を少し詳しくお話を聞かせてください",
            "Chinese": "可以请您再详细地和我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:33:00",
            "content": "楽しいことがないんです。",
            "Chinese": "感觉没什么开心的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:33:21",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:33:36",
            "content": "相談者さんは今学生ですか？",
            "Chinese": "您现在是学生吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:34:10",
            "content": "フリーターです",
            "Chinese": "我是自由职业者。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:34:48",
            "content": "はい。ではアルバイトなどをされているのでしょうか？",
            "Chinese": "好的。那您是在做兼职之类的工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:34:59",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:35:42",
            "content": "アルバイト以外の時間はどの様にお過ごしですか？",
            "Chinese": "兼职以外的时间您是怎么度过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:36:48",
            "content": "YouTubeをみたり、ゴロゴロしています。",
            "Chinese": "看看YouTube，或者无所事事地待着。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:37:22",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:37:45",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:39:34",
            "content": "お友達とあったりされますか？",
            "Chinese": "您会和朋友见面吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:39:47",
            "content": "全く会わないです",
            "Chinese": "完全不见面。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:41:12",
            "content": "そうなんですね。それは憂うつになりますね",
            "Chinese": "是这样啊。那会让人感到很郁闷呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:41:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:43:00",
            "content": "今はどの様な事を考えると憂鬱に感じますか？",
            "Chinese": "现在想到什么样的事情会感到郁闷呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:44:13",
            "content": "やりたいことや、欲しいものなどが何もなくてそれでよけいに悲しくなったりしますね",
            "Chinese": "没有什么想做的事，也没有想要的东西，这让我更加难过。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:45:05",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:45:38",
            "content": "先ほどお友達と全く会っていないと言われていましたが、",
            "Chinese": "您刚才说完全不和朋友见面，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:46:08",
            "content": "何か理由がありますか？",
            "Chinese": "是有什么原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:47:07",
            "content": "普通に友達が少ないのと、近くに仲のいい人がいないとかです",
            "Chinese": "就是朋友本来就少，而且附近也没有关系好的朋友之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:49:06",
            "content": "ええ、ええ。友達と会わない事に関してはどの様にお感じになっていますか？",
            "Chinese": "嗯，嗯。对于不和朋友见面这件事，您有什么感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:49:52",
            "content": "さみしいです",
            "Chinese": "很寂寞。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:50:59",
            "content": "そうお感じなのですね。それは辛いですね",
            "Chinese": "您是这么感觉的啊。那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:51:16",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:52:35",
            "content": "では、今までのご相談をまとめてみてもいいですか？",
            "Chinese": "那么，我可以总结一下目前为止的咨询内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:52:41",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:53:19",
            "content": "ちなみに何とお呼びしたらいいですか？ニックネームなどでもいいです",
            "Chinese": "顺便问一下，我该怎么称呼您呢？用昵称也可以。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:53:40",
            "content": "では、ゆう　でおねがいします",
            "Chinese": "那就请叫我“悠”吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:53:56",
            "content": "はい。ありがとうございます",
            "Chinese": "好的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:56:56",
            "content": "ゆうさんは、今アルバイトをしながらフリーター生活を送っておられます。日々楽しいことがなく、やりたいこと、欲しいものなどもなく、無気力でおられます",
            "Chinese": "悠先生，您现在一边做兼职，一边过着自由职业者的生活。每天感觉不到快乐，也没有想做的事和想要的东西，感到无精打采。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:58:23",
            "content": "友達も近くにおらず、全く会っていなくて寂しいと感じておられる状況なのですね",
            "Chinese": "朋友也不在身边，完全见不到面，因此感到寂寞。是这样的情况对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 14:58:30",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 14:59:06",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:00:59",
            "content": "無気力なことは、大変つらくて憂鬱な気持ちになりますね。",
            "Chinese": "感到无精打采，确实会让人非常难受和郁闷呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:01:18",
            "content": "はい、むなしくなります",
            "Chinese": "是的，会感到空虚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:01:36",
            "content": "ええ、ええ",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:02:30",
            "content": "本日は勇気をだしてご相談に来てくださりありがとうございます。",
            "Chinese": "今天您能鼓起勇气前来咨询，非常感谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:03:01",
            "content": "このご相談で一番お話したいことはどのようなことですか？",
            "Chinese": "在这次咨询中，您最想聊的是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:03:34",
            "content": "どうしたら楽しく過ごせるかはなしたいです",
            "Chinese": "我想聊一聊怎样才能过得开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:04:58",
            "content": "ありがとうございます。どうしたら楽しく過ごせるか一緒に考えて、少しでも何かゆうさんのお力になれればと思います。",
            "Chinese": "谢谢您。我们一起思考如何能过得更开心，希望能对悠先生您有所帮助。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:05:07",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:07:19",
            "content": "ゆうさんは今までの生活の中で、何をしている時が嬉しいと感じていましたか？",
            "Chinese": "悠先生，在您至今为止的生活中，做什么事情的时候会感到开心呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:08:28",
            "content": "人とご飯食べたり、買い物したりしているときですかね",
            "Chinese": "大概是和别人一起吃饭、购物的时候吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:08:52",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:09:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:09:57",
            "content": "では、今あまりお友達と会う機会が減っていると、それもできなくて寂しいですね",
            "Chinese": "那么，现在和朋友见面的机会减少了，这些事也做不成了，一定感到很寂寞吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:10:14",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:12:15",
            "content": "先ほど友達と会えないのは、近くに仲のいい人がいない　と言われていましたが、",
            "Chinese": "您刚才说见不到朋友是因为附近没有关系好的朋友，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:12:43",
            "content": "お引越しをされたとかですか？",
            "Chinese": "是您搬家了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:13:14",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:13:48",
            "content": "そうだったのですね。それは悲しくなりますね。。",
            "Chinese": "原来是这样啊。那确实会让人难过呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:13:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:15:17",
            "content": "お友達は忙しくしていらっしゃる様子ですか？",
            "Chinese": "您的朋友们看起来很忙吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:15:37",
            "content": "あまり連絡をしないのでわからないです",
            "Chinese": "因为不怎么联系，所以不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:16:41",
            "content": "そうでしたか。連絡をた取らないのは何か理由はあるのかな？",
            "Chinese": "是这样啊。不怎么联系是有什么原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:18:14",
            "content": "私自身があまり積極的に人と交流するほうじゃなくて、どちらかというと少し苦手なのでずっと連絡を取り合うとかはほぼないですね",
            "Chinese": "我自己不是那种会积极与人交流的类型，反而有点不擅长，所以几乎不会一直保持联系。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:19:29",
            "content": "そうだったのですね。教えてくださりありがとうございます。",
            "Chinese": "原来是这样。谢谢您愿意告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:21:11",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:23:10",
            "content": "先ほど　人とご飯食べたり、買い物したりしているとき　が楽しいと教えてくださいましたが、他は何かも思いあたりませんか？",
            "Chinese": "您刚才告诉我“和别人一起吃饭、购物的时候”会感到开心，除此之外还能想到其他的吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:23:45",
            "content": "一人でする趣味などでもなんでも…",
            "Chinese": "比如一个人能做的兴趣爱好之类的都可以…"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:23:58",
            "content": "昔はサークル活動などがたのしかったです",
            "Chinese": "以前，社团活动之类的让我很开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:24:25",
            "content": "何のサークルですか？",
            "Chinese": "是什么社团呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:24:40",
            "content": "演劇です",
            "Chinese": "是戏剧社。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:25:13",
            "content": "そうなんですね！素敵なことですね",
            "Chinese": "是这样啊！那很棒呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:25:41",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:26:13",
            "content": "舞台などにでてらっしゃったのですか？",
            "Chinese": "您有上台表演过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:26:38",
            "content": "役者も裏方もやってました",
            "Chinese": "演员和幕后工作都做过。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:27:19",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:27:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:29:13",
            "content": "では、またそのようなサークルを探したり、ただ観劇するだけでも",
            "Chinese": "那么，再找找看类似的社团，或者只是去看看戏剧，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:29:37",
            "content": "刺激を受けられていいのかもしれませんね。",
            "Chinese": "也许能受到一些启发，会很不错呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/25(月) 15:30:14",
            "content": "そうですね",
            "Chinese": "说的是呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:31:50",
            "content": "今のゆうさんは、仲のいいお友達が遠くに行ってしまった悲しみや寂しさが大きくて",
            "Chinese": "现在的悠先生，可能因为好朋友去了远方而感到非常悲伤和寂寞，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:33:13",
            "content": "何も楽しくない、したくないと思ってしまうかもしれませんが、その感情を自分で受け止めて",
            "Chinese": "所以会觉得什么都不开心，什么都不想做。但请您先接纳自己的这种感情，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/25(月) 15:34:34",
            "content": "今の状況で少し顔を上にあげて周りを見回す余裕がでてきたときに",
