{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 18:50:40",
            "content": "こんばんは！今日はよろしくお願いいたします。",
            "Chinese": "晚上好！今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 18:51:58",
            "content": "こんばんは。",
            "Chinese": "晚上好。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 18:52:13",
            "content": "どうぞよろしくお願いします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 18:52:27",
            "content": "（時間になったら始めさせていただきますね）",
            "Chinese": "（时间到了，我们就开始吧。）"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 18:56:09",
            "content": "はい、お願いいたします。",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 18:59:26",
            "content": "（では始めさせていただきますね）こんばんは相談員です。今日はよろしくお願いいたします。",
            "Chinese": "（那么我们开始吧。）晚上好，我是咨询师。今天请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:00:26",
            "content": "はじめに、ご年齢と性別を教えていただけますか？",
            "Chinese": "首先，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:00:40",
            "content": "こんばんは。",
            "Chinese": "晚上好。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:00:47",
            "content": "お願いします",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:01:12",
            "content": "中2年　女子",
            "Chinese": "初中二年级，女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:01:23",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:01:44",
            "content": "今日はどのようなご相談でお越しいただきましたか？",
            "Chinese": "今天您是想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:02:15",
            "content": "いろいろな事が気になり、疲れてしまいます。",
            "Chinese": "我会在意很多事情，感觉很累。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:02:36",
            "content": "そうなんですね。疲れてしまうんですね。",
            "Chinese": "是这样啊。会觉得很累呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:02:41",
            "content": "もう少しで、学校が始まります。",
            "Chinese": "马上就要开学了。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:02:55",
            "content": "学校にいきたくないです。",
            "Chinese": "我不想去上学。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:02:59",
            "content": "あ、今は夏休みですもんね",
            "Chinese": "啊，现在是暑假嘛。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:03:07",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:03:18",
            "content": "学校に行きたくない気持ちなんですね",
            "Chinese": "您有不想去学校的心情呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:03:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:04:01",
            "content": "ゆっくりお話をうかがいたいと思うんですが何とお呼びしたらいいですか？ニックネームでもも",
            "Chinese": "我想慢慢地听您说，请问我该怎么称呼您呢？用昵称也可以。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:04:31",
            "content": "お友達と何かあるわけではないのですが、いろいろ気になり、つかれます。",
            "Chinese": "也不是和朋友发生了什么，就是会在意很多事情，很累。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:04:50",
            "content": "名前は、言わないとダメですか",
            "Chinese": "名字一定要说吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:05:22",
            "content": "いえいえ、大丈夫ですよ。こちらでは、言いたいことだけお話してくださいね。",
            "Chinese": "不不，没关系的。在这里，您只说想说的就好。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:05:31",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:06:06",
            "content": "いろいろ気になり・・・ってことですがたとえばどんな事が気になりますか？",
            "Chinese": "您说会在意很多事情……那比如说，会在意哪些事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:06:57",
            "content": "お友達といっしょにいると、合わせたりとかです。",
            "Chinese": "和朋友在一起时，需要迎合他们之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:07:59",
            "content": "そうなんですね～お友達に合わせたりが、しんどいんですね。",
            "Chinese": "是这样啊～迎合朋友让您觉得很辛苦呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:08:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:08:21",
            "content": "どうしたらいいてますか",
            "Chinese": "我该怎么办才好呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:08:42",
            "content": "「いいですか」でした",
            "Chinese": "是“该怎么办才好呢”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:08:50",
            "content": "一緒にどうしたらいいか、考えていきませんか？",
            "Chinese": "我们一起想想该怎么办，好吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:08:56",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:09:10",
            "content": "今は、どんな気持ち？",
            "Chinese": "现在，心里是什么感受？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:09:19",
            "content": "？",
            "Chinese": "？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:09:52",
            "content": "何のことですか",
            "Chinese": "您是指什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:10:27",
            "content": "学校に行きたくないなあって思うと気持ちは辛くなる？",
            "Chinese": "一想到不想去学校，您的心里会觉得难受吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:10:37",
            "content": "はい",
            "Chinese": "会的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:11:38",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:11:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:12:38",
            "content": "学校に行きたくない理由で、他に気になることって、ありますか？",
            "Chinese": "关于不想去上学的理由，还有其他在意的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:13:12",
            "content": "ないです。",
            "Chinese": "没有了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:13:46",
            "content": "そうなんですね他にはなさそうなんですね",
            "Chinese": "这样啊，看起来没有其他的了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:14:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:14:18",
            "content": "だめですか",
            "Chinese": "这样不行吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:14:43",
            "content": "いえいえ、丁寧にお返事いただいてありがとうございます",
            "Chinese": "不不，谢谢您这么认真地回答我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:15:39",
            "content": "気になるお友達は、何人かいらっしゃいますか？",
            "Chinese": "让您在意的朋友有几位呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:16:07",
            "content": "学校のお友達、みんなです。",
            "Chinese": "学校的朋友，全部都是。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:16:27",
            "content": "女子も、男子もって感じ？",
            "Chinese": "女生和男生都是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:16:42",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:17:07",
            "content": "気になると、疲れて自分が嫌になります。",
            "Chinese": "一旦在意起来，就会很累，甚至会讨厌自己。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:17:43",
            "content": "そうなんですね。自分が嫌になっちゃうほど、疲れてしまうんだね",
            "Chinese": "是这样啊。累到会觉得讨厌自己呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:17:57",
            "content": "どうしたら、いいですか",
            "Chinese": "我该怎么办才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:19:23",
            "content": "それは悩むよね・・・",
            "Chinese": "这确实让人烦恼啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:19:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:20:09",
            "content": "どうしたらいいのかな私も今、一生懸命に考えています。もう少しお話を聞かせてもらってもいいですか？",
            "Chinese": "该怎么办才好呢……我现在也在认真思考。可以再多听您说一些吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:20:37",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:21:01",
            "content": "お友達といる時に、つかれちゃうな～って思ったのは、いつ頃からですか？",
            "Chinese": "您大概是从什么时候开始，觉得和朋友在一起会很累的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:21:24",
            "content": "中学生になって",
            "Chinese": "上了初中之后。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:21:47",
            "content": "入学してすぐくらいから？",
            "Chinese": "刚入学不久就这样了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:22:20",
            "content": "あまり、覚えていません。",
            "Chinese": "不太记得了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:23:36",
            "content": "うんうんそうなんですね。でも、わりと長い間辛い気持ちとか、疲れるな～って気持ちを抱えてきたって感じですか？？",
            "Chinese": "嗯嗯，是这样啊。不过，感觉您抱着这种难受、疲惫的心情已经很长一段时间了，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:24:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:24:54",
            "content": "どうしたらいいですな",
            "Chinese": "我该怎么办才好呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:24:57",
            "content": "そっか・・・それはしんどかったよね",
            "Chinese": "这样啊……那确实很不容易呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:25:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:25:26",
            "content": "誰かに相談してみた？してない？",
            "Chinese": "您有和别人商量过吗？还是没有？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:25:50",
            "content": "してないから、相談にきました。",
            "Chinese": "因为没和别人说，所以才来咨询的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:26:52",
            "content": "そうですよね。来てくれてありがとう。今まで一人で悩んできたんだね",
            "Chinese": "是啊。谢谢您能来。至今为止都是一个人在烦恼呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:27:39",
            "content": "しんどかったね",
            "Chinese": "真是辛苦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:30:47",
            "content": "今は、どんな夏休みを過ごしてますか？",
            "Chinese": "现在您是怎么度过暑假的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:31:26",
            "content": "宿題とか、塾とか行ってます。",
            "Chinese": "在做作业，还有去补习班。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:32:15",
            "content": "夏休みでも宿題も塾もあって、大変だね",
            "Chinese": "即使是暑假，也要做作业和上补习班，真不容易呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:32:21",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:33:16",
            "content": "塾とかは行くのは平気な感じですか？",
            "Chinese": "去补习班之类的，还可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:33:29",
            "content": "塾でも、人間関係つかれます。",
            "Chinese": "在补习班，人际关系也让我很累。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:33:59",
            "content": "人間関係で、疲れちゃうんだね",
            "Chinese": "是因为人际关系而感到疲惫呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:34:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:34:49",
            "content": "どうして疲れるのかなあ・・って考えたことは今までにあったりする？",
            "Chinese": "您至今为止，有想过为什么会觉得这么累吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:36:45",
            "content": "一緒にいると、きをつかったり、さっきも、話しましたが、、合わせたりするから、つかれます。",
            "Chinese": "因为和别人在一起时，要顾虑别人，刚才也说了，要去迎合别人，所以很累。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:37:43",
            "content": "そうだねさっきも聞いたね気を使ったり、合わせたりが、きつんだよね",
            "Chinese": "是呢，刚才也听您说了。要顾虑别人、迎合别人，很辛苦是吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:37:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:38:45",
            "content": "お話をしていてお友達はたくさんいるんじゃないかなって思ったけど、合ってる？",
            "Chinese": "听您这么说，我感觉您的朋友应该很多，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:39:02",
            "content": "はい",
            "Chinese": "对。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:40:23",
            "content": "うんうんお友達と楽しく過ごしているようだけど心では気をつかったり合わせたりがきついってことかな",
            "Chinese": "嗯嗯，虽然看起来和朋友们相处得很开心，但内心却因为要顾虑和迎合他们而感到辛苦，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:40:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:41:52",
            "content": "そうなんだね。毎日疲れちゃうね",
            "Chinese": "这样啊。每天都会很累吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:42:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:42:32",
            "content": "お友達はあなたが疲れちゃうこと気付いていない感じかな",
            "Chinese": "您的朋友们，是不是没察觉到您很累呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:43:21",
            "content": "わからないです。",
            "Chinese": "不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:44:52",
            "content": "そうなんだね友達と色々話したり一緒に行動したりはしているけど常にあなたが気を使っている感じなのかな",
            "Chinese": "是这样啊。虽然会和朋友聊各种事，一起行动，但一直都是您在费心留意，是这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/17(火) 19:45:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/17(火) 19:46:44",
            "content": "そっか・・・それは本当に疲れると思います。状況を丁寧に話してくれてありがとう",
            "Chinese": "这样啊……我觉得那真的会很累。谢谢您这么详细地告诉我您的情况。"
