        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:31:15",
            "content": "でも学校に言われたくない",
            "Chinese": "但我不想让学校知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:31:35",
            "content": "それはどうして?",
            "Chinese": "这是为什么呢？"
