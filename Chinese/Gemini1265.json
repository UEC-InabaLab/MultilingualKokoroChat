        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:33:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:33:56",
            "content": "ただ",
            "Chinese": "不过——"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:34:15",
            "content": "いじめは、どんな場合にもあってはいけないことです。",
