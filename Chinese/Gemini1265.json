{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:42:54",
            "content": "お待たせしました。何とか、画面が出てきましたので、スタートしますね。",
            "Chinese": "让您久等了。总算把画面弄出来了，我们现在开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:43:06",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:43:36",
            "content": "こんにちは。相談員です。今日は相談に来てくださってありがとうございます。",
            "Chinese": "您好。我是咨询员。非常感谢您今天前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:43:46",
            "content": "宜しくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:44:07",
            "content": "こちらこそ、宜しくお願いします。初めに、性別と年齢を教えてください。",
            "Chinese": "我才是，请多关照。首先，请告诉我您的性别和年龄。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:44:26",
            "content": "14さい、女子です",
            "Chinese": "14岁，女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:44:38",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:45:01",
            "content": "中学二年生かな?今日はどのようなご相談ですか?",
            "Chinese": "是初二的学生吧？今天想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:45:13",
            "content": "はい、いじめられてて",
            "Chinese": "是的，我正在被欺负。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:45:35",
            "content": "そうなんですね。それは辛いですね。",
            "Chinese": "是这样啊。那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:45:49",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:45:55",
            "content": "詳しく教えてくれますか?",
            "Chinese": "能跟我详细说说吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:46:21",
            "content": "誰からいじめられてると感じていますか?",
            "Chinese": "您觉得是谁在欺负您呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:46:30",
            "content": "みんなが私のことこそこそはなしてて",
            "Chinese": "大家都背着我窃窃私语。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:46:51",
            "content": "そうなんだね。それは気になりますね。",
            "Chinese": "是这样啊。那确实会让人很在意呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:47:12",
            "content": "皆というのは、クラスの人?",
            "Chinese": "您说的“大家”，是指班上的同学吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:47:44",
            "content": "はい、聞こえてそっち見るとシラーっと違う方向見たりします",
            "Chinese": "是的，我听见后看过去，他们就装作若无其事地看向别的方向。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:48:35",
            "content": "聞こえてくるんですね。なのに見ると知らん顔・・・それはしんどいね。",
            "Chinese": "您能听到他们说话，但一看过去他们就装作不知道……这真是让人难受啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:48:47",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:49:09",
            "content": "どんな内容の話が聞こえてくるのですか?",
            "Chinese": "您都听到他们聊些什么内容呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:49:13",
            "content": "上履きも隠されて",
            "Chinese": "我的室内鞋也被藏起来了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:49:32",
            "content": "ええ、それは悪質ですね。",
            "Chinese": "啊，这行为太恶劣了。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:49:34",
            "content": "内容はわからなくて、○○ちゃんさーって",
            "Chinese": "具体内容听不清，就听到“（我的名字）啊——”这样的片段。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:49:43",
            "content": "名前が聞こえた",
            "Chinese": "听到了我的名字。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:49:56",
            "content": "そっかー",
            "Chinese": "这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:50:18",
            "content": "名前が聞こえると気になって仕方ないですよね。",
            "Chinese": "听到自己的名字，当然会特别在意呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:50:21",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:50:57",
            "content": "上履き隠されて、悲しかったよね。その後上履きはどうなったの?",
            "Chinese": "室内鞋被藏起来，一定很难过吧。后来室内鞋怎么样了呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:51:50",
            "content": "反対側の下駄箱の上の私には見えないところにありました",
            "Chinese": "被放在对面鞋柜上方我看不见的地方。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:52:21",
            "content": "出てきたけど、見つからないような場所にあったんですね。",
            "Chinese": "虽然找到了，但被放在不容易发现的地方了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:52:28",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:52:58",
            "content": "いつ頃から、そのような嫌な思いをしているのですか?",
            "Chinese": "大概从什么时候开始有这些让您难受的事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:53:36",
            "content": "1年の6月くらいから",
            "Chinese": "从初一的六月左右开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:54:03",
            "content": "ということは、1年半くらいかな?",
            "Chinese": "也就是说，差不多有一年半了吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:54:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:54:41",
            "content": "長い間、ずっと嫌な思いをして、闘ってきたんですね。",
            "Chinese": "这么长的时间里，您一直忍受着这种不愉快，一路抗争过来，真不容易。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:54:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:55:57",
            "content": "さっきの、上履きですが、どのようにして見つかったのですか?",
            "Chinese": "刚才说到的室内鞋，后来是怎么找到的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:56:42",
            "content": "知らない3年生が、私がうろうろしてたら背が高くて見えたみたいで",
            "Chinese": "有个不认识的初三学长，看到我在附近转来转去，他个子高，好像就看到了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:56:54",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:57:30",
            "content": "私のって知らないで上から落としてくれて",
            "Chinese": "他不知道是我的，就帮我从上面拿了下来。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:57:48",
            "content": "見つかりました",
            "Chinese": "找到了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:58:00",
            "content": "そっか、偶然だけれど見つかって良かったですね。",
            "Chinese": "这样啊，虽然是偶然，但能找到真是太好了。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:58:18",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:58:31",
            "content": "あなたが上履きを隠されたり、こそこそ言われたりしているのをお友達は知っていますか?",
            "Chinese": "您被藏室内鞋、被人窃窃私语这件事，朋友知道吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 11:59:03",
            "content": "なんとなく気が付いてると思います",
            "Chinese": "我想他们大概隐约察觉到了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 11:59:49",
            "content": "そうなんですね。直接、あなたから誰かにお話したりしたことはありますか?",
            "Chinese": "这样啊。您有没有亲口跟谁说过呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:00:04",
            "content": "ないです",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:00:17",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:00:40",
            "content": "おうちの人や先生はどうですか?",
            "Chinese": "家里人或者老师那边呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:00:57",
            "content": "はなしてませｓん",
            "Chinese": "还没说过……"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:01:07",
            "content": "ません",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:01:39",
            "content": "ということは、この一年半の間、一人で、しんどい思いを抱えて頑張ってきたんですね。",
            "Chinese": "也就是说，这一年半里，您一直都是一个人扛着这些难受的事，努力撑过来的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:01:46",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:01:53",
            "content": "しんどかったね。",
            "Chinese": "太辛苦了。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:02:02",
            "content": "始めは気にしないでって",
            "Chinese": "一开始我想“不要在意就好”，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:02:09",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:02:19",
            "content": "思ってたんだけど",
            "Chinese": "本来是这么想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:02:27",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:02:45",
            "content": "すごく続くからだんだん怖くなって",
            "Chinese": "但因为一直持续下去，我渐渐开始害怕了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:02:56",
            "content": "そうですよね。",
            "Chinese": "是啊，可以理解。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:03:03",
            "content": "この頃は学校も休んだりしてる",
            "Chinese": "最近我也开始请假不去学校了。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:03:15",
            "content": "行く日もあるけど",
            "Chinese": "虽然有时候还是会去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:03:28",
            "content": "学校にいけないくらい怖い気持ちになっているんですね。",
            "Chinese": "您已经害怕到有时没法去学校了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:03:37",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:04:50",
            "content": "学校をお休みすることを、おうちの人はどのように言ってますか?",
            "Chinese": "对于您请假不去学校这件事，您的家人是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:05:15",
            "content": "頭痛いとか言ってるから別に何とも言わないです。",
            "Chinese": "我说是头疼之类的，所以他们也没多说什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:06:07",
            "content": "そうなんだね。本当の理由を言えなくて苦しいね。",
            "Chinese": "是这样啊。不能说出真正的原因，心里一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:06:37",
            "content": "でも心配するから",
            "Chinese": "但是我怕他们会担心。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:06:57",
            "content": "言って大げさになりたくないし",
            "Chinese": "而且我也不想说了之后把事情闹大。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:07:11",
            "content": "そんな風に思ってるんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:07:29",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:08:27",
            "content": "一年半も苦しい思いが続いていると、体にも勉強にも影響が出るし、私は、あなたがとても心配です。",
            "Chinese": "这种痛苦的状况持续了一年半，会影响到您的身体和学习，我非常担心您。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:09:02",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:09:13",
            "content": "何人家族ですか?",
            "Chinese": "您家有几口人？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:09:26",
            "content": "3人です",
            "Chinese": "三口人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:09:36",
            "content": "構成は?",
            "Chinese": "家庭成员是？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:09:58",
            "content": "父・母・私です",
            "Chinese": "爸爸、妈妈和我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:10:11",
            "content": "一人っ子さんなんですね。",
            "Chinese": "您是独生女啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:10:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:10:49",
            "content": "お父さん、お母さんはどんな人ですか?",
            "Chinese": "您的爸爸妈妈是怎样的人呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:11:41",
            "content": "お父さんはほとんど仕事で朝も夜もあっても話さない感じで、お母さんとは普通です",
            "Chinese": "爸爸基本都在工作，早晚就算见到面也说不上话，和妈妈关系很普通。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:12:36",
            "content": "そうなんですね。お父さんは会っても話せないくらい、とても忙しいんですね。",
            "Chinese": "是这样啊。您的爸爸非常忙，忙到即使见面也说不上话的程度。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:12:50",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:13:09",
            "content": "お母さんは、お勤めされてるの?",
            "Chinese": "妈妈也在上班吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:13:13",
            "content": "仲悪くもないけど",
            "Chinese": "也不是关系不好，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:13:19",
            "content": "おとうさんとは",
            "Chinese": "和爸爸。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:13:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:13:36",
            "content": "お母さんも仕事してます",
            "Chinese": "妈妈也在工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:13:41",
            "content": "はい、お父さんのことありがとう。",
            "Chinese": "好的，谢谢您告诉我关于爸爸的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:13:53",
            "content": "お母さんもお仕事なんですね。",
            "Chinese": "妈妈也在上班呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:14:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:14:21",
            "content": "お母さんの忙しさは、どんな感じですか?",
            "Chinese": "妈妈忙到什么程度呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:15:48",
            "content": "7時過ぎには帰ってきます",
            "Chinese": "7点多会回到家。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:16:10",
            "content": "コロナで家で仕事する日もあります",
            "Chinese": "因为疫情，有时候也会在家办公。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:17:36",
            "content": "そうなんですね。在宅で仕事されてて、学校を休んでいると気を遣いますか?",
            "Chinese": "是这样啊。她在家办公的时候，您请假在家会觉得不自在吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:18:39",
            "content": "ほとんど部屋から出ないで寝てます",
            "Chinese": "我基本上都待在房间里睡觉，不怎么出来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:18:57",
            "content": "苦しいですね。",
            "Chinese": "真让人难受啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:19:11",
            "content": "気を遣うと言うか今日も学校行けなかったって、暗くなる",
            "Chinese": "与其说是不自在，不如说是想到“今天又没能去学校”，心情就会变得很低落。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:19:37",
            "content": "それは、あなた自身の気持ちですか?",
            "Chinese": "这是您自己的感受吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:19:45",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:20:33",
            "content": "そっか・・・。そんな風に考えると、お休みしていても、気が休まりませんね。",
            "Chinese": "这样啊……。这么想的话，即使是在家休息，心情也得不到放松呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:20:39",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:21:45",
            "content": "学校に行っても怖いし、家でもリラックスできない・・・あなたはとても我慢強い人だと感じます。でも、どんどん追い詰められてしんどくなっていないですか?",
            "Chinese": "去学校害怕，在家也无法放松……我觉得您非常能忍耐。但是，您是否感到自己越来越被逼入困境，越来越难受呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:22:01",
            "content": "しんどいです",
            "Chinese": "很痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:22:16",
            "content": "学校行きたくない",
            "Chinese": "我不想去学校。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:22:46",
            "content": "そうですよね。そんな風に思うのは自然のことだと思いますよ。",
            "Chinese": "是啊。我觉得会这么想是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:23:18",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:23:25",
            "content": "でも、家でも自分を責めて休めないんですよね。",
            "Chinese": "但是，在家里您也会责备自己，无法好好休息，对吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:23:55",
            "content": "お母さんの心配かけてはいけないとおもっているという話でしたが、",
            "Chinese": "您刚才提到不想让妈妈担心，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:24:06",
            "content": "自分っていうか、このままずっと続いたらどうしよって",
            "Chinese": "也不是责备自己，就是会想，如果一直这样下去该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:24:33",
            "content": "うんうん、不安な気持ちになりますよね。",
            "Chinese": "嗯嗯，确实会感到不安呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:24:39",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:24:55",
            "content": "高校とか将来のことも考える時期に差し掛かるし",
            "Chinese": "而且也到了该考虑高中和未来的时候了。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:25:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:25:32",
            "content": "もし、お母さんに本当のことを言ったら、具体的にどんな風に反応されると思いますか?",
            "Chinese": "如果把真实情况告诉妈妈，您觉得她会具体有什么反应呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:25:47",
            "content": "わからないけど、泣いちゃうかも",
            "Chinese": "我不知道，但她可能会哭吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:26:03",
            "content": "お母さんが?",
            "Chinese": "妈妈会哭吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:26:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:26:20",
            "content": "それは、どうしてそう思うの?",
            "Chinese": "您为什么会这么想呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:26:45",
            "content": "私をすごく心配してくれてるから",
            "Chinese": "因为她非常担心我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:27:01",
            "content": "そうなんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:27:15",
            "content": "心配というのは、例えば、どんなこと?",
            "Chinese": "您说的担心，具体是指哪些方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:27:20",
            "content": "あと、先生に言って大げさになるのもいや",
            "Chinese": "还有，我也不想她告诉老师把事情闹大。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:28:31",
            "content": "勉強わかる？とかお友達と仲良くしてる？とかよく聞いて来るから",
            "Chinese": "因为她经常问我“学习跟得上吗？”“和朋友们处得好吗？”之类的问题。"
