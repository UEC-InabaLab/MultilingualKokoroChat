        {
            "role": "クライアント",
            "time": "2021/01/29(金) 12:33:07",
            "content": "言いつけたっておもわれそう",
            "Chinese": "感觉会被认为是我“告状了”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:33:33",
            "content": "そんな風うに思うと言えなくなっちゃうよね。",
