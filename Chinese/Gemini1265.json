        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:28:46",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/29(金) 12:29:41",
            "content": "勉強や友達関係がスムーズにいってほしいように思えるんですね。",
