    },
    {
      "role": "client",
      "time": "2021-10-28T20:34:05",
      "origin": "毎日は行ってません。曜日によって行く感じです",
      "content": "不是每天都去，分星期几去。"
    },
    {
      "role": "counselor",
      "time": "2021-10-28T20:34:16",
      "origin": "そうだったのですね。",
