    },
    {
      "role": "counselor",
      "time": "2021-10-28T20:25:06",
      "origin": "そうねのですね。",
      "content": "是这样啊。"
    },
    {
      "role": "counselor",
      "time": "2021-10-28T20:25:18",
      "origin": "それは何故ですか？",
      "content": "那是为什么呢？"
    },
    {
      "role": "client",
