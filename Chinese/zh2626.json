    },
    {
      "role": "counselor",
      "time": "2021-10-28T20:19:49",
      "origin": "それはお辛かったですよね。",
      "content": "那一定很难受吧。"
    },
    {
      "role": "client",
      "time": "2021-10-28T20:20:25",
      "origin": "はい、もうしんどいです",
