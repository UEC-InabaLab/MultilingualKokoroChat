    },
    {
      "role": "client",
      "time": "2021-10-28T20:26:58",
      "origin": "はい",
      "content": "好的。"
    },
    {
      "role": "client",
      "time": "2021-10-28T20:27:17",
      "origin": "でも、どうしてかわかりません",
