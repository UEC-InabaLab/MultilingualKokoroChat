    {
      "role": "counselor",
      "time": "2021-10-28T20:23:25",
      "origin": "そうなのですね。",
      "content": "是这样啊。"
    },
    {
      "role": "client",
      "time": "2021-10-28T20:23:43",
      "origin": "あの子がどうだとか、こうだとか　です",
