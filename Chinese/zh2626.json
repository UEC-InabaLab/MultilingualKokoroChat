    },
    {
      "role": "counselor",
      "time": "2021-10-28T20:30:38",
      "origin": "そうでしたか。",
      "content": "是这样啊。"
    },
    {
      "role": "client",
      "time": "2021-10-28T20:30:57",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-10-28T20:31:03",
      "origin": "その時間はほっとする感じですか？",
