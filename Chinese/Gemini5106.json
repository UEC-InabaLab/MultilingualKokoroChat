{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 15:57:30",
            "content": "こんにちは本日宜しくお願いします",
            "Chinese": "您好，今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 15:57:54",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 15:58:04",
            "content": "宜しくお願い致します",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:00:09",
            "content": "こんにちは、相談員です。本日は相談に来ていただきありがとうございます。",
            "Chinese": "您好，我是咨询师。非常感谢您今天前来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:00:31",
            "content": "本日はどのようなご相談でしょうか。",
            "Chinese": "今天您想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:01:07",
            "content": "長い間飼っていたネコがなくなったんです",
            "Chinese": "我养了很久的猫去世了。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:01:19",
            "content": "悲しくて仕方ありません",
            "Chinese": "我难过得不得了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:01:36",
            "content": "そうでしたか、、",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:01:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:02:29",
            "content": "いつ頃から飼っておられたのでしょうか？",
            "Chinese": "您是从什么时候开始养它的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:02:51",
            "content": "もう17年一緒でした",
            "Chinese": "我们已经在一起17年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:03:26",
            "content": "17年もずっと一緒に大切な時間を過ごしてこられたのですね",
            "Chinese": "原来你们已经一起度过了17年这么长的宝贵时光啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:03:47",
            "content": "そうなんです。家族でした",
            "Chinese": "是啊，它就是我的家人。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:04:14",
            "content": "悲しくて毎日涙が出ます",
            "Chinese": "我难过得每天都流眼-泪。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:04:54",
            "content": "本当に悲しくて、寂しくて、どうしたらいいのか分からなくなりますよね、、",
            "Chinese": "真的会感到很悲伤、很孤单，甚至不知道该怎么办才好，是吧……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:05:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:06:26",
            "content": "あなたのことと、飼ってらっしゃったネコちゃんのことを、何とお呼びしたらよいでしょうか？",
            "Chinese": "请问该如何称呼您和您养的猫咪呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:07:14",
            "content": "ネコはレオンです。私はMでお願いします。",
            "Chinese": "猫咪叫雷欧，您可以叫我M。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:07:34",
            "content": "教えてくれてありがとうございます",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:08:18",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:08:22",
            "content": "ちなみに、ネコちゃんはオスですか、メスですか？",
            "Chinese": "顺便问一下，猫咪是公的还是母的？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:08:47",
            "content": "オスです",
            "Chinese": "是公的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:09:17",
            "content": "そうでしたか、レオンくんですね、ありがとうございます",
            "Chinese": "原来如此，是小雷欧啊，谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:09:30",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:10:03",
            "content": "悲しくて仕方無いのですが、気持ちの整理が尽きません",
            "Chinese": "我难过得不行，但心情一直无法平复。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:10:46",
            "content": "そうだったのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:10:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:11:35",
            "content": "レオンくんのことで、どんなことが思い出されますか？",
            "Chinese": "关于小雷欧，您会想起哪些事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:12:12",
            "content": "いつも仕事からかえって来たら、迎えに来てくれたり",
            "Chinese": "每次我下下班回家，它都会过来迎接我，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:12:23",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:12:28",
            "content": "一緒に毎日寝ていました。",
            "Chinese": "我们每天都一起睡觉。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:12:49",
            "content": "いつもそばにいてくれました",
            "Chinese": "它总是陪在我身边。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:12:55",
            "content": "そうだったのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:13:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:13:24",
            "content": "それは本当におつらいですよね、、",
            "Chinese": "那确实让人很难受……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:13:49",
            "content": "どんな時もずっとずっと一緒にいてくれた",
            "Chinese": "无论什么时候，它都一直一直陪在您身边。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:13:51",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:14:29",
            "content": "落ち込んでいる時は膝の上にきて慰めてくれたりしていました",
            "Chinese": "我心情低落的时候，它会跳到我膝盖上安慰我。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:15:45",
            "content": "あなたの気持ちが分かるくらい、レオンくんとあなたの間には深い繋がりがあったのですね",
            "Chinese": "您和小雷欧之间有着深刻的连结，它仿佛能懂得您的心情呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:16:37",
            "content": "そうですね。でももういなくて、会いたくてしかたありません",
            "Chinese": "是的。但它已经不在了，我好想见到它，想得不得了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:17:46",
            "content": "レオンくんは、あなたにとって本当に大切な存在なのですね",
            "Chinese": "小雷欧对您来说真的是非常重要的存在呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:18:11",
            "content": "大切な存在でした。",
            "Chinese": "它曾是非常重要的存在。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:18:25",
            "content": "本当にそうですよね",
            "Chinese": "确实是这样呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:18:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:18:45",
            "content": "先ほど、気持ちの整理がつかないと教えてくれましたが、今ご自身の中ではどういった感じなのでしょうか？",
            "Chinese": "刚才您提到难以整理情绪，现在您内心大致是一种怎样的感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:19:27",
            "content": "いないと分かっているんですが、探してしまいますし、",
            "Chinese": "虽然知道它不在了，但我还是会下意识地去找它。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:19:38",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:20:17",
            "content": "帰ってきた時に、もう迎えに来てくれる子がいないんだなと思って悲しくなります。",
            "Chinese": "回到家时一想到再也不会有那个会来迎接我的孩子了，就感到很悲伤。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:22:02",
            "content": "ずっと一緒で大切なだったからこそ、そう思われるのも無理ないと思います",
            "Chinese": "正因为一直在一起，是非常重要的存在，所以您会这么想也是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:22:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:23:02",
            "content": "ちなみに、一緒に住んでおられるご家族などはいらっしゃいますか？",
            "Chinese": "顺便问一下，您有和家人一起住吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:23:21",
            "content": "主人と二人です",
            "Chinese": "我和我丈夫两个人住。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:23:31",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:23:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:24:07",
            "content": "子供のような存在でした",
            "Chinese": "它就像我的孩子一样。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:24:37",
            "content": "人間だと高校生くらいまで生きたことになります。",
            "Chinese": "换算成人类年龄的话，相当于活到了高中生那么大。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:25:05",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:25:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:26:29",
            "content": "そうして長く生きることが出来たのは、レオンくんが家族として愛情たっぷりで過ごすことが出来たからかもしれませんね",
            "Chinese": "它能活这么久，或许正是因为它作为家人，在充满爱的环境中度过的缘故吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:26:58",
            "content": "そうかもしれませんね",
            "Chinese": "也许是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:27:54",
            "content": "レオンくんのこと、どんなことが思い出されますか？",
            "Chinese": "提到小雷欧，您还会想起哪些事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:28:26",
            "content": "先ほど述べたことと",
            "Chinese": "前面说到的那些，还有……"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:29:22",
            "content": "最後は、私が仕事から帰ってくるのを待っててくれて、私の腕の中で亡くなった事です",
            "Chinese": "还有就是最后，它一直等着我下班回家，在我的怀里去世了。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:30:04",
            "content": "思い出すと本当に辛いです",
            "Chinese": "一想起来就真的很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:31:30",
            "content": "そうだったのですね、Mさんに最後の最後まで寄り添って、旅立っていったのですね",
            "Chinese": "是这样啊，它陪伴着M女士直到最后一刻，才离开这个世界呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:31:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:33:24",
            "content": "旅立っていく時には、どんな思いがしましたか？",
            "Chinese": "在它离去的时候，您是怎样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:34:39",
            "content": "待っててくれたこと、最後をちゃんと見とどける事が出来て本当に良かったと思いました",
            "Chinese": "我觉得它能等着我，我能好好地送它最后一程，真的太好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:36:59",
            "content": "世界にたった一つの大切な存在だからこそ、最後の時間を過ごせたことは本当に良かったですよね",
            "Chinese": "正因为它是独一无二、无比珍贵的存在，能陪它走过最后的时光，确实是件很好的事呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:37:46",
            "content": "そうですね。本当にそう思っています。最後まで私のことを思ってくれていたのかなと",
            "Chinese": "是的。我也确实这么想。也许它到最后都还在惦记着我吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:38:18",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:38:29",
            "content": "本当にそうですよね",
            "Chinese": "确实是这样呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:39:24",
            "content": "毎日泣いてて良いのかなと、最近思ってきて、レオンが悲しんでいるかもと",
            "Chinese": "我最近在想，每天都这样哭是不是不太好，会不会让雷欧也难过。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:39:53",
            "content": "考えています。",
            "Chinese": "我一直在这样想。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:40:13",
            "content": "そのようにも考えておられるのですね",
            "Chinese": "您也在这样思考啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:40:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:41:04",
            "content": "毎日泣いていていいのかな・・って",
            "Chinese": "您在想“每天都哭，可以吗……”吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:41:27",
            "content": "そうですね…",
            "Chinese": "是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:42:54",
            "content": "もしレオンくんが、今Mさんのそばに居たとして、あなたが悲しんでいる様子を見た時に、レオンくんも悲しい感じになりそうでしょうか？",
            "Chinese": "如果小雷欧现在就在M女士身边，看到您这么伤心，您觉得它也会变得难过吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:43:30",
            "content": "きっと慰めにきてくれると思います",
            "Chinese": "我想它一定会过来安慰我。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:43:45",
            "content": "そうでしたか",
            "Chinese": "原来如此啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:44:04",
            "content": "あなたは何て声をかけてあげたいですか？",
            "Chinese": "那么您想对它说些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:44:40",
            "content": "会いたいっていうかな…",
            "Chinese": "我大概会说“好想见你”吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:45:13",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:45:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:45:42",
            "content": "大切な大切な存在だったからこそ、そう思いますよね",
            "Chinese": "正因为是非常非常重要的存在，所以才会这么想，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:46:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/05/22(月) 16:46:50",
            "content": "「会いたい」って声かけると、レオンくんはどんな反応をしていますか？",
            "Chinese": "当您对它说“好想见你”时，您想象中小雷欧会有什么反应呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/05/22(月) 16:47:32",
            "content": "悲しそうな顔するとおもいます",
            "Chinese": "我想它会露出悲伤的表情。"
        },
        {
            "role": "クライアント",
