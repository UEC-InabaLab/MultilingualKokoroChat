    },
    {
      "role": "counselor",
      "time": "2021-06-02T13:52:42",
      "origin": "あなたの思いを感じたい、分かりたいと思っているのです・・・",
      "content": "我是真心想要去感受、去理解您的感受……"
    },
    {
      "role": "client",
      "time": "2021-06-02T13:52:52",
      "origin": "そうですか・・",
      "content": "是吗……"
    },
    {
      "role": "counselor",
