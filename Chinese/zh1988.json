    {
      "role": "client",
      "time": "2021-06-02T13:47:35",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-06-02T13:49:21",
      "origin": "私にはあなたの寂しさや、いろんなお気持ちが伝わってくるような気がしています・・・",
