{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 20:51:58",
            "content": "こんばんは。本日はよろしくお願いいたします。",
            "Chinese": "晚上好。今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 20:52:08",
            "content": "よろしくお願いいたします",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 20:52:59",
            "content": "ありがとうございます。時間になりましたら初めてまいりますので、少々お待ちください。",
            "Chinese": "谢谢您。时间一到我们就会开始，请稍等片刻。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:00:10",
            "content": "こんばんは。相談員です。本日はご相談にお越しいただきありがとうございます。 はじめに、ご年齢と性別を教えていただけますか？",
            "Chinese": "晚上好。我是咨询员。感谢您今天前来咨询。首先，请问可以告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:00:26",
            "content": "13才　女",
            "Chinese": "13岁，女。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:00:44",
            "content": "ありがとうございます。 では、本日はどのようなご相談でしょうか？",
            "Chinese": "谢谢您。那么，今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:01:33",
            "content": "学校にいくのが怖いです",
            "Chinese": "我害怕去学校。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:03:10",
            "content": "そうでしたか・・・それはお困りですね。具体的にはどういったことが怖いのか教えていただいていいですか？",
            "Chinese": "是这样啊...那一定很困扰吧。能具体告诉我您害怕的是什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:03:48",
            "content": "ある先生の授業が明日あるのですが",
            "Chinese": "明天有一位老师的课，"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:03:59",
            "content": "その先生はいつも不機嫌で",
            "Chinese": "那位老师总是心情不好，"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:04:15",
            "content": "正直怖いです",
            "Chinese": "说实话，我很害怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:04:49",
            "content": "なるほど、その先生のことが怖いのですね",
            "Chinese": "原来如此，您害怕那位老师呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:05:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:05:26",
            "content": "不機嫌で、怒ったりするのですか？",
            "Chinese": "他心情不好时，会发脾气吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:05:36",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:06:38",
            "content": "そうなんですね・・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:07:02",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:07:12",
            "content": "ちなみに、どんな時に怒る感じでしょうか？",
            "Chinese": "顺便问一下，老师通常在什么情况下会发脾气呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:07:39",
            "content": "机叩いたり気に入らない生徒を怒鳴ったりしてます",
            "Chinese": "他会拍桌子，还会对看不顺眼的学生大吼大叫。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:08:00",
            "content": "それは怖いですね",
            "Chinese": "那确实很吓人。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:08:09",
            "content": "はい怖いです",
            "Chinese": "是的，很害怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:08:31",
            "content": "あなたも怒られたりするのでしょうか？",
            "Chinese": "您也被他骂过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:09:05",
            "content": "まだ怒られてはいないのですが",
            "Chinese": "我还没有被骂过，"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:09:33",
            "content": "いつ来てもおかしくないかなと",
            "Chinese": "但总觉得随时都可能轮到我，"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:09:35",
            "content": "思ってます",
            "Chinese": "我是这么想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:10:31",
            "content": "なるほど・・・周りの人を怒る様子を見ていると、いつ自分もって不安になる感じなんですね",
            "Chinese": "原来如此……看到老师对其他人发脾气，您就会担心自己也可能被骂，感到不安呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:10:38",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:12:00",
            "content": "いつ自分が怒られるかと思うと、びくびくしてしまうのはもっともなことだと思います。",
            "Chinese": "担心不知何时会被骂，变得惴惴不安，这是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:12:32",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:13:57",
            "content": "周りの友達はその先生の態度のことをどんな風に言っていますか？",
            "Chinese": "您的朋友们对这位老师的态度是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:14:21",
            "content": "理不尽だとか",
            "Chinese": "说他很不讲理，"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:14:33",
            "content": "八つ当たりだとか",
            "Chinese": "像是在迁怒，"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:14:39",
            "content": "そんな感じですかね",
            "Chinese": "大概就是这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:17:19",
            "content": "なるほど・・・気に入らないからって怒られるなんて・・・理不尽だと思ってしまいますよね",
            "Chinese": "我明白了...只是因为看不顺眼就被骂...确实会觉得很不讲理呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:17:30",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:18:41",
            "content": "ちなみに、その先生の授業は週に何回あるのでしょうか？",
            "Chinese": "顺便问一下，那位老师的课一周有几次呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:18:55",
            "content": "2回くらいです",
            "Chinese": "大概有两次。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:19:50",
            "content": "そうなんですね。毎日ではないのがせめてもの救いですかね。",
            "Chinese": "是这样啊。还好不是每天都有，算是不幸中的万幸吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:19:59",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:21:38",
            "content": "どのくらいの頻度で怒る感じですか？",
            "Chinese": "他发脾气的频率大概是多久一次呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:21:57",
            "content": "15分に一回くらいですね",
            "Chinese": "大概每15分钟一次吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:22:47",
            "content": "そんなに・・・そんなに頻繁ではあなたが怖くなるのも無理はないと思います。",
            "Chinese": "这么频繁……难怪您会感到害怕。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:22:57",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:24:53",
            "content": "先生が怒ったとき、教室ではどんな感じなのでしょうか？",
            "Chinese": "老师发脾气的时候，教室里的气氛是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:25:07",
            "content": "静まりますね。",
            "Chinese": "会一下子安静下来。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:25:23",
            "content": "何も言えないです",
            "Chinese": "大家都不敢说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:25:33",
            "content": "そうですよね・・・",
            "Chinese": "确实是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:26:44",
            "content": "そのあとはどんな感じですか？",
            "Chinese": "那之后又是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:27:05",
            "content": "怖くてあまり覚えてないです",
            "Chinese": "因为太害怕了，所以记得不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:28:04",
            "content": "そうなんですね・・・記憶が無くなるくらい怖い思いをしているんですね。",
            "Chinese": "原来如此……您害怕到连记忆都模糊了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:28:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:28:58",
            "content": "怒った後は授業を続ける感じでしょうか？",
            "Chinese": "他发完脾气之后，会继续上课吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:29:09",
            "content": "そうですね",
            "Chinese": "会的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:32:14",
            "content": "なるほど・・・先生が怒鳴ったりした後に授業を再開することについてはどのように感じていますか？",
            "Chinese": "我明白了...对于老师大吼大叫之后又重新开始上课这件事，您有什么感受？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:32:47",
            "content": "嵐が去った後の静けさを感じます",
            "Chinese": "感觉就像暴风雨过后的宁静。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:34:37",
            "content": "そうなんですねその嵐も15分おきでは落ち着かない感じなのではないでしょうか？",
            "Chinese": "是这样啊。不过如果那场“暴风雨”每15分钟就来一次，恐怕就很难平静下来了吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:34:48",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:36:30",
            "content": "先生は授業を続けても、あなたの気持ちはすぐには切れ変えられないのではないかと感じましたが、いかがですか？",
            "Chinese": "我感觉即使老师继续上课，您的心情可能也无法马上转换过来，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:37:32",
            "content": "気持ちが切り替えられない、、それはあると思います",
            "Chinese": "情绪切换不过来……我觉得确实如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:38:07",
            "content": "うん、うんそうですよね",
            "Chinese": "嗯，嗯，是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:38:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:39:36",
            "content": "ここまでのお話を一度おまとめしたいと思いますので、少しお時間をいただいてもよろしいでしょうか？",
            "Chinese": "我想先把目前的内容整理一下，可以请您给我一点时间吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:39:40",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:44:12",
            "content": "週に2回授業を担当する先生が15分に1回くらいの頻度で理不尽に感じる様な怒り方をする。記憶が飛ぶくらいとても怖くて、あなたはその授業がある日は学校に行くのさえ怖く感じている。怒られた後は授業を続けられても気持ちの切り替えが出来ていないと感じている。",
            "Chinese": "一位每周上两次课的老师，大约每15分钟就会以一种让人觉得不讲理的方式发脾气。您感到非常害怕，甚至到了会记不清事情的程度，以至于在这位老师有课的日子里，您连去学校都感到恐惧。并且您觉得，即使老师发完脾气后继续上课，自己的心情也无法转换过来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:44:33",
            "content": "この内容で合っていますか？",
            "Chinese": "我总结的对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:44:42",
            "content": "そうですね、その通りです",
            "Chinese": "是的，正是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:46:49",
            "content": "この状況で今あなたが一番困っていることはどんなことですか？",
            "Chinese": "在这种情况下，您现在最困扰的是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:47:42",
            "content": "理不尽な怒り方をする先生をどうにかしてほしいです",
            "Chinese": "我希望能解决那位老师无理发脾气的问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:49:20",
            "content": "そうですよね。そう思うのは当然なことだと思いますよ。",
            "Chinese": "是啊。您会这么想是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:49:27",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:49:35",
            "content": "どうしたら良いですか？",
            "Chinese": "我该怎么办才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:49:50",
            "content": "一緒に考えてみましょうね。",
            "Chinese": "我们一起想办法吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:49:57",
            "content": "お願いします",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:52:53",
            "content": "今のあなたならどんなことが出来そうですか？",
            "Chinese": "以您现在的情况，您觉得可以做些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:53:16",
            "content": "どうだろう、、何が出来るかな、、",
            "Chinese": "这个嘛……我能做些什么呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:54:07",
            "content": "例えば、誰かに相談してみるとかは難しそうでしょうか？",
            "Chinese": "比如说，找人商量一下，会很难吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:55:06",
            "content": "誰がいるかなあ、、",
            "Chinese": "能找谁呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:55:36",
            "content": "ちなみに、その怒る先生は担任ですか？",
            "Chinese": "顺便问一下，那位会发火的老师是您的班主任吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:55:51",
            "content": "担任ではないですが",
            "Chinese": "不是班主任，"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:56:11",
            "content": "同じ学年で別クラスの担任です",
            "Chinese": "是同年级另一班的班主任。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:56:56",
            "content": "そうなんですね・・・では、あなたの担任の先生に話すのはできそうでしょうか？",
            "Chinese": "这样啊……那么，和您自己的班主任谈谈，可行吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:57:27",
            "content": "今思ったのですが両親に相談しようと思いました",
            "Chinese": "我刚想到，想去和父母商量一下。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/09(金) 21:58:44",
            "content": "それはいいですね。ご両親があなたの気持ちを一番理解してくれるかもしれませんね。",
            "Chinese": "这个主意很好。您的父母或许最能理解您的感受。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:59:00",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/09(金) 21:59:13",
            "content": "もしダメなら担任に相談します",
            "Chinese": "如果不行的话，我再和班主任商量。"
        },
        {
