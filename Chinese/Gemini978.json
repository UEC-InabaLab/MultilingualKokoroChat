{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 09:52:08",
            "content": "本日は、よろしくお願いいたします。",
            "Chinese": "今天就拜托您了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 09:56:19",
            "content": "よろしくお願い致します！",
            "Chinese": "拜托您了！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 09:57:04",
            "content": "もし、よろしければ、お時間少し前ですが、始めさせていただけたら、と思うのですが、いかかでしょうか。",
            "Chinese": "如果您不介意的话，虽然比预定时间早了一点，但我想我们可以现在开始，您觉得怎么样？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:00:36",
            "content": "お時間になりましたので、始めさせて頂いてもよろしいでしょうか。",
            "Chinese": "时间到了，请问我们可以开始了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:00:58",
            "content": "はい、大丈夫です！",
            "Chinese": "好的，没问题！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:01:45",
            "content": "こんにちは、相談員です。本日は、相談にきてくださり、あらがとうございます。",
            "Chinese": "您好，我是咨询师。非常感谢您今天前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:01:54",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:01:58",
            "content": "本日は、どのようなご相談でしょうか。",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:02:28",
            "content": "子どもが不登校で",
            "Chinese": "孩子不去上学了……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:02:48",
            "content": "それは、ご心配ですね…",
            "Chinese": "那一定很让您担心吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:02:54",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:03:24",
            "content": "いつ頃から、登校されていないのですか。",
            "Chinese": "大概是从什么时候开始没去上学的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:04:56",
            "content": "１ヶ月前くらいからです…",
            "Chinese": "大概一个月前开始的……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:05:10",
            "content": "そうなのですね…",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:05:14",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:05:59",
            "content": "よろしければ、お子さんの不登校の経緯などを聞かせていただけますか。",
            "Chinese": "如果您方便的话，能请您谈谈孩子不去上学的具体情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:07:12",
            "content": "はい、",
            "Chinese": "好的，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:07:42",
            "content": "元気がなくて",
            "Chinese": "没什么精神，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:07:50",
            "content": "急に１ヶ月くらい前から",
            "Chinese": "大约一个月前突然开始的，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:07:58",
            "content": "でも聞いても教えてくれないんです",
            "Chinese": "可是问他也不肯说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:08:11",
            "content": "そうだったのですか…急に…",
            "Chinese": "是这样啊……突然之间……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:08:17",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:09:07",
            "content": "理由がわからないと、余計にどうしたらよいか、わからないですよね…",
            "Chinese": "不知道原因的话，就更不知道该怎么办了，是吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:09:16",
            "content": "そうなんです…",
            "Chinese": "是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:09:46",
            "content": "お子さんの性別と、学年を教えていただいてもよろしいですか。",
            "Chinese": "可以请您告诉我孩子的性别和年级吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:10:03",
            "content": "男中一です",
            "Chinese": "男孩，初一。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:10:17",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:11:35",
            "content": "思春期に入るくらいのご年齢なのですね。どのようなお子さんですか。",
            "Chinese": "是快进入青春期的年纪了呢。他平时是个什么样的孩子呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:11:51",
            "content": "優しくて思いやりのあるいい子です",
            "Chinese": "他是个温柔体贴的好孩子。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:11:58",
            "content": "なんでこんな風になってしまったのか…",
            "Chinese": "怎么会变成这样了呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:13:15",
            "content": "とてもいい子のお子さんが…。やるせないお気持ちですよね…。",
            "Chinese": "这么好的孩子竟然会这样……您的心情一定很无奈、很难受吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:13:21",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:14:48",
            "content": "このことを、どなたかに相談されましたか。",
            "Chinese": "这件事，您有和其他人商量过吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:15:00",
            "content": "いいえ、してないです",
            "Chinese": "没有，没跟别人说过。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:15:05",
            "content": "あぁ、でも夫には",
            "Chinese": "啊，不过，和我丈夫说过了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:15:12",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:15:33",
            "content": "夫さんは、どのようにおっしゃっていますか。",
            "Chinese": "您丈夫是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:15:49",
            "content": "そんなに気にしなくていいのではないかと",
            "Chinese": "他说不用太担心，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:15:55",
            "content": "色々あるんだよきっとと",
            "Chinese": "说这个年纪的孩子，肯定会遇到各种各样的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:16:26",
            "content": "そうなのですね…。夫さんは、おおらかに構えていらっしゃるようなのですね。",
            "Chinese": "是这样啊……看来您丈夫心态比较坦然呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:16:49",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:17:52",
            "content": "あなたは、夫さんのそのような意見について、どんなふうにお感じなのですか。",
            "Chinese": "那对于您丈夫的这种看法，您自己是怎么感觉的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:18:36",
            "content": "うーん",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:18:41",
            "content": "言ってることは分かるんですけど",
            "Chinese": "我明白他说的道理，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:18:48",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:19:13",
            "content": "そうは言っても",
            "Chinese": "话虽如此……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:19:19",
            "content": "…って感じです",
            "Chinese": "……就是这种感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:20:09",
            "content": "夫さんの意見に、もやもやした感じがあるのですね。",
            "Chinese": "您对丈夫的意见，感觉心里有些矛盾和烦闷，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:20:37",
            "content": "ええ、でも言ってることは理解できます",
            "Chinese": "是的，但我能理解他说的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:20:45",
            "content": "し、そうだなぁとも思います",
            "Chinese": "也觉得他说得有道理。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:21:03",
            "content": "ああ、そうなのですね。",
            "Chinese": "啊，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:21:38",
            "content": "お子さんを信頼していらっしゃるお気持ちが伝わってきます。",
            "Chinese": "我能感受到您对孩子的信任。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:21:44",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:22:37",
            "content": "家でのお子さんとの関りは、どんな感じでいらっしゃるのですか。",
            "Chinese": "在家里，您和孩子的互动是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:23:07",
            "content": "ご飯の時は部屋から出てきます",
            "Chinese": "吃饭的时候他会从房间里出来。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:23:21",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:23:38",
            "content": "それ以外は…",
            "Chinese": "那除此之外呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:23:58",
            "content": "それ以外は部屋ですね。。",
            "Chinese": "其他时间都待在房间里……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:25:13",
            "content": "それは、少し、寂しく不安になりますよね…",
            "Chinese": "那确实会让人有些寂寞和不安呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:25:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:25:49",
            "content": "あなたとお子さんとの関係は、どのような感じなのですか。",
            "Chinese": "您和您孩子的关系平时是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:26:01",
            "content": "仲は悪くないです",
            "Chinese": "关系不差。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:26:14",
            "content": "でももう何を話したらいいかわからなくて",
            "Chinese": "但现在已经不知道该和他说些什么了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:26:51",
            "content": "よい関係だけれど、かける言葉がみつからない…",
            "Chinese": "虽然关系不错，但却找不到可以说的话了……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:26:57",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:29:05",
            "content": "家の中で、あなたお一人がお子さんのことについて悩んでいらっしゃるようで、おつらいですよね…",
            "Chinese": "感觉在家里，似乎只有您一个人在为孩子的事烦恼，一定很辛苦吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:29:31",
            "content": "そうなんです",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:29:53",
            "content": "お子さんも、お話してくれないので、どうしてあげることもできず…",
            "Chinese": "孩子也不愿意开口，您也感觉无能为力……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:29:57",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:31:00",
            "content": "お子さんの学校からは、何かお話などありますか。",
            "Chinese": "学校那边，有没有和您沟通或反馈什么情况呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:31:09",
            "content": "いえ、まだ何も",
            "Chinese": "没有，还没有任何联络。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:31:18",
            "content": "電話がかかってくるくらいで",
            "Chinese": "只是会打个电话来而已。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:31:30",
            "content": "学校もコロナでバタバタしているようで",
            "Chinese": "学校好像也因为疫情忙得不可开交。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:31:48",
            "content": "そうなのですね…",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:32:27",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:32:53",
            "content": "お子さんは、そのバタバタの中で、過ごしていたのですね。",
            "Chinese": "孩子也是在那种忙乱的环境中学习生活的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:33:17",
            "content": "そうなんでしょうか、、それも分からなくて…",
            "Chinese": "是这样吗……这个我也不清楚……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:34:21",
            "content": "お子さんが学校に行けていないのは、大きなことなのに、しっかり学校に関わってもらえず、悔しいお気持ちですよね…",
            "Chinese": "孩子不去上学是件大事，学校却没有给予足够的重视，您一定觉得很懊恼和不甘吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:34:50",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:35:07",
            "content": "学校も大変なのは分かるんですけどね…",
            "Chinese": "我也理解学校很不容易，不过……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:35:24",
            "content": "そうですよね…",
            "Chinese": "是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:36:38",
            "content": "いろいろ、お子さんを取り巻く状況などを今まで聞かせていただいていたのですが、あなたにとって今、一番おつらいことは、何か聞かせていただいてもよろしいですか。",
            "Chinese": "刚才听您讲了许多关于孩子的情况，能否请您说说，目前对您来说最痛苦的是什么？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:37:38",
            "content": "子どもが心配です",
            "Chinese": "我担心孩子。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:37:48",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:37:55",
            "content": "それだけです",
            "Chinese": "就只有这个。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:38:04",
            "content": "何も話してくれないから…",
            "Chinese": "因为他什么都不肯说……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:38:17",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:40:10",
            "content": "ほんとに、ご心配ですよね…ちなみに、お子さんは、お父さんには色々お話したりしているようですか。",
            "Chinese": "真的很让您担心呢……顺便问一下，孩子会和爸爸多聊一些吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:40:24",
            "content": "いえ、夫にも分からないようです",
            "Chinese": "不，我丈夫好像也不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:40:53",
            "content": "ご家族の誰にもお話ししてくれていないのですね…",
            "Chinese": "就是说，他对家里任何一个人都没有开口是吗……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:40:58",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:42:53",
            "content": "今までのお話を、少し、振りかえらせていただいてもよろしいでしょうか。",
            "Chinese": "我可以稍微总结一下我们刚才谈话的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:42:58",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:44:02",
            "content": "優しくて思いやりのあったお子さんが、一か月くらい前から、学校に行かなくなってしまってらっしゃる。",
            "Chinese": "您那个曾经温柔体贴的孩子，从大约一个月前开始，就不去上学了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:44:59",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:45:22",
            "content": "急に元気がなくなり、その原因を、ご家族の誰にもお話してくれておらず、ごはんの時以外は、お部屋で過ごしていらっしゃる。",
            "Chinese": "他突然变得没有精神，原因也没有告诉任何家人，除了吃饭时间以外，都待在自己的房间里。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:45:29",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:46:50",
            "content": "学校も、バタバタの中、電話で連絡をくれるくらい。何も話してくれず、お子さんのことが心配でいらっしゃる。",
            "Chinese": "学校方面也很忙乱，只是打电话联络一下。而孩子什么都不说，您因此非常担心他。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:46:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:47:15",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:47:57",
            "content": "お子さんが、学校に行かなくなって、一か月の時ががたってしまい、",
            "Chinese": "您的孩子不去上学已经一个月了，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:48:01",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:48:30",
            "content": "原因もわからずのこの状態のままでは、あなたの不安も大きくなる一方だと思います。",
            "Chinese": "如果这种原因不明的状态持续下去，我想您的不安只会越来越大。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:48:40",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:49:35",
            "content": "そんな中、お子さんを信頼する気持ちを強く持って、お子さんとの仲を良好な状態で過ごしてこられたのは、本当に、素晴らしいと思います。",
            "Chinese": "在这样的情况下，您还能坚定地信任孩子，并与他维持着良好的关系，这真的很了不起。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:49:46",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:50:14",
            "content": "今までの、お子さんとの良い関係があってこその、夫さんのご意見もあるのだと思います。",
            "Chinese": "我想，也正因为您至今和孩子一直保持着良好的关系，您的丈夫才会有那样的看法。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:50:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:50:47",
            "content": "そこで、一つ提案をさせていただきたいのですが、お話させていただいても、よろしいでしょうか。",
            "Chinese": "因此，我想向您提一个建议，可以和您说一下吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:50:51",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:52:26",
            "content": "やはり、あなたがご心配されているように、何がお子さんを学校に行けなくさせているのかを、",
            "Chinese": "我觉得，正如您所担心的那样，究竟是什么让您的孩子无法去上学，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:52:34",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:53:32",
            "content": "理解していくことも、必要になっているのではないかと感じました。",
            "Chinese": "去了解清楚这件事，现在或许是必要的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:53:44",
            "content": "どういうことですか？",
            "Chinese": "您指的是什么意思？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:54:27",
            "content": "それは、お子さんの口からは、言いにくいことかもしれませんので、やはり、学校に、何があったのか、お聞きして言ってもいいのではないかと。",
            "Chinese": "这件事可能您的孩子不方便说出口，所以，或许可以去问问学校，到底发生了什么事。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:55:01",
            "content": "そうですね、先生も分からないと言ってて…",
            "Chinese": "是啊，可是老师也说他不知道……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:55:07",
            "content": "それ以来って感じです",
            "Chinese": "从那以后就没什么下文了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:55:18",
            "content": "そうだったのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:55:38",
            "content": "ええ、電話で一応言ってみたものの",
            "Chinese": "嗯，我在电话里姑且是问了一下，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:55:44",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:55:48",
            "content": "そこからバタバタしてって感じでした",
            "Chinese": "之后他们就好像很忙的样子。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:55:51",
            "content": "連絡なく",
            "Chinese": "也没有再联系我。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:56:07",
            "content": "そうでしたか…",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:58:17",
            "content": "それでは、お子さんが、お話ししてくれるのを少し待ってみてもよいのかも、しれません。",
            "Chinese": "那么，也许可以再稍微等等看，等孩子自己愿意开口。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:59:12",
            "content": "あぁ",
            "Chinese": "啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 10:59:21",
            "content": "このコロナでバタバタしている中、優しくて思いやりのあるお子さんでしたら、気づかないうちに、さまざまなストレスが心に積もって疲れてしまっているのかもしれません。",
            "Chinese": "在疫情带来的这种混乱中，像您孩子这样温柔体贴的孩子，可能在不知不觉中，心里积攒了各种各样的压力，已经感到非常疲惫了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 10:59:30",
            "content": "あぁ、そうですね",
            "Chinese": "啊，确实如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 11:00:57",
            "content": "大人でも、かなりのストレスから、疲労がたまってくる今の時期、お子さんももしかしたら、ずいぶんと疲れてしまっているのかもしれません。",
            "Chinese": "现在这个时期，连大人都会因为巨大的压力而感到疲惫，您的孩子或许也已经相当累了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 11:01:09",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 11:02:17",
            "content": "なるべく、今までの生活リズムを崩さないようにして、ご夫婦で、お子さんのお気持ちを受けとめてあげられる雰囲気をつくってみられてはいかかでしょうか。",
            "Chinese": "尽量不要打乱以往的生活节奏，由您和丈夫一起，试着营造一种能够接纳孩子心情的家庭氛围，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 11:02:37",
            "content": "どんな風にすればいいですか？",
            "Chinese": "具体该怎么做呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 11:03:48",
            "content": "お子さんの興味をもっていることについて話をする、一緒に近所をフォーキングする、テレビを見て笑うなど、",
            "Chinese": "比如聊一聊孩子感兴趣的事情，一起在附近散散步，或者看看电视一起开怀大笑等等。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 11:04:03",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 11:04:09",
            "content": "なるほどですね",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 11:04:31",
            "content": "ぜひ、やってみてください。",
            "Chinese": "请一定要试试看。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 11:04:49",
            "content": "ええ",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 11:05:02",
            "content": "お子さんが、元気になられること、願っています。",
            "Chinese": "祝愿您的孩子能早日恢复元气。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 11:05:22",
            "content": "お時間が過ぎてしまいました。",
            "Chinese": "时间已经超过了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 11:05:45",
            "content": "今日のご相談は、いかかだったでしょうか。",
            "Chinese": "今天的咨询，您感觉怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 11:05:55",
            "content": "はい、",
            "Chinese": "好的，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 11:05:58",
            "content": "ありがとうございました。、",
            "Chinese": "非常感谢您。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 11:06:00",
            "content": "やってみます",
            "Chinese": "我会试试的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 11:07:21",
            "content": "ありがとうございます。ご不安に思うことがまだまだおありかと思います。いつでもまたご相談ください。",
            "Chinese": "谢谢您。我想您可能还有许多不安之处，随时都可以再来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 11:07:42",
            "content": "ええ",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 11:07:47",
            "content": "それでは、これで、本日のご相談を終了させていただきます。",
            "Chinese": "那么，今天的咨询就到此结束。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/21(月) 11:07:52",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/21(月) 11:08:10",
