{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:24:12",
            "content": "テストですこんにちは本日はよろしくお願いいたします。",
            "Chinese": "这是测试。您好，今天请多多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:26:33",
            "content": "時間になりましたら始めさせていただきます",
            "Chinese": "时间到了，我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:30:40",
            "content": "こんにちわ",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:30:54",
            "content": "こんにちは相談員です",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:31:08",
            "content": "よろしくお願いします",
            "Chinese": "请多多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:31:32",
            "content": "はじめにどうお呼びさせていただければいいですか？",
            "Chinese": "首先，我该怎么称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:31:49",
            "content": "みくと申します",
            "Chinese": "我叫Miku。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:32:11",
            "content": "みくさんですねよろしくお願します",
            "Chinese": "是Miku女士吧，请多多指教。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:32:24",
            "content": "よろしくお願いします",
            "Chinese": "请多多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:32:41",
            "content": "本日はどのようなご相談ですか？",
            "Chinese": "今天您想咨询什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:32:56",
            "content": "来週手術なんです",
            "Chinese": "我下周要做手术。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:33:12",
            "content": "それはとてもふあんですね",
            "Chinese": "那一定很不安吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:33:26",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:34:06",
            "content": "どのような手術か詳しく教えていただいてもいいですか？",
            "Chinese": "可以请您详细说说是什么手术吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:34:16",
            "content": "癌です",
            "Chinese": "是癌症。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:34:35",
            "content": "それは怖いですね",
            "Chinese": "那一定很害怕吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:34:43",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:34:46",
            "content": "すごく",
            "Chinese": "非常害怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:35:13",
            "content": "怖くて不安ですよね",
            "Chinese": "是啊，又害怕又不安吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:35:21",
            "content": "とても",
            "Chinese": "非常。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:36:03",
            "content": "今はどのような状況なのですか？",
            "Chinese": "您现在是怎样的状况呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:36:36",
            "content": "不安と恐怖でMAXです",
            "Chinese": "我的不安和恐惧已经到极点了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:37:13",
            "content": "先が見えなくて辛いですよね",
            "Chinese": "看不到未来，一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:37:33",
            "content": "死を覚悟しなきゃないです",
            "Chinese": "我必须做好死亡的准备。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:38:13",
            "content": "それは目の前が真っ暗な感じですよね",
            "Chinese": "那种感觉就像是眼前一片漆黑吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:38:42",
            "content": "すごく深い暗闇です",
            "Chinese": "是非常深的黑暗。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:39:26",
            "content": "それはどうしたらいいかわからないですよね",
            "Chinese": "那一定很不知所措吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:39:39",
            "content": "どうしたらいいですか？",
            "Chinese": "我该怎么办呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:40:25",
            "content": "周りに今のようなお話を出来る方はいらっしゃいますか？",
            "Chinese": "您身边有没有可以像现在这样倾诉的人呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:41:05",
            "content": "いません、気をつかわせるので",
            "Chinese": "没有，怕让他们费心。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:41:43",
            "content": "自分自身話したくありません",
            "Chinese": "我自己也不想说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:42:16",
            "content": "自分のつらいはなしですからね",
            "Chinese": "是啊，毕竟是自己痛苦的经历。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:42:52",
            "content": "その中でもよくご相談くださいました",
            "Chinese": "在这样的情况下，您还能来咨询，真的不容易。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:43:02",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:43:29",
            "content": "とても勇気のいる行動だっと思いますがどうでしょうか？",
            "Chinese": "我觉得这需要很大的勇气，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:43:56",
            "content": "そうですか？",
            "Chinese": "是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:44:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:44:49",
            "content": "今は入院されているのですか？",
            "Chinese": "您现在住院了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:45:05",
            "content": "来週からです",
            "Chinese": "从下周开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:45:33",
            "content": "自宅で療養中なのですね",
            "Chinese": "也就是说您现在在家休养，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:45:50",
            "content": "手術が怖いのと、転移してたら・・・・",
            "Chinese": "我很怕手术，也怕万一已经转移了……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:46:02",
            "content": "不安と恐怖です",
            "Chinese": "就是不安和恐惧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:46:20",
            "content": "じっとしてられません",
            "Chinese": "我完全静不下来。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:46:21",
            "content": "自宅にいるとそう考えますよね",
            "Chinese": "一个人待在家里，确实会胡思乱想呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:46:57",
            "content": "外に出る気にはなれません",
            "Chinese": "我一点也不想出门。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:47:06",
            "content": "人と会う気にもなれません",
            "Chinese": "也不想见人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:47:23",
            "content": "病気についてお医者さんはどのように説明されているのですか？",
            "Chinese": "关于病情，医生是怎么跟您说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:47:23",
            "content": "ご飯も食べれません",
            "Chinese": "我连饭都吃不下。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:47:53",
            "content": "手術して腫瘍を取り切れるか・・・",
            "Chinese": "不知道手术能不能把肿瘤切除干净……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:48:02",
            "content": "頑張るって言ってました",
            "Chinese": "医生说会尽全力。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:48:10",
            "content": "余命は、わからないと",
            "Chinese": "至于还能活多久，他说不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:48:36",
            "content": "そういわれると余計に不安になりますよね",
            "Chinese": "听到这样的话，会更加不安吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:48:48",
            "content": "私まだ33才です",
            "Chinese": "我才33岁。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:48:58",
            "content": "まだまだ生きたい",
            "Chinese": "我还想好好活下去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:49:28",
            "content": "生きたいですよね",
            "Chinese": "是啊，您很想活下去。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:50:06",
            "content": "生きたい",
            "Chinese": "我想活下去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:50:43",
            "content": "とても生きたいですよね",
            "Chinese": "您非常想活下去，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:51:07",
            "content": "とても生きたい",
            "Chinese": "我非常想活下去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:51:20",
            "content": "手術が成功したらどうしたいですか？",
            "Chinese": "如果手术成功了，您想做什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:52:08",
            "content": "普通に生活していきたいです普通に生きていきたい",
            "Chinese": "我想过普通的生活，想普普通通地活下去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:53:11",
            "content": "普通に生きて生活することに希望をもたれているんですね？",
            "Chinese": "您对普普通通地活着这件事，抱有希望是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:53:57",
            "content": "普通でいいのです、希望と言うか、普通がいいです",
            "Chinese": "普通就好，与其说是希望，不如说我只想要普通的生活。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:54:11",
            "content": "みくさんにとって普通の生活とはどういったことでしょうか？",
            "Chinese": "对Miku女士您来说，普通的生活是指什么样的生活呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:55:49",
            "content": "3食ご飯たべて、普通に生活できればいいです",
            "Chinese": "一日三餐都能好好吃饭，能正常生活就好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:56:18",
            "content": "今は不安で食べれないですものね",
            "Chinese": "是啊，现在因为不安都吃不下饭。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:56:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:56:57",
            "content": "３食食べれるのが嬉しいですよね",
            "Chinese": "能吃上一日三餐，是件很幸福的事呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:57:06",
            "content": "はい、いいですね",
            "Chinese": "是啊，真好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:57:29",
            "content": "どういった物を食べたいですか？",
            "Chinese": "您想吃点什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:57:46",
            "content": "白米が一番です",
            "Chinese": "最想吃白米饭。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:57:52",
            "content": "お味噌汁と",
            "Chinese": "再配上味噌汤。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:58:08",
            "content": "和食ですやね",
            "Chinese": "是日式料理呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:58:32",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:58:39",
            "content": "心が暖まって美味しいですよね",
            "Chinese": "暖心又美味呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:58:55",
            "content": "いいですね",
            "Chinese": "是啊，真好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 12:58:59",
            "content": "何か思い出がありますか？",
            "Chinese": "是有什么回忆吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:59:03",
            "content": "涙出てきました",
            "Chinese": "我流眼泪了。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 12:59:20",
            "content": "思い出は特にないです",
            "Chinese": "倒也没有什么特别的回忆。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:00:06",
            "content": "白米とお味噌汁で感動されているのですね",
            "Chinese": "仅仅是白米饭和味噌汤就让您很感动呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:00:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:00:49",
            "content": "そんな普通の生活を続けたいです",
            "Chinese": "我想继续过这种普通的生活。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:00:55",
            "content": "ずーーっと",
            "Chinese": "一直一直。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:01:11",
            "content": "まだまだこれからですものね",
            "Chinese": "是啊，未来还很长呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:01:22",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:02:10",
            "content": "食べる以外にはありますか？普通にやりたいことが",
            "Chinese": "除了吃东西以外，还有什么想做的普通事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:02:34",
            "content": "散歩ですかね",
            "Chinese": "可能是散步吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:02:44",
            "content": "いいですね",
            "Chinese": "那很不错呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:03:05",
            "content": "どのようなところを散歩されますか？",
            "Chinese": "您想去什么样的地方散步呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:03:15",
            "content": "家の周りです",
            "Chinese": "就在家附近。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:03:21",
            "content": "近所です",
            "Chinese": "在附近。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:03:50",
            "content": "近所はいつも散歩されているのですか？",
            "Chinese": "您平时常在家附近散步吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:04:15",
            "content": "いいえ、ないです。これからやりたいです。",
            "Chinese": "不，没有。今后想去做。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:04:54",
            "content": "そうなんですね。やりたいことがおありなんですね？",
            "Chinese": "这样啊。您是有想做的事情了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:05:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:05:42",
            "content": "ずっと考えておられたんですか？",
            "Chinese": "您是一直都这么想的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:06:01",
            "content": "病気なってからです",
            "Chinese": "是生病之后才开始想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:06:45",
            "content": "病気になって良くなった何をしようか？と考えておられたのですね",
            "Chinese": "您是在想，等病好了要做些什么，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:07:16",
            "content": "普通に生活したいとおもってるだけです",
            "Chinese": "我只是想过普通的生活而已。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:07:50",
            "content": "みくさんにとっての普通は",
            "Chinese": "对Miku女士您来说，“普通”就是——"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:08:23",
            "content": "３食白米とみそ汁を食べて",
            "Chinese": "一天三餐吃白米饭和味噌汤，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:08:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:08:43",
            "content": "近所を散歩をして",
            "Chinese": "在家附近散散步，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:08:55",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:08:58",
            "content": "ずーっと生きていたい",
            "Chinese": "一直活下去，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:09:15",
            "content": "ということですね？",
            "Chinese": "是这样吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:09:28",
            "content": "はい、そんなかんじです",
            "Chinese": "嗯，差不多是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:10:18",
            "content": "今までのことをまとめさせていただいてもいいですか？",
            "Chinese": "我可以为您总结一下我们目前谈话的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:10:23",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:10:53",
            "content": "来週癌の手術があり",
            "Chinese": "您下周要做癌症手术，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:11:33",
            "content": "とても不安でつらい。さきが見えない。",
            "Chinese": "感到非常不安和痛苦，看不见未来。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:11:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:12:15",
            "content": "自宅にいるが外に出たくなく誰にも会いたくない",
            "Chinese": "虽然待在家里，但不想出门，也不想见任何人。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:12:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:12:49",
            "content": "それでも生きたい、生きて普通の生活を",
            "Chinese": "即使如此，您还是想活下去，想过普通的生活。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:13:24",
            "content": "３食食べて散歩をする普通の",
            "Chinese": "一日三餐，出门散步，这样普通的生活。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:13:45",
            "content": "生活をしたいと考えている",
            "Chinese": "您是这么想的，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:13:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:13:56",
            "content": "そうです",
            "Chinese": "没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:14:35",
            "content": "ここまで話をされてどのように感じておられますか？",
            "Chinese": "谈到这里，您现在感觉怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:15:32",
            "content": "そのとおりです。聞いてくださり有難うございます。",
            "Chinese": "您说的完全正确。谢谢您听我倾诉。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:16:38",
            "content": "話をされたことで気持ちが楽になりましたか？",
            "Chinese": "说出来之后，心情有没有轻松一点？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:16:56",
            "content": "はい、有難うございます",
            "Chinese": "有的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:17:53",
            "content": "生きることをとても強く思われている、みくさんは",
            "Chinese": "Miku女士，您有着非常强烈的求生欲，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:18:44",
            "content": "きっと希望している普通の生活を迎えれる",
            "Chinese": "我相信您一定能迎来所期望的普通生活，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:19:26",
            "content": "準備が出来ているのだと思いますので、",
            "Chinese": "我觉得您已经做好了准备，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:20:08",
            "content": "手術までは不安でしょうが、やってみたいことを思い浮かべながら",
            "Chinese": "在手术前虽然会很不安，但您可以一边想着那些想做的事情，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:20:52",
            "content": "乗り切ってもらえたらと思いますがいかがでしょうか？",
            "Chinese": "希望您能就这样撑过去，您觉得如何？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:21:22",
            "content": "はい、そうしたいと思います",
            "Chinese": "好的，我想那样做。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/11(土) 13:21:40",
            "content": "話を聞いていただき有難うございます",
            "Chinese": "谢谢您听我说了这么多。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/11(土) 13:22:19",
            "content": "はい。こちらこそご一緒できて良かったです。",
