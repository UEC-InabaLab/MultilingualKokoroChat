{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 18:54:21",
            "content": "（こんばんは、本日はよろしくお願いいたします。）",
            "Chinese": "（晚上好，今天请多多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 18:54:48",
            "content": "（こんばんはこちらこそ宜しくお願い致します）",
            "Chinese": "（晚上好，也请您多多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 18:57:05",
            "content": "（リクエストなのですが、中学、高校生あたりの方のお悩みでお願いできたらありがたいのですが、いかがでしょうか？）",
            "Chinese": "（我有个小请求，如果可以的话，希望能以初中生或高中生的烦恼为主题，您觉得怎么样？）"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 18:58:37",
            "content": "（中学・高校生って事ですかね）",
            "Chinese": "（是说初中生或高中生，对吧？）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 18:59:07",
            "content": "（はい、そうです）",
            "Chinese": "（是的，没错。）"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 18:59:28",
            "content": "（わかりました）",
            "Chinese": "（好的，明白了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:00:00",
            "content": "（ありがとうございます、よろしくおねがいいたします。）",
            "Chinese": "（谢谢您，那就拜托您了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:00:29",
            "content": "こんばんは、相談員です。よろしくお願いいたします。",
            "Chinese": "晚上好，我是咨询师。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:00:41",
            "content": "こんばんは",
            "Chinese": "晚上好。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:00:59",
            "content": "宜しくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:01:00",
            "content": "始めに、性別、年齢、相談内容を教えてください。",
            "Chinese": "首先，请告诉我您的性别、年龄和咨询内容。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:02:42",
            "content": "15歳　女性　学校に行きたないんです",
            "Chinese": "15岁，女性，我不太想去上学。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:03:04",
            "content": "お返事ありがとうございます。",
            "Chinese": "谢谢你的回复。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:03:29",
            "content": "学校のことで悩んでいるんですね。",
            "Chinese": "你正在为学校的事情烦恼呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:03:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:04:07",
            "content": "どんなことがあったのかな？",
            "Chinese": "发生了什么事呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:04:50",
            "content": "話せるところからで、大丈夫ですよ。",
            "Chinese": "从你方便说的地方开始就可以，没关系的。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:05:10",
            "content": "はい特に何も無いけど学校がつまらないし高校受験とか不安だし",
            "Chinese": "嗯，其实没什么特别的，就是学校很无聊，而且对中考也很不安。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:05:34",
            "content": "うんうん、そうなんだね。",
            "Chinese": "嗯嗯，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:05:41",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:06:26",
            "content": "学校受験、、今年受験生かな？",
            "Chinese": "中考……今年是考生吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:07:33",
            "content": "中学3年生ですか？",
            "Chinese": "是初三吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:07:34",
            "content": "そう三年生になって先生とかみんな言ってるけどまだまだなのにって思うし　よくわかんないし",
            "Chinese": "是的，升上三年级之后老师和大家都在说，但我总觉得还早得很，而且也搞不太懂。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:08:01",
            "content": "うんうん、どうなんだね。",
            "Chinese": "嗯嗯，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:08:12",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:08:15",
            "content": "受験は、不安だよね。",
            "Chinese": "考试确实会让人感到不安呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:08:27",
            "content": "そー頭悪いし",
            "Chinese": "是啊，而且我脑子又不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:08:59",
            "content": "そう、自分で感じてしまっているんですね。",
            "Chinese": "这样啊，你自己是这么觉得的呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:09:12",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:09:18",
            "content": "勉強は、苦手？",
            "Chinese": "学习方面比较吃力吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:09:52",
            "content": "うん面白くないしテストとかダルいし",
            "Chinese": "嗯，很没意思，考试之类的也很烦人。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:10:31",
            "content": "なるほど、テストがだるいんだね。",
            "Chinese": "原来如此，觉得考试很烦人是吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:10:40",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:11:18",
            "content": "学校がつまらないと言ってたけど、主に勉強が嫌でつまらない感じですか？",
            "Chinese": "你说学校无聊，主要是因为不喜欢学习所以觉得无聊吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:12:12",
            "content": "そうかな…",
            "Chinese": "可能是吧……"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:12:40",
            "content": "友達とかもまだ出来でないし",
            "Chinese": "而且也还没交到朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:13:00",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:13:20",
            "content": "まだ、クラス替えしてまもないのかな？",
            "Chinese": "是刚分班不久吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:14:11",
            "content": "そう三年生になって１ヶ月くらいだけど周りはグループできちゃったけど　なんか馴染めなくて",
            "Chinese": "是的，升上三年级大概一个月了，周围的同学都已经形成小团体了，但我总觉得融入不进去。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:14:51",
            "content": "そっか、そっか、、そうすると学校がつまらないよね。",
            "Chinese": "这样啊，这样啊……那确实会觉得学校很无聊呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:14:57",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:15:37",
            "content": "うんうん、お昼ご飯とかはどうしてるの？",
            "Chinese": "嗯嗯，那午饭是怎么解决的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:16:05",
            "content": "お昼ご飯は自分の席で食べてる",
            "Chinese": "午饭在自己的座位上吃。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:16:40",
            "content": "そうなんだね、もしかして一人で食べているのかな？",
            "Chinese": "这样啊，是一个人吃吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:17:05",
            "content": "あーでもまだみんなも席で食べてるから",
            "Chinese": "啊，不过大家也还是在座位上吃的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:17:44",
            "content": "そうなんだね、それならまだ寂しくないかな？",
            "Chinese": "是这样啊，那也许还不会觉得寂寞？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:17:58",
            "content": "でも、お友達と食べたいよね。",
            "Chinese": "不过，还是想和朋友一起吃吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:19:17",
            "content": "あーでもコロナがあってからうちの学校は席でってなったからそお昼ご飯は大丈夫",
            "Chinese": "啊，不过因为疫情，我们学校就规定在座位上吃了，所以午饭这方面没问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:20:03",
            "content": "そっか、そっか、ちゃんとコロナ対策ができてる学校なんだね。",
            "Chinese": "这样啊，那说明是所防疫措施做得很好的学校呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:20:11",
            "content": "一応ね",
            "Chinese": "算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:20:29",
            "content": "うんうん、とっても良い学校だね。",
            "Chinese": "嗯嗯，是所挺不错的学校呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:20:49",
            "content": "まぁ…そうかな",
            "Chinese": "嘛……大概是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:21:24",
            "content": "うん、相談員はそう思いましたよ。",
            "Chinese": "嗯，我是这么觉得的哦。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:21:36",
            "content": "そうかな",
            "Chinese": "是吗。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:21:44",
            "content": "よくわかんない",
            "Chinese": "不太明白。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:22:16",
            "content": "そっか。でも、そんな学校がつまらないのは、",
            "Chinese": "这样啊。不过，觉得这样的学校很无聊，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:22:30",
            "content": "困ってしまいますよね。",
            "Chinese": "也会让人很困扰呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:22:38",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:23:01",
            "content": "明日から嫌だなー",
            "Chinese": "从明天开始又要上学，真不想去啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:23:48",
            "content": "そっか、、ゆううつなんだね。うんうん、学校での生活のことを一緒に考えていきましょうね。",
            "Chinese": "这样啊……心情很郁闷呢。嗯嗯，我们一起来想想学校生活的事情吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:23:59",
            "content": "うゆ",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:24:06",
            "content": "うん…",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:24:48",
            "content": "一緒に考えたいので、少しこちらから質問しても良いですか？",
            "Chinese": "因为想和你一起思考，我可以问你几个问题吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:24:55",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:25:06",
            "content": "ありがとうございます。",
            "Chinese": "谢谢你。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:25:51",
            "content": "一番嫌なのは、受験のこと？それともお友達がまだできていないことかな？",
            "Chinese": "最让你烦恼的，是考试的事情？还是还没交到朋友这件事呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:26:12",
            "content": "受験かな…",
            "Chinese": "应该是考试吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:26:32",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:26:58",
            "content": "受験で不安って言ってたものね。",
            "Chinese": "你说过对考试感到不安嘛。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:27:18",
            "content": "そうよくわかんないし",
            "Chinese": "是啊，我也搞不太懂。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:28:10",
            "content": "うんうん、一番不安なことって、受験についてわからないことがあるからなのかな？",
            "Chinese": "嗯嗯，最让你不安的，是不是因为对考试还有很多不清楚的地方？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:28:51",
            "content": "そうあと頭悪いから",
            "Chinese": "是的，还有就是因为我脑子笨。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:29:43",
            "content": "分からないと、不安だよね。そんなふうに感じてしまっているんだね。",
            "Chinese": "不了解的时候，确实会感到不安呢。你现在就是那样的感觉吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:29:55",
            "content": "そうそう",
            "Chinese": "对，就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:30:19",
            "content": "ちなみに、受験したい学校はあるの？",
            "Chinese": "顺便问一下，有想考的学校吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:30:36",
            "content": "特にない",
            "Chinese": "没有特别想考的。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:31:01",
            "content": "ってか受験出来るのかなって",
            "Chinese": "话说，我到底能不能参加考试啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:31:45",
            "content": "受験できるのかが疑問なんだね。",
            "Chinese": "你在怀疑自己是否能参加考试呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:32:22",
            "content": "そう先生にそんなんじゃどこも出来なくなるって言われて",
            "Chinese": "是的，老师跟我说，你再这样下去哪儿都考不上了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:33:16",
            "content": "そうだったんだ、それは先生きつい言い方だね。",
            "Chinese": "原来是这样，老师的说法是有点严厉呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:33:34",
            "content": "そう嫌になる",
            "Chinese": "是啊，真让人讨厌。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:33:58",
            "content": "そうだよね、嫌な気分になるよね。",
            "Chinese": "是啊，会让人心情不好的。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:34:12",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:34:28",
            "content": "あなたは、そんなことない！って思うよね。",
            "Chinese": "你也会想“才不是那样呢！”对吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:34:38",
            "content": "そうかな",
            "Chinese": "是吗。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:35:01",
            "content": "でも頭悪いのは確か",
            "Chinese": "但我脑子不好倒是真的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:35:27",
            "content": "そんなことないと私は思いますよ。",
            "Chinese": "我并不这么认为哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:35:41",
            "content": "誰だって",
            "Chinese": "无论是谁，"
        },
        {
            "role": "クライアント",
            "time": "2024/05/06(月) 19:35:41",
            "content": "なんで？",
            "Chinese": "为什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/06(月) 19:35:57",
            "content": "得意、不得意があるもの。",
            "Chinese": "都有擅长和不擅长的事情。"
        },
        {
            "role": "クライアント",
