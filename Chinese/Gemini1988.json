{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 12:53:17",
            "content": "(よろしくお願いいたします。クライアント役で何かリクエストありますか？)",
            "Chinese": "（请多关照。关于来访者这个角色，您有什么要求吗？）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 12:55:07",
            "content": "こんにちは相談員です。よろしくお願いいたします。",
            "Chinese": "您好，我是咨询师。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 12:55:46",
            "content": "クライエント役は、あなたのなさりたい役柄でなさっていただきたいと思います。",
            "Chinese": "关于来访者的角色，我希望您能按照自己想扮演的角色来。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 12:55:52",
            "content": "()",
            "Chinese": "（）"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 12:56:04",
            "content": "(了解です）",
            "Chinese": "（明白了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 12:56:30",
            "content": "ありがとうございます。よろしくお願いいたします。",
            "Chinese": "谢谢您。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:00:03",
            "content": "最初に、想定なさったクライエントの年齢と性別を教えていただけますか？",
            "Chinese": "首先，能请您告知一下您设想的来访者的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:00:55",
            "content": "（すみません、相談の中でのやりとりでお願いします）",
            "Chinese": "（不好意思，希望能在咨询的对话中进行。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:01:12",
            "content": "了解です。ありがとうございます。",
            "Chinese": "明白了。谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:01:36",
            "content": "では、今日はどのようなご相談でしょうか？",
            "Chinese": "那么，今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:01:52",
            "content": "生きている意味がありません。",
            "Chinese": "我觉得活着没有意义。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:02:23",
            "content": "そんな風に思っていらっしゃるのですね。",
            "Chinese": "您是这样想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:02:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:03:24",
            "content": "そのように思うようになったのは何時ごろからですか？",
            "Chinese": "您大概是从什么时候开始有这种想法的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:03:52",
            "content": "ずっと思っています。毎日。",
            "Chinese": "我一直都这么想。每天都是。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:04:32",
            "content": "そうなんですね・・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:04:39",
            "content": "苦しくてたまりません。",
            "Chinese": "痛苦得受不了了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:04:49",
            "content": "生きているのが。",
            "Chinese": "活着这件事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:05:41",
            "content": "毎日、その思いでいらっしゃると・・・",
            "Chinese": "您每天都怀着这样的想法……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:06:34",
            "content": "一日一日が、一瞬一瞬が苦しいですね・・・",
            "Chinese": "每一天、每一瞬间都很痛苦，是吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:06:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:07:41",
            "content": "そんなお気持ちを抱えながら日々どのように時間を過ごしているのですか・・",
            "Chinese": "怀着这样的心情，您平时是如何度过每一天的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:08:02",
            "content": "何もできません。",
            "Chinese": "我什么都做不了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:08:23",
            "content": "ただ時間だけが過ぎていく",
            "Chinese": "只是任由时间流逝。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:08:43",
            "content": "むなしく・・・",
            "Chinese": "很空虚……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:08:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:10:19",
            "content": "深い淵の底にいるような感じでしょうか・・・",
            "Chinese": "是不是像身处深渊底部那样的感觉呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:10:38",
            "content": "もう何も考えられないです。",
            "Chinese": "已经什么都无法思考了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:11:06",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:11:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:12:07",
            "content": "何も考えられなくなってしまって、ただそこにいるということ・・・",
            "Chinese": "已经什么都无法思考，只是待在那里……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:12:34",
            "content": "いるのかもわかりません。",
            "Chinese": "我甚至不确定自己是否还存在。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:12:57",
            "content": "何もしていないので。",
            "Chinese": "因为我什么都没做。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:13:09",
            "content": "そうなんですね・・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:13:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:14:31",
            "content": "最初に、生きている意味がありませんということを仰っていましてけれど、かつては、生きているなと感じていた時もあったのでしょうか・・・",
            "Chinese": "您一开始提到“活着没有意义”，但过去是否也有过能感受到“自己正活着”的时刻呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:14:43",
            "content": "わかりません。",
            "Chinese": "我不知道。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:15:10",
            "content": "前のことはもうすべて意味がありません。",
            "Chinese": "过去的一切都已经毫无意義。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:15:25",
            "content": "今となっては。",
            "Chinese": "事到如今。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:15:53",
            "content": "そうかもしれませんね・・・",
            "Chinese": "也许是这样吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:16:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:17:01",
            "content": "昔のことは遠い過去のことですものね・・・",
            "Chinese": "过去的事情已经是遥远的往事了呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:17:07",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:17:39",
            "content": "何の意味のありません。",
            "Chinese": "没有任何意义。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:18:18",
            "content": "そうかもしれませんね・・・",
            "Chinese": "也许是这样吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:18:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:19:28",
            "content": "何もせず、時間が過ぎていくのですよね・・・",
            "Chinese": "什么也不做，任由时间流逝，是吗……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:19:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:20:48",
            "content": "ここにこうして、お話ししに来てくださっているのですが、今お話ししたいことは何でしょうか・・・",
            "Chinese": "您今天特地来到这里与我谈谈，那么现在您想谈些什么呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:21:11",
            "content": "何と言われても・・",
            "Chinese": "就算您这么问我……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:22:03",
            "content": "それがわからないから相談してみたのですが・・自分でも何をしたいのか解りません。",
            "Chinese": "正因为不知道才来咨询的……连我自己也不知道想做什么。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:22:15",
            "content": "何か聞きたいことがないとだめなのですか？",
            "Chinese": "难道没有想问的事情就不行吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:22:44",
            "content": "大丈夫です。",
            "Chinese": "没关系的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:23:33",
            "content": "こうして、生きている意味がないと聞かせていただきました。",
            "Chinese": "这样，我听您说了您觉得“活着没有意义”这件事。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:23:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:24:32",
            "content": "その思いを私も大切にさせていただきます。",
            "Chinese": "您的这份感受，我也会郑重对待。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:25:07",
            "content": "生きている意味がないことをですか？大切にとはどのようなことでしょうか？",
            "Chinese": "您是说要珍视“活着没有意义”这件事吗？所谓珍视是指什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:25:42",
            "content": "私は大切だとは思えません。",
            "Chinese": "我不觉得这值得珍视。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:26:14",
            "content": "こんな思い、なくなるものなら失くしてしまいたい。",
            "Chinese": "这种感受，如果能消失的话，我巴不得将它彻底抹去。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:26:22",
            "content": "何で大切なのでしょうか？",
            "Chinese": "为什么值得珍视呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:27:27",
            "content": "そこには、あなたの深い思いが感じられた気がしたものですから・・・",
            "Chinese": "因为我仿佛从中感受到了您内心深处的某些情感……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:27:55",
            "content": "深い思いとは？",
            "Chinese": "内心深处的感受？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:28:58",
            "content": "心の奥にあるあなたなりの思いがおありなのかと思ったのですが・・・",
            "Chinese": "我的意思是，我感觉您内心深处，或许有着一些您自己的想法……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:29:37",
            "content": "私なりの思い？よくわかりません。",
            "Chinese": "我自己的想法？我不太明白。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:30:29",
            "content": "思いでなく、事実なのです。",
            "Chinese": "这不是想法，而是事实。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:31:04",
            "content": "そうでした・・・",
            "Chinese": "确实如此……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:31:16",
            "content": "？",
            "Chinese": "？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:32:11",
            "content": "困惑しております。",
            "Chinese": "我很困惑。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:32:59",
            "content": "困惑させてしまって、ごめんなさい。",
            "Chinese": "让您感到困惑，非常抱歉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:35:15",
            "content": "こんな思い、なくなるものなら失くしてしまいたいと仰っていましたけれど・・・",
            "Chinese": "您刚才说“如果能消除这种感受，宁愿彻底摆脱它”……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:35:39",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:36:49",
            "content": "本当は、どうなりたいのかよければ話してみていただけますか・・・",
            "Chinese": "如果您愿意的话，能否谈谈您真正希望变成什么样子呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:37:33",
            "content": "思いも自分も消えて、楽になりたいです。",
            "Chinese": "我想让这些想法和自己都消失，从而获得解脱。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:39:06",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:39:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:39:59",
            "content": "楽になりたいのですね・・・",
            "Chinese": "您是想获得解脱，是吗……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:40:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:40:51",
            "content": "今が　あまりに苦しすぎますものね・・・",
            "Chinese": "因为当下实在太痛苦了，对吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:41:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:42:14",
            "content": "あなたのこのようなお気持ちを、今まで誰かに話したことはありますか？",
            "Chinese": "像这样的感受，您至今为止对谁说起过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:42:46",
            "content": "ありません",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:43:04",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:43:22",
            "content": "ご家族とかにも？",
            "Chinese": "对家人也没有吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:43:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:43:41",
            "content": "家族はいません。見捨てられましたので。",
            "Chinese": "我没有家人。因为被他们抛弃了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:44:51",
            "content": "そうでしたか。そんなことがおありだったのですね・・・",
            "Chinese": "是这样啊。原来您还经历过那样的事情……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:45:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:45:27",
            "content": "今はお一人でお暮らしでしょうか・・・",
            "Chinese": "您现在是一个人生活吗……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:45:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:47:21",
            "content": "ただお一人で、時が過ぎていくのを感じていらっしゃる・・・のですね。",
            "Chinese": "您只是独自一人，感受着时间一点点地流逝……是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:47:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/02(水) 13:49:21",
            "content": "私にはあなたの寂しさや、いろんなお気持ちが伝わってくるような気がしています・・・",
            "Chinese": "我似乎能感受到您的寂寞，以及其他各种复杂的心情……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/02(水) 13:49:56",
            "content": "気がする、ですか・・・私にとっては現実なのです。",
