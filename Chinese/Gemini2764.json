{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:30:09",
            "content": "こんにちは。相談員です。年齢、性別、相談内容を教えていただけますか。",
            "Chinese": "您好，我是咨询员。可以告诉我您的年龄、性别和咨询内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:30:42",
            "content": "18 男",
            "Chinese": "18岁，男。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:30:52",
            "content": "進路に悩んでる",
            "Chinese": "我在为前途烦恼。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:31:06",
            "content": "宜しくお願いします。",
            "Chinese": "拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:31:38",
            "content": "進路に悩んでいるんですね。",
            "Chinese": "您是在为前途烦恼啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:31:42",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:32:02",
            "content": "高校３年生ですか。",
            "Chinese": "您是高三学生吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:32:07",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:32:59",
            "content": "悩んでいるのは、就職か進学で悩んでいるんですか。",
            "Chinese": "您是在犹豫就业还是升学吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:33:31",
            "content": "親が言う方に進むか、自分の生きたい方に進むかです",
            "Chinese": "是听从父母的，还是走自己想走的路。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:33:42",
            "content": "親は進学",
            "Chinese": "父母希望我升学。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:33:59",
            "content": "自分はバイトしながら",
            "Chinese": "我想一边打工，"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:34:10",
            "content": "ダンスしたくて",
            "Chinese": "一边跳舞。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:35:02",
            "content": "そうなんですね。ダンスは長くやられているんですか。",
            "Chinese": "原来是这样。您跳舞很久了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:35:16",
            "content": "最近始めました",
            "Chinese": "最近才开始的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:36:20",
            "content": "最近始められたんですね。",
            "Chinese": "原来是最近才开始的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:36:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:36:47",
            "content": "勉強が嫌で、そっちやってみたらハマって",
            "Chinese": "因为讨厌学习，试着跳舞之后就迷上了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:37:41",
            "content": "両親にはダンスの話はされたんですか。",
            "Chinese": "您有和父母谈过跳舞的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:37:50",
            "content": "はい",
            "Chinese": "有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:38:30",
            "content": "どのように言ってらしましたか。",
            "Chinese": "他们是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:38:36",
            "content": "猛反対されています",
            "Chinese": "他们强烈反对。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:39:09",
            "content": "かたい家なんで、不良のやることだと",
            "Chinese": "因为我们家比较传统，他们觉得那是“不良少年”才做的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:40:01",
            "content": "そうなんですね。それはお辛いですね。",
            "Chinese": "这样啊。那您一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:40:08",
            "content": "昔から、自分たちの言う通りにならないと激昂するんで",
            "Chinese": "他们从小就这样，只要我不按他们说的做，就会大发雷霆。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:40:54",
            "content": "いつも全てに反対される",
            "Chinese": "我做什么他们都反对。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:41:32",
            "content": "自分が何も出来ないから悪いんだけど",
            "Chinese": "虽然也是因为我自己什么都做不好吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:41:52",
            "content": "そうですか。それはしんどいですね。",
            "Chinese": "是吗？那一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:41:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:42:36",
            "content": "両親お二人とも反対されているんでしょうか。",
            "Chinese": "父母双方都反对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:42:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:43:27",
            "content": "ご兄弟はいらっしゃいますか。",
            "Chinese": "您有兄弟姐妹吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:43:42",
            "content": "いません",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:44:50",
            "content": "そうなんですね。ダンスの話をすると猛反対されるんですね。",
            "Chinese": "这样啊。一提到跳舞就会遭到强烈反对，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:45:12",
            "content": "ダンス以外も全て基本反対されます",
            "Chinese": "不只是跳舞，基本上所有事情他们都反对。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:45:27",
            "content": "自分ADHDで、だから信用無いんだと思う",
            "Chinese": "我有ADHD，所以我觉得他们不信任我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:47:06",
            "content": "そうなんですか。今現在何か問題があることがあるんでしょうか。",
            "Chinese": "是这样吗？现在有什么具体的问题吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:48:09",
            "content": "なんでも中途半端だし、人と問題起こすし",
            "Chinese": "我做什么都半途而废，还总是和别人起冲突。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:48:16",
            "content": "問題だらけかも",
            "Chinese": "可能问题一大堆吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:49:01",
            "content": "人付き合いとかも、あまり上手く出来ないし、変なやつだと思われてる",
            "Chinese": "我也不太擅长人际交往，总被人当成怪人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:49:43",
            "content": "とてもお悩みなんですね。",
            "Chinese": "看来您真的很烦恼。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:49:56",
            "content": "聞いてもいいですか？",
            "Chinese": "我可以问个问题吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:50:30",
            "content": "はい、なんでしょうか。遠慮なくいってください。",
            "Chinese": "当然可以，请问是什么？请不要客气，尽管说。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:50:35",
            "content": "人って、何の為に生きているんですか？",
            "Chinese": "人到底是为了什么而活着呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:54:21",
            "content": "むづかしい質問ですけど、一度の人生、他人に迷惑をかけなければ好きなことをするために、生きていると自分は思います。いかがでしょうか。",
            "Chinese": "这是个很难回答的问题，但我个人认为，人生只有一次，只要不给别人添麻烦，就是为了做自己喜欢的事情而活。您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:54:58",
            "content": "迷惑をかけ無ければ…ですか。",
            "Chinese": "只要不添麻烦……是吗。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:55:36",
            "content": "自分は、迷惑をかけて生きているんですが、やっぱり親のいう事は聞いた方がいいですか？",
            "Chinese": "可我活着就是在给别人添麻烦，那我还是应该听父母的话吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:56:58",
            "content": "そうですね。親は身内なので多少の迷惑をかけることはしょうがないと思います。",
            "Chinese": "嗯……父母是家人，我觉得给他们添一点麻烦是难免的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:57:20",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 10:58:19",
            "content": "親とは何回くらい進路の話をされているんですか。",
            "Chinese": "您和父母谈过几次关于前途的事呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:58:42",
            "content": "ほぼ毎日その話になります",
            "Chinese": "几乎每天都会谈到这个话题。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:58:48",
            "content": "ウンザリしてます",
            "Chinese": "我已经厌烦透了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 10:59:32",
            "content": "いつになったら、楽しいと思う日が来ますか？",
            "Chinese": "什么时候才能迎来让我觉得快乐的日子呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:00:30",
            "content": "将来の為にって小さな頃から頑張ってきて、将来楽になる為とか言われてるけど",
            "Chinese": "从小就被教育说要为将来努力，为了将来能过得轻松一点，"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:00:46",
            "content": "その将来っていつ来ますか…？",
            "Chinese": "可那个“将来”到底什么时候才会来呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:01:41",
            "content": "そうですね。人生は山あり谷ありで、いいことも、悪いことも起こります。",
            "Chinese": "是啊。人生有起有落，有好事发生，也会有坏事发生。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:01:59",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:03:11",
            "content": "その将来を生きているはずの親をみても、全然楽しそうじゃないし、何の為に生きてるんだかわかりません",
            "Chinese": "看着本应活在那个“将来”的父母，他们看起来也一点都不快乐，我不知道人到底是为了什么而活。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:04:11",
            "content": "ただ、毎日、今を一生懸命生きることが大切だと思います。",
            "Chinese": "不过，我认为努力过好当下的每一天是很重要的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:06:14",
            "content": "アルバイトとかはしたことありますか。",
            "Chinese": "您打过工吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:06:19",
            "content": "はい",
            "Chinese": "有。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:06:26",
            "content": "夏休みとか",
            "Chinese": "暑假的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:07:04",
            "content": "そうですか。それは偉いですね。",
            "Chinese": "是吗？那很了不起啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:07:13",
            "content": "普通です",
            "Chinese": "很普通而已。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:08:19",
            "content": "一人暮らしをするとか考えた事は、ありますか。",
            "Chinese": "您有考虑过一个人生活吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:08:41",
            "content": "考えはじめました",
            "Chinese": "开始考虑了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:10:46",
            "content": "そうですか。それにはお金が必要になると思いますので、貯金が必要だと思いますが今後貯金とかできそうですか。",
            "Chinese": "是吗？那样的话会需要钱，所以需要存款。您觉得之后能存下钱吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:11:00",
            "content": "わかりません…",
            "Chinese": "我不知道…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:12:07",
            "content": "そうですね。今高校生だから休みの期間中くらいしかアルバイトできませんよね。",
            "Chinese": "是啊。因为您现在还是高中生，也只能在放假期间打工吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:12:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:13:17",
            "content": "もう、学校には進学とか報告されているんですか。",
            "Chinese": "您已经向学校报告升学意向了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:13:30",
            "content": "はい…一応",
            "Chinese": "是的…算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:15:19",
            "content": "ダンスは今、どのように行っていますか。それともこれからですか。",
            "Chinese": "您现在是怎么练习跳舞的？还是说正准备开始？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:15:41",
            "content": "塾の後、公園とかで",
            "Chinese": "补习班下课后，在公园之类的地方。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:16:31",
            "content": "そうですか。一人で練習されているんですか。",
            "Chinese": "这样啊。您是一个人练习吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:16:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:17:17",
            "content": "今ダンスの目標とかはありますか。",
            "Chinese": "现在在舞蹈方面有什么目标吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:18:01",
            "content": "ダンスで有名になって稼ぎたい",
            "Chinese": "我想靠跳舞出名赚钱。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:18:36",
            "content": "ダンスで頑張りたいんですね。",
            "Chinese": "您是想在舞蹈上好好努力啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:18:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:19:52",
            "content": "それを親に話したけど",
            "Chinese": "我和父母说了这个想法，但是"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:19:55",
            "content": "ダメで",
            "Chinese": "他们不同意。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:20:08",
            "content": "ダンスは今後、どこかでレッスンを受けるとか決めていますか。",
            "Chinese": "关于跳舞，您决定好之后去哪里上课了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:20:17",
            "content": "いつも話し合いになると親がキレ始めて話にならない",
            "Chinese": "每次一谈，我父母就开始发火，根本没法沟通。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:20:32",
            "content": "お金があればレッスンとかもいきたい",
            "Chinese": "要是有钱的话，我也想去上课。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:21:18",
            "content": "親を説得するのが、とても難しいんですね。",
            "Chinese": "说服父母，确实非常困难呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:21:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:22:18",
            "content": "家にいるのも辛い",
            "Chinese": "待在家里也很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:22:59",
            "content": "そうなんですね。お辛いんですね。",
            "Chinese": "是这样啊。您一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:23:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:23:48",
            "content": "誰か相談に乗ってくれそうな人はいませんか。",
            "Chinese": "有没有什么人可以和您商量一下呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:23:55",
            "content": "いません",
            "Chinese": "没有。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:24:06",
            "content": "だから、きました",
            "Chinese": "所以我才来这里。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:26:56",
            "content": "そうですね。後は親と真剣に話を何度もして小さな妥協点を見つけていくようにしていく事はできないでしょうか。",
            "Chinese": "是这样啊。那之后，您看能不能试着和父母多认真谈几次，慢慢找到一个小的妥协点呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:27:21",
            "content": "そうですね…",
            "Chinese": "嗯…是吧…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:29:28",
            "content": "真剣に何度も話をすることで少しづつわかってもらうというのではどうでしょうか。",
            "Chinese": "通过认真地、多次地沟通，让他们一点点地理解您，您觉得这个方法怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:29:44",
            "content": "話し合いにならないので…",
            "Chinese": "因为根本谈不下去…"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:30:04",
            "content": "わかりました、もう少し考えてみます",
            "Chinese": "我明白了，我再考虑一下。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:30:09",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/25(木) 11:31:14",
            "content": "こちらこそ今日はお話を聞かせていただき、ありがとうございました。今日はこのあたりにしたいと思うのですが、いかがでしょうか。",
            "Chinese": "我也要谢谢您今天愿意和我说这些。今天我们就先谈到这里，您觉得可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/25(木) 11:31:38",
