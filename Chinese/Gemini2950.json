{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 14:51:11",
            "content": "こんにちは。今日はよろしくお願いいたします。",
            "Chinese": "您好。今天请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 14:53:24",
            "content": "こんにちは、こちらこそよろしくお願いいたします。",
            "Chinese": "您好，我也请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 14:53:35",
            "content": "お時間になりましたら、始めさせていただきたいと思います。",
            "Chinese": "时间到了，我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 14:54:59",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:00:35",
            "content": "こんにちは、相談員です。ライン相談にお越しくださって、ありがとうございます。",
            "Chinese": "您好，我是咨询师。感谢您使用我们的线上咨询服务。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:00:46",
            "content": "はじめに年齢・性別と、ご相談になりたいことを教えていただいてよろしいでしょうか？",
            "Chinese": "首先，能请您告诉我您的年龄、性别以及想咨询的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:00:51",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:01:10",
            "content": "高校１年",
            "Chinese": "高一。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:01:17",
            "content": "男子",
            "Chinese": "男生。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:01:34",
            "content": "友達がいない",
            "Chinese": "我没有朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:02:30",
            "content": "そうなんですね。そのことについては、ご自身ではどんな風に思っているのですか？",
            "Chinese": "是这样啊。关于这件事，您自己是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:02:46",
            "content": "焦ってる",
            "Chinese": "很焦虑。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:03:02",
            "content": "うんうん。そうなんですね。",
            "Chinese": "嗯嗯，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:04:06",
            "content": "そう思いながら通うのはつらいですよね",
            "Chinese": "怀着这样的心情去上学，一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:04:22",
            "content": "つらい",
            "Chinese": "很痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:05:02",
            "content": "どうしたらいいの？",
            "Chinese": "我该怎么办？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:05:32",
            "content": "つらい気持ちの中、お話に来てくれてありがとう",
            "Chinese": "谢谢你在这么痛苦的时候，还愿意来和我说这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:05:53",
            "content": "あなたのことをもっと理解したいので、",
            "Chinese": "我想更深入地了解您的情况，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:07:19",
            "content": "お話聞かせてくださいね",
            "Chinese": "请和我分享一下您的事情吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:07:39",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:08:18",
            "content": "そんな中でも毎日学校へは通っているのですか？",
            "Chinese": "在这种情况下，您每天还是坚持去学校吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:08:54",
            "content": "通ってる",
            "Chinese": "有去。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:09:31",
            "content": "そうなんですね。そんな中でも通い続けているのですね。",
            "Chinese": "是这样啊。即使在这样的情况下，您还是坚持去上学呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:09:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:10:49",
            "content": "そうでしたか。今のような気持はいつ頃から感じているのかな？",
            "Chinese": "这样啊。像现在这样的心情，大概是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:12:13",
            "content": "高校に入ったときから",
            "Chinese": "从上高中开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:14:21",
            "content": "そうなんですね。長い間抱えてきたんですね。それでも頑張って通い続けるのはつらかったですよね",
            "Chinese": "原来如此。您已经独自承受了很长时间了呢。即使如此还努力坚持去上学，一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:14:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:14:53",
            "content": "ここではどんな気持ちをお話ししてくださっても大丈夫ですよ。",
            "Chinese": "在这里，无论您有什么样的心情，都可以放心说出来。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:15:18",
            "content": "焦ってしまう気持ちもあるようですが、",
            "Chinese": "您似乎感到很焦虑，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:16:25",
            "content": "焦ると思う時は、どんな場面だったりしますか？",
            "Chinese": "是在什么样的情况下会让您感到焦虑呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:16:38",
            "content": "（話せる範囲でかまいませんよ)",
            "Chinese": "（在您愿意分享的范围内就好。）"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:17:19",
            "content": "班を組むとき",
            "Chinese": "分组的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:17:32",
            "content": "ええ、そうなんですね",
            "Chinese": "嗯，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:17:50",
            "content": "１人になる",
            "Chinese": "我就会落单。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:19:16",
            "content": "そっか・・・それは不安にもなるでしょうね・・・そんな時は、どんなやり取りがあったりするのですか？",
            "Chinese": "这样啊……那确实会让人不安呢……那种时候，大家一般会有什么样的互动呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:19:44",
            "content": "最後に先生が決める",
            "Chinese": "最后由老师来决定。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:20:53",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:21:06",
            "content": "誰も声をかけてくれないから",
            "Chinese": "因为没有人来找我组队。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:22:13",
            "content": "そうなんですね。それは寂しいですよね。声をかけてくれないのかと思うと、焦ってしまうのも、無理もありませんよね",
            "Chinese": "是这样啊。那确实会很寂寞吧。想到没有人来找自己，会感到焦虑也是难免的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:22:49",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:23:05",
            "content": "焦る",
            "Chinese": "很焦虑。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:24:18",
            "content": "うんうん。すんなり決まらないと思うと、心細くもなると思います。そんな時はどんな考えが浮かんでいますか？",
            "Chinese": "嗯嗯。想到不能顺利分好-组，心里一定也很没底吧。这种时候，您脑海里会浮现出什么样的想法呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:25:41",
            "content": "帰りたくなる",
            "Chinese": "就想回家。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:26:19",
            "content": "うんうん。それくらいつらい思いをしているんですね。",
            "Chinese": "嗯嗯。看来您真的感到非常痛苦呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:26:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:27:32",
            "content": "よくこれまで辛抱してきましたねすこし質問が続くけど、大丈夫かな？",
            "Chinese": "您一直忍耐到现在，真的很不容易。接下来我可能还会问一些问题，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:27:40",
            "content": "はい",
            "Chinese": "可以。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:28:15",
            "content": "大丈夫",
            "Chinese": "没问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:29:09",
            "content": "もし答えにくいと思う時は、遠慮なく教えてくださいね高校に入ってから感じていると教えてくれたけど、",
            "Chinese": "如果有不想回答的问题，请不用客气，直接告诉我。您之前说从上高中后开始有这种感觉，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:29:58",
            "content": "今のような状況になるには、何か思い当たることなどあったりしますか？",
            "Chinese": "您觉得导致现在这种状况，有什么可能的原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:30:20",
            "content": "わからない",
            "Chinese": "我不知道。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:30:37",
            "content": "入ったときから１人",
            "Chinese": "从一进高中就是一个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:32:04",
            "content": "そうなんですね。わからないと思うと、悩ましいですよね。今の学校では、中学の時のお友だちとか、話せる人はどなたかいたりしますか？",
            "Chinese": "是这样啊。说不上来原因也会让人烦恼吧。在现在的学校里，有初中时的朋友，或者可以聊得来的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:32:16",
            "content": "いない",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:33:08",
            "content": "そうなんだ。慣れない環境になると、戸惑うことも多いですよね",
            "Chinese": "是这样啊。到了一个不习惯的新环境，会感到不知所措也是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:33:23",
            "content": "どうしたらいいのかわからない",
            "Chinese": "我不知道该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:34:04",
            "content": "悩みますよね。あなたと一緒に考えていきたいと思います",
            "Chinese": "这确实让人苦恼。我愿意和您一起慢慢想办法。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:36:29",
            "content": "あなたがとてもつらい思いをしていることがよく伝わっていますよ。",
            "Chinese": "我能深刻地感受到您非常痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:37:26",
            "content": "ところで、",
            "Chinese": "另外，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:38:14",
            "content": "中学生の頃は、どんな感じで過ごしていたのかな？今とどんな違いがあったりするでしょうか？",
            "Chinese": "您初中时是怎样度过的呢？和现在有什么不同吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:39:37",
            "content": "友達が１人いた",
            "Chinese": "有一个朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:39:53",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:40:47",
            "content": "歴史のこと話してた",
            "Chinese": "我们会聊历史。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:41:20",
            "content": "そうなんだ。それからそれから？",
            "Chinese": "原来如此。然后呢？然后呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:42:55",
            "content": "戦国時代のこととか",
            "Chinese": "比如战国时代之类的事情。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:43:22",
            "content": "いっぱい話してた",
            "Chinese": "聊了很多。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:43:53",
            "content": "そうなんですね。興味のあること　いっぱいお話しできていたんですね",
            "Chinese": "是这样啊。你们能一起聊很多感兴趣的话题呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:44:00",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:44:28",
            "content": "その子とだけは話が合った",
            "Chinese": "只有和那个朋友聊得来。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:45:04",
            "content": "ええ、そうなんですね。いいですね。気の合う友達がいるのはうれしいですよね",
            "Chinese": "嗯，是这样啊。真不错，能有一个投缘的朋友是很开心的事呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:46:11",
            "content": "北条早雲がどうやって小田原城を築いたかとか",
            "Chinese": "比如北条早云是如何修筑小田原城的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:46:29",
            "content": "楽しかった",
            "Chinese": "很开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:46:48",
            "content": "ほう！それは楽しそうですね",
            "Chinese": "哇！那听起来很有趣呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:46:58",
            "content": "でも今は１人",
            "Chinese": "但现在只有我一个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:48:21",
            "content": "そっか・・・楽しかったからこそ、今とのギャップも感じるのですね",
            "Chinese": "这样啊……正因为过去很开心，所以更能感受到和现在的落差吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:48:39",
            "content": "そうかもしれない",
            "Chinese": "也许是这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:49:56",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:51:03",
            "content": "そう感じるのですね。",
            "Chinese": "您是这样感觉的呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:51:38",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:52:38",
            "content": "気の合う子とお話しできるのは毎日の張りにもなりますものね。ちなみに、",
            "Chinese": "能和合得来的朋友聊天，也会成为每天的动力呢。顺便问一下，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:54:13",
            "content": "班作りの時とかでは、あなたから何か話しかけたりとか、やってみたりしたことってありますか？",
            "Chinese": "在分组的时候，您有没有主动去搭话或尝试做些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:58:03",
            "content": "ある",
            "Chinese": "有过。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 15:59:02",
            "content": "そうなんですね。どんなこと？",
            "Chinese": "是这样啊。都做了些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 15:59:13",
            "content": "入れてと言ったことがあった",
            "Chinese": "我曾经说过“可以加我一个吗”。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 16:00:07",
            "content": "そうなんだね、勇気を出したんですねそれでその後どうなったの？",
            "Chinese": "是这样啊，您鼓起勇气了呢。那之后怎么样了？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/08(土) 16:00:51",
            "content": "入れなかった",
            "Chinese": "没能加入。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/08(土) 16:02:04",
