        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:41:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:41:41",
            "content": "こういった感じでしょうか。",
