{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 09:52:44",
            "content": "おはようございます。本日はよろしくお願いします。",
            "Chinese": "早上好，今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 09:53:40",
            "content": "おはようございます",
            "Chinese": "早上好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 09:54:32",
            "content": "10：00になったら開始でよろしいでしょうか。",
            "Chinese": "我们10:00开始可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 09:55:24",
            "content": "はいよろしくお願いいたします",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:00:10",
            "content": "こんにちは。相談員です。本日はどのようなご相談でしょうか。",
            "Chinese": "您好，我是咨询师。今天您想咨询哪方面的问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:00:29",
            "content": "仕事がつまらないんです",
            "Chinese": "我觉得工作很无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:00:40",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:01:07",
            "content": "仕事がつまらないとやりがいがないですよね。",
            "Chinese": "如果工作无聊，就会觉得没有成就感吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:01:19",
            "content": "まあ。そうですね",
            "Chinese": "嗯，是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:01:38",
            "content": "なぜつまらないと感じるのでしょうか。",
            "Chinese": "您为什么会觉得无聊呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:01:58",
            "content": "私は営業なんですけど",
            "Chinese": "我是做销售的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:02:05",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:02:38",
            "content": "会社の方針が変わって、デスクワークが増えてしまって、",
            "Chinese": "公司方针改变了，内勤工作变多了，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:02:49",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:02:54",
            "content": "くだらない仕事が増えたんです",
            "Chinese": "增加了很多琐碎无意义的工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:03:28",
            "content": "それでつまらないと感じているのですね。",
            "Chinese": "所以您才觉得无聊的，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:03:35",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:04:10",
            "content": "営業の仕事というのは、外に出て活動するといった内容でしょうか。",
            "Chinese": "销售工作是指外出跑业务之类的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:05:01",
            "content": "そうです開拓とか、売上達成が目標ですね",
            "Chinese": "是的，比如开拓市场和达成销售目标。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:05:14",
            "content": "なるほどです。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:06:03",
            "content": "ご相談者様は売上達成などにやりがいを感じていたのですね。",
            "Chinese": "您过去是在完成业绩等方面感到有成就感的，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:06:21",
            "content": "その通りです",
            "Chinese": "正是如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:07:01",
            "content": "素敵なフロンティア精神ですね！",
            "Chinese": "您有很棒的开拓精神呢！"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:07:14",
            "content": "やりがいはありますね",
            "Chinese": "确实很有成就感。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:07:41",
            "content": "ご相談者様からはとても活動的でやる気を感じます。",
            "Chinese": "从您身上我能感受到很强的行动力和干劲。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:07:56",
            "content": "はい、営業ですから",
            "Chinese": "是的，毕竟是做销售的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:08:13",
            "content": "今はデスクワークが増えたとおっしゃってましたが、",
            "Chinese": "您刚才提到现在内勤工作增多了，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:08:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:08:50",
            "content": "営業のお仕事自体はまだ続いているのですか。",
            "Chinese": "销售工作本身还在继续吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:08:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:09:39",
            "content": "営業の割合が減ったという感じでしょうか。",
            "Chinese": "是不是感觉销售工作的占比减少了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:10:08",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:10:43",
            "content": "しかし、デスクワークも増えて不満を感じているのですね。",
            "Chinese": "不过，内勤工作增加这件事让您感到不满，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:10:55",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:11:10",
            "content": "いつ頃からそのような状態が続いているのでしょうか。",
            "Chinese": "这种状况大概从什么时候开始持续的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:12:07",
            "content": "働き方改革が始まってからというもの、ここ2年くらいから、",
            "Chinese": "从开始推行工作方式改革起，差不多这两年吧，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:12:48",
            "content": "二年ですか・・・よくその不満を耐えてきましたね。",
            "Chinese": "两年了吗……一直忍受这些不满，您真的很不容易。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:12:58",
            "content": "特に要求される事が多いです",
            "Chinese": "特别是被要求做的事情变多了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:13:04",
            "content": "おつらかったでしょう。",
            "Chinese": "您一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:13:19",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:13:19",
            "content": "要求ですか？",
            "Chinese": "您是说要求吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:13:29",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:13:46",
            "content": "例えばどのようなことでしょうか。",
            "Chinese": "比如说具体有哪些呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:14:58",
            "content": "営業日報や進捗状況などを、いちいち、iPadに入力させられるんです",
            "Chinese": "像营业日报、进度情况之类的，都要一项一项地被要求输入到iPad里。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:15:14",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:15:31",
            "content": "以前はそういったものはなかったのですか。",
            "Chinese": "以前没有这些吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:16:18",
            "content": "５年前位から営業はiPadを持たされるようになったのですが",
            "Chinese": "大概5年前开始，销售人员就配发iPad了，不过……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:16:27",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:17:01",
            "content": "営業活動やお客様のために活用するにはとても良いのですが、",
            "Chinese": "用于销售活动或者为客户服务，它本来是很好的工具，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:17:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:18:05",
            "content": "今、この顧客は、どんな推進段階か、みたいな事を、いちいち入力しなければならないのです",
            "Chinese": "现在，必须把“这个客户目前处于哪个推进阶段”之类的事情，一一输入进去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:18:19",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:18:31",
            "content": "それは手間ですね。",
            "Chinese": "那确实很麻烦呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:18:37",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:19:10",
            "content": "そういった細かい報告がわずらわしいのですね。",
            "Chinese": "这些细碎的汇报让您觉得很烦琐，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:19:57",
            "content": "あと、見積り依頼や発注も全てです。電話は使うな！と言われています",
            "Chinese": "还有，报价申请和下单也全都要用系统。公司说不准用电话！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:20:29",
            "content": "電話はだめなのですか。なぜでしょう。",
            "Chinese": "不能用电话吗？为什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:21:03",
            "content": "電話連絡したら、本社に名前を張り出されました！",
            "Chinese": "我用电话联系之后，名字被总部贴出来通报批评了！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:21:21",
            "content": "ひどいですね。。。",
            "Chinese": "太过分了……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:21:23",
            "content": "受け手の手間を省くためでしょうけど",
            "Chinese": "可能是为了减少接收方的工作量吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:21:43",
            "content": "何もそこまでしなくても、、、",
            "Chinese": "也没必要做到这个地步吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:21:54",
            "content": "とは感じますが、、、",
            "Chinese": "虽然我是这么觉得的……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:21:58",
            "content": "受注者とも、やりにくさを愚痴ったりしてます",
            "Chinese": "我也和接单方抱怨过，说这样很难办。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:22:32",
            "content": "お相手様もそう感じてらっしゃるのですね。",
            "Chinese": "对方也有同感呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:22:39",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:23:04",
            "content": "ご相談者様以外の周りの社員の方は、",
            "Chinese": "除了您之外，周围的同事们，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:23:21",
            "content": "似たような不満を持っているのでしょうか。",
            "Chinese": "也有类似的不满吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:24:07",
            "content": "事務員以外からは同じ不満が漏れます",
            "Chinese": "除了文员，其他人也都有同样的不满。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:24:21",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:24:40",
            "content": "事務員さんは不満が出ていないのですね。",
            "Chinese": "文职人员那边倒是没有什么不满，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:25:28",
            "content": "あと、一部素直に入力に、励んでる営業もいますけど、、、",
            "Chinese": "另外，也有一部分销售人员很老实地在努力输入……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:25:42",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:26:24",
            "content": "一部文句を言わずやっている職員もいるが、",
            "Chinese": "虽然也有一部分员工毫无怨言地在做，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:26:47",
            "content": "不満を感じている職員も多いのですね。",
            "Chinese": "但感到不满的员工也很多，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:27:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:27:28",
            "content": "ちなみにですが、",
            "Chinese": "顺便问一下，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:28:09",
            "content": "逆に、その方針が変わってからよかったと感じるものは何かありますか。",
            "Chinese": "反过来说，自从方针改变之后，有什么您觉得变好了的地方吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:28:32",
            "content": "うーん、、、",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:28:39",
            "content": "データが見やすくなったなど、、、",
            "Chinese": "比如数据变得更容易查看了之类的……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:29:10",
            "content": "なければないで無理に出さずとも結構ですよ。",
            "Chinese": "如果没有的话，也不用勉强想出来。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:29:18",
            "content": "すぐには、でてきません",
            "Chinese": "一下子想不出来。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:29:32",
            "content": "わかりました。",
            "Chinese": "好的，我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:29:42",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:30:19",
            "content": "ご相談者様としては、今の方針にメリットを感じないのですね。",
            "Chinese": "也就是说，您并没有感受到现行方针的好处，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:30:32",
            "content": "そうでね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:30:51",
            "content": "それはもちろん不満がたまりますよね。",
            "Chinese": "那当然会积累很多不满呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:31:27",
            "content": "営業活動のためにする意義があることにするならいいんですが",
            "Chinese": "如果做这些事对销售活动有意义的话还好，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:31:46",
            "content": "そうですよね。。。",
            "Chinese": "是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:32:02",
            "content": "そう感じるのは当然だと思います。",
            "Chinese": "有这样的感受很正常。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:32:19",
            "content": "ご相談者様は、",
            "Chinese": "您呢，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 10:32:46",
            "content": "会社に対し「こうなってほしい」などの希望はありますか。",
            "Chinese": "对公司有没有“希望能变成这样”的具体期望呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 10:34:00",
            "content": "会社に改善要求したら、iPad管理を強要されるに至りました",
            "Chinese": "向公司提出改善要求后，反而被强制要求使用iPad管理。"
        },
        {
            "role": "クライアント",
