{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:30:12",
            "content": "こんにちは相談員です。よろしくお願いいたします。",
            "Chinese": "您好，我是咨询师。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:30:31",
            "content": "お願いします",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:30:43",
            "content": "最初に年齢と性別を教えていただけますか？",
            "Chinese": "首先，能请您告知您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:31:04",
            "content": "14歳女子",
            "Chinese": "14岁，女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:31:18",
            "content": "お返事ありがとうございます。",
            "Chinese": "感谢您的回复。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:31:33",
            "content": "学年も教えていただけますか？",
            "Chinese": "能请您也告知一下您的年级吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:31:53",
            "content": "中3",
            "Chinese": "初三。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:32:05",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:32:21",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:32:36",
            "content": "学校に行くのが嫌になりました",
            "Chinese": "我不想去上学了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:32:51",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:32:58",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:33:22",
            "content": "どんな事があったのですか？",
            "Chinese": "发生什么事了呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:33:50",
            "content": "どんな事…友達に裏切られました",
            "Chinese": "发生什么事……我被朋友背叛了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:34:30",
            "content": "そうでしたか。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:34:50",
            "content": "苦しい出来事でしたね。",
            "Chinese": "这一定是很痛苦的经历吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:34:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:35:20",
            "content": "もう少し状況を教えていただけませんか？",
            "Chinese": "能请您再详细说明一下情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:36:09",
            "content": "信用してたから思ってること言ったのに裏切られました",
            "Chinese": "因为信任她，才说了心里话，结果却被背叛了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:36:35",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:36:51",
            "content": "信用して話したのにね。",
            "Chinese": "明明是信任她才说的呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:37:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:37:58",
            "content": "他の人には知られたくないことを、友達だからと思って信用して話したんですね。",
            "Chinese": "因为觉得对方是朋友，所以您信任她，把不想让别人知道的事情告诉了她，是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:38:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:38:33",
            "content": "知られたくないっていうか思ってたことかな",
            "Chinese": "与其说是不想让别人知道，不如说是我当时的想法吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:38:57",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:39:31",
            "content": "あなたとすれば、他の人には喋って欲しくなかったんでしょうね。",
            "Chinese": "对您来说，是不希望她告诉别人的吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:40:23",
            "content": "喋って欲しくない…どうかな",
            "Chinese": "不希望她说出去……不过也说不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:40:50",
            "content": "そういう訳でもない？",
            "Chinese": "也不完全是那样？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:40:56",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:41:25",
            "content": "そうすると、あなたが裏切られたと感じているのは、どんな点なのかな？",
            "Chinese": "这样的话，您觉得被背叛，具体是哪一点呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:42:25",
            "content": "裏切られましたと感じなのはやっぱり、喋られたからかな",
            "Chinese": "觉得被背叛，果然还是因为她把事情说出去了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:42:54",
            "content": "そうだったんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:43:14",
            "content": "ちなみに、思ってたことってどんなことなのかな？",
            "Chinese": "顺便问一下，您说的“想法”具体是指什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:44:29",
            "content": "リーダーの子がいつも順番に誰かを無視しようってなるから、それはおかしいと思わない？って言いました",
            "Chinese": "我对她说：“那个带头的同学总是要大家轮流孤立别人，你不觉得这很奇怪吗？”"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:45:01",
            "content": "そうだったんだね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:45:07",
            "content": "そしたら次の日から私が無視されました",
            "Chinese": "结果从第二天开始，我就被无视了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:45:22",
            "content": "そんなことが起こったんだ。",
            "Chinese": "竟然发生了这样的事啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:45:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:45:43",
            "content": "ひどすぎると思ったよ。",
            "Chinese": "我觉得这太过分了。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:46:15",
            "content": "誰でもそう思うのかな？",
            "Chinese": "谁都会这么想吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:46:51",
            "content": "私も、それは裏切りだと思ったよ。",
            "Chinese": "我也觉得，那就是一种背叛。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:47:02",
            "content": "そうですよね",
            "Chinese": "是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:47:56",
            "content": "あなたが思い、発言したことは勇気のいることだと思ったよ。",
            "Chinese": "我觉得，您能有那样的想法并且说出来，是件很需要勇气的事。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:48:20",
            "content": "でもみんなはそう思ってない。",
            "Chinese": "可是大家并不这么觉得。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:48:40",
            "content": "私が嫌なやつと思ってる",
            "Chinese": "他们觉得我是个讨厌的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:48:58",
            "content": "そこがひどすぎるよ。",
            "Chinese": "这点真的太过分了。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:49:28",
            "content": "ひどいって言われても",
            "Chinese": "就算你说这很过分……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:50:23",
            "content": "それは私の思いね。",
            "Chinese": "这是我的想法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:50:35",
            "content": "あなたはどう思っているの？",
            "Chinese": "您自己是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:51:39",
            "content": "学校行きたくない",
            "Chinese": "不想去上学。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:52:49",
            "content": "そういう気持ちになるの、無理ないと思うよ。",
            "Chinese": "会有这种心情，我觉得也是理所当然的。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:53:07",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:53:33",
            "content": "今は無視されているだよね。",
            "Chinese": "现在您正在被无视，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:53:38",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:53:55",
            "content": "つらいね。",
            "Chinese": "很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:54:03",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:54:08",
            "content": "昨日は学校に行ったの？",
            "Chinese": "昨天您去学校了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:54:19",
            "content": "昨日は行きました",
            "Chinese": "昨天去了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:54:35",
            "content": "そうだったんだ。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:54:48",
            "content": "どんな気持ちで行ったのかな？",
            "Chinese": "您当时是抱着什么样的心情去的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:55:04",
            "content": "嫌な気持ち",
            "Chinese": "心情很差。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:55:50",
            "content": "そうだよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:56:05",
            "content": "でも仕方ないから行ってるけど本当は行きたくない",
            "Chinese": "但没办法才去的，其实我真的不想去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:56:25",
            "content": "でもよく行ったね。",
            "Chinese": "不过您还是去了，真不容易。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:57:48",
            "content": "仕方ないからってやっぱり勉強が遅れたくないからとかいう思いからかな？",
            "Chinese": "说没办法，是因为不想耽误学习之类的原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:58:13",
            "content": "行かないといけないから",
            "Chinese": "因为必须得去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:58:33",
            "content": "そう思ってるんだね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:58:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:59:06",
            "content": "今日はどうしたの？",
            "Chinese": "今天您怎么了？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:59:44",
            "content": "今日はお腹痛いから休みました",
            "Chinese": "今天因为肚子疼请假了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:00:04",
            "content": "そうだったんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:01:29",
            "content": "お母さんには何て言ったの？",
            "Chinese": "您跟妈妈说了什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:01:45",
            "content": "何も言ってない",
            "Chinese": "什么都没说。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:02:37",
            "content": "腹痛だから学校お休みするって言ったのかな？",
            "Chinese": "您是说因为肚子疼，所以要请假不去上学，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:02:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:03:28",
            "content": "今日は1日お休みしてみてどうだったかな？",
            "Chinese": "今天休息了一整天，感觉怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:03:58",
            "content": "とうもならない",
            "Chinese": "没什么改变。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:04:38",
            "content": "そうなんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:05:40",
            "content": "1日モヤモヤしていたのかな・・・",
            "Chinese": "是烦闷了一整天吗……"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:05:48",
            "content": "今日休んだからって何もかわらないですよね。",
            "Chinese": "就算今天休息了，也什么都不会改变吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:06:15",
            "content": "モヤモヤはずっとしてるけど",
            "Chinese": "虽然心里一直很烦闷。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:06:42",
            "content": "かもしれない。",
            "Chinese": "或许是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:07:13",
            "content": "なにかかもしれないのですか？",
            "Chinese": "什么或许是这样？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:08:28",
            "content": "かもしれないの意味がわからないです",
            "Chinese": "我不明白“或许是这样”是什么意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:09:12",
            "content": "学校に行きたくない気持ちが身体に表われたのかもと思っています。",
            "Chinese": "我在想，是不是不想去学校的心情，反映在了身体上。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:09:26",
            "content": "いかがですか？",
            "Chinese": "您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:09:39",
            "content": "そうなのかな",
            "Chinese": "可能是这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:10:00",
            "content": "何か他の考えはありそうですか？",
            "Chinese": "您有其他什么想法吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:10:32",
            "content": "他の考えって？",
            "Chinese": "其他想法是指？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:10:51",
            "content": "何を考えたらいいのですか",
            "Chinese": "我该想些什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:11:45",
            "content": "あなたとしては、どうなりたいのかな？",
            "Chinese": "对您来说，您希望变成什么样呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:12:04",
            "content": "そこを考えてみるのも一つかもしれない。",
            "Chinese": "从这一点开始思考，或许是一种方法。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:12:12",
            "content": "わからないです",
            "Chinese": "我不知道。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:13:25",
            "content": "無視されててどうなりたいかって、無視されたくないしかないじゃないですか他にどうすればいいんですか",
            "Chinese": "被无视的情况下，还能希望变成什么样？不就是不想被无视吗！除此之外我还能怎么办？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:14:13",
            "content": "そうだよね。",
            "Chinese": "说的是呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:14:45",
            "content": "私の気持ち全然わかってもらえないのですね",
            "Chinese": "你根本不明白我的心情吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:15:25",
            "content": "無視されて辛い気持ち分かろうとしているよ。",
            "Chinese": "我正在努力理解您被无视的痛苦心情。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:15:53",
            "content": "分かろうとしてるだけでわからないですよね",
            "Chinese": "你只是在试着理解，但其实还是不明白，对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:16:06",
            "content": "どうしたら無視されないようになるか、一緒に考えよう。",
            "Chinese": "我们一起来想想，怎么做才能不再被无视，好吗。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:19:02",
            "content": "学校で無視して来ない人っていないのかな？",
            "Chinese": "在学校里，有没有不无视您的人呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:19:35",
            "content": "いるけど",
            "Chinese": "有是有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:19:51",
            "content": "そうなんだ。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:20:28",
            "content": "いたらおかしいですか",
            "Chinese": "有的话很奇怪吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:21:08",
            "content": "大事な事だと思いますよ。学校に行ったら、そういう人と話をするようにしてみるというのが一つかもしれないよ。",
            "Chinese": "我觉得这很重要。如果您去学校的话，可以试着和这样的人多交流，这或许是一个办法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:22:23",
            "content": "無視してくる人って本当の友だちなのかな？",
            "Chinese": "那些无视您的人，真的算是朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:22:49",
            "content": "ずっと一学期から一緒にいて？",
            "Chinese": "可我们从第一学期开始就一直在一起了啊？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:22:58",
            "content": "いてる",
            "Chinese": "是一起的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:24:15",
            "content": "大切なのは、一緒にいる時間なのかな？",
            "Chinese": "重要的只是一起相处的时间长短吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:24:46",
            "content": "無視してくる人って、本当に友達なのかな？　と私は疑問に思うな。",
            "Chinese": "我在想，那些无视您的人，真的是朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:25:40",
            "content": "それはあなたの意見ですよね",
            "Chinese": "那是你的看法吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:25:55",
            "content": "そうですね。あなたはどう思の？",
            "Chinese": "是的。您是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:26:15",
            "content": "わからない",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:26:30",
            "content": "そうなんだ。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:26:49",
            "content": "確かに1学期からずうっと一緒だったからね。",
            "Chinese": "的确，从第一学期开始就一直在一起嘛。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:27:28",
            "content": "今まで親しくしてきたっていう思いがつよくあるんだよね。",
            "Chinese": "您心里对“我们一直很要好”的感觉也很强烈吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:30:16",
            "content": "でも、今度のことは、本当の友だちって何？　を考えさせてくれる機会なのかもしれないという気もするけど。",
            "Chinese": "但是，我也觉得，这次的事情，或许也是一个让您思考“什么才是真正的朋友？”的机会。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:32:34",
            "content": "今までの人達から無視されないで関りを作り直すということと、もう一つは、新しい友達を作るという２つの選択肢があるかもしれないね。",
            "Chinese": "也许有两个选择：一是设法修复关系，让他们不再无视您；二是去结交新的朋友。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:33:08",
            "content": "わかりました",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:33:08",
            "content": "この機会に一度考えてみるのも一つかもしれないね。",
            "Chinese": "借这个机会好好想一想，或许也是一个办法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:33:35",
            "content": "考えがすこし進んだらまた、相談に来てください。",
            "Chinese": "如果想法有什么进展，欢迎随时再来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:33:48",
            "content": "ご一緒に考えさせていただきます。",
            "Chinese": "我会和您一起思考的。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:33:48",
            "content": "そうですね",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:34:08",
            "content": "あなたのことを応援していますよ。",
            "Chinese": "我一直在为您加油、支持您。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:34:09",
            "content": "それは大丈夫です",
            "Chinese": "那个就不用了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:35:34",
            "content": "あなたは人間との付き合い方について、尊い感覚をお持ちの人だと思っています。",
            "Chinese": "我认为您在与人相处方面，有着非常可贵的感知和判断力。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:36:54",
            "content": "だからこそ、順番に無視するっておかしいよねと言えたんですよね。",
            "Chinese": "正因为如此，您才能说出“轮流孤立别人很奇怪”这样的话，不是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:37:27",
            "content": "そう思っただけです",
            "Chinese": "我只是那么想而已。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:38:11",
            "content": "その気持ちがこれからのあなたの軸になっていきそうな気がしています。",
            "Chinese": "我觉得这份心情，今后会成为您的支撑与准则。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:38:20",
            "content": "応援していますね。",
            "Chinese": "我会一直支持您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:39:08",
            "content": "では、今日はここで相談は終了とさせていただいてよろしいですか？",
            "Chinese": "那么，今天的咨询到这里结束可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:39:16",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:39:29",
            "content": "今日はご相談に来てくださりありがとうございます。",
            "Chinese": "感谢您今天前来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:39:40",
            "content": "では失礼いたします。",
            "Chinese": "那我先告辞了。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 15:39:55",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 15:40:02",
