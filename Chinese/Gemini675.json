{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 09:53:51",
            "content": "入りました。今日はよろしくお願いいたします。。",
            "Chinese": "我进来了。今天还请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 09:56:20",
            "content": "(お待たせしました！よろしくお願いいたします)",
            "Chinese": "（让您久等了！请多多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 09:56:32",
            "content": "よろしくお願いします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 09:56:52",
            "content": "(はじめられますか？)",
            "Chinese": "（可以开始了吗？）"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 09:57:18",
            "content": "はい大丈夫です。",
            "Chinese": "好的，没问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 09:57:28",
            "content": "(始めますね)",
            "Chinese": "（那我们开始吧。）"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 09:57:34",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 09:57:42",
            "content": "こんにちは、相談員です。",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 09:57:51",
            "content": "こんにちは。",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 09:58:03",
            "content": "本日はどのようなご相談でしょうか？",
            "Chinese": "今天您有什么想咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 09:58:32",
            "content": "はい、中2の息子の事で困っています。",
            "Chinese": "是这样的，我为我上初二儿子的事情感到很困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 09:59:20",
            "content": "息子さんの事…それは心配になりますね。",
            "Chinese": "是关于您儿子的事啊……那确实会让人担心呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 09:59:25",
            "content": "よろしければ、初めに年齢と性別を教えていただけますか？(言えたらで大丈夫です)",
            "Chinese": "如果可以的话，能先告诉我您的年龄和性别吗？(方便说的话就可以)"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 09:59:52",
            "content": "はい。45歳、女です。",
            "Chinese": "好的。45岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:00:17",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:00:47",
            "content": "息子さんの事とは…どんな事で悩まれているのですか？",
            "Chinese": "关于您儿子的事……您具体在为哪些方面烦恼呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:00:59",
            "content": "コロナで休校の時期があったりしたあと、",
            "Chinese": "自从疫情期间停课之后，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:01:07",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:01:24",
            "content": "ゲームをする時間が長くなっているみたいで、寝てるのも遅いみたいなんです。",
            "Chinese": "他玩游戏的时间好像变长了，睡觉也变得很晚。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:01:41",
            "content": "でも、聞くとうるせえとか言われてしまい",
            "Chinese": "但是一问他，他就会说“烦死了”之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:01:49",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:02:13",
            "content": "話しかけても、うるさそうにされるので、",
            "Chinese": "就算我跟他说话，他也是一副很烦的样子，所以，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:02:18",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:02:29",
            "content": "よくわからなくて",
            "Chinese": "我也搞不太清楚。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:02:52",
            "content": "なんか、イライラしてるみたいです。",
            "Chinese": "感觉他总是烦躁的样子。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:03:19",
            "content": "うんうん、それは息子さんのご体調や気持ちが心配になりますよね",
            "Chinese": "嗯嗯，那样确实会担心您儿子的身体状况和心情呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:03:27",
            "content": "そうなんです。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:04:13",
            "content": "よく分からないというのは、息子さんがゲームをしているかどうかということですか？",
            "Chinese": "您说搞不清楚，是指不确定他是不是在玩游戏吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:04:30",
            "content": "そうですね。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:04:39",
            "content": "なんか、部屋にこもっているし",
            "Chinese": "他总是把自己关在房间里。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:05:19",
            "content": "そうですか…もっとお話ししたいですよね",
            "Chinese": "这样啊……您也会更想和他多聊聊吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:05:36",
            "content": "はい。今日学校楽しかった？とか聞いても、別に、とかふつう、とか",
            "Chinese": "是的。就算我问他“今天在学校开心吗？”，他也只会回答“没什么”或者“一般般”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:05:45",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:06:01",
            "content": "なんか、取り付く島がなくて。",
            "Chinese": "感觉完全无从下手。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:06:02",
            "content": "そう答えるんですね…",
            "Chinese": "他是这么回答的啊…"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:06:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:06:30",
            "content": "そうですか…",
            "Chinese": "这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:06:46",
            "content": "寂しくなりますよね。。",
            "Chinese": "会感到很寂寞吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:06:58",
            "content": "はい、なんか寂しいです。",
            "Chinese": "是的，感觉有点寂寞。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:07:07",
            "content": "そうですよね。。",
            "Chinese": "是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:07:32",
            "content": "休校前はどんな様子だったのでしょうか？",
            "Chinese": "停课之前他是什么样的情况呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:08:04",
            "content": "それほどゲームにはまっていたとも思わなかったので、",
            "Chinese": "我倒不觉得他那时候有那么沉迷游戏，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:08:12",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:08:35",
            "content": "休校中に時間があって、なんかくせになっちゃったのかなーとか。",
            "Chinese": "可能是停课期间时间多，慢慢就养成习惯了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:08:50",
            "content": "うんうん、なるほどですね",
            "Chinese": "嗯嗯，原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:09:26",
            "content": "前は部屋からよく出てきて、夜お茶したりもしたんですけど。",
            "Chinese": "以前他还经常从房间里出来，晚上也会一起喝点茶聊聊天。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:09:42",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:10:16",
            "content": "最近は部屋に入ったきりで、声かけてもめんどくさそうにされます。",
            "Chinese": "最近他总是一进房间就不出来，就算我叫他，他也是一副很麻烦的样子。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:10:43",
            "content": "そうでしたか…。それは息子さんとの時間が減って気持ちが通じ合っていない感じがして悲しくなってしまいますよね。",
            "Chinese": "原来是这样…。那和儿子相处的时间变少了，会感觉彼此的心意无法相通，让人很难过吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:10:56",
            "content": "そうてすね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:11:29",
            "content": "このことはどなたかにご相談されましたか？",
            "Chinese": "这件事您有和谁商量过吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:12:29",
            "content": "そうですね。夫には話したのですが、",
            "Chinese": "嗯，我跟我丈夫说过了，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:13:49",
            "content": "夫はあまり心配してないみたいでした。",
            "Chinese": "但他好像不怎么担心。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:14:00",
            "content": "そうなんですね…",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:14:24",
            "content": "それは自分だけ悩んでいるようで、もどかしいですよね",
            "Chinese": "那会让人觉得只有自己在烦恼，挺无奈的吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:14:45",
            "content": "そうなんですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:15:11",
            "content": "うんうん。ご確認ですが、今、あなた(なんとお呼びしますか？)のお話を聞いて、ゲームをやめさせることでもっと関わりたいとの気持ちが伝わってきましたが…いかがでしょうか？",
            "Chinese": "嗯嗯。我想跟您确认一下，听了您（我该怎么称呼您呢？）的话，我感觉到您是希望通过让他不玩游戏来更多地与他交流…是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:15:47",
            "content": "優子です。そうですね。",
            "Chinese": "我叫优子。是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:16:15",
            "content": "優子さんですね。ありがとうございます。",
            "Chinese": "优子女士是吧。谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:16:28",
            "content": "夜のゲームとか、あまり体によくなさそうで、心配なのです。",
            "Chinese": "晚上玩游戏什么的，感觉对身体不太好，我很担心。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:17:16",
            "content": "でも、言うこと聞いてくれそうにないし。",
            "Chinese": "但是，他又好像不会听我的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:17:42",
            "content": "うんうん、そうですよね。それでしたらこのご相談では、ゲームを少しでも減らして、息子さんと関わるためには？ということを一緒に考えていきましょう。",
            "Chinese": "嗯嗯，是啊。既然如此，在这次咨询中，我们就一起来思考“为了能让儿子稍微减少一点游戏时间，并与他多一些交流，该怎么做？”这个问题吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:18:05",
            "content": "ありがとうございます。お願いします。",
            "Chinese": "谢谢您。拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:18:39",
            "content": "はい、こちらこそお願いします。ええ、話しかけて息子さんに怖い口調で言われると嫌ですよね。",
            "Chinese": "好的，也请您多关照。嗯，跟他说话却被儿子用很冲的语气回应，会很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:18:57",
            "content": "とっても嫌です。",
            "Chinese": "非常难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:19:35",
            "content": "ええ、本当にそうだと思います。日常生活で息子さんと関わるときはどんなときですか？",
            "Chinese": "是的，我完全理解。平时您主要在什么时候和儿子有互动呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:20:06",
            "content": "共働きなので、帰ってきて夕食を取るとき、です。",
            "Chinese": "我们是双职工，所以主要是回家一起吃晚饭的时候。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:20:37",
            "content": "夫のが遅いので基本2人です。",
            "Chinese": "我丈夫回来得比较晚，所以基本上都是我们两个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:21:12",
            "content": "ええ、そうなんですね。その時はどんなお話をするのですか？",
            "Chinese": "嗯，原来如此。那时通常会聊些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:21:43",
            "content": "最近なんか、不機嫌というか、つっかかってくるので",
            "Chinese": "最近他总是不太高兴，或者说，老是跟我抬杠，所以"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:21:49",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:22:03",
            "content": "何を話したらいいかわからなくなってしまって",
            "Chinese": "我也不知道该说什么好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:22:12",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:22:24",
            "content": "(お話しくださいね)",
            "Chinese": "（请随意说就好。）"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:22:37",
            "content": "学校のこととか聞いても、別に、で終わってしまうし",
            "Chinese": "问他学校的事，他也就一句“没什么”就结束了，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:22:45",
            "content": "ああ…",
            "Chinese": "啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:22:49",
            "content": "困っています",
            "Chinese": "我很困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:23:06",
            "content": "そっかぁ…それはきついですね",
            "Chinese": "这样啊…那确实很难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:23:26",
            "content": "はい。きついです。",
            "Chinese": "是的，很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:23:52",
            "content": "そうですよね…本当にそうだと思います…。息子さんは、お父さんとはいかがですか？",
            "Chinese": "是啊…我真的这么觉得…。您儿子和他爸爸关系怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:24:31",
            "content": "主人とは、まぁ仲良しかなと思います。",
            "Chinese": "和他爸爸嘛，我觉得关系还不错。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:25:02",
            "content": "そうですか…それも優子さんから見ると寂しいですよね。",
            "Chinese": "这样啊…那在优子女士看来，也会感到寂寞吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:25:20",
            "content": "自分とも話してほしいのに…と思いますよね。",
            "Chinese": "会想“也希望他能和我多说说话……”对吗。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:25:49",
            "content": "そうですね。異性なのでわかりにくいところもあるし",
            "Chinese": "是的。可能因为是异性，有些地方也不太容易理解。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:25:56",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:26:27",
            "content": "どうしたらいいんだ？っておもって。",
            "Chinese": "所以我就想“该怎么办才好呢？”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:27:20",
            "content": "ええ、そう思うのも無理はないです。一緒にかんがえましょう。ここまでのお話をまとめさせていただいてもいいですか？",
            "Chinese": "嗯，您会这么想也是当然的。我们一起来想想办法吧。我可以先总结一下到目前为止的谈话内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:27:28",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:28:37",
            "content": "優子さんは、息子さんが休校明けから夜遅くまでゲームをしていることに心配されています。また、関わることも減って寂しい思いをされています。",
            "Chinese": "优子女士，您很担心儿子从停课结束后开始玩游戏到深夜。同时，也因为与他交流减少而感到寂寞。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:28:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:30:14",
            "content": "以前はお茶を飲みに出てきていたのに、今はお部屋にいることが多く、話しかけてもうるさいと言われて困ってらっしゃいますね。",
            "Chinese": "以前他还会出来一起喝茶聊天，但现在大多待在房间里，您一搭话就被说“烦死了”，这让您很困扰，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:30:26",
            "content": "そうですね。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:32:08",
            "content": "自分にはそういう態度なのに…お父様とは仲が良く、夕飯も二人でお話にあまり答えてくれず、取り付く島がないと感じてらっしゃいます。",
            "Chinese": "他对您是这种态度…但和父亲关系却很好，晚饭时两个人聊天他也不怎么回应您，让您感觉无从下手。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:32:33",
            "content": "はい、なんか寂しいです。",
            "Chinese": "是的，感觉有些寂寞。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:32:52",
            "content": "そうですよね…お気持ち伝わってきます。",
            "Chinese": "是啊…我能感受到您的心情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:33:32",
            "content": "あなたは休校明けから寂しさを我慢しながらも、息子さんに話しかけ続け",
            "Chinese": "您自从停课结束后，尽管感到寂寞，仍然坚持和儿子说话，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:34:05",
            "content": "本当に息子さんを愛してらっしゃるのだと思いました",
            "Chinese": "我觉得您是真的很爱您的儿子。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:34:20",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:34:24",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:34:29",
            "content": "憎らしいですが。",
            "Chinese": "虽然也觉得他很可气。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:34:58",
            "content": "色々心配してしまいます。",
            "Chinese": "但还是会为他担心各种事。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:35:02",
            "content": "ええ。そういう気持ちもおありなんですよね。お話を伺って思ったことをお伝えしてもいいですか？",
            "Chinese": "嗯。您有这样的复杂心情是很自然的。我可以说说我听了您的叙述后的一些想法吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:35:13",
            "content": "はい、お願いします。",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:35:21",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:35:52",
            "content": "優子さんは本当にご家族思いのお優しい方なのだと思いました",
            "Chinese": "我觉得优子女士是一位非常顾家、温柔的人。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:36:13",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:36:55",
            "content": "息子さんの体調や気持ちも心配したり、寂しい気持ちをもちながらも、夕食をご一緒されていますね",
            "Chinese": "您既关心儿子的身体状况和心情，即使心里感到寂寞，也仍然坚持和他一起吃晚饭呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:37:02",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:37:15",
            "content": "息子さんによっては心強い存在だと思います",
            "Chinese": "我想对于您儿子来说，您是一个让他很安心的存在。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:37:24",
            "content": "そうでしょうか？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:37:45",
            "content": "そうだといいです。",
            "Chinese": "希望是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:38:16",
            "content": "そうですね、どう思われますか？",
            "Chinese": "是啊，您自己觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:39:23",
            "content": "うーん。うるさがられてるのかなと。",
            "Chinese": "嗯……可能他觉得我太烦了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:40:18",
            "content": "うんうん、そう思われるのも無理ないです。",
            "Chinese": "嗯嗯，您会这么想也是很正常的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:41:04",
            "content": "もしかしたら、言葉と気持ちとは裏腹な部分もあるかもしれませんね。",
            "Chinese": "也许，他说的话和心里的想法是相反的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:41:25",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:41:56",
            "content": "ここからはご提案なのですが、おつたえしていいでしょうか？",
            "Chinese": "接下来我有一些建议，可以跟您说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:42:01",
            "content": "お願いします",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:44:09",
            "content": "お話を聞いていて、中学二年生という時期はお母さんに反抗したい時期でもあると思いました。優子さんも言っていたように、異性より同性の親と話が盛り上がる時期なのかもしれません。",
            "Chinese": "听了您的话，我觉得初中二年级这个时期，也是孩子想要反抗母亲的时期。就像优子女士您说的那样，或许这也是一个比起异性父母，和同性父母聊天更能起劲的时期。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:45:04",
            "content": "お父さんにも相談したけど、あんまりな反応だったとのことですが、",
            "Chinese": "您也提到和父亲商量过，但他的反应不太积极，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:45:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:46:37",
            "content": "共働きとのことなので、お休みの日に環境を変えてどこかにお出かけして、そこで三人で今の優子さんの気持ち…じっくりお話ししてみるのはいかがでしょうか？",
            "Chinese": "既然是双职工，那么在休息日换个环境，一起出去走走，然后在那里三个人一起，把优子女士您现在的心情…好好地聊一聊，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:47:06",
            "content": "お休みの日に、ですね。なるほど。",
            "Chinese": "在休息日啊。原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:47:15",
            "content": "うまく言えるかな・・",
            "Chinese": "不知道我能不能好好表达……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:47:36",
            "content": "ええ、心配になりますよね。行く前に夫さんに",
            "Chinese": "嗯，确实会有点担心。出门前可以先和您先生——"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:47:51",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:48:48",
            "content": "【悩んでいる事をお話しする時間】を作るためにお出かけしたいと、お話しするのがポイントです",
            "Chinese": "关键是要告诉他，希望这次外出是为了创造一个【聊聊烦恼的时间】。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:49:19",
            "content": "なるほど。先に伝えておくんですね。",
            "Chinese": "原来如此。要先告诉他啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:50:20",
            "content": "心理学で【レディネス】という言葉があります。お話をする【心構え】をしてもらって夫さんに味方になってもらって、お話し進めてみるといいと思いますよ。",
            "Chinese": "心理学里有个词叫“准备度”（Readiness）。先让您先生做好【谈话的心理准备】，让他成为您的支持者，这样再推进谈话，我想会比较顺利。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:50:30",
            "content": "いかがでしょうか？",
            "Chinese": "您觉得如何？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:50:52",
            "content": "そうなんですね。わかりました！ちなみに子供には、どんな伝え方なら、受け取ってもらえるでしょう。",
            "Chinese": "是这样啊，我明白了！另外，跟孩子该怎么说，他才更容易接受呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:51:06",
            "content": "ええ、お伝えしますね",
            "Chinese": "好的，我来说说看。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:51:14",
            "content": "お願いします。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:51:41",
            "content": "優子さんが、息子さんの素敵だなと思うところはありますか？",
            "Chinese": "优子女士，您觉得儿子有哪些很棒的地方呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:51:54",
            "content": "素敵・・うーん。",
            "Chinese": "很棒的地方……嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:52:00",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:52:44",
            "content": "友達は多いみたいです。",
            "Chinese": "他朋友好像挺多的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:52:59",
            "content": "おお、なるほどですね！",
            "Chinese": "哦哦，原来如此！"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:53:33",
            "content": "あと、結構物知りです。",
            "Chinese": "还有，他懂的东西挺多的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:53:42",
            "content": "お友達にはどんな部分が好きになってもらっているんですかね？",
            "Chinese": "朋友们是喜欢他的哪些地方呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:53:52",
            "content": "物知り、いいですね",
            "Chinese": "懂得多，这很棒啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:54:18",
            "content": "よく話して面白いって言われるみたいです。",
            "Chinese": "他们好像说他很会聊天，很有趣。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:54:32",
            "content": "へぇ！",
            "Chinese": "是吗！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:54:50",
            "content": "そうですか、それでしたら",
            "Chinese": "这样啊，既然如此，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:56:10",
            "content": "「お母さんは物知りで友達も多い○○の事すごいなぁと思うし、いつも大切に思っている」",
            "Chinese": "“妈妈觉得你见多识广、朋友也多，真的很厉害，也一直很在乎你。”"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:56:38",
            "content": "といいところからお伝えして",
            "Chinese": "先从这些优点说起，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:56:52",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:57:18",
            "content": "でも最近お母さん寂しく思っている、理由は○○",
            "Chinese": "然后再说“但是最近妈妈觉得很寂寞，理由是……”，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:57:41",
            "content": "と優子さんの正直な気持ちをお伝えするといいと思います",
            "Chinese": "像这样把优子女士您真实的心情传达给他，我觉得会比较好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:57:48",
            "content": "いかがでしょうか？",
            "Chinese": "您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:57:51",
            "content": "なるほどです。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:58:00",
            "content": "話せそうな気がしてきました。",
            "Chinese": "我感觉好像能说出口了。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:58:05",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:58:36",
            "content": "おお、よかったです。あと、ゲームですが",
            "Chinese": "哦，那太好了。另外，关于游戏这件事，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:58:40",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:59:11",
            "content": "お父さんと三人で約束を作るといいと思いますよ",
            "Chinese": "我建议由你们三个人一起商量一个约定。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:59:21",
            "content": "そうですね。",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 10:59:41",
            "content": "３人で約束ですね。",
            "Chinese": "由三个人一起定约定，对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 10:59:52",
            "content": "例えば一時間とか。ポイントは息子さんが【自分で決める】です",
            "Chinese": "比如一个小时之类的。重点是要让儿子【自己决定】。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 11:00:03",
            "content": "いかがでしょうか？",
            "Chinese": "您觉得如何？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 11:00:25",
            "content": "わかりました。夫とも相談してみます。",
            "Chinese": "明白了。我也会和丈夫商量看看。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 11:01:34",
            "content": "ええ、是非相談してみて下さいね！ご家族思いの優子さんのお話し、お二人ともきっと聞いてくれますよ、心からおうえんしています！",
            "Chinese": "嗯，请一定和他商量看看！像优子女士这样为家人着想的人说的话，他们父子俩一定会听的，我真心为您加油！"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 11:01:44",
            "content": "ありがとうございます！",
            "Chinese": "谢谢您！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 11:01:57",
            "content": "今日はお話ししてみていかがでしたか？",
            "Chinese": "今天聊下来，您感觉如何？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 11:02:16",
            "content": "なんか明るい気持ちになってきました。",
            "Chinese": "感觉心情亮堂了不少。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 11:03:08",
            "content": "前向きに考えてみます。",
            "Chinese": "我会积极地去想一想。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/09(月) 11:03:24",
            "content": "優子さんの未来心から応援しています！またどうなったか教えてくださいね。本日はご相談に来ていただきありがとうございました。",
            "Chinese": "我真心为优子女士您的未来加油！之后情况如何也请告诉我哦。今天非常感谢您前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/09(月) 11:03:39",
            "content": "こちらこそありがとうございました。",
            "Chinese": "我也要谢谢您。"
        },
        {
