{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 17:52:00",
            "content": "(こんばんは。宜しくお願いします)",
            "Chinese": "（晚上好。请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 17:52:41",
            "content": "こんばんはよろしくお願いします。",
            "Chinese": "晚上好，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 17:53:29",
            "content": "18時に開始させていただきます。",
            "Chinese": "我们将在18点开始。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 17:53:48",
            "content": "(承知致しました)",
            "Chinese": "(好的，明白了。)"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:00:10",
            "content": "ご相談ありがとうございます。相談員にお繋ぎいたします。はじめに性別、年齢、お住まいの都道府県を教えてください。",
            "Chinese": "感谢您的咨询。现在为您接通咨询员。首先，请告诉我您的性别、年龄以及居住的都道府县。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:00:40",
            "content": "えっ",
            "Chinese": "诶？"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:01:17",
            "content": "23歳男です",
            "Chinese": "23岁，男性。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:01:54",
            "content": "何処に住んでるかも聞かれるんだ？",
            "Chinese": "连住在哪里也要问吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:02:03",
            "content": "教えて頂きありがとうございます。今日はどうされましたか？",
            "Chinese": "感谢您告知。今天您有什么困扰吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:02:24",
            "content": "そうですね。答えなくても大丈夫です。",
            "Chinese": "是的。不回答也没关系的。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:02:34",
            "content": "どうっていうか",
            "Chinese": "该怎么说呢……"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:03:20",
            "content": "うまくいえないけど",
            "Chinese": "虽然我说不太好……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:03:27",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:04:01",
            "content": "なんかやる気しないんだよね、何にも。",
            "Chinese": "就是感觉提不起劲，对什么事都一样。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:04:38",
            "content": "何に対してもモチベーションが上がらないんですね。",
            "Chinese": "也就是说，您对任何事情都提不起干劲呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:04:46",
            "content": "それが悩みです。",
            "Chinese": "这正是我的烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:05:02",
            "content": "それは悩みますね。",
            "Chinese": "这确实很让人烦恼呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:05:02",
            "content": "モチベーションて？",
            "Chinese": "干劲？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:05:26",
            "content": "モチベーション＝やる気みたいな感じです。",
            "Chinese": "“Motivation”差不多就是“干劲”的意思。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:05:53",
            "content": "あー、そうなんだあ",
            "Chinese": "啊，原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:06:27",
            "content": "いつからやる気を感じられないですか？",
            "Chinese": "您是从什么时候开始感觉没有干劲的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:07:03",
            "content": "何月何日なんて分かるわけないじゃん",
            "Chinese": "我怎么可能知道是几月几号啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:07:34",
            "content": "確かにそうですね。わからないですよね。",
            "Chinese": "确实如此呢，很难说得那么清楚。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:07:38",
            "content": "ここ半年とかいう感じ",
            "Chinese": "大概有半年左右吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:08:01",
            "content": "ここ半年やる気を感じられないんですね。",
            "Chinese": "这半年来您都感觉不到干劲是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:08:29",
            "content": "その前はやる気に満ち溢れていたのですか？",
            "Chinese": "在那之前是干劲十足的吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:08:40",
            "content": "何にもやる気になれない",
            "Chinese": "对什么都提不起劲。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:09:28",
            "content": "そんな次々言われたら答えらんねえじゃん",
            "Chinese": "你这么一个接一个地问，我怎么回答得过来啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:10:03",
            "content": "すいません。ゆっくりと質問させてもらいますね。",
            "Chinese": "抱歉，我会慢慢提问的。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:10:18",
            "content": "迷惑だったんですか",
            "Chinese": "我是给您添麻烦了吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:10:47",
            "content": "迷惑でないですよ。",
            "Chinese": "一点也不麻烦的。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:11:42",
            "content": "やる気満々だった訳じゃないけど",
            "Chinese": "倒也不是说以前干劲十足，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:12:17",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:12:39",
            "content": "仕事までやる気無いってヤバいっしょ",
            "Chinese": "连工作都提不起劲，这很糟糕吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:13:57",
            "content": "そういうお考えなんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:14:27",
            "content": "お考えってほどじゃないけど、",
            "Chinese": "也谈不上什么想法，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:15:25",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:15:31",
            "content": "とりあえず仕事くらいやるの普通だよね",
            "Chinese": "至少把工作做好是很正常的吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:16:22",
            "content": "なるほどですね。仕事は普通にやるというお考えなんですね。",
            "Chinese": "原来如此。您认为工作是理应正常去做的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:17:41",
            "content": "今回は仕事のやる気がなくなったからご相談されていることでよろしいでしょうか？",
            "Chinese": "这次来咨询，主要是因为对工作的干劲没了，是这样理解吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:18:10",
            "content": "普通に出来るようにならんと、マズイし、同僚・・・・・",
            "Chinese": "要是不能正常工作就糟了，而且同事……"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:18:40",
            "content": "ヨロシクナイです",
            "Chinese": "不是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:19:47",
            "content": "普通にできるようにならないとマズイのですね。同僚さんについてなにかお考えあるのですか？",
            "Chinese": "您觉得不能正常工作就很糟糕是吗？关于您的同事，您有什么想法吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:20:04",
            "content": "よろしくないのですね。わかりました。",
            "Chinese": "不是的是吗？我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:20:16",
            "content": "同僚にもこんな話出来ないし、はなしてもせいぜいやる気出せば、的っしょ。",
            "Chinese": "这种话也没法跟同事说，就算说了，顶多也是被一句“打起精神来”打发吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:21:28",
            "content": "相談したところで",
            "Chinese": "就算找人商量……"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:21:57",
            "content": "やる気が戻れるか分からんし。",
            "Chinese": "也不知道干劲能不能回来。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:22:46",
            "content": "それがイタイ。",
            "Chinese": "这点很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:22:46",
            "content": "同僚にやる気がでない話ができないんですね。",
            "Chinese": "也就是说，您没法跟同事谈自己提不起劲这件事。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:22:59",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:23:42",
            "content": "確かに相談したところで「やる気出せば」的な感じ言われても納得できないですよね。",
            "Chinese": "的确，就算找人商量，如果被说“打起精神来”之类的话，也很难接受呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:24:07",
            "content": "それなら相談しないほうがいいと思いますね。",
            "Chinese": "那样的话，我觉得还不如不商量的好。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:24:36",
            "content": "と思ってここに来ました。",
            "Chinese": "我就是这么想的，所以才来这里。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:25:37",
            "content": "友達や家族に話しても分かんないだろうし。",
            "Chinese": "跟朋友或家人说，他们大概也不会懂。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:26:24",
            "content": "それで今日来られたんですね。ありがとうございます。",
            "Chinese": "所以您今天才来的啊。非常感谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:26:52",
            "content": "確かに「やる気」とか口で説明されてもわからないですよね。",
            "Chinese": "确实，‘干劲’这种东西，光用语言解释也很难让人理解呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:26:58",
            "content": "こちらがお願いしてるんで、",
            "Chinese": "是我来拜托您的，"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:27:12",
            "content": "宜しくお願いします",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:27:32",
            "content": "どうしたら良いですか。",
            "Chinese": "我该怎么办才好？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:28:39",
            "content": "コールサックさんは好きなこととかありますか？例えばスポーツとか",
            "Chinese": "科尔萨克先生，您平时有什么喜欢的事情吗？比如运动之类的。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:29:05",
            "content": "え、名前分かるの？",
            "Chinese": "诶，你们能知道我的名字吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:29:22",
            "content": "ヤバくない？",
            "Chinese": "这不有点吓人吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:30:20",
            "content": "好きなこと・・・？",
            "Chinese": "喜欢的事情……？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:32:03",
            "content": "すいません。名前が表示されていることは説明不足でした。",
            "Chinese": "很抱歉，关于姓名会显示出来这一点，是我说明不充分。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:33:04",
            "content": "LINEのIDも分かるの？",
            "Chinese": "连LINE的ID也能看得到吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:33:49",
            "content": "今の仕事は好きですか？",
            "Chinese": "您喜欢现在的工作吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:34:04",
            "content": "ラインのIDはわかりません。",
            "Chinese": "我们无法看到您的LINE账号。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:35:45",
            "content": "すみませんが、オチます。",
            "Chinese": "不好意思，我要下线了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:36:16",
            "content": "何かありましたか？",
            "Chinese": "发生什么事了吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:37:00",
            "content": "空気読んで下さい",
            "Chinese": "请有点眼力见。"
        },
        {
            "role": "クライアント",
            "time": "2022/07/11(月) 18:37:19",
            "content": "レス不",
            "Chinese": "不再回复。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/07/11(月) 18:38:57",
            "content": "今回ご相談ありがとうございました。また機会があればきてください。",
            "Chinese": "感谢您这次的咨询。如果还有机会，欢迎您再来。"
        }
    ],
