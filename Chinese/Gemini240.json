{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 16:56:15",
            "content": "こんにちはよろしくお願いします",
            "Chinese": "您好，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 16:56:40",
            "content": "こんにちはこちらこそよろしくお願いいたします",
            "Chinese": "您好，我也请您多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 16:57:33",
            "content": "これから、すぐ始めますかいかがいたしましょうか",
            "Chinese": "接下来，我们马上开始吗？您希望怎么做呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 16:57:57",
            "content": "始めて大丈夫です",
            "Chinese": "可以开始了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 16:58:17",
            "content": "それでは、始めます",
            "Chinese": "那么，我们开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 16:58:28",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 16:58:51",
            "content": "こんにちは相談員です。本日は、いかがされましたか",
            "Chinese": "您好，我是咨询师。今天您有什么事想谈谈吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 16:59:17",
            "content": "こんにちは最近学校行きたくないんです",
            "Chinese": "您好，我最近不太想去学校。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 16:59:39",
            "content": "そうなんですねそれはお辛いですね",
            "Chinese": "这样啊，那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 16:59:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:00:24",
            "content": "最近、行きたくないと思われたきっかけは、心当たりありますか",
            "Chinese": "您最近开始不想去上学，是有什么契机或原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:00:50",
            "content": "やる気が起きない",
            "Chinese": "就是提不起干劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:01:18",
            "content": "そうなんですねお辛いですね",
            "Chinese": "是这样啊，那您一定很难受。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:01:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:01:55",
            "content": "どんな時に、やる気が出ないですか",
            "Chinese": "在什么情况下会提不起劲呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:02:20",
            "content": "何をやってもやる気がでないです",
            "Chinese": "不管做什么都提不起干劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:03:00",
            "content": "そうなんですねお困りですよね",
            "Chinese": "这样啊，这一定让您很困扰吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:03:24",
            "content": "自分でも何でかわからない",
            "Chinese": "连我自己也不知道为什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:03:41",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:04:05",
            "content": "食事や睡眠は、きちんととれていますか",
            "Chinese": "您的饮食和睡眠都规律吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:04:36",
            "content": "夜更かしが多くなった気がする食事はちゃんととれてます",
            "Chinese": "感觉最近熬夜变多了，不过饮食还是规律的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:05:18",
            "content": "何時に寝て、何時ごろ、起きますか",
            "Chinese": "您几点睡觉，大概几点起床呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:05:45",
            "content": "12時頃寝て7時頃起きます",
            "Chinese": "大约12点睡觉，7点左右起床。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:06:22",
            "content": "夜更かしは、どのようなことをされていますか",
            "Chinese": "您熬夜的时候一般都在做什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:06:49",
            "content": "友達とLINEとかゲームかな",
            "Chinese": "和朋友在LINE上聊天，或者玩游戏吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:07:26",
            "content": "そうなんですねそれは、お疲れですよね",
            "Chinese": "这样啊，那也会挺累的吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:07:45",
            "content": "まぁ、そうかもしれません",
            "Chinese": "嗯，或许是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:08:40",
            "content": "他には、何か、趣味をお持ちですか",
            "Chinese": "除此之外，您还有什么其他的兴趣爱好吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:08:56",
            "content": "テニスです",
            "Chinese": "网球。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:09:32",
            "content": "そうなんですねテニス、良いですね",
            "Chinese": "这样啊，网球不错呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:09:46",
            "content": "楽しいです",
            "Chinese": "很有趣。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:10:11",
            "content": "そうですねそれは、良かったです",
            "Chinese": "是啊，那真是太好了。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:10:28",
            "content": "でも今はできないんで",
            "Chinese": "但是现在打不了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:10:45",
            "content": "どうしてですか",
            "Chinese": "为什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:10:58",
            "content": "部活休みなんです",
            "Chinese": "社团活动暂停了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:11:25",
            "content": "そうなんですね寂しいですね",
            "Chinese": "这样啊，那会觉得很失落吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:11:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:11:48",
            "content": "どうして、休みなんですか",
            "Chinese": "为什么暂停了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:12:03",
            "content": "コロナの関係です",
            "Chinese": "因为疫情的关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:12:24",
            "content": "そうなんですね嫌ですよね",
            "Chinese": "原来如此，真是让人烦恼呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:13:01",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:13:18",
            "content": "すると、今は、ずっと家にいるのですかそれとも、外には出ておられるんですか",
            "Chinese": "那么，您现在是一直待在家里，还是会出门呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:13:49",
            "content": "学校には週3回行ってますそれ以外は家です",
            "Chinese": "学校一周去3次，其他时间都在家。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:14:05",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:14:46",
            "content": "学校では、どんなことをされていますか",
            "Chinese": "在学校都做些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:15:06",
            "content": "授業受けるだけです",
            "Chinese": "就只是上课而已。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:15:37",
            "content": "そうなんですね座ってばかりだと、息が詰まりますよね",
            "Chinese": "我了解，老是坐着也会觉得憋闷吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:16:05",
            "content": "人と騒いでいけないって先生から言われるんで",
            "Chinese": "因为老师说不能和别人吵闹。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:16:44",
            "content": "そうなんですねそれも、もどかしいですね",
            "Chinese": "我明白，那也挺让人憋屈的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:17:00",
            "content": "はい、そうですね",
            "Chinese": "是的，确实如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:17:13",
            "content": "何年生ですか",
            "Chinese": "您上几年级？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:17:28",
            "content": "高1です",
            "Chinese": "高一。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:17:56",
            "content": "そうですか。",
            "Chinese": "这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:20:10",
            "content": "ご自身では、どんなことが、やる気がしないと、何か感じること、心当たりは、ありますか",
            "Chinese": "关于提不起劲这件事，您自己有没有感觉到可能的原因，或者有什么头绪吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:20:57",
            "content": "せっかく受験頑張って高校入ったのに、入学式もない。学校行っても勉強だけ。つまんない",
            "Chinese": "好不容易努力考上了高中，结果连开学典礼都没有。去学校也只是学习，好无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:21:45",
            "content": "そうなんですねそれは、つまらないですよね",
            "Chinese": "这样啊，那确实会觉得很无聊呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:22:03",
            "content": "週3だから友達もほとんどできない",
            "Chinese": "因为一周只去三天，所以几乎交不到朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:22:30",
            "content": "そうなんですね友達も、出来づらいですよね",
            "Chinese": "是啊，确实很难交到朋友呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:22:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:22:56",
            "content": "何とお呼びしたらよろしいですか",
            "Chinese": "我该怎么称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:23:10",
            "content": "ようこです",
            "Chinese": "我叫洋子。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:25:01",
            "content": "ようこさん、高校に、入学して、学校生活をとても楽しみにしていたのに、入学式もなく、友達も、出来ずらくて、とても悔しいですね",
            "Chinese": "洋子同学，您考上高中后一定非常期待校园生活，结果却没有入学典礼，也很难交到朋友，一定觉得很遗憾吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:25:29",
            "content": "とても、悲しいことと思います",
            "Chinese": "这一定很让人难过。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:25:40",
            "content": "悔しくはないかな",
            "Chinese": "倒也不是遗憾吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:25:54",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:25:55",
            "content": "とにかくつまらないです",
            "Chinese": "总之就是很无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:26:08",
            "content": "つまらないのですね",
            "Chinese": "感到很无聊啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:27:38",
            "content": "そのつまらなさから、悲しくて、寂しくて、心細くて、何にもやる気がしないのと思います",
            "Chinese": "我想，正是因为这种无聊感，让您感到悲伤、寂寞、无助，所以才对什么都提不起干劲。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:27:57",
            "content": "そうなんですかね",
            "Chinese": "也许吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:28:45",
            "content": "ゲームをやったり、友達と、ラインをやるのも、その心を埋める気持ちなのかもしれません",
            "Chinese": "玩游戏，或者和朋友聊LINE，或许也是为了填补内心的这种空虚感吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:29:22",
            "content": "もともとゲームは好きなんで",
            "Chinese": "我本来就喜欢玩游戏。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:29:34",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:31:48",
            "content": "ようこさんは、学校生活を、とても頑張って有意義な学校生活にしようと頑張っている、とても努力家の方だと思います",
            "Chinese": "我觉得洋子同学非常努力，一直希望让校园生活变得充实有意义。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:32:41",
            "content": "いや、そんな訳でも。。。ただ普通に学校通いたいです",
            "Chinese": "没有啦，也不至于……只是想正常去学校而已。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:32:56",
            "content": "そうですか",
            "Chinese": "这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:34:28",
            "content": "学校を通いたいと思っているということは、一生懸命、学校生活を送りたいということだと思いますが、いかがですか",
            "Chinese": "您想去上学，我想这也就意味着您是想认真地度过校园生活的，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:34:54",
            "content": "一生懸命って感じでもないです",
            "Chinese": "也谈不上是认真的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:35:37",
            "content": "家に帰ってからの楽しみは、何かありませんか",
            "Chinese": "回到家之后，有什么让您期待的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:35:56",
            "content": "ゲームとLINE",
            "Chinese": "玩游戏和聊LINE。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:36:07",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:38:14",
            "content": "それでは、ゲームとラインを、一番の楽しみにされて、ようこさんのご褒美とされては、いかかでしょうかそして、学校生活の足りない部分を、家で補うのも、良いと思いますが、いかがですか",
            "Chinese": "那么，把玩游戏和聊LINE当作最大的乐趣，作为给自己的奖励，您觉得怎么样呢？然后，在家里弥补学校生活中不足的部分，我觉得也不错，您认为呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:38:48",
            "content": "高校1年生と言えば、進路の勉強もあると思います",
            "Chinese": "说到高一，可能也要开始做一些升学或未来规划方面的学习。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:39:15",
            "content": "よくわかりません",
            "Chinese": "我不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:39:28",
            "content": "どうしてですか",
            "Chinese": "为什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:39:53",
            "content": "勉強は好きではないです",
            "Chinese": "我不太喜欢学习。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:40:06",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:40:27",
            "content": "どうな勉強が好きですか",
            "Chinese": "那您喜欢什么样的学习呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:40:57",
            "content": "勉強は嫌いです",
            "Chinese": "我讨厌学习。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/23(木) 17:41:46",
            "content": "どんな科目が、好きですか",
            "Chinese": "那您喜欢哪些科目呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/23(木) 17:42:03",
