{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:00:07",
            "content": "こんにちは。相談員です。",
            "Chinese": "您好。我是咨询师。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:00:30",
            "content": "本日はよろしくお願いします。",
            "Chinese": "今天请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:00:58",
            "content": "よろしくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:01:13",
            "content": "ありがとうございます。初めに、お年と性別をお伺いできますか？",
            "Chinese": "谢谢您。首先，可以请问您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:01:37",
            "content": "お年ってなんですか",
            "Chinese": "“年纪”是什么意思？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:02:11",
            "content": "はい。ご年齢をお聞かせいただけますか？",
            "Chinese": "好的。请问您能告诉我您的年龄吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:02:23",
            "content": "14",
            "Chinese": "14"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:02:30",
            "content": "男",
            "Chinese": "男"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:02:38",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:03:04",
            "content": "本日は、どのようなご相談でお越しいただきましたか？",
            "Chinese": "今天您来是想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:03:13",
            "content": "辛いです",
            "Chinese": "我很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:03:34",
            "content": "そうなんですね...お辛い状況なんですね...",
            "Chinese": "是这样啊……您现在的处境很难受啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:04:01",
            "content": "お話しできる範囲で構いません。少し詳しくお伺いできますか？",
            "Chinese": "在您方便说的范围内就好。能稍微详细地跟我说一下情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:04:34",
            "content": "とにかく辛いです",
            "Chinese": "总之就是很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:04:55",
            "content": "そうなんですね...",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:05:17",
            "content": "そんなにお辛いんですね...",
            "Chinese": "原来这么难受啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:06:04",
            "content": "今のようなお気持ちは、いつ頃からですか？",
            "Chinese": "您现在这样的心情，是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:06:25",
            "content": "思い出せません",
            "Chinese": "我想不起来了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:07:10",
            "content": "そうですか...お辛い時に、ここへ来てくださって、ありがとうございます。",
            "Chinese": "是这样啊……在您这么难受的时候，还能来到这里，非常感谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:07:34",
            "content": "睡眠やお食事は取れていますか？",
            "Chinese": "您的睡眠和饮食还好吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:07:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:07:59",
            "content": "それは少し安心しました。",
            "Chinese": "听到这个我稍微放心了一些。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:08:21",
            "content": "今、どちらにいらっしますか？",
            "Chinese": "您现在在哪里呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:08:45",
            "content": "どこでもよくないですか",
            "Chinese": "在哪儿不都一样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:09:37",
            "content": "そうですね。ごめんなさい。お話ししたくないことはお話ししなくて大丈夫です。",
            "Chinese": "您说的是。对不起。不想说的事情可以不说的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:11:02",
            "content": "一番お辛いと感じるのは、どんな時ですか？",
            "Chinese": "您觉得最难受的是在什么时候呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:11:10",
            "content": "いつもです",
            "Chinese": "一直都是。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:11:32",
            "content": "そうなんですね。それは苦しいですね...",
            "Chinese": "是这样啊。那一定很痛苦吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:12:13",
            "content": "苦しいと感じた時は、どうやって過ごされるんですか？",
            "Chinese": "感到痛苦的时候，您是怎么度过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:12:26",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:13:06",
            "content": "そうなんですね...",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:14:37",
            "content": "お話し伺っていますと、とても苦しくて、お困りなことがあるのかと思います。",
            "Chinese": "听您这么说，我觉得您可能非常痛苦，并且遇到了什么困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:15:27",
            "content": "お辛いお気持ちは、周りの方にお話しできていますか？",
            "Chinese": "您这种难受的心情，有对身边的人说过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:15:42",
            "content": "いいえ",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:16:00",
            "content": "そうなんですね。今何年生ですか？",
            "Chinese": "是这样啊。您现在几年级？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:16:08",
            "content": "2",
            "Chinese": "二年级。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:16:26",
            "content": "中学2年生でいいですか？",
            "Chinese": "是初中二年级，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:16:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:17:06",
            "content": "お辛くなるきっかけは、何かありますか？",
            "Chinese": "有什么契机让您开始感到难受的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:17:13",
            "content": "思い出せません",
            "Chinese": "我想不起来了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:18:14",
            "content": "そうなんですね...",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:19:24",
            "content": "今のお気持ちを、どうしたいと思いますか？",
            "Chinese": "对于现在的心情，您希望它变成什么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:19:33",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:20:00",
            "content": "そうなんですね。それでもここへ連絡してくれたんですね...",
            "Chinese": "是这样啊。即使如此，您还是联系了我们……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:20:57",
            "content": "お話ししようと思ってくれて、よかったです。",
            "Chinese": "您愿意来倾诉，真是太好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:22:36",
            "content": "どんなことでも構いません。私は、あなたのお気持ちが少しでも楽になるような方法をご一緒に考えたいと思います。お話しできることから、お聞かせいただけますか？",
            "Chinese": "什么都可以。我希望能和您一起，想办法让您的心情哪怕能轻松一点点。能从您方便说的事情开始告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:23:45",
            "content": "何を話せば良いかわかりません",
            "Chinese": "我不知道该说什么好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:24:04",
            "content": "そうですよね。いきなり、わからないですよね。",
            "Chinese": "说的也是。突然要说，您也不知道该从何说起吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:24:38",
            "content": "では、私からお聞きするので、話せそうなことだけ、お話しいただけますか？",
            "Chinese": "那么，我来问您问题，您只回答您觉得方便说的部分，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:24:52",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:25:09",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:25:37",
            "content": "中学2年生とおっしゃっていましたけど、公立の学校ですか？",
            "Chinese": "您刚才说是初中二年级，请问是公立学校吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:25:58",
            "content": "それって関係ありますか",
            "Chinese": "这有关系吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:27:10",
            "content": "そうですね、地域の学校にお通いなのか、お伺いしようと思いましたが、答えたくなければ、答えていただかなくても大丈夫です。",
            "Chinese": "您说的是。我是想了解您是不是在当地的学校就读，不过如果您不想回答，不说也没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:27:38",
            "content": "ご家族は何人家族なんですか？",
            "Chinese": "您家里有几口人呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:27:46",
            "content": "3人",
            "Chinese": "3个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:28:24",
            "content": "ありがとうございます。ご両親とあなたでよろしいですか？",
            "Chinese": "谢谢您。是您的父母和您三位，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:28:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:30:07",
            "content": "お母さん、お父さんは、どんなご両親なんですか？",
            "Chinese": "您的爸爸妈妈是怎样的父母呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:30:26",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:30:50",
            "content": "わかりづらいですよね。",
            "Chinese": "确实不太好描述呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:31:43",
            "content": "お勉強のことなど、厳しかったり、優しかったり、いかがですか？",
            "Chinese": "比如在学习方面，他们是比较严格，还是比较温和呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:32:01",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:32:48",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:33:23",
            "content": "あなたが好きなこと、は何ですか？",
            "Chinese": "您喜欢做什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:33:35",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:34:07",
            "content": "そうですか...では、好きな食べ物、は？",
            "Chinese": "是吗……那喜欢的食物呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:34:23",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:35:06",
            "content": "そうなんですね。では、嫌いなものは、何かありますか？",
            "Chinese": "是这样啊。那么，有什么讨厌的东西吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:35:15",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:35:28",
            "content": "嫌いな人、とか",
            "Chinese": "比如说，不喜欢的人之类的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:35:44",
            "content": "それもわかりません",
            "Chinese": "那个我也不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:36:25",
            "content": "そうなんですね。でも、辛い、というお気持ちは感じるんですよね...",
            "Chinese": "是这样啊。但是，您能感觉到“难受”这种心情，是吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:37:26",
            "content": "これは私が感じたこと、なんですが、お話ししてもいいですか？",
            "Chinese": "这是我的一点感受，可以说给您听听吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:37:32",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:38:28",
            "content": "いろいろな感情や感覚、美味しいとか、楽しいとか、...そんなことを感じられなくなっているのでしょうか？",
            "Chinese": "您是不是对各种各样的感情和感觉，比如‘好吃’、‘开心’之类的……都感觉不到了呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:39:03",
            "content": "よくわかりません",
            "Chinese": "我不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:40:03",
            "content": "そうなんですね...でも、お辛いんですね",
            "Chinese": "是这样啊……但您还是觉得难受，是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:41:10",
            "content": "辛いという感覚だけを感じているのだとしたら、それはすごくやりきれない、息苦しいのではないでしょうか...",
            "Chinese": "如果只能感觉到‘难受’这一种感觉，那一定非常难以承受，让人喘不过气来吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:41:56",
            "content": "どうなんでしょうね",
            "Chinese": "这就不太清楚了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:42:52",
            "content": "あくまで、私の感じたことなんですが...お食事はできているとおっしゃっていましたが、味は感じていますか？",
            "Chinese": "这只是我的个人感受……您刚才说还能吃饭，那味道能尝到吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:43:07",
            "content": "はい",
            "Chinese": "能。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:43:38",
            "content": "よかったです。お腹も空きますか？",
            "Chinese": "那就好。肚子会饿吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:43:44",
            "content": "はい",
            "Chinese": "会。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:44:05",
            "content": "何をしているときが楽ですか？",
            "Chinese": "做什么的时候会觉得轻松一些呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:44:28",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:45:08",
            "content": "そうなんですね。でも、ご飯食べているのは、おいしく思うこともあるんですね",
            "Chinese": "是这样啊。不过，吃饭的时候有时还是会觉得好吃的，对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:45:50",
            "content": "学校へはいっていますか？",
            "Chinese": "您有去学校吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/21(火) 14:46:20",
            "content": "はい",
            "Chinese": "有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/21(火) 14:46:56",
