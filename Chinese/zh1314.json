    },
    {
      "role": "counselor",
      "time": "2021-02-09T20:32:49",
      "origin": "そう思われるお気持ちもすごくわかります。",
      "content": "我非常理解您这样的心情。"
    },
    {
      "role": "client",
      "time": "2021-02-09T20:33:11",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "counselor",
      "time": "2021-02-09T20:33:31",
      "origin": "今は1人暮らしなのでしょうか？",
