{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 19:51:31",
            "content": "お越しいただきありがとうございます。準備が出来ましたら始めさせていただきますね。",
            "Chinese": "感谢您的到来。如果您准备好了，我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 19:53:27",
            "content": "こんばんわ。宜しくお願い致します。",
            "Chinese": "晚上好。请多多指教。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 19:53:48",
            "content": "準備オッケーです",
            "Chinese": "准备好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 19:54:16",
            "content": "こんばんは。ありがとうございます。よろしくお願いします。",
            "Chinese": "晚上好。谢谢您。请多多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 19:54:51",
            "content": "相談員です。今日はどのようなご相談でしょうか？",
            "Chinese": "我是咨询师。今天您想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 19:55:38",
            "content": "好きな人が居るのですが、家族に反対されていて、どうしたらいいのか悩んでます",
            "Chinese": "我有喜欢的人，但家人反对，不知道该怎么办，很烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 19:56:51",
            "content": "そうなのですね。よろしければ年令と性別を教えていただけますか？",
            "Chinese": "是这样啊。如果方便的话，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 19:57:13",
            "content": "2５歳　女です",
            "Chinese": "25岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 19:57:51",
            "content": "ありがとうございます。何とお呼びすればよろしいですか？",
            "Chinese": "谢谢您。我该怎么称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 19:58:03",
            "content": "ゆき　です",
            "Chinese": "我叫雪。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 19:58:57",
            "content": "ゆきさんですね。良ければもう少し詳しく教えていただけますか？",
            "Chinese": "是雪小姐吧。如果您方便的话，能再详细地讲讲吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 19:59:05",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:00:17",
            "content": "家族は私に家を継いで欲しいのですが、暴言を吐く父が嫌いで家を出て、そこで彼と出会いました",
            "Chinese": "家人希望我继承家业，但我因为讨厌口出恶言的父亲而离家出走，在那里遇到了他。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:00:36",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:00:41",
            "content": "私に彼が居ると知り、",
            "Chinese": "家人知道我有了男朋友后，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:00:54",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:01:03",
            "content": "父は激怒。直ぐに帰って来いと、、",
            "Chinese": "父亲勃然大怒，让我立刻回家……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:01:35",
            "content": "そうなのですね...",
            "Chinese": "原来是这样啊…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:01:47",
            "content": "そこで母も姉も交際に反対で、味方は居ません",
            "Chinese": "然后母亲和姐姐也反对我们交往，没有人支持我。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:02:23",
            "content": "悩んでます",
            "Chinese": "我很苦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:02:28",
            "content": "それはゆきさんにとってとてもお辛いですね...",
            "Chinese": "这对雪小姐您来说，一定非常痛苦吧…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:02:53",
            "content": "お父様は",
            "Chinese": "您父亲……"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:03:07",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:03:18",
            "content": "家を継いでほしいとのことですが",
            "Chinese": "听说他们希望您继承家业，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:03:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:03:48",
            "content": "ゆきさんは長女でいらっしゃいますか？",
            "Chinese": "雪小姐是长女吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:04:03",
            "content": "いえ、姉が居ます",
            "Chinese": "不，我有个姐姐。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:04:45",
            "content": "お父様がゆきさんに継いでほしいという理由があるのでしょうか？",
            "Chinese": "您的父亲希望由您来继承家业，是有什么原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:04:54",
            "content": "はい",
            "Chinese": "有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:05:27",
            "content": "よろしければ理由を教えていただけますか？",
            "Chinese": "如果方便的话，能告诉我原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:05:55",
            "content": "姉と父は似たもの同士で、直ぐに喧嘩になります。さらに姉は病気で子が産めません。",
            "Chinese": "姐姐和父亲性格很像，动不动就吵架。而且姐姐因为生病无法生育。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:06:31",
            "content": "だから、子が産める私に後を継いで欲しいと、母から聞きました",
            "Chinese": "所以，我听母亲说，他们希望能够生育的我来继承家业。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:06:32",
            "content": "そうなのですね...",
            "Chinese": "原来是这样啊…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:06:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:07:33",
            "content": "ゆきさんにとっては深刻なことですね...",
            "Chinese": "对雪小姐来说，这确实是个很严重的问题…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:07:50",
            "content": "はい、とても深刻です。",
            "Chinese": "是的，非常严重。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:08:49",
            "content": "ゆきさんの好きな方はそのことをご存知なのでしょうか？",
            "Chinese": "您喜欢的那位，知道这些情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:09:13",
            "content": "はい、すべて知ってます",
            "Chinese": "是的，他全都知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:09:48",
            "content": "彼は何とおっしゃっていますか？",
            "Chinese": "他是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:10:49",
            "content": "悩んでいました。私にそばに居て欲しいと思ってはいるのですが、私が悲しむのは見たくないと・・",
            "Chinese": "他也很纠结。他希望我能在他身边，但又不想看到我难过……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:11:31",
            "content": "彼も複雑な気持ちを抱えていらっしゃるのですね...",
            "Chinese": "看来他也有着复杂的心情呢…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:12:11",
            "content": "はい、私が悩み、苦しむので、、",
            "Chinese": "是的，因为我烦恼、痛苦……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:12:23",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:12:34",
            "content": "どうしたら泣かずに解決できるかを",
            "Chinese": "他在想，要怎样才能在不让我伤心的情况下解决问题，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:12:45",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:12:46",
            "content": "考えてはくれていましたが、",
            "Chinese": "他虽然有在为我考虑，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:13:05",
            "content": "最後は自分で決めて欲しい、みたいな感じです。",
            "Chinese": "但感觉上，他还是希望最后由我自己来决定。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:13:50",
            "content": "母が、、",
            "Chinese": "母亲她……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:14:12",
            "content": "彼は自分のことよりもゆきさんのことを思っていらっしゃるのですね。",
            "Chinese": "比起自己的事，他更是为您着想呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:14:16",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:15:34",
            "content": "お母様が最後は自分で決めてほしいとゆきさんに伝えられたのですか？",
            "Chinese": "是您的母亲告诉您，希望您最后自己做决定吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:16:26",
            "content": "彼は、はい、そう感じました。いえ、違います母は、父に暴言を受けて、精神的に参ってしまい、私に助けを求めてるのが分かるんです。",
            "Chinese": "关于他，是的，我是那么感觉的。不，不是的。我母亲因为受到父亲的恶言，精神上已经不堪重负，我能感觉到她是在向我求助。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:16:46",
            "content": "そうなのですね...",
            "Chinese": "原来是这样啊…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:16:50",
            "content": "母は、子の産めない体の",
            "Chinese": "母亲因为生下了"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:17:03",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:17:05",
            "content": "長女を生んだことも責めています",
            "Chinese": "无法生育的长女而责备自己。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:17:32",
            "content": "だから、姉も母も父も私を頼ってる",
            "Chinese": "所以，姐姐、母亲和父亲都依靠着我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:17:49",
            "content": "お母様も辛い思いを抱えているのですね...",
            "Chinese": "您的母亲也背负着痛苦的感受呢…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:17:56",
            "content": "けれど",
            "Chinese": "不过，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:18:03",
            "content": "はい、自分を責めてます",
            "Chinese": "是的，她一直在自责。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:18:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:18:22",
            "content": "一番辛い思いをされているのはゆきさんだと思います。",
            "Chinese": "我想，承受最多痛苦的人还是雪小姐您。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:18:43",
            "content": "ええ！そうなんですか？",
            "Chinese": "诶！是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:19:14",
            "content": "家族のみなさんがゆきさんに",
            "Chinese": "您的家人们都希望雪小姐您"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:19:45",
            "content": "継いでもらうことを望まれて",
            "Chinese": "能够继承家业，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:20:49",
            "content": "ゆきさんも家族と彼のどちらも大切で辛さを抱えているのではと感じました。",
            "Chinese": "而我感到您对家人和男友双方都很重视，因此承受着痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:21:36",
            "content": "はい、そうです。どちらかを選ばないといけないのはキツイです",
            "Chinese": "是的，就是这样。必须要二选一，这太辛苦了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:22:01",
            "content": "そうですよね...",
            "Chinese": "是啊…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:22:11",
            "content": "ゆきさんは",
            "Chinese": "雪小姐您"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:23:08",
            "content": "継ぐことに抵抗はあるのでしょうか？",
            "Chinese": "对继承家业这件事，心里是有抵触的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:23:35",
            "content": "抵抗あります。嫌なのです。",
            "Chinese": "有抵触。我很讨厌。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:23:51",
            "content": "そうなのですね...",
            "Chinese": "是这样啊…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:24:17",
            "content": "はい、継がなくてもいいから、",
            "Chinese": "是的，就算不继承家业，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:24:25",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:25:22",
            "content": "近くの人と結婚して住んで、子を見せてやって欲しいと、自分にはそれが出来ないから姉に泣きながら土下座されました。",
            "Chinese": "姐姐因为自己做不到，哭着向我下跪，求我嫁给附近的人住下来，好让他们能看到孩子。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:26:00",
            "content": "姉は、",
            "Chinese": "姐姐她，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:26:16",
            "content": "病気で子が産めない体になったとき",
            "Chinese": "在因病变得无法生育的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:26:16",
            "content": "泣きながら土下座されることは胸が痛みますね...",
            "Chinese": "被哭着下跪哀求，想必您也很心痛吧…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:26:20",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:26:21",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:27:28",
            "content": "姉と親元を離れ一緒に暮らしてたんです",
            "Chinese": "我曾经和姐姐一起离开父母家生活。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:27:49",
            "content": "そうなのですね...",
            "Chinese": "是这样啊…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:28:01",
            "content": "病気で手術して、姉が死にたいほど苦しんだ姿を",
            "Chinese": "姐姐因病手术后，那痛苦到想死的样子，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:28:12",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:28:20",
            "content": "見ていたもので、",
            "Chinese": "我都看在眼里，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:28:32",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:28:55",
            "content": "姉の土下座は、彼と別れる気持ちに今傾きつつ",
            "Chinese": "所以姐姐的下跪，让我现在渐渐倾向于和男友分手，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:29:02",
            "content": "ここにきました",
            "Chinese": "才来到了这里。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:29:52",
            "content": "ゆきさんはとても辛い気持ちを抱えていたことをお話し下さったのですね...",
            "Chinese": "原来您是抱着如此痛苦的心情，才来向我倾诉的…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:30:06",
            "content": "はい、ありがとうございます。",
            "Chinese": "是的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:30:49",
            "content": "聞かせていただき私自身、胸が締め付けられます...",
            "Chinese": "听了您的诉说，我自己也感到心头一紧…"
