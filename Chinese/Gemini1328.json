        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:32:23",
            "content": "そうなのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:32:27",
            "content": "というか、私がしました",
            "Chinese": "应该说，是我提出来的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:32:48",
            "content": "ご家族は何とおっしゃっていましたか？",
            "Chinese": "您的家人是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:33:12",
            "content": "彼は父が早くに他界したので、母と自分の二人暮らし",
            "Chinese": "他父亲早逝，一直和母亲两个人生活。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:33:24",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:33:29",
            "content": "お嫁さんが来るのをとても楽しみにしている",
            "Chinese": "他的母亲非常期待儿媳妇的到来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:33:40",
            "content": "そうなのですね...",
            "Chinese": "是这样啊…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:33:50",
            "content": "だから、厳しいと。",
            "Chinese": "所以，这件事很难办。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:34:13",
            "content": "ゆきさんも彼も",
            "Chinese": "雪小姐您和您的男友"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:34:38",
            "content": "ご家族の思いを受けているのですね...",
            "Chinese": "都承载着各自家人的期望呢…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:35:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:35:57",
            "content": "とても複雑なことだと思うので、ゆきさんと彼が",
            "Chinese": "我觉得这件事非常复杂，所以关于您和他的事，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:36:37",
            "content": "幸せになれる方法を一つ一つ、一緒に考えさせていただけますか？",
            "Chinese": "可以让我和您一起，一步步地思考能让您和男友都获得幸福的方法吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:36:50",
            "content": "はい、お願いします",
            "Chinese": "好的，拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:37:44",
            "content": "ゆきさんの思いはこういう形に出来たらいいなということはありますか？",
            "Chinese": "在雪小姐您的心中，有没有“如果能以这种形式解决就好了”之类的想法呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:38:39",
            "content": "母が精神疾患なので、それがなかったら",
            "Chinese": "我母亲有精神疾病，如果不是因为这个，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:38:48",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:39:28",
            "content": "父に何とか、と思うのですが",
            "Chinese": "我本想或许能想办法说服父亲，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:39:43",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:40:03",
            "content": "父は彼の話を聴きもしてくれません",
            "Chinese": "但父亲连听都不愿意听关于他的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:40:17",
            "content": "そうなのですね...",
            "Chinese": "是这样啊…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:40:19",
            "content": "父は弱い人で",
            "Chinese": "我父亲是个软弱的人，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:40:25",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:41:01",
            "content": "大声出して怒鳴って威圧したらいいと思ってる。彼にそんな父に合わせるのも怖いです",
            "Chinese": "他觉得只要大声吼叫威吓就好了。让男友去面对那样的父亲，我也很害怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:41:21",
            "content": "そうですよね...",
            "Chinese": "是啊…"
        },
        {
            "role": "クライアント",
            "time": "2021/02/11(木) 20:41:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 20:41:48",
            "content": "まずはお父様とお母様の",
            "Chinese": "我想，首先如果能让您的父母"
