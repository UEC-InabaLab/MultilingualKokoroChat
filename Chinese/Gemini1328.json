            "role": "クライアント",
            "time": "2021/02/11(木) 21:03:21",
            "content": "ですが。",
            "Chinese": "但是。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/11(木) 21:03:27",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
