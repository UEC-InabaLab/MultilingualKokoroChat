        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:50:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:50:50",
            "content": "了解です。",
            "Chinese": "明白了。"
