{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:00:08",
            "content": "こんばんは相談員です。よろしくお願いいたします。",
            "Chinese": "晚上好，我是咨询师。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:00:27",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:00:41",
            "content": "最初に年齢と性別を教えていただけますか？",
            "Chinese": "首先，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:01:27",
            "content": "17歳、男性です。",
            "Chinese": "17岁，男性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:01:43",
            "content": "お返事ありがとうございます。",
            "Chinese": "感谢您的回复。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:01:58",
            "content": "学年も教えていただけますか？",
            "Chinese": "能告诉我您的年级吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:02:18",
            "content": "高3です。",
            "Chinese": "高三。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:02:31",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:02:45",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:04:24",
            "content": "受験生なのですが、やる気が起きないのです。",
            "Chinese": "我是考生，但是提不起劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:04:57",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:05:29",
            "content": "状況をもう少し教えていただけますか？",
            "Chinese": "能再详细告诉我一些具体情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:08:15",
            "content": "朝から塾に行って夜までずっといるのですが、全然成績も上がらないし、勉強も進みません。",
            "Chinese": "我从早到晚都在补习班，但成绩完全没有提高，学习也毫无进展。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:09:16",
            "content": "一日中頑張っているんですね。",
            "Chinese": "您一整天都在努力呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:10:00",
            "content": "全然頑張れていません。",
            "Chinese": "完全谈不上努力。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:10:40",
            "content": "ご自身ではそう感じているんですね‥",
            "Chinese": "您自己是这么感觉的啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:11:17",
            "content": "はい。周りはもっと頑張っていますし。",
            "Chinese": "是的。而且周围的同学都比我更努力。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:11:32",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:11:40",
            "content": "何か気になっていることでもあるのですか？",
            "Chinese": "有没有什么让您在意的事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:12:09",
            "content": "体重がどんどん増えているのです。",
            "Chinese": "我的体重在不断增加。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:12:35",
            "content": "それはまた、どうしてでしょう？",
            "Chinese": "这又是为什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:13:02",
            "content": "運動してないからだと思います。",
            "Chinese": "我觉得是因为没有运动。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:13:20",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:13:43",
            "content": "受験体制に入る前は、何か運動部とかやっていたのですか？",
            "Chinese": "在进入备考状态之前，您有参加过运动社团之类的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:14:12",
            "content": "はい、バスケをやっていました。",
            "Chinese": "是的，我以前打篮球。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:14:29",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:14:57",
            "content": "練習は毎日とか？",
            "Chinese": "训练是每天都有吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:15:17",
            "content": "はい、毎日ありました",
            "Chinese": "是的，每天都有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:15:36",
            "content": "週末は試合があったり？",
            "Chinese": "周末会有比赛之类的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:16:16",
            "content": "そうですね。試合もありました。",
            "Chinese": "是的，也有比赛。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:16:32",
            "content": "すっかりバスケ三昧だったのですね。",
            "Chinese": "那您过去完全沉浸在篮球里了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:16:43",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:17:04",
            "content": "いつで、バスケ部活は終わりにしたのですか？",
            "Chinese": "您是什么时候结束篮球社团活动的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:17:40",
            "content": "7月の始めくらいです。",
            "Chinese": "大概是7月初。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:18:20",
            "content": "7月の初めまではバスケをやっていたのですね。頑張りましたね。",
            "Chinese": "一直到7月初都还在打篮球啊。您很努力呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:18:31",
            "content": "そうですね。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:19:19",
            "content": "その後は、バスケを止めて、身体を動かさなくなったということですか？",
            "Chinese": "在那之后，就不打篮球，也不怎么活动身体了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:19:42",
            "content": "はい、時間がないんです。",
            "Chinese": "是的，没有时间。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:20:07",
            "content": "そうですよね。",
            "Chinese": "是啊，可以理解。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:20:36",
            "content": "どうしたらいいですか？",
            "Chinese": "我该怎么办呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:20:39",
            "content": "でもつい習慣で食べてしまう・・・という感じですか？",
            "Chinese": "是因为习惯而不自觉地吃东西……是这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:21:56",
            "content": "習慣というか出てきたものは食べます。",
            "Chinese": "与其说是习惯，不如说端上来的饭菜我都会吃掉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:22:10",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:22:26",
            "content": "いままでのところを少しだけ整理してもいいですか？",
            "Chinese": "我可以稍微整理一下目前为止我们谈到的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:22:36",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:22:45",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:24:21",
            "content": "今受験勉強に入ったが、1日中勉強し、夜は塾にも行っているのに、成績があがらない。",
            "Chinese": "您现在进入了备考阶段，虽然一整天都在学习，晚上也去补习班，但成绩却没有提高。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:24:37",
            "content": "やる気が出ないので困っている。",
            "Chinese": "因为提不起干劲而感到困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:24:48",
            "content": "気になっているのは太ってきたこと。",
            "Chinese": "在意的事情是自己变胖了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:25:24",
            "content": "実はずうっとバスケ部をこの7月までやってきた。その後はバスケを止めて体を動かす機会もない。",
            "Chinese": "实际上，您一直到今年7月都在参加篮球社团。那之后就停止打球，也没有机会活动身体了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:25:41",
            "content": "こんな理解でよろしいですか？",
            "Chinese": "我的理解是这样，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:25:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:26:01",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:26:52",
            "content": "そこで、体重のことと、勉強のやる気のことをこれからご一緒に考えて行ったらよいですか？",
            "Chinese": "那么，接下来我们一起思考一下关于体重和学习动力的问题，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:27:11",
            "content": "そうですね。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:27:19",
            "content": "了解です。",
            "Chinese": "明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:28:06",
            "content": "バスケ部だった他の子は、体重のことと勉強のことについて、何か言ってますか？",
            "Chinese": "以前篮球部的其他同学，有没有谈到体重或学习方面的事情？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:28:41",
            "content": "最近話してないので、わかりません。",
            "Chinese": "最近没怎么和他们聊天，所以不清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:28:53",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:29:37",
            "content": "じゃあ、先ず体重について考えてみましょうか。",
            "Chinese": "那么，我们先来考虑一下体重的问题吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:29:47",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:29:58",
            "content": "ご自分としては、体重についてはどうしていきたいと思っていますか？",
            "Chinese": "关于体重，您自己希望怎么做呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:31:05",
            "content": "顔が丸くなるのが嫌なんです。それがどうにかなればと。",
            "Chinese": "我不喜欢脸变圆。只要能改善这一点就好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:31:29",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:32:37",
            "content": "けっこうどう見えるかを大臣するんですね。",
            "Chinese": "您很在意自己看起来怎么样呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:33:14",
            "content": "↑「大事にする」です。",
            "Chinese": "（抱歉，应该是“在意”。）"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:34:30",
            "content": "どう見えるかを大事にするかどうかはわかりませんが、嫌じゃないですか？",
            "Chinese": "我不知道算不算是很在意，但（脸变圆）不是很讨厌吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:35:10",
            "content": "たしかに。",
            "Chinese": "的确如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:35:52",
            "content": "そうすると、体重を増やさない工夫をするということが必要みたいですね。",
            "Chinese": "这样的话，看来有必要下点功夫来防止体重增加了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:36:39",
            "content": "でも、そんな時間、ないです。",
            "Chinese": "可是，我没有那种时间。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:37:22",
            "content": "特別な時間を使わなくても可能だと思うのですが。",
            "Chinese": "我觉得不占用特别的时间也是有可能做到的。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:37:42",
            "content": "そうなんですか？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:37:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:38:20",
            "content": "今まで、運動をしてた＝エネルギーを沢山使っていた。",
            "Chinese": "之前您运动时，消耗了很多能量。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:39:20",
            "content": "突然、運動を止めた➡出ていくエネルギーが少なくなった➡栄養が消費されないので体に溜まる",
            "Chinese": "突然停止运动 ➡ 能量消耗减少 ➡ 营养无法被消耗而堆积在体内"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:39:39",
            "content": "ということが起こっていると思うのですが・・・",
            "Chinese": "我想您身上发生的就是这样的情况…"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:40:42",
            "content": "でも、そんなに食べてないですよ。",
            "Chinese": "可是，我并没有吃那么多啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:41:14",
            "content": "さきほど、出されたものを食べていると言っていましたが・・・",
            "Chinese": "您刚才不是说，端上来的饭菜都会吃掉吗…"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:42:11",
            "content": "残した方がいいということですか？",
            "Chinese": "您的意思是最好剩下一些吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:42:45",
            "content": "取り入れる栄養　＝　使うエネルギー　とバランスをとると、身体に栄養がたまらなくなるかと思うので、",
            "Chinese": "如果能做到“摄入的营养 = 消耗的能量”这种平衡，营养就不会在体内堆积了，所以，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:43:22",
            "content": "お母さんに、食事の量を調整してもらってはいかがでしょうか？",
            "Chinese": "您看是不是可以请妈妈帮忙调整一下饭量呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:44:26",
            "content": "今でもお腹すくの我慢しているのに減らさなきゃいけないのですか？",
            "Chinese": "我现在已经在忍着肚子饿了，还要再减量吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:45:51",
            "content": "お腹いっぱいになるけど、栄養価はあまり高くない食物もありますよ。その辺をざっくばらんにお母さんに相談なさるとよろしいかと思いますが・・・",
            "Chinese": "有些食物既能让人有饱腹感，热量又不太高哦。关于这点，我觉得您可以坦率地和妈妈商量一下…"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:47:09",
            "content": "そうですか",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:47:24",
            "content": "もう一つ提案してもいいですか？",
            "Chinese": "我可以再提一个建议吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/11(水) 21:47:41",
            "content": "もういいです",
            "Chinese": "不用了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:48:10",
            "content": "わかりました。",
            "Chinese": "好的，我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/11(水) 21:48:38",
            "content": "それでは、勉強のことについて考えて行ってはと思いますが、よろしいですか？",
            "Chinese": "那么，我们接下来谈谈学习的事情，可以吗？"
        },
        {
            "role": "クライアント",
