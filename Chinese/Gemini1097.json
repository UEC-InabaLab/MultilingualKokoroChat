{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:49:29",
            "content": "カウンセリング部門：テーマは希死念慮です。よろしくお願いいたします。",
            "Chinese": "咨询部门：本次主题是自杀意念。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:50:15",
            "content": "宜しくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:50:34",
            "content": "こんにちは、相談員です。ご相談ありがとうございます。本日はどのようなご相談でしょうか。",
            "Chinese": "您好，我是咨询师。感谢您前来咨询。今天您想谈些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:50:59",
            "content": "死にたいです",
            "Chinese": "我想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:51:18",
            "content": "そう思われていおられるのですね。",
            "Chinese": "您现在是这么想的，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:51:26",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:51:35",
            "content": "それはお辛いですね。",
            "Chinese": "这一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:51:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:52:06",
            "content": "よかったら、どのような事がおありだったのか、教えてもらえますか？",
            "Chinese": "如果可以的话，能跟我说说发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:52:10",
            "content": "もう、生きて要られません",
            "Chinese": "我已经活不下去了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:52:29",
            "content": "それ程、追い詰められている気持ちなんですね。",
            "Chinese": "您感觉自己被逼得走投无路了，是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:52:51",
            "content": "今はどこから連絡をしていただいていますか。そこは暖かいでしょうか。",
            "Chinese": "您现在是从哪里和我们联系的呢？那里暖和吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:53:04",
            "content": "収入が少なく、年金も少なく、もう、疲れているのです",
            "Chinese": "我的收入很少，养老金也不多，我已经很疲惫了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:53:35",
            "content": "家の中です",
            "Chinese": "在家里。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:54:25",
            "content": "そうなんですね。経済的な不安がおありなんですね。家の中でしたか。お身体暖かくしてご相談頂ければと思います。",
            "Chinese": "是这样啊。您有经济上的不安，是吗？是在家里啊。希望您能注意保暖，我们再继续谈。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:54:41",
            "content": "そして、・・・",
            "Chinese": "而且……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:54:51",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:55:00",
            "content": "経済的不安では、ありません",
            "Chinese": "并不是经济上的担忧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:55:31",
            "content": "ペットと過ごすのが、唯一の楽しみでした",
            "Chinese": "和宠物在一起是我唯一的乐趣。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:55:47",
            "content": "生きがいでした",
            "Chinese": "那是我活着的意义。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:55:57",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:57:02",
            "content": "ペットが死んでしまって、次から次へと、思い出が、頭から、離れません",
            "Chinese": "宠物去世后，一幕幕的回忆在脑海里挥之不去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:57:18",
            "content": "そうだったんですね。それはとてもお辛いですね。",
            "Chinese": "原来如此，这一定非常痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:57:22",
            "content": "涙、涙",
            "Chinese": "（哭泣）"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:57:37",
            "content": "死んでしまいたいです",
            "Chinese": "我真想一死了之。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:57:58",
            "content": "一緒に過ごされる時間が生きがいと感じるくらい、大事にされていたんですね。",
            "Chinese": "您非常珍视和它在一起的时光，甚至觉得那是您活下去的意义，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:58:25",
            "content": "はい、そうです",
            "Chinese": "是的，没错。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:58:59",
            "content": "生きる価値がありません",
            "Chinese": "我没有活下去的价值了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 13:59:26",
            "content": "そう思われるのも無理はないと感じます。今の気持ちを他の方に伝えることはできていますか。それとも、一人でかかえ込まれていますか。",
            "Chinese": "您有这样的想法也是情有可原的。您有把现在的心情告诉过其他人吗？还是一直一个人扛着呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 13:59:58",
            "content": "誰も、話をすることができません",
            "Chinese": "我谁都没法说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:01:13",
            "content": "そうだったんですね。誰にも話さずに、ご自身だけで辛い気持ちを抱えていらっしゃったんですね。",
            "Chinese": "原来是这样啊。您没有告诉任何人，一直独自承受着这份痛苦，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:01:28",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:01:32",
            "content": "それはとても辛い思いをされていましたね。",
            "Chinese": "那您一定承受了很大的痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:01:37",
            "content": "誰もいないのです",
            "Chinese": "我谁都没有了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:02:33",
            "content": "そうなんですね。今はお一人で住まれている、ということでしょうか。",
            "Chinese": "是这样啊。也就是说您现在是一个人住吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:02:44",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:05:40",
            "content": "親戚との交流がありません",
            "Chinese": "我和亲戚没有来往。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:07:22",
            "content": "どうなさいましたか",
            "Chinese": "您怎么了？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:07:27",
            "content": "死にたいです",
            "Chinese": "我想死。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:07:40",
            "content": "どうしたら良いですか",
            "Chinese": "我该怎么办？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:08:11",
            "content": "死んでしまいたいです",
            "Chinese": "我真想死。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:14:28",
            "content": "大丈夫ですか",
            "Chinese": "您没事吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:14:28",
            "content": "すみませんでした",
            "Chinese": "对不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:47:24",
            "content": "お待たせして申し訳ありません。システムエラーで連絡が遅くなりました。ご相談を続けさせていただきます。辛い気持ちを抱えながら、こうやって相談をしてくださり、ありがとうございます。今回どんなことを相談したいと感じ、ご連絡いただけましたか。",
            "Chinese": "非常抱歉让您久等了。因为系统错误，回复晚了。我们继续咨询吧。感谢您在如此痛苦的心情下，还能来这里咨询。您这次联系我们，是希望咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:53:13",
            "content": "ありがとうございます再開します",
            "Chinese": "谢谢您，我们继续吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:53:22",
            "content": "よろしくお願いいたします",
            "Chinese": "好的，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:53:58",
            "content": "とにかく、寂しい、悲しい、死んでしまいたい、",
            "Chinese": "总之，就是很寂寞、很悲伤，想一死了之，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:54:32",
            "content": "ペットがいない生活なんて、考えられません",
            "Chinese": "没有宠物的生活，我根本无法想象。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:54:47",
            "content": "一人ぼっちです",
            "Chinese": "我孤身一人。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:55:17",
            "content": "生きてる価値はありません",
            "Chinese": "我没有活下去的价值。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:56:06",
            "content": "そのように感じられているんですね。辛いお気持ち、とても伝わってきます。",
            "Chinese": "您有这样的感受啊。您的痛苦，我深切地感受到了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:56:20",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:56:24",
            "content": "辛い気持ちを抱えながら、こうやって相談をしてくださり、ありがとうございます。今回どんなことを相談したいと感じ、ご連絡いただけましたか。",
            "Chinese": "感谢您在如此痛苦的心情下，还能来这里咨询。您这次联系我们，是希望咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:56:52",
            "content": "頭から、離れません。",
            "Chinese": "它在我脑海里挥之不去。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:57:02",
            "content": "ペットのことが",
            "Chinese": "宠物的事情。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:57:09",
            "content": "悲しいです",
            "Chinese": "我很伤心。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:57:18",
            "content": "そうなんですね、ずっと考えてしまうんですね。",
            "Chinese": "是啊，您会一直想着它，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:57:19",
            "content": "涙が止まりません",
            "Chinese": "眼泪止不住。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:57:34",
            "content": "はい、そうなんです",
            "Chinese": "是的，就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 14:58:29",
            "content": "そうですよね。お辛いですね。もしかして、ご飯が喉を通らなかったり、普段できている事ができなくなっている状況でしょうか。",
            "Chinese": "是啊，一定很难过吧。是不是有吃不下饭，或者平时能做的事情现在也做不了的情况呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:59:35",
            "content": "はい、食欲がなくて、眠れません気が貼っています",
            "Chinese": "是的，没有食欲，也睡不着，神经一直绷着。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 14:59:53",
            "content": "張る",
            "Chinese": "是“绷着”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:00:46",
            "content": "そうなんですね、食べる気力もなくなってしまいますよね。更に眠れなかったり、気が張っていたら、疲れを感じやすくなるのも無理はありません。",
            "Chinese": "这样啊，人会连吃东西的力气都没有吧。如果又睡不着、神经又一直绷着，很容易觉得疲惫，也是可以理解的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:01:09",
            "content": "はい、",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:03:18",
            "content": "それだけ、思いが強かったのだという事が伝わります。",
            "Chinese": "这让我感受到，您对它的感情有多么深。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:04:19",
            "content": "はい、ドックランで、思いっきり、はしっていたことがあります",
            "Chinese": "是的，在狗狗乐园里，它曾经尽情地奔跑过。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:04:25",
            "content": "それから、",
            "Chinese": "还有，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:04:34",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:04:52",
            "content": "よく食事をしているときに、匂いをかぎに来ましいた",
            "Chinese": "我吃饭的时候，它经常会跑过来闻味道。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:05:02",
            "content": "涙涙",
            "Chinese": "（哭泣）"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:05:47",
            "content": "ペットだけが、唯一の生きがいだった・・・",
            "Chinese": "只有宠物，是我唯一的精神寄托……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:06:04",
            "content": "そうだったんですね。たくさんの思い出がおありになるんですね。もしよろしければ、もう少し、一緒に過ごされたお話を聞かせていただきたいです。",
            "Chinese": "原来是这样。你们之间有很多的回忆呢。如果您不介意的话，我想再多听一些你们一起度过的故事。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:06:20",
            "content": "いつ頃から一緒に過ごされていたんですか。",
            "Chinese": "你们从什么时候开始在一起的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:06:42",
            "content": "１４年前からです",
            "Chinese": "从14年前开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:07:34",
            "content": "そうだったんですね。とても長い時間を一緒に過ごされたんですね。その頃からお一人で育てられていたのでしょうか。",
            "Chinese": "是这样啊。你们在一起度过了很长的时间呢。那时候开始就是您一个人养的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:08:53",
            "content": "はい、生まれて４ヶ月ぐらいからです。でも、寿命が短かったほうだと思います",
            "Chinese": "是的，从它出生4个月左右开始。但是，我觉得它的寿命算是短的了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:10:27",
            "content": "そうだったんですね。随分と小さな頃から一緒にいらっしゃったんですね。寿命が短かかったというのは、何かご病気があったのでしょうか。",
            "Chinese": "是这样啊。从它很小的时候你们就在一起了呢。您说它的寿命短，是生了什么病吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:11:19",
            "content": "最初にけがをして、その後、病気になりました",
            "Chinese": "一开始是受了伤，后来就生病了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:12:17",
            "content": "そうだったんですね。それはとても不安や心配な気持ちになったこともあったかと思います。",
            "Chinese": "原来如此。想必当时您也感到非常不安和担心吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:12:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:12:51",
            "content": "毎日、病院に行ったこともあります",
            "Chinese": "我曾经每天都带它去医院。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:13:15",
            "content": "手術をしたことも、あります",
            "Chinese": "也动过手术。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 15:13:31",
            "content": "涙、涙",
            "Chinese": "（哭泣）"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 15:13:46",
            "content": "そうだったんですね。それは大変不安でしたね。献身的に看病されていらっしゃったんですね。",
            "Chinese": "是这样啊。那您一定非常不安吧。您一直在尽心尽力地照顾它呢。"
        },
        {
