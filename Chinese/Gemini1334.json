            "role": "クライアント",
            "time": "2021/02/12(金) 12:49:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:49:08",
            "content": "気が重いです",
