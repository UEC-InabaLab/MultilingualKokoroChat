{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 11:53:15",
            "content": "こんにちは。宜しくお願いします。時間になりましたら、こちらから、スタートさせていただきますね。",
            "Chinese": "您好，请多关照。时间一到，我这边就会开始。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 11:53:41",
            "content": "（こんにちは）",
            "Chinese": "（您好）"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 11:53:50",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:00:10",
            "content": "こんにちは。相談員です。今日は相談に来てくださってありがとうございます。",
            "Chinese": "您好，我是咨询师。感谢您今天前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:00:19",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:00:41",
            "content": "初めに、年代と性別を教えていただけますか?",
            "Chinese": "首先，能请您告诉我您的年龄段和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:00:56",
            "content": "50代、女性です",
            "Chinese": "50多岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:01:06",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:01:20",
            "content": "今日はどのようなご相談ですか?",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:02:23",
            "content": "パート先の人間関係が辛くて",
            "Chinese": "兼职单位的人际关系让我很痛苦，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:02:30",
            "content": "ご相談に来ました",
            "Chinese": "所以特地前来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:03:12",
            "content": "そうなんですね。お勤め先の人間関係は、切れないので辛いですね。",
            "Chinese": "是这样啊。工作单位的人际关系无法轻易切断，确实很辛苦呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:03:33",
            "content": "はい、そうなんです",
            "Chinese": "是的，就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:03:34",
            "content": "お力になりたいので、詳しくお話してくださいますか?",
            "Chinese": "我很愿意帮您，能否请您详细说说情况？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:04:21",
            "content": "実は、私は望んでいないのですが、いじめる側みたいになってしまって",
            "Chinese": "其实，我并不想这样，但不知不觉好像成了欺负人的一方。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:04:52",
            "content": "もともと意地悪な人が一人いまして",
            "Chinese": "原本就有一位性格刻薄的人，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:04:59",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:05:28",
            "content": "その人が色々な人を数か月おきにターゲットを変えるような形で",
            "Chinese": "那个人每隔几个月就换一个目标，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:05:42",
            "content": "悪口を言いふらしたりしていたんです",
            "Chinese": "到处散布坏话之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:06:03",
            "content": "周りを巻き込んで",
            "Chinese": "还拉拢周围的人。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:06:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:06:14",
            "content": "迷惑ですね。",
            "Chinese": "真令人困扰呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:06:21",
            "content": "最初はその方ベテランなので",
            "Chinese": "一开始因为那个人是资深员工，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:06:31",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:06:35",
            "content": "みんなも話を信じてたんですが",
            "Chinese": "大家也都相信了她的话，不过，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:06:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:06:56",
            "content": "度重なると、どうやらいろんな人の事を",
            "Chinese": "但次数多了之后，大家开始觉得她好像"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:07:05",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:07:16",
            "content": "言ってるみたいだと思うようになり",
            "Chinese": "说了许多人的坏话，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:07:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:08:13",
            "content": "ちょっとお互いに確認してみたらやっぱり、数か月ごとにあの人は仕事サボってるとか生意気な口をきいたとか",
            "Chinese": "彼此稍微一核对，果然如此。她每隔几个月就会说谁工作偷懒、谁出言不逊之类的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:08:27",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:08:28",
            "content": "服装が変だとか",
            "Chinese": "还说别人穿着奇怪，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:08:38",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:08:52",
            "content": "仲間外れにして、数人でランチに行ったり",
            "Chinese": "把人孤立起来，几个人结伴去吃午饭，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:09:10",
            "content": "言葉だけでなく、そんなことも",
            "Chinese": "不仅是言语上，还会做出那样的事啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:10:03",
            "content": "それは、不快ですね。",
            "Chinese": "那真让人不舒服呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:10:33",
            "content": "はい。ただ、今度は本人が悪いんですけど、バレた形になってみんなから本人が仲間外れにと言うか、仕返しにあっているんです。",
            "Chinese": "是的。不过，这次虽然是她自己的问题，但事情败露后，她反过来被大家排挤，或者说是在报复她。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:10:49",
            "content": "そうなんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:10:58",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:11:05",
            "content": "皆さんの積もり積もった気持ちが",
            "Chinese": "可能是大家日积月累的情绪"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:11:16",
            "content": "爆発したのかもしれませんね。",
            "Chinese": "一下子爆发出来了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:11:55",
            "content": "あなたは、どのように感じておられますか?",
            "Chinese": "您对此有什么感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:12:12",
            "content": "そうなんです。たまたま私は被害に遭わずに仕事で来ていたのですが、その仕返しグループの人たちの",
            "Chinese": "是的。我碰巧没有受过害，一直正常工作，但是那个报复小团体的人们……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:12:22",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:12:29",
            "content": "誘われるもので",
            "Chinese": "会来邀请我，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:12:37",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:12:53",
            "content": "食事に行ったり、悪口とかどんなことをされたとか",
            "Chinese": "一起去吃饭，然后听她们说坏话，或者说自己被怎样对待过。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:13:01",
            "content": "聞かされて",
            "Chinese": "听她们说这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:13:06",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:13:30",
            "content": "私は被害に遭っていないから、仕返しみたいな雰囲気に加わりたくないんですが",
            "Chinese": "因为我并没有受害，不想加入那种报复的氛围，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:13:42",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:13:44",
            "content": "結果加わったみたいになってしまっていて",
            "Chinese": "但结果看起来却好像我也加入了一样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:13:52",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:14:21",
            "content": "8人しかいない事務グループなので",
            "Chinese": "因为我们事务组只有8个人，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:14:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:14:38",
            "content": "本人が悪いと言えばそうなんですが、、、",
            "Chinese": "要说她有错，确实也是她不对，但是……"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:14:59",
            "content": "心苦しいというか",
            "Chinese": "我心里很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:15:12",
            "content": "そんなことがあって、自分は望んでいないのに、いじめる側になってしまたということだったんですね。",
            "Chinese": "原来是发生了这样的事，您在并非本意的情况下，感觉自己成了欺凌者的一方。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:15:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:16:09",
            "content": "思ってもいないのに、そんな風になってしまっているのは毎日しんどいですね。",
            "Chinese": "明明不是那样想的，却变成了那样的状况，每天一定都很煎熬吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:16:25",
            "content": "ちなみに、",
            "Chinese": "顺便问一下，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:16:30",
            "content": "はい、だんだんかわいそうな感じで",
            "Chinese": "是的，渐渐觉得她也有点可怜了。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:16:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:16:49",
            "content": "そんな風にもお感じなんですね。",
            "Chinese": "您也会有这样的感觉啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:17:18",
            "content": "事務所の8人にうち",
            "Chinese": "办公室的8个人中，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:17:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:17:49",
            "content": "元々のベテランさんと、あなたを除くと6人ですが、",
            "Chinese": "除去原来的那位资深员工和您，还剩6个人，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:17:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:18:25",
            "content": "仕返しをしている人は何人おられるのですか?",
            "Chinese": "参与报复的人有几位呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:18:47",
            "content": "主に4人です",
            "Chinese": "主要是4个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:19:08",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:19:18",
            "content": "2人は派遣社員で",
            "Chinese": "其中两位是派遣员工，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:19:26",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:19:43",
            "content": "事務と言っても数か月でよく入れ替わる人員なんです",
            "Chinese": "虽说是文职，但人员经常几个月就更换一次。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:20:02",
            "content": "そうなんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:20:14",
            "content": "私たちはパート雇用ですが、フルタイムなので",
            "Chinese": "我们虽然是兼职，但是全职工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:20:25",
            "content": "少し、立場が違うんですね。",
            "Chinese": "立场上稍微有些不同呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:20:28",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:20:54",
            "content": "ということは、パートのフルタイムのメンバーで",
            "Chinese": "也就是说，在兼职的全职员工中，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:20:56",
            "content": "年齢も派遣さんは20代から30代くらいの事が多くて",
            "Chinese": "年龄上，派遣同事多是二三十岁，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:21:05",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:21:19",
            "content": "すみません、行違いましたが",
            "Chinese": "抱歉，说岔了，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:21:42",
            "content": "私たちの年代とはちょっと加わらない感じです",
            "Chinese": "感觉和我们这个年龄段的人不太能融到一起。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:21:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:21:50",
            "content": "大丈夫です",
            "Chinese": "没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:21:58",
            "content": "フルタイムで、仕返しに入っていないのは、あなただけということですね。",
            "Chinese": "那么在全职员工中，没有参与报复的就只有您一个人了，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:22:13",
            "content": "はい、もともとなにもされていないので",
            "Chinese": "是的，因为我本来就没被她怎么样过。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:22:26",
            "content": "そうでしたか。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:22:30",
            "content": "ただ、ランチに誘われたり",
            "Chinese": "不过，她们会邀请我一起吃午饭，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:22:35",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:22:50",
            "content": "休憩時にちょっとコンビニに出たりするのも声をかけてもらうので",
            "Chinese": "休息时去趟便利店之类的，也会叫上我，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:22:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:23:15",
            "content": "グループのようになっています",
            "Chinese": "于是就像成了一个小团体。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:23:33",
            "content": "悪口の同意を求められるような",
