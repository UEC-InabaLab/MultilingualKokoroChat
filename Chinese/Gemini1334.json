        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:49:19",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/12(金) 12:49:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/12(金) 12:50:17",
            "content": "朝、立ち上がるのに結構な決心が必要だということでしたが、",
