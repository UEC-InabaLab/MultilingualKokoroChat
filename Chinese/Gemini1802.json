{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 09:57:05",
            "content": "今日はよろしくお願いします。",
            "Chinese": "今天请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 09:57:18",
            "content": "よろしくお願いします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:00:29",
            "content": "こんにちは、相談員です。今日はお越し頂きありがとうございます。初めに、あなたの年齢、性別を教えていただけますか？",
            "Chinese": "您好，我是咨询员。感谢您今天前来。首先，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:00:43",
            "content": "こんにちは。",
            "Chinese": "您好。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:01:08",
            "content": "14歳女",
            "Chinese": "14岁，女。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:01:16",
            "content": "お願いします。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:01:32",
            "content": "教えてくださりありがとうございます。今日はどのようなご相談でしょうか？",
            "Chinese": "谢谢您告诉我。今天您想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:01:53",
            "content": "リスカがやめられないのです。",
            "Chinese": "我戒不掉割腕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:02:18",
            "content": "そうなのですね…それは辛いですよね。",
            "Chinese": "是这样啊……那一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:02:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:02:55",
            "content": "どのような気持ちになるのかお話できるところからでいいので、教えて頂けますか？",
            "Chinese": "您可以从自己愿意谈的部分开始，跟我说说当时是怎样的心情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:03:16",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:03:45",
            "content": "もう、消えたい！",
            "Chinese": "我真的好想消失！"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:04:11",
            "content": "リスカしたくないけれど、やめられない！",
            "Chinese": "我不想再割腕了，可就是停不下来！"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:05:14",
            "content": "昔から、リスカしていたけれど、最近は、切らずにいられないのです。",
            "Chinese": "我从以前就开始割腕了，但是最近，已经到了不割就受不了的程度。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:05:26",
            "content": "えぇ、えぇ。そのように思われるのですね。やめられないのですね。　消えたい　というのは具体的にどんな気持ちですか？",
            "Chinese": "嗯，嗯。您是这样想的啊，停不下来了，是吗。您说的“想消失”，具体是一种怎样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:07:55",
            "content": "すべてが、嫌になってしまうのです。",
            "Chinese": "就是对所有事情都感到厌烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:08:34",
            "content": "えぇ。そんな思いに駆られるのですね。苦しいですよね…",
            "Chinese": "嗯。您会被这种想法驱使着啊。一定很痛苦吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:08:50",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:08:57",
            "content": "昔からとのことですが、いつ頃からリスカはされてるのですか？",
            "Chinese": "您说从以前就开始了，大概是从什么时候开始割腕的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:09:19",
            "content": "小学校3年",
            "Chinese": "小学三年级。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:09:57",
            "content": "そうでしたか…5.6年ずっと辛い思いをされてきたのですね。",
            "Chinese": "是这样啊……这五六年来您一直都很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:10:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:10:25",
            "content": "最近はどのくらいの頻度出されてるのですか？",
            "Chinese": "最近的频率大概是多久一次呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:10:52",
            "content": "うん〜。",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:11:03",
            "content": "わからない",
            "Chinese": "不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:11:38",
            "content": "えぇ、えぇ。そうなんですね。",
            "Chinese": "嗯，嗯。是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:12:19",
            "content": "リスカをするときはどのような気持ちになりますか？",
            "Chinese": "割腕的时候您是怎样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:12:50",
            "content": "スッキリします",
            "Chinese": "会觉得舒畅。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:13:19",
            "content": "でも、よくないことだと思っています。",
            "Chinese": "但是，我也觉得这是不好的行为。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:13:57",
            "content": "そうなんですね。そのように思われてるのですね…よくないこと　と思うのはどんなことがあってなのかお話しできますか？",
            "Chinese": "是这样啊。您是这么认为的啊……可以告诉我，您为什么会觉得这是“不好的行为”吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:14:54",
            "content": "リスカって、よくないですよね。",
            "Chinese": "割腕，是不好的吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:15:42",
            "content": "自分の体を傷つけるのは確かに良くないことだと思いますが、あなたの悩みやトラウマがそうさせてるのは自然なことかと思うので、自分を責める必要はないと思いますよ。",
            "Chinese": "伤害自己的身体确实是不好的，但我想您的烦恼和创伤让您这么做也是很自然的，所以没有必要责备自己。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:16:10",
            "content": "小学校3年生からされてるとのことですが、なにかきっかけになる出来事はあったのでしょうか？",
            "Chinese": "您说从小学三年级就开始了，是有什么契机事件吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:16:23",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:16:47",
            "content": "覚えていないです。",
            "Chinese": "不记得了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:17:20",
            "content": "えぇ。ここで少しづつ楽になれるように一緒にお話ししていきましょうね。",
            "Chinese": "嗯。我们在这里一起慢慢聊，希望能让您一点点轻松起来。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:17:27",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:18:13",
            "content": "えぇ、覚えてないんですね。このことを知ってる周りの人はいるのですか？",
            "Chinese": "嗯，不记得了啊。您身边有人知道这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:18:29",
            "content": "いないです",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:18:56",
            "content": "そうだったのですね。勇気を持ってここに来てくださったのですね…",
            "Chinese": "是这样啊。您是鼓起了很大的勇气才来到这里的吧…"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:19:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:20:01",
            "content": "ありがとうございます。勇気を持ってここに来てくださった思いとはどのような思いなんでしょうか？",
            "Chinese": "谢谢您。能告诉我您鼓起勇气来到这里是出于怎样的想法吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:20:43",
            "content": "最初にお話ししましたけど…。",
            "Chinese": "我一开始就说过了…。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:21:44",
            "content": "リスカがやめられなくて、どうしたらいいか…",
            "Chinese": "我戒不掉割腕，不知道该怎么办…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:22:21",
            "content": "そうでしたね。。失礼しました。リスカをやめたいけどやめれないんですよね…",
            "Chinese": "是啊，您说过了。非常抱歉。您想戒掉割腕但又戒不掉，是吧…"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:22:29",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:23:13",
            "content": "最近は切らずにいられない…とのことですが、最近はきっかけになるようなことがあったかお話しできますか？",
            "Chinese": "您说最近到了不割就不行的地步……可以告诉我最近有没有发生什么成为契机的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:23:34",
            "content": "はい",
            "Chinese": "有的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:25:27",
            "content": "Twitter で友達になった人に裸の写真を送るように言われ、送ったところ、相手が、年配の男性だったのです。",
            "Chinese": "在Twitter上认识的一个朋友让我发裸照给他，我发了之后才发现对方是个上了年纪的男性。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:25:35",
            "content": "どうしたらいいのか",
            "Chinese": "我不知道该怎么办。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:26:06",
            "content": "考えると深くリスカしてしまうのです。",
            "Chinese": "一想到这件事就会割得很深。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:26:10",
            "content": "えぇ、えぇ。そんなことがあったのですね。",
            "Chinese": "嗯，嗯。原来发生了这样的事啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:26:29",
            "content": "心配になるし、不安になりますよね。",
            "Chinese": "您会担心，也会感到不安吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:26:42",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:26:50",
            "content": "それでいまはどんなやりとりをしてるのですか？",
            "Chinese": "那现在你们之间还有什么交流吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:27:08",
            "content": "何もしていないです。",
            "Chinese": "什么都没有了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:28:08",
            "content": "そうでしたか。相手が年配の男性ということはどのように知ったのですか？",
            "Chinese": "是吗。您是怎么知道对方是上了年纪的男性的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:30:25",
            "content": "送ったあとに、自分の年齢を言ってきたのです。",
            "Chinese": "我发过去之后，他告诉了我他的年龄。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:31:55",
            "content": "えぇ。ええ。そうだったのですね。教えてくださりありがとうございます。",
            "Chinese": "嗯。嗯。是这样啊。谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:33:17",
            "content": "その件に関してですが、",
            "Chinese": "关于这件事，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:35:11",
            "content": "あなたの人権を守ることを第一に考え、警察などに相談することがまずは大切なのではないかと思います。",
            "Chinese": "我认为首要的是保护您的人权，建议您先向警察等机构咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:35:27",
            "content": "その人とのやりとりはどのようなものだったのですか？",
            "Chinese": "您和那个人的交流是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:35:49",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:40:41",
            "content": "お話しするのは難しそうですか…？その行為は場合によっては犯罪になることもあります。相談窓口を記載するので、ご自身で尋ねてみるのはいかがでしょうか？",
            "Chinese": "说出来会比较困难吗……？对方的行为根据情况也可能构成犯罪。我可以给您提供咨询窗口的联系方式，您自己去问问看怎么样？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:44:17",
            "content": "相談することでインターネットに関するトラブルや犯罪被害などに対応していけると思うので、どうしていけばいいのか解決策がわかると思います。いかがですか？",
            "Chinese": "通过咨询，我认为可以应对网络相关的纠纷和犯罪侵害等问题，也能找到解决办法。您觉得怎么样？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:49:15",
            "content": "どうされましたか？",
            "Chinese": "您怎么了？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:51:51",
            "content": "しばらくお返事しづらい状況ですか？",
            "Chinese": "是暂时不方便回复吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:53:02",
            "content": "どうもありがとうございます",
            "Chinese": "非常感谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:53:41",
            "content": "話が行き違ってしまったようですが、文字は見られますか？",
            "Chinese": "我们的话题好像有点错开了，您能看到我发的消息吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:53:49",
            "content": "はい",
            "Chinese": "能。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:54:04",
            "content": "よかったです。",
            "Chinese": "太好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:54:37",
            "content": "相談窓口などもありますが、ご自身で連絡することはできそうですか？",
            "Chinese": "有咨询窗口之类的机构，您自己能联系上吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:56:44",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:57:20",
            "content": "では、24時間の相談窓口を記載しますね。00-0000-0000",
            "Chinese": "那么，我把24小时咨询窗口的电话写给您。00-0000-0000"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:57:29",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:57:43",
            "content": "どうもありがとうございました",
            "Chinese": "非常感谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 10:58:44",
            "content": "はい、こちらこそお話しを聞かせてくださりありがとうございました。あなた自身がリスカをやめれない　とお悩みでしたが、その件についてもう少しお話ししませんか？",
            "Chinese": "好的，我也非常感谢您愿意和我说这些。您之前烦恼的是“戒不掉割腕”这件事，关于这个，我们能再多聊一会儿吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:59:21",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 10:59:42",
            "content": "大丈夫です。",
            "Chinese": "没关系了。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/07(金) 11:00:02",
            "content": "どうもありがとうございました。",
            "Chinese": "非常感谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/07(金) 11:01:16",
            "content": "そうですか。わかりました。では、もしまた何かに悩まれることなどありましたらいつでもここに相談しに来てくださいね。いつでもここで待ってます。",
            "Chinese": "是吗，我明白了。那如果之后再有什么烦恼，随时都可以来这里咨询。我随时都在这里等您。"
        },
        {
