    {
      "role": "client",
      "time": "2020-12-31T13:49:34",
      "origin": "死にたいです",
      "content": "我想死。"
    },
    {
      "role": "client",
      "time": "2020-12-31T13:49:45",
      "origin": "辛いです",
      "content": "很痛苦。"
    },
    {
      "role": "counselor",
      "time": "2020-12-31T13:49:56",
      "origin": "そう思っているんですね。おつらいですね",
