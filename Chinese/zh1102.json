    {
      "role": "client",
      "time": "2020-12-31T13:50:39",
      "origin": "生きている意味がわかりません",
      "content": "我不明白活着的意义。"
    },
    {
      "role": "client",
      "time": "2020-12-31T13:50:51",
      "origin": "誰も信じられません",
      "content": "我谁也无法相信。"
    },
    {
