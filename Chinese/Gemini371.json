{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 13:58:39",
            "content": "こんにちは！そろそろ時間となりますが、始めてもよろしいでしょうか？",
            "Chinese": "您好！时间差不多了，请问我们可以开始了吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:01:15",
            "content": "こんにちは！相談員です。今日はどんなご相談でしょうか？",
            "Chinese": "您好！我是咨询师。今天想聊点什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:04:00",
            "content": "Kaiさん？どうされましたか？",
            "Chinese": "Kai，你怎么了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:06:10",
            "content": "つらたん",
            "Chinese": "好难受啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:07:11",
            "content": "こんにちは！Kaiさん、つらたんとは、辛いのですか？？",
            "Chinese": "您好，Kai。您说的“好难受”，是指感到很痛苦吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:07:20",
            "content": "学校行きたくない",
            "Chinese": "不想去学校。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:08:53",
            "content": "学校に行きたくないんですね。今、どんな気持ちかな？",
            "Chinese": "你不想去学校啊。现在是什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:10:19",
            "content": "だるい",
            "Chinese": "没劲儿。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:11:25",
            "content": "体がだるいんですね。それはしんどいよね。何歳か教えてくれるかな？",
            "Chinese": "是身体感觉没劲啊。那肯定很难受吧。可以告诉我你几岁了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:11:47",
            "content": "JK1",
            "Chinese": "高一女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:13:06",
            "content": "高校1年生の女性なんですね。具体的に学校に行きたくないなぁと思うようになったのはいつごろからかな？",
            "Chinese": "原来是高一的女生啊。大概是从什么时候开始觉得不想去学校的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:15:42",
            "content": "最初から",
            "Chinese": "从一开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:17:30",
            "content": "高校の最初からなんですね。そうなんですね。何日かは、学校に行ったのですか？？",
            "Chinese": "从高中一开始就是了啊。这样啊。那有去过几天学校吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:17:59",
            "content": "うん 何日か",
            "Chinese": "嗯，去了几天。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:19:07",
            "content": "何日か通ったんですね。学校でどんなことがあったのか、具体的に教えてもらっていいですか？？",
            "Chinese": "去过几天啊。能具体说说在学校发生了些什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:22:04",
            "content": "別になんも",
            "Chinese": "也没什么特别的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:25:02",
            "content": "学校では特に何もなかったのですね。じゃあ、話変わるけど、家族のこと教えてもらってもいいかな？",
            "Chinese": "在学校没有发生什么特别的事是吧。那我们换个话题，可以告诉我一些关于家人的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:25:17",
            "content": "何を？",
            "Chinese": "说什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:25:29",
            "content": "誰と住んでる？",
            "Chinese": "现在和谁一起住呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:25:39",
            "content": "母親",
            "Chinese": "妈妈。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:26:00",
            "content": "お母さんとKaiさんと二人暮らし？",
            "Chinese": "是和妈妈两个人一起住吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:28:26",
            "content": "そうなんですね。Kaiさんは、お母さんのことどんな風に思っていますか？",
            "Chinese": "这样啊。Kai，你对妈妈是怎样的看法呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:29:36",
            "content": "別に",
            "Chinese": "没什么特别的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:30:42",
            "content": "そうかぁ。それじゃあ、Kaiさんは、学校に行っていないということだけど、最近どんなことをして過ごしているのかな？",
            "Chinese": "这样啊。那么，Kai，你最近没去学校，这段时间都在做些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:31:06",
            "content": "てきとーに",
            "Chinese": "随便混混。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:31:23",
            "content": "具体的に教えてくれるかな？",
            "Chinese": "能具体说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:31:46",
            "content": "ブラブラしてる",
            "Chinese": "到处闲逛。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:32:20",
            "content": "そうかあ。どんなところへ行っているの？",
            "Chinese": "这样啊。都去些什么地方呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:33:09",
            "content": "渋谷",
            "Chinese": "涩谷。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:33:44",
            "content": "渋谷でどんなことをして過ごすの？",
            "Chinese": "在涩谷都怎么打发时间呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:33:54",
            "content": "ネカフェ",
            "Chinese": "网咖。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:34:18",
            "content": "ネカフェかぁ。一日何時間くらいいるの？",
            "Chinese": "去网咖啊。一天大概待多久呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:34:28",
            "content": "ばらばら",
            "Chinese": "不一定。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:36:05",
            "content": "そうかぁ。お母さんは、Kaiさんに対して、何か言ったりする？",
            "Chinese": "这样啊。妈妈会对你说些什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:38:52",
            "content": "何も",
            "Chinese": "什么都不说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:39:35",
            "content": "そうなんだね。Kaiさんは、中学は学校毎日通ってたの？",
            "Chinese": "是这样啊。Kai，你初中的时候每天都去学校吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:40:34",
            "content": "微妙",
            "Chinese": "不太好说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:42:23",
            "content": "そうかぁ。学校に行きたくない理由って何だろう？？話せる範囲で教えてくれるかな？",
            "Chinese": "这样啊。不想去学校的理由是什么呢？可以在你方便说的范围内告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:42:35",
            "content": "だるいから",
            "Chinese": "因为没劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:44:08",
            "content": "そうかぁ。Kaiさんが、今日ここにきてくれたのは、どんな思いがあったのかな？",
            "Chinese": "这样啊。那你今天会来这里，是抱着什么样的想法呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:45:22",
            "content": "もう世の中うざくて",
            "Chinese": "就是觉得这世界很烦人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:45:52",
            "content": "世の中がうざいと感じるんだね。どんなことがうざいと感じる？",
            "Chinese": "你觉得世界很烦人啊。是什么事情让你觉得烦呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:46:00",
            "content": "学校",
            "Chinese": "学校。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:46:02",
            "content": "親",
            "Chinese": "妈妈。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:46:35",
            "content": "学校と母親なんだね。何を言われるのかな？",
            "Chinese": "是学校和妈妈让你觉得烦呀。她会对你说些什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:46:40",
            "content": "何も",
            "Chinese": "什么都不说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:47:18",
            "content": "そうかぁ。何も言われないのに、なぜうざいとかんじるのかなぁ？",
            "Chinese": "这样啊。即使什么都没说，为什么还是会觉得烦呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:47:56",
            "content": "感じるでしょ",
            "Chinese": "就是会觉得烦啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:52:44",
            "content": "そうかぁ。Kaiさんは、好きなことってある？",
            "Chinese": "这样啊。Kai，你有什么喜欢做的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:53:41",
            "content": "は？",
            "Chinese": "哈？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:54:01",
            "content": "例えば、ゲームとか漫画とか",
            "Chinese": "比如游戏、漫画之类的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:54:09",
            "content": "別に",
            "Chinese": "没有特别的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:55:05",
            "content": "そうかぁ。ここでどんなことを話したいかな？",
            "Chinese": "你希望在这里聊些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 14:57:08",
            "content": "なんでこんなつまんないんだろう人生",
            "Chinese": "为什么人生会这么无聊呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 14:58:39",
            "content": "そうかぁ。今、人生つまらないと思っているんだね。思いを言ってくれてありがとう。",
            "Chinese": "这样啊。你现在觉得人生很无聊。谢谢你愿意说出这些感受。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 15:01:07",
            "content": "なんでつまらないと思う？？具体的に今まであったことを教えてくれるかな？",
            "Chinese": "为什么会觉得无聊呢？可以具体告诉我至今为止发生过什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 15:01:27",
            "content": "学校もつまんない",
            "Chinese": "学校也很无聊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 15:01:39",
            "content": "どこもつまんない",
            "Chinese": "去哪儿都很无聊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 15:01:51",
            "content": "全部つまんない",
            "Chinese": "全部都很无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 15:03:17",
            "content": "そっかあ。全部つまらないかぁ。これからどうしていきたい？学校に通いたい？",
            "Chinese": "这样啊。全部都很无聊啊。那你今后想怎么做呢？想去上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 15:03:23",
            "content": "行きたくない",
            "Chinese": "不想去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 15:03:44",
            "content": "働きたい？",
            "Chinese": "想工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 15:03:49",
            "content": "やだ",
            "Chinese": "不要。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 15:05:26",
            "content": "複雑な気持ちだよね。どうしていきたい？",
            "Chinese": "心情很复杂吧。你希望自己接下来怎么做？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 15:05:40",
            "content": "わかんね",
            "Chinese": "不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 15:07:03",
            "content": "そうだよね。今日、ここで相談してみてどうだったかな？",
            "Chinese": "是啊。今天在这里聊了聊，感觉怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 15:07:11",
            "content": "よくわからん",
            "Chinese": "不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 15:08:56",
            "content": "そっかぁ。そろそろお時間となりますが、言っておきたいことあるかな？",
            "Chinese": "这样啊。时间差不多了，还有什么想说的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/25(火) 15:09:51",
            "content": "もういいや",
            "Chinese": "算了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/25(火) 15:11:18",
            "content": "終了ボタン押しますね。ありがとうございました。",
            "Chinese": "那我按结束按钮了。谢谢你。"
        }
    ],
