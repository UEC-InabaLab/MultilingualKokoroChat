{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 15:53:16",
            "content": "こんにちはよろしくお願いします",
            "Chinese": "您好，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 15:55:20",
            "content": "よろしくお願いいたします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 15:55:45",
            "content": "少し時間が早いですが、今から始めてもよろしいでしょうか勿論、時間どうりでも、構いません",
            "Chinese": "时间稍微早了一点，我们现在可以开始吗？当然，准时开始也没关系。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 15:55:54",
            "content": "はい、大丈夫です",
            "Chinese": "好的，没问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 15:56:28",
            "content": "ありがとうございますでは、始めます",
            "Chinese": "谢谢您，那么我们开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 15:56:42",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 15:57:18",
            "content": "こんにちは相談員です今日は、ご相談にきていただき、ありがとうございますよろしくお願いします",
            "Chinese": "您好，我是咨询师。感谢您今天前来咨询，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 15:57:36",
            "content": "今日は、どのようなご相談ですか",
            "Chinese": "今天您想咨询什么方面的问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 15:57:37",
            "content": "こんにちは、よろしくお願いいたします",
            "Chinese": "您好，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 15:58:09",
            "content": "はい、会社に行くのが気が重くて",
            "Chinese": "是的，去公司上班让我感到心情沉重。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 15:58:31",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 15:58:51",
            "content": "もう少し、詳しく教えていただけませんか",
            "Chinese": "能请您再详细说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:00:05",
            "content": "在宅ワークが4月からだったのですが、10月以降に出勤をするようになって、でも、取引先が在宅ワークだったりしてとっても暇なんです。会社に行ってもやることもないのにずっと時間つぶしみたいにしていて。",
            "Chinese": "我从4月份开始居家办公，但10月以后就要去公司上班了。但是，客户那边也是居家办公，所以我特别闲。去了公司也没什么事可做，感觉一直在消磨时间。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:00:39",
            "content": "だんだん私のいる意味あるのかなって",
            "Chinese": "渐渐地我开始觉得，我待在那里还有意义吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:01:17",
            "content": "そうなんですね・・・そのように思ってしまわれたんですね",
            "Chinese": "是这样啊……您会不由自主地那么想了呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:01:55",
            "content": "かといって休みをとるのはまわりにわるいし",
            "Chinese": "话虽如此，请假又觉得对不起周围的同事。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:02:12",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:02:46",
            "content": "今現在、会社に行っている人は、何人くらいなんですか",
            "Chinese": "目前大约有多少人在公司上班呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:03:37",
            "content": "大体30名が同じ部屋ですが、会社全体は1000人くらいです",
            "Chinese": "大约30人在同一个办公室，但整个公司大约有1000人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:04:04",
            "content": "そうなんですね・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:04:15",
            "content": "そんなに多くの人が、",
            "Chinese": "有这么多人，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:04:41",
            "content": "会社に行って、勤務しているのですね",
            "Chinese": "都到公司上班了啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:05:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:05:24",
            "content": "他の方も、暇なのですか",
            "Chinese": "其他人也都比较清闲吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:05:42",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:06:03",
            "content": "そうなんですね・・それは、困りますよね",
            "Chinese": "是这样啊……那确实很困扰呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:06:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:07:03",
            "content": "そんなにたくさんの人が、暇をつぶしていらっしゃるのですか",
            "Chinese": "有那么多人都在打发时间吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:07:32",
            "content": "もちろん程度の違いはあると思いますけど",
            "Chinese": "当然，我觉得程度会有所不同。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:07:44",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:08:00",
            "content": "以前よりは業務量が減っています",
            "Chinese": "业务量比以前少了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:08:57",
            "content": "そうなんですね・・あまりにも、することがなければ、かえって疲れてしまいますよね",
            "Chinese": "是这样啊……如果太无事可做，反而会觉得累吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:09:07",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:09:28",
            "content": "今、とんなことをされていらっしゃるのですか",
            "Chinese": "您现在主要在做些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:09:41",
            "content": "主に営業事務ですね",
            "Chinese": "主要是销售事务方面的工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:09:55",
            "content": "そうなんですね",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:10:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:10:46",
            "content": "毎日、どのくらいの時間、働いていらっしゃるのですか",
            "Chinese": "您每天大概工作多长时间呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:11:09",
            "content": "9時から5時です",
            "Chinese": "早上九点到下午五点。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:11:20",
            "content": "そうなんですね",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:12:24",
            "content": "会社に行って、同僚の方とは、仲がよろしいですか",
            "Chinese": "在公司里，您和同事们关系还好吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:12:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:13:31",
            "content": "会社にいって、何かお困りのことは、ありませんか",
            "Chinese": "去公司后，有什么让您为难或困扰的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:13:58",
            "content": "しごとでですか？",
            "Chinese": "是指工作上的吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:14:38",
            "content": "仕事でも、同僚の方とのことでも、その他でも、何でもよいです",
            "Chinese": "工作上的、和同事相处的，或者其他任何方面都可以。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:15:16",
            "content": "具体的に困っていることは無いです。",
            "Chinese": "没有什么具体的困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:15:30",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:15:48",
            "content": "ただやる意味とか感じられないです",
            "Chinese": "只是感觉做这些没有什么意义。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:16:22",
            "content": "そうなんですね・・辛いですね",
            "Chinese": "是这样啊……这确实挺让人难受的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:16:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:17:49",
            "content": "やる気がないのは、何か、理由は、ありますか、暇以外でも、",
            "Chinese": "除了很闲之外，还有其他什么原因导致您提不起干劲吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:18:22",
            "content": "わからないんです",
            "Chinese": "我也不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:19:41",
            "content": "ちなみに、年齢、性別、お名前は、なんとお呼びしたらよろしいですか",
            "Chinese": "顺便问一下，您的年龄、性别，以及我该如何称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:20:08",
            "content": "30才、女性、佐藤です",
            "Chinese": "30岁，女性，姓佐藤。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:20:36",
            "content": "佐藤さん、教えていただき、ありがとうございます",
            "Chinese": "佐藤女士，感谢您的告知。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:20:57",
            "content": "ｈくぃ",
            "Chinese": "（声音含糊）"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:21:04",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:21:33",
            "content": "佐藤さんは、毎日お元気で暮らしていますか",
            "Chinese": "佐藤女士，您每天过得还好吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:21:55",
            "content": "たいちょうのことですか？",
            "Chinese": "是指身体状况吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:21:59",
            "content": "体調",
            "Chinese": "身体状况。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:22:04",
            "content": "はい、",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:22:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:22:22",
            "content": "特別問題ありません",
            "Chinese": "没有什么特别的问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:22:26",
            "content": "それは、よかったです",
            "Chinese": "那太好了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:22:57",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:23:17",
            "content": "家族は、何人で暮らしていますか",
            "Chinese": "您家里有几口人呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:23:26",
            "content": "3にんです",
            "Chinese": "3个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:24:03",
            "content": "佐藤さんと、どなたと一緒に暮らしていますか",
            "Chinese": "佐藤女士，您是和谁一起住呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:24:26",
            "content": "相談にひつようなのでしょうか",
            "Chinese": "这些信息对咨询是必要的吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:25:10",
            "content": "言いたくなければ、言わなくても、構いません",
            "Chinese": "如果您不想说，不说也没关系。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:25:19",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:26:12",
            "content": "会社に行くのが、気が重いのは、どうしてですか",
            "Chinese": "为什么您会觉得去公司上班心情沉重呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:26:51",
            "content": "意味がないと思われていらっしゃるのですね",
            "Chinese": "您是觉得这样做没有意义，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:26:52",
            "content": "行ってもやることが無いし、行く意味あるのかなって思うからです",
            "Chinese": "因为去了也没什么事可做，就会想“这么去有意义吗”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:27:57",
            "content": "佐藤さんは、今以上に、仕事をしたいと、思われますか",
            "Chinese": "佐藤女士，您是希望做比现在更多的工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:29:01",
            "content": "今以上って量的にということですか？",
            "Chinese": "您说的“比现在更多”，是指工作量上吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:29:17",
            "content": "ええ、",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:30:39",
            "content": "そうでもないですが・・・",
            "Chinese": "也不是那样……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:31:06",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:31:10",
            "content": "やりがいのある仕事をしたいです",
            "Chinese": "我想做有成就感的工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:31:37",
            "content": "そうなんですね・・やりがいのある仕事って、素敵ですよね",
            "Chinese": "是这样啊……有成就感的工作，确实很棒呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:31:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:32:40",
            "content": "佐藤さんは、今のままのお仕事を続けたいと思われますか。それとも、転職したいと思われますか",
            "Chinese": "佐藤女士，您是想继续现在的工作，还是想换工作呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:33:17",
            "content": "転職とかはこのコロナの状態でむりじゃないですか？",
            "Chinese": "现在这种疫情状况，换工作什么的，不可能吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:34:42",
            "content": "そう思われるのですね必ずしも、無理とは、限らないとわたしは、思いますが",
            "Chinese": "您是这么想的啊。不过我认为，也未必就完全不可能。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:35:04",
            "content": "そうですか",
            "Chinese": "是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:35:26",
            "content": "仕事の内容によると思います",
            "Chinese": "我觉得这取决于工作内容。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:36:16",
            "content": "じゃあ転職した方がいいんですかね",
            "Chinese": "那我该不该换工作呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:37:08",
            "content": "佐藤さんが、転職したければ、です。このようなことを、誰かに相談したことが、ありますか",
            "Chinese": "这取决于您自己是否想换工作。这类事情，您和别人商量过吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:37:30",
            "content": "いえ、今日が初めてです",
            "Chinese": "没有，今天是第一次。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:37:44",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/16(水) 16:38:02",
            "content": "転職については、どのように思われますか",
            "Chinese": "对于换工作，您是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/16(水) 16:38:32",
