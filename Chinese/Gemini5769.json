{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 12:52:35",
            "content": "(こんにちは。本日はよろしくお願い致します。）",
            "Chinese": "您好。今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 12:52:50",
            "content": "（よろしくお願いいたします。）",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:00:14",
            "content": "こんにちは、相談員です。",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:00:40",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:01:04",
            "content": "よろしければ、はじめに年齢・性別・本日のご相談内容について教えていただけますか？",
            "Chinese": "如果方便的话，能否先告知您的年龄、性别以及今天想咨询的内容？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:01:23",
            "content": "中1女子です",
            "Chinese": "我是初一女生。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:01:34",
            "content": "どうしたらアイドルになれる？",
            "Chinese": "怎样才能成为偶像呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:01:42",
            "content": "教えてくれてありがとうございます。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:01:54",
            "content": "アイドルになりたいお気持ちがあるんですね。",
            "Chinese": "原来您是想成为偶像啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:02:42",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:02:49",
            "content": "いつ頃からアイドルになりたいと考えるようになりましたか？",
            "Chinese": "您大概是从什么时候开始想成为偶像的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:03:11",
            "content": "いつだろう",
            "Chinese": "什么时候呢……"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:03:15",
            "content": "4年生くらい？",
            "Chinese": "大概四年级的时候？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:03:38",
            "content": "そうなんですね、素敵な夢ですね。",
            "Chinese": "是这样啊，这是个很美好的梦想呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:03:57",
            "content": "ありがとう！",
            "Chinese": "谢谢！"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:04:17",
            "content": "でもママはダメって言う",
            "Chinese": "但妈妈说不行。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:05:10",
            "content": "そっか・・お母様に反対されているんですね。お母さまはどうしてダメって言いますか？",
            "Chinese": "是这样啊……也就是说妈妈在反对，对吗？她为什么说不行呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:05:28",
            "content": "なれるわけない",
            "Chinese": "不可能成为的。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:05:34",
            "content": "お金かかりそう",
            "Chinese": "好像很花钱。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:05:46",
            "content": "危ない",
            "Chinese": "危险。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:05:49",
            "content": "そんな感じ",
            "Chinese": "大概就是这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:06:31",
            "content": "そうなんですね、せっかく素敵な夢を持っていて、そう言われてしまうのは落ち込みますね。",
            "Chinese": "是这样啊。好不容易有了这么棒的梦想，却被这么说，会感到很失落吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:06:48",
            "content": "落ち込まない！",
            "Chinese": "我才不失落！"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:06:56",
            "content": "アイドルになるって決めてるから！",
            "Chinese": "因为我决定了要成为偶像！"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:07:18",
            "content": "あなたのアイドルになりたいという強いお気持ちが伝わってきます。",
            "Chinese": "我能感受到您想成为偶像的强烈愿望。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:07:39",
            "content": "アイドルになりたいと思ったきっかけを聞かせてくれますか？",
            "Chinese": "能否告诉我您想成为偶像的契机呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:08:44",
            "content": "あんまりかわいくない子も乃木坂とかにいて、わたしの方がアイドルに向いてるって思った",
            "Chinese": "乃木坂之类的组合里也有不怎么可爱的女生，我觉得我比她们更适合当偶像。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:08:51",
            "content": "歌も自信ある",
            "Chinese": "我对唱歌也很有自信。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:09:58",
            "content": "教えてくれてありがとう。自信を持てることがあること、すばらしいですね。",
            "Chinese": "谢谢您告诉我。有自己自信的地方，这很了不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:10:26",
            "content": "アイドルになるために、何かやっていることはありますか？",
            "Chinese": "为了成为偶像，您有在做什么努力吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:10:57",
            "content": "踊りが苦手だから、tiktokとか見て練習してる",
            "Chinese": "因为不擅长跳舞，所以我在看TikTok之类的视频练习。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:11:41",
            "content": "本当は動画とりたいんだけど",
            "Chinese": "其实我想拍视频……"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:12:06",
            "content": "まだ友だちにバラしてないから、とってって言えなくて",
            "Chinese": "但还没跟朋友公开，所以不好意思叫她们帮我拍。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:13:20",
            "content": "そうなんですね、tiktokを見てお一人で練習しているんですか？",
            "Chinese": "是这样啊，您是自己一个人看着TikTok练习吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:13:29",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:14:13",
            "content": "あなたは努力家だと感じました。",
            "Chinese": "我觉得您是个很努力的人。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:14:42",
            "content": "そうかな",
            "Chinese": "是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:15:26",
            "content": "夢に向かって、コツコツ努力することは簡単なことではないと思いますよ。",
            "Chinese": "朝着梦想踏实努力，可不是一件容易的事呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:15:51",
            "content": "ちなみにお友達にはアイドルになりたいお気持ちを伝えていないのは、どうしてですか？",
            "Chinese": "顺便问一下，您为什么没有告诉朋友想成为偶像的事呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:16:09",
            "content": "んー",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:16:16",
            "content": "なんかちょっと恥ずかしい",
            "Chinese": "感觉有点不好意思。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:16:23",
            "content": "本気すぎるｗ",
            "Chinese": "因为太认真了（笑）。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:18:30",
            "content": "なるほど・・アイドルになりたいという気持ちがちょっと恥ずかしかったり、本気でそう思っていることを言えない・・ということで合っていますか？",
            "Chinese": "原来如此……您的意思是，觉得想当偶像这件事有点不好意思，或者因为是认真的，所以反而说不出口……是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:18:49",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:18:56",
            "content": "本気だから言えない感じ",
            "Chinese": "就是因为太认真了才说不出口的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:20:15",
            "content": "本気だからこそ、慎重になる感じでしょうか。アイドルになる夢をとても大切にされているんですね。",
            "Chinese": "是不是正因为认真，所以才变得很慎重呢？您非常珍视成为偶像的这个梦想啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:20:37",
            "content": "アイドルになりたい",
            "Chinese": "我想成为偶像。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:20:42",
            "content": "オーディション受けたい",
            "Chinese": "我想参加选拔。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:22:48",
            "content": "アイドルになりたいお気持ち、すごく伝わってきますよ。そのお気持ちを叶えるために、できそうなこと、一緒に考えていきたいと思っています。",
            "Chinese": "我非常能感受到您想成为偶像的心情。为了实现这个愿望，我想和您一起思考一下能做些什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:23:07",
            "content": "今はオーディションについて調べたりしていますか？",
            "Chinese": "您现在有在查询选拔相关的信息吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:23:14",
            "content": "お願いします！",
            "Chinese": "拜托您了！"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:24:49",
            "content": "さっき踊りの練習をしていることを話してくれましたね。",
            "Chinese": "刚才您提到您在练习跳舞。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:26:25",
            "content": "他にはアイドルになるために、こんなことできそうだなとか、したいなと思っていることがあったら教えてもらえますか？",
            "Chinese": "除此之外，为了成为偶像，如果您还有什么觉得可以做，或者想做的事情，能告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:27:04",
            "content": "おー",
            "Chinese": "哦……"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:27:13",
            "content": "なんだろ",
            "Chinese": "是什么呢……"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:27:38",
            "content": "髪型の研究してる",
            "Chinese": "我在研究发型。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:27:51",
            "content": "どういうのが似合うか",
            "Chinese": "什么样的发型适合我。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:28:28",
            "content": "話があんまり上手じゃないかも",
            "Chinese": "我可能不太会说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:28:54",
            "content": "うんうん、似合っている髪型を研究すること、良い取り組みですね。",
            "Chinese": "嗯嗯，研究适合自己的发型，这是个很好的尝试呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:28:54",
            "content": "笑わせたりしないと",
            "Chinese": "必须得能逗人笑才行。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:29:27",
            "content": "髪型は友だちとできるし楽しい",
            "Chinese": "发型可以和朋友一起弄，很开心。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:29:48",
            "content": "アイドルのこと言わなくても一緒に試してる",
            "Chinese": "就算不提当偶像的事，也会一起试试。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:30:24",
            "content": "楽しいことを取り入れて、夢に向かっていくことは大切なことと思います。",
            "Chinese": "把有趣的事情融入其中，一边享受一边朝梦想前进，我觉得这很重要。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:30:43",
            "content": "お話しはちょっと心配なところがある感じなんですね。",
            "Chinese": "您对说话这件事，感觉有点担心是吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:30:46",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:30:47",
            "content": "楽しい",
            "Chinese": "很开心。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:30:53",
            "content": "でもママがダメって言う",
            "Chinese": "但是妈妈说不行。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:31:01",
            "content": "どうしたらいいですか？",
            "Chinese": "我该怎么办呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:31:38",
            "content": "あそう、話すのはヘタみたい",
            "Chinese": "啊对了，我好像不擅长说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:31:57",
            "content": "少し行違ってしまったところがあったので、ここまでのお話しを少しまとめさせて下さいね。",
            "Chinese": "可能刚才有些地方我们没对上，请允许我稍微总结一下目前为止的谈话内容。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:32:22",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:33:55",
            "content": "あなたはアイドルになる為に、踊りの練習をしたり、お友達と髪型の研究をしています。少しお話しに不安があります。アイドルになることについて、お母様にダメと言われて、どうしたら良いかなと悩んでいます。",
            "Chinese": "您为了成为偶像，在练习跳舞，和朋友一起研究发型。您对说话有些不安。关于成为偶像这件事，妈妈说不行，您正在烦恼该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:34:28",
            "content": "ここまでのお話しは、こんな感じで合っていますか？（もし違うところがあったら教えて下さいね）",
            "Chinese": "目前的整理大致是这样，对吗？（如果有不对的地方请告诉我。）"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:34:29",
            "content": "そうそう",
            "Chinese": "对对。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:34:38",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:35:52",
            "content": "アイドルは危ないのかな",
            "Chinese": "当偶像会很危险吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:36:58",
            "content": "お母さまはアイドルは危ないと言っているんでいたね。",
            "Chinese": "您妈妈是说当偶像很危险，对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:37:25",
            "content": "どうしてお母さまはそう言っているか・・何かお話ししましたか？",
            "Chinese": "妈妈为什么会这么说……她有和您聊过什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:37:39",
            "content": "んーなんか",
            "Chinese": "嗯……怎么说呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:37:41",
            "content": "詐欺とか",
            "Chinese": "比如诈骗啊，"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:38:03",
            "content": "だまされるからって言う",
            "Chinese": "说会被人骗之类的。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:38:14",
            "content": "あとストーカーとか",
            "Chinese": "还有跟踪狂之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:38:48",
            "content": "なるほど、お母さまはあなたの身の安全を心配するお気持ちがあるんですね。",
            "Chinese": "原来如此，妈妈是担心您的人身安全啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:39:30",
            "content": "そっか",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/09/29(金) 13:40:02",
            "content": "でもアイドルはたくさんいる",
            "Chinese": "但是偶像有很多啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/09/29(金) 13:40:58",
            "content": "そうですね、必ずしもアイドルになったからそういう危険に巻き込まれるわけではないと思いますよね。",
