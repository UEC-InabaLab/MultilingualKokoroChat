{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 20:59:58",
            "content": "こんばんは。今日はよろしくお願いします。",
            "Chinese": "晚上好。今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:00:11",
            "content": "よろしくお願いいたします",
            "Chinese": "也请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:00:27",
            "content": "始めさせていただいてもよろしいでしょうか？",
            "Chinese": "我们可以开始了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:00:31",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:01:17",
            "content": "こんばんは。相談員です。今日はどんなご相談でしょうか？",
            "Chinese": "晚上好，我是咨询员。今天您有什么想咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:01:33",
            "content": "死にたい",
            "Chinese": "我想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:02:54",
            "content": "死にたいと思っておられるんですねそう思うほど、きっと辛いことがあったんでしょうね",
            "Chinese": "您是有了想死的念头啊。会这么想，想必是遇到了非常痛苦的事情吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:03:36",
            "content": "まだ話していませんがそんなかんじです",
            "Chinese": "虽然我还没说，但差不多是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:03:39",
            "content": "良かったら、お話を聞かせてもらえませんか？",
            "Chinese": "如果您愿意的话，能跟我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:04:33",
            "content": "友達に見捨てられた",
            "Chinese": "我被朋友抛弃了。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:04:41",
            "content": "あれだけ信じていたのに",
            "Chinese": "我明明那么信任对方……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:04:57",
            "content": "誰も信じられない",
            "Chinese": "我谁也无法相信了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:05:19",
            "content": "そうなんですね信じてたのに・・・それはひどいですね",
            "Chinese": "是这样啊。明明那么信任他……这真是太过分了。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:05:48",
            "content": "友達だと思っていた",
            "Chinese": "我以为我们是朋友。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:05:55",
            "content": "でももう違う",
            "Chinese": "但现在已经不是了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:05:56",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:06:05",
            "content": "もうわからない",
            "Chinese": "我已经不知道了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:06:51",
            "content": "分からない？",
            "Chinese": "不知道？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:07:07",
            "content": "生きる意味がわからない",
            "Chinese": "我不明白活着的意义。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:08:02",
            "content": "そう思っておられるんですね友だちに裏切られた気持ちでいっぱいで、悔しいですね",
            "Chinese": "您是这么想的啊。心里充满了被朋友背叛的感觉，一定很不甘心吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:08:15",
            "content": "裏切られた",
            "Chinese": "被背叛了。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:08:17",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:08:30",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:08:50",
            "content": "その友達はどんな友達でしたか？",
            "Chinese": "那位朋友是怎样的朋友呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:08:59",
            "content": "親友",
            "Chinese": "挚友。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:09:24",
            "content": "そうだったんですね親友だったら、余計に許せないですね",
            "Chinese": "原来是挚友啊。既然是挚友，那就更无法原谅了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:09:35",
            "content": "ゆるせない",
            "Chinese": "无法原谅。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:09:48",
            "content": "かなしい",
            "Chinese": "很伤心。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:10:08",
            "content": "ショックだし、すごく悲しいですね",
            "Chinese": "您一定很震惊，也非常伤心吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:10:40",
            "content": "生きていられない",
            "Chinese": "我活不下去了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:10:43",
            "content": "良かったら、どんなことがあったか教えていただけませんか？",
            "Chinese": "如果您愿意的话，能告诉我发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:11:46",
            "content": "最高の親友だと思ってたのに",
            "Chinese": "我一直以为那是我最好的朋友，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:11:54",
            "content": "その子は他の子が親友だと",
            "Chinese": "可那个人却觉得另一个人才是自己的挚友，"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:11:55",
            "content": "思ってた",
            "Chinese": "是那么想的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:11:58",
            "content": "しんどい",
            "Chinese": "好痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:12:02",
            "content": "裏切られた",
            "Chinese": "我被背叛了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:12:04",
            "content": "生きていられないと感じるほど、あなたは傷ついていているんですね",
            "Chinese": "您已经受伤到觉得活不下去的地步了啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:12:34",
            "content": "傷ついてる、そう",
            "Chinese": "受伤了，是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:12:43",
            "content": "つらいですね",
            "Chinese": "一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:12:44",
            "content": "リスカもしてる",
            "Chinese": "我也在割腕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:13:14",
            "content": "いつからですか？今？",
            "Chinese": "从什么时候开始的？现在吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:13:19",
            "content": "今",
            "Chinese": "现在。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:14:09",
            "content": "傷口はどう？？出血は多いの？？？",
            "Chinese": "伤口怎么样？出血多吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:14:17",
            "content": "血はない",
            "Chinese": "没有出血。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:14:21",
            "content": "体調は大丈夫？？",
            "Chinese": "身体状况还好吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:14:32",
            "content": "平気",
            "Chinese": "没事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:15:05",
            "content": "良かった・・出血ないんですね傷だけですか？？",
            "Chinese": "太好了……没有出血啊。只是有伤口吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:15:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:16:31",
            "content": "良かった・・・ホッしました。あなたが無事でよかったです。リスカは初めてかな？今までもあるのかな？",
            "Chinese": "太好了…我松了一口气。您没事就好。是第一次割腕吗？以前也有过？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:16:47",
            "content": "今までもある",
            "Chinese": "以前也有过。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:16:55",
            "content": "嫌な時あったり",
            "Chinese": "遇到讨厌的事情时就会。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:17:04",
            "content": "みんなしてる",
            "Chinese": "大家都在做。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:17:07",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:17:16",
            "content": "え？みんな？",
            "Chinese": "欸？大家？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:17:35",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:17:49",
            "content": "みんなって誰ですか？",
            "Chinese": "您说的“大家”是指谁呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:17:59",
            "content": "知り合い",
            "Chinese": "认识的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:18:36",
            "content": "友だちではなくて、しりあいなんだどんな知り合い？",
            "Chinese": "不是朋友，而是熟人啊。是怎样的熟人？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:18:49",
            "content": "学校",
            "Chinese": "学校里的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:19:50",
            "content": "学校の知り合いなんだね。今、何年生？？",
            "Chinese": "是学校里的熟人啊。您现在读几年级？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:20:29",
            "content": "高２",
            "Chinese": "高二。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:22:35",
            "content": "高２なんだね学校はどんな感じ？",
            "Chinese": "高二了啊。在学校怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:23:19",
            "content": "どんな感じ、、",
            "Chinese": "怎么样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:24:19",
            "content": "お返事しにくいかな",
            "Chinese": "是不是不太好回答？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:26:17",
            "content": "話すのが難しいなら話さなくても大丈夫です",
            "Chinese": "如果觉得很难开口，不说也没关系的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:26:50",
            "content": "そういうことではありません",
            "Chinese": "不是那个意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:28:35",
            "content": "そうなんですね分かりにくかったかもしれないですね。学校ではどう過ごしているのかな？",
            "Chinese": "是这样啊。可能我问得不太清楚。您在学校一般是怎么度过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:28:47",
            "content": "普通に過ごしてます",
            "Chinese": "就普通地过着。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:28:55",
            "content": "普通って？",
            "Chinese": "“普通”是指？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:29:27",
            "content": "普通は普通です",
            "Chinese": "普通就是普通。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:31:15",
            "content": "普通って言われても、人によって普通はひとりひとり違うから、難しいね",
            "Chinese": "虽然您说是“普通”，但每个人对“普通”的定义都不一样，所以这有点难呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:31:42",
            "content": "どういうことですか",
            "Chinese": "这是什么意思？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:32:49",
            "content": "「普通」って、人によって違うよね。あなたはどう思いますか？",
            "Chinese": "所谓的“普通”，是因人而异的吧。您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:35:09",
            "content": "なんでその質問をするんですか",
            "Chinese": "为什么要问这个问题？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:36:39",
            "content": "あなたが思う普通って、どんなのかな～と思って、聞いてみました。",
            "Chinese": "我是在想，您所认为的“普通”是什么样的，所以就问了一下。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:37:02",
            "content": "それ聞いてどうするんですか",
            "Chinese": "问这个有什么用呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:37:27",
            "content": "無理に答えることはないので",
            "Chinese": "您不必勉强回答。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:37:43",
            "content": "話したくないなら話さなくて大丈夫です",
            "Chinese": "如果不想说，不说也没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:38:11",
            "content": "ここではあなたが話したいことを話してもらえたら大丈夫です",
            "Chinese": "在这里，您想谈什么就谈什么，没关系的。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:38:17",
            "content": "私のせいですね",
            "Chinese": "是我的错吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:38:20",
            "content": "だめですね",
            "Chinese": "我真没用啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:38:31",
            "content": "あなたのせい？",
            "Chinese": "您的错？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:38:37",
            "content": "だめ？",
            "Chinese": "没用？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:38:39",
            "content": "余計なこと言ったから",
            "Chinese": "因为我说了多余的话。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:38:45",
            "content": "もういいです",
            "Chinese": "算了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:39:21",
            "content": "何も余計なことは言ってないです",
            "Chinese": "您没有说任何多余的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:40:07",
            "content": "こちらこそ、話したくないことを聞いてしまったんですね",
            "Chinese": "应该说是我，问了您不想说的事情。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:40:38",
            "content": "もういいです私が悪いので",
            "Chinese": "算了，都是我的错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:42:44",
            "content": "そんなことはないです。あなたは何も悪くありません。",
            "Chinese": "没有这回事。您没有任何错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:45:31",
            "content": "どうしましょうか。このまま、お話続けられますか？",
            "Chinese": "我们接下来怎么办呢？还能继续谈下去吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:48:59",
            "content": "しんどいんでやめます",
            "Chinese": "我太难受了，不说了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:52:37",
            "content": "そうなんですね。分かりました。今日は辛い気持ちの中、ここにくれて本当にありがとうございました。最後にあなたに伝えたいことがあるので、お伝えしてもいいでしょうか？",
            "Chinese": "是这样啊，我明白了。今天您在如此痛苦的心情下还能来到这里，真的非常感谢。最后，我有些话想对您说，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/25(火) 21:52:55",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/25(火) 21:56:57",
