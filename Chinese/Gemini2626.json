{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:00:04",
            "content": "こんばんは。本日はよろしくお願い致します。",
            "Chinese": "晚上好。今天请您多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:00:16",
            "content": "よろしくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:00:30",
            "content": "早速ですがロールプレイを始めさせて頂きます。",
            "Chinese": "那么，我们就马上开始角色扮演吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:00:43",
            "content": "はい、お願いします",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:01:20",
            "content": "こんばんは。相談員です。初めに年齢と性別を伺ってもよろしいでしょうか？",
            "Chinese": "晚上好。我是咨询员。首先可以请教一下您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:01:47",
            "content": "17歳、女性",
            "Chinese": "17岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:01:56",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:02:07",
            "content": "本日はどういった相談でしょうか？",
            "Chinese": "今天您想咨询什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:02:47",
            "content": "最近、教室にいてもなんとなく不安で、息苦しさを感じます",
            "Chinese": "最近，即使在教室里，我也会感到莫名的不安，觉得喘不过气来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:03:03",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:03:16",
            "content": "それはしんどいですよね。",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:03:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:03:34",
            "content": "何かきっかけとかはあったのでしょうか？",
            "Chinese": "有没有什么具体的原因呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:03:56",
            "content": "それが分からないんです",
            "Chinese": "我也不太清楚。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:04:15",
            "content": "自分でもどうしたらいいのか…",
            "Chinese": "我自己也不知道该怎么办才好……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:04:23",
            "content": "なるほど。わからないと余計にしんどいですよね。",
            "Chinese": "原来如此。不清楚原因的话，确实会更加难受呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:04:39",
            "content": "今日は一緒に考えていきましょうね。",
            "Chinese": "今天我们一起来想一想吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:04:40",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:05:34",
            "content": "お願いします",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:05:46",
            "content": "もちろんです。",
            "Chinese": "当然。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:06:04",
            "content": "今のクラスでの状況を聞いてもよろしいですか？",
            "Chinese": "我可以了解一下您现在班级里的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:06:13",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:06:28",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:07:27",
            "content": "どういった時に不安や苦しさを感じますか？",
            "Chinese": "您在什么样的情况下会感到不安或难受呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:08:38",
            "content": "教室で普通に勉強をしていても、何をしていても不安や緊張がとれません",
            "Chinese": "就算在教室里正常学习，无论做什么都无法摆脱不安和紧张。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:09:28",
            "content": "何をしていても不安や緊張状態が続いてしまうのは辛いですよね。",
            "Chinese": "无论做什么都一直处于不安和紧张的状态，确实很不容易呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:09:39",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:09:56",
            "content": "一緒に過ごす友達はいらっしゃいますか？",
            "Chinese": "您有可以一起相处的朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:10:43",
            "content": "いますが、休み時間に少し話すくらいです",
            "Chinese": "有，不过也就是在休息时间简单聊几句。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:10:56",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:11:24",
            "content": "その友達と一緒にいる時はどんな気持ちになりますか？",
            "Chinese": "和那位朋友在一起时，您的心情如何呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:12:18",
            "content": "普通です。何も思いません。",
            "Chinese": "很普通。没什么特别的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:12:27",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:13:05",
            "content": "17歳ということですか高校2年生ですか？",
            "Chinese": "您17岁，是高二学生吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:13:16",
            "content": "はい、そうです",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:13:25",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:13:44",
            "content": "1年生の時はどうお過ごしでしたか？",
            "Chinese": "高一的时候您过得怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:14:49",
            "content": "1年の時は、あまり不安とは思いませんでした",
            "Chinese": "高一的时候，我不太觉得不安。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:15:01",
            "content": "そうだったのですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:15:28",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:15:35",
            "content": "不安に思わなかった理由はわかりますか？",
            "Chinese": "您知道为什么那时没有感到不安吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:15:59",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:16:14",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:16:37",
            "content": "2年生になってから急に不安な気持ちになることが増えたということでしょうか？",
            "Chinese": "也就是说，升上二年级之后，突然感到不安的情况变多了是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:17:09",
            "content": "はい、最近とくに感じるようになりました",
            "Chinese": "是的，最近尤其明显。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:17:20",
            "content": "自分でもどうしたらいいのかわかりません",
            "Chinese": "我自己也不知道该怎么办才好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:17:33",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:17:44",
            "content": "苦しい気持ちを抱えてよく踏ん張ってこられましたね。",
            "Chinese": "一直带着这么难受的心情还能坚持到现在，您真的很不容易。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:18:04",
            "content": "はい、ありがとうございます",
            "Chinese": "是的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:18:42",
            "content": "心から思います。",
            "Chinese": "我是发自内心地这么觉得的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:18:48",
            "content": "今の不安な気持ちは誰かにお話しされましたか？",
            "Chinese": "您把现在的不安情绪跟谁说过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:19:05",
            "content": "誰にも話していません",
            "Chinese": "我没有跟任何人说过。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:19:19",
            "content": "お一人で抱えてこられたのですね。",
            "Chinese": "原来一直都是您一个人扛着过来的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:19:33",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:19:49",
            "content": "それはお辛かったですよね。",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:20:25",
            "content": "はい、もうしんどいです",
            "Chinese": "是的，已经很难受了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:21:12",
            "content": "お一人で抱えてこられたのですからそう思うのも無理ないですよね。",
            "Chinese": "您一直一个人承受着，会这么想也是理所（当然的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:22:01",
            "content": "少し話せるクラスメイトがいると伺いましたが、その方とはどんな話をされますか？",
            "Chinese": "您提到有能聊上几句的同学，那通常会聊些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:23:13",
            "content": "授業全然わからなかったとか、たわいも無い話です。",
            "Chinese": "就是聊一些“上课完全听不懂”之类的，没什么要紧的话题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:23:25",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:23:43",
            "content": "あの子がどうだとか、こうだとか　です",
            "Chinese": "就是说那个谁谁谁怎么样了之类的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:24:28",
            "content": "噂話のようなものですか？",
            "Chinese": "是类似八卦闲聊吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:24:56",
            "content": "そうですね、あまり深い話はしません",
            "Chinese": "算是吧，我们不怎么聊深入的话题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:25:06",
            "content": "そうねのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:25:18",
            "content": "それは何故ですか？",
            "Chinese": "那是为什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:25:33",
            "content": "なぜ？",
            "Chinese": "为什么？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:26:02",
            "content": "そういう話にならないから？",
            "Chinese": "大概是因为……聊不到那种深入的话题上吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:26:15",
            "content": "わかりにくくてすみません。",
            "Chinese": "抱歉，可能是我没表达清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:26:45",
            "content": "深い話をされないのはどうしてなのかなと思ったのですが聞いてもいいですか？",
            "Chinese": "我只是在想，您为什么不聊深入的话题呢，我可以问一下吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:26:51",
            "content": "いいえ、だいじょうぶです",
            "Chinese": "不，没关系的。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:26:58",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:27:17",
            "content": "でも、どうしてかわかりません",
            "Chinese": "但是，我也不知道是为什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:27:27",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:27:36",
            "content": "深い話したほうがいいのでしょうか",
            "Chinese": "我是不是应该聊一些更深入的话题比较好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:27:50",
            "content": "いいえ、そんなことはありませんよ。",
            "Chinese": "不，没有这回事的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:28:40",
            "content": "もし話せない理由があるなら解決の一手段になるかと思ったので。",
            "Chinese": "我只是觉得，如果有什么不能聊的理由，那找到这个理由或许会是解决问题的一个方法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:29:18",
            "content": "学校にいて不安や緊張しない時間はありますか？",
            "Chinese": "在学校里，有不感到不安和紧张的时候吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:30:20",
            "content": "たまに昼休みに、一人で図書館にいる時です",
            "Chinese": "偶尔午休的时候，我一个人待在图书馆里。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:30:38",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:30:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:31:03",
            "content": "その時間はほっとする感じですか？",
            "Chinese": "那个时候会有种松一口气的感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:31:26",
            "content": "少し落ち着きます",
            "Chinese": "会稍微平静一些。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:31:32",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:31:55",
            "content": "落ち着く時間は大切ですよね。",
            "Chinese": "能让自己平静下来的时间很重要呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:32:09",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:32:32",
            "content": "1日でどれくらい図書室に行きますか？",
            "Chinese": "您一天会去几次图书馆呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:34:05",
            "content": "毎日は行ってません。曜日によって行く感じです",
            "Chinese": "不是每天都去，分星期几去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:34:16",
            "content": "そうだったのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:34:50",
            "content": "月曜とか水曜は行くこと多いです",
            "Chinese": "周一和周三去得比较多。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:35:10",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:35:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:35:36",
            "content": "どういう学校生活が理想的だと思いますか？",
            "Chinese": "您觉得什么样的学校生活是理想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:36:44",
            "content": "不安や緊張を感じずに、もっと楽に学校で過ごせるようになりたいです",
            "Chinese": "我希望能不再感到不安和紧张，在学校里过得更轻松一些。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:36:57",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:38:45",
            "content": "勉強中にも不安を感じることがあるとおっしゃっていましたが、授業を受けていて不安に感じることはどれくらいありますか？",
            "Chinese": "您提到学习时也会感到不安，那在上课时感到不安的情况有多频繁呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:40:04",
            "content": "最近はよくあります",
            "Chinese": "最近经常会这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:40:11",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/28(木) 20:40:35",
            "content": "それは勉強の理解が難しいという不安ですか？",
            "Chinese": "那是因为学习内容难以理解而感到不安吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/28(木) 20:40:52",
            "content": "それもあると思います",
