    },
    {
      "role": "client",
      "time": "2020-12-31T11:01:12",
      "origin": "ありがとうございます。",
      "content": "谢谢您。"
    },
    {
      "role": "client",
      "time": "2020-12-31T11:01:33",
      "origin": "実は…彼がいるんですけど、",
