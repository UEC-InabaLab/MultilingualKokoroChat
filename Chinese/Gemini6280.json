{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 19:51:13",
            "content": "こんばんは。今日はよろしくお願いいたします。",
            "Chinese": "晚上好。今天请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 19:51:27",
            "content": "よろしくお願い致します。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 19:52:26",
            "content": "お時間になりましたら始めさせたいただきます。",
            "Chinese": "时间到了，我们现在开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 19:52:40",
            "content": "ありがとうございます。承知しました。",
            "Chinese": "谢谢您。我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:00:23",
            "content": "こんばんは、相談員です。始めに年齢と性別を教えてください。",
            "Chinese": "晚上好，我是咨询师。首先请告诉我您的年龄和性别。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:00:41",
            "content": "25歳　女性",
            "Chinese": "25岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:00:56",
            "content": "ありがとうございます。今日のご相談内容を教えてください。",
            "Chinese": "谢谢您。请告诉我您今天想咨询什么内容呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:01:16",
            "content": "母のことについて",
            "Chinese": "是关于我母亲的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:01:59",
            "content": "そうなのですね。お母様のどのようなことでお悩みなのですか？",
            "Chinese": "是这样啊。关于您母亲的什么事情让您烦恼呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:02:22",
            "content": "いつも自分を頼ってきて",
            "Chinese": "她总是很依赖我。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:02:26",
            "content": "嫌です",
            "Chinese": "我很讨厌这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:03:18",
            "content": "そうなのですね、ご相談者様をお母様は頼られているのですね。",
            "Chinese": "是这样啊，原来是您的母亲很依赖您。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:03:43",
            "content": "まあ、はい",
            "Chinese": "嗯……算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:04:11",
            "content": "お母様は今おいくつなのですか？",
            "Chinese": "您母亲现在多大年纪了？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:04:26",
            "content": "50歳です",
            "Chinese": "50岁。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:06:08",
            "content": "そうなのですね。いつからお母様はご相談者様を頼られているのですか？",
            "Chinese": "是这样啊。您母亲是从什么时候开始依赖您的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:06:26",
            "content": "小さい頃から",
            "Chinese": "从小时候开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:07:11",
            "content": "なるほど、それはかなり長く頼られてきたのですね。",
            "Chinese": "原来如此，那她依赖您已经很长时间了呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:07:36",
            "content": "もう疲れてます",
            "Chinese": "我已经很累了。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:08:39",
            "content": "離れて暮らしているのに",
            "Chinese": "明明我们已经分开住了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:09:02",
            "content": "そうなんですね、それは疲れると思います。",
            "Chinese": "是啊，那想必一定很累吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:09:57",
            "content": "これってAIですか？",
            "Chinese": "这是AI吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:10:24",
            "content": "ちがいます。大変失礼いたしました。",
            "Chinese": "不是的。非常抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:10:33",
            "content": "わかりました",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:11:22",
            "content": "お母様のことを今まで誰かにお話しされたことはありますか？",
            "Chinese": "关于您母亲的事情，您有跟谁聊过吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:11:46",
            "content": "うーん",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:12:01",
            "content": "話した事はあるけど",
            "Chinese": "虽然聊过……"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:12:11",
            "content": "わかってもらえなかった",
            "Chinese": "但他们不理解。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:13:07",
            "content": "そうだったのですね。ご自身としては分かってもらえなくてお辛かったですよね。",
            "Chinese": "是这样啊。不被理解，您一定很难过吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:13:27",
            "content": "もう嫌なんです",
            "Chinese": "我真的受够了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:15:05",
            "content": "そうなんですね、頼られるというの具体的にどのようなことを頼られるのですか？",
            "Chinese": "是吗？您说的“依赖”，具体是指依赖您做些什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:15:23",
            "content": "お金の無心とか",
            "Chinese": "比如找我要钱。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:15:40",
            "content": "いきなり呼びつけるとか",
            "Chinese": "或者突然把我叫过去。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:16:07",
            "content": "いろいろあります",
            "Chinese": "还有很多其他事。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:16:26",
            "content": "そうなのですね、ご相談者様のことを考えていただけないのですね。",
            "Chinese": "是这样啊，看来她并没有为您着想呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:17:28",
            "content": "ご相談者様のご親族にお話はされましたか？",
            "Chinese": "您和您的亲属谈过这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:17:32",
            "content": "考えてないからできるんじゃないんですか",
            "Chinese": "就是因为她不考虑我，才能做出这种事吧？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:17:41",
            "content": "親族って？",
            "Chinese": "亲属是指？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:18:16",
            "content": "ご家族です。",
            "Chinese": "指您的家人。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:18:35",
            "content": "話したってわかってくれない",
            "Chinese": "就算说了他们也不会理解的。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:18:44",
            "content": "ずっとそうだから",
            "Chinese": "一直以来都是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:19:35",
            "content": "そうなのですね、それは一人で抱え込んでいらした、ということでしょうか？",
            "Chinese": "我明白了，那也就是说这些一直都是您一个人扛着吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:20:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:21:35",
            "content": "なるほど、よくおひとりで頑張られてこられましね。",
            "Chinese": "原来如此，您一个人坚持到现在，真的很不容易。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:22:13",
            "content": "はい・・・",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:25:06",
            "content": "ご相談者はこれからどのようにお母様と接していきたい、とお考えですか？",
            "Chinese": "您今后希望怎样和您的母亲相处呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:26:10",
            "content": "離れたいけど",
            "Chinese": "虽然想和她保持距离……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:27:22",
            "content": "なるほど、そうなのですね。でもお母様はそうはならない、ともお考えなのでしょうか？",
            "Chinese": "原来如此。但您是否也觉得，母亲那边可能不会如您所愿呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:27:28",
            "content": "もう一人で暮らしているし",
            "Chinese": "而且她现在一个人住。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:27:43",
            "content": "無理な気がする",
            "Chinese": "感觉不太可能。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:29:29",
            "content": "そうなのですね、でもお母様はまだ50歳ですよね。お元気だと思いますが。",
            "Chinese": "原来如此，但您母亲才50岁，应该还很健康吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:29:47",
            "content": "病気だから",
            "Chinese": "因为她生病了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:30:39",
            "content": "そうだったのですね。それは悩まれますよね。",
            "Chinese": "原来如此，难怪让您很为难。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:32:18",
            "content": "行政などに相談したことはありますか？",
            "Chinese": "您有向政府机构等咨询过吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:32:29",
            "content": "ないです",
            "Chinese": "没有。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:32:41",
            "content": "ここって話を聞いてくれるんじゃないんですか？",
            "Chinese": "我来这里，不就是来倾诉的吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:33:32",
            "content": "はい、ご相談者様のお話をお聞きします。",
            "Chinese": "是的，我们会认真聆听您的诉说。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:35:26",
            "content": "お母様は今どのような状態なのですか？",
            "Chinese": "您母亲现在是什么样的状态呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:35:37",
            "content": "家事もできないし",
            "Chinese": "她连家务都做不了，"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:35:46",
            "content": "通院しています",
            "Chinese": "需要定期去医院，"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:35:55",
            "content": "精神の病気なので",
            "Chinese": "因为患有精神疾病。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:36:24",
            "content": "そうなのですね、それでご相談者様に頼られているのですね。",
            "Chinese": "原来是这样，所以她才这么依赖您。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:36:36",
            "content": "でも限界です",
            "Chinese": "但我已经到了极限。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:38:38",
            "content": "そうなんですね、でもそんなにつらくてもお母様は行政などに頼らずに、このまま頑張っておひとりで見ていくおつもりなのですか？",
            "Chinese": "我理解。不过即使这么辛苦，您也不打算寻求政府等方面的帮助，打算就这样一个人撑着照看她吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:39:03",
            "content": "だからここに来ています",
            "Chinese": "正因如此，我才来到这里。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:39:40",
            "content": "そうなのですね、それはありがとうございます。",
            "Chinese": "明白了，感谢您前来。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:41:05",
            "content": "でも相談員はご相談者様のお体と心のことを考えても、どなたかに助けていただいたほうがいいと思いますが、いかかですか？",
            "Chinese": "但是，作为咨询师，考虑到您的身心健康，我认为寻求他人的帮助会更好，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:41:25",
            "content": "家族も見て見ぬふりだし",
            "Chinese": "家人也装作看不见，"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:41:34",
            "content": "父も弟も",
            "Chinese": "我父亲和我弟弟都是。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:42:43",
            "content": "そうだったのですね。ご家族はお母様と別に暮らしていらっしゃるのでしょうか？",
            "Chinese": "是这样啊。您的家人是和您母亲分开住的吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:42:56",
            "content": "いえ、一緒に暮らしています",
            "Chinese": "不，他们住在一起。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:43:04",
            "content": "私は離れたので",
            "Chinese": "是我搬出来了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:44:21",
            "content": "なるほど、そういうことなのですね。ご家族はなぜご一緒に暮らしているお母様に関心がないのですか？",
            "Chinese": "原来是这样。那为什么您的家人对和他们住在一起的母亲漠不关心呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:45:07",
            "content": "私がやるものだと思っているから",
            "Chinese": "因为他们觉得这些事就该我来做。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:46:49",
            "content": "そうなのですね、ご長女であるご相談者様にみなさんも頼られている、ということなのですね。",
            "Chinese": "是这样啊，也就是说，大家也都依赖着作为长女的您。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:47:33",
            "content": "そうやってみんな言ってくる",
            "Chinese": "他们都这么说。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:47:55",
            "content": "親孝行な娘とか言われたら、どこにも話せないですよ",
            "Chinese": "要是被说是“孝顺的女儿”，我就更没法跟任何人说了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:48:53",
            "content": "なるほど、そうだったのですね。",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:49:47",
            "content": "ご自身としてもそういわれていたら、助けないわけにはいかないですよね。",
            "Chinese": "如果您自己也被人这么说，确实很难不去帮助她吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:51:01",
            "content": "でも限度を越しています",
            "Chinese": "但已经超出了我的承受范围。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:51:35",
            "content": "そうなんですね、本当にお辛いですよね。",
            "Chinese": "我明白，您真的很辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:53:30",
            "content": "お一人で暮らしていられるとおっしゃいましたが、何かリラックスできることなどは考えたことはございますか？",
            "Chinese": "您说您现在一个人住，那有没有想过做些什么让自己放松一下呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:54:31",
            "content": "いつも不安で",
            "Chinese": "我总是很不安。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:55:19",
            "content": "母、職場にきた事もあったし",
            "Chinese": "我妈还来过我的公司。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:55:27",
            "content": "怖いんです",
            "Chinese": "我很害怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/01/19(金) 20:56:28",
            "content": "そうなのですね、離れているご相談者様のお宅まで来られるんですね。",
            "Chinese": "是这样啊，她竟然会去已经分开住的您的家里。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:56:37",
            "content": "職場です",
            "Chinese": "是公司。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:56:41",
            "content": "私の",
            "Chinese": "我的公司。"
        },
        {
            "role": "クライアント",
            "time": "2024/01/19(金) 20:57:04",
