{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:25:59",
            "content": "こんばんは。本日はよろしくお願いいたします。",
            "Chinese": "晚上好。今天请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:26:19",
            "content": "時間になりましたらお声がけします。",
            "Chinese": "时间到了我会提醒您。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:27:22",
            "content": "本日はよろしくお願いします。わかりました。",
            "Chinese": "今天请多关照。我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:30:42",
            "content": "こんばんは。相談員です。本日はよろしくお願いいたします。はじめにご年齢と性別を教えていただけますか？",
            "Chinese": "晚上好，我是咨询师。今天请多关照。首先，可以告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:30:51",
            "content": "よろしくお願いします。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:31:14",
            "content": "２０代前半の社会人です",
            "Chinese": "我是二十出头的上班族。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:31:22",
            "content": "女性です",
            "Chinese": "女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:31:41",
            "content": "ありがとうございます。本日はどのようなご相談ですか？",
            "Chinese": "谢谢您。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:31:59",
            "content": "お母さんの存在が鬱陶しく感じてしまうので、相談したいです",
            "Chinese": "我觉得妈妈的存在很烦人，想和您谈谈。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:32:48",
            "content": "お母様のことについてですね。",
            "Chinese": "是关于您母亲的事情呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:32:54",
            "content": "はいそうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:33:13",
            "content": "どのようなことがあったのですか。",
            "Chinese": "具体发生了什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:33:52",
            "content": "特にこういうことがあったというわけではないんですが",
            "Chinese": "其实并没有发生什么特别的事情，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:33:59",
            "content": "結構私に依存しているので",
            "Chinese": "只是她对我依赖得挺严重的，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:34:02",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:34:06",
            "content": "それがたまに苦しくなります",
            "Chinese": "这让我有时觉得很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:34:53",
            "content": "そうなんですね。苦しく感じているのですね。",
            "Chinese": "是这样啊。您感到很难受，是吗。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:35:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:35:40",
            "content": "依存しているというと、例えばどのようなご様子なのですか？",
            "Chinese": "您说她依赖您，具体是怎样的表现呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:36:00",
            "content": "私がちょっとでもお母さんからのラインの返信が遅いと",
            "Chinese": "只要我回复妈妈的LINE消息稍微晚一点，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:36:06",
            "content": "かなり怒ってきたり",
            "Chinese": "她就会非常生气，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:36:09",
            "content": "電話するときは",
            "Chinese": "打电话时，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:36:10",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:36:21",
            "content": "私がいないとさみしい、結局お母さんはひとりぼっちといって",
            "Chinese": "她会说“没有你我很寂寞，到头来妈妈还是孤零零一个人”，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:36:44",
            "content": "そういうことをたくさんいってきます",
            "Chinese": "她会说很多这样的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:36:47",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:37:39",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:37:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:38:18",
            "content": "返信が遅いだけで怒られると嫌な気分にもなりますし、",
            "Chinese": "只是因为回复晚了就被责备，确实会让人心里不舒服，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:39:22",
            "content": "電話するときに結局お母さんはひとりぼっちという感じはめんどくささを感じてしまいますね。",
            "Chinese": "而且打电话时总是说“妈妈终究是一个人”，也会让人感到心累呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:39:30",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:40:02",
            "content": "それは困ってしまいますよね。",
            "Chinese": "这确实很让人困扰呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:40:06",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:41:23",
            "content": "お母様が鬱陶しく感じるな、と思うときはどのくらいの頻度で感じるのですか？",
            "Chinese": "您大概多久会觉得母亲很烦人呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:41:38",
            "content": "電話をしたり、ラインがきたり、そういう接点がある度です",
            "Chinese": "每次打电话、收到LINE消息，只要有接触的时候都会。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:41:54",
            "content": "そうなんですね。",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:41:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:42:46",
            "content": "それだと接点がある度にお母様に困惑してしまいますよね。",
            "Chinese": "那样的话，每次有接触您都会对母亲感到困扰呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:42:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:43:28",
            "content": "あなたはお母様とは別に暮らしているのですか？",
            "Chinese": "您现在和母亲是分开住的吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:43:36",
            "content": "そうです、別々に暮らしています",
            "Chinese": "是的，我们分开住。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:44:10",
            "content": "そうなんですね。別々に暮らしてどれぐらい経ちますか？",
            "Chinese": "是这样啊。分开住多久了？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:44:20",
            "content": "高校生からなので",
            "Chinese": "从高中开始的，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:44:27",
            "content": "5年くらいとかですかね",
            "Chinese": "大概有5年左右了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:44:53",
            "content": "そうなんですね。",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:45:13",
            "content": "ひあ",
            "Chinese": "啊，是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:45:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:45:48",
            "content": "別々に暮らすことになった5年くらい前からお母様はそのような様子なのですか？",
            "Chinese": "从大概5年前开始分开住的时候，您母亲就是这个样子了吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:45:55",
            "content": "もうずっと前からです",
            "Chinese": "从很早以前就是了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:46:07",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:46:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:46:48",
            "content": "長い間あなたは困っておられたのですね。",
            "Chinese": "看来您已经被这件事困扰很久了呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:46:59",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:48:09",
            "content": "お母様の存在が鬱陶しく感じるとおっしゃってましたが、",
            "Chinese": "您刚才说觉得母亲的存在很烦人，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:49:14",
            "content": "たまに苦しくなるともおっしゃってました。",
            "Chinese": "也提到有时会感到难受。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:49:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:49:57",
            "content": "苦しくなるというのは、どんな感情があったり、答えられる範囲で教えていただけますか？",
            "Chinese": "您说的“难受”，具体是指什么样的感受呢？可以在您方便说的范围内告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:50:22",
            "content": "そうですね",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:50:32",
            "content": "なんか、自分のことをみてもらえてないんだなと",
            "Chinese": "就是感觉，她没有看到我这个人。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:50:34",
            "content": "思います",
            "Chinese": "我是这么觉得的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:50:58",
            "content": "お母さん自身が自分のさみしいしかみていないんだなって",
            "Chinese": "感觉妈妈只看得到她自己的寂寞。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:51:05",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:51:30",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:51:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:53:18",
            "content": "お母様は自分のさみしいという感情をいうのに対し、",
            "Chinese": "您母亲会表达自己“很寂寞”的感受，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:53:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:54:19",
            "content": "あなたのことに関しては言わない、という感じですか？",
            "Chinese": "但似乎不太提及您的事情，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:54:33",
            "content": "私のことに関して言わないと言うか",
            "Chinese": "与其说是不说我的事，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:54:42",
            "content": "表面的なことしか聞いてこないと言う感じですね",
            "Chinese": "不如说是只问一些表面上的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:54:42",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:55:10",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:55:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:56:19",
            "content": "だと話してても内面まで見てもらえてない、聴いてもらえてない、",
            "Chinese": "这样一来，即便和她聊天，也感觉内心没有被看见、没有被真正倾听，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:56:27",
            "content": "という感じですか？",
            "Chinese": "是这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:56:35",
            "content": "うーん、そうですね",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:56:38",
            "content": "昔から",
            "Chinese": "从以前开始就是了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:56:47",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:56:48",
            "content": "最近学校どう？仕事どう？の後",
            "Chinese": "问完“最近学校怎么样？”“工作怎么样？”之后，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:56:59",
            "content": "こうだよ、って答えたら",
            "Chinese": "我回答说“就是这样这样”之后，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:57:04",
            "content": "うんうん、",
            "Chinese": "嗯嗯两声，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:57:07",
            "content": "えー大変だね、無理しないでね",
            "Chinese": "就说“哎呀，真不容易啊，别太勉强自己哦”，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:57:08",
            "content": "おわり",
            "Chinese": "然后就结束了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:57:11",
            "content": "みたいな感じで",
            "Chinese": "就是这种感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:57:18",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:57:30",
            "content": "その後、お母さん早く会いたいとか寂しいって話になるので",
            "Chinese": "之后话题就转到“妈妈好想快点见到你”或者“好寂寞”之类的话题上，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:57:57",
            "content": "全然深く聴いてくれないなって感じです",
            "Chinese": "所以感觉她完全没有深入地听我说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:58:09",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:58:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 19:59:39",
            "content": "お母さまは早く会いたいとか寂しいって話をするのに、あなたのことを聞くときあっさりとされてる感じがしますね。",
            "Chinese": "您母亲在说想见您、很寂寞的时候，问起您的事情时却显得很敷衍，有这种感觉呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:59:46",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 19:59:50",
            "content": "それは感じます",
            "Chinese": "我确实有这种感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:00:14",
            "content": "ええ。そうですよね。",
            "Chinese": "嗯，是啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:00:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:01:27",
            "content": "では今回のご相談ではどのような点をご相談されたいですか？",
            "Chinese": "那么，这次您想咨询哪些方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:01:50",
            "content": "どうやったらお母さんの存在を苦に思わず楽になれるかです",
            "Chinese": "我想知道怎样才能不把妈妈的存在当作负担，让自己轻松一些。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:03:06",
            "content": "そうなのですね。教えていただきありがとうございます。",
            "Chinese": "原来如此。谢谢您告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:03:10",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:04:05",
            "content": "どうやったらお母さんの存在を苦に思わず楽になれるか、あなたにとって大事なことなので一緒に考えてみましょうね。",
            "Chinese": "“怎样才能不把母亲的存在当作负担，让自己轻松一些”，这对您来说很重要，我们一起来思考一下吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:04:17",
            "content": "はい、お願いします",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:04:46",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:05:30",
            "content": "また話が戻ってしまいますが、",
            "Chinese": "话题可能要回到前面了，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:05:42",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:06:58",
            "content": "お母様があなたのことに関して表面的なことしか聞いてこないとき、",
            "Chinese": "当您母亲只问您一些表面上的事情时，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:07:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:07:50",
            "content": "あなたはどんなお気持ちになるのですか？",
            "Chinese": "您心里会有什么感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:08:04",
            "content": "寂しいですね",
            "Chinese": "会觉得很寂寞。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:08:33",
            "content": "ええ。そうなんですね。",
            "Chinese": "嗯，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:08:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:10:06",
            "content": "自分の親に表面的なことしか聞かれなかったら、誰しもが寂しさを感じると思います。",
            "Chinese": "如果自己的父母只问一些表面的事情，谁都会感到寂寞的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:10:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:11:58",
            "content": "そのようなとき、あなたの心の中ではどんなことを思ってる感じですか？",
            "Chinese": "在那种时候，您的心里大概在想些什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:12:15",
            "content": "もっと内面まで聞いてよ、とか。",
            "Chinese": "比如，“多问问我内心的想法啊”之类的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:12:31",
            "content": "もっと自分を見て欲しいな、向き合ってほしかったなって思ったりもういい加減こばなれしてほしあなとおもいませ",
            "Chinese": "我会想“希望她能多看看我，多关注我”，但同时又想“真希望她能放手让我独立”。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:12:41",
            "content": "子離れして欲しいなと思います",
            "Chinese": "希望她能放手让我独立。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:13:03",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:13:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:13:55",
            "content": "自分を見て欲しいと思うその反面、子離れして欲しいと思っておられるんですね。",
            "Chinese": "一方面希望她能关注自己，另一方面又希望她能放手让您独立，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:14:01",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:14:54",
            "content": "ちなみにお父様にはこのことについて、相談しましたか？",
            "Chinese": "顺便问一下，您和父亲谈过这件事吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:15:02",
            "content": "知ってる感じですか？",
            "Chinese": "他知道情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:15:07",
            "content": "うーん、相談はしてないですけど",
            "Chinese": "嗯……没有特意商量过，但是"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:15:15",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:15:18",
            "content": "父の前でも母はそういう発言をするので",
            "Chinese": "妈妈在爸爸面前也会说那些话，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:15:24",
            "content": "分かっているかとはおもいます",
            "Chinese": "所以我想他应该是知道的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:15:48",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:15:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:17:06",
            "content": "お母様が子離れしてないことについて、何か思い当たるようなことはありますか？",
            "Chinese": "关于您母亲不太能放手这件事，您有想到什么可能的原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:17:48",
            "content": "母も、家庭環境は複雑で母のお母さんからもあまりちゃんと愛を受けてそだたなかったみたいなので",
            "Chinese": "我母亲的家庭环境也比较复杂，她好像也没有从她的母亲（我的外婆）那里得到足够的爱，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:18:00",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:18:07",
            "content": "また、父との関係も悪いので、私に依存してしまうのも無理はないかな思います",
            "Chinese": "另外，她和父亲的关系也不好，所以我觉得她依赖我大概也是情有可原的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:18:37",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:18:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:19:31",
            "content": "家庭環境やお父様との関係から、あなたに依存してしまうのも無理はないかなと感じているのですね。",
            "Chinese": "您觉得因为家庭环境以及和您父亲的关系，她依赖您也是情有可原的，是这样吗。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:19:39",
            "content": "はいそうです",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:21:32",
            "content": "もしかするとそういったことがあってあなたに依存している、かもしれないけど",
            "Chinese": "或许确实是因为那些原因，她才会依赖您，但是，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:22:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:22:41",
            "content": "でもあなたにとって依存されることから楽になるために、",
            "Chinese": "为了让您自己能从被依赖的状态中解脱出来，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:23:03",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:23:04",
            "content": "自分にできそうなことって、どんなことがありますか？",
            "Chinese": "您觉得有什么是自己可以做到的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:23:32",
            "content": "そーですねー。。",
            "Chinese": "这个嘛……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:23:40",
            "content": "いままでいろんなこと試してきましたけど",
            "Chinese": "我之前也尝试过很多方法了，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:23:50",
            "content": "あんまり効果を実感できてないので",
            "Chinese": "但并没有感觉到什么明显的效果，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:23:56",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:23:58",
            "content": "どうしたらいいか分からないですね。",
            "Chinese": "所以也不知道该怎么办了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:24:23",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:24:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:24:46",
            "content": "いままでいろんなことを試す努力をされてきたんですね。",
            "Chinese": "您一直在努力尝试各种方法呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:24:56",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:25:39",
            "content": "ええ。それだけなんとかしようと考えてこられたんですね。",
            "Chinese": "嗯，这说明您一直在努力思考，想要改变现状呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:25:44",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:25:45",
            "content": "ちなみに、",
            "Chinese": "顺便问一下，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:26:40",
            "content": "お母様の依存は、改善できそうって感じたりしますか？",
            "Chinese": "您觉得母亲的这种依赖，有改善的可能吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:26:54",
            "content": "私の力では難しそうですね",
            "Chinese": "光靠我的力量，恐怕很难。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:27:24",
            "content": "そう感じるのですね。",
            "Chinese": "您是这么觉得的啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:27:28",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:29:05",
            "content": "依存は簡単には改善できないと",
            "Chinese": "依赖这个问题，确实不是那么容易改善的，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:29:28",
            "content": "思います。",
            "Chinese": "我是这么认为的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:29:37",
            "content": "そうですけ",
            "Chinese": "是吗。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:29:38",
            "content": "ね",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:29:48",
            "content": "なので、今後も接点がある度に",
            "Chinese": "所以，今后每次和她接触时，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:30:37",
            "content": "自分はひとりぼっちと言ったりすると思います。",
            "Chinese": "我想她可能还是会说自己是“孤单一个人”之类的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:30:43",
            "content": "なので、",
            "Chinese": "所以，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:32:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:32:49",
            "content": "「自分はひとりぼっち」と言うだろうと思って聞いてあげたり、",
            "Chinese": "您可以抱着“她大概又要说自己孤单了”这样的心态去听，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:33:45",
            "content": "ある程度過去の経験から「こう母は出てくる」と予測すると",
            "Chinese": "或者根据过去的经验，在某种程度上预测“妈妈接下来会是这种反应”，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:34:10",
            "content": "気持ち的に準備ができたり、",
            "Chinese": "这样在心理上就能有所准备，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:34:55",
            "content": "もちろんもっと自分を見て欲しいなというさみしいもあると思いますが、",
            "Chinese": "当然，您肯定还是会有希望她多关注自己的那种寂寞感，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:35:25",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:36:12",
            "content": "母親の心理を観察、推測できてると少し気持ち的に楽になるかなと",
            "Chinese": "但如果能够观察、推测母亲的心理，或许心情上会稍微轻松一些，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:36:22",
            "content": "思いますが、いかがですか？",
            "Chinese": "您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:36:29",
            "content": "そうですね",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:36:45",
            "content": "予測はもうしているんですが、また意識してみたいと思います",
            "Chinese": "其实我已经在这么预测了，但今后会再有意识地去试试看。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:37:28",
            "content": "そうだったんですね。予測で大事な点は、",
            "Chinese": "是这样啊。关于这个预测，重要的一点是，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:38:29",
            "content": "あなた自身が苦に思わないことが一番大事な点になります。",
            "Chinese": "您自己不因此感到难受，这才是最重要的一点。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:38:37",
            "content": "そうですね、ありがとうございます",
            "Chinese": "是的，谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:39:15",
            "content": "お時間なりましたので、ここら辺にさせていただいて大丈夫でしょうか",
            "Chinese": "时间差不多了，我们今天就先到这里可以吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:39:30",
            "content": "なので自分自身の気持ちを一番に考えるつもりでお母様と接して見てくださいね。",
            "Chinese": "所以请您试着在和母亲接触时，把自己的感受放在第一位。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:39:39",
            "content": "はい、ありがとうございます",
            "Chinese": "好的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:39:45",
            "content": "長引いてしまいすみません。",
            "Chinese": "拖延了一点时间，非常抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:39:50",
            "content": "とんでもないです",
            "Chinese": "没关系。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/17(火) 20:39:57",
            "content": "貴重なお時間ありがとうございました",
            "Chinese": "感谢您宝贵的时间。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/17(火) 20:40:06",
            "content": "終了させていただきますね。",
            "Chinese": "那么本次咨询就到此结束了。"
        },
