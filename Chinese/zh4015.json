{
  "dialogue": [
    {
      "role": "counselor",
      "time": "2022-09-22T09:53:01",
      "origin": "（おはようございます。今日はよろしくお願いします。）",
      "content": "（早上好。今天请多关照。）"
    },
    {
      "role": "client",
      "time": "2022-09-22T09:53:19",
      "origin": "よろしくお願いします。",
      "content": "请多关照。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T09:53:42",
      "origin": "（時間前ですが、定時からスタートしますか？）",
      "content": "（虽然还没到时间，但要从预定时间开始吗？）"
    },
    {
      "role": "client",
      "time": "2022-09-22T09:53:59",
      "origin": "お任せします。",
      "content": "听您的安排。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T09:54:37",
      "origin": "（それでは、これかこら１時間でお願いします。）",
      "content": "（好的，那么接下来一个小时，拜托了。）"
    },
    {
      "role": "client",
      "time": "2022-09-22T09:54:48",
      "origin": "了解しました。",
      "content": "明白了。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T09:55:35",
      "origin": "おはようございます。相談員です。まず初めによろしかったら年齢、性別、相談内容についてお聞かせ下さい。",
      "content": "早上好。我是咨询员。首先，如果方便的话，请您告诉我您的年龄、性别，以及咨询的内容。"
    },
    {
      "role": "client",
      "time": "2022-09-22T09:56:18",
      "origin": "おはようございます、40代、女性です、相談内容は、",
      "content": "早上好，我四十多岁，女性，想咨询的内容是……"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T09:56:29",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2022-09-22T09:56:41",
      "origin": "姉との関係についてです、",
      "content": "是关于我和姐姐的关系。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T09:58:25",
      "origin": "そうなんですね。お姉さまとの関係ということで、具体的にはどのようなことでご相談でしょうか？",
      "content": "这样啊。您说是关于和姐姐的关系，具体是想咨询哪方面的问题呢？"
    },
    {
      "role": "client",
      "time": "2022-09-22T09:59:11",
      "origin": "4つ上に姉がいるのですが、最近疎遠にしています、",
      "content": "我有一个大我四岁的姐姐，最近我们变得有些疏远了。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T09:59:22",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2022-09-22T09:59:34",
      "origin": "もうお互い大人なので、",
      "content": "毕竟我们都已经是成年人了，"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T09:59:42",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2022-09-22T09:59:50",
      "origin": "ベタベタする必要はありませんが、",
      "content": "虽然也没必要总是黏在一起，"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:00:04",
      "origin": "このままでいいのかな、",
      "content": "但总会想，这样下去真的好吗？"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:00:05",
      "origin": "そう思われていらっしゃるのですね。",
      "content": "您是这么想的呀。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:00:28",
      "origin": "とたまに思ったりします、",
      "content": "偶尔会这么想。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:00:39",
      "origin": "そうなんですね。",
      "content": "是这样啊。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:00:45",
      "origin": "はい、",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:01:45",
      "origin": "それは、気になられますよね。このままでいいのかなと思われますよね。",
      "content": "这确实会让人在意呢。会想“这样下去真的好吗”。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:01:56",
      "origin": "はい、",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:02:43",
      "origin": "いつ頃からそのようにお感じになられたのでしょうか？",
      "content": "您是从什么时候开始有这种感觉的呢？"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:03:12",
      "origin": "この数日です、",
      "content": "就是这几天。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:03:29",
      "origin": "明日、兄夫婦が遊びに来るので、",
      "content": "因为明天我哥和嫂子要来玩，"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:03:39",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:03:44",
      "origin": "思い出しました、",
      "content": "我就想起了这件事。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:03:54",
      "origin": "そうなんですね。",
      "content": "这样啊。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:03:58",
      "origin": "はい、",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:05:04",
      "origin": "お姉さんとの間でそのように感じられる何かきっかになるようなことは、ございましたか？",
      "content": "您和姐姐之间，有没有发生过什么事，成为了您产生这种感觉的契机呢？"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:05:48",
      "origin": "はい、今年の新年の集まりで、",
      "content": "有的，在今年新年聚会的时候。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:05:57",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:06:20",
      "origin": "酔っ払って子どもたちの前でおでこを叩かれました。",
      "content": "她喝醉了，当着孩子们的面敲了我的额头。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:06:51",
      "origin": "姉は冗談のつもりだと思うのですが、",
      "content": "我想姐姐应该只是开个玩笑，"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:07:08",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:07:22",
      "origin": "とても腹が立ち、それから距離を取っています、",
      "content": "但我非常生气，从那之后就和她保持着距离。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:08:05",
      "origin": "そんな事が、おありだったのですね。それは、腹が立ちますよね。",
      "content": "原来发生过那样的事啊。那确实会很生气呢。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:08:11",
      "origin": "はい、",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:09:19",
      "origin": "どうしてお姉さまは、そのような事をされたか、考えられると事は、おありですか？",
      "content": "您认为姐姐为什么会那么做呢？您有没有想过可能的原因？"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:09:59",
      "origin": "母から聞いた話しですが、",
      "content": "我是听我妈说的，"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:10:07",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:10:54",
      "origin": "わたしが冗談で旦那のことを悪く言ったことに対してツッコミを入れたと、、",
      "content": "（她说）是因为我开玩笑地说了我丈夫的坏话，她才“吐槽”我的……"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:11:10",
      "origin": "なるほど",
      "content": "原来如此。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:11:12",
      "origin": "わたしの旦那のことなのに、",
      "content": "明明是我自己的丈夫，"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:11:23",
      "origin": "何が悪いのか、",
      "content": "这有什么不对的吗？"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:11:41",
      "origin": "そうですよね",
      "content": "是啊。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:13:06",
      "origin": "その話をお母さまからお聞きになられて、どんなお気持ちになられましたか？",
      "content": "当您从母亲那里听到这些之后，您心里是什么感受呢？"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:13:31",
      "origin": "自分のことを棚に上げて、",
      "content": "（我觉得）她这是严于律人，宽于待己，"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:13:38",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:13:42",
      "origin": "とさらに腹が立ちました、",
      "content": "我就更生气了。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:15:27",
      "origin": "そう思われたのですね。自分の事を棚に上げてとお聞きしましたが、お姉さまも旦那さんの事を、お母さまに話されていらしゃるのでしょうか？",
      "content": "您是这样想的啊。您刚才说她“严于律人，宽于待己”，是指姐姐也会跟母亲说她丈夫的事吗？"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:16:32",
      "origin": "姉は旦那さんに頭が上がらないので、悪くいいません、",
      "content": "姐姐很怕她丈夫，所以不会说他的坏话。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:16:52",
      "origin": "そうなんですね。",
      "content": "这样啊。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:17:11",
      "origin": "でも、他の人、自分が気に入らない人に対しては全否定します、",
      "content": "但是，对于其他人，尤其是她看不顺眼的人，她会全盘否定。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:17:28",
      "origin": "そうなんですか。",
      "content": "是这样吗。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:18:17",
      "origin": "それは、貴方としては、納得いかないですよね。",
      "content": "这在您看来，确实是难以接受的吧。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:18:32",
      "origin": "はい、",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:19:04",
      "origin": "ご兄弟は、何人でいらしゃるのでしょうか？",
      "content": "您家兄弟姐妹一共有几位呢？"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:19:27",
      "origin": "３人兄妹です",
      "content": "我们兄妹三人。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:20:23",
      "origin": "そうでらっしゃるんですね。お兄さまとは、どのような関係でいらしゃるのでしょうか？",
      "content": "是这样啊。那您和哥哥的关系怎么样呢？"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:20:41",
      "origin": "私ですか？",
      "content": "我吗？"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:20:54",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:21:02",
      "origin": "良好です、",
      "content": "关系很好。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:21:25",
      "origin": "兄はあまり自己主張しないタイプなので、",
      "content": "哥哥是不太爱表达自己想法的类型，"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:22:04",
      "origin": "いつも中立でいたがります、",
      "content": "总是想保持中立。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:22:04",
      "origin": "そうなんですね。お兄さまとお姉さまの関係は、どのような感じでいらしゃるのでしょうか？",
      "content": "这样啊。那哥哥和姐姐的关系怎么样呢？"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:22:22",
      "origin": "兄はシスコンです、",
      "content": "我哥是个“姐控”。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:22:36",
      "origin": "姉には服従しています、",
      "content": "对姐姐言听计从。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:23:01",
      "origin": "昔からそうでしたね、",
      "content": "从小时候起就是这样了。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:23:06",
      "origin": "そうなんですね。それは、貴方としては、やりきれないですよね。",
      "content": "是这样啊。对您来说，这确实让人感到无奈吧。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:23:51",
      "origin": "そうですね、、",
      "content": "是啊……"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:24:14",
      "origin": "そう思います。",
      "content": "我理解您的感受。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:25:34",
      "origin": "貴方と、お姉さまのこういった関係は、いつ頃からそう感じられるようになられたのでしょうか？",
      "content": "您和姐姐的这种关系，是从什么时候开始让您有这种感觉的呢？"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:26:08",
      "origin": "わたしが結婚してからですかね、、",
      "content": "应该是我结婚之后吧……"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:26:27",
      "origin": "そうなんですか。",
      "content": "是这样啊。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:26:37",
      "origin": "独身のころは可愛がってくれていました、",
      "content": "我单身的时候，她还挺疼我的。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:26:50",
      "origin": "そうだったのですね。",
      "content": "原来是这样啊。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:26:59",
      "origin": "甥っ子たちともよく遊びましたし、",
      "content": "我也经常和外甥们一起玩，"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:27:12",
      "origin": "なるほど",
      "content": "原来如此。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:27:17",
      "origin": "はい、",
      "content": "嗯。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:28:42",
      "origin": "貴方のご結婚が、お姉さまにどのような影響があられたとお感じになりますか？",
      "content": "您觉得您的婚姻，对姐姐产生了什么样的影响呢？"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:28:58",
      "origin": "そうですね、、",
      "content": "这个嘛……"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:29:06",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:29:27",
      "origin": "わたしと姉は真逆の人生を歩んでいるように感じています、",
      "content": "我感觉我和姐姐走在截然相反的人生道路上。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:29:46",
      "origin": "そう思われていらっしゃるのですね。",
      "content": "您是这么想的呀。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:29:56",
      "origin": "彼女は20才でできちゃった結婚",
      "content": "她20岁奉子成婚，"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:30:14",
      "origin": "そうなんですね。",
      "content": "这样啊。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:30:35",
      "origin": "わたしは31才で式を挙げて結婚",
      "content": "而我，是31岁才举办婚礼结婚的。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:30:55",
      "origin": "そうだったんですね。",
      "content": "原来是这样啊。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:31:19",
      "origin": "はい、",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:32:24",
      "origin": "その事が、お姉さまにどのような考えを持たれるようになられたとお考えですか？",
      "content": "您认为这件事，让姐姐对您产生了什么样的想法呢？"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:33:03",
      "origin": "お互い違い過ぎて、同じ経験をしているようで違うのだと思います、",
      "content": "我们彼此差异太大了，虽然看似有着相似的经历，但其实根本不同。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:33:27",
      "origin": "子育てしている時代も環境も違うので、、",
      "content": "养育孩子的时代和环境也都不一样……"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:33:39",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:34:11",
      "origin": "彼女の態度から察すると、",
      "content": "从她的态度来看，"
    },
    {
      "role": "counselor",
      "time": "2022-09-22T10:34:19",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2022-09-22T10:34:24",
      "origin": "気に入らないのでしょう、、",
