{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 19:50:38",
            "content": "（こんばんは。よろしくお願いいたします）",
            "Chinese": "（晚上好。请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 19:54:25",
            "content": "よろしくお願いいたします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:00:06",
            "content": "こんばんは。相談員です。はじめに年齢と性別、今日ご相談になりたいことを教えていただけますか？",
            "Chinese": "晚上好。我是咨询员。首先，能告诉我您的年龄、性别以及今天想咨询的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:00:31",
            "content": "30才女です",
            "Chinese": "30岁，女性。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:02:25",
            "content": "母が亡くなり",
            "Chinese": "母亲去世了，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:02:41",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:02:41",
            "content": "立ち直れません",
            "Chinese": "我一直走不出来。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:03:31",
            "content": "そうなのですね。それはとても悲しくお寂しく、お辛いですね。。",
            "Chinese": "这样啊。那一定非常悲伤、孤独和痛苦吧……"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:03:54",
            "content": "どうしたらいいでしょうか",
            "Chinese": "我该怎么办才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:05:08",
            "content": "深い悲しみの中にいらっしゃるのですね。。",
            "Chinese": "您正深陷于悲痛之中呢……"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:05:45",
            "content": "もう一年が経ちますが",
            "Chinese": "已经过去一年了，"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:06:04",
            "content": "気持ちがついていかなくて",
            "Chinese": "可心情还是跟不上，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:06:54",
            "content": "そうなのですね、、",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:07:18",
            "content": "何もする気になれないんです",
            "Chinese": "什么都提不起劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:07:48",
            "content": "大切なご家族を失われたのですから、そのような気持ちになるのも無理はないと思います。",
            "Chinese": "失去了至亲，会有这样的心情也是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:08:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:08:43",
            "content": "いつになったら楽になるのか",
            "Chinese": "不知道什么时候才能好受一点，"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:08:53",
            "content": "ならないのか",
            "Chinese": "还是永远都不会好起来，"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:09:00",
            "content": "わからなくて",
            "Chinese": "我不知道，"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:09:05",
            "content": "つらいです",
            "Chinese": "很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:09:35",
            "content": "先の見えないほどの深い悲みの中にいらっしゃるのですね。。",
            "Chinese": "您仿佛置身于看不到尽头的深切悲伤之中……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:10:13",
            "content": "深くお悲しみのことと思いますが、相談者さんは、食事は睡眠は、いかがですか？",
            "Chinese": "我想您一定非常悲痛，但请问您的饮食和睡眠情况怎么样？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:10:44",
            "content": "失礼しました、食事と睡眠は、です。",
            "Chinese": "不好意思，是问饮食和睡眠。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:10:45",
            "content": "それは大丈夫です",
            "Chinese": "那方面还好。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:11:00",
            "content": "いえ",
            "Chinese": "不。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:11:22",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:11:48",
            "content": "相談者様には、お母様の他にご家族はいらっしゃいますか？",
            "Chinese": "请问您除了母亲之外还有其他家人吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:12:36",
            "content": "夫と子どもがいます",
            "Chinese": "我有丈夫和孩子。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:13:16",
            "content": "教えてくださってありがとうございます。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:14:09",
            "content": "お話できる範囲で構いませんので・・・お母様がお亡くなりになったいきさつについて、教えていただくことはできますか？",
            "Chinese": "在您愿意的范围内就好……能跟我说说您母亲去世的经过吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:15:15",
            "content": "肺炎でした。もともと心臓が悪くて",
            "Chinese": "是肺炎。她本来心脏就不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:15:56",
            "content": "そうなのですね。お母様は、ご入院されていたのでしょうか。",
            "Chinese": "这样啊。那您母亲当时是住院了吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:16:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:17:06",
            "content": "相談者様は、お母様の付き添いなどをされていたのでしょうか。",
            "Chinese": "您当时有在旁陪护吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:17:39",
            "content": "コロナ禍で付き添えませんでした",
            "Chinese": "由于疫情，没能陪在身边。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:18:24",
            "content": "そうなのですね、、それはとても、、お辛いし、悔しかったすね、、",
            "Chinese": "是这样啊……那一定非常……痛苦，也很令人懊悔……"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:19:04",
            "content": "申し訳なく思います",
            "Chinese": "我觉得很愧疚。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:19:20",
            "content": "一人で旅立たせてしまいました",
            "Chinese": "让她一个人离开了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:19:41",
            "content": "お母様も、相談者様も、お寂しかったですね。。",
            "Chinese": "您的母亲和您，一定都很孤独吧……"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:20:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:20:40",
            "content": "最期まで帰りたいと言っていたようで",
            "Chinese": "她好像直到最后都说想回家，"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:20:58",
            "content": "何も話せず",
            "Chinese": "却什么都没能说上，"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:21:10",
            "content": "お別れも言えませんでした",
            "Chinese": "连道别都没能说出口。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:22:03",
            "content": "相談者様の悲しみが伝わってきます",
            "Chinese": "我能感受到您的悲伤。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:22:26",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:23:14",
            "content": "何もする気がしなくて",
            "Chinese": "什么都提不起劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:24:14",
            "content": "そのような形で大切なお母様と別れなければならなかったのですから、相談者様の今のご様子は、本当に、無理もないことと思います。",
            "Chinese": "必须以那样的方式与至亲告别，您如今的状态真的完全可以理解。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:24:39",
            "content": "はい、でも",
            "Chinese": "是的，可是……"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:24:48",
            "content": "生活があります",
            "Chinese": "还有生活要过，"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:24:54",
            "content": "家事も仕事も",
            "Chinese": "家务和工作，"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:25:00",
            "content": "上の空で",
            "Chinese": "都心不在焉。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:25:33",
            "content": "そうなのですね。お仕事は、どんなことをなさっていますか？",
            "Chinese": "是这样啊。您的工作是做什么的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:26:10",
            "content": "看護師です",
            "Chinese": "我是护士。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:27:28",
            "content": "そうなのですね。。お仕事しながら、お母様のことを考えてしまうのも、無理はないと思いますが、",
            "Chinese": "是这样啊……一边工作一边不由得想起母亲，这也很正常，不过，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:27:42",
            "content": "周囲の方に何か言われたりしますか？",
            "Chinese": "周围的人有对您说什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:28:33",
            "content": "職場ではいつも通りやれていると思いますが",
            "Chinese": "我觉得在职场上我表现得和平时一样，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:28:42",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:28:55",
            "content": "正直無理矢理なので",
            "Chinese": "但说实话都是硬撑的，"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:29:25",
            "content": "帰宅すると動けなくなります",
            "Chinese": "一回到家就动不了了。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:29:34",
            "content": "それから",
            "Chinese": "而且，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:30:11",
            "content": "はい（お聞きしています）",
            "Chinese": "嗯（我在听）。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:30:37",
            "content": "正直患者さんのこともどうでもいいと感じたりします",
            "Chinese": "老实说，我有时甚至会觉得患者的事也无所谓了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:31:15",
            "content": "きっと、頑張り続けている分、とても心がお疲れになっているのですね。",
            "Chinese": "想必是因为您一直在努力坚持，所以内心才非常疲惫了吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:32:16",
            "content": "こんな状態で仕事をしていいのか",
            "Chinese": "在这种状态下继续工作到底好不好，"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:32:23",
            "content": "分かりません",
            "Chinese": "我也不知道。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:33:00",
            "content": "辞めた方がいいのでしょうか",
            "Chinese": "我是不是应该辞职呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:33:04",
            "content": "責任感が強いからこそ、悩まれるのですね。",
            "Chinese": "正因为您责任感强，才会如此烦恼吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:33:37",
            "content": "分かりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:34:24",
            "content": "帰宅してから動けなくなるとおっしゃっていたので、相談者様は、本当に毎日気持ちを奮い立たせて頑張っておられるのだと思いました。",
            "Chinese": "您说您回到家就动不了了，我想您真的是每天都在强打精神努力着。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:35:07",
            "content": "少しお仕事を休んでみるのも一つかと思いますが、いかがでしょうか？",
            "Chinese": "我觉得可以先休息一下工作，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:38:23",
            "content": "気持ちを奮い立たせて仕事をしているのはそうなのですがそれは生活のためです。責任感ではないかもしれません。夫が鬱で休職しています。辞められないだけ、という方が正解かもしれません",
            "Chinese": "我确实在努力工作，但这是为了生活，可能并非出于责任感。我丈夫因抑郁症休职了，或许更准确的说法是，我只是不能辞职而已。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:39:39",
            "content": "大切なことをお話くださり、ありがとうございます。そうなのですね、働かなければならない状況なのですね。",
            "Chinese": "谢谢您告诉我这么重要的事情。这样啊，您是处于必须工作的状况中呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:40:06",
            "content": "お子さんは、まだお小さいですか？",
            "Chinese": "您的孩子还小吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:41:11",
            "content": "3歳です",
            "Chinese": "3岁。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:42:32",
            "content": "そうなのですね、育児もきっとお忙しいですね。",
            "Chinese": "这样啊，育儿也一定很忙吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:43:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:43:26",
            "content": "家事も育児も相談者様が中心になってなさっているのですね。",
            "Chinese": "家务和育儿也都是以您为中心在做的吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:43:55",
            "content": "そうですね。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:44:12",
            "content": "お子さんは、保育園かどこかに通われていますか？",
            "Chinese": "您的孩子有去托儿所之类的地方吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:44:38",
            "content": "はい",
            "Chinese": "有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:46:41",
            "content": "今、相談者様はとてもお疲れだと思うので、お子さんが保育園などに行かれている間に、少しでも一人の時間を作って、お体やお気持ちを休めてみてはどうかと思いました。いかがでしょうか？",
            "Chinese": "我想您现在非常疲惫，也许可以在孩子去托儿所的时候，尽量给自己留一点独处的时间，让身心都休息一下，您觉得如何？"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:47:56",
            "content": "そうですね.....",
            "Chinese": "说得也是……"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:48:19",
            "content": "なかなか時間がないのですが",
            "Chinese": "虽然很难挤出时间，"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:48:31",
            "content": "それしかないですものね",
            "Chinese": "但也只能这样了呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:49:22",
            "content": "少しであったとしても、ご自分のことを大切にする時間を持ってみてほしいと、相談員は思います。",
            "Chinese": "我希望您能为自己留出一些时间，哪怕只是一小会儿，来好好爱护自己。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/10/24(火) 20:49:49",
            "content": "お母様が亡くなられてから、存分に泣くことはできていますか？",
            "Chinese": "自从母亲去世后，您能尽情地哭出来吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/10/24(火) 20:50:17",
