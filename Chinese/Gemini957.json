{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 09:59:28",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 09:59:46",
            "content": "よろしくお願い致します",
            "Chinese": "请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:01:12",
            "content": "よろしくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:01:56",
            "content": "では初めさせて頂きますね",
            "Chinese": "那么，我们开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:02:05",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:02:19",
            "content": "こんにちは相談員です",
            "Chinese": "您好，我是咨询员。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:02:28",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:03:06",
            "content": "今日はどのようなご相談でしょうか",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:03:21",
            "content": "もう疲れてしまいました",
            "Chinese": "我已经筋疲力尽了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:03:43",
            "content": "それはしんどいですね",
            "Chinese": "那一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:03:52",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:04:09",
            "content": "学校から帰ると毎日家事をやらされて",
            "Chinese": "每天从学校一回来就要做家务，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:04:20",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:05:22",
            "content": "二学期中におわらせなければならかい課題も終わりそうにない",
            "Chinese": "第二学期必须完成的作业也似乎做不完了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:05:32",
            "content": "（お聞きしていますね）",
            "Chinese": "（我正在认真倾听。）"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:05:55",
            "content": "どうしたらいいのかわからない",
            "Chinese": "我不知道该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:06:03",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:06:20",
            "content": "とてもお辛い状況なんですね",
            "Chinese": "您现在的情况一定非常艰难吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:06:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:08:09",
            "content": "ちなみにあなたの年齢と性別を教えてもらえますか",
            "Chinese": "顺便问一下，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:08:39",
            "content": "17歳女子です",
            "Chinese": "我17岁，女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:09:02",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:09:35",
            "content": "高校生でしょうか？",
            "Chinese": "您是高中生吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:10:13",
            "content": "はい高校2年生です",
            "Chinese": "是的，我高二。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:10:25",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:10:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:11:05",
            "content": "学校の宿題もたくさんあって時間がいくらあっても足りない感じですよね",
            "Chinese": "学校的作业也很多，感觉时间怎么都不够用，对吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:11:58",
            "content": "あなたが困ってしまっているのが目に浮かんできます",
            "Chinese": "我几乎能想象到您现在有多困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:12:31",
            "content": "ご家族はあなたのほかにどなたがいるのでしょうか？",
            "Chinese": "除了您之外，家里还有其他家人吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:12:39",
            "content": "買物したり、食事を作ったり、洗濯したりで疲れてしまって",
            "Chinese": "买东西、做饭、洗衣服，累得不行。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:12:47",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:13:07",
            "content": "勉強が進みません",
            "Chinese": "学习一点也进行不下去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:13:30",
            "content": "そんなにもたくさんの家事を・・",
            "Chinese": "竟然要做那么多的家务……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:14:00",
            "content": "頭も悪いし",
            "Chinese": "我脑子也不好使。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:15:22",
            "content": "そんなふうに感じてしまうのですね",
            "Chinese": "您会有这样的感觉啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:16:06",
            "content": "だって成績1ばかりだもん",
            "Chinese": "因为成绩总是1分啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:16:24",
            "content": "そっか・・",
            "Chinese": "这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:16:50",
            "content": "物理の試験でこんど赤点とったら単位落としちゃう",
            "Chinese": "这次物理考试如果再不及格，就要丢学分了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:17:30",
            "content": "勉強する時間が全く取れないから・・心配ですね",
            "Chinese": "因为完全腾不出学习时间……确实让人担心呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:17:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:17:52",
            "content": "どうすればいいんだろう",
            "Chinese": "我该怎么办才好呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:18:05",
            "content": "学校は毎日行けてますか？",
            "Chinese": "您每天都能去上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:18:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:18:37",
            "content": "嫌だけど行ってます",
            "Chinese": "虽然很讨厌，但还是坚持去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:18:48",
            "content": "そうなんですね・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:18:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:19:25",
            "content": "ちなみにあなたがどうしてそんなにひとりで家事をしないといけないのか教えてもらえますか？",
            "Chinese": "顺便问一下，能告诉我为什么您要独自承担这么多家务吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:20:27",
            "content": "中1のとき両親が離婚して、父と二人暮らしなんです",
            "Chinese": "我上初一的时候父母离婚了，现在和爸爸两个人生活。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:20:39",
            "content": "そうだったんですね",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:21:28",
            "content": "父は仕事で忙しいからって、私に全部家事を押しつけてくる",
            "Chinese": "爸爸总以工作忙为借口，把所有家务都推给我。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:21:41",
            "content": "うん、うん",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:22:19",
            "content": "ちょんとやってないと怒鳴られるんです何やってるんだって",
            "Chinese": "要是没做好就会被他大吼：“你在干什么！”"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:22:35",
            "content": "そっか・・",
            "Chinese": "这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:23:03",
            "content": "それではますます辛くなってしまいよね・・",
            "Chinese": "那样的话会越来越痛苦吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:23:14",
            "content": "しまうよね・・",
            "Chinese": "确实会这样……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:23:15",
            "content": "誰のお陰で飯食えると思ってんだとか",
            "Chinese": "还会说“你以为你是靠谁才有饭吃的”之类的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:23:30",
            "content": "うん、うん",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:24:04",
            "content": "そんなひどいことも言われて・・",
            "Chinese": "竟然还对您说这么过分的话……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:24:19",
            "content": "悲しくなりますね",
            "Chinese": "的确会让人很难过呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:24:24",
            "content": "それに成績が悪いと、何でお前はそんなに馬鹿なんだって言われる",
            "Chinese": "而且成绩不好时，他还会骂：“你怎么这么笨！”"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:24:36",
            "content": "そうなんですね・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:24:52",
            "content": "それはあんまりですね",
            "Chinese": "那实在太过分了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:25:15",
            "content": "だから頑張って勉強しようと思うけど上手くいかないし",
            "Chinese": "所以我想努力学习，但总是不顺利。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:25:25",
            "content": "勉強する時間が全くないのに・・",
            "Chinese": "明明完全没有时间学习……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:25:32",
            "content": "悲しくなってしまう",
            "Chinese": "我就会感到很难过。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:25:54",
            "content": "うん、うん泣きたい気持ちになりますね",
            "Chinese": "嗯，嗯，会有想哭的感觉呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:26:33",
            "content": "だからリスかしちゃうんです",
            "Chinese": "所以我就会自残。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:27:07",
            "content": "もう私なんて生きてない方がいいって思うと",
            "Chinese": "一想到“我这样的人还不如死了算了”，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:27:07",
            "content": "そっか・・そんなにも追い詰められてしまってるんですね",
            "Chinese": "是这样啊……您已经被逼到这种地步了啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:27:19",
            "content": "うん、うん",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:29:27",
            "content": "なんとかいい方法かないか一緒に考えてみたいので、いくつか質問してもいいですか？",
            "Chinese": "我想和您一起想想有没有什么好的办法，可以问您几个问题吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:29:38",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:30:56",
            "content": "成績が良くないということなので、あなたの学校の先生にそのことを相談したことはありますか？",
            "Chinese": "既然成绩不太理想，您有没有就此向学校的老师咨询过呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:32:12",
            "content": "面談のときに成績のことを話したくらいです",
            "Chinese": "也就是在面谈时提过成绩的事而已。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:32:28",
            "content": "そうだったんですね",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:32:54",
            "content": "しっかりやれって言われてしまいました",
            "Chinese": "对方就只是说“好好学”。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:33:21",
            "content": "忙しいとか言い訳できなかった",
            "Chinese": "我没能说出因为忙之类的借口。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:33:29",
            "content": "勉強する時間がとれないとか、そういった今の現状は相談できてないのですね",
            "Chinese": "也就是说，像“腾不出学习时间”这样的现实状况，并没有能够向老师说明，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:33:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:35:25",
            "content": "あなたは忙しいお父さんに代わって家事すべてをしながら、学校は休まずに頑張って行っていてとても頑張り屋さんなのだとおまいます",
            "Chinese": "您代替忙碌的父亲承担了所有家务，同时还坚持不缺课去上学，我觉得您真的非常努力。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:35:38",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:35:56",
            "content": "でも、今のあなたには大人の支援がとても必要です",
            "Chinese": "不过，以您目前的状况，非常需要成年人的支持与帮助。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:36:07",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:36:18",
            "content": "あなた一人で頑張っても限界があるかと思います",
            "Chinese": "我想，只靠您一个人努力是有限度的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:36:56",
            "content": "あなたの学校にはスクールカウンセラーの先生とかはいらっしゃいますか？",
            "Chinese": "您的学校有心理咨询老师吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:38:09",
            "content": "います",
            "Chinese": "有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:40:29",
            "content": "できたら今の苦しい状況を相談することはできそうでしょうか",
            "Chinese": "如果可以的话，您觉得能否把现在的困境向他们咨询一下呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:41:46",
            "content": "知らない大人の人に話すのは怖いです",
            "Chinese": "跟不认识的成年人说这些让我感到害怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:42:29",
            "content": "そうですよね・・とまどってしまいますよねでもリスかしてしまうほどとても辛い状況をお話してみたら、力になってくれるかも・・",
            "Chinese": "是啊……会感到不知所措吧。但是，如果您能把现在痛苦到甚至会自残的状况说出来，或许老师能成为您的力量……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:43:17",
            "content": "と思うのですが、勇気をだしてお話できたらいいなと",
            "Chinese": "我是这么想的，如果能鼓起勇气去谈谈就好了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/18(金) 10:44:08",
            "content": "家のこと恥ずかしくて言いづらいです",
            "Chinese": "家里的事情我觉得很丢脸，很难说出口。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/18(金) 10:45:05",
            "content": "そっか・・そう思うのは当然ですよねでも、ほかに学校の先生でお話しやすい先生とかはいますか？",
