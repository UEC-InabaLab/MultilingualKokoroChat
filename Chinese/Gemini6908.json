{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 09:52:17",
            "content": "（こんにちは。今日はよろしくお願いいたします。もし可能であれば希死念慮のある相談者役をしていただけるとありがたいです。）",
            "Chinese": "（您好。今天请多关照。如果可以的话，麻烦您扮演一位有轻生念头的来访者角色。）"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 09:55:10",
            "content": "（こんにちは、わかりました。初めてですが、やってみます。こちらこそ、よろしくお願いいたします。）",
            "Chinese": "（您好，好的。虽然是第一次，但我试试看。也请您多多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 09:56:36",
            "content": "（無理を言って申し訳ありません。ありがとうございます。）",
            "Chinese": "（抱歉强人所难。非常感谢。）"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 09:57:44",
            "content": "はい、お互い頑張りましょう。",
            "Chinese": "好的，我们一起加油吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:00:10",
            "content": "こんにちは、相談員です。年齢、性別、相談内容を教えていただけますか？",
            "Chinese": "您好，我是咨询员。请问可以告知您的年龄、性别以及咨询内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:01:04",
            "content": "30代 男性　どうしたらよいのか分からない",
            "Chinese": "30多岁，男性，不知道该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:02:13",
            "content": "そうなんですね。よかったら、もう少し詳しく教えていただけますか？",
            "Chinese": "原来如此。如果您方便的话，能否再详细说明一下呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:02:44",
            "content": "借金があり、彼女とわかれて、生活が苦しい",
            "Chinese": "我有债务，和女友分手了，生活很艰难。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:03:17",
            "content": "そうなのですね。それはとてもお辛いですね。",
            "Chinese": "是这样啊。那一定非常痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:03:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:05:31",
            "content": "ちなみに借金はいくらくらいあるのでしょうか？",
            "Chinese": "顺便问一下，您的债务大概有多少呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:06:15",
            "content": "分からない、計算できない、毎月くる",
            "Chinese": "不清楚，算不清，每个月都会有账单来。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:07:48",
            "content": "生きてる意味が分からない",
            "Chinese": "我不知道活着的意义是什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:07:48",
            "content": "そうなのですね。毎月請求がくるような感じなんですね。",
            "Chinese": "是这样啊。也就是每个月都会收到账单的感觉，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:07:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:10:10",
            "content": "死にたい",
            "Chinese": "我想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:11:11",
            "content": "そうなんですね。そう思うほどつらい気持ちになっているんですね。",
            "Chinese": "是这样啊。您的心情已经痛苦到会这么想了，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:11:12",
            "content": "どうしたらいい",
            "Chinese": "该怎么办才好？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:11:27",
            "content": "つらい",
            "Chinese": "好痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:12:01",
            "content": "今はお仕事はされているのでしょうか？",
            "Chinese": "您现在有在工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:12:19",
            "content": "しているが、払いきれない",
            "Chinese": "有工作，但还不清。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:13:34",
            "content": "彼女のためにつくしたのに",
            "Chinese": "我明明为她付出了那么多。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:14:56",
            "content": "そうだったんですね。彼女の為に借金ができた感じなのでしょうか？",
            "Chinese": "原来是这样。是因为她才欠下债务的吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:15:28",
            "content": "そう、好きなもの買ってやった",
            "Chinese": "是的，给她买了她喜欢的东西。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:16:42",
            "content": "ええ、そうだったのですね。それで別れてしまったということで、やりきれないお気持ちですね。",
            "Chinese": "嗯，是这样啊。结果却分手了，心里一定很难受、很难以释怀吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:17:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:17:50",
            "content": "死んだほうがまし",
            "Chinese": "还不如死了算了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:19:07",
            "content": "そうなんですね。そのように思っているんですね。",
            "Chinese": "是这样啊。您现在是这么想的，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:19:18",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:19:53",
            "content": "苦しい",
            "Chinese": "好痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:20:57",
            "content": "そうですよね。そういう状況だととても苦しいと思います。",
            "Chinese": "是啊。在那种情况下，我想一定非常痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:21:12",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:22:20",
            "content": "彼女とはどのような事で別れてしまったのでしょうか？",
            "Chinese": "您和女朋友是因为什么事情分手的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:22:23",
            "content": "苦しい",
            "Chinese": "好痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:22:42",
            "content": "借金できたから、ムリ",
            "Chinese": "因为我欠了债，她说不行了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:24:07",
            "content": "そうだったのですね。彼女の為に借金してまで尽くしたのに、それはないですよね。",
            "Chinese": "原来是这样。您为了她甚至不惜借债，她这样对您也太过分了。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:24:15",
            "content": "ない",
            "Chinese": "是啊，太过分了。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:24:39",
            "content": "俺も悪い",
            "Chinese": "我也有错。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:25:24",
            "content": "そうなのですね。それはどういうところからでしょうか？",
            "Chinese": "是这样啊。您是指哪方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:25:41",
            "content": "カッコつけすぎた",
            "Chinese": "太爱面子了。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:26:27",
            "content": "これからどうしたらいい",
            "Chinese": "接下来该怎么办？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:27:27",
            "content": "ええ、でも好きな人の前ではカッコつけたくなるのは普通ですよね。",
            "Chinese": "嗯，但是在喜欢的人面前想要表现得好一点，这也是很正常的吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:27:55",
            "content": "そうか？",
            "Chinese": "是吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:28:38",
            "content": "もう、むり",
            "Chinese": "我已经不行了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:28:52",
            "content": "これから先の事を考えると不安になりますよね。",
            "Chinese": "一想到今后的事情，就会感到不安吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:29:00",
            "content": "なる",
            "Chinese": "会的。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:29:12",
            "content": "どうしたらいい",
            "Chinese": "该怎么办？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:29:32",
            "content": "死んだほうがまし",
            "Chinese": "还不如死了算了。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:29:44",
            "content": "誰も悲しまない",
            "Chinese": "没有人会为我伤心。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:30:05",
            "content": "楽になりたい",
            "Chinese": "我想解脱。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:31:23",
            "content": "そうなのですね。そのように思うほど苦しい思いなんですね。",
            "Chinese": "是这样啊。您已经痛苦到会这么想了，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:31:35",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:32:08",
            "content": "今はお一人暮らしでしょうか？",
            "Chinese": "您现在是一个人住吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:32:48",
            "content": "金がないから、もうすぐ実家に帰る",
            "Chinese": "因为没钱了，马上就要回老家了。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:33:16",
            "content": "生きてる意味が分からない",
            "Chinese": "我不知道活着的意义。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:34:09",
            "content": "そうなんですね。それほどお辛いんですね。",
            "Chinese": "是这样啊。您真的非常痛苦呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:34:20",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:34:34",
            "content": "どうしたらいい",
            "Chinese": "该怎么办？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:35:13",
            "content": "どうしたらいい",
            "Chinese": "该怎么办？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:36:11",
            "content": "そうですね。まずは今借金がどのくらいあって、月にどれくらい返せそうか考えることも一つだと思いますが、どうでしょうか？",
            "Chinese": "是啊。我想，首先可以考虑一下现在大概有多少债务，每个月大概能还多少，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:36:21",
            "content": "分からない",
            "Chinese": "不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:37:31",
            "content": "そうなのですね。わからないくらい多くの借金があるんですね。",
            "Chinese": "这样啊。债务已经多到您都算不清楚了，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:37:37",
            "content": "ある",
            "Chinese": "有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:38:18",
            "content": "それは本当にお辛いと思います。",
            "Chinese": "我想那一定真的非常痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:38:31",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:40:08",
            "content": "実家に帰ってご両親に相談されてみてはと思うのですが、どうでしょうか？",
            "Chinese": "我在想，回到老家后，您是否可以尝试和父母商量一下，觉得如何？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:40:31",
            "content": "言えない",
            "Chinese": "说不出口。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:41:23",
            "content": "そうですよね。なかなか言いずらいですよね。",
            "Chinese": "是啊。这种事确实很难开口。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:41:46",
            "content": "だからきいてる",
            "Chinese": "所以我才来问您。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:43:50",
            "content": "あなたの中では少しづつでも借金が返せそうと思われますでしょうか？",
            "Chinese": "在您看来，哪怕一点点，觉得有可能逐步还上吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:44:30",
            "content": "全部むり",
            "Chinese": "完全不可能。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:45:59",
            "content": "そうなのですね。返せないと、そのうち取り立てに来たりされるのでしょうか？",
            "Chinese": "是这样啊。如果还不了，之后会有人上门催债吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:46:15",
            "content": "分からない",
            "Chinese": "不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:49:19",
            "content": "そうなんですね。お住いの市区町村の無料法律相談などには連絡できそうですか？",
            "Chinese": "是这样啊。您是否可以联系一下您所在地区的市区町村提供的免费法律咨询之类的服务呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:49:32",
            "content": "知らなかった",
            "Chinese": "不知道有这个。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:51:30",
            "content": "借金があって払えるかわからないとの事なので一度連絡されてはと思うのですが、いかがでしょうか？",
            "Chinese": "既然您有债务，而且不知道能不能还清，我想您可以联系他们一次试试看，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:52:00",
            "content": "きいてみる",
            "Chinese": "我去问问看。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:52:21",
            "content": "助かったかも",
            "Chinese": "也许有救了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:54:24",
            "content": "そうですね。そこでお話をされてみて解決策が見つかるといいですね。また今後も連絡してどうだったかとか、こちらの窓口にも教えに来てもらえたらと思いますが、どうでしょうか？",
            "Chinese": "是的。希望您和他们谈过之后能找到解决方案。另外，今后您也可以再联系我们，告诉我们进展如何，您觉得可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:55:18",
            "content": "わかった、行ってみる。また、連絡する。",
            "Chinese": "好的，我去试试看。之后我会再联系您的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:56:42",
            "content": "わかりました。大切なお話を聞かせていただきありがとうございました。",
            "Chinese": "明白了。感谢您愿意和我分享这些重要的事情。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:57:09",
            "content": "助かった。ありがとう。",
            "Chinese": "帮大忙了。谢谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:57:28",
            "content": "それでは今日は終わりにさせていただいてよろしいでしょうか？",
            "Chinese": "那么，我们今天就到这里可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 10:57:52",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 10:58:20",
            "content": "それでは今日は終わりにさせていただきますね。",
            "Chinese": "好的，那我们今天就到此结束了。"
        }
    ],
