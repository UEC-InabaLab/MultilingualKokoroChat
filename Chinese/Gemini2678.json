{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 20:55:39",
            "content": "こんばんは、21時からよろしくお願いいたします。",
            "Chinese": "晚上好，从21点开始，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 20:55:46",
            "content": "よろしくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:00:14",
            "content": "それでは始めます。",
            "Chinese": "那么我们开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:00:23",
            "content": "お願いします",
            "Chinese": "好的，拜托了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:00:30",
            "content": "こんばんは、相談員です",
            "Chinese": "晚上好，我是咨询员。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:00:36",
            "content": "こんばんは",
            "Chinese": "晚上好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:00:59",
            "content": "初めにあなたの年齢と性別を教えていただけますか？",
            "Chinese": "首先，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:01:22",
            "content": "16歳の女です",
            "Chinese": "我是16岁的女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:01:44",
            "content": "教えてくださりありがとうございます",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:02:39",
            "content": "学年は高校1年生でしょうか？",
            "Chinese": "您是高一学生吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:03:01",
            "content": "そうですよろしくお願いします(´･･`)",
            "Chinese": "是的，请多关照。(´･･`)"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:03:28",
            "content": "そうなんですねこちらこそよろしくお願いします",
            "Chinese": "原来如此，也请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:03:47",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:05:13",
            "content": "彼氏と別れて、つらくて仕方ないです(ToT)",
            "Chinese": "和男朋友分手了，难过得受不了(ToT)。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:05:29",
            "content": "そうだったんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:05:36",
            "content": "はい......",
            "Chinese": "是的......"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:06:10",
            "content": "悲しい思いをされましたね",
            "Chinese": "您一定很难过吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:06:26",
            "content": "はい(｡>ㅿ<｡)",
            "Chinese": "是的(｡>ㅿ<｡)"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:07:52",
            "content": "別れたのはいつ頃のことでしょうか？",
            "Chinese": "大概是什么时候分手的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:08:05",
            "content": "昨日です…",
            "Chinese": "昨天……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:09:02",
            "content": "そうなんだ",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:10:15",
            "content": "もうまじ死にたいです.....",
            "Chinese": "我真的已经想死了……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:10:38",
            "content": "それほどショックだったのですね",
            "Chinese": "看来这件事对您的打击很大。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:11:00",
            "content": "はい(｡>ㅿ<｡)",
            "Chinese": "是的(｡>ㅿ<｡)"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:12:05",
            "content": "もの凄く好きだったんですね",
            "Chinese": "您一定非常非常喜欢他吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:12:24",
            "content": "はい....",
            "Chinese": "是的...."
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:12:41",
            "content": "結婚しようって言ってたのに",
            "Chinese": "明明他还说过要和我结婚的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:13:08",
            "content": "そこまでお付き合いが進んでいたんですね",
            "Chinese": "你们的关系已经发展到那一步了啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:13:38",
            "content": "はい....",
            "Chinese": "是的...."
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:13:46",
            "content": "それなのに別れてしまったなんて・・・辛すぎますよね",
            "Chinese": "即便如此还是分开了……实在太让人难受了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:14:12",
            "content": "もうずっと泣いてます…",
            "Chinese": "我一直在哭……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:14:48",
            "content": "泣いてしまうのも自然なことだと思います",
            "Chinese": "我觉得想哭也是很自然的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:15:14",
            "content": "どんなことで別れてしまったのでしょうか？",
            "Chinese": "是因为什么原因分手的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:15:46",
            "content": "浮気されました …",
            "Chinese": "他出轨了……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:16:26",
            "content": "えっ結婚の話まで出ていたのに・・・",
            "Chinese": "咦？都已经谈到结婚了……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:16:55",
            "content": "そうなんです.....最低ですよね😭",
            "Chinese": "是啊……太渣了，对吧😭"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:18:21",
            "content": "それを知ったときどんな気持ちになりましたか？",
            "Chinese": "知道这件事的时候，您是什么心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:18:34",
            "content": "裏切られたって思いました",
            "Chinese": "我感觉被背叛了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:19:15",
            "content": "そうですよね",
            "Chinese": "是啊，没错。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:20:17",
            "content": "私の何が悪かったんでしょうか …",
            "Chinese": "到底是我哪儿不好呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:20:30",
            "content": "ゆくゆくは結婚しようと話していたのに、浮気するなんて",
            "Chinese": "明明还谈到将来要结婚，竟然还会出轨……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:20:41",
            "content": "まじ最低ですよね！",
            "Chinese": "真是太渣了吧！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:21:08",
            "content": "そう思うのは当然のことですよ",
            "Chinese": "您会这么想是理所णाम当然的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:21:43",
            "content": "でもめっちゃ好きだったんで、信じられないです....",
            "Chinese": "可我真的超喜欢他的，实在无法相信……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:21:57",
            "content": "あなたは悪くなんかないです裏切る方が悪いにきまっていますよ",
            "Chinese": "您没有任何错，肯定是背叛的那一方不对。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:23:04",
            "content": "めっちゃ好きだった人が浮気してるなんて信じたくないですよね",
            "Chinese": "自己那么喜欢的人竟然出轨了，真的很难让人相信吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:23:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:23:43",
            "content": "どんなことから、浮気に気付いたんですか？",
            "Chinese": "您是怎么发现他出轨的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:25:22",
            "content": "彼氏の車に女のピアス落ちてて",
            "Chinese": "男朋友的车里掉着一只女人的耳环……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:25:35",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:26:42",
            "content": "その後、携帯覗いたら、ばっちり浮気してました",
            "Chinese": "之后偷看了他的手机，出轨的证据一清二楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:26:59",
            "content": "そうだったんだ",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:27:06",
            "content": "最悪です",
            "Chinese": "真是糟透了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:28:36",
            "content": "携帯のやり取りをみてしまったんですね",
            "Chinese": "您看到了手机里的聊天记录啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:28:44",
            "content": "はい....",
            "Chinese": "是的...."
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:29:02",
            "content": "辛かったですよね",
            "Chinese": "一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:29:28",
            "content": "はい.....もう誰も信じられないです......",
            "Chinese": "是的.....我已经无法再相信任何人了......"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:30:51",
            "content": "信頼している人に裏切られたら、誰も信じられないって思うのも無理ないです",
            "Chinese": "被自己信赖的人背叛，会觉得无法再相信任何人也是人之常情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:35:07",
            "content": "今、彼が目に前にいたらどんなことを言いたいですか？",
            "Chinese": "现在，如果他就站在您面前，您想对他说些什么？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:35:25",
            "content": "私の何がいけなかったの？って",
            "Chinese": "“到底是我哪里做得不对？”"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:36:06",
            "content": "実際、聞きましたけどごめんってしか言ってくれませんでした....",
            "Chinese": "实际上我也问过了，但他只说“对不起”，什么都不肯多说……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:36:36",
            "content": "そっかー",
            "Chinese": "是吗—"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:36:55",
            "content": "ごめんって言われてどう思いましたか？",
            "Chinese": "听到他说“对不起”，您是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:37:14",
            "content": "私と話す気ないんだって思いました",
            "Chinese": "我觉得他根本不想和我好好谈。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:38:48",
            "content": "そうなんだちゃんと話をして欲しかったですね",
            "Chinese": "是这样啊，您是希望他能好好和您谈谈吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:39:39",
            "content": "もうしばらく学校とかも行きたくないです....立ち直れないですよ",
            "Chinese": "我暂时不想去学校了....根本振作不起来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:41:58",
            "content": "あなたのお話を伺って、そう感じられるのももっともなことだと思いました",
            "Chinese": "听了您的话，我觉得您有这种感觉是非常正常的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:42:09",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:43:15",
            "content": "ちなみに、その彼はどういう人なんですか？同じ学校の人とか、社会人とか",
            "Chinese": "顺便问一下，他是怎样的人呢？是同校的人，还是社会人士？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:43:46",
            "content": "バイトで一緒だった大学生です",
            "Chinese": "是一起打工的大学生。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:44:03",
            "content": "そうなんですね",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:44:28",
            "content": "はい....",
            "Chinese": "是的...."
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:44:32",
            "content": "バイトの方は今はどうされていますか？",
            "Chinese": "那打工那边现在怎么样了？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:46:02",
            "content": "私はまだやってますけど、彼は先月辞めました…家庭教師のバイトをはじめるとかで",
            "Chinese": "我还在做，但他上个月辞了……好像要去做家教的兼职。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:47:12",
            "content": "会わずに済むのですね",
            "Chinese": "这样就不用见到他了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:48:04",
            "content": "はい、会いたくても会えないですね....",
            "Chinese": "是的，想见也见不到了...."
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:50:07",
            "content": "そっかーそんなに辛い思いをされても、まだ好きなんですね",
            "Chinese": "是吗—即使经历了这么痛苦的事，您还是喜欢他啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:50:22",
            "content": "はい😭",
            "Chinese": "是的😭"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:51:23",
            "content": "気持ちってそんなに簡単に切り替えられないですものね",
            "Chinese": "感情这种事，不是那么容易就能改变的呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:52:24",
            "content": "そっかーしばらく辛い思いが続くかもしれませんね",
            "Chinese": "是吗—看来痛苦的心情可能还会持续一段时间。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:53:02",
            "content": "そういう気持ちを聴いてもらえるお友達とかはいそうでしょうか？",
            "Chinese": "有可以倾诉这种心情的朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:53:50",
            "content": "はいもうLINEしてて、みんな、そんな男忘れろって言ってくれますけど...",
            "Chinese": "有，我已经在LINE上和他们聊了，大家都说“那种男人就忘了吧”，不过……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:54:04",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:54:19",
            "content": "すごい好きだし、どうしたらいいかわからないです....",
            "Chinese": "我真的很喜欢他，也不知道该怎么办……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:55:30",
            "content": "忘れろと言われてもすぐには忘れられませんよね",
            "Chinese": "即便别人让您忘掉，也不可能马上就忘记，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:55:51",
            "content": "はい😢",
            "Chinese": "是的😢"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:56:16",
            "content": "そういうところも解ってくれる人がいるといいんですけどね",
            "Chinese": "要是有人能理解您这方面的心情就好了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/07(日) 21:57:57",
            "content": "みんな、いい子だけど、全員彼氏とラブラブだから、なんか逆に悲しくなりそう😭",
            "Chinese": "她们都是好人，但她们都有男朋友而且很恩爱，反而让我觉得更难过了😭"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 21:58:24",
            "content": "そうなんだ",
            "Chinese": "这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 22:00:46",
            "content": "みんながラブラブ・・・ですか",
            "Chinese": "大家都很恩爱……是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/07(日) 22:01:26",
            "content": "今のあなたにはしんどいですね",
            "Chinese": "对现在的您来说确实挺难熬的。"
        },
        {
