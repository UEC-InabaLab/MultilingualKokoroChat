      "time": "2021-11-25T10:30:42",
      "origin": "18 男",
      "content": "18岁，男。"
    },
    {
      "role": "client",
      "time": "2021-11-25T10:30:52",
      "origin": "進路に悩んでる",
      "content": "我在为前途烦恼。"
    },
    {
      "role": "client",
      "time": "2021-11-25T10:31:06",
      "origin": "宜しくお願いします。",
      "content": "拜托您了。"
