{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 14:53:40",
            "content": "本日はよろしくお願いいたします。",
            "Chinese": "今天请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 14:53:46",
            "content": "こんにちは。本日よろしくおねがいします🙂",
            "Chinese": "您好。今天请多多关照🙂"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 14:56:28",
            "content": "カウンセラー役初心者極まりない為、つたない内容になるかもしれないです…すみません…お時間になりましたら、始めさせて頂きます。",
            "Chinese": "因为我扮演咨询师还是个新手，内容可能会有些不成熟……非常抱歉……时间一到，我这边就开始。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 14:56:41",
            "content": "了解しました",
            "Chinese": "明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:00:20",
            "content": "こんにちは相談員です。本日はお越し頂きありがとうございます。",
            "Chinese": "您好，我是咨询师。感谢您今天前来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:00:42",
            "content": "はじめにあなたの年齢と性別をお聞かせいただけますか？",
            "Chinese": "首先，能否请您告知您的年龄和性别？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:01:09",
            "content": "ダンス発表会が明日なんですけど、全然出来ないんです。",
            "Chinese": "明天就是舞蹈发表会了，但我完全跳不好。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:01:31",
            "content": "高2　女子です",
            "Chinese": "高二，女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:02:02",
            "content": "発表会についてお話にきてくださったんですね。ありがとうございます",
            "Chinese": "原来您是为发表会的事情来咨询的啊。谢谢您告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:02:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:03:05",
            "content": "発表会の練習は、毎日しているのかな？",
            "Chinese": "您每天都进行发表会的练习吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:03:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:04:07",
            "content": "失敗するのが、ビデオや写真に残ると思うと、嫌で。",
            "Chinese": "一想到失败的样子会被录像和照片记录下来，我就很难受。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:04:22",
            "content": "終わった…",
            "Chinese": "完蛋了…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:04:39",
            "content": "失敗すると思うのは、何か理由があるのかな？",
            "Chinese": "您觉得自己会失败，是有什么原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:04:48",
            "content": "理由?",
            "Chinese": "原因？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:05:29",
            "content": "だって全然練習出来ていないのに、本番出来る訳ないじゃないですか。",
            "Chinese": "因为我根本就没练习好，正式表演不可能跳好的吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:06:22",
            "content": "リーダーに名前呼ばれるし、出来ない所指摘されるし、",
            "Chinese": "组长会点我的名，还会指出我跳得不好的地方，"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:07:00",
            "content": "やってもわからない",
            "Chinese": "即使练了也还是不会。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:07:11",
            "content": "そうなんですね。色々不安な感情があって、そういう気持ちになるんだね。",
            "Chinese": "是这样啊。因为有各种不安的情绪，所以才会有这样的心情呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:07:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:08:03",
            "content": "もともと運動苦手だし。",
            "Chinese": "我本来就不擅长运动。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:08:13",
            "content": "相談者さんは、今回発表会の参加は初めてですか？",
            "Chinese": "您是第一次参加这次的发表会吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:08:34",
            "content": "去年あったけど、またクラス違うし。",
            "Chinese": "去年也有，但是班级不一样了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:08:57",
            "content": "クラスで聞いてくれる人いないし。",
            "Chinese": "在班里也没有人可以倾诉。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:09:07",
            "content": "終わった‥",
            "Chinese": "完蛋了…"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:09:44",
            "content": "明日学校行きたくない。",
            "Chinese": "我明天不想去学校了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:09:54",
            "content": "そうなんだね。一緒にダンスをする友達と、明日の事で何か相談したのかな？",
            "Chinese": "是这样啊。您有没有和一起跳舞的朋友商量过明天的事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:10:34",
            "content": "してないです",
            "Chinese": "没有。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:10:48",
            "content": "っていうか、言えない",
            "Chinese": "不如说，我也说不出口。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:10:56",
            "content": "皆うまいし。",
            "Chinese": "因为大家都跳得很好。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:11:08",
            "content": "私だけ注意されるし。",
            "Chinese": "只有我被指出问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:11:51",
            "content": "そうなんだね。注意された時、どう思ったのかな？",
            "Chinese": "是这样啊。被指出问题时，您是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:12:08",
            "content": "恥ずかしいし、悔しかった",
            "Chinese": "又丢脸，又不甘心。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:12:33",
            "content": "でも、出来ない物は出来ないし。",
            "Chinese": "但不会的就是不会。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:12:33",
            "content": "注意されると、そういう気持ちになるよね。",
            "Chinese": "被指出问题时，确实会有这样的感受呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:12:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:13:21",
            "content": "明日、自分だけ失敗するかと思うと、憂鬱で。",
            "Chinese": "一想到明天可能只有我会失败，就很郁闷。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:14:04",
            "content": "失敗すると考えてしまうと、確かに憂鬱になってしまうよね。",
            "Chinese": "如果总想着会失败，确实会变得忧郁呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:14:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:16:03",
            "content": "緊張は友達みんなしていると思うんだけど、どうかな？失敗したら、みんなに責められそうと思ってしまうかな？",
            "Chinese": "我觉得朋友们应该也都很紧张，您觉得呢？您是不是担心如果失败了，就会被大家责备？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:16:44",
            "content": "はい",
            "Chinese": "会的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:16:54",
            "content": "立ち直れません",
            "Chinese": "我会一蹶不振的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:17:50",
            "content": "もう明日なのに。",
            "Chinese": "明明明天就要表演了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:18:03",
            "content": "全然できない",
            "Chinese": "我完全跳不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:19:07",
            "content": "世の中には完璧な人間なんていなくて、誰もが緊張もするし失敗もすると考え方を変えると、",
            "Chinese": "如果换个想法，觉得这个世界上没有完美的人，谁都会紧张，也都会失败的话，"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:19:23",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:19:37",
            "content": "考え方を変える?",
            "Chinese": "换个想法？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:19:44",
            "content": "少し気持ちが楽になると思うんだけどどうかな？",
            "Chinese": "我觉得这样可能会让心情轻松一些，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:19:47",
            "content": "どうやって?",
            "Chinese": "要怎么做？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:22:09",
            "content": "失敗したらどうしようと考えすぎると、",
            "Chinese": "如果过度担心“失败了怎么办”，"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:22:21",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:23:32",
            "content": "自分自身が緊張するように無意識に仕向けてしまいます。",
            "Chinese": "您就会在无意识中让自己变得更加紧张。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:26:06",
            "content": "無意識ですか",
            "Chinese": "无意识吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:26:07",
            "content": "完璧にこなさなくても良いと意識を変えられればと思うのですが、どうでしょうか？",
            "Chinese": "如果能将心态转变为“不要求自己做到完美也没关系”，我想会更好，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:27:15",
            "content": "それは失敗してもいいって事でですか?",
            "Chinese": "那是说，即使失败也没关系吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:29:44",
            "content": "失敗する事は、不安だよね。",
            "Chinese": "失败确实会让人感到不安呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:31:46",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:33:11",
            "content": "でも一生懸命練習してきたのだと思うし、",
            "Chinese": "但我想你已经很努力地练习了，"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:33:49",
            "content": "練習しても、成功しないと。",
            "Chinese": "就算练习了，不成功的话，"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:34:40",
            "content": "意味ないと思う",
            "Chinese": "我觉得就没有意义了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:34:58",
            "content": "そうだね。成功すると嬉しいと思うよね。",
            "Chinese": "是啊。成功了会很开心的，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:35:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:35:29",
            "content": "でも成功しないと思う。",
            "Chinese": "但我觉得我不会成功。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:35:48",
            "content": "練習でうまくいかないのに。",
            "Chinese": "因为练习的时候都跳不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:36:12",
            "content": "今のクラスのメンバーでは、今回が最後のダンス発表会になるのかな？",
            "Chinese": "和现在的班级成员一起，这次会是最后一次舞蹈发表会吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:36:49",
            "content": "年1回の行事だから、そうです",
            "Chinese": "因为是每年一次的活动，所以是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:37:18",
            "content": "無理無理無理",
            "Chinese": "不行不行不行。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:37:26",
            "content": "終わった…",
            "Chinese": "完蛋了…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:38:19",
            "content": "そうなんだね。無理って思ってしまう気持ちも分かる…",
            "Chinese": "是这样啊。我能理解你觉得“不行了”的心情…"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:38:47",
            "content": "わかるんですね",
            "Chinese": "您能理解啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:38:56",
            "content": "ありがとう",
            "Chinese": "谢谢你。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:41:35",
            "content": "でもクラスのメンバーとの最後の発表会だから、楽しい気持ちで参加できたらと思うんだけどどうですか？",
            "Chinese": "但是，因为这是和班上同学的最后一次发表会，如果能以愉快的心情参加就好了，你觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:42:02",
            "content": "楽しい気持…",
            "Chinese": "愉快的心情…"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:42:35",
            "content": "どうすれば楽しくなれますか?",
            "Chinese": "要怎样才能开心起来呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:45:31",
            "content": "一緒に友達と練習してきた時の、楽しい思い出を思い出す事はあるかな？",
            "Chinese": "您有没有回忆起和朋友一起练习时的愉快经历呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:45:50",
            "content": "ないです。",
            "Chinese": "没有。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:46:16",
            "content": "上手く出来ないし、失敗ばかりで。",
            "Chinese": "我总是做不好，老是在失败。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:46:30",
            "content": "練習は、辛い事ばかりだったかな？",
            "Chinese": "练习一直都是辛苦的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:46:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:46:55",
            "content": "色々言われるし",
            "Chinese": "还会被说三道四。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:47:20",
            "content": "そうなんだね。それでは、楽しく練習できないよね。",
            "Chinese": "是这样啊。那样的话，确实没法愉快地练习呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:48:00",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:50:00",
            "content": "みんな苦手な分野、得意な分野があるんだから、",
            "Chinese": "每个人都有不擅长和擅长的领域，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:51:15",
            "content": "ダンスが上手に出来ないからと、自分をそんなに責めることもないと思うよ。",
            "Chinese": "所以我觉得没必要因为舞跳不好就那么责备自己。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:51:42",
            "content": "そうなんだ",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/14(日) 15:53:40",
            "content": "そうですよ。ダンス以外で、自分が得意な事を探して伸ばしていった方が良いと思います。",
            "Chinese": "是的。我觉得不如在舞蹈之外，找出自己擅长的事情并加以发展，会更好。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:53:53",
            "content": "そうですか",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/14(日) 15:54:23",
            "content": "ダンスは捨てろって感じかな",
            "Chinese": "感觉就是要把舞蹈放弃掉的意思吗？"
        },
        {
            "role": "カウンセラー",
