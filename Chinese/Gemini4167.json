{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:21:33",
            "content": "(こんばんは。本日はよろしくお願いいたします。時間になりましたら始めさせていただきますね。）",
            "Chinese": "（晚上好。今天请多关照。时间一到，我们就会开始。）"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:21:59",
            "content": "（ありがとうございます。承知しました。よろしくお願い致します。）",
            "Chinese": "（谢谢您。我明白了。请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:30:10",
            "content": "こんばんは。相談員です。本日はお越しいただきありがとうございます。まずはじめに、年齢、性別、相談内容を教えていただけますか？",
            "Chinese": "晚上好，我是咨询师。感谢您今天前来。首先，可以请您告诉我您的年龄、性别和咨询内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:30:36",
            "content": "18歳　学生周りの目が気になる",
            "Chinese": "18岁，学生。很在意周围的目光。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:30:58",
            "content": "教えてくださってありがとうございます。周りの目が気になるのですね。",
            "Chinese": "谢谢您告诉我。您很在意周围的目光呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:31:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:31:25",
            "content": "どんな時に周りの目が気になるなと思いますか？",
            "Chinese": "您在什么样的时候会觉得在意周围人的眼光呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:31:33",
            "content": "いつもです",
            "Chinese": "一直都是。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:31:53",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:32:43",
            "content": "ちなみに、いま何年生か教えていただけますか？",
            "Chinese": "顺便问一下，可以告诉我您现在是几年级吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:33:01",
            "content": "1年生",
            "Chinese": "一年级。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:33:10",
            "content": "大学生です",
            "Chinese": "是大学生。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:33:32",
            "content": "教えてくださってありがとうございます。大学1年生なのですね。",
            "Chinese": "谢谢您告知。原来是大学一年级啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:33:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:33:50",
            "content": "周りの目が気になり始めたのは、いつごろからですか？",
            "Chinese": "您是从什么时候开始在意周围的目光的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:34:00",
            "content": "中学生ぐらい",
            "Chinese": "大概是初中的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:35:16",
            "content": "そんなに前から気にされていたのですね。周りの目が気になってしまうと、しんどいことも多いと想像できますが、",
            "Chinese": "原来您从那么久以前就在意了啊。我可以想象，总是在意周围人的眼光，一定有很多辛苦的地方。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:35:54",
            "content": "周りの目が気になってしまうことで、どんなことに悩んでいますか？",
            "Chinese": "因为在意周围人的眼光，您具体在为什么事情烦恼呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:36:24",
            "content": "よくわからないです",
            "Chinese": "不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:37:09",
            "content": "そうなのですね。周りを気にしている時に、あなたはどんなお気持ちになりますか？",
            "Chinese": "是这样啊。那么，当您在意周围人时，您是怎样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:38:00",
            "content": "つらいです",
            "Chinese": "很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:38:17",
            "content": "お辛いんですね。",
            "Chinese": "您很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:39:44",
            "content": "そうですよね。周りを気にしてしまうと、びくびくしてしまってつらいこともあるのかなと想像しました。",
            "Chinese": "是啊。我能想象，总是在意周围人的话，有时会变得战战兢兢，感觉很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:39:55",
            "content": "はい、、",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:40:39",
            "content": "周りの目が気になるときは、自分と周りを比べてしまったりして辛くなるのでしょうか？何がつらいなと感じますか？",
            "Chinese": "在意周围人眼光的时候，是因为会和周围人比较而感到难受吗？您觉得难受的是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:41:51",
            "content": "評価される感じ",
            "Chinese": "感觉一直在被评价。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:42:25",
            "content": "なるほど、評価される感じがしてつらいのですね、、。",
            "Chinese": "原来如此，是感觉自己总被评价，所以很难受啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:43:39",
            "content": "周りが自分のことをどう思ってるんだろうと常々考えてしまうと、身動きがとれなくなってしまいますよね。",
            "Chinese": "如果总是想着“周围人是怎么看我的”，就会变得束手束脚，动弹不得了呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:44:20",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:45:20",
            "content": "それは、つらいですよね、、。周りの目が気になり始めたきっかけは何かありますか？",
            "Chinese": "那一定很难受吧……。有没有什么契机让您开始在意周围人的眼光呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:46:46",
            "content": "中学より高校に入ってからひどくなった",
            "Chinese": "上了高中以后比初中时更严重了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:47:44",
            "content": "そうだったのですか。どうして高校に入ってからひどくなったか、思いあたることはありますか？",
            "Chinese": "原来是这样。关于为什么上了高中以后变得更严重了，您有什么头绪吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:49:03",
            "content": "先生から",
            "Chinese": "因为老师。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:49:13",
            "content": "容姿について言われた",
            "Chinese": "老师对我的外貌说了一些话。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:49:44",
            "content": "ええ。容姿について、、そうだったのですね。",
            "Chinese": "嗯。关于外貌……是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:50:00",
            "content": "みんなの前で",
            "Chinese": "当着大家的面。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:50:11",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:50:22",
            "content": "嫌だった",
            "Chinese": "我很讨厌那样。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:50:51",
            "content": "みんなの前で、容姿のことについて言われて、嫌な思いをされることがあったのですね。",
            "Chinese": "您曾在大家面前因为外貌被评论，有过不愉快的经历呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:51:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:51:50",
            "content": "お話しできる範囲で大丈夫なので、どんなことを言われたのか教えていただくことはできますか？言いたくなければ、無理しないでくださいね。",
            "Chinese": "在您可以说的范围内就好，能告诉我当时老师说了些什么吗？如果不想说，请不要勉强自己。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:53:07",
            "content": "あんまり言いたくない",
            "Chinese": "不太想说。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:53:42",
            "content": "そうですよね。それほど、あなたにとって嫌なことだったのですよね。答えてくださってありがとうございます。",
            "Chinese": "我理解。这对您来说一定是段十分不愉快的经历。谢谢您愿意回答。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:54:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:54:30",
            "content": "そんなことがあって、周りにどう評価されているかが気になってしかたなくなってしまったのですね、、。",
            "Chinese": "经历了这些事情后，您便格外在意他人对您的评价，是这样吗……"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:55:00",
            "content": "親もできてないことを責めてくる",
            "Chinese": "父母也会因为我没做到的事情责怪我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:55:16",
            "content": "ええ。そうなのですね。",
            "Chinese": "嗯。是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:55:47",
            "content": "ちなみに、できてないこと、というのはどういったことですか？",
            "Chinese": "顺便问一下，您说的“没做到的事情”，是指什么样的事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:56:11",
            "content": "家事が時間で終わらない時",
            "Chinese": "家务活没有在规定时间内做完的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:57:21",
            "content": "そんなときに、責められるのですね。",
            "Chinese": "那种时候会被责备呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:57:31",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:57:59",
            "content": "それも、しんどいお気持ちになりますよね。",
            "Chinese": "这一定也让您感到非常难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:58:24",
            "content": "いつも怒られる",
            "Chinese": "总是被骂。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:58:53",
            "content": "そうでしたか、、。",
            "Chinese": "原来是这样……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 19:59:37",
            "content": "ちなみに、家事は、何か分担等であなたがやることが決められているような感じですか？",
            "Chinese": "顺便问一下，关于家务，是像分工那样，规定了要由您来做吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 19:59:55",
            "content": "中学から自分がしています",
            "Chinese": "从初中开始就是我负责的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:01:17",
            "content": "中学からされているのですか。それは、大変な思いをされたことがたくさんおありだったんだろうなと想像できます。",
            "Chinese": "从初中就开始了吗？我可以想象，您一定经历了很多辛苦的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:01:56",
            "content": "家事はほとんどあなたがされていらっしゃるのですか？割合的にはどんな感じでしょう？",
            "Chinese": "家务几乎都是您在负责吗？比例大概是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 20:02:50",
            "content": "夜ご飯と洗い物と、洗濯。",
            "Chinese": "晚饭、洗碗和洗衣。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:03:57",
            "content": "そういった家事をされていらっしゃるのですね。それができていないと親御さんに責められるのですね。",
            "Chinese": "原来您负责这些家务。如果没能完成，就会被父母责备呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 20:04:20",
            "content": "時間で終わらないと言われます",
            "Chinese": "他们说我没能按时完成。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:05:24",
            "content": "そうなのですね。念のために確認させていただきたいのですが、時間で終わらないと、というのは時間が決められていてその時間内に終わらないと、という認識で合っていますか？",
            "Chinese": "是这样啊。为了确认一下，您说的“没有在规定时间内做完”，是指有规定好的时间，如果没能在那个时间内完成就会被说，我这样理解对吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 20:07:20",
            "content": "はい、そうです",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:07:48",
            "content": "わかりました。ありがとうございます。",
            "Chinese": "我明白了。谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:08:52",
            "content": "時間内に終わらず、そういう風に親御さんに怒られると、あなたはどんなお気持ちになりますか？",
            "Chinese": "当您未能按时完成而被父母责骂时，您内心有什么样的感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 20:09:14",
            "content": "私が悪いと思いました",
            "Chinese": "我会觉得是我的错。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:09:34",
            "content": "そんな風に思われているのですね。",
            "Chinese": "您是这样认为的啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 20:10:37",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:11:16",
            "content": "親御さんに怒られて、自分が悪いと自分を責めることが続くと、つらくなってきてしまうのかなと思ったのですが、いかがですか？",
            "Chinese": "我想，如果持续被父母责骂并自责，您可能会越来越难受。您觉得是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 20:12:13",
            "content": "よくわからないです",
            "Chinese": "不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:12:41",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:13:52",
            "content": "では、外に出ると周りの目が気になってしまうし、家では家事ができないと責められてしまう、今はそんな状況があるのですね。",
            "Chinese": "也就是说，现在您出门时会在意周围的目光，在家又会因为家务做不好而被责备，您正处于这样的状况中呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 20:15:03",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:16:12",
            "content": "そんな状況だと、なかなかリラックスもできないし、緊張状態が続いてしまってお辛いと思います。だからこそ疲れも溜まってきているのではないかなと心配になります。",
            "Chinese": "在这样的状况下，很难放松下来，一直处于紧张状态，想必您一定很辛苦吧。正因为如此，我有点担心您是不是也积攒了很多疲劳。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 20:17:05",
            "content": "勉強が忙しいから",
            "Chinese": "因为学习很忙。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:17:12",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 20:17:17",
            "content": "家族に話したけど",
            "Chinese": "我跟家人说过了，但是……"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 20:17:27",
            "content": "聞いてもらえませんでした",
            "Chinese": "但他们没有听。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:18:51",
            "content": "ご家族に話しても聞いてもらえなかったんですね、、。お話ししたのは、勉強が忙しいから家事が時間内にできないということでしょうか？",
            "Chinese": "您跟家人说了，但他们没有倾听您……您说的是因为学习太忙，所以家务无法按时完成，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/26(水) 20:19:25",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/26(水) 20:20:10",
