{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:50:37",
            "content": "こんばんは。よろしくお願いいたします。",
            "Chinese": "晚上好。请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:50:57",
            "content": "こんばんは、宜しくお願いします",
            "Chinese": "晚上好，也请您多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:51:22",
            "content": "少し早いですがはじめてもよろしいですか？",
            "Chinese": "时间还有点早，不过我们可以开始了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:51:47",
            "content": "はい、大丈夫です",
            "Chinese": "好的，没问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:52:06",
            "content": "では始めますね。",
            "Chinese": "那么我们开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:52:14",
            "content": "どうぞ",
            "Chinese": "好的，请吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:52:52",
            "content": "こんにちは。相談員です。始めに年齢と性別、何とお呼びすれば良いか教えていただけますか？",
            "Chinese": "您好。我是咨询师。在开始之前，可以告诉我您的年龄、性别，以及我该如何称呼您吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:53:13",
            "content": "19才、女性",
            "Chinese": "19岁，女性。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:53:21",
            "content": "まこ",
            "Chinese": "真子。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:54:04",
            "content": "まこさんですね。教えていただきありがとうございます。本日はどのようなご相談ですか？",
            "Chinese": "是真子小姐啊。谢谢您告诉我。今天您想聊点什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:54:20",
            "content": "もう、消えてしまいたい",
            "Chinese": "我已经……好想就这样消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:55:19",
            "content": "そうだったのですね。お辛いかと思いますが、もう少し詳しく教えていただけますか？",
            "Chinese": "是这样啊。想必您一定很痛苦，可以再详细地跟我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:55:50",
            "content": "東京の大学に入学しましたが",
            "Chinese": "我考上了东京的一所大学，不过……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:55:57",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:56:07",
            "content": "コロナでずっとオンライン授業で",
            "Chinese": "因为疫情一直都是网课，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:56:16",
            "content": "友達も出来ず",
            "Chinese": "也交不到朋友，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:56:21",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:56:28",
            "content": "ずっと家にいます",
            "Chinese": "一直都待在家里。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:56:47",
            "content": "こんなの意味あるんでしょうか",
            "Chinese": "这样下去还有什么意义呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:57:38",
            "content": "そう思われるのも当然なことですよね。",
            "Chinese": "您会这么想也是很正常的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:58:11",
            "content": "本当に辛い世の中になってしまいましたものね。",
            "Chinese": "这个世界真的变得很艰难了呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:58:16",
            "content": "でも、",
            "Chinese": "但是，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:58:24",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:59:07",
            "content": "今日は勇気を持って相談していただき、まこさんの悩みをしっかり受け止めますね。",
            "Chinese": "今天您能鼓起勇气来咨询，我会认真倾听并接纳您的烦恼。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:59:21",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:59:33",
            "content": "ここでは、全て吐き出してくださいね。",
            "Chinese": "在这里，请把一切都倾诉出来吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:59:44",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:00:32",
            "content": "まこさんは、どんな大学生活を思い浮かべていましたか？",
            "Chinese": "真子小姐，您原本想象的大学生活是什么样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:01:06",
            "content": "すべてが変わると思ってました",
            "Chinese": "我曾以为一切都会改变。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:01:31",
            "content": "期待に胸が膨らみますよね。",
            "Chinese": "心里会充满期待呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:01:40",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:02:18",
            "content": "同じ大学に通っているかたも全てオンラインなのでしょうか？",
            "Chinese": "您同校的其他同学，也都是上网课吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:02:37",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:03:14",
            "content": "それは本当に辛いですよね。",
            "Chinese": "那真的很难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:03:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:03:54",
            "content": "まこさんは地方から東京に引っ越されたのですか？",
            "Chinese": "真子小姐，您是从外地搬到东京来的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:04:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:04:54",
            "content": "そうでしたか。期待が大きかった分辛くなってしまいますよね。",
            "Chinese": "这样啊。期待越大，失望也就越大，一定更难过了吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:05:12",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:05:57",
            "content": "ワクチンが出てきているようですが、まだ普及には時間がかかりそうですものね。",
            "Chinese": "虽然疫苗已经出来了，但要普及看来还需要一些时间呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:06:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:06:20",
            "content": "もう消えてしまいたい",
            "Chinese": "我真的好想就这样消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:06:40",
            "content": "はい。そこまでお辛かったのですね。",
            "Chinese": "嗯。您已经痛苦到这种程度了啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:07:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:07:53",
            "content": "まこさんは、その大学に入ってどのような生活を思い浮かべていたのですか？",
            "Chinese": "真子小姐，您当初进入那所大学时，设想的是怎样的生活呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:08:36",
            "content": "親に進められて入ったので",
            "Chinese": "因为是父母推荐我去的……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:08:44",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:08:55",
            "content": "とくにやりたいこと無いです",
            "Chinese": "其实并没有特别想做的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:09:55",
            "content": "なるほどですね。友人はたくさん作りたいということでしょうか？",
            "Chinese": "原来如此。是希望能交到很多朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:10:21",
            "content": "作れたらいいですけど…",
            "Chinese": "要是能交到就好了……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:10:28",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:11:05",
            "content": "この状況では無理ですよね",
            "Chinese": "但在这种情况下根本不可能，对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:11:27",
            "content": "なかなかオンラインで難しい状況ということですよね。",
            "Chinese": "也就是说，在线上交朋友是很难的，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:11:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:12:31",
            "content": "では、もう一つ質問ですが、まこさんは何をしている時が楽しいですか？",
            "Chinese": "那么再问一个问题，真子小姐，您做什么事情时会感到开心呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:13:06",
            "content": "今は思いつきません…",
            "Chinese": "现在想不出来……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:13:53",
            "content": "失礼いたしました。では、質問を変えますね。",
            "Chinese": "抱歉。那我换个问题吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:13:59",
            "content": "まこさんは、",
            "Chinese": "真子小姐，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:14:51",
            "content": "今とても不安なお気持ちなのではと思いますが、ここに相談する前にどなたかにご相談はされましたか？",
            "Chinese": "我想您现在的心情一定很不安，来这里咨询之前，您有和谁聊过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:15:31",
            "content": "いいえ、誰にも相談してません",
            "Chinese": "没有，我谁也没跟说过。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:16:17",
            "content": "そうでしたか。勇気を持って相談してくださったのですね。",
            "Chinese": "这样啊。您是鼓起了很大的勇气才来咨询的吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:16:40",
            "content": "そうですね",
            "Chinese": "算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:17:46",
            "content": "本当にありがとうございます。その勇気を無駄にしないために一緒に考えていきましょうね。",
            "Chinese": "真的非常感谢您。为了不辜负您的这份勇气，让我们一起想办法吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:18:03",
            "content": "はい、お願いします",
            "Chinese": "好的，拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:18:18",
            "content": "一つ気になったのですが、",
            "Chinese": "有件事我有点在意，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:18:40",
            "content": "親に大学を進められたとありましたが、",
            "Chinese": "您提到是父母建议您上这所大学，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:19:12",
            "content": "まこさんはもともとどのような進路を希望していたのですか？",
            "Chinese": "真子小姐原本希望走什么样的道路呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:20:04",
            "content": "あまり気にしてませんでした",
            "Chinese": "我没怎么在意过。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:20:08",
            "content": "ただ",
            "Chinese": "只是，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:20:14",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:20:32",
            "content": "実家は出たいなというのはありました",
            "Chinese": "有过想离开家的念头。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:21:23",
            "content": "なるほどですね。よろしければ家を出たいということについて詳しく教えていただけますか？",
            "Chinese": "原来如此。如果不介意的话，可以详细地告诉我您想离开家的原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:22:09",
            "content": "高校でいじめにあってました",
            "Chinese": "我高中时被霸凌过。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:22:42",
            "content": "そうだったのですね。それはお辛かったのではと思います。",
            "Chinese": "是这样啊。那段经历一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:22:50",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:23:35",
            "content": "高校でそのような経験をされて家を出たくなってしまったということでしょうか？",
            "Chinese": "是因为在高中经历了那样的事情，所以才想离开家吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:24:19",
            "content": "もうこの町にはいたくないと思ってました",
            "Chinese": "我当时只觉得再也不想待在这个小镇了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:24:59",
            "content": "そう思われても無理もないですよね。私もそういう経験ありますので、お気持ちすごくわかります。",
            "Chinese": "您会这么想也是难免的。我也有过类似的经历，所以非常理解您的心情。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:25:18",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:25:58",
            "content": "それについて両親はどのような感じだったのですか？",
            "Chinese": "关于这件事，您的父母是什么反应呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:26:30",
            "content": "親には心配かけたくなかったので",
            "Chinese": "因为不想让父母担心，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:26:38",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:27:02",
            "content": "はっきりとは話しなかったんです",
            "Chinese": "所以没有跟他们明说。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:27:35",
            "content": "心配かけたくないという気持ちになってしまいますよね。",
            "Chinese": "您一定很不想让他们担心吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:28:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:28:13",
            "content": "親思いの心優しいかたなのですね。",
            "Chinese": "您真是一个体贴父母、心地善良的人呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:28:48",
            "content": "そうですか",
            "Chinese": "是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:29:17",
            "content": "はい。私にはそう思います。",
            "Chinese": "是的。我是这么认为的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:29:28",
            "content": "大学で、",
            "Chinese": "在大学里，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:30:02",
            "content": "新しい友人に会えるかもという期待が強かったのではないでしょうか？",
            "Chinese": "您是不是很期待能认识新朋友呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:30:46",
            "content": "はい、すべて変えられると思ってました",
            "Chinese": "是的，我以为一切都能改变。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:30:50",
            "content": "でも",
            "Chinese": "可是，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:30:57",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:31:06",
            "content": "何も変わらなかった",
            "Chinese": "却什么都没有改变。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:31:28",
            "content": "もう消えてしまいたい",
            "Chinese": "我真的好想就这样消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:32:49",
            "content": "そう思われるお気持ちもすごくわかります。",
            "Chinese": "我非常理解您这样的心情。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:33:11",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:33:31",
            "content": "今は1人暮らしなのでしょうか？",
            "Chinese": "您现在是一个人住吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:33:43",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:34:14",
            "content": "なおさら寂しい気持ちになってしまいますよね。",
            "Chinese": "那一定更加感到孤单吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:34:43",
            "content": "両親とのご関係は良好でしょうか？",
            "Chinese": "您和父母的关系还好吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:35:16",
            "content": "まあ、そうだと思います",
            "Chinese": "嗯，我想算是吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:35:28",
            "content": "心配かけたくないので",
            "Chinese": "因为不想让他们担心，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:35:54",
            "content": "本当の気持ちは絶対言えません",
            "Chinese": "所以绝对不能说出真实感受。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:37:11",
            "content": "そうだったのですね。でも両親は心配をかけないようにしているまこさんに心配されているかもしれませんよ。",
            "Chinese": "原来是这样。但您的父母可能正因为您不想让他们担心而更加担心呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:37:28",
            "content": "そうですね",
            "Chinese": "也是呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:39:02",
            "content": "一度今の状況をご相談されて見るのはいかがでしょうか？",
            "Chinese": "试着和他们谈谈现在的情况怎么样？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:39:17",
            "content": "もしかしたら、",
            "Chinese": "说不定，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:39:59",
            "content": "相談されるのを待っているかもしれませんよね。",
            "Chinese": "他们可能也正等着您开口呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:41:02",
            "content": "でも心配かけたくない",
            "Chinese": "可我还是不想让他们担心。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:41:22",
            "content": "こんな相談した私が悪いんです",
            "Chinese": "都是我不好，提出这种咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:41:47",
            "content": "そんなことありませんよ。具体的にどのような心配か教えていただけますか？",
            "Chinese": "没有这回事哦。可以具体告诉我您在担心什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:42:48",
            "content": "親は自分の進めた大学に入学させて喜んでると思います",
            "Chinese": "我想父母会因为我进入了他们推荐的大学而高兴。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:43:09",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:43:11",
            "content": "私がこんなんじや",
            "Chinese": "可我现在这样，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:43:18",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:43:32",
            "content": "きっとがっかりすると思います",
            "Chinese": "他们一定会很失望的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:45:22",
            "content": "まこさんは、本当はその大学に入りたかったわけではなかった。ということでしょうか？",
            "Chinese": "您的意思是，您其实并不是真的想进那所大学，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:45:54",
            "content": "あまり何も考えずに",
            "Chinese": "我当时并没有多想，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:46:01",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:46:19",
            "content": "親のすすめるまま入学しました",
            "Chinese": "就按父母的建议入学了。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:46:34",
            "content": "地元に残るのも嫌でしたし",
            "Chinese": "而且我也不想留在老家。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:46:42",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:47:20",
            "content": "一つ提案よろしいでしょうか？",
            "Chinese": "我可以提个建议吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:47:28",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:47:46",
            "content": "今はなかなか考え辛いとは思いますが、",
            "Chinese": "我想现在可能很难去思考，但是"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:48:19",
            "content": "まこさん自身のやりたいこと、楽しいことを探して行ければと思います。",
            "Chinese": "我建议，我们可以一起去寻找您自己想做、并且能让您开心的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:48:29",
            "content": "そうすることにより、",
            "Chinese": "这样做的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:48:54",
            "content": "自分に自信を持ちながら行動できますし、",
            "Chinese": "您可以在行动中建立自信，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:49:18",
            "content": "親もまこさんの決断なら納得すると思うんです。",
            "Chinese": "而且我想，如果是您自己的决定，您的父母也会理解的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:49:26",
            "content": "なかなか、",
            "Chinese": "虽然这可能，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:49:45",
            "content": "難しいことかもしれませんが、",
            "Chinese": "是一件很难的事，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:50:12",
            "content": "親に人生を決められるのではなく、",
            "Chinese": "与其让父母来决定人生，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:50:45",
            "content": "自分で好きなことに挑戦して行ければと思いますがいかがでしょうか？",
            "Chinese": "不如由自己去尝试喜欢的事情，您觉得如何？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:51:43",
            "content": "好きなことって何だろう？",
            "Chinese": "喜欢的事情……是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:52:02",
            "content": "今は思いつきません",
            "Chinese": "我现在想不出来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:53:26",
            "content": "今思いつかなかったとしても良いと思います。これから探していきませんか？",
            "Chinese": "现在想不出来也没关系。要不要从现在开始慢慢找一找？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:54:07",
            "content": "こんな私で見つかるでしょうか？",
            "Chinese": "像我这样的人，能找到吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:55:41",
            "content": "見つかりますとも。心優しいまこさんは人のために考えられるかたですから、自分自身についてもきっと考えていけるはずだと思います。",
            "Chinese": "一定能找到的。心地善良的您是能为他人着想的人，所以我想您一定也能够好好地为自己考虑。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:56:17",
            "content": "はい、ありがとうございます",
            "Chinese": "好的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:57:04",
            "content": "頑張っていきましょうね。心から応援しております。また何かありましたらご相談にいらしてくださいね。",
            "Chinese": "我们一起加油吧。我真心为您加油。如果还有什么事，请随时来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:57:25",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:58:00",
            "content": "それでは本日のご相談を終了いたしますね。",
            "Chinese": "那么今天的咨询就到此结束了。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:58:14",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:58:24",
            "content": "ロールプレイ終了してもよろしいですか？",
            "Chinese": "可以结束本次角色扮演了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 20:58:49",
            "content": "(はい、お疲れ様でした！)",
            "Chinese": "（好的，辛苦了！）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 20:59:30",
            "content": "こちらこそありがとうございました。お疲れ様でした。失礼いたします。",
            "Chinese": "我也要谢谢您。辛苦了。那么我先告辞了。"
        }
