{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:02:53",
            "content": "こんばんは。よろしくお願いいたします。",
            "Chinese": "晚上好。请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:10:38",
            "content": "（恐れ入ります。本日18時～19時でロールプレイ相談者役で申込成立し、只今待機中です）",
            "Chinese": "（不好意思。我已成功预约今天18点到19点的角色扮演咨询，目前正在等待中。）"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:34:44",
            "content": "こんばんは。大変お待たせいたしました。",
            "Chinese": "晚上好。非常抱歉，让您久等了。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:34:56",
            "content": "こんばんは。よろしくお願いいたします。",
            "Chinese": "晚上好。请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:35:44",
            "content": "ごめんなさい。それでは、お時間少なくなってしまいましたが、さっそく始めさせていただきます。",
            "Chinese": "非常抱歉。时间所剩不多了，我们这就马上开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:35:51",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:35:56",
            "content": "お願いいたします。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:37:06",
            "content": "本日は、どのようなご相談でいらっしゃいましたか？ご相談に先立ち、ご年齢と性別、ご相談の内容を簡単におはなしいただけるとありがたいです。",
            "Chinese": "今天您想咨询什么问题呢？在开始咨询前，如果可以的话，能请您简单说一下您的年龄、性别以及咨询的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:37:17",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:38:24",
            "content": "年齢は40代、女です。年老いた両親のことで色々と考えています",
            "Chinese": "我40多岁，女性。最近一直在为年迈父母的各种事情操心。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:38:41",
            "content": "両親とは別居です。",
            "Chinese": "我和父母不住在一起。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:39:02",
            "content": "お年を召されたご両親のお話ですね。",
            "Chinese": "是关于您年迈父母的事情，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:39:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:39:22",
            "content": "いかがされましたか？",
            "Chinese": "具体是怎么回事呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:40:40",
            "content": "父が体調を崩し、先日退院し今は実家で母と一緒にいるのですが",
            "Chinese": "我父亲前阵子身体不适，前几天刚出院，现在在老家和母亲一起生活，不过……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:40:52",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:41:06",
            "content": "母の体調も心配で",
            "Chinese": "我也很担心母亲的身体状况。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:41:44",
            "content": "お母様も…",
            "Chinese": "您母亲也……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:41:53",
            "content": "遠くに住んでいるもので簡単には会いに行けず",
            "Chinese": "因为我住得很远，没法轻易过去探望。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:42:11",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:42:14",
            "content": "母は疲れやすいので",
            "Chinese": "我母亲很容易感到疲劳。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:42:33",
            "content": "それは、心配ですね",
            "Chinese": "那确实让人担心呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:42:46",
            "content": "はい。母は何か病気になっているわけではないです",
            "Chinese": "是的。倒不是说我母亲得了什么病。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:43:25",
            "content": "病気ではない…ちなみに、おいくつでいらっしゃるのですか？",
            "Chinese": "没有生病……顺便问一下，您父母多大年纪了？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:43:52",
            "content": "両親ともに70代後半です",
            "Chinese": "父母都是70多岁的后半段了。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:44:41",
            "content": "兄夫婦が近くに住んでいますので、色々な意味で安心していたのですが",
            "Chinese": "我哥哥夫妇就住在附近，所以我在各方面一直都比较放心，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:44:59",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:45:03",
            "content": "兄夫婦は共働きで忙しいらしく",
            "Chinese": "哥哥夫妇好像因为是双职工，所以很忙。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:45:13",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:45:40",
            "content": "両親も気をつかって、兄夫婦には迷惑かけないようにしているのです",
            "Chinese": "我父母也很体谅，尽量不给哥哥他们添麻烦。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:46:05",
            "content": "私は離れているので何もできず",
            "Chinese": "而我离得远，什么也帮不上。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:46:16",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:47:14",
            "content": "ご心配募るお気持ち、お察しいたします",
            "Chinese": "我能理解您日益加深的担忧。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:47:36",
            "content": "ありがとうございます｡私は実家から出ているので兄夫婦の立場も考えないといけないなとも思っています",
            "Chinese": "谢谢您。因为我已经不住在老家了，所以也觉得必须考虑我哥哥他们的立场。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:47:54",
            "content": "複雑です",
            "Chinese": "心情很复杂。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:49:11",
            "content": "そうでしたか。気丈なご両親とはいえご自身たちだけでできることにも限りが生じるお年頃ですね。お兄様のお立場も配慮されると確かにちゃちゃを入れているようなことになるのははばかられますね。",
            "Chinese": "是这样啊。虽然您的父母很坚强，但以他们这个年纪，独自能做的事情也有限。再考虑到您哥哥的立场，确实也不好贸然插手呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:49:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:49:31",
            "content": "そういう感じです",
            "Chinese": "就是这种感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:50:34",
            "content": "現状、退院されたお父様の身の回りのお世話は、お母様がおひとりで頑張っていらっしゃるということでしょうか",
            "Chinese": "目前，您出院后的父亲，日常照料都是由母亲一个人在勉力支撑着，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:50:52",
            "content": "はいそうです",
            "Chinese": "是的，没错。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:51:10",
            "content": "母は大丈夫だよと",
            "Chinese": "母亲总说“我没事的”。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:51:25",
            "content": "心配かけたくないようです",
            "Chinese": "她好像不想让我们担心。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:51:39",
            "content": "なんとも、心苦しい状態ですね。",
            "Chinese": "这情况真是让人心疼呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:51:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:52:29",
            "content": "お兄様のご家族は、そのご様子について、どのようにお考えなのでしょうか？お話しされたことはありますか？",
            "Chinese": "您哥哥一家对这种情况是怎么想的呢？您和他们谈过吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:52:43",
            "content": "はい",
            "Chinese": "谈过。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:53:14",
            "content": "もしよろしければ、少しお話しいただけますか？",
            "Chinese": "如果方便的话，能稍微说一下吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:53:44",
            "content": "両親がそれで良いって言ってるのだから、余計な心配いらないんじゃないという感じです",
            "Chinese": "他们大概是觉得，既然父母自己都说这样就行，那我们也就不用多操心了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:54:05",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:54:57",
            "content": "そうはいっても、ご心配なのですよね",
            "Chinese": "话虽如此，您还是很担心，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:55:07",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:55:33",
            "content": "明らかに両親は大変だと思います",
            "Chinese": "我觉得父母明显很辛苦。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:55:49",
            "content": "兄夫婦も忙しいのはわかりますが",
            "Chinese": "我也理解哥哥和嫂子很忙，不过……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:56:19",
            "content": "これで良いのかな",
            "Chinese": "但这样真的好吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:56:32",
            "content": "と色々考えてしまいます",
            "Chinese": "不由得会想很多。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:56:50",
            "content": "そうですね。ご心配なお気持ちは、状況からもお察しいたします。どのようなことで、ご両親のお力になりたいか、なにかお考えはありますか？",
            "Chinese": "是啊。从您描述的情况来看，我能理解您的担心。您有没有想过，希望在哪些方面能帮到您的父母呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:57:18",
            "content": "本当はそばにいたい気持ちですが",
            "Chinese": "其实我希望能陪在他们身边，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:57:27",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:57:31",
            "content": "それは現実的に厳しくて",
            "Chinese": "但现实中很难做到。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:57:46",
            "content": "はい、たしかに。",
            "Chinese": "是的，确实如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:57:46",
            "content": "私の家庭や仕事がありますので",
            "Chinese": "因为我也有自己的家庭和工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:57:55",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:58:06",
            "content": "それでも",
            "Chinese": "但即便如此，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:58:19",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:58:28",
            "content": "近くで看てくれる人がいれば",
            "Chinese": "如果有能在附近照看他们的人，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:58:37",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:58:38",
            "content": "少しは安心できそうです",
            "Chinese": "我或许就能稍微安心一些。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:58:53",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:59:27",
            "content": "自分は何もできないのですが",
            "Chinese": "虽然我自己什么也做不了，"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 18:59:41",
            "content": "心配ばかりが募ります",
            "Chinese": "但担心却越来越多。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 18:59:58",
            "content": "せめて、ご両親の暮らしぶりを親身に看ることのできる方法があれば、",
            "Chinese": "如果至少能有一种方法，可以贴心地照看到您父母的生活状况，"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 19:00:11",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 19:00:35",
            "content": "状況が見えない不安は除くことができそうですね",
            "Chinese": "那么因不了解情况而产生的不安，或许就能减轻一些了呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 19:00:48",
            "content": "ご提案なのですが",
            "Chinese": "我有一个建议，"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 19:00:51",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 19:01:07",
            "content": "お願いいたします",
            "Chinese": "麻烦您说说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 19:01:30",
            "content": "地域包括支援センターというものが、全国各自治体にあります。",
            "Chinese": "全国各地的自治体都设有“地域综合支援中心”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 19:01:39",
            "content": "ご存じでしょうか？",
            "Chinese": "您听说过吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 19:01:47",
            "content": "いいえ",
            "Chinese": "没有。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 19:01:58",
            "content": "はじめて聴きます",
            "Chinese": "第一次听说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 19:02:44",
            "content": "ここは、厚労省の地域包括ケアシステムの施策で、高齢者および、その家族を対象に",
            "Chinese": "这个机构是根据厚生劳动省的“地区综合护理系统”政策设立的，服务对象是老年人及其家属。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 19:02:52",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 19:03:30",
            "content": "高齢者が要介護になっても住み慣れた地域で過ごせるように、「住まい」「介護」「医療」「予防」「生活支援」といった必要なサービスを、地域一帯となって提供する体制を目指しています。",
            "Chinese": "它的目标是建立一个体系，让老年人即使需要护理，也能在自己熟悉的社区生活，由整个地区共同提供“居住”、“护理”、“医疗”、“预防”、“生活支援”等必要的服务。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 19:03:42",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 19:04:03",
            "content": "社会福祉士や看護師といった専門の方が無料で相談に応じてくれます。",
            "Chinese": "像社会福利工作者、护士这样的专业人士会免费提供咨询。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/25(金) 19:04:15",
            "content": "そうなのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/25(金) 19:04:25",
            "content": "見守りを依頼することもできます。",
            "Chinese": "也可以委托他们进行探望照看。"
        },
        {
            "role": "クライアント",
