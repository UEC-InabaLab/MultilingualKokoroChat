{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 10:51:11",
            "content": "こんにちは。本日はロールプレイをよろしくお願い致します。",
            "Chinese": "您好。今天的角色扮演还请多多指教。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 10:51:52",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 10:52:52",
            "content": "お時間になりましたら始めさせていただきます。",
            "Chinese": "时间到了我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 10:53:14",
            "content": "はい、よろしくお願いします。",
            "Chinese": "好的，拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:00:04",
            "content": "こんにちは。相談員です。差し支えなければ最初に年齢と性別を教えていただけますか？",
            "Chinese": "您好，我是咨询师。如果不介意的话，能否先告诉我您的年龄和性别？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:00:16",
            "content": "17歳",
            "Chinese": "17岁。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:00:18",
            "content": "男子",
            "Chinese": "男生。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:00:30",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:00:49",
            "content": "本日はどのようなご相談ですか？",
            "Chinese": "您今天想咨询什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:01:08",
            "content": "勉強する意味がわかりません。悩んでいます。",
            "Chinese": "我不明白学习的意义，感到很困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:01:31",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:01:47",
            "content": "詳しくお話を聞かせてください",
            "Chinese": "能请您详细说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:02:43",
            "content": "なんで勉強をするのかなと思ってしまい、やる気がしません。",
            "Chinese": "我总在想为什么要学习，所以提不起干劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:03:09",
            "content": "相談者さまは今、高校2年生でよろしいですか？",
            "Chinese": "请问您现在是高二学生，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:03:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:04:31",
            "content": "勉強する意味がわからず、やる気が出なくて悩んでいらっしゃるのですね。",
            "Chinese": "因为不明白学习的意义，所以提不起干劲，为此感到烦恼，是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:04:57",
            "content": "そうです。成績もあがりません。",
            "Chinese": "是的。成绩也上不去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:05:34",
            "content": "そうなのですね。それはしんどいですね",
            "Chinese": "是这样啊。那一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:05:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:06:59",
            "content": "成績の事で先生や周りの方とお話をしますか？",
            "Chinese": "您会和老师或身边的人谈论成绩的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:07:41",
            "content": "先生には勉強しなさいと言われます。",
            "Chinese": "老师会对我说‘要好好学习’。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:08:39",
            "content": "うん、うん。そういわれるんですね。そういわれてどう感じるのかな？",
            "Chinese": "嗯，嗯。老师会这么说啊。听到这样的话，您有什么感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:09:23",
            "content": "一応、その時は、はいと言います。",
            "Chinese": "当时我一般会先说“好”。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:09:39",
            "content": "でも、なんで勉強するんだろうと思ってしまい、",
            "Chinese": "但是，我还是会想，到底为什么要学习呢，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:09:57",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:09:58",
            "content": "やる気になりません。",
            "Chinese": "就提不起干劲了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:11:04",
            "content": "そうなんですね。それは憂鬱になってしまいますよね。",
            "Chinese": "是这样啊。那确实会让人感到郁闷呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:11:26",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:11:40",
            "content": "なんか、イライラします。",
            "Chinese": "总觉得有点烦躁。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:12:26",
            "content": "うん、うん、そうなんですね。",
            "Chinese": "嗯，嗯，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:15:20",
            "content": "勉強する意味が分からなくて悩んでいるのに、",
            "Chinese": "明明正在为不明白学习的意义而烦恼，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:15:59",
            "content": "勉強しろと言われたらイライラするよね…",
            "Chinese": "却被要求‘去学习’，会感到烦躁也是理所当然的呢…"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:16:06",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:16:52",
            "content": "高校2年生といえば、これからの進路の事なども決めていく時期かと思いますが、",
            "Chinese": "说到高二，我想也是决定未来发展方向的时期，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:17:48",
            "content": "その辺のことはどうかな？",
            "Chinese": "关于这方面您是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:18:02",
            "content": "大学には行こうと思ってます。",
            "Chinese": "我打算上大学。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:18:25",
            "content": "ええ、そうなんですね。",
            "Chinese": "嗯，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:19:37",
            "content": "大学で何を勉強したいとか、",
            "Chinese": "您想在大学学习什么专业，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:20:10",
            "content": "いきたい大学は決まっていますか？",
            "Chinese": "或者决定好想去的大学了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:20:38",
            "content": "経済か、哲学か、社会学とか",
            "Chinese": "比如经济学、哲学或者社会学之类的。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:20:43",
            "content": "大学は決まってません。",
            "Chinese": "大学还没决定。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:21:29",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:23:22",
            "content": "勉強する意味がわからないと言っていましたが、勉強することは好きですか？",
            "Chinese": "您刚才说不明白学习的意义，那您喜欢学习这件事本身吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:23:45",
            "content": "あまり好きではありません。",
            "Chinese": "不太喜欢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:24:01",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:24:21",
            "content": "とくに英語と数学は好きではないです。",
            "Chinese": "尤其是不喜欢英语和数学。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:24:43",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:25:12",
            "content": "でも、英語と数学は",
            "Chinese": "但是，英语和数学"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:25:40",
            "content": "重要な教科ですよね…",
            "Chinese": "都是很重要的科目呢…"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:26:33",
            "content": "嫌いだとしんどいですね…",
            "Chinese": "不喜欢的话确实会很辛苦呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:26:34",
            "content": "重要なんですね。",
            "Chinese": "原来很重要啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:26:51",
            "content": "はい、しんどいです。",
            "Chinese": "是的，挺难受的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:28:27",
            "content": "勉強以外に高校生活では取り組んでいることはありますか？",
            "Chinese": "除了学习之外，高中生活中还有其他参与的活动吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:29:37",
            "content": "文芸部に入ってます。ゆるい感じ出すが。",
            "Chinese": "我参加了文艺社，不过氛围比较轻松。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:29:41",
            "content": "ですが。",
            "Chinese": "但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:30:13",
            "content": "文芸部なんですね。",
            "Chinese": "是文艺部啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:31:41",
            "content": "文芸部とは何をする部活なのか教えていただけますか？すみません、私の知識がなくて",
            "Chinese": "能告诉我文艺部是做什么的吗？不好意思，我不太了解。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:32:08",
            "content": "とくに決まってませんが、好きな本の話をしたり、",
            "Chinese": "也没有什么特别固定的活动，就是聊聊喜欢的书，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:32:19",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:32:21",
            "content": "リレーで小説を作ったりする感じです。",
            "Chinese": "或者大家接力写小说之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:33:02",
            "content": "そうなのですね。教えてくださりありがとうございます。",
            "Chinese": "是这样啊。谢谢您告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:33:26",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:33:29",
            "content": "部活をしているときは楽しいですか？",
            "Chinese": "参加社团活动的时候，您觉得开心吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:33:45",
            "content": "そうですね。それなりに楽しいです。",
            "Chinese": "嗯，还算挺开心的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:35:03",
            "content": "では、これまでのお話をまとめてみてもいいですか？",
            "Chinese": "那么，我可以总结一下我们目前谈话的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:35:08",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:38:22",
            "content": "あなたは勉強する意味がわからず悩んでいます。成績があがらす、やる気が出ない中、先生には勉強しなさいと言われ、イライラとした感情もあります",
            "Chinese": "您因为不明白学习的意义而烦恼。在成绩没有提升、提不起干劲的情况下，老师还对您说要好好学习，这让您感到有些烦躁。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:38:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:40:00",
            "content": "勉強はあまり好きではない。特に英語と数学は大学受験は考えているがまだ行きたい大学は決まっていない。",
            "Chinese": "您不太喜欢学习，特别是英语和数学。虽然考虑过大学升学，但还没有确定想去的大学。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:40:31",
            "content": "はい。そうです。",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:40:44",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:41:10",
            "content": "このご相談で一番解決したいことはどの様なことですか？",
            "Chinese": "在这次咨询中，您最想解决的是什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:41:50",
            "content": "勉強することの意味が知りたいです。",
            "Chinese": "我想知道学习的意义。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:41:57",
            "content": "あとは、どうしたらやる気になるのか。",
            "Chinese": "另外，想知道怎样才能提起学习的动力。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:42:40",
            "content": "はい。では一緒に考えていけたらと思います",
            "Chinese": "好的。那我们一起探讨这个问题吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:43:03",
            "content": "お願いします。",
            "Chinese": "拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:44:09",
            "content": "先ほどのお話で英語と数学は嫌いと言われていましたが、",
            "Chinese": "刚才您提到不喜欢英语和数学，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:44:59",
            "content": "好きな教科は得意な教科は何ですか？",
            "Chinese": "那么有喜欢或者擅长的科目吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:45:46",
            "content": "好きな教科はあまりありません。",
            "Chinese": "没什么特别喜欢的科目。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:45:59",
            "content": "現代文は成績は悪くないです。",
            "Chinese": "现代文的成绩还不错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:46:16",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:46:24",
            "content": "つまらなく感じます。",
            "Chinese": "但感觉很无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:47:19",
            "content": "現代文は成績は悪くないけど、つまらないと感じるのですね",
            "Chinese": "虽然现代文成绩不错，但您还是觉得很无聊，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:47:37",
            "content": "つまらないのは、どの教科もつまらなく感じてしまいます。",
            "Chinese": "说到无聊，我感觉所有科目都很无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:47:57",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:49:32",
            "content": "文芸部に所属されているという事でしたが、",
            "Chinese": "您刚才提到您是文艺部的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:51:06",
            "content": "かなりたくさんの本を読まれるのですか？",
            "Chinese": "平时会读很多书吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/17(木) 11:51:39",
            "content": "たくさんでもないですが、読みます。",
            "Chinese": "虽然不算很多，但会读一些。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/17(木) 11:52:10",
            "content": "ええ、",
            "Chinese": "嗯，"
