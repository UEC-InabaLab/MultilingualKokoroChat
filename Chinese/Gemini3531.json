{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:22:25",
            "content": "（こんばんは。本日はよろしくお願いいたします。）",
            "Chinese": "（晚上好。今天请多多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:27:06",
            "content": "宜しくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:27:29",
            "content": "（時間になりましたら始めさせていただきます）",
            "Chinese": "（时间到了我们就开始吧。）"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:27:39",
            "content": "分かりました宜しくお願いします",
            "Chinese": "明白了，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:30:10",
            "content": "こんばんは。相談員です。本日はお越しいただきありがとうございます。はじめに年齢、性別を教えていただけますか？",
            "Chinese": "晚上好，我是咨询师。感谢您今天前来咨询。首先，可以告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:30:55",
            "content": "年齢は言いたくないのですが、女性です。",
            "Chinese": "年龄不太想说，但我是女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:31:26",
            "content": "かしこまりました。ありがとうございます。本日はどのようなご相談でしょうか？",
            "Chinese": "好的，我明白了。谢谢您。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:32:08",
            "content": "そうですね",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:32:36",
            "content": "自分が周りから",
            "Chinese": "我在周围人眼中……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:32:38",
            "content": "見た目的に",
            "Chinese": "外表方面……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:32:43",
            "content": "どう思われてるのかを気にしすぎて",
            "Chinese": "过分在意别人怎么看待我……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:32:46",
            "content": "悩んでます",
            "Chinese": "很烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:33:52",
            "content": "周りの目を気にしてしまう、というご相談ですね。",
            "Chinese": "也就是说，您很在意周围人的目光，是关于这方面的咨询对吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:34:02",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:34:59",
            "content": "周りの目、というのは具体的にどういった人のことでしょうか？",
            "Chinese": "您说的“周围人的目光”，具体是指哪些人呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:35:14",
            "content": "いろんな人です",
            "Chinese": "各种各样的人。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:35:20",
            "content": "でも特に男性かもしれないです",
            "Chinese": "但可能特别是男性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:35:55",
            "content": "なるほどですねそれはお悩みになりますよね",
            "Chinese": "原来如此，这确实会让人烦恼呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:36:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:37:41",
            "content": "気にされてしまうとのことですが、それはいつ頃からでしょうか？",
            "Chinese": "您提到会很在意，这种情况大概从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:37:52",
            "content": "分からないです",
            "Chinese": "不太清楚。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:38:01",
            "content": "中学生くらいかなと思います",
            "Chinese": "我感觉大概是初中左右开始的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:38:32",
            "content": "そのころから思っておられたのですね",
            "Chinese": "原来从那个时候就开始有这种想法了啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:38:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:39:39",
            "content": "そのときに、なにかきっかけとなるようなことはございましたか？",
            "Chinese": "那个时候，有什么契机之类的事情发生吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:40:13",
            "content": "分からないです",
            "Chinese": "不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:40:39",
            "content": "ええそうなのですね",
            "Chinese": "嗯嗯，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:40:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:41:59",
            "content": "見た目とおっしゃていましたが、ご自身で気になる、ということはあるのでしょうか？",
            "Chinese": "您提到了外表，您自己本身是否也有在意的地方呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:42:31",
            "content": "自分でも気にはします",
            "Chinese": "我自己也会在意。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:43:01",
            "content": "そのように思っておられるのですね",
            "Chinese": "原来您是这样想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:43:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:44:34",
            "content": "周りの人からはどのように思われいると考えていらしゃいますか？",
            "Chinese": "您觉得周围的人是怎么看待您的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:44:54",
            "content": "周りが自分をどう思ってるとは",
            "Chinese": "关于周围的人如何看我这件事，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:44:57",
            "content": "思ってないです",
            "Chinese": "我并没有这么想。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:45:14",
            "content": "むしろ周りは自分のことを",
            "Chinese": "反而，我觉得周围的人对我"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:45:20",
            "content": "どうも思ってないと思いますが",
            "Chinese": "并没有什么特别的想法，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:45:26",
            "content": "私が気にしてるだけだとおまいます",
            "Chinese": "只是我自己在意罢了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:45:57",
            "content": "なるほどですねそのように思っておられるのですね",
            "Chinese": "原来如此，您是这样想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:46:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:48:17",
            "content": "周りの人がというよりは、ご自身が自分の見た目のことを気にしてしまっているのを悩まれている、という感じでしょうか？",
            "Chinese": "与其说是周围的人，不如说您是为“自己总是在意自己的外表”这件事本身而烦恼，是这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:48:44",
            "content": "うーん、、周りの人にどう思われてるかが気になります。。",
            "Chinese": "嗯……我还是会在意周围的人是怎么看我的……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:48:51",
            "content": "周りの目線です。",
            "Chinese": "就是周围人的目光。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:49:11",
            "content": "そうなのですね教えていただきありがとうございます。",
            "Chinese": "原来如此，感谢您愿意告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:49:14",
            "content": "周りの目線を気にしてる自分を気にしてる、と言う感じです",
            "Chinese": "更像是，我在意那个“会在意别人目光的自己”。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:51:10",
            "content": "なるほどですねそれはお悩みになるのも無理のないことだと思います",
            "Chinese": "原来如此，您会因此而烦恼，我觉得也是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:51:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:52:25",
            "content": "このことは他の方に相談されたりしたことはございますか？",
            "Chinese": "关于这件事，您有向其他人咨询或倾诉过吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:52:32",
            "content": "ないです",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:53:06",
            "content": "そうだったのですねお一人で抱えておられたのですね",
            "Chinese": "原来如此，您一直一个人扛着呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:53:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:54:36",
            "content": "ご自身では、どのようになれば少しでも気になってしまうお気持ちが楽になると思われますか？",
            "Chinese": "您自己觉得，要怎么做才能让这种在意的心情稍微轻松一些呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:54:58",
            "content": "分からないので相談しにきました",
            "Chinese": "我就是因为不知道才来咨询的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:56:27",
            "content": "ええでは周りの人から良く思われたいというお気持ちですか？",
            "Chinese": "嗯嗯，那么，您是希望周围的人对您有好感吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:56:43",
            "content": "そうですね、そう思ってます",
            "Chinese": "是的，我是这么想的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:56:50",
            "content": "よく思われたくて",
            "Chinese": "想要别人对我印象好，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:57:26",
            "content": "彼氏もいるのに",
            "Chinese": "明明有男朋友，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:57:31",
            "content": "他の異性からの目を気にしてるのが",
            "Chinese": "却还在意其他异性的目光，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:57:38",
            "content": "自分が嫌だなって感じですね",
            "Chinese": "我觉得这样的自己很讨厌。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:57:41",
            "content": "恥ずかしいですが",
            "Chinese": "虽然很不好意思，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:57:51",
            "content": "綺麗って思われたい、と思いすぎて",
            "Chinese": "但是我太想被别人觉得漂亮了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:57:56",
            "content": "これを気にしなかったら",
            "Chinese": "如果我能不这么在意，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:58:06",
            "content": "どれだけこころがじゆあになれるんだろうって",
            "Chinese": "内心会变得多么自由啊，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:58:09",
            "content": "自由に",
            "Chinese": "自由地，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:58:14",
            "content": "考えちゃいます",
            "Chinese": "不由自主就会这样想。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:58:30",
            "content": "ええそのようなお気持ちを持っておられるのですね",
            "Chinese": "嗯嗯，您有这样的想法啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:58:31",
            "content": "見た目への承認欲求？が",
            "Chinese": "感觉自己对外表的认可欲？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:58:35",
            "content": "人より強い気がします",
            "Chinese": "我觉得比一般人更强。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 19:59:23",
            "content": "なるほどですね見た目を認めてほしいというお気持ちですね",
            "Chinese": "原来如此，是希望自己的外表得到认可的心情呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 19:59:43",
            "content": "そうですね認められたらなんか報われる気がするんです",
            "Chinese": "是的，如果被认可，总觉得会有所回报、被安慰。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:00:47",
            "content": "ええ人から認められたいお気持ち、人間はみんな持っているものだと思います",
            "Chinese": "嗯嗯，希望得到他人认可的心情，我觉得是每个人都会有的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:00:56",
            "content": "はい、そうですよね",
            "Chinese": "是的，是这样呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:02:19",
            "content": "ええ周りの方はあなたの見た目に対して、実際になにかをあなたに伝えることはありますか？",
            "Chinese": "嗯嗯，周围的人实际上有对您的外表说过些什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:02:41",
            "content": "そうですね",
            "Chinese": "嗯，有的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:02:45",
            "content": "可愛いとか褒められることはあります",
            "Chinese": "有时候会被夸奖说可爱之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:03:17",
            "content": "そうなのですねそのときはどのようなお気持ちですか？",
            "Chinese": "是这样啊，那个时候您是什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:03:28",
            "content": "すごく嬉しいです",
            "Chinese": "非常开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:04:27",
            "content": "なるほどですねあなたのことを褒めてくれる方があなたの周りにいらっしゃるのですね",
            "Chinese": "原来如此，您的身边有会夸奖您的人呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:04:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:04:42",
            "content": "褒められたくて",
            "Chinese": "为了被夸奖，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:04:46",
            "content": "外見は努力してます",
            "Chinese": "我在外表上下了功夫。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:05:58",
            "content": "ご自身で努力もされているのですね素晴らしいと思います",
            "Chinese": "您自己也在努力呢，我觉得这很了不起。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:06:12",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:07:03",
            "content": "ただ",
            "Chinese": "但是，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:07:13",
            "content": "なんか過度に努力しすぎだなって",
            "Chinese": "总觉得自己好像努力得有点过头了，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:07:20",
            "content": "好きな自分でいるための努力ではなく",
            "Chinese": "不是为了成为自己喜欢的样子而努力，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:07:27",
            "content": "人からよく思われるための努力は",
            "Chinese": "而是为了让别人对自己有好感而努力，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:07:32",
            "content": "しんどいですね",
            "Chinese": "感觉很累。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:08:00",
            "content": "そのようなお考えもお持ちなのですね",
            "Chinese": "您也有这样的想法啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:08:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:08:33",
            "content": "気にしなくなりたいんですけど",
            "Chinese": "我想变得不那么在意，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:08:53",
            "content": "気にしなくなるのが怖いのかもしれないです",
            "Chinese": "但也许我又害怕自己真的不在意了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:09:17",
            "content": "ええそうなのですね",
            "Chinese": "嗯嗯，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:09:28",
            "content": "誰も私のこと認めてくれない気がして",
            "Chinese": "感觉那样就没有人会认可我了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:10:06",
            "content": "ええそういったお気持ちなのですね",
            "Chinese": "嗯嗯，您是这样的心情啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:10:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:12:01",
            "content": "いま話を聞いていて、あなたは今までそのようなお気持ちを抱えながら頑張ってこられたのだなと感じました",
            "Chinese": "听您这样说，我感觉到您一直带着这些感受努力地走过来。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:12:20",
            "content": "はい、そうですね",
            "Chinese": "是的，是这样呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:13:34",
            "content": "あなたは自分自身で自分を認めたい、というお気持ちがあるように思いますが、いかがですか？",
            "Chinese": "我感觉您似乎有种“想要自己认可自己”的心情，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:13:56",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:14:00",
            "content": "それはあると思います",
            "Chinese": "我觉得是有的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:14:04",
            "content": "そしたら楽だろうなって",
            "Chinese": "那样的话应该会轻松很多吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:14:34",
            "content": "ええそのように思っておられるのですね",
            "Chinese": "嗯嗯，您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:14:37",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:16:24",
            "content": "では私の考えをお伝えしてもよろしいですか？",
            "Chinese": "那么，我可以分享一下我的想法吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:16:36",
            "content": "はい、何でしょうか",
            "Chinese": "好的，您请说。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:18:29",
            "content": "ここまでのお話を聞かせていただいて、一番大事だと思ったのはあなたがあなたを好きになって、",
            "Chinese": "听了您刚才的话，我觉得最重要的是您要喜欢上您自己，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:19:21",
            "content": "自分らしく生きることがあなたの幸せのための一歩になるのかなとわたしは感じました、",
            "Chinese": "活出自我，这或许会成为您迈向幸福的一步，我是这么感觉的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:19:32",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:19:35",
            "content": "自分のことは",
            "Chinese": "关于我自己，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:19:37",
            "content": "好きなんです",
            "Chinese": "我其实是喜欢的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:19:42",
            "content": "ただ",
            "Chinese": "只是，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:19:50",
            "content": "あ、あと",
            "Chinese": "啊，还有，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:19:55",
            "content": "ええ",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:19:58",
            "content": "自分らしくも生きてはいるんです",
            "Chinese": "我也的确在以自己的方式生活。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:20:59",
            "content": "そうなのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:21:16",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:22:19",
            "content": "いま周りにいるひともあなたのことを好きでいてくれているのではないのでしょうか？",
            "Chinese": "现在在您身边的人，不也是喜欢着您的吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:22:53",
            "content": "どうなんでしょう、聞いたことはないので分からないです",
            "Chinese": "这个怎么样呢，我没问过所以不知道。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:23:41",
            "content": "ただ、",
            "Chinese": "不过，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:23:46",
            "content": "自分が自分の見た目を",
            "Chinese": "我把自己的外表"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:23:52",
            "content": "存在価値にしてしまってるのが",
            "Chinese": "当成了自己的存在价值，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:23:56",
            "content": "悲しいなとは思います",
            "Chinese": "我觉得这挺让人难过的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:24:18",
            "content": "ええそのような思いもあるのですね",
            "Chinese": "嗯嗯，您也有这样的想法啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:24:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:25:41",
            "content": "あなたはあなたの為に努力もできるし、大事にできる",
            "Chinese": "您能够为了自己而努力，也能够珍惜自己，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:26:12",
            "content": "見た目でないところも魅力がたくさんあるように思いますよ",
            "Chinese": "我觉得您在外表之外的地方也有很多魅力哦。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:26:26",
            "content": "そうですね、、",
            "Chinese": "是啊……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:26:37",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:28:16",
            "content": "ええ今日は話してみて少しでもお役に立てましたでしょうか？",
            "Chinese": "嗯，今天聊下来，有没有对您哪怕一点点帮助呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:28:29",
            "content": "そうですね、少し整理はできました",
            "Chinese": "是的，我稍微整理了一下思绪。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/19(木) 20:28:31",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/19(木) 20:30:16",
            "content": "こちらこそ大切なお話をありがとうございます。簡単なお悩みでないと思いますので、またいつでもご相談にいらしてくださいね",
