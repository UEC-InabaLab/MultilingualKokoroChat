{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 15:57:28",
            "content": "こんにちは！宜しくお願いします",
            "Chinese": "您好！请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 15:57:59",
            "content": "こんにちは、相談員ですよろしくお願いします",
            "Chinese": "您好，我是咨询师，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 15:58:25",
            "content": "はい、お願いします",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 15:58:43",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 15:59:12",
            "content": "子供達の事で心配があります",
            "Chinese": "我有些担心我的孩子们。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 15:59:49",
            "content": "はい、お子様のご相談ですね、とても大切なことですよね",
            "Chinese": "好的，是关于您孩子的事啊，这确实是非常重要的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:00:08",
            "content": "どのような、、",
            "Chinese": "具体是怎样的……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:00:21",
            "content": "ことか、具体的にお聞かせいただけますか？",
            "Chinese": "能否请您具体说一下呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:01:04",
            "content": "はい、3月頃からコロナの影響で情緒が不安定になってしまったきがします",
            "Chinese": "是的，我觉得从3月左右开始，受新冠疫情的影响，他们的情绪变得有些不稳定了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:02:04",
            "content": "はい、それは心配なことです。具体的にはどなたがでしょうか？",
            "Chinese": "嗯，这确实很令人担心。具体是哪一位孩子呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:02:47",
            "content": "私には高校3年の受験を控えた男の子と、大学4年の娘がおりますが",
            "Chinese": "我有一个即将参加高三升学考试的儿子，和一个上大四的女儿。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:03:08",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:04:08",
            "content": "就職活動につまずき、大学院に進む事を決めた娘は部屋にこもりきりで、人と会いたがりませんし、",
            "Chinese": "在求职中受挫、决定读研究生的女儿，一直把自己关在房间里，也不愿意见人，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:04:36",
            "content": "なるほど、、すごく心配ですね",
            "Chinese": "原来如此……确实让人很担心。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:05:04",
            "content": "高3の息子も、一学期はリモート授業しか受けておらず、ゲームの毎日です",
            "Chinese": "高三的儿子第一学期也只上了远程课，每天都在玩游戏。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:05:31",
            "content": "受験への意欲は感じられないんです",
            "Chinese": "感觉不到他对升学考试有什么热情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:05:32",
            "content": "なるほど、、息子さんも心配ですね",
            "Chinese": "原来如此，儿子的情况也让人担心啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:05:47",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:06:32",
            "content": "差し支えなければ、ご家族構成教えて頂いても宜しいですか？",
            "Chinese": "如果方便的话，能告诉我一下您的家庭成员构成吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:07:41",
            "content": "主人、私、娘、息子の4人家族です。最近、娘の希望で犬を飼い始めました",
            "Chinese": "我们家是四口人：丈夫、我、女儿和儿子。最近，应女儿的要求，我们开始养狗了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:08:04",
            "content": "ありがとうございます。ワンちゃんいいですね！",
            "Chinese": "谢谢您。有只小狗真好啊！"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:08:24",
            "content": "はい、世話は大変ですが可愛いです",
            "Chinese": "是的，虽然照顾起来很辛苦，但它很可爱。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:08:47",
            "content": "癒されますよね＾＾",
            "Chinese": "很治愈，对吧？＾＾"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:08:53",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:08:57",
            "content": "さて、娘さんですが、",
            "Chinese": "那么，关于您的女儿，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:09:22",
            "content": "3月くらいから変化無いかんじですか？",
            "Chinese": "是从3月左右开始就一直这样，没什么变化吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:09:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:09:33",
            "content": "いいえ",
            "Chinese": "也不是。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:09:42",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:09:44",
            "content": "それまで色々ありました",
            "Chinese": "在那之前发生了很多事。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:09:49",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:10:20",
            "content": "教えて頂いてもよろしいですか？",
            "Chinese": "方便的话，能跟我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:10:26",
            "content": "3年生までは就職活動をしていましたが",
            "Chinese": "她到大三为止一直在进行求职活动，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:10:36",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:10:51",
            "content": "リモート面談で酷く傷つき",
            "Chinese": "但是在远程面试中受到了严重的打击，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:10:58",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:11:35",
            "content": "人生感が変わるくらいの衝撃を受けたようです",
            "Chinese": "她似乎受到了足以改变人生观的冲击。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:12:07",
            "content": "そんな衝撃的なことがあったのですか・・・",
            "Chinese": "竟然发生了那样令人震惊的事啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:12:15",
            "content": "リモート面談では、自分の内面な本心や、",
            "Chinese": "在远程面试中，关于自己内心的真实想法，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:12:24",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:12:46",
            "content": "社会への感覚の自身の考えの甘さ",
            "Chinese": "以及自己对社会看法的天真，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:13:01",
            "content": "はい・・・",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:13:25",
            "content": "そしてモラハラな態度の3つを経験したようです",
            "Chinese": "以及对方精神霸凌般的态度，她似乎都经历了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:14:09",
            "content": "そうなんですか、そんなにも・・・お母様としても心配ですね・・・",
            "Chinese": "是这样啊，经历了这么多……作为母亲，您一定很担心吧……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:14:25",
            "content": "また、付き合っている彼がコロナで心を病んでおり",
            "Chinese": "另外，她正在交往的男朋友因为疫情，心理上出了些问题，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:14:39",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:14:55",
            "content": "異常な程のアルコール消毒や",
            "Chinese": "他会过度地用酒精消毒，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:15:03",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:15:24",
            "content": "ソーシャルディスタンスを求めるのです",
            "Chinese": "还要求保持社交距离。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:15:31",
            "content": "なるほど、、",
            "Chinese": "原来如此……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:15:48",
            "content": "心の支えが必要な時に",
            "Chinese": "在需要心灵支柱的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:15:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:16:11",
            "content": "大変心を痛めてしまったようなんです",
            "Chinese": "她似乎因此感到非常痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:16:28",
            "content": "そうですか、",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:16:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:16:46",
            "content": "とても心配ですよね",
            "Chinese": "确实很让人担心呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:16:52",
            "content": "ええ",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:17:00",
            "content": "これだけいろんな事が重なって、",
            "Chinese": "这么多事情都赶在一起，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:17:29",
            "content": "娘さんもすごく傷ついてらっしゃんじゃないでしょうか？",
            "Chinese": "您的女儿也一定受到了很大的伤害吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:17:36",
            "content": "だから、",
            "Chinese": "所以，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:17:44",
            "content": "多分そうです",
            "Chinese": "大概是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:17:48",
            "content": "情緒不安定なのですね",
            "Chinese": "情绪才会变得不稳定啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:18:03",
            "content": "お母様はいま、どんなお気持ちですか？",
            "Chinese": "作为母亲，您现在是什么心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:18:55",
            "content": "しかし、彼女は私にもそれを隠し人に感情をぶつけて自身を癒すことをしない子です",
            "Chinese": "但是，她是个连我都会隐瞒，不会通过向别人发泄情绪来治愈自己的孩子。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:19:16",
            "content": "そうなんでか・・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:19:26",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:19:48",
            "content": "どのような感じですか？",
            "Chinese": "具体是什么样的情况呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:19:51",
            "content": "なので、余計に心配なのです",
            "Chinese": "所以，我才更加担心。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:20:05",
            "content": "なるほど、、",
            "Chinese": "原来如此……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:20:15",
            "content": "とても心配ですよね",
            "Chinese": "真的很让人担心呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:20:22",
            "content": "私に甘えて当たり散らすことをせず",
            "Chinese": "她不会对我撒娇或者乱发脾气，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:20:29",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:20:44",
            "content": "自分だけで解決しようとする子です",
            "Chinese": "是个什么事都想靠自己解决的孩子。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:21:09",
            "content": "なので、ひたすら部屋で一人で過ごすそうです",
            "Chinese": "所以，她就一直一个人待在房间里。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:21:18",
            "content": "そうなんですね、、ご家族に甘えてくれても、、って思いますよね",
            "Chinese": "是这样啊，您会想“要是能对家人撒撒娇就好了”，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:21:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:21:48",
            "content": "その方が助かるのですが",
            "Chinese": "那样我反倒能放心一些，可是……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:22:00",
            "content": "ダメなんですね",
            "Chinese": "她就是做不到呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:22:04",
            "content": "お母様からは、娘さんにどのように接してらっしゃるんですか？",
            "Chinese": "那您平时是怎么和女儿相处的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:22:34",
            "content": "なるべく笑顔で普通な話しをしたり",
            "Chinese": "我尽量带着笑容和她聊些平常的话题，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:22:41",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:22:58",
            "content": "犬の事で笑ったり",
            "Chinese": "聊聊小狗，一起笑一笑，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:23:03",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:23:29",
            "content": "さりげなく過ごすように心がけています",
            "Chinese": "我努力和她自然地相处。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:23:39",
            "content": "それしかできません",
            "Chinese": "我也只能做到这些了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:23:52",
            "content": "なるほど、、そうような感じなのですね",
            "Chinese": "原来如此，您是这样做的呀。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:24:18",
            "content": "ちなみに、以前まではどのような感じだったのでしょうか？",
            "Chinese": "顺便问一下，她以前是什么样的状态呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:24:19",
            "content": "彼女にとってはそれが一番楽なのではと考えています",
            "Chinese": "我想对她来说，这样做可能是最轻松的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:24:42",
            "content": "（すいません被りました）",
            "Chinese": "（不好意思，我的问题和您的话题重叠了）"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:24:42",
            "content": "就職活動に意欲的でキラキラしていました",
            "Chinese": "她对求职充满热情，整个人都闪闪发光。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:24:53",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:25:11",
            "content": "自信に満ちていました",
            "Chinese": "充满了自信。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:25:18",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:25:24",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:25:34",
            "content": "他には？",
            "Chinese": "还有其他的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:26:08",
            "content": "今はすっかり、自信を無くしています",
            "Chinese": "现在却完全失去了自信。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:26:16",
            "content": "はい・・・",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:26:40",
            "content": "やはり、就活の一件と、彼氏の対応からでしょうか？",
            "Chinese": "果然还是因为求职那件事，以及她男朋友的应对方式吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:27:32",
            "content": "リモート面談で散々な態度を取られたらしいんです。それに、彼に距離を取られる孤独感かと思われます。",
            "Chinese": "好像是在远程面试时被对方用很糟糕的态度对待了。此外，我想还有被男朋友疏远所带来的孤独感。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:27:55",
            "content": "なるほど、、辛いですね・・・",
            "Chinese": "原来如此……真是令人难受啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:28:01",
            "content": "ええ",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:28:13",
            "content": "心配です",
            "Chinese": "我很担心。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:28:16",
            "content": "それは、娘さんがそうおっしゃてたんですか？",
            "Chinese": "这些是您的女儿亲口说的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:28:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:28:48",
            "content": "彼のことは推測です",
            "Chinese": "关于她男朋友的事是我的推测。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:28:59",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:28:59",
            "content": "感情として",
            "Chinese": "从情感上来说，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:29:04",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:29:47",
            "content": "そんな時にはまるごとつ包んでくれる存在が必要と考えますから",
            "Chinese": "因为我觉得在那种时候，需要一个能全身心包容自己的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:29:56",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:32:11",
            "content": "そうですよね、そういう存在の方、大切ですよね",
            "Chinese": "是啊，那样的存在非常重要。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:32:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:33:05",
            "content": "さて、",
            "Chinese": "那么，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:33:26",
            "content": "息子さんのお話もお聞かせ頂いても宜しいでしょうか？",
            "Chinese": "可以也请您说说关于您儿子的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:33:33",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:34:22",
            "content": "息子は高校では優秀な理系の特別クラスに入りましたが",
            "Chinese": "我儿子在高中进入了优秀的理科特长班，但是"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:34:30",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:34:38",
            "content": "その環境に馴染めず",
            "Chinese": "他无法融入那个环境，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:34:44",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:35:05",
            "content": "クラスでの成績は最下位です",
            "Chinese": "在班里的成绩是垫底的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:35:12",
            "content": "はい・・・",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:35:22",
            "content": "心配ですね・・・",
            "Chinese": "真让人担心啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:35:50",
            "content": "小さな頃からゲーム好きです",
            "Chinese": "他从小就喜欢玩游戏。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:35:56",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:36:26",
            "content": "ゲームへの集中力は凄いです",
            "Chinese": "玩游戏时的专注力非常惊人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:36:38",
            "content": "なるほど、ですね",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:36:58",
            "content": "しかし、大学受験が迫り",
            "Chinese": "但是，大学升学考试临近，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:37:04",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:37:22",
            "content": "現実から逃避していると感じます",
            "Chinese": "我感觉他是在逃避现实。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:37:41",
            "content": "なるほど、、心配ですね・・・",
            "Chinese": "原来如此，确实令人担心……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:37:47",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:37:59",
            "content": "受験控えてるだけに・・・",
            "Chinese": "毕竟马上就要考试了，更是让人担心……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:38:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:38:21",
            "content": "良い大学に入れ無くても",
            "Chinese": "就算考不上好大学，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:38:28",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:38:35",
            "content": "自分で目標を見つけて",
            "Chinese": "我也希望他能自己找到目标，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:38:41",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:38:48",
            "content": "進んで欲しいと",
            "Chinese": "然后积极地前进。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:38:54",
            "content": "考えます",
            "Chinese": "我是这么想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:38:54",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:39:10",
            "content": "そうですよね、親としはそうですよね",
            "Chinese": "是啊，作为父母都是这么想的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:39:17",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:39:29",
            "content": "それは、息子さんには伝えわってますか？",
            "Chinese": "您的这些想法，传达给您儿子了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:39:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:39:45",
            "content": "伝えました",
            "Chinese": "已经告诉他了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:39:54",
            "content": "息子さんは何ておっしゃってますか？",
            "Chinese": "您儿子是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:40:11",
            "content": "行きたい大学は決まっていると",
            "Chinese": "他说想去的大学已经定好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:40:22",
            "content": "なつほど、、",
            "Chinese": "原来如此……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:40:25",
            "content": "言います",
            "Chinese": "他是这么说的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:40:40",
            "content": "目標の大学はある、感じなのですね",
            "Chinese": "也就是说，他是有目标大学的，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:40:47",
            "content": "しかし、行動が伴っていません",
            "Chinese": "但是，他的行动跟不上。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:41:05",
            "content": "なるほど・・・",
            "Chinese": "原来如此……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:41:16",
            "content": "ゲームばかりしているように見えます",
            "Chinese": "在我看来，他只是成天在玩游戏。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:41:28",
            "content": "そうですか・・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:41:46",
            "content": "心配ですよね",
            "Chinese": "确实很令人担心。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:42:05",
            "content": "塾の先生や学校の先生からも、このままではまずいと聞いています",
            "Chinese": "我也听补习班的老师和学校的老师说了，再这样下去就不妙了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:42:18",
            "content": "なるほど、、",
            "Chinese": "原来如此……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:42:36",
            "content": "もう8月ですからね、焦ってきますよね",
            "Chinese": "毕竟已经是八月了，难免会着急起来呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:42:53",
            "content": "やりたい事が本心ななのか",
            "Chinese": "他想做的事情到底是不是真心的，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:43:01",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:43:28",
            "content": "疑問ですし、甘えているとも取れます",
            "Chinese": "我对此抱有疑问，也可以看作是他在依赖、撒娇。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:43:53",
            "content": "そうですか、、以前はどんな感じだったのでしょうか？",
            "Chinese": "是这样啊……那他以前是什么样子的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:44:54",
            "content": "前からゲームすですが、中学受験である程度頑張り、成績はそこそこ良かったですね",
            "Chinese": "他以前就喜欢玩游戏，但在小升初考试时也算努力过，成绩还算不错。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:45:07",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:45:09",
            "content": "ゲーム好きです",
            "Chinese": "喜欢玩游戏。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:45:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:45:47",
            "content": "コロナのリモート授業が彼にとっては楽みたいです",
            "Chinese": "新冠疫情期间的网课对他来说似乎很轻松。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:45:47",
            "content": "ゲームと勉強の両立ができる息子さんだったのですね",
            "Chinese": "也就是说，您的儿子曾经是个能兼顾游戏和学习的孩子，是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:46:02",
            "content": "なるほど、、リモートが",
            "Chinese": "原来如此……远程授课……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:46:03",
            "content": "それなりに",
            "Chinese": "算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:46:09",
            "content": "楽",
            "Chinese": "很轻松。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:46:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:46:15",
            "content": "はい、、",
            "Chinese": "好的……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:46:31",
            "content": "すいません、遮ってしまい",
            "Chinese": "不好意思，打断您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:46:41",
            "content": "どうぞ！お話しください",
            "Chinese": "请继续，您请说。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:47:16",
            "content": "私は息子に後悔の無い人生を歩んで欲しいのです",
            "Chinese": "我希望儿子能过上不留遗憾的人生。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:47:24",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:47:37",
            "content": "まだ、未熟な彼には",
            "Chinese": "对于还不够成熟的他来说，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:47:43",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:48:10",
            "content": "大学受験の大切さや",
            "Chinese": "大学升学考试的重要性，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:48:15",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:48:52",
            "content": "学歴がどれだけ人生ん前向きにするものかを",
            "Chinese": "以及学历对人生的积极影响有多大，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:49:00",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:49:15",
            "content": "知ることは出来ていないと考えます",
            "Chinese": "我认为他还没有意识到这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:49:24",
            "content": "なるほど、、",
            "Chinese": "原来如此……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:49:41",
            "content": "私の価値観ではありますが、、、",
            "Chinese": "虽然这只是我的价值观……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:49:53",
            "content": "そうですか、、",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:49:57",
            "content": "そう考えてしまうのです",
            "Chinese": "我就是会这么想。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:50:14",
            "content": "お父様は何とおっしゃってますか？",
            "Chinese": "那孩子的父亲是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:50:50",
            "content": "主人とは全くコミュニケーションはとれない関係です",
            "Chinese": "我和丈夫是完全无法沟通的关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:51:01",
            "content": "ええ",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:51:05",
            "content": "子育てに興味は無く",
            "Chinese": "他对育儿不感兴趣，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/10(月) 16:51:12",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/10(月) 16:51:46",
            "content": "子供については、ほとんど私一人で考えて育ててきた感があります",
            "Chinese": "关于孩子，我感觉几乎是我一个人在思考和抚养他们长大的。"
        },
        {
