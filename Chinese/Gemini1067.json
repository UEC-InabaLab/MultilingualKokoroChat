{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:01:19",
            "content": "こんにちは。カウンセラーの相談員です。よろしくお願いいたします。",
            "Chinese": "您好。我是心理咨询师。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:01:34",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:01:48",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您有什么想咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:01:55",
            "content": "学校いきたくない",
            "Chinese": "我不想去上学。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:02:29",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:03:06",
            "content": "学校で何か嫌なことがあったのでしょうか？話せるところから教えていただいてもいいですか。",
            "Chinese": "是在学校发生了什么不愉快的事情吗？可以从您愿意说的部分开始告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:03:23",
            "content": "いろいろ",
            "Chinese": "各种各样的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:03:32",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:04:04",
            "content": "今日も学校に行きたくない気持ちなんですね。",
            "Chinese": "所以今天您还是不想去学校，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:04:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:04:32",
            "content": "そういう気持ちになってどのくらいになりますか？",
            "Chinese": "这种心情持续多久了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:04:51",
            "content": "4月から",
            "Chinese": "从四月开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:05:18",
            "content": "長いこと辛い気持ちを抱えてきたんですね。",
            "Chinese": "您一直承受着这样痛苦的心情很久了呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:05:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:05:30",
            "content": "それは苦しかったですね。",
            "Chinese": "那一定很痛苦吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:06:34",
            "content": "どんなことがあったのか少し教えていただいてもいいですか？",
            "Chinese": "可以稍微告诉我发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:06:56",
            "content": "くらすでボッチ",
            "Chinese": "在班里孤零零的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:08:09",
            "content": "そうだったんだ。ボッチというのはもしかしたらクラスでひとりボッチだったということかな？",
            "Chinese": "原来是这样啊。您说的“ボッチ”，是指在班上总是自己一个人的意思吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:08:25",
            "content": "そーです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:08:40",
            "content": "そうだんたんだ。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:09:15",
            "content": "そのことをお母さんとかには話してみた？",
            "Chinese": "这件事有跟妈妈他们说过吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:09:24",
            "content": "話してない",
            "Chinese": "没说过。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:10:07",
            "content": "今までだれにもそのことを話したことはないの？",
            "Chinese": "到现在为止，你都没有跟任何人说过这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:10:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:10:52",
            "content": "そうだったんだ。長い事一人で苦しんできたんですね。",
            "Chinese": "原来是这样。您一个人承受了这么久的痛苦啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:10:58",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:11:34",
            "content": "4月から一人ぼっちを抱えてきたとのお話しだけれど、学校には行けていたのかしら？",
            "Chinese": "您说从4月开始就一直是一个人，那这段时间还坚持去学校了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:11:56",
            "content": "行ってる",
            "Chinese": "有去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:12:15",
            "content": "そうだったんだ。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:12:47",
            "content": "よく通ってきましたね。そのことはすごいと思いますよ。",
            "Chinese": "您一直坚持去上学，真的很不容易。我觉得这很了不起。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:13:17",
            "content": "すごくない",
            "Chinese": "没什么了不起的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:13:58",
            "content": "なるほどそうおもうんですね。ひとりボッチだったとのお話しだけど、お休み時間とは、どうしていたの？",
            "Chinese": "原来您是这么想的啊。您说在班上是一个人，那课间休息的时候是怎么过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:14:12",
            "content": "ボッチ",
            "Chinese": "还是一个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:14:42",
            "content": "そうなんだね。ひとりでどんな風に休み時間を過ごしていたのかな？",
            "Chinese": "是这样啊。那您一个人是怎么度过课间休息的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:14:58",
            "content": "何もしてない",
            "Chinese": "什么都没做。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:15:15",
            "content": "そうだんだ。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:15:28",
            "content": "ただ一人で過ごしていたんですね。",
            "Chinese": "就只是一个人待着，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:15:35",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:15:53",
            "content": "それはとってもさびしかったんじゃないかな。",
            "Chinese": "那一定非常寂寞吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:16:05",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:16:49",
            "content": "そうだよね。あなたとしては、どんな風になったらいいなと思っているのかな？",
            "Chinese": "是啊。那您希望情况能变成什么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:17:04",
            "content": "どうにもならない",
            "Chinese": "改变不了的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:17:41",
            "content": "ということは、ご自分なりには、なにかやってみたことがあるということ？",
            "Chinese": "这么说，您自己也尝试过做些什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:18:00",
            "content": "なにもできない",
            "Chinese": "什么都做不到。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:18:23",
            "content": "そんな思いなんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:18:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:18:58",
            "content": "どんなことから、「なんにもできない」って思っているのかな？",
            "Chinese": "您是从哪些事情上，觉得自己“什么都做不到”的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:19:42",
            "content": "なにもできないから",
            "Chinese": "因为什么都做不到。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:19:54",
            "content": "そうなんだ。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:20:42",
            "content": "ちなみに学年を教えていただけますか？",
            "Chinese": "顺便问一下，方便告诉我您现在是几年级吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:20:52",
            "content": "中１",
            "Chinese": "初一。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:21:09",
            "content": "そうなんだ。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:21:35",
            "content": "それでは去年までは、小学校ではどうでしたか？",
            "Chinese": "那么，去年之前您在小学的时候怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:21:50",
            "content": "楽しかった",
            "Chinese": "很开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:22:34",
            "content": "もしかして、中学に入ったら、去年小６までの友達は周りに誰もいなくなってしまったのかな？",
            "Chinese": "是不是上了初中以后，小学时的朋友就都不在身边了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:22:43",
            "content": "そう",
            "Chinese": "是这样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:23:11",
            "content": "そうだったんだ。それは戸惑うの無理ないよね。",
            "Chinese": "原来是这样啊。那您会感到不知所措也是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:23:18",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:24:10",
            "content": "中学は今までの小学校よりだいぶ離れた地域にあるのかな？",
            "Chinese": "您的初中是不是比之前的小学远很多呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:24:40",
            "content": "離れてない",
            "Chinese": "不远。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:24:57",
            "content": "そうなんだ。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:25:58",
            "content": "中学では部活とかあるかと思うけど部活はどうしていますか？",
            "Chinese": "我想初中应该有社团活动吧，您参加了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:26:13",
            "content": "帰宅部",
            "Chinese": "没有参加，放学就回家。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:26:34",
            "content": "なるほど。そうなんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:27:44",
            "content": "さきほど何もできないというお話しでしたけれど、休み時間に何かひとりでもできることが見つかるといいですね。",
            "Chinese": "您刚才说自己什么也做不了，但如果在休息时间能找到一件即使一个人也能做的事情，那就好了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:28:15",
            "content": "何かやってなきゃダメ？",
            "Chinese": "一定得做点什么吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:28:50",
            "content": "ご自分が楽にしていられるなら、何でもいいと思いますよ。",
            "Chinese": "只要能让您自己感到轻松自在，做什么都可以的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:29:20",
            "content": "気配けすだけで精一杯",
            "Chinese": "光是尽量降低存在感就已经竭尽全力了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:29:40",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:30:24",
            "content": "ひっそりとしていたいんですね。",
            "Chinese": "您是想安安静静地待着，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:30:43",
            "content": "していたいわけじゃない",
            "Chinese": "我并不是想这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:31:23",
            "content": "そうだよね。",
            "Chinese": "也是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:31:39",
            "content": "そうするしかないということなんだよね。",
            "Chinese": "您是觉得只能那样做吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:31:48",
            "content": "そう",
            "Chinese": "是这样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:33:30",
            "content": "そんなつらい気持ちを誰かに聞いてもらえたら少し楽になるのではないかと思うけどどうかな？",
            "Chinese": "我觉得，如果能把这样痛苦的心情说给谁听听，也许会好受一些，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:33:47",
            "content": "どうせわかってもらえない",
            "Chinese": "反正他们也不会懂。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:34:06",
            "content": "そう思うんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:34:53",
            "content": "もしかしたら、スクールカウンセラーとか保健室の先生とはか、そういう気持ちを聞いてくれるんじゃないかと思うけど、どうかな？",
            "Chinese": "或许学校的心理咨询师，或者保健室的老师，会愿意倾听您的这些感受，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:35:05",
            "content": "無理",
            "Chinese": "不可能。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:35:37",
            "content": "そんな気持ちなんですね。",
            "Chinese": "您是这样的心情啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:35:52",
            "content": "でも今日はここに来てくれてありがとう。",
            "Chinese": "不过，谢谢您今天能来这里。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:36:23",
            "content": "あなたの辛い気持ちを聞かせていただきました。",
            "Chinese": "感谢您向我倾诉了您痛苦的心情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:37:10",
            "content": "そろそろお時間なので今日は終了となりますが、またいらしてください。",
            "Chinese": "时间差不多了，今天就到这里结束。欢迎您下次再来。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:37:37",
            "content": "ここで終了とさせていただきますね。",
            "Chinese": "那我们就在这里结束吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:38:19",
            "content": "終了でよろしいでしょうか？",
            "Chinese": "这样结束可以吗？"
        }
    ],
