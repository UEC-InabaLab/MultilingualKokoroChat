    {
      "role": "client",
      "time": "2022-05-29T15:18:48",
      "origin": "よくわからないんです",
      "content": "我也不太清楚。"
    },
    {
      "role": "client",
      "time": "2022-05-29T15:19:05",
      "origin": "いきなり自分ターゲットにされて",
      "content": "突然之间我就成了她的目标。"
    },
    {
      "role": "counselor",
      "time": "2022-05-29T15:19:12",
