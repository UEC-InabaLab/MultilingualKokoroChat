    {
      "role": "client",
      "time": "2022-05-29T15:23:33",
      "origin": "悲しいです",
      "content": "很难过。"
    },
    {
      "role": "counselor",
      "time": "2022-05-29T15:23:55",
      "origin": "そうですよね。",
      "content": "是啊。"
    },
    {
      "role": "client",
      "time": "2022-05-29T15:24:49",
