{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 17:51:28",
            "content": "こんにちは今日はよろしくお願いいたします。",
            "Chinese": "您好，今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 17:52:16",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 17:53:43",
            "content": "お時間少し早いですが、始めさせて頂いてよろしいでしょうか？時間どおりの方がよろしいですか？",
            "Chinese": "现在比预定时间早一些，我们可以现在开始吗？还是您希望准时开始？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 17:54:26",
            "content": "どちらでも構いません。お任せします。",
            "Chinese": "都可以，听您的安排。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 17:55:00",
            "content": "ありがとございます。では、はじめさせてください。",
            "Chinese": "谢谢您。那我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 17:55:09",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 17:55:24",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 17:55:48",
            "content": "こんにちは、相談員ですよろしくお願いいたします",
            "Chinese": "您好，我是咨询师，请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 17:55:56",
            "content": "お願いいたします。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 17:56:50",
            "content": "よろしければニックネームでかまいませんので、なんとお呼びすれば良いか教えていただけますか？",
            "Chinese": "如果方便的话，用昵称也可以，能告诉我该如何称呼您吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 17:57:15",
            "content": "みどりと申します。",
            "Chinese": "我叫绿。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 17:57:23",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 17:57:52",
            "content": "みどりさん、今日はどのようなご相談でしょうか？",
            "Chinese": "绿女士，今天想就什么问题进行咨询呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 17:58:51",
            "content": "結婚式を控えていたのですが、キャンセルになり、結婚することを考え直しています。",
            "Chinese": "我本来准备要办婚礼了，但是取消了，现在正在重新考虑结婚这件事。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 17:59:33",
            "content": "色々考えていると何が良いのか",
            "Chinese": "越想越不确定什么才好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 17:59:45",
            "content": "ご結婚式がキャンセルですか・・・どのような事でキャンセルになられたのですか？",
            "Chinese": "婚礼取消了啊……请问是因为什么原因取消的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:00:35",
            "content": "コロナが原因で式場はキャンセルしました。",
            "Chinese": "因为新冠疫情的原因，我们取消了婚礼场地。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:00:53",
            "content": "入籍はしていません。",
            "Chinese": "我们还没有登记结婚。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:01:28",
            "content": "そうでしたかそれでキャンセルを機に色々お考え始めてらっしゃるのですね",
            "Chinese": "原来是这样啊。所以您就以取消婚礼为契机，开始考虑各种事情了是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:01:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:02:20",
            "content": "重要な決断をなさろうとしていらっしゃるわけですね・・",
            "Chinese": "您现在正准备做一个很重要的决定呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:02:42",
            "content": "そういうことになりますね。",
            "Chinese": "可以这么说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:03:28",
            "content": "お迷いになれていらっしゃるのは具体的にどのようなことなのですか？",
            "Chinese": "具体来说，您在犹豫些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:04:12",
            "content": "私の仕事はこれまでどおりなのですが",
            "Chinese": "我的工作和以前一样，没什么变化。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:04:22",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:04:42",
            "content": "彼の仕事がガラっと変わってしまい",
            "Chinese": "但是他的工作发生了翻天覆地的变化。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:04:50",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:06:05",
            "content": "彼のお母様が体調を崩し入院してしまい",
            "Chinese": "他母亲身体不适住院了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:06:14",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:06:36",
            "content": "この数ヶ月で色々な状況が変わってしまい",
            "Chinese": "这几个月里，各种情况都发生了变化。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:06:44",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:07:19",
            "content": "彼を支えていけるのかが一番の不安です",
            "Chinese": "我最不安的是，我是否能支持他走下去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:07:55",
            "content": "そうだったのですねそれは大きな出来事の変化が大変ですね",
            "Chinese": "原来是这样啊。发生这么大的变故，真是辛苦您了。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:08:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:08:58",
            "content": "彼氏さんのお仕事の変化は、職場や収入などがお迷いの原因ですか？",
            "Chinese": "关于他工作的变化，是职场环境或收入等问题让您犹豫吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:09:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:10:11",
            "content": "収入の面を考えると不安になるのは当然ですよね",
            "Chinese": "考虑到收入问题，感到不安是很自然的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:10:28",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:10:56",
            "content": "転職も考えているようですが",
            "Chinese": "他好像也在考虑换工作。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:11:17",
            "content": "厳しそうですし",
            "Chinese": "但看起来不太容易。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:11:26",
            "content": "そうでしたか彼氏さんも悩みどころなのですね",
            "Chinese": "这样啊，看来您男朋友也很烦恼呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:11:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:11:56",
            "content": "因みに、",
            "Chinese": "顺便问一下，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:12:02",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:12:32",
            "content": "彼氏さんのお母さまの看護などには関わられておられるのですか？",
            "Chinese": "您有参与照顾他母亲吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:12:57",
            "content": "それも",
            "Chinese": "这方面也是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:13:02",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:13:52",
            "content": "まだ結婚していない状況でどこまで関わったら良いのか",
            "Chinese": "在还没结婚的情况下，我不知道该介入到什么程度才合适，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:14:06",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:14:19",
            "content": "病院には行けないのですが",
            "Chinese": "我不能去医院探望。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:14:27",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:15:18",
            "content": "彼のお父様がお一人で暮らしていますので、そちらも心配です。",
            "Chinese": "他父亲一个人生活，我也很担心他那边。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:15:57",
            "content": "そうでしたか本当に色々と考えてしまうことばかりですね",
            "Chinese": "这样啊，确实有太多需要操心的事了。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:16:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:16:30",
            "content": "彼の妹が",
            "Chinese": "他的妹妹……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:16:41",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:16:51",
            "content": "よくやっていると思います",
            "Chinese": "我觉得她做得很好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:17:26",
            "content": "それはよい親子関係でよかったですね",
            "Chinese": "那真是太好了，看来他们家人之间的关系很不错。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:17:37",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:18:03",
            "content": "彼氏さんとはお付き合いして何年くらいなのですか？",
            "Chinese": "您和男朋友交往多久了？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:18:29",
            "content": "3年くらいです",
            "Chinese": "大概3年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:19:25",
            "content": "そうなのですね交際から結婚に至るにはどのような事がきっかけだったのでしょうか？",
            "Chinese": "是这样啊。那从交往到决定结婚，是有什么契机吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:19:41",
            "content": "そうですね",
            "Chinese": "这个嘛……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:19:49",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:21:05",
            "content": "結婚の決め手は一緒にいて自分らしく居られたことです。",
            "Chinese": "决定结婚的关键是，和他在一起时我能做最真实的自己。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:21:58",
            "content": "それは大事なことですよねご自分らしくいられるのは素敵です",
            "Chinese": "这很重要呢。能够做真实的自己，真的很棒。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:22:26",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:22:31",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:22:48",
            "content": "結婚して彼の仕事を手伝う予定でした",
            "Chinese": "我本来计划结婚后帮他打理工作上的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:23:20",
            "content": "そうだったのですねですが、転職なさってしまった・・・",
            "Chinese": "原来如此，不过他可能要转职了……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:24:09",
            "content": "転職は考え中です",
            "Chinese": "他还在考虑换工作。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:24:29",
            "content": "私も今の仕事は辞めていません",
            "Chinese": "我也还没辞掉现在的工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:24:57",
            "content": "あ、すみませんでした職場の変化というのは？",
            "Chinese": "啊，抱歉。那么您说的工作环境的变化是指？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:25:09",
            "content": "彼氏さんの",
            "Chinese": "我是指您男朋友的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:25:12",
            "content": "いいえ",
            "Chinese": "不是。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:26:01",
            "content": "コロナで",
            "Chinese": "因为新冠疫情，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:26:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:27:18",
            "content": "お店を改装したり、感染予防対策で人数制限したりといったところです",
            "Chinese": "比如店里重新装修，或者为了防疫限制客流人数之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:27:53",
            "content": "コロナの影響で、職場自体が、ガラッと変わってしまったという事だったのですね",
            "Chinese": "原来是受疫情影响，他工作的环境本身发生了很大变化是吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:28:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:28:31",
            "content": "説明不足ですみません",
            "Chinese": "抱歉，我说明得不够清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:29:00",
            "content": "いえ、こちらの早とちりでした申し訳ないです",
            "Chinese": "不，是我理解错了，很抱歉。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:29:14",
            "content": "彼氏さんとは、",
            "Chinese": "您和您男朋友，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:29:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:29:43",
            "content": "お付き合いの中でどのようなお二人の仲なのでしょうか？",
            "Chinese": "在交往的过程中，你们两位的关系怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:30:42",
            "content": "どのように答えたら良いのか",
            "Chinese": "该怎么回答才好呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:31:03",
            "content": "あいまい過ぎる質問でしたね",
            "Chinese": "是我问得太模糊了。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:31:09",
            "content": "いいえ",
            "Chinese": "不会。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:31:26",
            "content": "お二人は良くお話しはなさりますか？",
            "Chinese": "你们二位经常聊天沟通吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:31:40",
            "content": "そういうことですね",
            "Chinese": "原来是问这个啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:31:52",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:32:06",
            "content": "これまでは何でも話していたと思います",
            "Chinese": "到目前为止，我觉得我们什么都能说。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:32:34",
            "content": "ケンカしたりとかはないです",
            "Chinese": "也没有吵过架之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:32:52",
            "content": "そうですよね彼氏さんのご職場で一緒に働いてもよいと思われたくらいですもの",
            "Chinese": "是啊，毕竟您都考虑到要去他工作的地方一起帮忙了。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:33:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:33:15",
            "content": "結婚式がキャンセルになり",
            "Chinese": "自从婚礼取消后，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:33:21",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:33:28",
            "content": "色々バタバタして",
            "Chinese": "各种事情忙得团团转，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:33:33",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:33:57",
            "content": "ここ数ヶ月は話せていないです",
            "Chinese": "这几个月都没能好好聊聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:34:30",
            "content": "仲がよろしいお二人にとってはお辛い時間でしたね",
            "Chinese": "对关系这么好的你们来说，这段时间一定很煎熬吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:34:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:35:03",
            "content": "忙しくしているのが見えたので",
            "Chinese": "我看到他一直很忙，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:35:29",
            "content": "彼のことです",
            "Chinese": "我是说他。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:35:35",
            "content": "みどりさんが、お気を使われておられたのですね",
            "Chinese": "原来是您在体谅他呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:35:57",
            "content": "そうなりますね",
            "Chinese": "算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:37:36",
            "content": "コロナの事では、色々と地球規模で考えなければならなく本当に辛かったですね普段ならなんでもお話し出来るお二人なのに",
            "Chinese": "关于新冠疫情，全球范围的影响确实让人难受，尤其是对平时无话不谈的你们来说。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:37:45",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:38:09",
            "content": "お二人の、",
            "Chinese": "你们二位的，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:38:16",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:41:06",
            "content": "この3年のお付き合いの月日の中で、彼氏さんの職場の方たちだったり、親御さん、妹さん関りになられて、だからこそお悩みも必然的に多くなってしまい、彼氏さんの収入面でもごふあんになり、結婚自体も考えなおすきっかけになってしまわれたかんじでしょうか？",
            "Chinese": "在这三年的交往中，您也与他职场的同事、他的父母和妹妹都有所接触，也正因如此，烦恼自然变多了；再加上他收入方面让您担心，于是也成了您重新考虑结婚的契机，是这种感觉吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:41:40",
            "content": "と、",
            "Chinese": "而且，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:42:03",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:42:11",
            "content": "そうです",
            "Chinese": "正是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:42:55",
            "content": "一番大きな原因としては良くお話しするお二人が、ここ暫くみどりさんがお気を使われお話し出来てない事も重要な感じですよね",
            "Chinese": "感觉一个很重要的原因，是原本无话不谈的你们，最近因为您的体谅而没能好好沟通，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:43:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:43:41",
            "content": "彼氏さんから、連絡はこないのですか？",
            "Chinese": "您男朋友没有联系您吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:44:18",
            "content": "連絡はきます",
            "Chinese": "他有联系我，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:44:45",
            "content": "彼の気持ちは変わっていないような",
            "Chinese": "感觉他的心意并没有变，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:44:52",
            "content": "それだけに",
            "Chinese": "正因为如此，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:45:11",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:45:11",
            "content": "不安な気持ちを伝えるのは",
            "Chinese": "要把我的不安说出来，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:45:30",
            "content": "悪い気がしまして",
            "Chinese": "我总觉得不太好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:45:36",
            "content": "躊躇してしまっておられるのですね",
            "Chinese": "所以您就犹豫了，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:45:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:46:11",
            "content": "彼のことが嫌いになったわけではなくて",
            "Chinese": "并不是我不喜欢他了，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:46:24",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:47:10",
            "content": "結婚しようと思っていたときと状況が変わり",
            "Chinese": "只是和当初准备结婚时的情况不同了，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:47:43",
            "content": "はい逆に彼氏さん思いですよね",
            "Chinese": "嗯，反过来说，您是很为他着想的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:48:06",
            "content": "そうですか?",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:48:24",
            "content": "ええ、とっても私にはそう感じます",
            "Chinese": "是的，我完全这么觉得。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:48:39",
            "content": "結婚を考え直している自分って",
            "Chinese": "在重新考虑结婚这件事的自己，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:48:46",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:49:21",
            "content": "冷たいな～とか思ってしまいます",
            "Chinese": "总觉得这样是不是太冷淡了…"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:49:34",
            "content": "あれあれ・・",
            "Chinese": "哎呀……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:49:53",
            "content": "私は全く逆の印象でしたよ",
            "Chinese": "我完全是相反的印象哦。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:50:01",
            "content": "そうですか",
            "Chinese": "是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:51:03",
            "content": "彼を支えると決めたのに",
            "Chinese": "明明下定决心要支持他的，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:51:16",
            "content": "みどりさんは、相手の立場におなりになられながら、自分の気持ちを押し殺して先読みと心配りができるお優しい方と思います",
            "Chinese": "我觉得绿女士您是一个很温柔的人，能够站在对方的立场上，压抑自己的感受，为对方深思熟虑、体贴周到。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:51:44",
            "content": "そうですか",
            "Chinese": "是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:51:49",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:52:59",
            "content": "溜め込み過ぎてしまいお辛い気持ちの行き場がなくなっているのではないでしょうか？みどりさんご自身もお辛い時期なのに",
            "Chinese": "您是不是把太多情绪憋在心里，导致痛苦的心情无处安放了呢？明明您自己也正处在艰难的时期。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:53:35",
            "content": "そうかもしれません",
            "Chinese": "也许是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:54:20",
            "content": "このまま結婚しても大丈夫なのかなと",
            "Chinese": "我也在想，这样继续结婚下去真的没问题吗。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:54:52",
            "content": "みどりさんご自身の本来からあるお優しさが逆にご自身を追い詰めてる気がしますがいかかでしょうか？",
            "Chinese": "我觉得绿女士您天生的善良，反而把自己逼得太紧了，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:55:11",
            "content": "そうかもしれません",
            "Chinese": "可能确实是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:55:42",
            "content": "確かに、彼氏さんの収入が大きく変わるとなると",
            "Chinese": "确实，如果他收入发生了很大变化，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:55:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:56:44",
            "content": "結婚への不安も増すとは思いますが、お二人ならお話をなさりながら上手に乗り越えていけそうに感じます",
            "Chinese": "对婚姻的不安确实会增加，但我感觉，如果是你们两个人的话，应该能通过沟通很好地克服困难。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:57:26",
            "content": "はい。彼や彼の家族、職場の仲間のことは大切です。",
            "Chinese": "是的。他、他的家人，还有他工作上的伙伴，对我都非常重要。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:58:08",
            "content": "そうですよね、みどりさん本当にお人柄の良さが伝わってきます",
            "Chinese": "是啊，绿女士，我真的能感受到您的人品非常好。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:58:20",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:58:26",
            "content": "ここは、",
            "Chinese": "在这个时刻，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:58:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 18:59:35",
            "content": "もう、控えめになり過ぎずにご連絡がとれそうな時にご自身の不安だったお気持ちをお伝えしてはいかがでしょうか？",
            "Chinese": "或许不必再过于克制了，在合适联系得到的时候，把您不安的心情如实告诉他，怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 18:59:59",
            "content": "みんな頑張っているのに",
            "Chinese": "可是大家都在努力，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:00:13",
            "content": "自分だけ不安になって",
            "Chinese": "只有我一个人感到不安。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 19:00:19",
            "content": "一人で抱え込み過ぎては良くないですよ",
            "Chinese": "一个人扛得太多可不好哦。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:00:38",
            "content": "こんな気持ちを伝えるのは気が引けていました",
            "Chinese": "把这种心情告诉他，我总觉得过意不去。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:00:51",
            "content": "そうですね",
            "Chinese": "说得也是。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 19:01:37",
            "content": "皆も頑張って来れているのは上手に吐き出しができているからだ。とは思いませんか？",
            "Chinese": "您不觉得大家之所以能坚持努力，正是因为他们懂得如何适当地倾诉吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:02:00",
            "content": "そうなんですね",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:02:09",
            "content": "気が付きませんでした",
            "Chinese": "我都没有意识到。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 19:02:52",
            "content": "ええ、みどりさんが思う以上にご自身は溜め込み過ぎてしまっている様に感じます",
            "Chinese": "是的，我感觉您把自己压抑得比您自己想象的还要厉害。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:03:09",
            "content": "そうですか",
            "Chinese": "是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 19:03:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:03:33",
            "content": "これが当たり前でした",
            "Chinese": "我一直以为这是理所当然的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 19:04:31",
            "content": "みどりさんは、お優しく、気配り上手で相手の立場になり過ぎてしまうのかもしれませんね",
            "Chinese": "绿女士您很温柔，又很会体贴人，也许是太过设身处地为对方着想了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 19:04:54",
            "content": "では、",
            "Chinese": "那么，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:04:58",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 19:05:57",
            "content": "ここがチャンスで新しいご自身のチャレンジですね勇気をもって抑えてたお気持ち伝えてみてください",
            "Chinese": "这就是一个机会，也是您自己的一个新挑战。请鼓起勇气，试着把压抑的心情说出来吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:06:28",
            "content": "良いきっかけをいただきました。",
            "Chinese": "谢谢您给了我一个很好的契机。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:06:34",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:06:54",
            "content": "彼に話してみます",
            "Chinese": "我会试着跟他谈谈。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 19:07:28",
            "content": "はい！是非！！みどりさんの新たな出発を応援しています",
            "Chinese": "好的！请一定试试！我支持您的新开始。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:07:54",
            "content": "新たな出発ですね",
            "Chinese": "是新的开始呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:08:01",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 19:08:10",
            "content": "新たな出発ですね＾＾",
            "Chinese": "是新的开始呢。＾＾"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:08:30",
            "content": "前向きに考えます",
            "Chinese": "我会积极去想的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:08:36",
            "content": "ありがとうございました",
            "Chinese": "非常感谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 19:08:50",
            "content": "勇気がいるでしょが頑張ってみてくださいねはい、前向きで！！",
            "Chinese": "这可能需要勇气，但请加油试试看！是的，要积极向前！"
        },
        {
            "role": "クライアント",
            "time": "2020/07/24(金) 19:09:43",
            "content": "自分の気が付かなかったところを教えていただきありがとうございました。",
            "Chinese": "谢谢您指出了我自己都没有意识到的地方。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/24(金) 19:10:19",
            "content": "こちらこそ、お話をお聞かせ下さりありがとうございました",
            "Chinese": "我才要谢谢您，谢谢您愿意和我说这么多。"
        },
