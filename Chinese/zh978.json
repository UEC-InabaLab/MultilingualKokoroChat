    {
      "role": "client",
      "time": "2020-12-21T10:21:44",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "counselor",
      "time": "2020-12-21T10:22:37",
      "origin": "家でのお子さんとの関りは、どんな感じでいらっしゃるのですか。",
