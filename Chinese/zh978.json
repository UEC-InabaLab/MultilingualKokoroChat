    {
      "role": "client",
      "time": "2020-12-21T10:29:57",
      "origin": "ええ",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2020-12-21T10:31:00",
      "origin": "お子さんの学校からは、何かお話などありますか。",
