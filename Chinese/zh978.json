    {
      "role": "client",
      "time": "2020-12-21T10:15:00",
      "origin": "いいえ、してないです",
      "content": "没有，没跟别人说过。"
    },
    {
      "role": "client",
      "time": "2020-12-21T10:15:05",
      "origin": "あぁ、でも夫には",
      "content": "啊，不过，和我丈夫说过了。"
    },
    {
      "role": "counselor",
      "time": "2020-12-21T10:15:12",
