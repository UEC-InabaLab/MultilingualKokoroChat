      "role": "client",
      "time": "2020-12-21T10:34:50",
      "origin": "ええ",
      "content": "是的。"
    },
    {
      "role": "client",
      "time": "2020-12-21T10:35:07",
      "origin": "学校も大変なのは分かるんですけどね…",
