{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:00:07",
            "content": "こんにちは、相談員です。本日はお越し頂きありがとうございます。",
            "Chinese": "您好，我是咨询师。感谢您今天前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:00:26",
            "content": "よろしくお願いします",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:00:39",
            "content": "はじめに年齢と性別をお聞かせいただけますか？",
            "Chinese": "首先，能请您告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:00:48",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:00:59",
            "content": "45才、女性です。",
            "Chinese": "45岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:01:06",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:01:20",
            "content": "本日はどのようなお悩みで相談にこられましたか？どのような事でもお話し下さいね。",
            "Chinese": "今天您是为什么烦恼来咨询的呢？任何事情都可以跟我说哦。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:01:29",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:02:03",
            "content": "先週お友達の犬が17才で亡くなりました。",
            "Chinese": "上周，我朋友的狗狗以17岁的高龄去世了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:02:24",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:02:50",
            "content": "私の犬は1年前に亡くなってるのですが、その友達と犬と私と私の犬ととても仲良くしておりました",
            "Chinese": "我的狗狗是一年前去世的，我和那位朋友，以及我们各自的狗狗，关系都非常好。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:03:10",
            "content": "いつも一緒に散歩へ行ってました",
            "Chinese": "我们总是一起去散步。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:03:13",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:03:33",
            "content": "で、時々「ん？」と思うことがありました",
            "Chinese": "然后，有时会发生一些让我觉得“嗯？”的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:03:49",
            "content": "どうなさったのですか？",
            "Chinese": "发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:04:49",
            "content": "友達の犬が亡くなった時、市の職員に遺体を引き取ってもらって処分したと聞きました。それで「え」と。",
            "Chinese": "我听说朋友家的狗狗去世时，她让市政工作人员把遗体带走处理掉了。我听了之后“啊？”地一下很震惊。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:05:30",
            "content": "詳しく言うと",
            "Chinese": "具体来说就是……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:05:30",
            "content": "そのようなことが、おありだったんですね。",
            "Chinese": "原来发生了那样的事啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:05:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:05:36",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:05:51",
            "content": "お話ください",
            "Chinese": "请继续说。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:06:35",
            "content": "市に処分を頼むと遺骨は戻ってこないし、共同塚のようなものもなくお参りにも行けないんです",
            "Chinese": "如果委托市政处理，骨灰是不会归还的，也没有类似公共墓地的地方，连去祭拜都做不到。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:06:51",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:06:55",
            "content": "私は",
            "Chinese": "而我……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:07:20",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:07:31",
            "content": "自分の犬が亡くなった時は動物霊園で火葬をし、遺骨を持って帰って来ました",
            "Chinese": "我的狗狗去世时，我是在宠物墓园火化的，然后把骨灰带回了家。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:07:42",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:08:20",
            "content": "友達はすごく犬を可愛がっていたのに最後があれでは犬が不憫でモヤモヤしてしまいました",
            "Chinese": "朋友明明那么疼爱她的狗，最后却是那样的结局，我觉得狗狗好可怜，心里总觉得很不是滋味。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:09:06",
            "content": "そのように感じられたんですね。",
            "Chinese": "您是这样感觉的呀。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:09:13",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:09:36",
            "content": "その人考えなので私が口出すことではないのですが",
            "Chinese": "这是她个人的想法，本不该我多嘴的，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:10:24",
            "content": "モヤモヤしてしまうとのことですが、ご自身はどのような風に思われましたか？",
            "Chinese": "您说心里很不是滋味，那您自己是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:11:21",
            "content": "私なら遺骨が戻ってこないことが耐えられないんです",
            "Chinese": "如果是我，我无法接受骨灰拿不回来。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:12:10",
            "content": "そうなんですね。大切にしている気持ちが伝わってきます。",
            "Chinese": "是这样啊。我能感受到您那份珍视的心情。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:12:29",
            "content": "ありがとうございます。また涙が出てきました。",
            "Chinese": "谢谢您。我又想哭了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:13:35",
            "content": "泣いても大丈夫ですよ。ゆっくりお話伺いますね",
            "Chinese": "想哭就哭吧，没关系的。我会慢慢听您说的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:13:46",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:13:54",
            "content": "友達が",
            "Chinese": "我朋友她……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:14:00",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:15:06",
            "content": "犬が亡くなったと自分の母親に話したら「あんまり悲しむと成仏出来ないよ」と言ったので、「それもそうだな」と言ってました。",
            "Chinese": "她跟她妈妈说狗狗去世了，她妈妈说“你太伤心的话，它就没法安息了”，然后她就说“说得也是”。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:15:08",
            "content": "で",
            "Chinese": "然后……"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:15:28",
            "content": "私は「悲しい時は悲しんでいいねんよ」と言いました",
            "Chinese": "我就对她说：“伤心的时候，就尽情伤心好了。”"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:15:38",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:16:29",
            "content": "なんで悲しんでる人に「成仏出来ない」なんて呪縛を説くんだろうと思いました",
            "Chinese": "我就在想，为什么要在别人伤心的时候，说出“无法安息”这种像魔咒一样的话呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:16:57",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:17:22",
            "content": "でも友達も",
            "Chinese": "但我朋友她也……"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:18:23",
            "content": "亡くなったその日に市の職員に遺体を引き渡し(夫さんは死に目にも遺体にも会えず)、翌日には遺品のl整理を始めようとしてました",
            "Chinese": "在狗狗去世当天就把遗体交给了市政工作人员（她丈夫连最后一面和遗体都没见到），第二天就准备开始整理遗物了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:18:45",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:19:07",
            "content": "それについては、どう思われましたか？？",
            "Chinese": "对于这件事，您有什么感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:19:18",
            "content": "はい。なんか私と温度差を感じてしまいモヤモヤしました",
            "Chinese": "是的。总觉得我和她在感受上有温差，心里很不是滋味。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:20:01",
            "content": "お友達との温度差を感じたんですね",
            "Chinese": "您感受到了和朋友之间的温度差，是吗。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:20:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:20:23",
            "content": "私は一年経っても遺品のl整理が出来ません",
            "Chinese": "我过了一年都还无法整理狗狗的遗物。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:20:48",
            "content": "なるほどですね。お友達とはお付き合いは長いにですか？？",
            "Chinese": "原来如此。您和这位朋友交往很久了吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:21:02",
            "content": "長いのですか？",
            "Chinese": "交往很久了吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:21:08",
            "content": "はい。もう10年以上です",
            "Chinese": "是的，已经十多年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:22:03",
            "content": "今までに、今回のように、モヤモヤや温度差を感じたことは、あったのでしょうか？",
            "Chinese": "在这之前，有过像这次一样，让您感到郁闷或者有温差的经历吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:22:38",
            "content": "今ずーっと思い返してたんですが、めちゃめっちゃありました。",
            "Chinese": "我刚才一直在回想，发现真的有很多很多次。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:23:33",
            "content": "そうなんですね。思い返すと、思い当たることが多いんですね",
            "Chinese": "是这样啊。一回想起来，就发现有很多类似的事情呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:23:41",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:23:44",
            "content": "元々",
            "Chinese": "本来呢……"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:24:07",
            "content": "通販オペレーターのパートの同期で知り合ったのですが",
            "Chinese": "我们原本是在做网购客服兼职时，作为同一批同事认识的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:24:23",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:25:06",
            "content": "そこはカスタマーセクハラ(カスハラ)がひどくてパートさんは病んで皆短期で辞めていくんですね",
            "Chinese": "那里的顾客骚扰（也就是所谓的“客诉霸凌”）很严重，兼职的同事们大多都精神上不堪重负，没做多久就辞职了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:25:18",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:25:26",
            "content": "セクハラじゃない、ハラスメントです",
            "Chinese": "不是性骚扰，就是指一般的骚扰。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:25:48",
            "content": "で、私は1年で病む寸前で辞めました",
            "Chinese": "然后，我做了一年，在快要精神崩溃前辞职了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:26:04",
            "content": "なるほど",
            "Chinese": "我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:26:08",
            "content": "友達は10数年働き続けてました",
            "Chinese": "朋友却在那里持续工作了十几年。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:26:19",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:26:57",
            "content": "お客からの罵声より上司から叱られる方が嫌と言ってましたね友達は。",
            "Chinese": "我朋友说过，比起被客人辱骂，她更讨厌被上司责骂。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:27:09",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:27:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:27:25",
            "content": "神経が図太いです",
            "Chinese": "她神经很大条。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:28:04",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:28:13",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:28:20",
            "content": "お友達の事は、",
            "Chinese": "关于您的朋友……"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:28:27",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:28:52",
            "content": "神経が図太い、意外に、どう思われますか？？",
            "Chinese": "除了说她“神经很大条”之外，您对她还有什么看法呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:29:40",
            "content": "おおらかで細かいことに悩まず私には無い部分をたくさん持ってます",
            "Chinese": "她很大度，不为小事烦恼，有很多我所不具备的优点。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:29:52",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:30:17",
            "content": "それが羨ましい時もあります",
            "Chinese": "有时我也会很羡慕她这一点。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:30:24",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:30:44",
            "content": "だけど…",
            "Chinese": "但是……"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:31:12",
            "content": "犬が寝たきりで床ずれが酷いと聞いたので",
            "Chinese": "我听说她的狗狗卧床不起，褥疮很严重，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/24(月) 14:31:55",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/24(月) 14:32:06",
            "content": "エアーマットがいいよと紹介したんだけど、高価なので買わないと言われました",
            "Chinese": "所以就推荐她用气垫床，但她说太贵了不买。"
        },
        {
