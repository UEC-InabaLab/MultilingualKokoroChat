        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 14:03:09",
            "content": "（とても勉強になるケース、ありあがとうございました）",
            "Chinese": "（这是一个很有学习价值的案例，非常感谢。）"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 14:03:26",
            "content": "こちらこそありがとうございました。",
