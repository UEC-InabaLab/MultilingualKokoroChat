{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 12:51:28",
            "content": "（よろしくお願いいたします。）",
            "Chinese": "（请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 12:52:30",
            "content": "よろしくお願いします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 12:52:49",
            "content": "すみません",
            "Chinese": "不好意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 12:53:34",
            "content": "はい、何かありますか？",
            "Chinese": "好的，您有什么想说的吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 12:54:13",
            "content": "（もしよかったら少しでも希死念慮のあるクライアントおねがいできますか？）",
            "Chinese": "（如果可以的话，能请您扮演一位稍微有些轻生念头的来访者吗？）"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 12:54:25",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 12:54:32",
            "content": "承知いたしました。",
            "Chinese": "明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 12:55:07",
            "content": "（ありがとうございます。時間になったら始めさせていただきますね。）",
            "Chinese": "（谢谢您。时间到了我们就开始吧。）"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 12:55:24",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 12:59:55",
            "content": "こんにちは。相談員です。ご相談にいらしていただきありがとうございます。今日はどのようなご相談ですか？",
            "Chinese": "您好。我是咨询员。感谢您前来咨询。今天想谈些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:00:21",
            "content": "死ぬ",
            "Chinese": "想死。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:00:40",
            "content": "死ぬ",
            "Chinese": "想死。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:00:47",
            "content": "死ぬ",
            "Chinese": "想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:01:09",
            "content": "そのようなお気持ちなのですね・・そのお気持ちについて、よかったらお話きかせていただけますか？",
            "Chinese": "原来您是这样的心情啊……如果可以的话，能跟我说说您的这种感受吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:01:36",
            "content": "死にます",
            "Chinese": "我要去死。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:01:49",
            "content": "もういいかなと思っています。",
            "Chinese": "我觉得，就这样算了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:02:26",
            "content": "そうですか・・・もういいかな、というお気持ちについて、もう少し詳しくきかせていただけますか？",
            "Chinese": "是吗……关于“就这样算了吧”的这种心情，能再详细地和我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:02:53",
            "content": "もう死んでもいいかなということです。",
            "Chinese": "意思就是，我觉得死了也无所谓了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:03:25",
            "content": "そうですか・・そう思われるほどお辛いのですね・・",
            "Chinese": "是吗……您是痛苦到会这么想的程度了啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:03:50",
            "content": "死ぬ",
            "Chinese": "想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:04:05",
            "content": "どのようなことから、もう死んでもいいかな、というお気持ちになっていらっしゃるのですか？",
            "Chinese": "是什么样的事情，让您产生了“死了也无所谓了”这样的心情呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:04:29",
            "content": "お話しやすいことからお話してくださいね。",
            "Chinese": "从您方便说的部分开始说就好。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:04:51",
            "content": "またさっきも殴られました",
            "Chinese": "刚才又被打了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:05:07",
            "content": "そうだったのですね・・怖くて痛い思いをされたのですね・・",
            "Chinese": "是这样啊……您一定又害怕又疼吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:05:19",
            "content": "誰に殴られたのですか？",
            "Chinese": "是被谁打的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:05:42",
            "content": "お父さんです",
            "Chinese": "是我爸爸。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:06:06",
            "content": "そうでしたか・・また、ということはよく殴られるのですか？",
            "Chinese": "这样啊……您刚才说“又”，是说您经常被打吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:06:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:06:47",
            "content": "そうなのですね・・そんなにしょっちゅう殴られるのですね・・",
            "Chinese": "这样啊……竟然如此频繁地被打……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:07:00",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:07:03",
            "content": "ずっと怖い思いをされているのですね・・",
            "Chinese": "您一直都很害怕吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:07:15",
            "content": "どのような時に殴られるのですか？",
            "Chinese": "他一般在什么情况下会打您呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:07:38",
            "content": "お酒飲んだら",
            "Chinese": "他一喝酒就会。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:08:07",
            "content": "いつも絡んできて",
            "Chinese": "总是来纠缠我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:08:42",
            "content": "そうでしたか・・それで、死にたくなるほどしんどい思いをされているのですね・・",
            "Chinese": "是这样啊……所以您才会痛苦到想死的地步……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:08:45",
            "content": "嫌だというと怒って殴る",
            "Chinese": "只要我说“不要”，他就会生气然后打我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:09:04",
            "content": "そうでしたか・・絡まれるのなんて嫌ですよね・・",
            "Chinese": "是吗……被纠缠肯定很难受吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:09:15",
            "content": "でも怒って、殴るのですね・・",
            "Chinese": "但他却因此生气打您……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:09:58",
            "content": "お酒注がせたり",
            "Chinese": "逼我给他倒酒，"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:10:07",
            "content": "触ったり",
            "Chinese": "还对我动手动脚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:10:27",
            "content": "そのようなこともさせられるのですね・・",
            "Chinese": "您还被迫做那样的事情啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:10:43",
            "content": "ちなみにあなたはおいくつですか？",
            "Chinese": "顺便问一下，您今年多大了？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:10:55",
            "content": "中2",
            "Chinese": "初二。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:11:26",
            "content": "そうですか・・いつごろからそのようなことをさせられているのですか？",
            "Chinese": "这样啊……从什么时候开始被这样对待的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:12:04",
            "content": "小6の頃から",
            "Chinese": "从小学六年级开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:12:35",
            "content": "そうだったのですね・・そんなに長い間、一人で嫌な思いをされてきたのですね・・・",
            "Chinese": "原来是这样……这么长时间以来，您都是一个人默默忍受着这些痛苦啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:12:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:13:05",
            "content": "もう限界、もういいか、と思って今日相談にいらしてくださったのですね・・",
            "Chinese": "您是觉得已经到极限了，觉得“就这样算了吧”，所以今天才来咨询的吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:13:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:14:37",
            "content": "これまでどなたかに相談なさったことはありますか？",
            "Chinese": "之前有向任何人求助或倾诉过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:14:44",
            "content": "ない",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:15:12",
            "content": "そうでしたか・・誰にも言えずに苦しんでこられたのですね・・",
            "Chinese": "是吗……您一直无法对任何人诉说，独自承受着痛苦……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:15:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:16:14",
            "content": "勇気を出して相談にいらしていただきありがとうございます。",
            "Chinese": "感谢您鼓起勇气前来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:16:20",
            "content": "お母さまは、そのようなときどのよう",
            "Chinese": "您母亲在那种时候……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:16:37",
            "content": "どのようにされているのですか？",
            "Chinese": "会怎么做呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:17:00",
            "content": "入院しています。",
            "Chinese": "她住院了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:17:22",
            "content": "お父さんに殴られたりして、心病んで",
            "Chinese": "因为被爸爸打，她的精神出了问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:18:06",
            "content": "そうでしたか・・お母さまも殴られていたのですね・・",
            "Chinese": "是这样啊……您母亲也被打过啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:18:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:18:47",
            "content": "今家ではお父さんと2人なのですね・・",
            "Chinese": "现在家里只有您和爸爸两个人了啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:18:56",
            "content": "兄弟はいらっしゃいますか？",
            "Chinese": "您有兄弟姐妹吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:19:47",
            "content": "おばあちゃんがいる。きょうだいはいません。",
            "Chinese": "有奶奶在。我没有兄弟姐妹。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:20:40",
            "content": "そうなのですね・・お父さんに絡まれたとき、おばあちゃんはどうしているのですか？",
            "Chinese": "这样啊……当您被父亲纠缠时，奶奶在做什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:21:00",
            "content": "おばちゃんのところに行ってる",
            "Chinese": "她去阿姨家了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:22:07",
            "content": "そうでしたか・・お家にいないときなのですね・・助けて欲しくても誰もいないのですね・・",
            "Chinese": "是吗……是在她不在家的时候啊……您想求助的时候，身边却没有任何人呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:22:38",
            "content": "はい。つらいです。",
            "Chinese": "是的。很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:22:54",
            "content": "一人で心細いし、嫌だし、痛いし・・・すごくしんどいお気持ち伝わってきます。",
            "Chinese": "一个人又无助，又厌恶，又疼痛……我非常能体会您这种痛苦的心情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:23:46",
            "content": "触る、殴るなども募力は絶対あってはならないことです。",
            "Chinese": "动手动脚、殴打等暴力行为是绝对不能容忍的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:24:32",
            "content": "暴力を振るう方が100%悪いです。あなたは何も悪くありません。あなたはもっと大切にされるべきです。",
            "Chinese": "施暴的一方是100%错误的。您没有任何错。您理应被更好地珍惜。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:24:53",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:24:56",
            "content": "でもきつい",
            "Chinese": "但是太难熬了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:25:06",
            "content": "もういいかなって思います",
            "Chinese": "我觉得，就这样算了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:25:38",
            "content": "そうですよね・・だれも助けてくれず、誰にも言えず、一人で我慢しているとそう思ってしまいますよね・・",
            "Chinese": "是啊……没有人帮助，也无法对任何人倾诉，只能一个人默默忍受，也难怪会这么想了……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:26:01",
            "content": "おばあちゃんやおばさんには言えない感じですか？",
            "Chinese": "感觉是没法和奶奶或阿姨说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:26:33",
            "content": "いとこと仲悪いし、来るなって言われてる",
            "Chinese": "我和表亲关系不好，他们还让我别过去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:27:08",
            "content": "そうでしたか・・それは悲しいですよね・・そう言われると何も相談できないですよね・・",
            "Chinese": "是吗……那真是让人伤心……被那样说的话，确实什么都没法谈了……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:27:25",
            "content": "もう何もかもいやだ",
            "Chinese": "我已经什么都厌烦了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:27:50",
            "content": "生きていてもしかたない。しんどすぎ",
            "Chinese": "活着也没什么意义。太痛苦了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:29:09",
            "content": "そう思われるお気持ち、伝わってきます。とても心配しています。誰か周りの大人に助けてもらえれば、と思うのですが、おばあちゃんはどうですか？",
            "Chinese": "我能理解您这样的心情。我非常担心您。我在想，如果能有身边的大人帮助您就好了，您奶奶怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:29:45",
            "content": "もうダメ",
            "Chinese": "已经不行了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:29:56",
            "content": "これ以上頑張れない",
            "Chinese": "再也坚持不下去了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:30:09",
            "content": "すべてがしんどい",
            "Chinese": "一切都太痛苦了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:30:28",
            "content": "これまでぎりぎりまで、一人で頑張ってきたのですものね・・",
            "Chinese": "是啊，毕竟您一直以来都是一个人坚持到了极限……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:30:51",
            "content": "どのように死のうか、なども考えたこともありますか？",
            "Chinese": "您有想过要用什么方式结束生命吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:32:47",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:33:00",
            "content": "楽になりたい。",
            "Chinese": "想解脱。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:33:18",
            "content": "そうでしたか・・それほどまで思い詰められているのですね・・",
            "Chinese": "是吗……您已经被逼到这个地步了啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:33:20",
            "content": "楽になったらだめですか？",
            "Chinese": "想解脱也不行吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:34:43",
            "content": "こんなに苦しんでいるので、楽になりたいですよね・・死ぬこともひとつの方法かもしれませんが、それ以外にも何か方法があるか一緒に考えてみませんか？",
            "Chinese": "您这么痛苦，当然会想解脱的……死亡或许是一种方法，但除此之外，或许还有其他的方法，我们能一起找找看吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:35:43",
            "content": "ありがとう。話せたからもういい",
            "Chinese": "谢谢。能说出来就够了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:35:48",
            "content": "あなたは何も悪くないのに、大切なあなたの命が奪われてしまうのは、私は悲しいです。",
            "Chinese": "您没有任何错，但您宝贵的生命却要因此逝去，我感到很难过。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:35:55",
            "content": "もう考えるの疲れた",
            "Chinese": "我已经不想再思考了，太累了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:36:34",
            "content": "そうでしたか・・疲れたけど、こうやって相談にいらしてくださったのですよね・・",
            "Chinese": "是吗……虽然很累，但您还是像这样来咨询了，不是吗……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:37:33",
            "content": "もういい",
            "Chinese": "就这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:38:38",
            "content": "私は諦めて欲しくないな、と思っています。大切なあなたの命。",
            "Chinese": "我希望您不要放弃。您宝贵的生命。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:39:02",
            "content": "もう無理",
            "Chinese": "已经不行了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:39:16",
            "content": "ただ、お母さんがかわいそう",
            "Chinese": "只是，妈妈太可怜了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:40:02",
            "content": "そうですか・・かわいそう、と思うお気持ちもう少しきかせてくださいますか？",
            "Chinese": "是吗……能再多和我说说您觉得她“可怜”的这种心情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:40:58",
            "content": "お母さんがかわいそう。わたししかいないから。わたしががんばらないとっておもってた。",
            "Chinese": "妈妈很可怜。因为她只有我了。我一直觉得我必须坚持下去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:41:35",
            "content": "そうだったのですね・・お母さんのために、我慢して頑張ってこられたのですね・・",
            "Chinese": "是这样啊……您是为了妈妈，才一直忍耐坚持到现在的啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:41:52",
            "content": "でももう無理",
            "Chinese": "但我已经撑不住了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:42:56",
            "content": "そのお気持ち、痛いほど伝わってきます。お母さんは一人っ子のあなたを可愛がられてこられたのですね・・",
            "Chinese": "您的这种心情，我感同身受。您妈妈一定非常疼爱作为独生女的您吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:43:20",
            "content": "でも、もう駄目なの",
            "Chinese": "可是，已经不行了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:43:49",
            "content": "おかあさんに、もういいって　言われた",
            "Chinese": "妈妈对我说，“就这样算了吧”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:44:22",
            "content": "そうだったのですね・・もういい、というのは、もう死んでもいい、と言われたのですか？",
            "Chinese": "是这样啊……她说的“算了吧”，是指“死了也可以”的意思吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:45:54",
            "content": "お母さんも　わたしを見捨てて、薬いっぱいのんで、　死のうとした",
            "Chinese": "妈妈也抛弃了我，吃了很多药，试图自杀。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:46:02",
            "content": "だからもういい",
            "Chinese": "所以，就这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:46:19",
            "content": "そうでしたか・・・そんなことがあったのですね・・",
            "Chinese": "是吗……竟然发生了那样的事……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:46:41",
            "content": "お母さんのために頑張ってきたのに、それは悲しいですよね・・",
            "Chinese": "明明是为了妈妈才一直坚持的，这太让人伤心了……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:46:55",
            "content": "しんどいですよね・・",
            "Chinese": "太痛苦了……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:47:25",
            "content": "もう何でもいい",
            "Chinese": "已经什么都无所谓了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:47:34",
            "content": "早く楽になりたい",
            "Chinese": "想快点解脱。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:48:28",
            "content": "こんなに苦しくても頑張ってきたのに・・そう思われますよね・・",
            "Chinese": "即使这么痛苦也坚持到了现在……您会这么想也是当然的……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:49:48",
            "content": "見捨てられた、と思うと、やりきれないですよね・・",
            "Chinese": "一想到自己被抛弃了，就觉得无法忍受了吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:49:55",
            "content": "もういいから。",
            "Chinese": "够了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:50:03",
            "content": "死ぬから",
            "Chinese": "我要去死了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:50:14",
            "content": "大丈夫。ありがとう",
            "Chinese": "没关系。谢谢你。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:51:10",
            "content": "苦しいですよね・・学校は行っていらっしゃるのですか？",
            "Chinese": "确实很痛苦……您还在上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:51:40",
            "content": "行ってる",
            "Chinese": "在上。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:52:06",
            "content": "いじめられてる。",
            "Chinese": "被霸凌。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:52:22",
            "content": "もういいから。",
            "Chinese": "够了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:52:25",
            "content": "そうでしたか・・学校でも辛い思いをされているのですね・・",
            "Chinese": "是吗……您在学校也过得很痛苦啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:52:28",
            "content": "死ぬから",
            "Chinese": "我要去死了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:52:38",
            "content": "もういい",
            "Chinese": "够了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:53:42",
            "content": "学校でも家でも、しんどい思いをされているのですね・・",
            "Chinese": "无论是在学校还是在家里，您都过得很痛苦啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:54:36",
            "content": "先生やスクールカウンセラーにはお話したことありますか？",
            "Chinese": "您和老师或学校的心理咨询师谈过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:55:02",
            "content": "ない",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:56:12",
            "content": "そうでしたか・・・もういい、というお気持ち、とっても伝わってきます。でも私は、大切なあなたの命を守って楽になれる方法があると思っています。",
            "Chinese": "是吗……您“就这样吧”的心情，我非常能理解。但是我认为，有能够守护您宝贵的生命，并且让您获得解脱的方法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:56:47",
            "content": "スクールカウンセラーの先生などに一度お話なさってみてはいかがでしょうか？",
            "Chinese": "您要不要试着和学校的心理咨询师谈一次呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:57:22",
            "content": "辛いお気持ちを振り絞って今日相談にいらしてくださった。あなたならできると思います。",
            "Chinese": "您今天能强忍着痛苦的心情来咨询。我相信您一定可以做到的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:57:36",
            "content": "いかがでしょうか？",
            "Chinese": "您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:58:41",
            "content": "公園歩いてる。ロープ持ってる",
            "Chinese": "我在公园里走着。手里拿着绳子。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:58:49",
            "content": "もいい",
            "Chinese": "就这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 13:58:55",
            "content": "ありがとう",
            "Chinese": "谢谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 13:59:44",
            "content": "そうなのですね・・ロープを置いて、どこか座ることを見つけることはできますか？",
            "Chinese": "是这样啊……您能放下绳子，找个地方坐下吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 14:02:03",
            "content": "（すみません、時間になってしまいました）",
            "Chinese": "（抱歉，时间到了。）"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 14:02:19",
            "content": "ベンチ",
            "Chinese": "长椅。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 14:02:25",
            "content": "座った",
            "Chinese": "我坐下了。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 14:02:36",
            "content": "こちらこそ",
            "Chinese": "我也要谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/06/03(木) 14:02:42",
            "content": "ベンチに座れたのですね。",
            "Chinese": "您在长椅上坐下了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/06/03(木) 14:02:43",
            "content": "ありがとうございました",
