{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:36:32",
            "content": "こんにちは、カウンセラーです",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:36:37",
            "content": "こんにちは。",
            "Chinese": "您好。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:36:42",
            "content": "よろしくお願い致します",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:36:50",
            "content": "こちらこそどうぞよろしくお願いします",
            "Chinese": "我也请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:37:06",
            "content": "今日は、どういったご相談でいらっしゃいますか？",
            "Chinese": "今天您有什么想咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:37:48",
            "content": "告白しようか、悩んでいます",
            "Chinese": "我在纠结要不要表白。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:38:05",
            "content": "そうだったんですね。。それはなやみますよね。",
            "Chinese": "原来是这样啊。这确实会让人烦恼呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:38:11",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:38:44",
            "content": "告白、、、ドキドキしますよね、、ちなみにどのような人でいらっしゃるんでしょうか？",
            "Chinese": "表白啊……确实会让人心跳加速呢。顺便问一下，对方是个怎样的人呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:39:06",
            "content": "相手は社会人です",
            "Chinese": "对方是已经工作的人。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:39:23",
            "content": "年齢が離れているので悩んでいます",
            "Chinese": "因为年龄差距大，所以很烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:39:42",
            "content": "なるほど。そうだったんですね。ちなみに今、年齢とかおいくつでいらっしゃいますか？",
            "Chinese": "原来如此，是这样啊。顺便问一下，您现在多大了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:39:53",
            "content": "今、中2です",
            "Chinese": "我现在上初二。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:40:17",
            "content": "そうだっんですね。ちなみにお相手の方は何歳なのでしょうか",
            "Chinese": "是这样啊。那对方多大年纪了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:40:47",
            "content": "うーん、、、多分、30才とかかなあ",
            "Chinese": "嗯……大概30岁左右吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:41:14",
            "content": "そうなんですね。。たしかに年齢差もあるし迷いますよね。。。",
            "Chinese": "原来是这样。确实年龄差距这么大，是会让人犹豫呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:41:20",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:41:45",
            "content": "告白しようかな、ということですが、どれくらい前から好きになった感じなのでしょうか？",
            "Chinese": "您说您想表白，大概是从什么时候开始喜欢上对方的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:42:04",
            "content": "中1の時に好きになりました",
            "Chinese": "我是从初一的时候开始喜欢他的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:42:38",
            "content": "なるほど、、ありがとうございます。どんなところがステキかな、好きかな、とかいかがでしょうか",
            "Chinese": "原来如此，谢谢您告诉我。您觉得他哪些地方很棒，或者说您喜欢他哪一点呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:43:09",
            "content": "すごく優しんです",
            "Chinese": "他非常温柔。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:43:30",
            "content": "おお！たとえばどんな感じ？",
            "Chinese": "哦！比如说，是怎样的温柔呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:44:13",
            "content": "同学年の男子は子どもっぽいし",
            "Chinese": "同龄的男生都很幼稚，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:44:21",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:44:26",
            "content": "優しくないし",
            "Chinese": "而且也不温柔。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:44:44",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:44:57",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:45:15",
            "content": "たとえばどんな風に優しくしてくれる感じ？",
            "Chinese": "比如说，他是怎么对您温柔的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:45:24",
            "content": "全部",
            "Chinese": "各方面都很温柔。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:45:34",
            "content": "すごい！",
            "Chinese": "哇，真厉害！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:46:18",
            "content": "それだけ全部優しいと思えるくらいの人にであったら、それは気持ちを伝えたくなるのも自然なことだと思います",
            "Chinese": "能遇到一个让您觉得他处处都很温柔的人，会想要向他表达自己的心意也是很自然的。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:46:49",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:46:55",
            "content": "告白するのに年齢差が気になるってことでしたが、どの辺りが具体的に気になる感じでしょうか？",
            "Chinese": "您说在表白这件事上在意年龄差，具体来说，您担心哪些方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:47:03",
            "content": "言ってもいいと思いますか？",
            "Chinese": "您觉得我告诉他也可以吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:47:50",
            "content": "素直な気持ちだから、伝えてもいいと思うけど、なにか迷う理由とかあるのかな？",
            "Chinese": "那是您真诚的心情，我觉得可以表达。不过，是否有让您犹豫的原因呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:48:20",
            "content": "相手が大人でもいいですか？",
            "Chinese": "即使对方是大人也可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:48:33",
            "content": "じゃあ、もう言おうかな",
            "Chinese": "那……要不我就去说吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:49:07",
            "content": "大人だとちょっと言い出しにくい気持ちもありますよね。たとえば伝えたら、相手はどう反応してきそうでしょうか？",
            "Chinese": "对方是成年人，确实会有点难以开口呢。比如说，如果告诉他了，您觉得他可能会有什么反应呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:49:50",
            "content": "この間、急にキスしてきたんです。",
            "Chinese": "前几天，他突然亲了我。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:49:59",
            "content": "ほっぺだけど。",
            "Chinese": "不过只是亲了脸颊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:50:07",
            "content": "なるほど、そのようなことがあったのですね。。。",
            "Chinese": "原来发生过这样的事啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:50:11",
            "content": "ドキドキしました",
            "Chinese": "我心跳得好快。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:50:29",
            "content": "確かにビックリもするし、ドキドキしますよね",
            "Chinese": "的确会又吃惊又心跳加速呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:51:09",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:51:32",
            "content": "そのときはどんなお気持ちでしたか？",
            "Chinese": "当时您是什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:51:49",
            "content": "ドキドキしました",
            "Chinese": "就是心跳得很快。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:52:34",
            "content": "そうだったんですね。。。そういうことがあると、期待してしまいますよね。",
            "Chinese": "是这样啊……发生这种事，确实会让人有所期待呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:52:41",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:53:32",
            "content": "告白もうしちゃおっかな、とのことですが、もし伝えたらどう返ってきそうでしょうか",
            "Chinese": "您说干脆就去表白吧，如果告诉他了，您觉得他会怎么回应呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:54:09",
            "content": "うーん、わかんないです。。。",
            "Chinese": "嗯……我也不太清楚……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:54:30",
            "content": "たしかに予想できないこともありますよね",
            "Chinese": "的确，有些事情是无法预料的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 15:54:36",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 15:54:53",
            "content": "もし伝えるとしたら、どう伝えようかな、とかいかがでしょうか",
            "Chinese": "如果要表达的话，您考虑过要怎么说吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 16:19:18",
            "content": "★★ここから再開となります★★",
            "Chinese": "★★从这里重新开始★★"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 16:20:34",
            "content": "うーん、どうやって言うかはまだ決めてないです",
            "Chinese": "嗯，还没想好要怎么说。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 16:21:02",
            "content": "直接言ったほうが良いですか？",
            "Chinese": "是当面说比较好吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 16:21:07",
            "content": "なるほど、確かにまよいますよね",
            "Chinese": "原来如此，这确实会让人犹豫呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 16:21:13",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 16:21:36",
            "content": "よかったら、直接伝えた時とそうでないときでどうか一緒に考えていけたらと思います",
            "Chinese": "如果您愿意的话，我们可以一起来想一想当面说和不当面说各会怎么样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 16:22:07",
            "content": "もし、直接伝えるとしたら、どんな風に伝えたいとおもいますか？",
            "Chinese": "如果要当面说的话，您想用什么样的方式表达呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 16:23:18",
            "content": "でも、すごい恥ずかしいかも。。。",
            "Chinese": "但是，可能会非常害羞……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 16:23:47",
            "content": "確かに、、、恥ずかしい気持ちもありますし、ドキドキしますものね",
            "Chinese": "确实……会觉得害羞，也会心跳加速呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 16:23:53",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 16:24:13",
            "content": "告白をしたり、異性にお気持ちを伝えるのは、今回が初めてだったりするのかな？",
            "Chinese": "这是您第一次向异性表白或者表达自己的心意吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 16:24:20",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 16:24:45",
            "content": "それは確かにより、躊躇してしまいますよね",
            "Chinese": "那样的话，的确会更加犹豫不决呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 16:25:04",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 16:25:24",
            "content": "もし仮に、、、ですが、伝えない、という選択をしたら、どんなお気持ちになりますか？",
            "Chinese": "那如果假设……您选择不告诉他，您会是什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/10/05(月) 16:27:56",
            "content": "加藤木先生終了してください",
            "Chinese": "加藤木老师，请结束吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/10/05(月) 16:28:12",
            "content": "承知いたしました",
            "Chinese": "好的，明白了。"
        }
    ],
