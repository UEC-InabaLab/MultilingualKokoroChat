{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 14:50:57",
            "content": "こんにちは。本日はよろしくお願いいたします。",
            "Chinese": "您好，今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 14:51:17",
            "content": "よろしくお願い致します。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 14:51:56",
            "content": "お時間になりましたら始めさせていただきますね。",
            "Chinese": "时间到了我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 14:52:13",
            "content": "承知しました。よろしくお願いします。",
            "Chinese": "好的，知道了。麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 14:53:03",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 14:53:21",
            "content": "こちらこそよろしくお願い致します。",
            "Chinese": "我才要请您多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:00:09",
            "content": "こんにちは相談員です。本日はご相談ありがとうございます。",
            "Chinese": "您好，我是咨询师。感谢您今天前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:00:16",
            "content": "よろしくお願いします。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:00:47",
            "content": "はじめにあなたのご年齢、ご性別をお聞かせいただけますか？",
            "Chinese": "首先，能请您告知您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:01:07",
            "content": "35歳　女性です。",
            "Chinese": "35岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:01:20",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:01:26",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:01:51",
            "content": "本日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:02:30",
            "content": "毎日何やっているんだろうなぁと思っています",
            "Chinese": "我总是在想，我每天到底在干些什么啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:03:16",
            "content": "毎日何やってるんだろうなぁと思われてるんですね。",
            "Chinese": "您每天都在想自己究竟在做什么，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:03:25",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:03:47",
            "content": "例えばどういう時にでしょうか？",
            "Chinese": "比如在什么样的时候会这么想呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:04:15",
            "content": "忙しくて",
            "Chinese": "在忙碌的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:04:21",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:04:23",
            "content": "疲れている時です",
            "Chinese": "还有疲惫的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:05:08",
            "content": "なるほど、忙しくて疲れている時にそう思われるのですね。",
            "Chinese": "原来如此，您是在忙碌又疲惫的时候会有这样的想法呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:05:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:06:39",
            "content": "忙しいとは日常生活ででしょうか？",
            "Chinese": "您说的“忙”，是指日常生活方面吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:06:51",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:07:37",
            "content": "もう少し詳しく教えていただけませんでしょうか？",
            "Chinese": "能否请您再详细说明一下呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:07:51",
            "content": "何をですか？",
            "Chinese": "具体指什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:08:47",
            "content": "日常生活の忙しいという中身です。例えば仕事をしていてだとか。わかりにくくてすみません",
            "Chinese": "指的是日常生活中“忙”的具体内容。比如工作上的事。不好意思，可能是我说得不够清楚。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:09:40",
            "content": "わかりました。仕事も家庭も忙しいです。子どもを抱えて勤務しています。",
            "Chinese": "我明白了。工作和家庭都很忙。我既要照顾孩子又要上班。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:11:14",
            "content": "そうだったんですね。お子さんを抱えて仕事もされ、家事もされてそれは忙しいですし、疲れてしまいますね。",
            "Chinese": "原来是这样啊。又要带孩子，又要工作，还要做家务，那确实很忙，也肯定会很累呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:11:26",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:14:04",
            "content": "疲れてしまってる時に何をやってるんだろうなと思うのはどんな感情がぴったりしますか？",
            "Chinese": "在感到疲惫、想着“我到底在做什么呢”的时候，用什么样的情绪来形容最贴切呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:14:23",
            "content": "例えば虚無感とか",
            "Chinese": "比如说，虚无感之类的。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:15:08",
            "content": "どんな感情、、よくわかりません。今、疲れている。それだけではまずいですか？",
            "Chinese": "什么样的情绪……我不太清楚。我现在就是很累。只是这样不行吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:15:48",
            "content": "ここなら話聞いてもらえるかなと思ったんですけど、、",
            "Chinese": "我本以为在这里能有人听我倾诉……"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:16:07",
            "content": "あんまり難しいことはわからないから",
            "Chinese": "太复杂的事情我也不懂。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:17:29",
            "content": "私の傾聴力不足でした。",
            "Chinese": "是我倾听得不够到位。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:17:57",
            "content": "今疲れている。そうなんですね",
            "Chinese": "您现在很累。是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:18:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:19:42",
            "content": "家事、子育て、仕事何が一番疲れますか？",
            "Chinese": "家务、育儿、工作，哪一项最让您疲惫呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:19:52",
            "content": "全部です",
            "Chinese": "全部都是。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:21:47",
            "content": "全部なんですね全部疲れてしまうんですね。大変ですね",
            "Chinese": "全部都是啊，所有事情都让您感到疲惫。真是辛苦您了。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:21:59",
            "content": "だから相談に来ました",
            "Chinese": "所以我才来咨询的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:22:15",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:23:31",
            "content": "何やってるんだろうなと思ってしまうほど疲れてしまってるんだなと私も思いました。",
            "Chinese": "我也感受到，您已经疲惫到会想“我到底在做什么呢”这种程度了。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:24:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:25:26",
            "content": "こうなれば少しは楽になるのになとかありますか？",
            "Chinese": "您有没有想过，如果能怎么样的话，或许会轻松一些？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:25:43",
            "content": "それがわからないから相談に来たんですが",
            "Chinese": "就是因为不知道，我才来咨询的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:26:31",
            "content": "そうですね。では一緒に考えていくのはどうでしょうか？",
            "Chinese": "说的是。那我们一起探讨一下，您看如何？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:26:43",
            "content": "だから何をですか？",
            "Chinese": "所以说，要探讨什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:29:14",
            "content": "相談者さまは仕事、子育て、家事全部疲れるとおっしゃってました。それでこの3つの中で疲れが取れることがあるのならば、一緒に考えませんか？と提案しました。",
            "Chinese": "您刚才说工作、育儿、家务全都让您感到疲惫。所以我提议的是，如果在这三件事中有什么可以缓解疲劳的方法，我们是否可以一起探讨一下呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:31:12",
            "content": "よくわからないです。私、相談員さんからかわいそうな人と思われています？",
            "Chinese": "我不太明白。您是不是觉得我很可怜？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:32:30",
            "content": "そんなことは全く思っておりませんでした。私の言葉でそう伝わってしまったのなら申し訳ございません。",
            "Chinese": "我完全没有那样想。如果我的话让您产生了这样的误解，我非常抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:35:27",
            "content": "ここは話を聞いてくれるところと聞いたんですが、、",
            "Chinese": "我听说这里是能好好倾听（我说话）的地方……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:36:02",
            "content": "はい、そうです。",
            "Chinese": "是的，没错。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:36:47",
            "content": "何からどう話せばいいかわからないんです。",
            "Chinese": "我不知道该从何说起，也不知道该怎么说。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:37:59",
            "content": "何からどう話せばいいのかわからないのですね。そうだったんですね。",
            "Chinese": "您不知道该从何说起、也不知道该怎么说，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:38:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:38:47",
            "content": "今の言葉はすごく伝わりましたよ",
            "Chinese": "您刚才的这句话，我深有体会。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:39:12",
            "content": "それ、何のことですか？",
            "Chinese": "那是指什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:39:41",
            "content": "「何からどう話せばいいのかわからない」です。",
            "Chinese": "就是您说的“我不知道该从何说起，也不知道该怎么说”。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:40:23",
            "content": "何でそんなこと言ってくるの？",
            "Chinese": "为什么要这么说？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:41:13",
            "content": "相談者さんの素直なお気持ちだと思ったからです",
            "Chinese": "因为我觉得那是您坦率的心声。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:41:19",
            "content": "やっぱり私の事どこかばかにしてますよね。",
            "Chinese": "果然您还是在某种程度上看不起我吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:42:24",
            "content": "素直なお気持ちを話されたなと思いました。ばかになんて決してしてませんよ",
            "Chinese": "我只是觉得您说出了自己真实的心情。我绝没有瞧不起您的意思。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:43:35",
            "content": "もういいです。終わりにしていいですか？",
            "Chinese": "算了。可以结束了吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:43:50",
            "content": "分かりました。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:44:08",
            "content": "本日はありがとうございました。",
            "Chinese": "今天非常感谢您。"
        },
        {
            "role": "クライアント",
            "time": "2022/02/20(日) 15:44:53",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/02/20(日) 15:45:27",
            "content": "それでは失礼いたします",
            "Chinese": "那么，今天就到这里了。"
        }
    ],
