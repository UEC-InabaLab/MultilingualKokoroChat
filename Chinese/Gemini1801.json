        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:45:32",
            "content": "そうですよね、一人だと寂しいですよね、、",
            "Chinese": "是啊，一个人的话会很寂寞吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:45:34",
            "content": "そんな明るい人間でもないし",
