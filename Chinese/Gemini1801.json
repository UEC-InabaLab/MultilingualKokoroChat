{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 18:52:04",
            "content": "こんばんは、本日はよろしくお願い致します",
            "Chinese": "晚上好，今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 18:53:14",
            "content": "よろしくお願い致します。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 18:53:57",
            "content": "お時間になりましたら、こちらから声掛けさせていただきますね。",
            "Chinese": "时间到了我会主动提醒您。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 18:54:26",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:00:06",
            "content": "こんばんは相談員です。ご相談に来ていただき有難うございます。まず初めに、年齢と性別を教えていただけますか。",
            "Chinese": "晚上好，我是咨询师。感谢您前来咨询。首先，请问可以告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:00:51",
            "content": "27歳、女です。",
            "Chinese": "27岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:01:00",
            "content": "有難うございます",
            "Chinese": "感谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:01:13",
            "content": "本日はどのようなご相談でしょうか",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:01:41",
            "content": "もうつらくて消えてしまいたいです",
            "Chinese": "我太痛苦了，想消失。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:01:51",
            "content": "なにもかもいやです",
            "Chinese": "什么都讨厌。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:02:13",
            "content": "つらい",
            "Chinese": "好痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:02:16",
            "content": "しんどい",
            "Chinese": "很累，很煎熬。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:02:21",
            "content": "そうなんですね、今そんなふうなお気持なんですね、、",
            "Chinese": "是这样啊，您现在是这样的心情呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:02:43",
            "content": "どんなことがあったのか、もう少し詳しく教えてもらえますか",
            "Chinese": "能再详细地告诉我发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:03:04",
            "content": "なんかいろいろうまくいかないです",
            "Chinese": "总觉得很多事情都不顺利。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:03:18",
            "content": "わたしが悪いと思うんですけど",
            "Chinese": "我觉得是我的错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:03:36",
            "content": "そうでしたか、、自分を責めてしまうのですね、、",
            "Chinese": "是这样啊……您在责怪自己呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:04:03",
            "content": "どんなことが、うまくいかない感じなのでしょうか",
            "Chinese": "具体是哪些事情让您觉得不顺呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:04:21",
            "content": "仕事とか恋愛とか他のことも",
            "Chinese": "工作、恋爱还有其他事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:05:09",
            "content": "上手くいかないことが重なるととても苦しいですよね、、",
            "Chinese": "不顺利的事情接踵而至，一定非常痛苦吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:05:42",
            "content": "はいもうずっとそうなんです、、",
            "Chinese": "是的，一直都是这样……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:06:44",
            "content": "そうですよね、、よかったら話やすいところからでだいじょうぶですので、どんなことがありましたか",
            "Chinese": "是啊……如果您不介意，可以从您觉得方便说起的地方开始，告诉我发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:07:22",
            "content": "仕事だとずっと上司に怒鳴られるんです",
            "Chinese": "在工作上，我总是被上司大吼大叫。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:07:43",
            "content": "もうこわい",
            "Chinese": "好可怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:07:58",
            "content": "本当にそうですよね、、",
            "Chinese": "真的，那一定很不好受……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:08:15",
            "content": "怖くて逃げだしたくなりますよね、、",
            "Chinese": "会感到害怕，想要逃离，对吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:08:32",
            "content": "はい、、でも仕事はしなきゃちけないし",
            "Chinese": "是的……但是工作又必须做。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:09:08",
            "content": "うんうん、それでずっと耐えておられるんですね、、",
            "Chinese": "嗯嗯，所以您一直在忍耐着呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:09:21",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:09:31",
            "content": "耐えるしかないです",
            "Chinese": "只能忍耐了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:10:14",
            "content": "それはしんどくなりますよね、、",
            "Chinese": "那确实会很辛苦呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:10:37",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:10:41",
            "content": "どんなことで上司からは怒鳴られるのでしょうか",
            "Chinese": "您的上司会因为什么事对您大吼大叫呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:11:20",
            "content": "なんかちょっとした入力ミスとかですね",
            "Chinese": "就是一些小的输入错误之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:11:34",
            "content": "そんなちょっとしたことで、、",
            "Chinese": "就为那么一点小事……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:11:35",
            "content": "なにかと難癖つけてくるんです",
            "Chinese": "他总是找各种茬。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:11:49",
            "content": "それは嫌になりますよね、、",
            "Chinese": "那确实会让人很厌烦呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:12:01",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:12:48",
            "content": "その上司はご自身以外の周りの人に対してはどんな感じなのでしょうか",
            "Chinese": "那位上司对您以外的其他人是什么样子的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:13:36",
            "content": "怒ってますねでも私よりは怒られてないと思います",
            "Chinese": "他也会对别人生气，但我觉得没我被吼得那么厉害。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:13:45",
            "content": "なんで私だけ",
            "Chinese": "为什么偏偏是我？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:14:08",
            "content": "そう思ってしまうのも当然ですよね、、",
            "Chinese": "您会这么想也是理所当然的……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:14:54",
            "content": "もう何もかも終わりにしたい",
            "Chinese": "真想把一切都结束掉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:15:18",
            "content": "そんなふうに感じておられるのですね、、",
            "Chinese": "您现在是这样的感觉啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:15:46",
            "content": "もしかすると、もう終わりにしたら楽になるかもとか考えておられますか",
            "Chinese": "您是不是也在想，如果就此结束会不会轻松些呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:16:07",
            "content": "そうですね楽だと思います",
            "Chinese": "是啊，我觉得会很轻松。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:16:45",
            "content": "そこまで追い詰められているのですね、、",
            "Chinese": "您已经被逼到这个地步了啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:17:30",
            "content": "そうかもしれないですね",
            "Chinese": "也许是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:18:02",
            "content": "もしかすると計画などを考えておられたりしますか",
            "Chinese": "或许，您有在考虑什么具体的计划吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:18:33",
            "content": "何のですか？",
            "Chinese": "什么计划？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:19:48",
            "content": "言葉が伝わらずすみません、死ぬことに対して、近々実行しようとかまで考えておられたりしますか",
            "Chinese": "抱歉我没表达清楚。我是说关于结束生命这件事，您是否已经考虑到近期要付诸实施了呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:20:54",
            "content": "死ぬ計画ってことですか？",
            "Chinese": "您是说自杀的计划吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:21:55",
            "content": "はい（答えにくいようでしたらすみませんでした）",
            "Chinese": "是的（如果这个问题让您为难，我很抱歉）。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:22:09",
            "content": "調べたりはしています",
            "Chinese": "有在网上查过一些。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:22:35",
            "content": "そうなんですね、、",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:22:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:23:21",
            "content": "今はどちらにいらっしゃいますか",
            "Chinese": "您现在在哪里呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:23:41",
            "content": "家です",
            "Chinese": "在家里。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:24:34",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:25:07",
            "content": "家はどなたかと一緒に住んでおられるのでしょうか",
            "Chinese": "您是和别人一起住吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:25:16",
            "content": "1人です",
            "Chinese": "一个人住。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:26:02",
            "content": "そうでしたか、いつくらいからお一人で住んでおられるのですか",
            "Chinese": "这样啊，您大概从什么时候开始一个人住的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:26:36",
            "content": "高校卒業してからですね",
            "Chinese": "高中毕业以后。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:27:19",
            "content": "そうすると、9年ほど一人暮らしを続けておられるのですね",
            "Chinese": "这么说，您已经一个人生活了大约9年了。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:27:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:27:49",
            "content": "ご家族とは連絡とかはされていますか",
            "Chinese": "您和家人有联系吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:28:02",
            "content": "してないです",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:29:05",
            "content": "そうなんですね、ご家族にはどんな思いがありますか",
            "Chinese": "是这样啊，您对家人是怎样的感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:29:18",
            "content": "特になにも",
            "Chinese": "没什么特别的感觉。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:29:35",
            "content": "特別仲良くはないです",
            "Chinese": "关系不是特别好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:30:10",
            "content": "そうでしたか、、根掘り葉掘り聞いてしまってごめんなさいね",
            "Chinese": "是吗……对不起，问得这么详细。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:30:36",
            "content": "いえ",
            "Chinese": "没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:31:40",
            "content": "先ほど、恋愛のことも上手くいなかないとおっしゃってましたが、どんなことがあったのかよかったら教えてもらえますか",
            "Chinese": "您刚才提到恋爱方面也不顺利，如果不介意的话，能告诉我发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:32:02",
            "content": "振られました",
            "Chinese": "被甩了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:32:28",
            "content": "それはつらいですよね、、",
            "Chinese": "那一定很难过吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:32:46",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:33:37",
            "content": "どんなことがあって、振られたのでしょうか（お話しできる範囲で結構です）",
            "Chinese": "是因为什么事被甩了呢（在您能说的范围内就好）？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:34:12",
            "content": "特に何かあったらとかはないんですが",
            "Chinese": "也不是因为发生了什么特别的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:34:29",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:34:33",
            "content": "お前もういいわーとかつまらんとか言われました",
            "Chinese": "他跟我说“你够了”、“真无聊”之类的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:34:53",
            "content": "えっ！そんな、、",
            "Chinese": "啊！怎么会这样……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:34:57",
            "content": "いつもそんな理由で振られるんです",
            "Chinese": "总是因为这种理由被分手。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:35:11",
            "content": "そうでしたか、、",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:35:40",
            "content": "いつも というと、これまでにも何人かお付き合いはされてきたのでしょうか",
            "Chinese": "您说“总是”，也就是说您之前也交往过几位对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:35:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:37:00",
            "content": "そうなんですね、そんなふうに言われたら傷ついてしまいますよね、、",
            "Chinese": "是这样啊，被人这么说，一定会很受伤吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:37:21",
            "content": "なんか慣れました",
            "Chinese": "感觉有点习惯了。"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:37:45",
            "content": "やっぱそうかって感じ",
            "Chinese": "有种“果然还是这样啊”的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:38:40",
            "content": "それは　自信を無くしてしまっている感じでしょうか",
            "Chinese": "这让您感觉失去自信了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/05/06(木) 19:39:16",
            "content": "無くすというか元からないです",
            "Chinese": "与其说是失去了，不如说本来就没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/05/06(木) 19:39:39",
            "content": "そうでしたか、、",
