{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:26:27",
            "content": "こんにちは。今日はよろしくお願いいたします",
            "Chinese": "您好。今天请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:26:46",
            "content": "こんにちは。よろしくお願いいたします。",
            "Chinese": "您好。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:28:30",
            "content": "何か取り上げたいテーマとかありますか？",
            "Chinese": "您有什么想谈的话题吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:29:05",
            "content": "希死念慮があります",
            "Chinese": "我有轻生的念头。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:29:15",
            "content": "了解しました。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:29:51",
            "content": "自殺系はあまり得意ではないのですが、できるだけやってみます。よろしくお願いいたします。",
            "Chinese": "我对自杀相关的议题不太擅长，但我会尽力协助您。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:30:17",
            "content": "＜時間が来たので始めますね＞",
            "Chinese": "＜时间到了，我们开始吧＞"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:30:39",
            "content": "こんにちは。相談員です。今日はどのようなご相談で来られましたか？",
            "Chinese": "您好。我是咨询员。今天您来是想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:31:04",
            "content": "よろしくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:31:21",
            "content": "よろしくお願いいたします。",
            "Chinese": "也请您多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:31:57",
            "content": "良かったら、あなたの性別・年齢・どのようにお呼びしたらいいか、聴いてもいいですか？",
            "Chinese": "如果方便的话，可以请教您的性别、年龄，以及该如何称呼您吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:32:51",
            "content": "60歳 男性",
            "Chinese": "60岁，男性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:33:16",
            "content": "教えていただいてありがとうございます。",
            "Chinese": "感谢您的告知。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:38:02",
            "content": "…ご相談内容をご自身で話せる範囲でいいので、伺ってもいいですか？",
            "Chinese": "…如果您愿意的话，能否请您在自己能说的范围内谈谈咨询内容呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:38:32",
            "content": "最近元気がないんです",
            "Chinese": "最近提不起精神。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:40:04",
            "content": "それはしんどいですね。",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:40:17",
            "content": "何かきっかけになることがありましたか？",
            "Chinese": "是发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:41:03",
            "content": "3ヶ月まてに妻がなくなりました",
            "Chinese": "三个月前，我妻子去世了。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:41:25",
            "content": "3か月前に、です",
            "Chinese": "是在三个月前。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:41:33",
            "content": "それはお辛いですね。お悔やみ申し上げます。",
            "Chinese": "那一定非常痛苦。请节哀顺变。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:47:09",
            "content": "…奥様が亡くなられてから、何か変わられた事はありましたか？",
            "Chinese": "…自从您太太去世后，有什么变化吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:48:19",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:48:37",
            "content": "やる気が出なくなりました",
            "Chinese": "我变得提不起劲了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:49:25",
            "content": "はい（聴いています）",
            "Chinese": "嗯（我在听）。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:52:37",
            "content": "何にもしたくないんです",
            "Chinese": "我什么都不想做。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:53:44",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:53:56",
            "content": "親しい身内の方が亡くなられたのですから、そういうお気持ちになられるのは、自然なことだと思います。",
            "Chinese": "亲近的家人去世了，会有这样的心情是很自然的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:56:21",
            "content": "ちなみに、ご家族は奥様の他にどなたかいらっしゃいますか？",
            "Chinese": "顺便问一下，除了您太太，您还有其他家人吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:56:41",
            "content": "いません",
            "Chinese": "没有了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:57:36",
            "content": "お二人暮らしだったんですね…。",
            "Chinese": "原来是你们二位一起生活啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:57:43",
            "content": "今はずっとお一人でいることが多いのでしょうか？",
            "Chinese": "现在是不是大部分时间都是一个人待着呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:57:51",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 15:58:36",
            "content": "お一人でいると、色々思い出すこともありますよね…。",
            "Chinese": "一个人的时候，也会想起很多事情吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 15:58:48",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:00:12",
            "content": "…何もしたくないということですが、普段はどのように過ごされていらっしゃいますか？",
            "Chinese": "…您说您什么都不想做，那平时都是怎么过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:00:33",
            "content": "1日寝ています",
            "Chinese": "整天都躺在床上。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:01:05",
            "content": "ずっとお一人で家で寝ていらっしゃる感じでしょうか？",
            "Chinese": "是一直一个人在家躺着的感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:01:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:02:29",
            "content": "体調がすぐれない感じでしょうか？",
            "Chinese": "是身体有什么不舒服吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:03:54",
            "content": "もう寝たまま起きたくないです",
            "Chinese": "我真想就这么睡下去，不要醒来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:04:51",
            "content": "起きたくない…。",
            "Chinese": "不想醒来……"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:05:52",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:07:22",
            "content": "お一人でずっと横になっていると、身体もだるくなりがちだし、寂しいですよね…。",
            "Chinese": "一个人长期躺着，身体也容易乏力，而且会感到寂寞吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:08:51",
            "content": "もう全てがどうでもいいです",
            "Chinese": "已经一切都无所谓了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:09:14",
            "content": "全てがですか。",
            "Chinese": "所有的一切吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:09:51",
            "content": "そうですね",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:12:10",
            "content": "それはお辛いですよね。",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:14:31",
            "content": "…奥様が亡くなられて３か月ということで、少しづつい亡くなられている現実が実感として、感じられていらっしゃると思います。",
            "Chinese": "…距您太太离世才三个月，我想您正逐渐切身感受到她已经不在的现实。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:15:38",
            "content": "その現実を受け入れられない１つの状況として、やる気が出なくなったり、ずっと寝ている状態が続いているのは、ある部分あってもおかしくない心の状況だと思います。",
            "Chinese": "作为无法接受现实的一种表现，提不起干劲、持续卧床，我认为这些都是心理上很自然的反应。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:17:29",
            "content": "ずっと一人で寂しさや孤独を抱えていらっしゃってお辛かったと思います。",
            "Chinese": "一直以来，您独自承受着寂寞和孤独，想必一定很痛苦吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:18:52",
            "content": "今日、こちらへご相談に来られたということは、ご自身でもどうにかしたいと思われている気持ちがどこかにあるからではないでしょうか。",
            "Chinese": "今天您能来这里咨询，是不是因为在您的内心深处，也希望能做些什么来改变现状呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:19:30",
            "content": "良かったら、話せる範囲で構わないので、今まで抱えてこられたお気持ちを吐き出してみませんか？",
            "Chinese": "如果可以，您能说到哪里就说到哪里，把一直以来压在心里的感受倾诉出来，好吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:23:19",
            "content": "そうですね",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:24:00",
            "content": "なんでも構わないですよ。",
            "Chinese": "说什么都可以。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:26:47",
            "content": "妻に会いたいです",
            "Chinese": "我想见我的妻子。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:27:11",
            "content": "ええ（聴いています）",
            "Chinese": "嗯（我在听）。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:31:01",
            "content": "会いたいけど会えないです",
            "Chinese": "想见，却见不到。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:31:24",
            "content": "…そう思われるほど、あなたにとって奥様はとても大事な存在の方だったんですね。",
            "Chinese": "……能让您如此思念，对您来说，您的太太一定是一位非常重要的人吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:32:14",
            "content": "＜１時間経ちましたが、ロールプレイ時間は継続して大丈夫ですか？＞",
            "Chinese": "＜已经过去1小时了，角色扮演时间可以继续吗？＞"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:36:47",
            "content": "はい、大丈夫です",
            "Chinese": "可以的，没问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:37:13",
            "content": "＜了解しました。もうしばらく続けますね＞",
            "Chinese": "＜明白了。那我们再继续一会儿。＞"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:38:55",
            "content": "そういう気持を抱えたまま、毎日お一人で過ごされるのは、辛いし、寂しいですね。",
            "Chinese": "抱着这样的心情，每天一个人生活，一定很痛苦，也很寂寞吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:41:16",
            "content": "ポッカリ穴が空いてしまった感じです",
            "Chinese": "感觉心里空了一大块。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:41:41",
            "content": "うんうん（聴いています）",
            "Chinese": "嗯嗯（我在听）。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:44:08",
            "content": "やる気もないです",
            "Chinese": "也提不起干劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:45:25",
            "content": "奥様が亡くなられてから、ずっとそんな感じが続いていますか？",
            "Chinese": "自从太太去世后，一直都是这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:46:06",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:46:28",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:46:38",
            "content": "「喪の時間」というのを聞かれたことはありますか？",
            "Chinese": "您听说过“哀悼期”这个说法吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:46:59",
            "content": "まだありません",
            "Chinese": "还没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:47:11",
            "content": "人が大事な人を失ったとき、その回復時間はその人との関係があった時間がかかると言われています。",
            "Chinese": "据说，当一个人失去重要的人时，恢复所需的时间，可能与他们相处的时间一样长。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:47:21",
            "content": "奥様がまだ亡くなられて３か月ということは、今までのお話を伺っていると、まだまだ回復時間はかかると思います。",
            "Chinese": "您太太才去世三个月，从您刚才说的情况来看，我认为恢复还需要很长的时间。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:49:45",
            "content": "ただ、その間何もせず、じっとするのではなくて、少しずつできる範囲でお気持ちを整理していくことも大事です。",
            "Chinese": "但是，在这段时间里，与其什么都不做、只是呆着，更重要的是在力所能及的范围内，慢慢整理自己的心情。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:50:32",
            "content": "そうなんですね",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:50:42",
            "content": "どうしても動けない時は、ずっと横になっていてもいいし、辛くなった時はこちらのような窓口へ来てくださって、気持ちを吐き出していきながら、少しずつ調整していってもいいと思います。",
            "Chinese": "实在动不了的时候，一直躺着也可以；感到痛苦的时候，可以来我们这样的地方，倾诉您的心情，一点点地进行调整，我觉得这样也很好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:52:15",
            "content": "どうか焦らず、ゆっくりでいいので、ご自身の事を大事になさってください。",
            "Chinese": "请不要着急，慢慢来就好，请您一定要好好照顾自己。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:52:38",
            "content": "はい、そうしてみますありがとうございました",
            "Chinese": "好的，我会试试的。谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:53:36",
            "content": "またお待ちしております。いつでも相談に来てくださいね。",
            "Chinese": "我们随时欢迎您再来。任何时候都可以来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:54:10",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:54:30",
            "content": "こちらこそありがとうございました。",
            "Chinese": "我也要谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/23(木) 16:55:36",
            "content": "＜ロールプレイも終わりでいいでしょうか？＞",
            "Chinese": "＜角色扮演可以结束了吗？＞"
        },
        {
            "role": "クライアント",
            "time": "2021/09/23(木) 16:55:44",
            "content": "「お疲れ様でした、ありがとうございました」",
            "Chinese": "“您辛苦了，非常感谢。”"
        },
        {
