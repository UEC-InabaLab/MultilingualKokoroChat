{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 13:59:08",
            "content": "こんにちは、相談員です。本日はお越しいただきありがとうございます",
            "Chinese": "您好，我是咨询师。感谢您今天前来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 13:59:19",
            "content": "ご相談をはじめる前に、性別と年齢、あと何とお呼びすればいいか教えていただけますか？あだ名でも大丈夫です。",
            "Chinese": "在开始咨询之前，能请您告知性别和年龄，以及希望我如何称呼您吗？昵称也可以。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 13:59:51",
            "content": "よろしくお願いいたします",
            "Chinese": "拜托您了。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:00:10",
            "content": "29歳男です",
            "Chinese": "29岁，男性。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:00:34",
            "content": "渡辺とお呼びください",
            "Chinese": "请叫我渡边。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:00:53",
            "content": "渡辺さんですね、ありがとうございます",
            "Chinese": "好的，渡边先生，谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:00:58",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:01:04",
            "content": "それでは、本日はどのようなご相談ですか？",
            "Chinese": "那么，今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:02:08",
            "content": "毎日割と楽しく過ごしていますが",
            "Chinese": "我每天过得还算愉快，不过……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:02:14",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:02:36",
            "content": "たまに無気力になる日があります",
            "Chinese": "但偶尔会有感到无精打采的日子。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:02:58",
            "content": "そのときにどうすればいいか教えていただきたいです",
            "Chinese": "我想请教一下，那种时候该怎么办才好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:03:08",
            "content": "なるほど、わかりました",
            "Chinese": "原来如此，我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:03:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:03:58",
            "content": "たまに無気力になるきっかけのようなものは何か心当たりはありますか？",
            "Chinese": "对于偶尔感到无精打采，您有没有想到什么可能的原因或契机呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:05:13",
            "content": "特に心当たりがないんです",
            "Chinese": "并没有想到什么特别的原因。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:05:35",
            "content": "そうなんですね、それはもやもやしますね",
            "Chinese": "这样啊，那确实会让人感到很困惑呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:05:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:05:52",
            "content": "では、つい最近無気力になったのはいつですか？",
            "Chinese": "那么，最近一次感到无精打采是什么时候呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:06:43",
            "content": "ここ1年間くらいですね",
            "Chinese": "大概是最近一年左右吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:07:27",
            "content": "そうでしたか…1年も…すっきりしたいですよね",
            "Chinese": "这样啊……已经一年了啊……确实很想摆脱这种状态呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:07:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:08:13",
            "content": "無気力になったとき、どのようなことを考えていますか？",
            "Chinese": "在感到无精打采的时候，您通常会想些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:08:34",
            "content": "そうですね…",
            "Chinese": "这个嘛……"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:08:51",
            "content": "ボーっとしてしまいます",
            "Chinese": "会不由自主地发呆。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:09:01",
            "content": "あとは手につかない",
            "Chinese": "另外什么都做不进去，"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:09:05",
            "content": "感じです",
            "Chinese": "就是这种感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:09:50",
            "content": "なるほど、それはどんどんつらくなってくるでしょうね…",
            "Chinese": "我明白了，那样的话一定会越来越难受吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:10:21",
            "content": "そうですね…",
            "Chinese": "是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:10:30",
            "content": "ボーっとしているときはどこにいるときが多いですか？",
            "Chinese": "您发呆的时候，大多是在哪里呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:10:59",
            "content": "自宅ですね",
            "Chinese": "在家里。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:11:15",
            "content": "仕事は在宅勤務です",
            "Chinese": "我是居家办公的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:11:24",
            "content": "なるほど、そうでしたか",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:11:42",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:11:59",
            "content": "以前は職場でお仕事されていたんですか？",
            "Chinese": "以前是在公司上班吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:12:17",
            "content": "はい、そうです",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:12:41",
            "content": "コロナ禍で在宅勤務になったという感じでしょうか？",
            "Chinese": "是因为疫情才开始居家办公的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:12:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:13:10",
            "content": "なるほど…コロナ…不安を感じますよね…",
            "Chinese": "原来如此……疫情……确实会让人感到不安呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:13:20",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:13:56",
            "content": "職場でお仕事をされていたときは、無気力を感じていましたか？",
            "Chinese": "以前在公司上班的时候，也会感到无精打采吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:14:40",
            "content": "少しあった気がします",
            "Chinese": "感觉好像也有一点。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:14:57",
            "content": "今ほど気になるほどではなかったですが",
            "Chinese": "但不像现在这么在意。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:15:29",
            "content": "なるほど…おつらい中お仕事されていたんですね…",
            "Chinese": "这样啊……您是在很难受的情况下坚持工作的呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:16:23",
            "content": "モヤモヤします",
            "Chinese": "感觉很烦闷。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:17:13",
            "content": "そうなんですね…はやくすっきりしたいですね",
            "Chinese": "是这样啊……真希望您能尽快摆脱这种烦闷的感觉。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:17:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:17:52",
            "content": "自宅でお仕事されているときは、もやもやは感じますか？",
            "Chinese": "居家办公的时候，会感到烦闷吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:18:03",
            "content": "はい",
            "Chinese": "会的。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:18:06",
            "content": "感じます",
            "Chinese": "会有这种感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:18:47",
            "content": "今特に不安を感じることは何かありますか？",
            "Chinese": "现在有什么特别让您感到不安的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:19:45",
            "content": "充実を感じることが一番なので",
            "Chinese": "因为我最看重的是能感受到充实感。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:19:57",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:20:00",
            "content": "足枷になっている",
            "Chinese": "感觉这成了我的绊脚石。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:20:03",
            "content": "と思います",
            "Chinese": "我是这么认为的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:20:58",
            "content": "なるほど、それは居たたまれなくなってきますよね…",
            "Chinese": "我明白了，那样确实会让人感到坐立不安呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:21:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:22:07",
            "content": "お仕事において、渡辺さんが一番充実感を感じるのはどんなときですか？",
            "Chinese": "在工作中，什么样的时候最能让渡边先生感到充实呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:22:25",
            "content": "そうですね…",
            "Chinese": "这个嘛……"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:23:00",
            "content": "誰かの役に立てたと思えたとき",
            "Chinese": "当我感觉自己帮助到别人的时候。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:23:04",
            "content": "ですね",
            "Chinese": "就是那样的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:23:16",
            "content": "素敵ですね！",
            "Chinese": "真是很棒！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:23:41",
            "content": "お客様にもさぞ喜んでいただけるんでしょうね",
            "Chinese": "您的客户一定也会很高兴吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:23:47",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:24:19",
            "content": "ちなみにお仕事は何をされているか、教えていただけますか？",
            "Chinese": "顺便问一下，能告诉我您是做什么工作的吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:24:37",
            "content": "可能な範囲で大丈夫です",
            "Chinese": "在您方便的范围内即可。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:25:03",
            "content": "営業職です",
            "Chinese": "我是做销售的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:25:19",
            "content": "わかりました、ありがとうございます！",
            "Chinese": "了解了，非常感谢！"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:25:34",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:26:07",
            "content": "営業職となると、コロナ禍で外に出にくくなった現状では、充実感を感じにくい状況ですね…",
            "Chinese": "从事销售的话，在疫情期间不方便外出的现状下，确实是很难感受到充实感的情况呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:26:48",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:27:10",
            "content": "直接顔を見て話せないですね",
            "Chinese": "无法直接面对面交谈了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:27:41",
            "content": "そうですね、お客様の顔が見えないとなんだか寂しいですね",
            "Chinese": "是啊，看不到客户的脸，总觉得有些寂寞呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:27:54",
            "content": "そう思います",
            "Chinese": "我也这么觉得。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:29:01",
            "content": "現状では、お客様とはどのようにコンタクトを取っているんでしょうか？",
            "Chinese": "目前，您是如何与客户联系的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:29:26",
            "content": "電話で応対しています",
            "Chinese": "通过电话沟通。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:29:48",
            "content": "なるほど、お声だけでお話されているんですね",
            "Chinese": "原来如此，只能通过声音来交流呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:29:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:30:55",
            "content": "お客様のお役に立てたと思うときは、どんなときですか？",
            "Chinese": "您在什么时候会觉得自己帮助到客户了呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:31:27",
            "content": "ありがとうと言われたら嬉しいです",
            "Chinese": "当对方对我说“谢谢”的时候，我会很高兴。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:31:47",
            "content": "そうですよね、こちらも嬉しくなりますものね",
            "Chinese": "是啊，听到这话我们也会很开心呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:32:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:32:58",
            "content": "渡辺さんは、どのような想いでお仕事をされているか、改めてお聞かせいただいていいですか？",
            "Chinese": "能否请您再谈一谈，您是抱着怎样的想法在工作的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:34:16",
            "content": "喜んでもらえるために、自分ができることをしよう",
            "Chinese": "为了让别人高兴，尽自己所能去做。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:34:25",
            "content": "と思ってます",
            "Chinese": "我是这么想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:34:29",
            "content": "とても素敵です",
            "Chinese": "这想法非常棒。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:34:35",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:34:49",
            "content": "私もなんだか嬉しくなりました",
            "Chinese": "我听了也觉得很开心。"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:35:09",
            "content": "そう言って頂けて嬉しいです",
            "Chinese": "您能这么说我很高兴。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:35:15",
            "content": "それでは、",
            "Chinese": "那么，"
        },
        {
            "role": "クライアント",
            "time": "2021/03/27(土) 14:35:19",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/03/27(土) 14:36:20",
            "content": "在宅勤務になって、お客様に喜んでいただく最大の足枷は何とお考えですか？",
            "Chinese": "居家办公后，您认为让客户满意的最大障碍是什么？"
        },
        {
            "role": "クライアント",
