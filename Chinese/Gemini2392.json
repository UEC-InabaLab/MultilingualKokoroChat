{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:00:05",
            "content": "こんにちは相談員です。よろしくお願いいたします。",
            "Chinese": "您好，我是咨询师。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:00:15",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:00:28",
            "content": "最初に年齢と性別を教えていただけますか？",
            "Chinese": "首先，可以请您告知年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:00:54",
            "content": "40才、女性",
            "Chinese": "40岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:01:08",
            "content": "お返事ありがとうございます。",
            "Chinese": "谢谢您的回答。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:01:20",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:01:51",
            "content": "何やってもうまくいかないのです",
            "Chinese": "我感觉自己做什么都不顺利。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:02:08",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:02:35",
            "content": "それはお困りですね。例えば、どんなことでしょうか？",
            "Chinese": "这一定很困扰您吧。比如说，是哪些事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:03:03",
            "content": "事務職なのですが、ミスが多くて",
            "Chinese": "我是做文职工作的，经常出错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:03:23",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:03:29",
            "content": "なんでこんなにもできないのかと",
            "Chinese": "我总在想，为什么自己这么没用。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:03:46",
            "content": "気になっていらっしゃるんですね。",
            "Chinese": "这件事一直让您很在意呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:04:00",
            "content": "はい、気になります",
            "Chinese": "是的，我很在意。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:04:12",
            "content": "それで上司に怒られるし、",
            "Chinese": "结果被上司责备，"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:04:26",
            "content": "お客様に迷惑かけるし",
            "Chinese": "也给客户添了麻烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:04:45",
            "content": "それは、困りましたね・・・",
            "Chinese": "这确实很困扰呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:04:53",
            "content": "なんて自分はできないのかと思ってしまってます",
            "Chinese": "我总是忍不住想，自己怎么这么差劲。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:05:17",
            "content": "そこまで思っていらっしゃるんですね。",
            "Chinese": "您已经想到这种地步了啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:05:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:05:37",
            "content": "お気持ちも、ふさいでしまいますよね・・・",
            "Chinese": "心情也会因此变得郁闷吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:05:49",
            "content": "ええ、",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:06:13",
            "content": "ボーッとしてて、車にひかれそうになりました",
            "Chinese": "我走神发呆，差点被车撞到。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:06:32",
            "content": "危ないですね。",
            "Chinese": "太危险了。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:06:47",
            "content": "そうなのです",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:07:15",
            "content": "最近集中が途切れることが多いという感じでしょうか？",
            "Chinese": "是不是感觉最近注意力经常不集中呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:07:36",
            "content": "そうなのかもしれないですが、",
            "Chinese": "也许是这样吧，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:07:46",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:07:54",
            "content": "自分でもよくわからないのです",
            "Chinese": "但我自己也不是很清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:08:05",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:08:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:09:01",
            "content": "ボートっとして、車に惹かれそうになるということは、もしかしたら、ご自分でも気づかない変化が起こっているのかもしれませんね・・・",
            "Chinese": "发呆到差点被车撞，也许是您自己都没察觉到的一些变化正在发生吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:09:02",
            "content": "こんな私、だめだと思うのです。",
            "Chinese": "我觉得这样的自己很没用。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:09:44",
            "content": "それはあるかもしれません。時々、いなくなってもいいかな、と思うこともあります。",
            "Chinese": "也许有吧。有时候，我甚至会想，消失了也无所谓。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:10:05",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:10:40",
            "content": "いなくなってもいいかなというのは、何か気になることとか、嫌なこととかおありなのですか？",
            "Chinese": "您说“消失了也无所谓”，是不是有什么让您在意或者讨厌的事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:11:19",
            "content": "あまりにも出来が悪い自分が嫌で、、",
            "Chinese": "我讨厌这么没用的自己……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:11:52",
            "content": "ミスのこととかですか？",
            "Chinese": "是指工作上的失误吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:11:58",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:12:21",
            "content": "今のお仕事はどのくらい続けていらっしゃるんですか？",
            "Chinese": "您现在这份工作做了多久了？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:12:46",
            "content": "事務は5年ぐらいです。",
            "Chinese": "文职工作做了大概5年。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:13:01",
            "content": "その前は販売、接客してました",
            "Chinese": "在这之前是做销售、接待客人的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:13:18",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:13:44",
            "content": "同じ会社の中での異動だったのですか？",
            "Chinese": "是在同一家公司内部调动的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:14:03",
            "content": "異動、そうですね",
            "Chinese": "是的，属于岗位调动。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:14:25",
            "content": "前の販売のお仕事はどのくらいなさっていたのでしょう？",
            "Chinese": "之前的销售工作您做了多久呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:15:00",
            "content": "15年ぐらいです",
            "Chinese": "大约15年。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:15:18",
            "content": "長いご経験ですね。",
            "Chinese": "您的经验很丰富呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:15:35",
            "content": "そうなのです。長いのが取り柄です",
            "Chinese": "是啊。做得久是我的优点。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:16:32",
            "content": "長く販売をなさって来たので、いろいろなご経験も積まれたのでしょうね・・・",
            "Chinese": "做了这么长时间的销售，一定积累了很多经验吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:17:30",
            "content": "はい。販売実績が高かったときもありました",
            "Chinese": "是的。也曾有过销售业绩很好的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:17:47",
            "content": "ステキですね。",
            "Chinese": "真棒啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:17:57",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:18:08",
            "content": "ちなみにどんな商品を販売していたのですか？",
            "Chinese": "顺便问一下，您当时卖的是什么商品呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:19:24",
            "content": "簡単にいうと地元のお土産屋さんです",
            "Chinese": "简单来说，就是在当地的特产店。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:19:42",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:20:02",
            "content": "地域の特産品などを販売されていたんですね。",
            "Chinese": "您卖的是当地的特产之类的商品吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:20:16",
            "content": "そうなのです!",
            "Chinese": "是的！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:20:32",
            "content": "地域密着のステキな販売という感じがしますね・・・",
            "Chinese": "感觉是那种扎根于当地的、很棒的销售工作呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:20:46",
            "content": "ホントですか?!",
            "Chinese": "真的吗？！"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:20:59",
            "content": "嬉しい",
            "Chinese": "好开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:21:06",
            "content": "はい　そう思います。",
            "Chinese": "是的，我确实是这样认为的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:21:37",
            "content": "地域のお土産を制作している職人さんたちには、頼りにされていたのでは？",
            "Chinese": "制作当地特产的工匠们，应该也很依赖您吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:22:44",
            "content": "そうですね。おかげさまで、職人さんとの人間関係には恵まれてました",
            "Chinese": "是的。托大家的福，我和工匠们的关系一直很好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:23:25",
            "content": "きっと、好かれたのにはあなたの人柄もあったのでしょうね・・・",
            "Chinese": "大家那么喜欢您，一定也和您的为人有关吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:24:02",
            "content": "そうなのかな〜",
            "Chinese": "是这样吗～"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:24:21",
            "content": "きっとそうだと思いますよ・・・",
            "Chinese": "我确信是这样的……"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:24:21",
            "content": "でも今は、ミスばかりで信頼されてないですよ",
            "Chinese": "但是现在，我总是出错，已经不被信任了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:24:56",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:26:01",
            "content": "以前の販売の時には実績が高かった時があったとのお話しですが、その時にはご自分なりに工夫や努力をなさっていたかと思いますが、いかがでしたか？",
            "Chinese": "您提到之前做销售时有过业绩很好的时候，我想那个时候您一定也下了很多功夫、付出了很多努力吧，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:26:27",
            "content": "たしかにありましたね",
            "Chinese": "的确是有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:27:04",
            "content": "どんな工夫や努力をしていたのですか？",
            "Chinese": "您当时都做了哪些努力和尝试呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:27:25",
            "content": "いつも笑顔",
            "Chinese": "总是面带微笑。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:27:31",
            "content": "いつも感謝",
            "Chinese": "总是心怀感谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:27:37",
            "content": "ステキ",
            "Chinese": "真好。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:27:54",
            "content": "いつも自分の足で地元に出向いて勉強",
            "Chinese": "经常亲自到当地走访学习。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:28:02",
            "content": "こんな感じでした",
            "Chinese": "大概就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:28:08",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:28:39",
            "content": "地元を知ろうとなさっていたのですね。",
            "Chinese": "您一直在努力深入了解当地啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:29:01",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:29:14",
            "content": "その工夫と努力が結果に結びついていたのでしょうね。",
            "Chinese": "这些努力和尝试，最终都转化为了成果吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:29:39",
            "content": "言われてみるとそうかもしれません",
            "Chinese": "听您这么一说，可能确实如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:30:06",
            "content": "そんなあなたを支えていたものは何だったのでしょうか？",
            "Chinese": "当时支撑着您的又是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:31:19",
            "content": "周りのみなさま、かな?",
            "Chinese": "应该是周围的大家吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:31:58",
            "content": "周りの皆さまとの関りなんですね。",
            "Chinese": "原来是与周围人的连结啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:32:37",
            "content": "一人では仕事できなかったと思ってます",
            "Chinese": "我觉得光靠我一个人是做不好工作的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:33:31",
            "content": "周りの人たちに支えられていたからこそ、お仕事が続けられたという思いなのですね。",
            "Chinese": "正因为有周围人的支持，您才能一路坚持工作，这是您的感受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:34:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:34:32",
            "content": "同時に、あなたも周りの人たちを販売というお仕事を通して支えていたとい面もきっと大きかったのでしょうね・・・",
            "Chinese": "同时，您也通过销售这份工作支持着周围的人，这方面的影响一定也很大吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/08/26(木) 13:35:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/08/26(木) 13:35:48",
            "content": "ステキな関係ですね。",
