    },
    {
      "role": "client",
      "time": "2021-05-06T19:07:43",
      "origin": "もうこわい",
      "content": "好可怕。"
    },
    {
      "role": "counselor",
      "time": "2021-05-06T19:07:58",
      "origin": "本当にそうですよね、、",
      "content": "真的，那一定很不好受……"
    },
    {
      "role": "counselor",
      "time": "2021-05-06T19:08:15",
      "origin": "怖くて逃げだしたくなりますよね、、",
      "content": "会感到害怕，想要逃离，对吧……"
    },
    {
      "role": "client",
      "time": "2021-05-06T19:08:32",
      "origin": "はい、、でも仕事はしなきゃちけないし",
      "content": "是的……但是工作又必须做。"
    },
    {
      "role": "counselor",
      "time": "2021-05-06T19:09:08",
      "origin": "うんうん、それでずっと耐えておられるんですね、、",
      "content": "嗯嗯，所以您一直在忍耐着呢……"
    },
    {
      "role": "client",
      "time": "2021-05-06T19:09:21",
      "origin": "そうですね",
      "content": "是啊。"
    },
    {
      "role": "client",
      "time": "2021-05-06T19:09:31",
      "origin": "耐えるしかないです",
      "content": "只能忍耐了。"
    },
    {
      "role": "counselor",
      "time": "2021-05-06T19:10:14",
      "origin": "それはしんどくなりますよね、、",
      "content": "那确实会很辛苦呢……"
    },
    {
      "role": "client",
      "time": "2021-05-06T19:10:37",
