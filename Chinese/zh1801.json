    {
      "role": "client",
      "time": "2021-05-06T19:12:01",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-05-06T19:12:48",
      "origin": "その上司はご自身以外の周りの人に対してはどんな感じなのでしょうか",
