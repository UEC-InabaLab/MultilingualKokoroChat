{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 17:59:06",
            "content": "お疲れ様です。本日はよろしくお願い致します。",
            "Chinese": "您辛苦了。今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 17:59:35",
            "content": "よろしくお願いします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:00:06",
            "content": "では、始めさせて頂いてもよろしいですか？",
            "Chinese": "那么，我们可以开始了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:00:25",
            "content": "よろしくお願いします。",
            "Chinese": "好的，拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:00:46",
            "content": "こんにちは。相談員です。",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:01:20",
            "content": "本日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:02:33",
            "content": "妻のことの相談です。",
            "Chinese": "是关于妻子的咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:03:02",
            "content": "ご相談ありがとうございます。",
            "Chinese": "感谢您的咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:03:12",
            "content": "妻さんのご相談なんですね。",
            "Chinese": "是关于您妻子的事情，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:03:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:03:34",
            "content": "差し支えなければ、詳しく教えて頂くことはできますか？",
            "Chinese": "如果方便的话，能否请您详细说说？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:04:26",
            "content": "自分はあまり平日は仕事をして",
            "Chinese": "我平时基本上都在工作，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:04:40",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:05:22",
            "content": "休日は家事全般をしてるのですが、妻は",
            "Chinese": "休息日我包办了全部家务，但是妻子她……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:05:40",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:06:32",
            "content": "3人の育児をしてきたことの方が常に優位に立っていると思っているようです。",
            "Chinese": "她似乎觉得，自己抚养三个孩子这件事，让她始终处于上风。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:07:08",
            "content": "そうなんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:07:32",
            "content": "私自身は平等だと思っている思いがあるのですが",
            "Chinese": "我自己认为我们是平等的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:07:47",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:07:56",
            "content": "どうなのだろうという気持ちがあります。",
            "Chinese": "但也会想，真的是这样吗。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:08:19",
            "content": "なるほど、そうなんですね。",
            "Chinese": "我明白了，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:08:39",
            "content": "奥さんが優位で、対等な関りでないとお感じなんですね。",
            "Chinese": "您感觉妻子处于优势地位，你们的关系并不对等，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:08:58",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:09:17",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:09:29",
            "content": "それはモヤモヤしますね。",
            "Chinese": "这确实会让人心里感到很憋闷呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:09:54",
            "content": "具体的にどのようなところで妻さんが優位だと感じられますか？",
            "Chinese": "具体来说，您在哪些方面会感觉到妻子处于优势地位呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:11:49",
            "content": "私と他人の意見が同じことを言っているのですが",
            "Chinese": "即使我和别人说的是同样的意见，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:11:58",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:12:18",
            "content": "他人の意見の方が尊重されるのです...",
            "Chinese": "她却更尊重别人的意见……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:12:40",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:12:50",
            "content": "それは納得いかないですね。",
            "Chinese": "这确实让人难以接受呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:13:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:13:28",
            "content": "それに日々、耐えているんです...",
            "Chinese": "我每天都在忍受着这些..."
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:13:52",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:14:04",
            "content": "自分の意見を尊重してもらえないと",
            "Chinese": "自己的意见得不到尊重，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:14:31",
            "content": "そう感じるのも無理はないですよね。",
            "Chinese": "有这样的感觉也是人之常情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:14:40",
            "content": "そのような状況になったのは、どれくらい前からですか？",
            "Chinese": "出现这种情况，大概是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:15:17",
            "content": "結婚してからです。",
            "Chinese": "从结婚以后就是这样了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:15:47",
            "content": "結婚してから...",
            "Chinese": "结婚之后……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:16:08",
            "content": "そこで妻さんがそのような態度に変わるきっかけはありましたか？",
            "Chinese": "那时候有什么契机让您妻子的态度发生这样的变化吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:18:05",
            "content": "もとの性格だと思います。",
            "Chinese": "我觉得是她本来的性格。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:18:22",
            "content": "そうお感じなんですね。",
            "Chinese": "您是这样感觉的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:18:35",
            "content": "結婚される前はそのようなことはありましたか？",
            "Chinese": "结婚前有过这样的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:19:54",
            "content": "出会って三ヶ月程で結婚したんです。",
            "Chinese": "我们认识三个月左右就结婚了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:20:28",
            "content": "うんうん、そうなんですね。",
            "Chinese": "嗯嗯，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:21:06",
            "content": "では、結婚前と後の違いはあまり感じないような感じでしょうか？",
            "Chinese": "那么，您的感觉是结婚前后没什么太大的差别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:21:38",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:21:46",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:22:52",
            "content": "では、妻さんがあなたのことを尊重してくれないという状況を聴かせて頂きましたが、",
            "Chinese": "好的，我听您说了妻子不尊重您的情况，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:23:33",
            "content": "あなたはどうなればよいとお感じですか？",
            "Chinese": "您希望情况变成什么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:26:26",
            "content": "仕事から帰ってきた時にご飯を用意してくれてるや出勤時と帰宅時の",
            "Chinese": "我下班回家的时候能准备好饭菜，以及我上下班的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:26:37",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:27:03",
            "content": "声がけをしてほしいのです。",
            "Chinese": "希望她能跟我打声招呼。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:27:35",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:27:58",
            "content": "会社に行くときや帰ってきたときに",
            "Chinese": "上下班的时候"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:28:17",
            "content": "声掛けがあるないでは",
            "Chinese": "有没有人打招呼，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:28:30",
            "content": "大違いですよね。",
            "Chinese": "感觉是完全不一样的，对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:28:41",
            "content": "現状はどのような感じですか？",
            "Chinese": "目前的情况是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:30:39",
            "content": "帰ってきても手作りではなくお弁当や娘が作っている状態です。",
            "Chinese": "即使回家，也没有她亲手做的饭菜，而是便当或者女儿做的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:30:55",
            "content": "！",
            "Chinese": "啊！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:31:07",
            "content": "そうなんですね。",
            "Chinese": "这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:31:32",
            "content": "妻さんはその時は何をしておられますか？",
            "Chinese": "那时候您妻子在做什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:32:32",
            "content": "家にいないのです。",
            "Chinese": "她不在家。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:33:01",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:33:27",
            "content": "一日頑張って働いて帰ってくるからこそ",
            "Chinese": "正因为在外面辛苦工作了一天回到家，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:33:42",
            "content": "出迎えてほしいと思いますよね。",
            "Chinese": "才更希望有人能迎接自己，是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:34:04",
            "content": "妻さんはその際どこにいらっしゃいますか？",
            "Chinese": "那您妻子当时一般会在哪里呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:35:15",
            "content": "車で出掛けているのでどこに行っているかわかりません...",
            "Chinese": "她开车出门了，所以我也不知道她去了哪里……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:35:25",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:35:46",
            "content": "それは不安に感じますね。",
            "Chinese": "这确实会让人感到不安呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:35:56",
            "content": "そのことについて",
            "Chinese": "关于这件事，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:36:07",
            "content": "妻さんと話されたことはありますか？",
            "Chinese": "您和妻子谈过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:36:25",
            "content": "何回もあります。",
            "Chinese": "谈过很多次了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:36:33",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:36:49",
            "content": "差し支えなければ、",
            "Chinese": "如果方便的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:36:57",
            "content": "どのような回答だったか",
            "Chinese": "她是怎么回答的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:37:07",
            "content": "教えて頂けますか？",
            "Chinese": "可以告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:38:55",
            "content": "長年、自分なりに責任感を持って頑張ってきたけれど育児にまいってしまい",
            "Chinese": "她说，自己这些年一直凭着责任感在努力，但在育儿方面实在精疲力竭，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:39:10",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:39:41",
            "content": "自分が追い込まれておかしくなってしまいそうだと言っていました。",
            "Chinese": "感觉自己被逼得快要崩溃了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:40:15",
            "content": "うんうん、そうなんですね。",
            "Chinese": "嗯嗯，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:40:39",
            "content": "妻さんも今は",
            "Chinese": "看来您的妻子现在也，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:40:58",
            "content": "大変な状況にある感じなんですね。",
            "Chinese": "处在一种很困难的状况中呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:41:10",
            "content": "その状況について、",
            "Chinese": "对于这个状况，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:41:24",
            "content": "あなたはどのようにお感じですか？",
            "Chinese": "您有什么感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:42:57",
            "content": "大変なんだなと思っています。",
            "Chinese": "我觉得她确实很辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:43:28",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:43:44",
            "content": "そうお感じなんですね。",
            "Chinese": "您是这么感觉的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:44:08",
            "content": "その状況に対して妻さんと一緒に",
            "Chinese": "针对这个情况，您和妻子有没有一起"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:44:35",
            "content": "考えたり、行動されたことはありますか？",
            "Chinese": "想过办法，或者采取过什么行动呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:45:20",
            "content": "助言はしています。",
            "Chinese": "我给过她建议。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:45:51",
            "content": "なるほどなるほど。",
            "Chinese": "原来如此，原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:45:59",
            "content": "あなたも妻さんのサポートを",
            "Chinese": "您也在支持着您的妻子，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:46:11",
            "content": "されておられるのですね。",
            "Chinese": "是这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/16(土) 18:46:28",
            "content": "助言をされて妻さんの反応はいかがですか？",
            "Chinese": "您给了她建议之后，她的反应怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/16(土) 18:46:59",
            "content": "聞いてくれません。",
