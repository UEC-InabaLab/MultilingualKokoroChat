{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:29:26",
            "content": "ロープレを開始したいと思います。宜しくお願い致します。",
            "Chinese": "我想开始角色扮演。请多指教。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:29:37",
            "content": "おねがいします",
            "Chinese": "好的，请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:30:02",
            "content": "こんばんは。相談員です。宜しくお願い致します。",
            "Chinese": "晚上好。我是咨询师。请多指教。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:30:16",
            "content": "おねがいします",
            "Chinese": "好的，请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:30:30",
            "content": "なんとお呼びしたらよいですか？",
            "Chinese": "请问我该怎么称呼您？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:30:40",
            "content": "りゅうじです",
            "Chinese": "我叫龙司。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:31:03",
            "content": "りゅうじさん、本日はどのようなご相談でしょうか？",
            "Chinese": "龙司先生，今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:31:26",
            "content": "部下が年上のガンコ親父で困ってます",
            "Chinese": "我的下属是个比我年长的顽固老头，我很苦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:32:17",
            "content": "そうなんですね。それは困ってしまいますね。具体的にどのようなことでお困りですか？",
            "Chinese": "是这样啊。那确实很伤脑筋呢。具体来说，是什么样的事情让您困扰呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:33:06",
            "content": "私のストレスがハンパないのです",
            "Chinese": "我的压力大得离谱。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:33:27",
            "content": "イライラと、",
            "Chinese": "又烦躁，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:33:46",
            "content": "モヤモヤで、",
            "Chinese": "又郁闷，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:34:01",
            "content": "髪もハゲてしまいました・・・",
            "Chinese": "头发都秃了……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:34:33",
            "content": "ストレスがハンパないとは、おつらいですね。",
            "Chinese": "压力这么大，您一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:35:07",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:35:11",
            "content": "それだけ大変思いをされているのですね。",
            "Chinese": "您承受了这么多辛苦啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:35:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:36:07",
            "content": "本日は少しでもりゅうじさんのストレスが軽減されるように、お話を聴きながら一緒に考えていきたいです。",
            "Chinese": "今天，为了能稍微减轻一些龙司先生的压力，我想一边倾听您的情况，一边和您一起思考对策。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:36:21",
            "content": "ぜひおねがいします！",
            "Chinese": "那可就拜托您了！"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:36:32",
            "content": "髪が生えるといいですが・・・",
            "Chinese": "要是头发能长回来就好了……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:37:45",
            "content": "はい。それでは、具体的に部下さんのお藩士をお伺いしても宜しいでしょうか？",
            "Chinese": "好的。那么，我可以具体了解一下您下属的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:37:56",
            "content": "どうぞ",
            "Chinese": "请说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:38:07",
            "content": "お話をお伺いしても宜しいでしょうか？",
            "Chinese": "我可以听您说说具体情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:38:12",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:38:46",
            "content": "部下さんは、頑固おやじだとのこと。どんなところが頑固でお困りですか？",
            "Chinese": "您说您的下属是个顽固老头。他的哪些地方让您觉得顽固和困扰呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:39:17",
            "content": "自分がいいと思ったことしか進めないのです。",
            "Chinese": "他只推进自己认为好的事情。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:39:26",
            "content": "それと、",
            "Chinese": "还有，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:39:49",
            "content": "自分に超優しく、他人に超厳しいひとです",
            "Chinese": "他对自己超级宽容，对别人却超级严苛。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:40:02",
            "content": "友達もいません",
            "Chinese": "他也没有朋友。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:40:40",
            "content": "同僚もみんあ、面倒なので放ってる感じです",
            "Chinese": "同事们也都觉得他很麻烦，所以都对他放任不管了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:40:58",
            "content": "なるほど。。自分に超優しく、他人に超厳しい人、いますよね、、。そういう方に合わせるのは大変ですよね。",
            "Chinese": "原来如此……对自己超级宽容、对别人超级严苛的人，确实有呢……要配合这样的人，一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:41:01",
            "content": "私は上司なので、",
            "Chinese": "因为我是他的上司，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:41:22",
            "content": "放りたいけど、できません・・・",
            "Chinese": "所以虽然想放任不管，但还是做不到……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:41:32",
            "content": "といったところです",
            "Chinese": "大概就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:42:01",
            "content": "そうですね。上司なので、ほっておくことができないところが、さらに辛いですね。",
            "Chinese": "是啊。正因为您是上司，所以不能放任不管，这点更让您辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:42:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:42:23",
            "content": "わかってもらえますか",
            "Chinese": "您能理解吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:43:08",
            "content": "はい、もちろん。上司の立場でありますし。りゅうじさんは、責任感のある方なんですね。",
            "Chinese": "是的，当然能。毕竟您是上司。龙司先生，您真是一位有责任感的人呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:43:35",
            "content": "人として、普通です",
            "Chinese": "作为一个人，这很正常。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:44:30",
            "content": "そんなことないですよ。上司として部下のことで悩んでいるのも責任感があるからだと思いますよ。立派です。",
            "Chinese": "没那回事。我认为，您作为上司会为下属的事情烦恼，正是因为您有责任感。这很了不起。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:45:11",
            "content": "そうですかーそれはありがとうございます",
            "Chinese": "是吗？那真是谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:45:35",
            "content": "りゅうじさん、参考までに、具体的に部下さんとの困った具体例を教えて頂いてもよいですか？",
            "Chinese": "龙司先生，为了更好地了解情况，您能举一个和这位下属相处时让您困扰的具体例子吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:48:32",
            "content": "自分が好きなことはせっせとやるが、自分が嫌なことは、文句ばかり言って、やらないだけでなく、邪魔をしてきます",
            "Chinese": "他对喜欢做的事情就勤快地做，但对自己讨厌的事情，就光是抱怨，不仅不做，还会从中作梗。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:48:58",
            "content": "マジ面倒な人間です",
            "Chinese": "真是个超级麻烦的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:49:12",
            "content": "え、、そうなんですね。お仕事ですし、それは困りますよね。",
            "Chinese": "诶……是这样啊。这毕竟是工作，那样确实很麻烦呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:49:31",
            "content": "うおーーーーーーめんどくせーーーーーーーーーーーーって感じです。以前こんなCMありましたが・・・",
            "Chinese": "就是那种“哇——————好烦啊——————”的感觉。以前有过这样的广告……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:50:17",
            "content": "CMどおりですかね…さけびたくなってしまいますね。",
            "Chinese": "简直和广告里一样呢……会让人想大叫出来呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:50:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:50:50",
            "content": "叫ぶかわりに髪が飛んでってしまいました・・・",
            "Chinese": "没喊出来，倒是头发先飞走了……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:51:04",
            "content": "困りました・・・",
            "Chinese": "真是伤脑筋……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:51:32",
            "content": "ストレスがたまりますね。りゅうじさんは、部下さんが、嫌なことはしないで邪魔したりする時は、どのように接しているのですか？",
            "Chinese": "这样压力真的会很大呢。龙司先生，当您的下属不做讨厌的工作还从中作梗时，您是怎么应对的呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:51:48",
            "content": "怒ったりしますか？",
            "Chinese": "您会生气吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:51:52",
            "content": "大人の対応してます笑顔で",
            "Chinese": "我会用成年人的方式，微笑着应对。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:52:42",
            "content": "笑顔で接することができるとは、素晴らしいですね。",
            "Chinese": "能够微笑着去应对，这真的很了不起。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:52:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:52:59",
            "content": "頑張ってます",
            "Chinese": "我一直在努力。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:53:18",
            "content": "ほんと、毎日お疲れ様です。",
            "Chinese": "真的，您每天都辛苦了。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:53:34",
            "content": "そうです疲れてます",
            "Chinese": "是的，我很累。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:53:57",
            "content": "笑顔で接し、注意の言葉などはかけるのですか？",
            "Chinese": "微笑着应对时，会说些提醒的话吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:54:30",
            "content": "はい、毎回言ってますそのひとゴッチといいますが、",
            "Chinese": "是的，每次都会说。那个人叫Gocchi，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:55:18",
            "content": "ゴッチさん、ここは思うこともあると思うが、仕事だし、前に進めようよーと接してます",
            "Chinese": "我会跟他说：“Gocchi，我知道你可能有些自己的想法，但这是工作，我们还是一起往前推进吧。”"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:56:00",
            "content": "すると、わしゃー納得いかん、やる意味がわからんとかいいます",
            "Chinese": "然后他就会说：“我可不服气，搞不懂这么做有什么意义。”"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:56:27",
            "content": "上司として、素晴らしい対応だと思います。冷静に声掛けされているんですね。",
            "Chinese": "作为上司，我认为您的应对方式非常棒。您能很冷静地和他沟通呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:56:40",
            "content": "部下さんも仕事なのだから、いやなことも、きちんと取り組んで欲しいですね",
            "Chinese": "毕竟是工作，真希望您的下属也能好好地完成那些他不喜欢的工作啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:56:49",
            "content": "頑張ってます",
            "Chinese": "我在努力。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:56:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:57:40",
            "content": "ごっちさんのやらない仕事は、どなたがされるんですか？",
            "Chinese": "Gocchi不做的那些工作，最终是谁来做呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:57:52",
            "content": "僕です",
            "Chinese": "是我。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:58:10",
            "content": "2人チームなので",
            "Chinese": "因为我们是两人团队。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:58:29",
            "content": "、、そうなんですね。。仕事が増えてしまい、さらに疲れてしまいますね。",
            "Chinese": "……是这样啊。工作量增加了，您会更累吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:58:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:58:55",
            "content": "２人チームですと、他にふれないですもね。",
            "Chinese": "因为是两人团队，也没办法分给别人做呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:59:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 20:59:28",
            "content": "りゅうじさんは、ゴッチさんのことを社内のどなたかに相談されましたか？",
            "Chinese": "龙司先生，关于Gocchi的事，您有没有向公司里的其他人反映过？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 20:59:45",
            "content": "相談しなくても、みんな知ってます",
            "Chinese": "不用我说，大家都知道。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:00:03",
            "content": "部長も、支店長も、近くで見てますから",
            "Chinese": "部长和分店长也都在旁边看着呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:00:15",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:00:32",
            "content": "部長も支店長もみているだけですか？",
            "Chinese": "部长和分店长也只是看着吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:00:54",
            "content": "そうなんです",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:01:59",
            "content": "それは、りゅうじさんだけにストレスや仕事の負担がかかり、、重荷ですね。",
            "Chinese": "这样的话，压力和工作负担就都落在龙司先生您一个人身上了……这担子太重了。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:02:35",
            "content": "そうなんです頭は軽くなりましたが・・・",
            "Chinese": "是啊，虽然头倒是轻了……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:03:47",
            "content": "これではストレスたまりますね、りゅうじさん、これまでのお話を少しまとめても宜しいでしょうか？",
            "Chinese": "这样下去压力确实会很大呢。龙司先生，我可以稍微总结一下您刚才说的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:03:55",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:05:34",
            "content": "りゅうじさんには、年上ですが、部下がいらっしゃいます。その部下はゴッチさん。ゴッチさんは、頑固おやじのようで、自分のすきな仕事しかしない。みんなもあきれている。",
            "Chinese": "龙司先生，您有一位比您年长的下属，叫Gocchi先生。Gocchi先生像个顽固老头，只做自己喜欢的工作。大家对他都很无奈。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:06:00",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:06:52",
            "content": "部長や支店長も近くにいるのに見ているだけ。りゅうじさんは上司として、冷静に対応していらっしゃいますが、ゴッチさんは、嫌な仕事はせず、その仕事はりゅうじさんがおこなっています。",
            "Chinese": "部长和分店长就在旁边却也只是看着。龙司先生您作为上司，很冷静地在应对，但是Gocchi先生不做他讨厌的工作，而那些工作都由您来完成。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:07:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:08:31",
            "content": "りゅうじさんは、そのせいで、ストレスがたまり、イライラ。モヤモヤしていて、髪の毛にも影響がでている。いかがでしょうか？",
            "Chinese": "因此您压力不断累积，既烦躁又郁闷，连头发都受到了影响。这样的概括是否贴近您的状况？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:09:05",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:09:18",
            "content": "今までお話を聴いて感じたことをお話をしても宜しいでしょうか？",
            "Chinese": "我可以谈谈听了您的话之后我的感受吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:09:31",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:10:30",
            "content": "りゅうじさんは、上司として、とても責任感のある方であると思います。また、本来であれば、怒ってどなってしまいそうなゴッチさんの言動にも、冷静に対応されていると思います。",
            "Chinese": "我觉得龙司先生作为上司，是一位非常有责任感的人。而且，对于Gocchi先生那些本可能会让人大发雷霆的言行，您也都能冷静地应对。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:10:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:11:14",
            "content": "同僚やりゅうじさんの上司も、ゴッチさんが面倒な人とわかっていても見て見ぬふり。",
            "Chinese": "您的同事和上司，也都知道Gocchi先生是个麻烦的人，却都视而不见。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:11:26",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:13:10",
            "content": "りゅうじさんのストレスを少しでも軽減するために、やはり、部長や支店長など、話しやすい上司にゴッチさんのことを相談をしてみてはいかがでしょうか？",
            "Chinese": "为了能稍微减轻一些您的压力，您不妨和部长或分店长等比较容易沟通的上司，再谈一谈Gocchi先生的事情如何？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:13:40",
            "content": "みんな、りゅうじさんに甘えてしまっているのかなとも思います。",
            "Chinese": "我也觉得，大家可能都有点仗着您能扛事，而把问题都推给您了。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:13:41",
            "content": "したこと何回もあります",
            "Chinese": "我已经谈过好几次了。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:14:02",
            "content": "頑張ろうって言ってました",
            "Chinese": "他们就说“加油吧”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:14:13",
            "content": "相談されたこともあるんですね。その時には、なんというお返事だったのでしょうか？",
            "Chinese": "原来您已经谈过了啊。那时候，他们是怎么回复的呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:14:26",
            "content": "頑張ろうって言われたのですね。",
            "Chinese": "就是让您“加油”是吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:14:33",
            "content": "頑張ろう  っていってました",
            "Chinese": "是的，他们就说“加油”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:15:29",
            "content": "そうなんですね。りゅうじさんは、グッチさんに、どのような部下になってほしいでしょうか？",
            "Chinese": "是这样啊。那龙司先生，您希望Gocchi先生变成什么样的下属呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:16:00",
            "content": "普通でいて欲しいです",
            "Chinese": "我希望他能正常一点就行。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:16:47",
            "content": "ゴッチさんに、普通の方と同様にお仕事していただきたい？ということでしょうか？",
            "Chinese": "您的意思是，希望Gocchi先生能像普通人一样工作，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:17:17",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:18:26",
            "content": "りゅうじさんのこうして欲しいという気持ちを、改めて時間を設けて、ゴッチさんに、お伝えしてみてはいかがっでしょうか？",
            "Chinese": "那不妨另外约个时间，把您“希望他这样做”的具体想法，正式地向Gocchi说明一下，您觉得如何？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:19:24",
            "content": "その際にりゅうじさんの上司や信頼できる同僚でも良いので、今一度事情を話して立ちあってもらうのも良いかもしれません。",
            "Chinese": "到时候，您可以再次跟您的上司或者信得过的同事说明情况，请他们陪同在场，或许也是个好办法。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:19:25",
            "content": "やってみますか",
            "Chinese": "要不，试试看吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:19:38",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:20:38",
            "content": "是非やってみてください！りゅうじさんにストレスがたまり、もっとお体に支障がでてしまったら、会社としてもマイナスです。",
            "Chinese": "请您务必试试！如果让您继续承受压力，导致身体出现更多问题，对公司来说也是一种损失。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:21:02",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:21:25",
            "content": "言ってみて、ゴッチさんがかわらないようであれば、またご相談くださいね。",
            "Chinese": "如果谈过之后，Gocchi先生还是没有改变的话，请再来找我商量。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:21:34",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:22:21",
            "content": "くれぐれもお体をお大事に。。",
            "Chinese": "请您务必保重身体。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:22:26",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:22:57",
            "content": "本日はこちらで終わりにしても宜しいでしょうか？",
            "Chinese": "今天先到这里可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:23:04",
            "content": "はい",
            "Chinese": "可以。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:23:11",
            "content": "ありがとうございました",
            "Chinese": "非常感谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:23:24",
            "content": "本日は、ご相談頂き有難うございました。",
            "Chinese": "今天非常感谢您的咨询。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/12(水) 21:23:38",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:23:57",
            "content": "こちらで、ロープレを終了いたします。",
            "Chinese": "那么，角色扮演到此结束。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/12(水) 21:24:07",
            "content": "有難うございました。",
