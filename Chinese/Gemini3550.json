{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 14:51:01",
            "content": "相談者役をさせて頂きます。よろしくお願い致します。",
            "Chinese": "我来扮演来访者的角色。请多多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 14:52:19",
            "content": "こんにちは。本日はよろしくお願いいたします。",
            "Chinese": "您好。今天请多多指教。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 14:52:38",
            "content": "ありがとうございます。よろしくお願いします。",
            "Chinese": "谢谢您。请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 14:52:38",
            "content": "時間になりましたら始めさせていただきます。",
            "Chinese": "时间到了我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 14:52:43",
            "content": "わかりました。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:00:21",
            "content": "こんにちは。相談員です。本日はお越しいただきありがとうございます。はじめにご年齢と性別を教えていただけますか。",
            "Chinese": "您好，我是咨询师。感谢您今天前来。首先，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:00:36",
            "content": "14歳　女性",
            "Chinese": "14岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:01:02",
            "content": "ありがとうございます。本日はどのようなご相談ですか。",
            "Chinese": "谢谢您。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:01:15",
            "content": "もう死にたい",
            "Chinese": "我真的不想活了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:01:27",
            "content": "誰も分かってくれない",
            "Chinese": "谁都不理解我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:01:38",
            "content": "そう思われているのですね。",
            "Chinese": "原来您是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:02:20",
            "content": "どんなお話でもお聴きしますので、どんなことがあったか教えていただけますか。",
            "Chinese": "无论是什么样的事情我都会倾听，可以告诉我发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:02:57",
            "content": "半年前から友人から嘘をつかれていて、",
            "Chinese": "从半年前开始，我的朋友就一直对我撒谎，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:03:09",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:03:43",
            "content": "私のある事ない事、周りの人に言いふらすんです。",
            "Chinese": "把关于我的真真假假的事，到处散播给周围的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:04:19",
            "content": "そんなことがあったんですね。",
            "Chinese": "原来发生了这样的事啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:04:56",
            "content": "だからいつも私が悪者",
            "Chinese": "所以我总是被当成坏人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:05:45",
            "content": "ええ。それはつらいですよね。",
            "Chinese": "嗯。那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:05:59",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:06:34",
            "content": "その友人は相談者さんのどんなことを言いふらすんですか？",
            "Chinese": "那位朋友都在对外散布关于您的哪些事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:07:10",
            "content": "私のせいで自分が精神を病んだとか",
            "Chinese": "比如说她精神出了问题，都是因为我造成的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:07:21",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:08:31",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:08:31",
            "content": "私が友人をいじめているとか、",
            "Chinese": "或者说我欺负她之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:08:46",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:10:36",
            "content": "そんなひどいことを周りに言うのですね。",
            "Chinese": "她竟然对周围的人说这么过分的话。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:10:44",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:11:34",
            "content": "そんなことを周りに言いふらされたら、誰しもがしんどくなると思います。",
            "Chinese": "被人在背后这么说，任谁都会觉得很痛苦的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:12:11",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:12:42",
            "content": "その友人はどんな性格の子なのですか？",
            "Chinese": "那位朋友是个什么性格的孩子呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:13:13",
            "content": "優しい",
            "Chinese": "她很温柔。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:13:22",
            "content": "自分以外にた",
            "Chinese": "对除我以外的人……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:13:31",
            "content": "以外には、です",
            "Chinese": "我是说，对除我以外的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:14:01",
            "content": "そういう子なんですね。",
            "Chinese": "原来是这样的孩子啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:14:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:14:25",
            "content": "同じクラスの子ですか？",
            "Chinese": "是同班同学吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:15:07",
            "content": "今は違います",
            "Chinese": "现在不是了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:15:43",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:17:23",
            "content": "ちなみに、",
            "Chinese": "顺便问一下，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:18:17",
            "content": "半年前から嘘をつかれているとのことですが、半年前にどんなことがあったのですか。",
            "Chinese": "您说从半年前开始就被造谣，那半年前发生了什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:18:48",
            "content": "よくわからないんです",
            "Chinese": "我也不太清楚。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:19:05",
            "content": "いきなり自分ターゲットにされて",
            "Chinese": "突然之间我就成了她的目标。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:19:12",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:20:16",
            "content": "クラスが変わっても",
            "Chinese": "即使换了班级，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:20:34",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:20:47",
            "content": "自分だけ言われる",
            "Chinese": "她还是只针对我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:21:24",
            "content": "そうでしたか。それは本当におつらいですよね。",
            "Chinese": "是这样啊。那真的很难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:21:39",
            "content": "はい、、",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:22:12",
            "content": "少し苦しいことを聴くかもしれませんが、",
            "Chinese": "接下来我问的，可能会让您有些难受，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:23:14",
            "content": "友人から周りの人に嘘をつかれて、相談者さんはどのような気持ちになったのですか？",
            "Chinese": "当朋友向周围的人编造关于您的谎言时，您心里是什么感受？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:23:33",
            "content": "悲しいです",
            "Chinese": "很难过。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:23:55",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:24:49",
            "content": "先生や保健室の先生に話しても、わかってもらえませんでした。",
            "Chinese": "我跟老师和保健室的老师说了，但他们都不理解我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:25:40",
            "content": "そうだったんですね。ちゃんと相談したのにわかってくれる人が先生方にはいなかったのですね。",
            "Chinese": "是这样啊。明明您已经去求助了，但老师们中却没有能理解您的人。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:25:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:26:25",
            "content": "なおさらショックでしたよね…",
            "Chinese": "那一定让您更受打击了吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:27:35",
            "content": "親御さんとか、他にご相談できそうな人はいましたか？",
            "Chinese": "那您的父母呢，或者还有其他可以商量的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:30:26",
            "content": "ごめんなさい。考えていて",
            "Chinese": "抱歉，我正在想……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:30:34",
            "content": "いないです",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:30:48",
            "content": "いいえ。ゆっくりでいいですからね。",
            "Chinese": "没关系，慢慢来就好。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:30:58",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:31:14",
            "content": "教えていただきありがとうございます。",
            "Chinese": "谢谢您告诉我这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:31:35",
            "content": "本日はどんなことを解決したいですか。",
            "Chinese": "今天您希望解决什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:31:46",
            "content": "わからない",
            "Chinese": "我不知道。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:31:56",
            "content": "でももうつらい",
            "Chinese": "但已经太痛苦了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:32:01",
            "content": "死にたい",
            "Chinese": "想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:32:03",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:32:22",
            "content": "そう思うほどつらいのですね。",
            "Chinese": "痛苦到让您产生这样的想法了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:33:09",
            "content": "親は忙しくて",
            "Chinese": "父母都很忙，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:33:23",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:33:29",
            "content": "話せる感じじゃないんでしょ",
            "Chinese": "不是那种能跟他们说的气氛。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:33:33",
            "content": "です",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:34:07",
            "content": "話せる感じじゃない、というと",
            "Chinese": "您说“不是那种能跟他们说的气氛”，是指……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:34:34",
            "content": "親は忙しいから親に相談できないって感じですか？",
            "Chinese": "是因为父母很忙，所以觉得没法向他们咨询，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:34:52",
            "content": "さっき言いましたが、そうです",
            "Chinese": "我刚才说过了，是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:35:26",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:36:13",
            "content": "忙しいというと、親御さんはお仕事で忙しい感じですか？",
            "Chinese": "您说忙，是指父母因为工作很忙的那种吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:36:36",
            "content": "父は仕事で忙しくて",
            "Chinese": "父亲工作很忙，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:36:43",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:36:53",
            "content": "母は弟の世話で忙しいです",
            "Chinese": "母亲则忙着照顾弟弟。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:37:21",
            "content": "そうでしたか。弟さんはおいくつですか？",
            "Chinese": "是这样啊。您的弟弟多大了？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:37:28",
            "content": "10歳です",
            "Chinese": "10岁。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:37:51",
            "content": "弟は病気があるから",
            "Chinese": "因为弟弟生病了，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:38:07",
            "content": "いつも母が見ています",
            "Chinese": "所以妈妈一直在照顾他。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:38:28",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:38:59",
            "content": "相談者さんはいつも学校とか家ではどう過ごしていますか？",
            "Chinese": "您平时在学校和家里是怎么度过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:39:40",
            "content": "学校に行くのは怖いけど何とか過ごしています。",
            "Chinese": "去学校很害怕，但还是勉强撑着。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:40:12",
            "content": "家では母がいない時はご飯作ったり洗濯したりしてます",
            "Chinese": "在家里，妈妈不在的时候，我会做饭、洗衣服。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:41:06",
            "content": "そうなんですね。怖いけど何とか通ってるのですね。",
            "Chinese": "是这样啊。虽然害怕，但还是硬着头皮坚持去上学呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:41:27",
            "content": "でもどこにも居場所がない",
            "Chinese": "但是，我感觉哪里都没有我的容身之处。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:42:10",
            "content": "そう感じているのですね。",
            "Chinese": "您是这样感觉的啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:42:17",
            "content": "みんなわかってくれなくて",
            "Chinese": "大家都不理解我，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:42:35",
            "content": "そんな所で過ごすのはつらい",
            "Chinese": "在那样的地方待着很痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:43:28",
            "content": "行きたくないけど仕方ない",
            "Chinese": "虽然不想去，但也没办法。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:43:34",
            "content": "そうですよね。居場所がないと思うと寂しいし、わかってくれる人がいないとつらいと思いますよね。",
            "Chinese": "是啊。感觉没有容身之处会很寂寞，没有能理解自己的人也会很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:43:52",
            "content": "だからもう死にたい",
            "Chinese": "所以我才想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:44:11",
            "content": "仕方ないと思いながらも行ってるのですね。",
            "Chinese": "您一边觉得没办法，一边还是坚持去学校了呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:45:01",
            "content": "死にたいと思うとどういうイメージがありますか。",
            "Chinese": "当您想到‘想死’时，心里会浮现怎样的感觉或画面？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:45:22",
            "content": "楽になる感じ",
            "Chinese": "感觉会变得轻松。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:45:50",
            "content": "なるほどですね。楽になりたいなと思っているんですね。",
            "Chinese": "原来如此。您是希望能变得轻松一些啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:46:22",
            "content": "他にはどんな方法だと楽になれそうですか。",
            "Chinese": "除此之外，还有什么方法能让您感觉轻松一些呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:46:47",
            "content": "私死んだ方がいいですよね",
            "Chinese": "我还是死了比较好吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:47:45",
            "content": "そう考えているのですね。ちなみに今は家の中ですか？",
            "Chinese": "您是这么想的啊。顺便问一下，您现在在家里吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:47:52",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:48:31",
            "content": "そうなんですね。ちなみにもし、",
            "Chinese": "是这样啊。顺便问一下，如果……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:49:34",
            "content": "嘘をつく友人のことが解決できるそうってなったら、どう思いますか。",
            "Chinese": "如果您那个撒谎的朋友的问题有可能得到解决，您会怎么想？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:49:56",
            "content": "解決できそうってなったら、です。",
            "Chinese": "我是说，如果看起来有可能解决的话。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:49:59",
            "content": "そんな事できないでしょう",
            "Chinese": "那种事根本做不到吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:50:14",
            "content": "誰も分かってくれないのに",
            "Chinese": "反正谁都不理解我。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:50:34",
            "content": "相談員さん、解決できるんですか？",
            "Chinese": "咨询师，您能解决吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:50:58",
            "content": "ええ。もしかするとあなたの近くにわかってくれる人はいないかもですが、",
            "Chinese": "嗯。也许在您身边没有能理解您的人，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:51:42",
            "content": "あなたのことを理解してくれる場所はあると言えますよ。",
            "Chinese": "但我可以说，一定有能理解您的地方。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:52:10",
            "content": "やっぱり誰も分かってくれない",
            "Chinese": "果然还是谁都不理解我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:53:11",
            "content": "まず嘘をついて人を傷つけることはあってはならないことであり、",
            "Chinese": "首先，用谎言伤害他人是绝对不应该发生的事情，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:53:36",
            "content": "それは一般的にはいじめに相当することです。",
            "Chinese": "这在通常情况下相当于霸凌。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:54:55",
            "content": "なのでそれを機関に相談することで、",
            "Chinese": "所以，通过向相关机构咨询这件事，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:55:33",
            "content": "友人から嘘をつかれることはなくなります。",
            "Chinese": "您朋友用谎言中伤您的行为也将会停止。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:56:43",
            "content": "ネットで「いじめ相談窓口」と検索すると上に文科省の",
            "Chinese": "在网上搜索“霸凌咨询窗口”，就能看到文部科学省（相当于中国的教育部）的"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:57:52",
            "content": "ページに相談先が乗ってるので、24時間対応してくれますよ。",
            "Chinese": "页面上会有咨询方式，他们提供24小时服务哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 15:58:38",
            "content": "相談できそうですか？",
            "Chinese": "您觉得可以去咨询一下吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 15:59:33",
            "content": "それって大人に話して、それを友人に話して注意してもらうことでしょう。大人は信用できない。",
            "Chinese": "那不就是跟大人说了，然后大人再去跟我朋友说，提醒她一下吗。我信不过大人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 16:00:12",
            "content": "そう考えているのですね。",
            "Chinese": "您是这样想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 16:00:50",
            "content": "今まで大人は信用できない人ばかりだったかもですが、",
            "Chinese": "也许您至今遇到的都是不可信的大人，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 16:02:16",
            "content": "期待はせずに、一度でいいので相談してみるのは有りかと思いますよ。",
            "Chinese": "我觉得就算不抱什么期待，试着咨询一次也未尝不可。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 16:02:27",
            "content": "もちろん強制ではないですからね。",
            "Chinese": "当然，这并不是强制的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 16:02:30",
            "content": "もういいです",
            "Chinese": "算了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 16:02:54",
            "content": "もう傷つきたくない",
            "Chinese": "我不想再受伤了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 16:03:15",
            "content": "さようなら",
            "Chinese": "再见。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 16:03:24",
            "content": "ええ。力になれずすみません。それではこれで終了しますがよろしいですか。",
            "Chinese": "好的。很抱歉没能帮上您的忙。那么这次咨询就到此结束，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/29(日) 16:03:31",
            "content": "はい",
            "Chinese": "可以。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 16:03:51",
            "content": "それでは失礼いたします。",
            "Chinese": "那么失礼了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 16:04:41",
            "content": "（お疲れ様でした。ありがとうございました。お手隙に評価頂けたら幸いです。）",
            "Chinese": "（辛苦了。非常感谢。如果您有空的话，希望能给予评价。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/29(日) 16:05:00",
