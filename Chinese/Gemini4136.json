{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 14:51:35",
            "content": "（こんにちは。今日はよろしくお願いします。）",
            "Chinese": "（您好。今天请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 14:52:02",
            "content": "(よろしくお願いします。本日ご希望のケース等はございますでしょうか？)",
            "Chinese": "（请多关照。请问您今天有希望扮演的案例类型吗？）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 14:52:25",
            "content": "（特にありません。）",
            "Chinese": "（没有特别的要求。）"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 14:52:38",
            "content": "(かしこまりました)",
            "Chinese": "（好的，明白了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 14:52:53",
            "content": "（時間前ですが、定時からスタートしますか？）",
            "Chinese": "（虽然还没到时间，要准时开始吗？）"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 14:55:30",
            "content": "(定時でお願いします)",
            "Chinese": "（请准时开始。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 14:55:46",
            "content": "（承知しました。）",
            "Chinese": "（了解了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:00:35",
            "content": "こんにちは。相談員です。まず初めによろしかったら年齢、性別、相談内容についてお聞かせ下さい。",
            "Chinese": "您好。我是咨询员。首先，如果方便的话，请告诉我您的年龄、性别，以及想咨询的内容。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:01:00",
            "content": "32 女",
            "Chinese": "32岁，女。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:01:08",
            "content": "つらい",
            "Chinese": "我很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:01:08",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:02:31",
            "content": "そうなんですね。具体的にはどのような事が、お辛いと感じられていらっしゃるのでしょうか？",
            "Chinese": "是这样啊。具体是什么事情让您感到这么难受呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:03:40",
            "content": "いろんなことがあって気持ちの整理ができません",
            "Chinese": "发生了很多事情，情绪理不清。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:04:28",
            "content": "そうだったんですね。それは、お辛いですよね。",
            "Chinese": "原来是这样。那一定很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:05:53",
            "content": "お話し出来るところからで結構ですが、例えばどんな事がおありだったのですか？",
            "Chinese": "您可以从方便说的地方说起，比如说，都发生了些什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:06:14",
            "content": "仕事のこととか家のこととか",
            "Chinese": "比如工作上的事、家里的事之类的。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:06:17",
            "content": "です",
            "Chinese": "就是这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:08:31",
            "content": "そうなんですね。色々おありでいたたまれないですよね。お仕事のことでは、どんな事がございましたか？",
            "Chinese": "是这样啊。发生了这么多事，一定让您很煎熬吧。关于工作上的事，发生了什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:09:55",
            "content": "つらいことが起きました",
            "Chinese": "发生了让人难受的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:12:47",
            "content": "なるほど。それはお辛い思いをされたのですね。貴方がそのように思われることは、どんなことだったのでしょうか？",
            "Chinese": "我明白了。那一定让您很难受吧。能具体说说是什么事情让您有这样的感受吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:13:19",
            "content": "いなくなりたい",
            "Chinese": "我想消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:14:31",
            "content": "そうなんですね。そう思われていらっしゃるのですね。それは、いつ頃からそのように感じらるようになられたのでしょうか？",
            "Chinese": "是这样啊。您有这样的想法了呢。大概是从什么时候开始有这种感觉的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:15:05",
            "content": "数年前から",
            "Chinese": "从几年前开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:16:54",
            "content": "そうなんですね。長い間お悩みになられていらっしゃるのですね。それは、どんなところからそう感じられるようになられましたか？",
            "Chinese": "是这样啊。看来您已经被这个问题困扰很长时间了。是什么契机让您开始有这样的感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:17:24",
            "content": "どう言う意味ですか",
            "Chinese": "什么意思？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:18:35",
            "content": "何かきっかになるようなこととか、もう少し詳しくお聴きしてもいいですか？",
            "Chinese": "是不是有什么契机，或者说，能再详细地和我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:19:19",
            "content": "意味がよくわかりません",
            "Chinese": "我不太明白您的意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:20:49",
            "content": "すいません。どのようなことがおありだったか、詳しくお話し聴かせていただけますか？",
            "Chinese": "对不起。能详细地和我说说都发生了些什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:21:21",
            "content": "何のことかわかりません",
            "Chinese": "我不明白您在说什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:22:58",
            "content": "お仕事のことで、いなくなりたいと思われのは、どんなところからそう感じらるのでしょうか？",
            "Chinese": "关于工作方面，是什么让您产生了想要消失的想法呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:23:17",
            "content": "うまくいかないところ",
            "Chinese": "那些不顺利的地方。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:24:40",
            "content": "そうなんですね。それは、悩まれますよね。どんなところが、上手くいかないと思われていらしゃるのでしょうか？",
            "Chinese": "是这样啊。那的确会很烦恼呢。您觉得是哪些地方不顺利呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:24:45",
            "content": "なにもかも",
            "Chinese": "什么都不顺。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:26:12",
            "content": "そうなんですね。そういうお気持ちでいらっしゃるのですね。それは、やりきれないお気持ちですよね。",
            "Chinese": "是这样啊。您现在是这样的心情呢。这种感觉一定很难承受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:28:32",
            "content": "お家のことについては、どんなところが、辛いとお感じですか？",
            "Chinese": "关于家里的事，是哪些方面让您觉得难受呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:29:19",
            "content": "全部",
            "Chinese": "全部。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:31:04",
            "content": "そうだったんですね。ご家族とご一緒に住んでいらしゃるのでしょうか？家族構成は、どんな感じでいらっしゃるのでしょうか？",
            "Chinese": "原来是这样。您是和家人住在一起吗？家庭成员构成是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:31:48",
            "content": "親がいます",
            "Chinese": "有父母。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:32:54",
            "content": "そうなんですね。お家ではどんな風にお過ごしでいらっしゃるのでしょうか？",
            "Chinese": "是这样啊。您在家一般是怎么度过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:34:15",
            "content": "色々です",
            "Chinese": "各种各样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:35:37",
            "content": "そうなんですね。親御さんとは、どのような関係の感じでいらっしゃいますか？",
            "Chinese": "是这样啊。您和父母的关系怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:35:50",
            "content": "親子です",
            "Chinese": "是亲子关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:37:12",
            "content": "普段どんな風に親御さんと暮らしていらっしゃるのでしょうか？",
            "Chinese": "平时您和父母是怎样一起生活的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:38:39",
            "content": "色々しながらです",
            "Chinese": "一边做各种事一边生活。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:40:08",
            "content": "そうなんですね。色々されながら、どのような事が、お辛いと感じられますか？",
            "Chinese": "是这样啊。在做各种事情的过程中，是什么让您觉得难受呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:40:28",
            "content": "全部です",
            "Chinese": "全部。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:41:42",
            "content": "そうなんですね。そう思われていらっしゃるのですね。お仕事は、どんな事をされていらっしゃるのでしょうか？",
            "Chinese": "是这样啊。您是这么想的呢。您的工作是做什么的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:42:11",
            "content": "会社員です",
            "Chinese": "我是公司职员。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:43:14",
            "content": "そうだったんですね。どの位の年数お勤めになっていらっしゃるのですか？",
            "Chinese": "原来是这样。您工作大约多少年了呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:43:26",
            "content": "数年ほど",
            "Chinese": "几年左右。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:44:41",
            "content": "そうなんですね。具体的には、会社でどのようなお仕事をされていらっしゃるのでしょうか？",
            "Chinese": "是这样啊。具体来说，您在公司是做什么工作的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:45:53",
            "content": "色々やってます",
            "Chinese": "做的事情挺杂的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:48:55",
            "content": "そうなんですね。色々仕事でもおありになって、気持ちを整理されたいとお話し伺いましたが、どのようなお気持ちを整理されたいとお考えですか？",
            "Chinese": "是这样啊。听您说工作上也发生了很多事，想要整理一下心情，请问您想整理的是什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:50:06",
            "content": "全部",
            "Chinese": "全部。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:50:27",
            "content": "今あるもの",
            "Chinese": "现在有的这些。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:50:49",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:51:58",
            "content": "どんな答えが出れば良いと思いますか？",
            "Chinese": "您觉得得到什么样的答案会比较好呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:52:25",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:52:32",
            "content": "決められません",
            "Chinese": "我决定不了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:54:07",
            "content": "そのような状況でいらっしゃるのですね。それはお辛いですよね。",
            "Chinese": "您现在是这样的状况啊。那一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:54:38",
            "content": "きえたい",
            "Chinese": "想消失。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:56:43",
            "content": "そのように感じられていらしゃるのですね。でも、消えていい人なんていないと考えますが、いかがですか？",
            "Chinese": "您有这样的感觉啊。但是，我认为没有人是应该消失的，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:57:07",
            "content": "綺麗事ですね",
            "Chinese": "真是冠冕堂皇的话。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:57:15",
            "content": "さようなら",
            "Chinese": "再见。"
        },
        {
            "role": "クライアント",
            "time": "2022/10/18(火) 15:57:40",
            "content": "(このまま終了の方向でお願いします。)",
            "Chinese": "（请就这样结束吧。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/10/18(火) 15:58:19",
            "content": "（了解しました。大変勉強になりました。ありがとうございました。）",
            "Chinese": "（明白了。学到了很多。非常感谢您。）"
        }
    ],
