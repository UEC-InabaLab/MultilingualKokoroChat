{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 19:53:14",
            "content": "こんばんは。宜しくお願い致します。時間になりましたら、こちらから始めますね。",
            "Chinese": "晚上好。请多关照。时间一到，我这边就会开始。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 19:53:53",
            "content": "こんばんは宜しくお願いします",
            "Chinese": "晚上好，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 19:58:41",
            "content": "こんばんは。",
            "Chinese": "晚上好。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 19:59:12",
            "content": "こんばんは",
            "Chinese": "晚上好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 19:59:20",
            "content": "ごめんなさい。ボタン間違いました。",
            "Chinese": "抱歉，我按错按钮了。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 19:59:32",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 19:59:39",
            "content": "大丈夫です",
            "Chinese": "没关系的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:00:06",
            "content": "こんばんは。相談員です。今日は相談に来てくださってありがとうございます。",
            "Chinese": "晚上好，我是咨询师。感谢您今天前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:00:22",
            "content": "よろしくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:00:46",
            "content": "宜しくお願い致します。まず、最初に年齢と性別を教えていただけますか?",
            "Chinese": "请多关照。首先，能请您告知您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:01:06",
            "content": "18才、男",
            "Chinese": "18岁，男。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:01:56",
            "content": "ありがとうございます。この相談であなたを何とお呼びすれば宜しいですか?ニックネームでもかまいませんよ。",
            "Chinese": "谢谢。在这次咨询中，我该如何称呼您呢？用昵称也可以哦。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:02:17",
            "content": "ひろや　です",
            "Chinese": "我叫弘也。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:02:50",
            "content": "ひろやさんですね。今日はどのようなご相談ですか?",
            "Chinese": "是弘也同学啊。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:03:32",
            "content": "大学が始まったのですが、全然やる気が起きなくって",
            "Chinese": "大学开学了，但我完全提不起干劲。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:03:37",
            "content": "困ってます",
            "Chinese": "我很困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:03:52",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:04:00",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:04:20",
            "content": "18歳ということは、この春ご入学されたんですか?",
            "Chinese": "18岁的话，是今年春天刚入学的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:04:30",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:04:47",
            "content": "おめでとうございます。",
            "Chinese": "恭喜您。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:04:59",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:06:02",
            "content": "新しい生活が始まっているのに、やる気が起きないんですね。もどかしいですね。",
            "Chinese": "明明开始了新的生活，却提不起干劲，真是让人着急难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:06:16",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:07:11",
            "content": "あなたのお力になりたいので、少し詳しくお聴きしたいのですが、",
            "Chinese": "我想尽力帮到您，可以请您再详细谈谈吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:07:23",
            "content": "お願いします",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:07:42",
            "content": "やる気がでないというのは、どんな感じでいらっしゃいますか?",
            "Chinese": "您说的提不起干劲，具体是种什么样的感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:08:18",
            "content": "大学に興味も無いし",
            "Chinese": "对大学也没兴趣，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:08:26",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:08:57",
            "content": "やりたいことも見つからないまま入学を迎えたという感じです",
            "Chinese": "感觉就像是还没找到想做的事情就开学了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:09:11",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:09:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:10:25",
            "content": "焦ってしまいますね。",
            "Chinese": "这会让人感到焦虑呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:10:40",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:10:58",
            "content": "焦るというより",
            "Chinese": "与其说是焦虑，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:11:06",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:11:29",
            "content": "何もやる気出なくて、どうでもいいって感じです",
            "Chinese": "不如说是对什么都提不起干劲，感觉怎么样都无所谓了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:12:05",
            "content": "そうでしたか…。",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:13:21",
            "content": "大学に興味がない、ということでしたが、高校時代は進路についてどのように考えておられたのですか?",
            "Chinese": "您说对大学没兴趣，那么高中时您对未来的发展是怎么考虑的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:14:04",
            "content": "第1希望の大学はあったのですが",
            "Chinese": "我本来是有第一志愿的大学的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:14:10",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:14:25",
            "content": "受験に失敗してしまって",
            "Chinese": "但是考试失败了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:14:41",
            "content": "（お聴きしています）",
            "Chinese": "（我在认真倾听。）"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:14:49",
            "content": "地元の三流大学しか受かりませんでした",
            "Chinese": "只考上了本地一所三流大学。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:15:08",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:15:18",
            "content": "最悪です",
            "Chinese": "真是糟透了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:15:27",
            "content": "それで、そちらに進学されたんですね。",
            "Chinese": "所以，您就去那所大学上学了，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:15:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:16:14",
            "content": "最悪、というのは、どんな感じですか?",
            "Chinese": "您说的“糟透了”，具体是种什么样的感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:16:40",
            "content": "受験に失敗して",
            "Chinese": "考试失败了，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:16:55",
            "content": "ええ、がっかりされましたよね。",
            "Chinese": "嗯，您一定很失望吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:17:08",
            "content": "親からは何でこんなことになったんだとか",
            "Chinese": "父母质问我怎么会变成这样，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:17:23",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:17:34",
            "content": "人生終わったなとか",
            "Chinese": "还说“人生完蛋了”之类的话。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:18:00",
            "content": "そんなことばかり言われて",
            "Chinese": "总是被这样说，"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:18:19",
            "content": "つらくてたまりません",
            "Chinese": "我难受得不得了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:18:53",
            "content": "そんなことを言われたんですね。そうですね。ひろやさん自身が一番がっくり来ているのに。辛いですよね。",
            "Chinese": "他们竟然对您说了这些话啊。是啊，明明弘也同学您自己才是最沮丧的，这一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:19:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:19:44",
            "content": "受験後、すぐに今の大学への進学を決めたのですか?",
            "Chinese": "考试之后，您是马上就决定去现在的大学了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:20:14",
            "content": "そこしか受からなかったので",
            "Chinese": "因为只考上了那一所。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:20:40",
            "content": "浪人はダメと言われてたので",
            "Chinese": "父母又说不许我复读。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:22:09",
            "content": "そうでしたか…。何かご家庭の事情がおありなのでしょうが、ひろやさんはどうされたかったですか?",
            "Chinese": "是这样啊……想必是有什么家庭原因吧，但弘也同学您自己当时是想怎么做的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:23:01",
            "content": "出来ればもう一度挑戦出来たらよかったですが",
            "Chinese": "如果可以的话，我希望能再挑战一次，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:23:10",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:23:20",
            "content": "浪人だけは絶対ダメだと",
            "Chinese": "但他们说绝对不许复读。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:23:46",
            "content": "頭悪い人間はダメだよねとか",
            "Chinese": "还说什么“脑子笨的人就是不行”之类的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:23:46",
            "content": "そうでしたか。悔しかったですね。",
            "Chinese": "是这样啊。那一定很不甘心吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:23:58",
            "content": "いつも聞かされていました",
            "Chinese": "我一直听他们这么说。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:24:34",
            "content": "お前の人生は終わったとかこんなことをずっ言われ続けるのでしょうか？",
            "Chinese": "难道我要一直被说“你的人生完蛋了”这样的话吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:26:47",
            "content": "そんなことを言われ続けると、前をむいて進む気に慣れないのは自然なことだと思います。苦しいですね。",
            "Chinese": "一直被说这样的话，自然会没有心情向前看的。这一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:27:05",
            "content": "はい、苦しいです",
            "Chinese": "是的，很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:27:40",
            "content": "ひろやさんは、親御さんのそのような言葉を聴いて、どんな風に思われますか?",
            "Chinese": "弘也同学，听到父母这些话，您内心是怎样想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:28:28",
            "content": "両親はどちらもエリート意識が高いので",
            "Chinese": "我父母都有很强的精英意识，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:28:35",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:29:01",
            "content": "当たり前のように頭の悪い人をけなしていました",
            "Chinese": "他们理所当然地看不起脑子笨的人。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:29:08",
            "content": "だから",
            "Chinese": "所以，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:29:21",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:29:32",
            "content": "自分がそっちの人になって",
            "Chinese": "当我成了被他们归到那一类的人，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:29:48",
            "content": "（聴いています）",
            "Chinese": "（我在认真倾听。）"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:30:05",
            "content": "そんなふうな扱いを受けるのは",
            "Chinese": "会受到那样的对待，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:30:18",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:30:28",
            "content": "そうなんだろうなと思いました",
            "Chinese": "我就觉得，大概就是那样了吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:30:36",
            "content": "まさか自分が",
            "Chinese": "没想到自己"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:30:44",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:31:01",
            "content": "親からけなされるようになるなんて",
            "Chinese": "会被父母这样贬低。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:31:09",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:31:19",
            "content": "こんなことが続けば",
            "Chinese": "如果这种情况一直持续下去，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:31:26",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:31:31",
            "content": "消えてしまいたいですね",
            "Chinese": "我真想消失算了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:31:50",
            "content": "そこまで、追い詰められた気持ちなんですね。",
            "Chinese": "您的心情已经被逼到这种地步了啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:32:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/08(木) 20:32:30",
            "content": "どうしたらいいんでしょうか？",
            "Chinese": "我该怎么办才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/08(木) 20:32:35",
            "content": "深く傷きましたね。",
            "Chinese": "您受到了很深的伤害呢。"
        },
        {
            "role": "クライアント",
