{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:00:17",
            "content": "こんばんは。本日はよろしくお願い致します。",
            "Chinese": "晚上好。今天还请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:00:27",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:00:43",
            "content": "早速始めさせていただきますね。",
            "Chinese": "那么我们马上开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:01:02",
            "content": "お願いいたします。",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:01:08",
            "content": "こんばんは。相談員です。本日はお越し下さりありがとうございます。はじめに年齢と性別を教えていただけますでしょうか？",
            "Chinese": "晚上好，我是咨询员。感谢您今天前来咨询。首先，可以请您告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:01:34",
            "content": "24歳男です。",
            "Chinese": "24岁，男性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:01:41",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:01:58",
            "content": "本日はどういった相談内容でしょうか？",
            "Chinese": "今天您想咨询哪方面的问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:04:31",
            "content": "自分、ウバーイーツで仕事してるんですけど、品物の質が悪いとか、態度が悪いなどとイチャモンつけられて悩んでます。",
            "Chinese": "我在优步外卖工作，但总被人找茬，说我送的东西质量差、态度不好之类的，这让我很困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:04:52",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:05:16",
            "content": "それはどうしてそのような状態になったと考えられますか？",
            "Chinese": "您认为是什么原因导致了这种情况呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:06:12",
            "content": "自分なりには良いやり方をしてると思うので、わかりません。",
            "Chinese": "我觉得自己的做法已经很好了，所以不太明白。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:06:27",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:06:50",
            "content": "良かれと思った行動を勘違いされるのは悲しいですね。",
            "Chinese": "出于好意的行为却被误解，这确实令人难过。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:07:04",
            "content": "そうですね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:07:38",
            "content": "毎回クレームを言われるのでしょうか？",
            "Chinese": "是每次都会被投诉吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:08:18",
            "content": "同じお客様から毎回言われます。",
            "Chinese": "是同一个客人每次都投诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:08:29",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:08:47",
            "content": "それは参ってしまいますよね。",
            "Chinese": "那确实让人吃不消。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:09:16",
            "content": "どうすればいいですかね。",
            "Chinese": "我该怎么办才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:09:48",
            "content": "そうですね。一緒に考えていきましょう。",
            "Chinese": "说的是呢。我们一起来想办法吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:10:08",
            "content": "その方からは主に対応のことを言われるのでしょうか？",
            "Chinese": "那位客人主要是在说您服务态度方面的问题吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:10:25",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:10:33",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:10:48",
            "content": "どういった対応のことを言われるのですか？",
            "Chinese": "他具体是说您服务态度哪里有问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:12:07",
            "content": "無駄話が多いと言われます。",
            "Chinese": "他说我废话太多。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:12:19",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:12:34",
            "content": "それを言われてご自身ではどう思いますか？",
            "Chinese": "听到他这么说，您自己是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:13:21",
            "content": "どう改善したらいいのかわからなくて、困っています。",
            "Chinese": "我不知道该怎么改进，很困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:13:31",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:14:07",
            "content": "「無駄話が多い」と言われた時は思い当たる節などはありましたか？",
            "Chinese": "当他跟您说“废话太多”的时候，您有想到可能是指什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:15:46",
            "content": "こちらご注文頂きました、〇〇ですと言って商品を渡してすぐ帰るのですが、そこでイチャモンつけられます。",
            "Chinese": "我只是说“这是您点的餐，XX”，然后把东西交给他马上就走了，但还是会被他找茬。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:16:07",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:16:35",
            "content": "このことに関して誰かに相談はされましたか？",
            "Chinese": "关于这件事，您有和谁商量过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:18:26",
            "content": "会社に相談しているんですけど、お客様に自分で聞いてみたらどうかと言われていて、直接聞いたのですが、お客様に自分で考えてみろと言われてどうすればいいのかわかりません。",
            "Chinese": "我跟公司反映过，但他们让我自己去问客人。我直接问了，但客人又让我自己想，我真的不知道该怎么办了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:18:50",
            "content": "それは困ってしまいますよね。",
            "Chinese": "那确实让人很为难。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:19:34",
            "content": "その方はいつからそのような対応をされるのですか？",
            "Chinese": "那位客人从什么时候开始是这种态度的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:19:57",
            "content": "最初からです。",
            "Chinese": "从一开始就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:20:18",
            "content": "そうですか。それはお辛いですよね。",
            "Chinese": "是吗？那您一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:20:33",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:21:35",
            "content": "自分で考えた結果は「どう改善したら良いかわからない」ということなのでしょうか？",
            "Chinese": "您自己思考后的结果是“还是不知道如何改进”，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:22:10",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:22:17",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:22:31",
            "content": "そのことはお客様にお伝えになられましたか？",
            "Chinese": "这件事您有告诉那位客人吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:23:53",
            "content": "そのことって、なんですか？",
            "Chinese": "您说“那点”是指什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:25:21",
            "content": "言葉足らずで申し訳ございません。お客様に「自分で考えろ」と言われたけれどあなたが考えた結果「どう改善したら良いかわからない」ということについてです。",
            "Chinese": "抱歉我没说清楚。我是指，客人让您“自己想”，而您自己思考后的结果是“不知道该如何改进”这件事。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:26:23",
            "content": "なるほど。",
            "Chinese": "哦，原来是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:26:42",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:28:22",
            "content": "先程の質問についてですか、またクレームを言われるのが怖くて伝えられてません。",
            "Chinese": "关于您刚才的问题，我因为害怕再次被投诉，所以没能告诉他。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:28:39",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:29:07",
            "content": "また言われるかもしれないという怖さを持つのも無理はないですよね。",
            "Chinese": "会害怕可能又被说些什么，这种心情是可以理解的。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:29:21",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:31:07",
            "content": "クレームを毎回言われるお客様以外のお客様を接客してみてその反応はいかがですか？",
            "Chinese": "除了那位每次都提投诉的客户之外，您接待其他客户时，他们的反应如何呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:33:51",
            "content": "他のお客様からは、ありがとうなど、接客の態度いいねと褒めてもらうことがあります。",
            "Chinese": "其他客人有时会跟我说谢谢，或者称赞我服务态度很好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:34:07",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:34:17",
            "content": "それは励みになりますね。",
            "Chinese": "那真是很鼓舞人心呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:40:19",
            "content": "態度を褒めてもらった時はどう感じられましたか？",
            "Chinese": "当您的服务态度受到称赞时，您有什么感觉？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:41:52",
            "content": "頑張ろうって思いますね。",
            "Chinese": "会觉得要继续加油。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:42:09",
            "content": "そうですね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:43:10",
            "content": "話は戻りますが、クレームを言われるお客様は同僚の方からは購入されますか？",
            "Chinese": "我们再说回原来的话题，那位投诉您的客人，他会从您的同事那里点餐吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:44:40",
            "content": "はい、同僚もイチャモンをつけられるって言ってました。",
            "Chinese": "会的，我同事也说会被他找茬。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:44:52",
            "content": "なるほど。そうでしたか。",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:45:48",
            "content": "そのクレームを言われるお客様があなたに依頼する頻度はどれくらいですか？",
            "Chinese": "那位会投诉的客户向您下单的频率大概是多少？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:46:20",
            "content": "3日に1回くらいです",
            "Chinese": "大概三天一次。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:46:34",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:47:18",
            "content": "依頼が入るとどういう感情になりますか？",
            "Chinese": "一接到他的订单，您会有什么感受？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:47:45",
            "content": "またあの人かと思ってしまいます。",
            "Chinese": "会想“又是那个人啊”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:48:19",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:48:36",
            "content": "同僚の方はどのように思っておられるのでしょうか？",
            "Chinese": "您的同事对此又是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:49:00",
            "content": "まだそこは聞いていません。",
            "Chinese": "这方面我还没问过他们。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:49:10",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:50:41",
            "content": "クレームを言われるお客様に「自分なりに考えたけれどわからない」ということを伝えるとどうなると思いますか？",
            "Chinese": "如果您告诉那位投诉的客人，“我自己想过了但还是不明白”，您觉得会怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:51:45",
            "content": "「知らねーよ。会社に聞けよ。」って言われると思います。",
            "Chinese": "我觉得他会说：“我哪知道，去问公司吧。”"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:51:52",
            "content": "なるほど。",
            "Chinese": "我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:52:12",
            "content": "強く言われると思います。",
            "Chinese": "我觉得他会用很强硬的口气说。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:52:30",
            "content": "そうですか。",
            "Chinese": "这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:52:45",
            "content": "会社にもう一度相談されてみるのはいかがですか？",
            "Chinese": "再和公司商量一次，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:53:30",
            "content": "何度も相談しましたが、解決しませんでした。",
            "Chinese": "我已经商量过很多次了，但都没有解决。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:54:31",
            "content": "解決しないというのは会社に聞いてもらえないということでしょうか？",
            "Chinese": "所谓的没解决，是指公司不听取您的意见吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:55:41",
            "content": "話が長くなってしまって、解決に至りません。",
            "Chinese": "每次都说很久，但就是没能解决问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:55:54",
            "content": "なるほど。そうだったのですね。",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:56:12",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:56:42",
            "content": "お話を伺っていたいのですが、そろそろお時間になってしまいました。本日お話しされてみていかがでしたでしょうか？",
            "Chinese": "我本想继续听您说，但时间差不多到了。今天聊下来您感觉怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/10/24(日) 21:59:13",
            "content": "話を聞いてもらって気持ちが少し楽になりました。",
            "Chinese": "有人听我倾诉，感觉心情轻松了一些。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/10/24(日) 21:59:26",
            "content": "そうでしたか。それはよかったです。",
            "Chinese": "是这样啊，那太好了。"
        },
        {
