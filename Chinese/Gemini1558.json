{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:21:28",
            "content": "おはようございます。本日、カウンセラー役をさせていただきます。",
            "Chinese": "早上好。今天由我担任咨询师。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:21:37",
            "content": "お時間になりましたら、どうぞよろしくおねがい致します。",
            "Chinese": "到时间后，还请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:25:35",
            "content": "おはよう御座います。本日はよろしくお願いいたします。",
            "Chinese": "早上好。今天请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:30:26",
            "content": "それでは、始めさせていただきます。どうぞよろしくおねがい致します。",
            "Chinese": "那么，我们现在开始吧。请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:30:40",
            "content": "おはようございます。相談員です。",
            "Chinese": "早上好。我是咨询员。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:30:46",
            "content": "本日はどうされましたか？",
            "Chinese": "您今天想谈些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:31:16",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:32:17",
            "content": "友人が仕事で疲れている様子で",
            "Chinese": "我的朋友看起来因为工作很疲惫，"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:32:29",
            "content": "なんとかしてあげたいです",
            "Chinese": "我很想为他做点什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:32:41",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:32:48",
            "content": "それは、心配になりますね。",
            "Chinese": "那确实会让人担心呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:32:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:33:19",
            "content": "上司との人間関係が特に悩んでる様子です",
            "Chinese": "他好像尤其为与上司的人际关系而烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:33:49",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:33:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:35:02",
            "content": "上司との人間関係は、大変ですよね。お友達を思う心配されるお気持ち、伝わってきます。",
            "Chinese": "和上司的人际关系确实很辛苦呢。我能感受到您为朋友担心的心情。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:35:44",
            "content": "はい、大変そうです。",
            "Chinese": "是的，他看起来很辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:37:10",
            "content": "お友達は、どのようなお友達なのか、お伺いしてもよろしいでしょうか？",
            "Chinese": "可以请您谈谈您的朋友是怎样一个人吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:38:10",
            "content": "中学時代のクラスメートで同じバレーボール部に所属してました",
            "Chinese": "我们是初中时的同班同学，还一起待过排球部。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:38:44",
            "content": "そうなのですね。それ以来ずっと仲が良いお友達なのですか？",
            "Chinese": "是这样啊。从那以后你们就一直是很好的朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:39:00",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:40:18",
            "content": "そうなのですね。長い付き合いのお友達が、仕事で悩まれていたら、やはり心配になってしまいますよね。",
            "Chinese": "是这样啊。相处多年的朋友因为工作而烦恼，确实会让人很担心呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:40:49",
            "content": "はい。そう思います。",
            "Chinese": "是的，我也是这么想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:41:25",
            "content": "お友達は、上司との関係について、どのようにおっしゃっていますか？",
            "Chinese": "关于和上司的关系，您的朋友是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:43:15",
            "content": "事あるごとにガミガミ言い、仕事がしづらく、",
            "Chinese": "他说上司动不动就唠叨个没完，让他很难开展工作，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:43:24",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:43:29",
            "content": "関わるとストレスを感じるそうです。",
            "Chinese": "据说一和他打交道就感到很有压力。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:43:47",
            "content": "なるほど、そうなのですね。",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:43:55",
            "content": "それは大変そうですね。",
            "Chinese": "那听起来确实很辛苦。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:43:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:44:07",
            "content": "大変そうです",
            "Chinese": "看起来很辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:44:59",
            "content": "それを聞いた時、どのようなお気持ちでしたか？",
            "Chinese": "听到这些时，您是什么心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:45:41",
            "content": "なんとかしたいと思いました",
            "Chinese": "我想设法为他做点什么。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:46:15",
            "content": "ただ自分に何ができるかわからないという感じです",
            "Chinese": "但就是感觉不知道自己能做些什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:46:30",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:46:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:46:39",
            "content": "先ほども書きましたが、",
            "Chinese": "我刚才也提到了，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:46:59",
            "content": "友達を思われている気持ちがとても伝わってきます。お優しいのですね。",
            "Chinese": "我能深切感受到您为朋友着想的心情。您真是个温柔的人。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:47:18",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:47:39",
            "content": "中学の頃からのお付き合いとのことでしたが、",
            "Chinese": "您提到你们从初中就开始认识了，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:48:03",
            "content": "以前にも同じような気持ちになったことはありましたか？",
            "Chinese": "以前您也有过类似的心情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:49:09",
            "content": "以前も少し悩んでるようでしたが、",
            "Chinese": "他以前好像也有些烦恼，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:49:16",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:49:32",
            "content": "今はもっと悩んでるようすです",
            "Chinese": "但现在看起来他更烦恼了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:49:48",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:49:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:51:17",
            "content": "お友達が相談されてきた時のご様子はどのような感じでしたか？",
            "Chinese": "您的朋友来找您倾诉时，他是什么样子的呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:51:50",
            "content": "体調などについておっしゃっていたりはしたでしょうか？",
            "Chinese": "他有没有提到身体状况之类的事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:52:18",
            "content": "普段より表情が暗かったです",
            "Chinese": "他的表情比平时要黯淡一些。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:52:33",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:53:16",
            "content": "相談されたというより、仕事のことかな？と察知しました",
            "Chinese": "与其说是他找我倾诉，不如说是我察觉到他可能是在为工作烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:53:57",
            "content": "そうなのですね。直接言われた訳ではなかったのですね。",
            "Chinese": "是这样啊。所以他并没有直接告诉您呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:54:57",
            "content": "どちらかというとそうなります。",
            "Chinese": "差不多是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:55:19",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:55:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:57:02",
            "content": "以前の話に戻ってしまうのですが、",
            "Chinese": "我们稍微回到之前的话题，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:57:38",
            "content": "以前お友達が少し悩まれていた時も、何かしてあげたいな、という風にお思いになりましたか？",
            "Chinese": "以前您的朋友有点烦恼的时候，您是否也想过“想为他做点什么”呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 10:58:24",
            "content": "思いました。",
            "Chinese": "想过。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 10:59:09",
            "content": "その時は、どのようにお友達にして差し上げましたか？",
            "Chinese": "那个时候，您为朋友做了些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:00:03",
            "content": "そうですね…",
            "Chinese": "嗯，我想想…"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:01:14",
            "content": "相談できる先輩に、上司との上手い関わり方を聞いてみるのは？",
            "Chinese": "我问他要不要去问问可以商量的前辈，该怎么和上司好好相处？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:01:29",
            "content": "と言いました",
            "Chinese": "我是这么说的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:02:04",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:02:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:02:15",
            "content": "お友達はどのような反応でしたか？",
            "Chinese": "您的朋友是什么反应呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:03:26",
            "content": "「そうするよ」と言ってました",
            "Chinese": "他说了“我会那么做的”。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:04:06",
            "content": "私は「なにかあればいつでも相談して」とも言いました",
            "Chinese": "我还对他说：“有什么事随时都可以来找我聊。”"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:04:46",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:04:50",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:06:39",
            "content": "なにかあればいつでも相談して、という言葉に対して、お友達はどのような反応でしたか？",
            "Chinese": "对于您说的“有什么事随时都可以跟我说”这句话，您的朋友有什么反应呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:06:53",
            "content": "「ありがとう」と言ってました",
            "Chinese": "他说了声“谢谢”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:07:49",
            "content": "そうだったのですね。その時どのようなお気持ちでしたか？",
            "Chinese": "是这样啊。那时您是什么心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:09:42",
            "content": "まずは見守ろうと思いました。",
            "Chinese": "我当时想，先在一旁默默守护吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:10:08",
            "content": "様子を見てまたできることをしようと思いました",
            "Chinese": "我想先看看情况，再做些力所能及的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:11:02",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:11:28",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:13:33",
            "content": "見守られて、お友達のその後ご様子はいかがでしたか？話が少し飛んでしまうかもしれませんが、その後、現在の大変そうに見える状況、という事で大丈夫でしょうか？",
            "Chinese": "您在一旁观察，之后您朋友的情况如何呢？话题可能有点跳跃，在那之后，就到了现在这个看起来很辛苦的状况，这样理解对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:13:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:13:54",
            "content": "仰せの通りです",
            "Chinese": "您说的没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:14:14",
            "content": "なるほど、そうなのですね。",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:14:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:15:25",
            "content": "見守っているお友達が、辛そうに見えるのは、ご自身にとっても辛いお気持ちになりますよね。",
            "Chinese": "看着自己在一旁默默守护的朋友那么痛苦，您自己心里也会很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:15:46",
            "content": "そうですね…",
            "Chinese": "是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:16:58",
            "content": "今回、お友達に実際にして差し上げたことは何かありましたか？",
            "Chinese": "这一次，您实际为朋友做了些什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:18:50",
            "content": "仕事は続ける予定？と聞いたら",
            "Chinese": "我问他：“还打算继续这份工作吗？”"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:18:59",
            "content": "はい。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:18:59",
            "content": "続けると言ってました",
            "Chinese": "他说会继续做。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:19:20",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:19:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:20:14",
            "content": "同じ質問をしてしまって恐縮なのですが、その時にどのようにお感じになりましたか？",
            "Chinese": "很抱歉问了同样的问题，当时您有什么感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:21:56",
            "content": "そうですね…",
            "Chinese": "嗯，我想想……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:22:38",
            "content": "その意思を尊重しようと思いました",
            "Chinese": "我当时想，应该尊重他的决定。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:22:54",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:23:19",
            "content": "あとは趣味を聞いたり、平日に何かできそうなことも聞きました",
            "Chinese": "另外我还问了他的兴趣爱好，以及平日里有什么可以做的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:23:44",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:23:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:24:01",
            "content": "その時のお友達はどのような様子でしたか？",
            "Chinese": "那时您的朋友是什么样子的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:25:35",
            "content": "詳しく覚えてないですが、気を紛らすことは少しはできた気がします",
            "Chinese": "具体细节我记不太清了，但感觉他多少也分散了一些注意力。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:26:38",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:26:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:27:37",
            "content": "今日お話を伺っていて、とてもお友達のことを心配されて、思われているのがとても伝わってきました。",
            "Chinese": "今天听您说了这么多，我深切地感受到您非常担心和关心您的朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:28:14",
            "content": "そして、お友達に何かしてあげられることはないか、とても考えておられる。",
            "Chinese": "而且，您一直在认真思考能为朋友做些什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:28:40",
            "content": "しかも、ご自身の意見をアドバイス的に言うのではなくて、",
            "Chinese": "并且，您不是以提建议的方式说出自己的意见，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:28:59",
            "content": "見守られたり、尊重したり、",
            "Chinese": "而是在一旁守护、尊重他，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:29:45",
            "content": "質問をしたりして、",
            "Chinese": "通过提问的方式，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:30:12",
            "content": "本当の意味でのお気遣いをされている、そんな印象を受けました。",
            "Chinese": "给我的印象是，您在做真正意义上的体贴与关怀。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:30:33",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:31:05",
            "content": "何が出来るかわからない、という事で本日ご相談いただいておりますが、",
            "Chinese": "您今天来咨询是因为“不知道自己能做什么”，"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:31:30",
            "content": "私自身、アドバイス的な意見を言われるのが苦手なので、相手を尊重することを第一に、と思いました",
            "Chinese": "因为我自己也不喜欢别人给我提建议式的意见，所以我觉得首先要尊重对方。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:31:50",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:32:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:32:49",
            "content": "先ほど、お友達からありがとう、と言われた、という件をお話いただきました。",
            "Chinese": "刚才您提到，您的朋友对您说了“谢谢”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:33:33",
            "content": "それはご自身が相手を尊重することを第一に考え、お友達にされたことが、伝わった、という事ではないでしょうか？",
            "Chinese": "这不正是因为您把尊重对方放在第一位，您为朋友所做的一切，他都感受到了吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:33:55",
            "content": "今回、さらに辛い様子なお友達にも、",
            "Chinese": "这一次，面对看起来更辛苦的朋友，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:34:16",
            "content": "先ほどのように、質問したり、尊重したりして、接していらっしゃる。",
            "Chinese": "您也像之前一样，通过提问、尊重他的方式与他相处。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:34:53",
            "content": "伝わりましたかね？そうであれば嬉しいです！",
            "Chinese": "他感受到了吗？如果是那样的话就太好了！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:35:16",
            "content": "今のお話を伺っていて、伝わっていると私は感じました。",
            "Chinese": "听了您刚才的话，我觉得他是感受到了的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:35:59",
            "content": "お友達も、苦しい時にそんな風に接してくれて、嬉しかったからこその「ありがとう」だったのではないでしょうか？",
            "Chinese": "您的朋友也正是在痛苦的时候，您能那样对待他，他感到很开心，所以才说了那句“谢谢”吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:36:10",
            "content": "確信はないですが、そうであれば良いです！",
            "Chinese": "虽然不敢确定，但如果是那样就太好了！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:37:42",
            "content": "私は、そう感じました。",
            "Chinese": "我就是这样感受到的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:37:55",
            "content": "本当に気遣いの出来る、優しい方だと思いました。",
            "Chinese": "我觉得您真的是一位懂得体贴、很温柔的人。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:38:19",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:38:22",
            "content": "不安になられるのも、お友達を思われているからこそ、のように感じます。",
            "Chinese": "我感觉，您之所以会感到不安，也正是因为您很在乎您的朋友。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:39:04",
            "content": "相談員さんのおかげで安心できました",
            "Chinese": "多亏了咨询员，我安心多了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:39:33",
            "content": "それはよかったです。",
            "Chinese": "那太好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:40:10",
            "content": "そろそろお時間になりますが、お答えになりましたでしょうか？",
            "Chinese": "时间差不多了，不知我的回答是否对您有所帮助？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:40:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:40:25",
            "content": "相談できてよかったです",
            "Chinese": "能和您谈谈真是太好了。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:40:27",
            "content": "！",
            "Chinese": "！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:40:41",
            "content": "そう言っていただけてよかったです。",
            "Chinese": "听您这么说我很高兴。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:40:53",
            "content": "それでは本日はこちらで失礼いたします。",
            "Chinese": "那么今天就到这里结束了。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:41:12",
            "content": "ありがとうございました",
            "Chinese": "非常感谢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/03(土) 11:41:17",
            "content": "失礼いたします",
            "Chinese": "那我先告辞了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/03(土) 11:41:29",
            "content": "ありがとうございました。失礼いたします。",
