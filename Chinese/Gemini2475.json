{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 09:50:39",
            "content": "こんにちは。どうもありがとうございます。どうぞよろしくお願いいたします。",
            "Chinese": "您好。非常感谢您。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 09:51:25",
            "content": "クライエント役をさせて頂きます。よろしくお願い致します。",
            "Chinese": "我将担任来访者角色，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 09:52:21",
            "content": "お時間になりましたら、始めさせていただきたいと思います。よろしいでしょうか。",
            "Chinese": "时间到了，我想我们可以开始了。可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 09:52:29",
            "content": "はい、大丈夫です。",
            "Chinese": "好的，没问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 09:52:50",
            "content": "どうぞ、よろしくお願いいたします。",
            "Chinese": "那么，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 09:53:12",
            "content": "こちらこそよろしくお願いします。",
            "Chinese": "我也请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:00:37",
            "content": "こんにちは。相談員です。ご相談にお越しいただいて、どうもありがとうございます。",
            "Chinese": "您好，我是咨询师。非常感谢您前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:00:43",
            "content": "ここの話は、どこにも漏れない？",
            "Chinese": "这里说的话，不会外传吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:02:50",
            "content": "安心してお話しください。ここだけのお話しでお聴きしますので。あなたが、少しでも楽になるように、お話をお聴きしたいとおみます。",
            "Chinese": "请您放心倾诉。我们的谈话内容不会外泄，我会在这里倾听。我希望能倾听您的心声，让您能稍微轻松一些。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:03:10",
            "content": "わかりました。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:03:21",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:03:30",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:03:57",
            "content": "相談にあたって、まずはじめに、よろしかったら、年齢と性別を教えていただけますか。",
            "Chinese": "在开始咨询之前，如果方便的话，能请您告诉我年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:04:16",
            "content": "50歳　男性",
            "Chinese": "50岁，男性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:04:32",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:04:49",
            "content": "今日は、どのようなご相談でしょうか。",
            "Chinese": "今天，您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:05:12",
            "content": "これからどうしたらいいか",
            "Chinese": "接下来该怎么办。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:05:23",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:05:42",
            "content": "そう思われると悩まれますね。",
            "Chinese": "您这样想一定很困扰吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:05:58",
            "content": "まあ",
            "Chinese": "嗯，算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:07:02",
            "content": "あなたが少しでも、楽に過ごせるよう一緒に考えていきたいと思いますので、どんなことでも安心して、お話しください。",
            "Chinese": "为了让您能稍微轻松一些，我希望能和您一起思考，所以任何事情都请您放心地说出来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:07:13",
            "content": "どんなことが、ありましたか",
            "Chinese": "发生了什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:07:46",
            "content": "最近の時代についていけない。",
            "Chinese": "我跟不上最近这个时代了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:08:16",
            "content": "そう思われるのですね。",
            "Chinese": "您有这样的感受啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:08:49",
            "content": "具体的には、どのようなことで、そう思われるのでしょうか",
            "Chinese": "具体来说，是什么事情让您有这种感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:09:21",
            "content": "管理職をしているけど、",
            "Chinese": "虽然我担任管理职务，"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:10:02",
            "content": "部下の提案や考え方が理解できない",
            "Chinese": "但无法理解下属的建议和想法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:10:33",
            "content": "そんなことが、あったのですね。",
            "Chinese": "原来发生过这样的事啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:10:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:10:49",
            "content": "そう思われると、悩みますね。",
            "Chinese": "您这样想一定很烦恼吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:12:47",
            "content": "気がついたら50歳で",
            "Chinese": "回过神来已经50岁了，"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:13:04",
            "content": "今のままでいいのかと思う",
            "Chinese": "我在想，现在这样下去真的好吗。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:13:28",
            "content": "そうなのですね。管理職ですと、いろいろな事に神経を使われますよね。",
            "Chinese": "是这样啊。作为管理层，确实要为很多事情费心呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:13:45",
            "content": "そう思われたのは、いつごろからですか",
            "Chinese": "您是从什么时候开始有这种感觉的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:13:53",
            "content": "まあ、、仕事だからね。",
            "Chinese": "嗯……毕竟是工作嘛。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:14:08",
            "content": "ここ1年ぐらい",
            "Chinese": "大概最近一年吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:15:06",
            "content": "その間、もやもしゃして過ごされてきたのですね。",
            "Chinese": "这段时间您一直感到很迷茫吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:15:45",
            "content": "コロナもあって、変わってしまって、",
            "Chinese": "也是因为疫情，一切都变了，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:16:04",
            "content": "（ええ、お聴きしていますね。）",
            "Chinese": "（嗯，我在认真倾听。）"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:16:18",
            "content": "自分みたいな人間はどうしたらいいかと、",
            "Chinese": "像我这样的人该怎么办呢，"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:16:41",
            "content": "器用じゃないし、仕事一筋で、",
            "Chinese": "我又不够灵活，一直埋头于工作，"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:17:45",
            "content": "先が見えない",
            "Chinese": "看不到未来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:18:29",
            "content": "そう思われるのですね。",
            "Chinese": "您会有这样的感受啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:18:46",
            "content": "そう思わわれると、不安になりますね。",
            "Chinese": "您这样想一定感到不安吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:19:09",
            "content": "不安というか、",
            "Chinese": "与其说是不安，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:19:23",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:19:58",
            "content": "言われた仕事ををしてきて、家族のために働いてきたけど、",
            "Chinese": "我一直都做着被安排的工作，为了家人而工作，但是，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:20:13",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:20:31",
            "content": "どこにも居場所がない",
            "Chinese": "却感觉哪里都没有我的容身之处。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:20:58",
            "content": "そう思われるのは、寂しいですね。",
            "Chinese": "这样想一定很孤独吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:21:25",
            "content": "これってAI？",
            "Chinese": "这是AI吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:21:46",
            "content": "いいえ、ごめんなさい、違います。",
            "Chinese": "不，不好意思，不是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:22:00",
            "content": "わかりました",
            "Chinese": "明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:22:11",
            "content": "そう思われたら、ごめんなさいね。",
            "Chinese": "如果让您有那样的感觉，很抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:22:31",
            "content": "いえ",
            "Chinese": "没事。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:22:38",
            "content": "大丈夫です",
            "Chinese": "没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:22:53",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:23:32",
            "content": "お話ししにくいことをお話ししてくださって、どうもありがとうございます。",
            "Chinese": "非常感谢您愿意说出这些难以启齿的事情。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:23:58",
            "content": "いえ、うまく話せなくて",
            "Chinese": "哪里，是我没说好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:24:30",
            "content": "いいえ、あなたの苦しい状況伝わってきています。",
            "Chinese": "不，我已经感受到了您痛苦的处境。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:25:24",
            "content": "ここで、お話を伺ったことをまとめさせていただいても、よろしいでしょうか。",
            "Chinese": "我可以先总结一下刚才听到的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:25:29",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:25:55",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:28:26",
            "content": "これから、どうしてよいかとのご相談。管理職をされていて、１年前から部下の提案や考えにたいして、理解できないと思われている。",
            "Chinese": "您咨询的是关于“接下来该怎么办”。您担任管理职务，从一年前开始，就觉得无法理解下属的建议和想法。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:29:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:30:25",
            "content": "お仕事は、家族のために、頑張ってきたが、いま、自分の居場所がないと感じている",
            "Chinese": "您为了家人努力工作，但现在却感觉没有自己的容身之处。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:30:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:30:53",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:31:36",
            "content": "あなたは、管理職になられ、お仕事に力を注いでこられたのですね。",
            "Chinese": "您担任管理职务，一直全力以赴地工作呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:31:58",
            "content": "まあ、そうですね。",
            "Chinese": "嗯，算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:32:36",
            "content": "ここめで、こられたのは、あなたがお仕事にたいして、真摯に向かわれていたことだと思います。",
            "Chinese": "能一路走到今天，我想是因为您一直以来都以认真诚挚的态度面对工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:33:11",
            "content": "「ここまで」でした。",
            "Chinese": "应该说“到这里为止”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:33:26",
            "content": "ごめんなさいね。",
            "Chinese": "抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:33:27",
            "content": "だって仕事はしないといけないでしょう。仕事なんだから。",
            "Chinese": "可不做也不行啊，毕竟是工作嘛。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:33:33",
            "content": "大丈夫です",
            "Chinese": "没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:33:50",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:34:01",
            "content": "そう思われるのですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:34:39",
            "content": "働かないと家族食べさせていけないでしょう。",
            "Chinese": "不工作就养不活家人了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:35:24",
            "content": "そうですね。家族のために、お仕事すること、大切ですよね。",
            "Chinese": "是啊。为了家人而工作，是很重要的呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:35:54",
            "content": "ご家族は、何人いらっしゃるのでしょうか",
            "Chinese": "您家里有几位成员呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:36:42",
            "content": "大切というか、しないといけないから。",
            "Chinese": "与其说是重要，不如说是必须做。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:36:57",
            "content": "自分入れて3人です",
            "Chinese": "包括我在内一共3个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:37:11",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:38:32",
            "content": "あなたが、おひとりで、守らなければと感じていいらっしゃるのですね。",
            "Chinese": "您是不是觉得必须由您一个人来扛起守护家庭的责任呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:38:41",
            "content": "いかがでしょうか",
            "Chinese": "是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:39:33",
            "content": "男で一家を支えないといけないから。",
            "Chinese": "因为作为男人就得撑起这个家。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:40:37",
            "content": "そう思われると責任を強く感じますね。",
            "Chinese": "您这样想一定感到责任重大吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:41:08",
            "content": "ご家族とは、どのように過ごされているのでしょうか",
            "Chinese": "您和家人平时是怎么相处的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:41:26",
            "content": "家族を持つのはそういう事でしょう。",
            "Chinese": "有了家庭不就是这么回事吗。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:41:39",
            "content": "今は各自バラバラ",
            "Chinese": "现在各自过各自的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:42:15",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:42:57",
            "content": "子どもも大きいし",
            "Chinese": "孩子也大了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:43:43",
            "content": "なるほど・・。各自、ご自身のコミュニティを持たれている様子でしょうか。",
            "Chinese": "原来如此……。是说每个人都有了自己的社交圈子吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:44:00",
            "content": "そうなるのかな。",
            "Chinese": "大概就是那样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:44:50",
            "content": "なるほど・・・。あなたご自身は、この状態をどのように感じますか",
            "Chinese": "我明白了……您自己对这样的状态有什么感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:45:38",
            "content": "わからない",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:48:33",
            "content": "もしかしたら、子どもが大きくなて、それぞれの世界を持つことは嬉しいが、それぞれに過ごす時間が多くなった寂しさも感じていらっしゃる、ように思いました。",
            "Chinese": "我感觉，或许您一方面为孩子长大、拥有了各自的世界而感到欣喜，但另一方面，也因为彼此各自度过的时间变多了，而感到了一丝寂寞。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:48:41",
            "content": "いかがでしょうか",
            "Chinese": "您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:49:46",
            "content": "妻に任せて、あんまり育児もしてこなかったから仕方ないです。",
            "Chinese": "我把事情都交给妻子，自己也没怎么参与育儿，所以这也是没办法的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:50:22",
            "content": "そう思われるのですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:50:47",
            "content": "まあ、はい",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:52:44",
            "content": "奥さんに、任せていらして、お仕事に力を注いでこら出たのですね。",
            "Chinese": "您把家里的事交给太太，自己则专注于工作，是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:53:29",
            "content": "忙しくしてたので、そうしてしまいました。",
            "Chinese": "因为一直很忙，就不知不觉变成这样了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:54:58",
            "content": "家族のために、お子さんのためにも、お仕事をすることを優先されてきたことは、責任を果たされていますよね。",
            "Chinese": "为了家人，也为了孩子，您优先选择工作，这本身就是尽到了责任呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:55:56",
            "content": "そうしないと食べていけなかったから。",
            "Chinese": "不那样做就维持不了生计。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:56:53",
            "content": "お仕事をすることは、そうですよね。家族を守るために、お仕事されてきたことは、あなたが家族を大切にされていることと思います。",
            "Chinese": "工作确实是这样呢。您为了守护家人而一直工作，我想这正是您珍视家人的表现。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:57:42",
            "content": "いや、妻も子も自分には冷たいです。",
            "Chinese": "不，妻子和孩子对我都很冷淡。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:58:14",
            "content": "そう思われるのは、悲しいですね。",
            "Chinese": "您这样想一定很伤心吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:58:42",
            "content": "ご家族にあなたの家族を思う気持ちを感じていただけたら、嬉しいですね。",
            "Chinese": "如果家人能感受到您对家庭的那份心意，那就太好了。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 10:58:56",
            "content": "いや、無理でしょう。",
            "Chinese": "不，恐怕不可能吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 10:59:10",
            "content": "そう思われるのですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:00:21",
            "content": "それは、あなたが、家族のことを守りたい気持ちで、お仕事を頑張ってこられたのに、やりきれなくなりますね。",
            "Chinese": "您怀着守护家人的心情努力工作至今，却得不到理解，这确实会让人感到失落和沮丧呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 11:00:39",
            "content": "（すみません、11時以降に他の予定があるので、ロールプレイ11時10分ぐらいまででいいですか？）",
            "Chinese": "（不好意思，我11点之后有别的安排，角色扮演可以到11点10分左右结束吗？）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:01:04",
            "content": "（もうしわけございません）",
            "Chinese": "（非常抱歉。）"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 11:01:17",
            "content": "（大丈夫です）",
            "Chinese": "（没关系。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:01:37",
            "content": "（ありがとうございます）",
            "Chinese": "（谢谢您。）"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 11:02:07",
            "content": "妻は妻で自分のやりたい事をしているし、息子も学校が楽しいみたいで。",
            "Chinese": "妻子在做自己喜欢的事，儿子似乎也很享受学校生活。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:02:49",
            "content": "そうなのですね。あなたは、一番どのようになったら、よいと思われますか。",
            "Chinese": "是这样啊。您觉得，最理想的状态会是什么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 11:03:00",
            "content": "わからないです。",
            "Chinese": "我不知道。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 11:03:25",
            "content": "それがわかれば、もうできているだろうし、",
            "Chinese": "要是知道的话，早就做到了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:04:02",
            "content": "私が、いままで、お聴きして、感じたことをお話しさせていただいても、よろしいでしょうか",
            "Chinese": "我可以分享一下刚才倾听后的感受吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 11:04:08",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:04:18",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:08:17",
            "content": "あなたは、家族を守りたいと思い、管理職になられるほど、お仕事に力を注いでこられてきました。それは、家族を大切にする思いを強く感じました。その一方ご家族に理解われているように感じられないことに喪失感をかんじていらっしゃるように感じます。",
            "Chinese": "您怀着守护家人的心愿，努力工作到担任管理职务，将精力都投入了工作。我能强烈地感受到您珍视家庭的心情。但另一方面，我感觉您似乎因为没有得到家人的理解，而感到一种失落。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 11:09:39",
            "content": "喪失感、、考えたこともなかった。そうなのかな。",
            "Chinese": "失落感……我倒是没这么想过。也许是这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:10:22",
            "content": "わたしは、あなたの家族へのお気持ちをご家族にお話しできたり、一緒に過ごす時間があったら、少しは、お気持ちが楽になるのではないかと思いました。",
            "Chinese": "我在想，如果能把您对家人的心意告诉他们，或者能多一些一起相处的时间，或许您的心情会稍微轻松一些。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:10:28",
            "content": "いかがでしょうか",
            "Chinese": "您觉得呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:10:46",
            "content": "（すみません。お時間ですね）",
            "Chinese": "（不好意思，时间到了呢）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:11:10",
            "content": "（お時間以内になれずに、もうしわけございませんでした）",
            "Chinese": "（没能在规定时间内完成，非常抱歉。）"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 11:11:17",
            "content": "（はい、すみません。後から振り返りあげますね）",
            "Chinese": "（好的，不好意思。我稍后会进行复盘。）"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 11:11:32",
            "content": "（こちらこそありがとうございました）",
            "Chinese": "（我也要谢谢您。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:11:46",
            "content": "（貴重なお時間をいただいて、どうもありがとうぼざいました）",
            "Chinese": "（非常感谢您抽出宝贵时间。）"
        },
        {
            "role": "クライアント",
            "time": "2021/09/20(月) 11:12:11",
            "content": "（ありがとうございました。失礼します）",
            "Chinese": "（谢谢您。我先告辞了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/20(月) 11:12:16",
            "content": "では、終了させていたきます。",
            "Chinese": "那么，我们就到这里结束吧。"
        },
        {
            "role": "カウンセラー",
