{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 13:58:16",
            "content": "本日のロールプレイよろしくお願い致します。時間になったら始めさせていただきますね。",
            "Chinese": "今天的角色扮演，请多指教。时间一到我们就可以开始了。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 13:58:27",
            "content": "よろしくお願いいたします",
            "Chinese": "请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:00:09",
            "content": "こんにちは。相談員です。まずはじめに年齢と性別を教えていただけますか？",
            "Chinese": "您好，我是咨询员。首先，请问可以告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:00:29",
            "content": "14　男",
            "Chinese": "14岁，男。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:00:33",
            "content": "ありがとうございます。本日はどういった相談でしょうか？",
            "Chinese": "谢谢您。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:00:49",
            "content": "外に出たくありません。",
            "Chinese": "我不想出门。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:01:00",
            "content": "そうだったのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:01:28",
            "content": "どうして出たくないと思われるのか話せる範囲で教えてもらえますか？",
            "Chinese": "可以在您愿意的范围内和我说说，为什么会不想出门吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:01:40",
            "content": "どうしてって言われても、、、",
            "Chinese": "您问我为什么，我也说不上来……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:01:56",
            "content": "何かきっかけはありましたか？",
            "Chinese": "是有什么触发的原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:02:52",
            "content": "なんでしょうね",
            "Chinese": "我也不太清楚呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:03:22",
            "content": "わからないけれど出たくないのですね。",
            "Chinese": "虽然说不清原因，但就是不想出门，是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:03:55",
            "content": "いつ頃から出たくないと思うようになりましたか？",
            "Chinese": "大概是从什么时候开始，您变得不想出门的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:04:57",
            "content": "今年度からです",
            "Chinese": "从这个学年开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:05:06",
            "content": "そうだったのですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:05:37",
            "content": "最後に外に出たのはいつでしょうか？",
            "Chinese": "您最后一次出门大概是什么时候呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:05:44",
            "content": "覚えてません",
            "Chinese": "不记得了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:06:08",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:07:05",
            "content": "普段はお家で何をされていますか？",
            "Chinese": "您平时在家都做些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:07:11",
            "content": "寝てます",
            "Chinese": "睡觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:07:24",
            "content": "そうだったのですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:07:41",
            "content": "夜は大体何時頃に寝られますか？",
            "Chinese": "您晚上一般几点左右睡觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:08:20",
            "content": "22時",
            "Chinese": "22点。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:08:37",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:09:41",
            "content": "何をしている時間が楽しいですか？",
            "Chinese": "您做什么事情的时候会觉得开心呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:09:52",
            "content": "楽しい時間はありません",
            "Chinese": "没有开心的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:10:22",
            "content": "楽しい時間がないのはしんどいですね。",
            "Chinese": "没有开心的时光，想必很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:10:48",
            "content": "どうして楽しい時間がない＝しんどいにつながるのですか？",
            "Chinese": "为什么“没有开心的时候”就等于“难受”呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:11:51",
            "content": "何をしても楽しいと思えないのかなと思ったのでこのような表現を使いましたが、気分を悪くさせてしまったら申し訳ありません。",
            "Chinese": "我的想法是，您可能觉得做什么都无法感到开心，所以才用了这样的表达。如果这让您感到不快，我非常抱歉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:13:09",
            "content": "楽しい時間がないというのはあなたにとってどう感じるかお話ししてもらえますか？",
            "Chinese": "那么，“没有开心的时光”对您来说是种什么样的感受呢？可以和我说一说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:13:26",
            "content": "別にどうでもよくないですか",
            "Chinese": "这无所谓吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:14:44",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:15:40",
            "content": "今日はあなたのお話を聞き、少しでも心がルクなればと思っておりますのでなんでもお話ししてくださいね。",
            "Chinese": "今天我想听您聊聊，希望能让您的心情哪怕轻松一点点也好，所以任何事情都可以放心地和我说。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:16:38",
            "content": "心がルク→心が軽くです。打ち間違えてしまいました。",
            "Chinese": "抱歉，刚刚“心がルク”是打错了，我想表达的是“心情轻松”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:17:10",
            "content": "普段は家族の方とお話しされますか？",
            "Chinese": "您平时和家人说话吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:17:40",
            "content": "こちらからはしません",
            "Chinese": "我不会主动跟他们说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:17:53",
            "content": "そうだったのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:18:40",
            "content": "家族の方が話しかけて来られる時はどう言ったお話をされますか？",
            "Chinese": "那家人主动找您说话的时候，一般会聊些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:19:07",
            "content": "学校に行ってくれみたいなことしか話しません",
            "Chinese": "翻来覆去就是让我去上学那些话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:19:17",
            "content": "そうだったのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:19:56",
            "content": "そう言われた時はどういう気持ちになりますか？",
            "Chinese": "听到这些话的时候，您是什么心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:20:33",
            "content": "うるさいです",
            "Chinese": "很烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:20:48",
            "content": "そう思われるのですね。",
            "Chinese": "您是这么觉得的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:22:00",
            "content": "ご家族の方に学校に行くように言われた時は何と返事をされるのですか？",
            "Chinese": "家人让您去上学时，您一般是怎么回应的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:22:39",
            "content": "だんまりです",
            "Chinese": "沉默不语。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:23:17",
            "content": "うるさいなと感じながらも黙っておられるのですね。",
            "Chinese": "您一边觉得很烦，一边选择保持沉默，是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:24:12",
            "content": "学校に行かなくなったのは今年度からですか？",
            "Chinese": "您是从这个学年开始不去上学的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:24:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:24:28",
            "content": "そうだったのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:24:56",
            "content": "昨年までの学校生活はどうでしたか？",
            "Chinese": "去年及之前的学校生活，您感觉怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:25:41",
            "content": "なんとも言えません",
            "Chinese": "不好说。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:26:00",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:26:47",
            "content": "部活動はしておられますか？",
            "Chinese": "您有参加社团活动吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:27:02",
            "content": "してません",
            "Chinese": "没有参加。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:27:11",
            "content": "そうだったのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:29:22",
            "content": "外へ出たいなというお気持ちはありますか？",
            "Chinese": "您有“想要出门”这样的想法吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:29:31",
            "content": "ありません",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:29:40",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:31:06",
            "content": "誰かに会ったりするのが嫌だなと思われたりするのですか？",
            "Chinese": "是会觉得不想见人，所以才不想出门吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:31:35",
            "content": "それがどうかしましたか",
            "Chinese": "是又怎么样？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:33:08",
            "content": "そう思うこともあるのかなと思いまして。無理に外へ出なくてもいいと思います。",
            "Chinese": "我只是觉得您可能会有这样的想法。我认为，不必勉强自己出门。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:34:33",
            "content": "なるほど、じゃあ親の言ってくることは間違ってるということですね。",
            "Chinese": "原来如此，那就是说我父母说的是错的了？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:36:23",
            "content": "間違っているということではないです。どうしても出たくないのであれば充電期間のように少し休んでもいいのではないかと思いました。",
            "Chinese": "我不是说他们错了。只是觉得，如果您实在不想出门，或许可以把这段时间当作一个充电期，稍微休息一下。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:37:03",
            "content": "は？じゃあ結局行けってこと？",
            "Chinese": "哈？那说到底不还是让我去学校吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:39:46",
            "content": "あなたが行きたいと思う時に行ければいいと思いますよ。",
            "Chinese": "我觉得，等到您自己想去的时候再去就可以了。"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:40:08",
            "content": "ふーん",
            "Chinese": "哦……"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:40:18",
            "content": "多分ないと思いますけどね",
            "Chinese": "不过，我想到时候大概也不会想去的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:40:20",
            "content": "行きたくない今は学校に行くことは考えなくてもいいと思います。",
            "Chinese": "既然现在不想去，那我觉得可以暂时先不用考虑去学校的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:41:33",
            "content": "あなたは家で寝る以外にしていることはありますか？（ゲームや漫画を読むなど）",
            "Chinese": "您在家除了睡觉，还会做别的事情吗？（比如玩游戏或看漫画之类的）"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:41:39",
            "content": "ありません",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:41:55",
            "content": "ずっと横になっておられるのですね。",
            "Chinese": "您是一直都躺着吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:42:18",
            "content": "なんで横になってるということになるのかわかりませんがまあそうですね",
            "Chinese": "我不明白为什么睡觉就等于躺着，不过……也算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:42:54",
            "content": "決めつけてしまってごめんなさいね。",
            "Chinese": "抱歉，是我想当然了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:43:55",
            "content": "これから何かしたいことはありますか？",
            "Chinese": "那接下来，您有什么想做的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:44:02",
            "content": "特にありません",
            "Chinese": "没什么特别的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:44:16",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:44:35",
            "content": "家にいてしんどいなと思うことはありますか？",
            "Chinese": "待在家里的时候，会有觉得难受的地方吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:45:21",
            "content": "親がうるさいところでしょうか",
            "Chinese": "大概是父母很烦人这一点吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:45:30",
            "content": "そうだったのですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:46:55",
            "content": "普段は自分の部屋に居られるのですか？",
            "Chinese": "您平时都待在自己的房间里吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:47:00",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:47:28",
            "content": "そうだったのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:48:01",
            "content": "自分の部屋にいる時はどういう気分ですか？",
            "Chinese": "待在自己房间里的时候，您感觉怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:48:36",
            "content": "何も感じません",
            "Chinese": "没什么感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:48:51",
            "content": "そうだったのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:49:15",
            "content": "ご飯は自室で召し上がりますか？",
            "Chinese": "您在自己房间吃饭吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:50:37",
            "content": "時々",
            "Chinese": "有时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:50:47",
            "content": "そうだったのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/12/01(水) 14:51:52",
            "content": "時々自室で食べられて、たまに食卓で食べられるというような感じでしょうか？",
            "Chinese": "就是说，有时候在自己房间吃，有时候在餐桌上吃，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/12/01(水) 14:52:04",
            "content": "はい",
