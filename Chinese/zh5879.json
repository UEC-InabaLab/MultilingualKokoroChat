    {
      "role": "client",
      "time": "2023-10-24T20:19:20",
      "origin": "一人で旅立たせてしまいました",
      "content": "让她一个人离开了。"
    },
    {
      "role": "counselor",
      "time": "2023-10-24T20:19:41",
