    },
    {
      "role": "client",
      "time": "2023-10-24T20:43:04",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2023-10-24T20:43:26",
      "origin": "家事も育児も相談者様が中心になってなさっているのですね。",
