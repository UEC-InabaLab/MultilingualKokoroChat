    },
    {
      "role": "client",
      "time": "2023-10-24T20:43:55",
      "origin": "そうですね。",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2023-10-24T20:44:12",
      "origin": "お子さんは、保育園かどこかに通われていますか？",
