    },
    {
      "role": "client",
      "time": "2023-10-24T20:12:36",
      "origin": "夫と子どもがいます",
      "content": "我有丈夫和孩子。"
    },
    {
      "role": "counselor",
      "time": "2023-10-24T20:13:16",
