    },
    {
      "role": "client",
      "time": "2023-10-24T20:41:11",
      "origin": "3歳です",
      "content": "3岁。"
    },
    {
      "role": "counselor",
      "time": "2023-10-24T20:42:32",
      "origin": "そうなのですね、育児もきっとお忙しいですね。",
