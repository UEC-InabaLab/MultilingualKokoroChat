    },
    {
      "role": "client",
      "time": "2023-10-24T20:32:23",
      "origin": "分かりません",
      "content": "我也不知道。"
    },
    {
      "role": "client",
      "time": "2023-10-24T20:33:00",
      "origin": "辞めた方がいいのでしょうか",
      "content": "我是不是应该辞职呢？"
    },
    {
      "role": "counselor",
      "time": "2023-10-24T20:33:04",
      "origin": "責任感が強いからこそ、悩まれるのですね。",
