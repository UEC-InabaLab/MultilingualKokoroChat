      "role": "client",
      "time": "2022-11-16T21:48:10",
      "origin": "もう別にいいかな",
      "content": "感觉也无所谓了。"
    },
    {
      "role": "client",
      "time": "2022-11-16T21:48:27",
      "origin": "死んだら特に意味ないですし。",
