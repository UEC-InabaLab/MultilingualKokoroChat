{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 20:51:56",
            "content": "（こんばんは。マッチングありがとうございます。お時間になったら始めさせていただきますね。）",
            "Chinese": "（晚上好。感谢您的匹配。时间到了我们就开始吧。）"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 20:54:41",
            "content": "(こんばんは、よろしくお願いいたします。）",
            "Chinese": "（晚上好，拜托您了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:00:24",
            "content": "こんばんは。相談員です。本日は相談に来てくださりありがとうございます。初めに、年齢（学年）、性別、ご相談内容を教えていただけますか？",
            "Chinese": "晚上好。我是咨询员。感谢您今天前来咨询。首先，请问可以告诉我您的年龄（年级）、性别以及咨询内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:00:50",
            "content": "１３才",
            "Chinese": "13岁"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:00:59",
            "content": "女",
            "Chinese": "女"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:01:15",
            "content": "中１",
            "Chinese": "初一"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:02:17",
            "content": "学校にいきたくない",
            "Chinese": "不想去学校"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:02:59",
            "content": "教えてくださりありがとうございます。",
            "Chinese": "感谢您告诉我这些。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:03:33",
            "content": "楽しくない",
            "Chinese": "不开心。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:03:56",
            "content": "仲いい友達が話してくれなくなった",
            "Chinese": "要好的朋友不再跟我说话了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:04:15",
            "content": "そうなのですね。楽しくないなと感じてしまうとつまらなくなってしまいますよね。",
            "Chinese": "是这样啊。感觉不开心的话，确实会觉得没意思呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:04:32",
            "content": "いつ頃から話してくれなくなってしまったのですか？",
            "Chinese": "大概从什么时候开始不跟你说话的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:04:54",
            "content": "1か月ぐらい前から",
            "Chinese": "大概一个月前。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:05:05",
            "content": "何もしていないので二",
            "Chinese": "我什么都没做，所以……"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:05:15",
            "content": "してないのに",
            "Chinese": "明明什么都没做"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:05:24",
            "content": "わけわかんない",
            "Chinese": "莫名其妙"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:05:39",
            "content": "学校行く意味ない",
            "Chinese": "去学校没有意义"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:05:54",
            "content": "そうだったんですね。思い当たることがないと、なおさらどうしていいかわからなくなってしまいますね。",
            "Chinese": "原来如此。如果想不出什么原因，确实会更让人不知所措呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:06:22",
            "content": "ほんとにそう",
            "Chinese": "真的就是这样"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:06:44",
            "content": "行かなくてもいいよね？",
            "Chinese": "不去也可以吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:06:46",
            "content": "あなたとその子との共通のお友達とかいますか？",
            "Chinese": "你和那位同学有共同的朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:07:11",
            "content": "ひとりじゃないよ",
            "Chinese": "不止一个人哦"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:07:23",
            "content": "みんながそんな感じ",
            "Chinese": "大家都差不多是那样"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:07:38",
            "content": "だからよけいにね",
            "Chinese": "所以就更……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:07:58",
            "content": "そうだったんですね。勘違いしてしまいました。",
            "Chinese": "原来是这样啊。是我误会了。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:08:09",
            "content": "大丈夫",
            "Chinese": "没关系"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:08:25",
            "content": "行かなくてもいいよね",
            "Chinese": "不去也可以吧"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:08:26",
            "content": "それは確かに嫌になってしまいますね。",
            "Chinese": "那确实会让人厌烦呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:08:36",
            "content": "行きたくないなら",
            "Chinese": "如果不想去的话"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:09:08",
            "content": "まずはここで相談員といっしょに少し考えてみませんか？",
            "Chinese": "要不要先在这里和我一起想一想呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:09:30",
            "content": "ん？何を？",
            "Chinese": "嗯？想什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:10:03",
            "content": "何が原因だったか、この先どうしていくか。",
            "Chinese": "原因是什么，接下来该怎么做。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:10:19",
            "content": "原因？この先？",
            "Chinese": "原因？接下来？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:10:38",
            "content": "考えても意味なくない？",
            "Chinese": "想了也没意义吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:11:14",
            "content": "なにが原因でそうなってしまったのかとか。",
            "Chinese": "比如，是因为什么才变成这样的。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:11:20",
            "content": "私なんかどうせ嫌われるんだよ",
            "Chinese": "我这种人反正会被讨厌的"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:11:39",
            "content": "今までもそうだったし",
            "Chinese": "以前也一直这样"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:12:06",
            "content": "そんなことはないですよ。あなたはどうにかしたいと思ってここに相談しにきてますし、",
            "Chinese": "没有这回事的。你也是因为想要改变现状，所以才来这里咨询的，"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:12:24",
            "content": "友達じゃなかっただけ",
            "Chinese": "只是本来就不是朋友而已"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:12:43",
            "content": "なんとかいまの状態を変えようと思ってるんだと感じます。",
            "Chinese": "我能感觉到你想设法改变现在的状况。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:13:31",
            "content": "そう思うんだ、へー",
            "Chinese": "你是这么想的啊，哦—"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:13:47",
            "content": "でも違うよ",
            "Chinese": "但不是那样的"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:13:57",
            "content": "学校に行きたくないだけ",
            "Chinese": "我只是单纯不想去学校而已"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:14:36",
            "content": "そうですか。そこまで強い思いがあるんですね。",
            "Chinese": "是吗。看来你不想去的想法非常强烈呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:14:41",
            "content": "勉強もできないし",
            "Chinese": "学习也不好"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:15:13",
            "content": "話す友達もいなかったら、いく意味ない",
            "Chinese": "要是连能说话的朋友都没有，去也没意义"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:15:27",
            "content": "言っても無駄",
            "Chinese": "说了也白说"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:15:33",
            "content": "行っても",
            "Chinese": "就算去了也……"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:15:55",
            "content": "だってそうでしょ",
            "Chinese": "不就是这样吗"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:16:29",
            "content": "みんなが話してくれなくなった時になにか思い当たることはありませんか？",
            "Chinese": "在大家都不和你说话的时候，你有没有想到什么可能的原因呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:16:58",
            "content": "特にない",
            "Chinese": "没什么特别的"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:17:49",
            "content": "ほんとにわけわかんない",
            "Chinese": "真的搞不懂"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:17:52",
            "content": "そうなんですか。そのことは誰か周りの人に相談したりしたことはありますか？",
            "Chinese": "是吗。这件事你和周围的人商量过吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:18:14",
            "content": "べつに",
            "Chinese": "倒也没有"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:19:10",
            "content": "そうなんですね。では今回はじめてここでその話をしてくれたのですね。",
            "Chinese": "这样啊。那这次是第一次在这里跟我说起这件事呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:19:35",
            "content": "まあそうかな",
            "Chinese": "嗯，算是吧"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:20:24",
            "content": "友達のことはしかたないよ",
            "Chinese": "朋友的事也没办法"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:20:43",
            "content": "嫌われたみたいだし",
            "Chinese": "好像是被讨厌了"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:20:44",
            "content": "その気持ちを打ち明けてくれてありがとうございます。",
            "Chinese": "谢谢你向我坦露你的心情。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:21:18",
            "content": "学校行く気になれないだけ",
            "Chinese": "只是提不起去学校的劲"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:21:48",
            "content": "もういろいろめんどい",
            "Chinese": "已经觉得各种都很麻烦"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:22:04",
            "content": "うんうん、お友達が話をしてくれなくなったら辛くなってしまいますものね。",
            "Chinese": "嗯嗯，要是朋友不再跟你说话，确实会很难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:22:29",
            "content": "つらく？べつにつらくはないよ",
            "Chinese": "难受？倒也不难受"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:23:20",
            "content": "いろいろと考えるのがめんどくさい",
            "Chinese": "只是想这想那很麻烦"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:23:22",
            "content": "そうでしたか。すみません。勝手にそう思ってしまいましたね。",
            "Chinese": "是这样啊。对不起，是我擅自那么想了。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:23:49",
            "content": "いえいえ、大丈夫",
            "Chinese": "不不，没关系"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:24:18",
            "content": "いろいろ面倒くさいというのは友達のこと以外になにかありますか？",
            "Chinese": "你说的“各种事都很麻烦”，除了朋友的事情以外，还有别的吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:24:50",
            "content": "そだね、あるよ",
            "Chinese": "嗯，有啊"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:25:10",
            "content": "どんなことか教えてもらえますか？",
            "Chinese": "能告诉我都是些什么事吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:26:13",
            "content": "もし言いたくなければ言わなくても大丈夫ですよ。",
            "Chinese": "如果不想说也没关系。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:26:54",
            "content": "お母さんのこととかご飯のこととか…かな",
            "Chinese": "比如妈妈的事、吃饭的事之类的…吧"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:27:19",
            "content": "お母さんいつ帰ってくるか分からないし、",
            "Chinese": "不知道妈妈什么时候回来，"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:27:38",
            "content": "帰ってきても忙しそうだし",
            "Chinese": "就算回来了看起来也很忙，"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:27:58",
            "content": "気を遣う",
            "Chinese": "得小心翼翼"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:28:40",
            "content": "そうだったんですね。忙しくしているお母さんを大事に思われているのですね。",
            "Chinese": "是这样啊。你很体谅忙碌的妈妈呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:28:56",
            "content": "大事？そんなことないよ",
            "Chinese": "体谅？才没有呢"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:29:10",
            "content": "しないと機嫌悪くなるから",
            "Chinese": "因为不那样做她心情就会变差"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:29:41",
            "content": "怒らせないようにしてる",
            "Chinese": "我只是在努力不惹她生气"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:29:57",
            "content": "仕事しているからだと思うけど",
            "Chinese": "我想是因为她在工作吧"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:30:12",
            "content": "しょうがないよね",
            "Chinese": "这也是没办法的事吧"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:30:30",
            "content": "そうでしたか。気をつかわなければいけないのですね。",
            "Chinese": "原来是这样啊。你必须要那么小心翼翼呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:31:22",
            "content": "お母さんは私のこといらないんだよ",
            "Chinese": "妈妈是不需要我的"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:31:25",
            "content": "お仕事されているからいつになるかわからないならそうですよね。",
            "Chinese": "因为她在工作，不知道什么时候回来，所以确实会这样呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:32:28",
            "content": "しょうがないから育てているだけ",
            "Chinese": "只是没办法才把我养着而已"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:32:29",
            "content": "そんな風に感じているのですね。どうしてそう思うのですか？",
            "Chinese": "你是有这样的感觉啊。为什么会这么想呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:32:42",
            "content": "お母さんから言われたから",
            "Chinese": "因为妈妈这么对我说过"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:33:37",
            "content": "そうだったんですね。それは寂しくなってしまいますね。お母さんに気を遣ってあげているのに。。",
            "Chinese": "是这样啊。那会让人觉得很孤单呢。明明你那么为妈妈着想……"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:33:51",
            "content": "嫌われてもしょうがないんだよ",
            "Chinese": "就算被讨厌也没办法"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:34:23",
            "content": "怒られたくないだけ",
            "Chinese": "我只是不想被骂而已"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:35:33",
            "content": "学校いくのめんどくさい",
            "Chinese": "去学校好麻烦"
        },
        {
            "role": "クライアント",
            "time": "2024/04/03(水) 21:35:48",
            "content": "学校行きたくない",
            "Chinese": "不想去学校"
        },
        {
            "role": "カウンセラー",
            "time": "2024/04/03(水) 21:36:18",
            "content": "そうですか。本当にいきたくないのですね。",
            "Chinese": "是吗。你真的非常不想去呢。"
        },
        {
            "role": "クライアント",
