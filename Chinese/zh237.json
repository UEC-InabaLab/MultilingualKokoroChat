{
  "dialogue": [
    {
      "role": "client",
      "time": "2020-07-23T11:56:09",
      "origin": "https://line.me/R/ti/p/%40208umcjj",
      "content": "https://line.me/R/ti/p/%40208umcjj"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T11:57:45",
      "origin": "こんにちわ相談員です。",
      "content": "您好，我是咨询师。"
    },
    {
      "role": "client",
      "time": "2020-07-23T11:58:16",
      "origin": "こんにちは。宜しくお願いします。",
      "content": "您好，请多关照。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T11:58:23",
      "origin": "宜しくお願いします！",
      "content": "也请您多关照！"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T11:58:45",
      "origin": "今日はどんなご相談でいらっしゃいましたか？",
      "content": "您今天想咨询些什么呢？"
    },
    {
      "role": "client",
      "time": "2020-07-23T11:58:50",
      "origin": "はい。",
      "content": "是的。"
    },
    {
      "role": "client",
      "time": "2020-07-23T11:59:08",
      "origin": "くだらない内容かも知れないのですが、、",
      "content": "可能不是什么大事……"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T11:59:16",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T11:59:18",
      "origin": "聞いていただけますか？",
      "content": "您愿意听我说吗？"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T11:59:29",
      "origin": "はい、どうぞ！",
      "content": "好的，请讲！"
    },
    {
      "role": "client",
      "time": "2020-07-23T11:59:45",
      "origin": "職場の人間関係のことなんですが、",
      "content": "是关于职场人际关系的……"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T11:59:54",
      "origin": "はい",
      "content": "好的。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:00:23",
      "origin": "小さな家族的会社でお米を全国に発送している事務をしています。",
      "content": "我在一家小型的家族式公司做文员，负责向全国邮寄大米。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:00:33",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:00:59",
      "origin": "社長の他に奥様と社長のお母さんと",
      "content": "除了社长，还有他的夫人和母亲，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:01:06",
      "origin": "はい",
      "content": "好的。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:01:29",
      "origin": "私と他にスタッフが３人でやっているのですが、",
      "content": "再加上我和另外3名员工一起工作。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:01:41",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:02:07",
      "origin": "最近、入った女性の新人さんが",
      "content": "最近新来的那位女同事，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:02:16",
      "origin": "はい",
      "content": "好的。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:02:26",
      "origin": "はじめは明るくて人当たりもよかったのですが、",
      "content": "起初性格开朗、待人也很好，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:02:33",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:02:44",
      "origin": "入って三ヶ月過ぎたあたりから",
      "content": "但进来三个月以后开始，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:02:50",
      "origin": "はい",
      "content": "好的。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:03:12",
      "origin": "先輩である私の悪口を言いふらしているようなんです。",
      "content": "她好像在到处说我这个前辈的坏话。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:03:29",
      "origin": "ええーー、そうなんですか",
      "content": "啊——是这样吗？"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:03:32",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:03:54",
      "origin": "あっ、すいません、続けてください",
      "content": "啊，抱歉，请您继续。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:04:01",
      "origin": "会社は家族経営的な感じなんですが",
      "content": "公司有点像家族式经营，"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:04:12",
      "origin": "社長の奥様が少し",
      "content": "社长的夫人有点……"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:04:20",
      "origin": "言いにくいのですが",
      "content": "不太好说，但是……"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:04:25",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:04:39",
      "origin": "知的障害がすこしある感じで",
      "content": "给人的感觉是有些轻度的智力障碍，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:04:47",
      "origin": "なるほどですね",
      "content": "原来是这样。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:05:01",
      "origin": "日中もボーっとしていることが多くて、",
      "content": "白天也经常发呆，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:05:06",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:05:31",
      "origin": "何をやるにもスローだし、たくさんのことを同時にできないんですね",
      "content": "做什么事都很慢，而且没法同时处理很多事情。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:05:40",
      "origin": "なるほど",
      "content": "我明白。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:06:01",
      "origin": "私も最初はあれって？思ったのですが",
      "content": "我一开始也觉得有点奇怪，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:06:08",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:06:27",
      "origin": "徐々にこれは疾患のひとつなんだなぁーと",
      "content": "逐渐意识到这应该是一种障碍，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:06:36",
      "origin": "なるほど",
      "content": "明白。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:06:43",
      "origin": "本人は全く悪気はなくて",
      "content": "她本人完全没有恶意，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:06:48",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:07:00",
      "origin": "社長もすごく良い人柄なんです",
      "content": "社长人也特别好，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:07:09",
      "origin": "はい",
      "content": "好的。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:07:35",
      "origin": "知的障害を軽度に持っていることを承知で結婚されたようです。",
      "content": "他似乎是在知道对方有轻度智力障碍的情况下结的婚。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:07:45",
      "origin": "なるほどですね",
      "content": "原来是这样。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:08:14",
      "origin": "その新人が",
      "content": "但那位新人"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:08:19",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:08:37",
      "origin": "その奥様の何というか、、、",
      "content": "对那位夫人，怎么说呢……"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:08:46",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:08:53",
      "origin": "仕事をサボっているとか",
      "content": "说她工作偷懒之类的，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:09:08",
      "origin": "はい",
      "content": "好的。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:09:19",
      "origin": "奥様に対して非難めいた言動が多くなり",
      "content": "对夫人的指责言行越来越多了。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:09:31",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:09:41",
      "origin": "こっちは忙しいのになんにもしないとか",
      "content": "说什么“我们这么忙，她却什么都不干”，"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:09:59",
      "origin": "私に苦情を言ってくるようになったんですね",
      "content": "还开始向我抱怨。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:10:09",
      "origin": "なるほど",
      "content": "我明白了。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:10:31",
      "origin": "私はもともと人の悪口を言うのは好きではなく",
      "content": "我本来就不喜欢说别人的坏话，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:10:37",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:10:51",
      "origin": "まして知的障害があることを承知で",
      "content": "更何况我也清楚她有智力障碍，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:10:59",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:11:20",
      "origin": "家族経営上社員として配置されている事情もわかっていたので",
      "content": "也明白在家族企业里，把她安排成员工是有原因的。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:11:31",
      "origin": "はい",
      "content": "好的。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:11:42",
      "origin": "その新人によくわかるように何度も説明したんですが",
      "content": "所以我也多次向那位新人解释得清清楚楚，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:11:53",
      "origin": "そうなんですね",
      "content": "是这样啊。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:12:03",
      "origin": "最初はあー、そうなんですねーと聞いていたのですが",
      "content": "她一开始还听着，说‘啊，是这样啊’，"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:12:32",
      "origin": "そのうちに奥様の悪口を私に毎日言ってくるようになり",
      "content": "但不久就又开始每天对我说夫人的坏话，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:12:40",
      "origin": "はい",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:12:55",
      "origin": "私は本人はそれは生まれもったものだから",
      "content": "我跟她说那是天生的，"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:13:27",
      "origin": "仕方ないことなんだよといくら言ってもエスカレートしてきて",
      "content": "不管我怎么说‘这是没办法的事’，她反而变本加厉。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:13:33",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:13:47",
      "origin": "最近では",
      "content": "最近甚至，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:13:53",
      "origin": "はい",
      "content": "好的。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:14:23",
      "origin": "他の男性のスタッフに私の悪口まで言うようになってきてしまい、、、",
      "content": "她甚至开始跟其他男同事说我的坏话了……"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:14:34",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:14:55",
      "origin": "ほとほと会社に行くのが嫌になってしまい、、",
      "content": "搞得我实在是不想去公司了……"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:15:03",
      "origin": "はい",
      "content": "我明白。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:15:25",
      "origin": "この先どのように気持ちを整理したらいいのか？",
      "content": "我不知道接下来该怎么调整自己的心情？"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:15:51",
      "origin": "どうしたらいいでしょうか？相談に乗ってもらえますか？",
      "content": "我该怎么办才好呢？能和您谈谈吗？"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:15:51",
      "origin": "はい",
      "content": "好的。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:16:16",
      "origin": "はい、、いろいろお話頂き有難うございます",
      "content": "好的……非常感谢您跟我说了这么多。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:16:21",
      "origin": "まずは、、",
      "content": "首先……"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:16:29",
      "origin": "ありがとうございます。",
      "content": "谢谢您。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:16:37",
      "origin": "最初にくだらない話しとおっしゃってましたが、、",
      "content": "您一开始说可能不是什么大事，但是……"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:16:43",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:16:53",
      "origin": "全然くだらないことではなく、",
      "content": "这完全不是小事，"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:17:06",
      "origin": "はい、、、",
      "content": "嗯……"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:17:15",
      "origin": "お仕事の、職場の大切な問題ですよね、",
      "content": "是工作上、职场中很重要的问题，对吧。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:17:55",
      "origin": "そうなんです。最近は夜もあんまり眠れない感じで、、、",
      "content": "是的。最近晚上也总是睡不太好……"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:18:01",
      "origin": "いろいろと悩まれてるのが分かりました、問題も何点かあり、気苦労されてますよね",
      "content": "我明白您有很多烦恼，问题也有好几个方面，确实让您很操心吧。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:18:21",
      "origin": "そうなんですよね。それ以外にも",
      "content": "是啊。除此之外还有……"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:18:22",
      "origin": "そうですか、それほど不安を感じてるんですね",
      "content": "是吗，看来您感到非常不安呢。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:18:27",
      "origin": "はい。",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:18:30",
      "origin": "あっ、はい、どうぞ",
      "content": "啊，好的，您请说。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:19:29",
      "origin": "その彼女はお米を発送する際の送付状とかも雑に貼るんですね。いくら注意しても直さないんです。",
      "content": "她在寄大米的时候，运单之类的也贴得很潦草。我提醒她好几次了，她就是不改。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:19:40",
      "origin": "ええ",
      "content": "嗯。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:20:08",
      "origin": "そうなんですね、そういった事でも不満をお持ちなんですね",
      "content": "是这样啊，您对这些事也感到不满呢。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:20:25",
      "origin": "はい。受け取ったお客様が嫌な感じを持ってしまうので、私は丁寧な貼るように指導するのですが、",
      "content": "是的。因为客户收到后会感到不悦，所以我指导她要贴得仔细一些，"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:20:33",
      "origin": "はい",
      "content": "好的。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:20:55",
      "origin": "人当たりは悪くないのですが、仕事が雑なんですね。",
      "content": "她待人接物还不错，就是工作太马虎了。"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:21:10",
      "origin": "なるほど、、厄介ですねー",
      "content": "原来如此……确实挺棘手的。"
    },
    {
      "role": "client",
      "time": "2020-07-23T12:21:20",
      "origin": "そうなんです、、、",
      "content": "就是啊……"
    },
    {
      "role": "counselor",
      "time": "2020-07-23T12:21:44",
      "origin": "毎日毎日、大変な思いをされてるのが目に浮かびます",
      "content": "我能想象得到您每天都过得很辛苦。"
    },
    {
      "role": "client",
