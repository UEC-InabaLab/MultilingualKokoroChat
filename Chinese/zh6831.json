    {
      "role": "client",
      "time": "2024-05-06T18:59:28",
      "origin": "（わかりました）",
      "content": "（好的，明白了。）"
    },
    {
      "role": "counselor",
      "time": "2024-05-06T19:00:00",
      "origin": "（ありがとうございます、よろしくおねがいいたします。）",
