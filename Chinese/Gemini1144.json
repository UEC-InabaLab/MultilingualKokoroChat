{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:08:20",
            "content": "★お待たせしました。宜しくお願い致します。",
            "Chinese": "★让您久等了。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:08:47",
            "content": "こちらこそよろしくお願いします！",
            "Chinese": "我也请您多多关照！"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:09:16",
            "content": "★早速始めますね。",
            "Chinese": "★那我们马上开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:09:21",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:09:25",
            "content": "こんにちは。相談員です。今日は相談に来てくださってありがとうございます。",
            "Chinese": "您好，我是咨询师。感谢您今天前来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:09:31",
            "content": "初めに",
            "Chinese": "首先，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:10:02",
            "content": "年代と性別をお訊かせいただけますか?",
            "Chinese": "可以请您告知您的年龄段和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:10:48",
            "content": "30代 女性です",
            "Chinese": "30多岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:11:09",
            "content": "ありがとうございます。今日はどのようなご相談ですか?",
            "Chinese": "谢谢您。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:11:44",
            "content": "自分の人生の反省についてです。",
            "Chinese": "是关于对自身人生的反思。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:12:21",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:12:50",
            "content": "詳しくお聞かせいただいても宜しいですか?",
            "Chinese": "能详细地和我说说吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:13:22",
            "content": "今、振り返って一番気になっていることはどのような事ですか?",
            "Chinese": "现在回想起来，最让您在意的事情是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:13:39",
            "content": "人を大切にしてこなかった自分に対してです。",
            "Chinese": "是对自己没有好好珍惜他人这件事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:14:11",
            "content": "そんな風に感じておられるんですね。お辛いですね。",
            "Chinese": "您是这样感受的啊。一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:14:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:15:27",
            "content": "いつ頃のことが心に残っていますか?",
            "Chinese": "大概是哪个时期的事情让您印象最深呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:16:28",
            "content": "19才から23才位までです。",
            "Chinese": "大概是19岁到23岁左右。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:16:41",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:18:07",
            "content": "長い間、思われ続けて、しんどかったですね。具体的にどのような事がありましたか?",
            "Chinese": "这么长时间一直想着这件事，一定很辛苦吧。具体发生了什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:19:14",
            "content": "高校を中退して家を出たのですが",
            "Chinese": "我高中辍学后离开了家，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:19:21",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:19:40",
            "content": "身一つで出たので",
            "Chinese": "因为当时孑然一身，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:20:00",
            "content": "どうぞ続けてくださいね",
            "Chinese": "请继续说吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:20:24",
            "content": "頼る人もいなくてお金もあまりない状態だったので",
            "Chinese": "当时无依无靠，也没什么钱，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:20:33",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:21:10",
            "content": "それと無知なものだったので",
            "Chinese": "再加上当时很无知，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:21:33",
            "content": "道を踏み外してしまいました...",
            "Chinese": "所以误入了歧途……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:22:16",
            "content": "そうだったんですね。大変な状況で家を出られて、心細かったですね。",
            "Chinese": "原来如此。在那样艰难的情况下离家，您一定很无助、很不安吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:22:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:22:55",
            "content": "家を出るきっかけはどのような事でしたか?",
            "Chinese": "是什么契机让您决定离家呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:24:09",
            "content": "悩みがピークにきた時に母親に伝えたのですが",
            "Chinese": "当烦恼到达极限时，我向母亲倾诉了，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:24:24",
            "content": "はいむ",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:24:52",
            "content": "すみません。「はい」です",
            "Chinese": "不好意思，是“嗯”。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:24:59",
            "content": "仕事が急がしいと突き放されてしまったので",
            "Chinese": "但她以工作忙为由，冷淡地拒绝了我，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:25:20",
            "content": "それは、寂しかったです。",
            "Chinese": "那一定很寂寞吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:25:37",
            "content": "家にいたくなくなったんです",
            "Chinese": "所以我就不想再待在家里了。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:25:43",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:25:51",
            "content": "ピークになるまで、我慢してこられたのでしょ?",
            "Chinese": "在达到顶点之前，您一定忍耐了很久吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:26:08",
            "content": "そうです。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:26:37",
            "content": "家を出たくなる気持ちにもなりますよね。",
            "Chinese": "会产生想离家的念头也是可以理解的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:26:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:27:12",
            "content": "これまでも、お母さんとはそのようなことがあったのですか?",
            "Chinese": "以前您和母亲之间也发生过类似的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:28:20",
            "content": "その時がはじめてでした。",
            "Chinese": "那是第一次。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:28:35",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:28:49",
            "content": "身一つで出たということでしたが",
            "Chinese": "您提到当时是孑然一身离开家的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:29:19",
            "content": "あなたとしてはその後どうしようとお考えだったんですか?",
            "Chinese": "那之后您打算怎么办呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:30:23",
            "content": "家族を信じられなくなってしまい",
            "Chinese": "我已经无法再信任家人了，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:31:02",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:31:04",
            "content": "家にいられるような",
            "Chinese": "要我继续待在家里那样的——"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:31:11",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:31:31",
            "content": "気持ちは持てなくなってしまったんです",
            "Chinese": "心情，我已经没有了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:31:51",
            "content": "なるほど。そうだったんですね。",
            "Chinese": "原来如此。是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:32:12",
            "content": "あなたの悩みの大きさに気づいてもらえなかったんですね。",
            "Chinese": "他们没有意识到您烦恼的严重性呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:32:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:32:53",
            "content": "どうしようもなく頼りたいときに突き放されて、悲しくなりますよね。",
            "Chinese": "在最无助、最需要依靠的时候被推开，一定很伤心吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:33:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:33:28",
            "content": "高校を中退され",
            "Chinese": "您高中辍学，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:33:48",
            "content": "一人で生きていくのは並大抵のことではなかったと思います。",
            "Chinese": "一个人生活下去想必是非常不容易的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:34:31",
            "content": "はい...",
            "Chinese": "是的……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:34:32",
            "content": "家を出られた時、ご家族はどのようでしたか?",
            "Chinese": "您离家时，家人是什么反应呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:35:11",
            "content": "驚いていました",
            "Chinese": "他们很惊讶。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:36:13",
            "content": "そうなんですね。初めて気づかれたのかもしれませんね。驚かれて何かアクションはありましたか?",
            "Chinese": "是这样啊。也许他们是第一次意识到吧。他们惊讶之后有什么行动吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:37:02",
            "content": "連絡がとても来るようになりました。",
            "Chinese": "他们开始非常频繁地联系我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:37:36",
            "content": "どこにお住まいかはご存じだったんですね。",
            "Chinese": "原来他们知道您住在哪里呀。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:38:19",
            "content": "連絡に対して、あなたはどのようにされていたのですか?",
            "Chinese": "面对这些联系，您当时是如何应对的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:38:23",
            "content": "伝えたくなかったので伝えませんでした。",
            "Chinese": "我不想告诉他们，所以就没说。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:39:04",
            "content": "応対しませんでした。",
            "Chinese": "没有理会。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:40:03",
            "content": "なるほど。簡単に対応できるくらいなら、家を出ないですよね。場所ではなく、連絡はつながる状態だったということですね。",
            "Chinese": "原来如此。如果能轻易应对的话，您也就不会离家了。也就是说，他们不知道您的住处，但联络方式是通的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:40:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:41:26",
            "content": "あなたにとっては、人生を左右するくらいの悩みだったのだと思います。それだけ分かってほしかった、ということですよね。",
            "Chinese": "我想对您来说，那是足以左右人生的烦恼。您只是希望家人能理解到这一点，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:42:10",
            "content": "そうなんです",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:43:22",
            "content": "対応したくない気持ちになるのも自然なことだと思います。",
            "Chinese": "会产生不想回应的心情也是很自然的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:43:30",
            "content": "初めに、道を踏み外したとありましたが・・・もう少し詳しくお話いただけますか?",
            "Chinese": "您一开始提到误入了歧途……能再详细地跟我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:44:59",
            "content": "社会の中で高校を卒業して進学や就職をするということではなく",
            "Chinese": "我没有像社会常规那样，高中毕业后就升学或就业，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:45:11",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:47:09",
            "content": "一般常識の",
            "Chinese": "那种符合普通常识的——"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:47:24",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:47:45",
            "content": "生活を送ることが出来なかったからです",
            "Chinese": "生活，我没能过上。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:48:14",
            "content": "その様にお考えなんですね。",
            "Chinese": "您是这样看待自己的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:48:30",
            "content": "人を騙してしまったりしたんです",
            "Chinese": "我还曾经欺骗过他人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:49:37",
            "content": "深い心の傷として残っておられるんですね。",
            "Chinese": "这件事在您心里留下了很深的创伤呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:49:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:51:00",
            "content": "相手の方はそのことをご存じですか?",
            "Chinese": "对方知道这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:51:19",
            "content": "はい",
            "Chinese": "知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:51:52",
            "content": "どのように言っておられますか?",
            "Chinese": "他们是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:52:28",
            "content": "相手の方とは騙してしまった方でしょうか？",
            "Chinese": "您说的对方，是指被我欺骗的人吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:52:43",
            "content": "そうです。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:53:36",
            "content": "相手というのが複数だったので...",
            "Chinese": "因为对方不止一个人……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:53:48",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:54:17",
            "content": "ちなみに、今現在は、あなたはどのような生活をされているのですか?",
            "Chinese": "顺便问一下，您现在过着怎样的生活呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/08(金) 11:55:26",
            "content": "今は色々な人に支えられ、愛情に生きたいと思える生活が出来ています。",
            "Chinese": "现在，在很多人的支持下，我过上了想要为爱而活的生活。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/08(金) 11:56:07",
