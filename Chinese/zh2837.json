    {
      "role": "client",
      "time": "2021-12-09T20:11:47",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-12-09T20:12:15",
      "origin": "私もたまに雨の日頭痛ありますので",
