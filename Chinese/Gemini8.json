{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:00:15",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:00:21",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:00:33",
            "content": "相談員です。",
            "Chinese": "我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:00:45",
            "content": "よろしくお願いします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:00:46",
            "content": "よろしくお願いいたします。",
            "Chinese": "也请您多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:01:16",
            "content": "死にたいです",
            "Chinese": "我想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:01:38",
            "content": "そんなお気持ちなんですね。",
            "Chinese": "原来您有这样的心情啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:01:42",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:02:03",
            "content": "いつからそんなお気持ちなんですか？",
            "Chinese": "您是从什么时候开始有这种感觉的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:02:15",
            "content": "ここ最近ずっとです",
            "Chinese": "最近一直都是。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:02:35",
            "content": "最近というと？",
            "Chinese": "您说的“最近”是指什么时候呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:03:29",
            "content": "今年に入ってからです",
            "Chinese": "从今年开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:03:45",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:03:51",
            "content": "はい…",
            "Chinese": "嗯…"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:03:55",
            "content": "しんどいです",
            "Chinese": "很痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:04:02",
            "content": "生きてることが",
            "Chinese": "活着这件事很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:04:07",
            "content": "3か月ぐらいそんなお気持ちが続いているんですね。",
            "Chinese": "您这样的心情已经持续了大约三个月了呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:04:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:04:24",
            "content": "しんどいですよね。",
            "Chinese": "确实很痛苦呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:04:28",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:04:54",
            "content": "何かきっかけのようなものがあったんですか？",
            "Chinese": "是有什么契机吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:06:09",
            "content": "うーん。仕事が忙しいのと、やりがいを感じなくなったのと、家族が倒れたりとか、何がきっかけは分かりませんが山ほどあるような気がします",
            "Chinese": "嗯…工作很忙、感觉不到价值、家人病倒了之类的，说不清楚具体是哪个，但感觉原因堆积如山。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:06:23",
            "content": "もう楽になりたい",
            "Chinese": "我想解脱了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:06:35",
            "content": "いろんなことが重なったんですね。",
            "Chinese": "很多事情都赶在一起了呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:06:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:06:46",
            "content": "大変でしたね。",
            "Chinese": "真不容易啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:06:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:07:13",
            "content": "お仕事は今での続いているんですか？",
            "Chinese": "您现在还在继续工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:07:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:08:02",
            "content": "やりがいを感じられなくなったと言っていましてけれど、今のところは続いているんですね",
            "Chinese": "您说感觉不到成就感了，但目前还在继续工作呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:08:49",
            "content": "やりがいないからといってすぐ辞めれないですし。社会人としてダメでしょう？",
            "Chinese": "就算没有成就感，也不能立刻辞职吧。作为社会人那样不行吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:09:09",
            "content": "よく続けていらっしゃるなと感じますよ。",
            "Chinese": "我觉得您能坚持下来已经很了不起了。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:09:35",
            "content": "はぁ。そうなんですね。",
            "Chinese": "唉，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:09:50",
            "content": "ご家族が倒れたそうですけど、大変でしたね。",
            "Chinese": "您说家人病倒了，那段时间一定很辛苦吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:10:11",
            "content": "倒れられたご家族とはどなたですか？",
            "Chinese": "病倒的是哪位家人呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:10:44",
            "content": "母です",
            "Chinese": "我母亲。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:10:58",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:11:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:11:22",
            "content": "今はお母様の具合はいかがですか？",
            "Chinese": "现在您母亲的身体状况如何？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:11:37",
            "content": "退院しました",
            "Chinese": "已经出院了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:12:02",
            "content": "一応お母様ん容体は落ち着かれたんですね。",
            "Chinese": "总之您母亲的病情算是稳定下来了呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:12:11",
            "content": "それはよかった。",
            "Chinese": "那真是太好了。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:12:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:12:45",
            "content": "よろしければあなたの性別と年代を教えていただけますか？",
            "Chinese": "如果方便的话，可以告诉我您的性别和年龄段吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:13:02",
            "content": "40代、女性",
            "Chinese": "40多岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:13:29",
            "content": "あなたのことはエヴァさんとお呼びしてもいいですか？",
            "Chinese": "我可以称呼您为艾娃女士吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:13:58",
            "content": "はい",
            "Chinese": "可以。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:14:21",
            "content": "エヴァさんよろしくお願いしますね。",
            "Chinese": "艾娃女士，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:14:34",
            "content": "よろしくお願いします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:14:48",
            "content": "お母さんは退院後はご自宅での生活は安定していらっしゃいますか？",
            "Chinese": "您母亲出院后，在家的生活还稳定吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:14:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:15:03",
            "content": "それはよかった。",
            "Chinese": "那就好。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:15:19",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:15:35",
            "content": "じゃあお母様はご自分の身の回りのことはご自分でできる状態なのかしら？",
            "Chinese": "那么您母亲现在能自理日常起居了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:16:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:16:22",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:16:52",
            "content": "それではエヴァさんにとって、今とてもつらい気持ちになっているのはお仕事のこと？",
            "Chinese": "那么对艾娃女士来说，现在让您感到非常痛苦的是工作上的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:17:07",
            "content": "かもしれません",
            "Chinese": "也许是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:17:31",
            "content": "じゃあもう少しお仕事のこと教えていただいてもいいですか？",
            "Chinese": "那能再多跟我谈谈工作方面的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:17:46",
            "content": "はい、何を話せばいいですか？",
            "Chinese": "好的，该从何说起呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:18:28",
            "content": "さきほどお仕事はやる気がしなくなってしまったと言っていましたけれど、その辺の状況をもう少し具体的に教えていただけない？",
            "Chinese": "您刚才说对工作失去了干劲，能把这方面的情况再具体地告诉我一些吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:19:15",
            "content": "どんなお仕事をしていて、そこでどんなことがあったのかな？",
            "Chinese": "比如您做的是什么样的工作，期间发生了什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:20:36",
            "content": "何をやっても達成感を感じないし、物理的な量が無理なんです。",
            "Chinese": "做什么都没有成就感，而且工作量在客观上就不可能完成。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:20:53",
            "content": "そうなんだ。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:21:19",
            "content": "仕事量がやり切れないほど多いのかな？",
            "Chinese": "工作量多到根本做不完吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:22:19",
            "content": "はい。毎日16時間ぐらいで、今年はまだ1日も休めてません",
            "Chinese": "是的。每天大概工作16个小时，今年以来一天都没休息过。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:22:42",
            "content": "そんなに働いているんだ。",
            "Chinese": "竟然要工作到那个程度啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:22:57",
            "content": "それは大変だ。",
            "Chinese": "那真是太辛苦了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:23:10",
            "content": "ちなみにどんなお仕事？",
            "Chinese": "顺便问一下，是什么样的工作呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:23:11",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:23:19",
            "content": "企画の仕事です",
            "Chinese": "是企划工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:23:42",
            "content": "難しそうなお仕事ですね。",
            "Chinese": "听起来是很不容易的工作呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:23:54",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:24:01",
            "content": "うーん。そうでもないかもしれないです",
            "Chinese": "嗯…也许并没有那么难。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:24:30",
            "content": "あなたにとっては時間さえあればできるお仕事なのかな。",
            "Chinese": "对您来说，只要有时间就能完成的工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:25:03",
            "content": "難しいからできないわけではないです。価値を感じれなくなったんだと思います",
            "Chinese": "并不是因为难才做不了。我想是因为我感觉不到价值了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:25:25",
            "content": "そうなんだ。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:25:50",
            "content": "以前は価値を感じることができていなんですね。",
            "Chinese": "以前您是能感受到价值的吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:26:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:26:32",
            "content": "その企画のお仕事はどのくらいの期間やってきたのですか？",
            "Chinese": "这份企划工作您做了多长时间了？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:27:27",
            "content": "15年ぐらいです",
            "Chinese": "大概15年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:27:54",
            "content": "すごく長い期間企画のお仕事をやって来られたんですね。",
            "Chinese": "您做企划工作已经有很长一段时间了呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:28:08",
            "content": "とても長いご経験ですね。",
            "Chinese": "资历非常深厚呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:28:18",
            "content": "そうなんですかね？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:28:36",
            "content": "私はそう思いますよ。",
            "Chinese": "我是这么认为的。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:29:14",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:29:35",
            "content": "死んだらだめなんですかね？",
            "Chinese": "死了不行吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:29:53",
            "content": "死にたいというより生きるのに疲れたかんじかもしれないですけど",
            "Chinese": "与其说是想死，可能更像是活累了的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:29:59",
            "content": "ところでその長い間やって来られたということは、そのお仕事にやりがいとか生きがいを感じていらしたとおもうのですんが、そんなことから、その企画のお仕事に価値をかんじられなくなってしまわれたんですか？",
            "Chinese": "说起来，您做了这么长时间，我想您曾经在这份工作中感受到过价值和意义，是什么让您从那样的状态，变成现在这样感觉不到企划工作的价值了呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:31:32",
            "content": "どんなことからその企画のお仕事に価値を感じられなくなってしまったのかしら？",
            "Chinese": "是哪些事情让您对这份企划工作失去了价值感呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:31:55",
            "content": "疲れたという感覚と関係があるのでは？",
            "Chinese": "会不会和您“累了”的感觉有关呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:32:29",
            "content": "わからないです",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:32:49",
            "content": "ただ疲れてしまった？",
            "Chinese": "只是单纯地累了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:33:30",
            "content": "そうかもしれません",
            "Chinese": "也许是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:34:05",
            "content": "何か思い当ることは？",
            "Chinese": "有什么能想到的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:35:18",
            "content": "うーん人間性のおかしい人が周りに多いからですかね。",
            "Chinese": "嗯……也许是因为周围人品有问题的人太多了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:35:38",
            "content": "おや、そうなんですね。",
            "Chinese": "哦？是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:35:55",
            "content": "例えばどんな人ですか？",
            "Chinese": "比如说，是什么样的人呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:36:31",
            "content": "結果が出れば自分のおかげ、うまくいかなければ人のせいみたいな感じですかね。",
            "Chinese": "大概就是那种，事情成功了就归功于自己，失败了就怪罪别人的人吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:36:55",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:37:37",
            "content": "周りがそうだと自分の人間性もおかしくなりそうです",
            "Chinese": "周围都是那样的人，感觉我自己的品行都要变得奇怪了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:38:04",
            "content": "それに対して、あなたのお仕事をやっていく上での方針はどんなやりかただったの？",
            "Chinese": "面对这种情况，您在工作上秉持的是什么样的方针呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:38:45",
            "content": "シンプルだと思います。",
            "Chinese": "我觉得很简单。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:38:59",
            "content": "必要なことは努力する。",
            "Chinese": "该努力的就努力。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:39:11",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:39:14",
            "content": "結果が出なければ課題を探す。",
            "Chinese": "出不了结果就找问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:39:24",
            "content": "すてきですね",
            "Chinese": "很棒呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:39:26",
            "content": "課題に取り組んで改善する",
            "Chinese": "针对问题去改进。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:39:37",
            "content": "すごい",
            "Chinese": "真了不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:39:56",
            "content": "それをやり続けてきたんですね。",
            "Chinese": "您一直都是这样坚持过来的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:40:00",
            "content": "頑張って結果が出れば褒めるし、出なければ反省する",
            "Chinese": "努力后有结果就表扬，没有就反省。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:40:12",
            "content": "そーですね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:40:17",
            "content": "いいですね。",
            "Chinese": "真好。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:40:22",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:40:27",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:40:56",
            "content": "人の尊厳は大切だとおもうからです。",
            "Chinese": "因为我认为人的尊严很重要。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:41:11",
            "content": "そうですよね。",
            "Chinese": "是的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:41:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:42:22",
            "content": "素晴らしいやり方だと思うけど、それで周りの結果を重視する人たちとうまくいかなくなったの？",
            "Chinese": "我觉得这是很棒的做法，但正因如此，才和周围那些只看重结果的人处不来了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:42:45",
            "content": "考え方が違うのだと思います",
            "Chinese": "我觉得是思考方式不同吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:43:06",
            "content": "どういう風に違うのかな？",
            "Chinese": "具体有什么不同呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:43:27",
            "content": "それはよくわからないです。違うことだけはわかります。",
            "Chinese": "这个我也说不清，只知道就是不一样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:43:38",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:43:55",
            "content": "机上の空論は簡単です。",
            "Chinese": "纸上谈兵很简单。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:44:08",
            "content": "ということは？",
            "Chinese": "您的意思是？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:44:39",
            "content": "何が起こったの？",
            "Chinese": "发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:44:44",
            "content": "そのままです。",
            "Chinese": "就是字面意思。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:45:06",
            "content": "できたらいいな。は簡単す。",
            "Chinese": "“要是能做到就好了”，说起来很简单。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:45:21",
            "content": "そうだよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:45:27",
            "content": "するためにはいろんな準備が必要です。",
            "Chinese": "但要做到就需要做各种各样的准备。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:45:38",
            "content": "ですよね。",
            "Chinese": "没错。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:46:13",
            "content": "で、楽になる方法は教えてもらえないですか？",
            "Chinese": "所以，能告诉我解脱的方法吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:47:13",
            "content": "ひょっとして、あなたはしっかり準備をする、周りの人は準備に時間をかけないという違いが起こっているのかしら？",
            "Chinese": "会不会是，您会认真做准备，而周围人却不愿在准备上花时间，存在这样的差异呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:47:43",
            "content": "違うと思います",
            "Chinese": "我觉得不是。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:48:19",
            "content": "どんな風に違うのかな？教えてくれる？",
            "Chinese": "具体哪里不一样呢？能跟我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:48:50",
            "content": "やり方が違う",
            "Chinese": "做法不同。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:49:03",
            "content": "結果までの方法が違う",
            "Chinese": "达成结果的过程不一样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:49:09",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:49:16",
            "content": "死んだら簡単ですけど、自殺はよくないかなと思うので、誰が殺してくれたらいいですけど、なかなかそんな人見つけれないですし。",
            "Chinese": "死了倒是很简单，但自杀又觉得不太好，所以要是有人能杀了我倒好了，可又找不到这样的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:49:56",
            "content": "そこまで思っているですね。",
            "Chinese": "您已经想到这个地步了啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:50:14",
            "content": "はい。だから相談に来ています。",
            "Chinese": "是的。所以我才来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:50:42",
            "content": "その思いを他に誰かに相談したことはありますか？",
            "Chinese": "您是否向其他人倾诉过这些想法？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:50:53",
            "content": "ないです。する気もありません。",
            "Chinese": "没有。也不想谈。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:50:58",
            "content": "だから、ここに来ています。",
            "Chinese": "所以，我才来这里。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:51:17",
            "content": "そうですよね",
            "Chinese": "是的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:51:32",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:51:50",
            "content": "死んだらだめなんですかね？",
            "Chinese": "死了不行吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:51:52",
            "content": "そしてここに来られたからにあ何か手がかりを探していらっしゃるんですよね。",
            "Chinese": "您来这里应该是想寻找一些线索吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:52:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:54:06",
            "content": "来てくれてありがとう。",
            "Chinese": "谢谢您能来。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:54:21",
            "content": "一緒に考えよう。",
            "Chinese": "我们一起想想办法吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:54:31",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:54:49",
            "content": "さっき仕事に疲れてしまったと教えてくれたよね。",
            "Chinese": "您刚才告诉我对工作感到疲惫了，是吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:54:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:55:14",
            "content": "そこまではあっている？",
            "Chinese": "到这里为止都没错吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:55:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:55:50",
            "content": "今での1日16時間も働いている。",
            "Chinese": "现在每天还要工作16个小时。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:56:01",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:56:10",
            "content": "一つだけ言ってもいい？",
            "Chinese": "我可以说一件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:56:15",
            "content": "はい",
            "Chinese": "请说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:56:34",
            "content": "もしかして、疲れすぎているのではない？",
            "Chinese": "您会不会是太累了？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:56:50",
            "content": "それは自覚しています",
            "Chinese": "这一点我有自觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:57:01",
            "content": "ですよね。",
            "Chinese": "是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:57:18",
            "content": "そこだと思いますよ。",
            "Chinese": "我想问题就在这里。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:57:37",
            "content": "は？疲れてるから死にたいということですか？",
            "Chinese": "哈？您的意思是因为累了所以想死吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:58:21",
            "content": "疲れすぎているので、もう、何もかも投げ出したくなっているという心の状態だと思います。",
            "Chinese": "我认为，是因为您太过疲劳，所以产生了一种想抛下一切的心理状态。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:58:30",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:58:33",
            "content": "いかがでしょうか？",
            "Chinese": "您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:58:49",
            "content": "うーん。それもあるとは思いますが…",
            "Chinese": "嗯……我觉得也有那方面的原因，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:59:03",
            "content": "他に何か？",
            "Chinese": "还有其他原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 11:59:33",
            "content": "環境",
            "Chinese": "环境。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 11:59:43",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 12:00:05",
            "content": "今の職場環境が嫌になったということ？",
            "Chinese": "您的意思是讨厌现在的工作环境吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 12:00:45",
            "content": "いや？とか、仕事において関係あるんですか？",
            "Chinese": "讨厌？这和工作有关系吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 12:01:39",
            "content": "とても深い関係があると思いますが、エヴァさんはそうは思わないの？",
            "Chinese": "我认为有很深的关系，但艾娃女士不这么觉得吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 12:02:03",
            "content": "さっき周りの人たちと考えが違うということにこだわっていたと思うけど。",
            "Chinese": "我记得您刚才很在意和周围的人想法不同这件事。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 12:02:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 12:02:48",
            "content": "周りの人たちって職場環境の大きな要素になるんじゃないかな・・・",
            "Chinese": "周围的人不正是工作环境的重要组成部分吗……"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 12:02:57",
            "content": "なりますよ",
            "Chinese": "是的，会的。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 12:03:03",
            "content": "それの改善方法は？",
            "Chinese": "那有什么改善的方法吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 12:04:03",
            "content": "あなたの職場における立場に寄って違ってくると思います。",
            "Chinese": "我想这取决于您在职场中的职位。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 12:04:48",
            "content": "もし、あなたが職場の人たちに影響を与えることのできる立場にいるなら、メンバーに影響を与える工夫をすること。",
            "Chinese": "如果您处在能影响他人的位置，就可以想一些办法去影响团队成员。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 12:05:05",
            "content": "リーダーです。どうやって？",
            "Chinese": "我是领导。要怎么做？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 12:05:20",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 12:05:30",
            "content": "どんな工夫？",
            "Chinese": "可以有哪些办法？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 12:06:09",
            "content": "であれば、方法はいくつかありそうです。",
            "Chinese": "那样的话，方法应该有好几种。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 12:06:27",
            "content": "言ってもいいですか？",
            "Chinese": "我可以说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 12:06:40",
            "content": "どうぞ",
            "Chinese": "请说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/03/08(日) 12:07:11",
            "content": "１つ　先ずあなたの上司に報告し、ざっくばらんに相談する。",
            "Chinese": "第一，先向您的上司汇报，坦诚地请教和商量。"
        },
        {
            "role": "クライアント",
            "time": "2020/03/08(日) 12:07:19",
