{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:00:01",
            "content": "こんにちは、相談があります。",
            "Chinese": "您好，我有件事想咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:00:07",
            "content": "こんにちは相談員です。よろしくお願いいたします。",
            "Chinese": "您好，我是咨询师。请多多指教。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:00:18",
            "content": "よろしくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:00:21",
            "content": "最初に年齢と性別を教えていただけますか？",
            "Chinese": "首先，能请您告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:00:29",
            "content": "22歳男性です",
            "Chinese": "22岁，男性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:00:42",
            "content": "お返事ありがとうございます。",
            "Chinese": "感谢您的回复。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:00:55",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询什么样的问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:01:53",
            "content": "私の田舎コンプレックスがすごくて、とてもストレスに感じているので、良い考え方や付き合い方を一緒に考えていただければと思っています。",
            "Chinese": "我对自己来自农村有很强的自卑感，感到很大的压力，希望能和您一起探讨一些更好的看法和应对方式。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:02:21",
            "content": "はい分かりました。",
            "Chinese": "好的，我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:02:44",
            "content": "どの様な時にそのようなことが気になるのですか？",
            "Chinese": "您在什么样的情况下会感到这种困扰呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:03:47",
            "content": "やはり田舎になくて都会にあるものの差を感じる時ですかね。",
            "Chinese": "应该是在感受到乡下没有而城市里有的东西的差距时吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:04:08",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:04:32",
            "content": "日々の生活の中で感じてしまうと辛いものがありますよね。",
            "Chinese": "在日常生活中感受到这些，确实会很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:04:40",
            "content": "そうなんです。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:04:55",
            "content": "例えば、どんなものですか？",
            "Chinese": "比如说，具体是哪些方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:06:31",
            "content": "私はすごい田舎出身で、大学で街の方で下宿したりパートナーが大阪の人で大阪にも何度も行ったということもあり、生活の不便さや物の充実度で差を感じます。",
            "Chinese": "我出身于一个非常偏僻的乡村，大学时在城里租房住，伴侣是大阪人，我也去过大阪很多次，因此在生活便利性和物质丰富程度上感受到了差距。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:07:30",
            "content": "そうなんですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:07:37",
            "content": "今は地元に戻ってきていて田舎で生活している感じです。",
            "Chinese": "现在已经回到老家，在乡下生活着。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:08:09",
            "content": "今は故郷に戻って暮らしていらっしゃるんですね。",
            "Chinese": "您现在是回到故乡生活了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:08:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:08:15",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:08:49",
            "content": "戻って来られての、故郷の生活感はいかがですか？",
            "Chinese": "回到故乡后，您的生活感受如何呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:09:10",
            "content": "一度故郷を出る前に比べてとても不便で辛く感じます。",
            "Chinese": "和离开家乡之前相比，现在觉得非常不方便，也很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:09:29",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:09:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:09:58",
            "content": "都会の便利な生活を知ってしまっただけに、比較してしまうのでしょうね・・・",
            "Chinese": "正因为体验过城市便利的生活，所以就不免会拿来比较吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:10:55",
            "content": "そうなんです。都会に当たり前にあるものがない生活が結構きついです。",
            "Chinese": "是啊。没有城市里理所当然存在的东西的生活，真的挺难熬。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:11:12",
            "content": "たしかに。",
            "Chinese": "确实如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:11:38",
            "content": "都会では○○があったのになと思うとちょっと悔しい思いでしょうか？",
            "Chinese": "当您想到“要是在城市里就有XX了”的时候，会觉得有些不甘心吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:12:26",
            "content": "悔しい思いと、私が好きなことがとことんできないもどかしさもあります。",
            "Chinese": "既有不甘心，也有无法尽情做自己喜欢的事的那种着急无奈。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:13:01",
            "content": "特になくて困るなというのは何ですか？",
            "Chinese": "具体来说，什么东西的缺失让您觉得最困扰呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:14:40",
            "content": "1番は交通の便だと思います。",
            "Chinese": "我觉得最主要的是交通便利性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:14:55",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:15:24",
            "content": "たしかに。メインの交通はバスですか？",
            "Chinese": "确实。主要的交通工具是公交车吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:16:00",
            "content": "バスも列車もあるのですが、バスも一日4本で列車も1時間に多くて1本です。",
            "Chinese": "有公交也有火车，但公交一天只有4班，火车一小时最多一班。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:16:18",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:16:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:16:43",
            "content": "それじゃ、ちょっと気楽にお出かけという訳にもいかないですよね・・・",
            "Chinese": "那样的话，就很难说走就走地出去逛逛了吧……"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:16:47",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:17:15",
            "content": "しっかり行きと帰りの計画を立ててからでないと、とか・・・",
            "Chinese": "必须把去程和回程都计划好之后才能出门之类的……"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:17:25",
            "content": "ちょっとお出かけが結構ストレス発散兼趣味のような感じだったので",
            "Chinese": "因为随便出门逛逛对我来说既是解压也是一种爱好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:17:48",
            "content": "都会にいた時はですね",
            "Chinese": "您是指在城市的时候是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:17:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:18:40",
            "content": "じゃあ　都会にいた時の気楽なストレス発散方法が無くなってしまったのですね。",
            "Chinese": "那么，您在城市里那种轻松的解压方式就没有了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:18:50",
            "content": "そうなんです。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:19:07",
            "content": "都会でたくさん好きなものを見つけたのですがそれが出来なくなっちゃった感じです。",
            "Chinese": "在城市里我找到了许多喜欢的事物，但现在感觉都做不了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:19:09",
            "content": "それはお困りですね・・・",
            "Chinese": "那确实很困扰呢..."
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:19:24",
            "content": "そうなんです、とても困っています。",
            "Chinese": "是的，非常困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:19:45",
            "content": "そうですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:20:06",
            "content": "今は、趣味とかストレス発散にはどんなことをしているのですか？",
            "Chinese": "现在，您有什么兴趣爱好或者用什么方式来解压呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:20:45",
            "content": "YouTubeをみたりするくらいです。",
            "Chinese": "也就是看看YouTube之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:20:57",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:21:25",
            "content": "YouTubeはどこでも見られますからね。",
            "Chinese": "因为YouTube在哪里都能看。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:21:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:21:44",
            "content": "唯一の楽しみという所でしょうか？",
            "Chinese": "这算是您唯一的乐趣了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:22:09",
            "content": "そうですね。",
            "Chinese": "可以这么说。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:22:49",
            "content": "パートナーさんは大阪の方とのことでしたが、パートナーさんは居間の暮しについては何と言っているのですか？",
            "Chinese": "您提到您的伴侣是大阪人，那么TA对您现在的生活有什么看法呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:23:29",
            "content": "パートナーとは遠距離中で、私の今の暮らしをすごくかわいそうだと言っています。",
            "Chinese": "我和伴侣正在异地恋，TA说我现在的生活很可怜。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:24:18",
            "content": "遠距離なんですね。パートナーさんは大阪にいらっしゃって都会の生活をしているんですね。",
            "Chinese": "原来是异地恋。您的伴侣住在大阪，过着城市生活呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:24:24",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:24:46",
            "content": "そうすると、あなたとしてもうらやましくなってしまいますよね。",
            "Chinese": "这样的话，您也难免会羡慕吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:25:00",
            "content": "はい。とても羨ましいです",
            "Chinese": "是的，非常羡慕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:25:14",
            "content": "ですよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:25:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:25:51",
            "content": "お二人の会話の中にも、パートナーさんからはいろいろ都会の生活の話が出てくるでしょうに・・・",
            "Chinese": "在你们俩的对话中，您的伴侣大概也会经常提起城市里的生活吧..."
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:27:24",
            "content": "都会の話を聞くの自体はあまりストレスに感じないですね。",
            "Chinese": "听城市的话题本身并不会让我感到很有压力。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:27:43",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:27:56",
            "content": "どちらかと言うと都会の話は好きなのでワクワクする感じがあります。",
            "Chinese": "与其说压力，不如说我喜欢聊城市，听了会有点兴奋。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:28:10",
            "content": "そうなんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:28:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:28:47",
            "content": "じゃあ、パートナーさんと都会の話で盛り上がることもよくあると言う感じみたいですね。",
            "Chinese": "那么，看来您和伴侣也经常因为城市的话题聊得很开心呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:28:54",
            "content": "そうですね。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:29:08",
            "content": "やはり都会に憧れがある感じです。",
            "Chinese": "果然我还是很向往城市。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:29:27",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:29:38",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:30:08",
            "content": "将来的には、こうしたいという考えはいかがですか？",
            "Chinese": "关于将来，您有什么样的打算呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:30:31",
            "content": "どこで、どんな暮らしがしたいとか・・・",
            "Chinese": "比如，想在哪里、过怎样的生活……"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:30:37",
            "content": "将来的には資格を取った後都会にでて生活をしたいと考えています",
            "Chinese": "我计划将来拿到资格证之后去城市里生活。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:31:11",
            "content": "やはり都会での生活を考えているんですね。",
            "Chinese": "您果然还是考虑在城市生活啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:31:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:31:48",
            "content": "ちなみに、今は資格を取るためのお勉強中なのですか？",
            "Chinese": "顺便问一下，您现在是为了考取资格证在学习吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:32:32",
            "content": "資格を取ってその仕事を始めるまで実家暮らしという感じです。",
            "Chinese": "打算一直住在老家，直到拿到资格并开始那份工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:32:49",
            "content": "そういうことなんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:32:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 15:33:09",
            "content": "大きな資格のようですね。",
            "Chinese": "听起来是个很重要的资格证呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 15:34:32",
