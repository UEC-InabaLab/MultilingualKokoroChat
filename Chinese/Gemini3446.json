{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 18:52:11",
            "content": "（宜しくお願い致します）",
            "Chinese": "（请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 18:53:43",
            "content": "（本日は、私が非常に難題だった事案をテーマにさせて頂きます）",
            "Chinese": "（今天，我想以一个对我来说非常棘手的案例作为主题。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 18:56:02",
            "content": "（こんばんは。本日はよろしくお願いいたします。）",
            "Chinese": "（晚上好。今天请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 18:56:27",
            "content": "（承知いたしました。）",
            "Chinese": "（明白了。）"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 18:56:36",
            "content": "（ありがとうございます）",
            "Chinese": "（谢谢您。）"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 18:57:28",
            "content": "（時間になりましたらスタートさせて頂きます）",
            "Chinese": "（时间一到我这边就开始。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 18:58:16",
            "content": "（はい。よろしくお願いいたします。）",
            "Chinese": "（好的。请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:00:04",
            "content": "宜しくお願いします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:00:33",
            "content": "こんばんは。相談員です。本日はよろしくお願いいたします。はじめにご年齢、性別を教えていただけますか？",
            "Chinese": "晚上好。我是咨询员。今天请多关照。首先，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:01:01",
            "content": "あまり言いたくありません",
            "Chinese": "我不太想说。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:01:48",
            "content": "かしこまりました。答えにくいことは全然答えなくても大丈夫ですからね。",
            "Chinese": "明白了。如果您觉得难以回答，完全可以不回答，没关系的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:01:55",
            "content": "本日はどのようなご相談ですか？",
            "Chinese": "今天您想咨询什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:01:58",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:02:19",
            "content": "生きるのに疲れました",
            "Chinese": "我活得好累。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:02:36",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:03:31",
            "content": "どういう時に疲れると感じるのか、あなたのことを知りたいので言える範囲で教えていただけますか？",
            "Chinese": "是在什么时候会感到疲惫呢？为了更好地了解您，可以请您在方便的范围内告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:03:59",
            "content": "やることが多すぎてもう疲れました",
            "Chinese": "要做的事情太多了，我已经累了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:04:24",
            "content": "とにかく疲れました、色々",
            "Chinese": "总之就是累，各方面都是。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:04:30",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:04:42",
            "content": "どうすればいいですか",
            "Chinese": "我该怎么办？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:05:06",
            "content": "やることありすぎてキャパオーバーという感じなのでしょうか。",
            "Chinese": "是感觉要做的事情太多，已经超出负荷了吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:05:21",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:05:38",
            "content": "はい。大事なことなので、一緒に考えていきましょうね。",
            "Chinese": "好的。因为这是很重要的事情，我们一起想一想吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:05:47",
            "content": "もう生きていても辛い",
            "Chinese": "活着本身已经很痛苦了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:06:08",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:06:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:06:42",
            "content": "ここで話せは解決しますか",
            "Chinese": "在这里说出来能解决问题吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:07:19",
            "content": "ここではあなたのために一緒に考える時間になります。",
            "Chinese": "在这里，我会陪着您一起思考。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:07:45",
            "content": "なので話せる範囲でいいので",
            "Chinese": "所以，在您方便说的范围内就好。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:07:55",
            "content": "じゃあここでは解決出来ないんですね",
            "Chinese": "那就是说在这里解决不了，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:08:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:08:45",
            "content": "解決できるかどうかまだわかりませんが、",
            "Chinese": "虽然还不知道能不能解决，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:09:07",
            "content": "あなたのために一緒に考えさせていただきますね。",
            "Chinese": "但我会为了您，和您一起认真思考的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:09:11",
            "content": "とにかく疲れました",
            "Chinese": "总之就是很累。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:09:50",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:10:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:10:40",
            "content": "今社会人でらっしゃいますか？それとも学生さんですか？",
            "Chinese": "您现在是在工作吗？还是学生呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:11:06",
            "content": "社会人",
            "Chinese": "在工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:11:30",
            "content": "教えていただき、ありがとうございます。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:11:53",
            "content": "生きるのしんどいです",
            "Chinese": "活着好辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:12:47",
            "content": "ええ。そんな中、相談しに来てくださったんですね。",
            "Chinese": "嗯。在这样的情况下，您还是来咨询了呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:13:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:13:25",
            "content": "どんな時しんどさを感じますか？例えば、",
            "Chinese": "在什么时候会感到辛苦呢？比如，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:13:27",
            "content": "疲れました、もう",
            "Chinese": "我累了，真的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:13:49",
            "content": "仕事が忙しい時とか、",
            "Chinese": "比如工作很忙的时候，或者……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:13:56",
            "content": "色々ありすぎて決められません",
            "Chinese": "各种事情太多了，没法具体说。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:14:44",
            "content": "そうだったんですね。ありすぎるくらいあるからこそ、しんどいと感じているんですね。。。",
            "Chinese": "原来是这样。正因为事情多到应接不暇，才会感觉这么辛苦啊……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:15:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:16:01",
            "content": "疲れたとか、しんどさを感じた時は、どなたにご相談していますか？",
            "Chinese": "当您觉得累、觉得辛苦的时候，通常会和谁倾诉呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:16:32",
            "content": "相談できないので来ました",
            "Chinese": "就是因为没人可以商量，我才来这里的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:17:32",
            "content": "今までずっと一人で抱えてきたんですね。",
            "Chinese": "您一直以来都是一个人扛着所有事的啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:17:44",
            "content": "もう自分なんて居なくても周りは困らないだろうし",
            "Chinese": "反正就算没有我，周围的人大概也不会困扰吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:18:16",
            "content": "うん、困らないというのは",
            "Chinese": "嗯，您说“不会困扰”，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:18:26",
            "content": "なぜそう思うのですか？",
            "Chinese": "为什么会这么想呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:19:05",
            "content": "そんなこと言われても·······",
            "Chinese": "就算您这么问我……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:20:00",
            "content": "はい。周りの人が困る可能性もあるかもしれないですよね。",
            "Chinese": "是的。周围的人也可能会感到困扰，不是吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:20:17",
            "content": "分かりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:20:30",
            "content": "どうしてですか",
            "Chinese": "为什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:21:03",
            "content": "確実ではないので、そうかもしれないし、そうでないかもしれない",
            "Chinese": "因为并不确定，所以可能是那样，也可能不是那样。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:21:12",
            "content": "ということです。",
            "Chinese": "就是这个意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:21:20",
            "content": "今日はどんなことを一番相談したいですか？",
            "Chinese": "今天您最想商量的是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:21:36",
            "content": "で、どうすればいいんですか",
            "Chinese": "所以，我到底该怎么办？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:22:24",
            "content": "生きるのに疲れたということをなんとかしたい、ということでよろしいでしょうか。",
            "Chinese": "也就是说，您是希望能想办法改善“活得很累”的这种状况，我这样理解对吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:22:34",
            "content": "何度も言いますが、もう疲れたんですよ",
            "Chinese": "我都说了很多遍了，我已经累了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:23:16",
            "content": "そうなんですよね。何度も確認させてしまい、申し訳ございませんでした。",
            "Chinese": "是的，您说得对。让您重复确认了好几次，非常抱歉。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:24:26",
            "content": "疲れた、しんどいなと感じるようになったのはいつ頃からですか？",
            "Chinese": "是从什么时候开始感到疲惫、辛苦的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:25:03",
            "content": "一年くらい前です",
            "Chinese": "大概一年前。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:25:52",
            "content": "そうなんですね。一年もの長い間しんどい思いをされてたんですね。。。",
            "Chinese": "是这样啊。这么说来，您已经辛苦了整整一年这么久了啊……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:26:07",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:26:54",
            "content": "それは辛かったですよね…",
            "Chinese": "那一定很难熬吧…"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:27:19",
            "content": "疲れました",
            "Chinese": "我累了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:27:28",
            "content": "うんうん、",
            "Chinese": "嗯嗯，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:28:21",
            "content": "疲れた、しんどいと感じるときはこれまで、どのようにされてきましたか？",
            "Chinese": "到目前为止，当您感到疲惫、辛苦的时候，您都是怎么做的呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:28:31",
            "content": "音楽を聴くとか",
            "Chinese": "比如听音乐之类的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:28:55",
            "content": "あなたに何が分かるんですか？",
            "Chinese": "你又能懂什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:29:33",
            "content": "ええ。あなたのことを知りたいのできいております。",
            "Chinese": "嗯。我之所以这样问，是想更多地了解您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:29:46",
            "content": "あなたにとってとても大事なことなので。",
            "Chinese": "因为这对您来说是非常重要的事情。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:29:55",
            "content": "この先どうすればいいですか",
            "Chinese": "接下来我该怎么办？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:30:40",
            "content": "はい。どうすればいいか、一緒に考えていきましょうね。",
            "Chinese": "好的。我们一起来想想该怎么办吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:30:45",
            "content": "仕事が沢山ありすぎて",
            "Chinese": "工作实在太多了，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:31:02",
            "content": "うんうん、",
            "Chinese": "嗯嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:31:13",
            "content": "皆押し付けて来ますから。",
            "Chinese": "因为大家都把工作往我这儿推。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:32:13",
            "content": "そうだったんですね。それでは仕事が終わらないし、",
            "Chinese": "原来是这样。那样的话工作就做不完，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:32:33",
            "content": "疲れるのも無理はないと思います。",
            "Chinese": "会感到疲惫也是理所当然的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:32:49",
            "content": "そうですね",
            "Chinese": "确实是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:33:18",
            "content": "押し付けるのはおかしい話ですよね",
            "Chinese": "把工作硬推给别人，这事儿本身就很不合理，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:33:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:34:13",
            "content": "仕事はみんな押し付けてくるせいで手に負えなくなる感じですか？",
            "Chinese": "是不是因为大家把工作都推给您，导致您有些应付不过来了？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:34:28",
            "content": "でも断れません",
            "Chinese": "但我没办法拒绝。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:35:41",
            "content": "そうなんですね。断れず、今まで押し付けられた分も頑張って仕事されてらしたんですね。",
            "Chinese": "是这样啊。因为无法拒绝，您一直以来连别人推过来的工作也努力撑着做完了呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:35:53",
            "content": "だから困ってるんで",
            "Chinese": "所以我才困扰啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:36:03",
            "content": "そうですよね",
            "Chinese": "说得也是。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:36:18",
            "content": "断るのは勇気がいるって感じですか？",
            "Chinese": "是不是觉得，要开口拒绝是件需要勇气的事？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:37:15",
            "content": "断るなんて出来ないんですよ",
            "Chinese": "我根本做不到拒绝这种事。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:38:03",
            "content": "ええ。もし断ったとすると、どんなイメージがしますか？",
            "Chinese": "嗯。如果拒绝了的话，您会想象到什么样的情景呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:38:51",
            "content": "なおさら押し付けて来るかも？",
            "Chinese": "他们可能会变本加厉地把工作推给我吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:39:21",
            "content": "それは困りますよね。",
            "Chinese": "那确实会很困扰呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:40:26",
            "content": "では仮にもし断ることに成功したら、あなたはどう思いますか？",
            "Chinese": "那么，假如您成功地拒绝了，您自己会怎么想呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:40:54",
            "content": "無理です",
            "Chinese": "不可能的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:41:22",
            "content": "信頼出来る人も居ません",
            "Chinese": "也没有可以信赖的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:41:43",
            "content": "はい。ちなみに断ったことは今までないのでしょうか？",
            "Chinese": "好的。顺便问一下，您以前从来没有拒绝过吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:42:10",
            "content": "···········",
            "Chinese": "……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:42:45",
            "content": "断ろうとしたことはありますが",
            "Chinese": "虽然我试过想要拒绝。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:42:53",
            "content": "ええ、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:43:59",
            "content": "ダメだと押し通されました",
            "Chinese": "但被对方一句“不行”给强行驳回了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:44:44",
            "content": "そうだったんですね",
            "Chinese": "原来是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:45:02",
            "content": "それって理不尽ですよね",
            "Chinese": "那也太不讲理了，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:45:25",
            "content": "はい、それで諦めました",
            "Chinese": "是的，所以我就放弃了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:46:11",
            "content": "ええ。それで今まで人の分まで一生懸命に頑張ってこられたんですね。",
            "Chinese": "嗯。所以您一直以来，连别人的份也一起拼命地扛过来了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:46:35",
            "content": "仕事を辞めたほうが良いですか?",
            "Chinese": "我是不是辞职比较好？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:47:03",
            "content": "ご自身ではどう考えておられましたか？",
            "Chinese": "您自己是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:47:16",
            "content": "パワハラ？",
            "Chinese": "这算是职场霸凌吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:48:04",
            "content": "ええ、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:48:12",
            "content": "分からないですけど。",
            "Chinese": "我也不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:48:27",
            "content": "ちなみに仕事を押し付けてくる以外には何かありますか？",
            "Chinese": "顺便问一下，除了把工作推给您之外，还有其他类似的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:49:29",
            "content": "·····",
            "Chinese": "……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:49:57",
            "content": "話しにくいというか、",
            "Chinese": "该怎么说呢，有点难以启齿。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:50:04",
            "content": "うんうん、",
            "Chinese": "嗯嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:50:41",
            "content": "ええと·····",
            "Chinese": "那个……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:50:58",
            "content": "ゆっくりでいいですからね",
            "Chinese": "不着急，您慢慢说就好。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:51:10",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:52:05",
            "content": "上司も同僚も威圧感があります。",
            "Chinese": "上司和同事都给我很强的压迫感。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:52:38",
            "content": "これがパワハラなんでしょうか。",
            "Chinese": "这算是职场霸凌吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:53:19",
            "content": "ええ。威圧感を感じるなか、仕事を押し付けられて本当にしんどかったですよね。。。",
            "Chinese": "嗯。在那种压迫感之下，还被硬塞了工作，一定非常辛苦吧……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:53:57",
            "content": "仕事を辞めるしかないですかね。",
            "Chinese": "是不是只能辞职了呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:54:17",
            "content": "ではもし仕事を押し付けられたとして、",
            "Chinese": "那么，假如再有工作被推给您，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:55:07",
            "content": "一度断り、何か文句などを言われたら、",
            "Chinese": "您先拒绝一次，如果对方因此抱怨或说了什么难听的话，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:55:35",
            "content": "どうするのですか？",
            "Chinese": "那该怎么办呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:55:53",
            "content": "「パワハラですよ」とパワハラを盾にするのはいかがでしょうか？",
            "Chinese": "您觉得把“你这是职场霸凌”这句话当作挡箭牌怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:56:08",
            "content": "えっ!",
            "Chinese": "诶！"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:56:23",
            "content": "できるかどうか不安かもしれませんが、",
            "Chinese": "也许您会担心自己能不能做到，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:56:57",
            "content": "出来ません出来ません",
            "Chinese": "做不到，做不到。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:57:08",
            "content": "ハラスメントっていうのは、被害者側の権利なんですよ。",
            "Chinese": "所谓的职场霸凌，是受害者一方可以主张的权利哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:57:23",
            "content": "なので、",
            "Chinese": "所以，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:57:50",
            "content": "上司だろうと立場上はあなたが優位なのでよ。",
            "Chinese": "即使对方是上司，从立场上来说您是占优势的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 19:58:01",
            "content": "それは分かりますが、これ以上辛い目に遭いたくないです。",
            "Chinese": "道理我明白，但我不想再经历更痛苦的事情了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:59:09",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 19:59:38",
            "content": "でもパワハラを武器にしますよ、という姿勢を見せるとあなたは仕事を押し付けられることはなくなると思うのですが、いかがですか？",
            "Chinese": "但是，如果您表现出“我会用职场霸凌来维权”的态度，我想他们应该就不会再把工作推给您了，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:00:13",
            "content": "そう簡単には·········",
            "Chinese": "恐怕没那么简单……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:00:40",
            "content": "もちろん簡単にはいかないかもしれませんが、",
            "Chinese": "当然，可能不会那么简单，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:00:50",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:01:19",
            "content": "誰も味方なんていないし、",
            "Chinese": "反正也没有人会站在我这边，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:01:36",
            "content": "味方はその会社にいないかもしれませんが、",
            "Chinese": "也许在公司里没有支持您的人，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:01:46",
            "content": "聞く耳持たないのではと。",
            "Chinese": "我担心他们根本听不进去。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:02:05",
            "content": "その会社以外は全てあなたの味方ですよ。法律などもです。",
            "Chinese": "公司以外的所有人都会是您的后盾，法律也是。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:02:45",
            "content": "（お時間ですが、どうされますか？）",
            "Chinese": "（时间到了，您看接下来怎么办？）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:02:48",
            "content": "断ってもし何か言われたら、",
            "Chinese": "如果拒绝后对方说了什么，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:03:05",
            "content": "訴訟ですか？",
            "Chinese": "是要提起诉讼吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:03:10",
            "content": "（あと5分よろしいでしょうか？）",
            "Chinese": "（可以再延长5分钟吗？）"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:03:31",
            "content": "（私は大丈夫です）",
            "Chinese": "（我没问题。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:04:10",
            "content": "自治体に相談できる窓口がありますので、訴えるのもできますよね。",
            "Chinese": "地方政府都设有可以咨询的窗口，所以您也可以向他们提出申诉。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:04:25",
            "content": "（ありがとうございます）",
            "Chinese": "（谢谢您。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:05:03",
            "content": "あと、",
            "Chinese": "另外，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:05:05",
            "content": "そんなことをしたらもう会社に居られなくなります",
            "Chinese": "如果真那么做了，我在公司就待不下去了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:05:37",
            "content": "でもその会社以外にも働き先は色々あるので、",
            "Chinese": "但是除了那家公司，也还有很多其他的工作机会，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:05:40",
            "content": "どんな顔で会社にいれば良いのですか",
            "Chinese": "那我以后还怎么在公司待下去啊？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:06:07",
            "content": "転職する、という選択肢を常に持っておくといいと思います。",
            "Chinese": "我觉得最好随时都保留着“跳槽”这个选项。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:06:19",
            "content": "憧れの業界だったんです",
            "Chinese": "这曾是我一直憧憬的行业。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:06:38",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:07:05",
            "content": "でも疲れました",
            "Chinese": "但我已经累了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:07:17",
            "content": "ええ。なので",
            "Chinese": "嗯。所以，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:07:27",
            "content": "どうして良いか分からないんです",
            "Chinese": "我不知道该怎么办才好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:08:13",
            "content": "あなたのタイミングで転職するというカードを選択するのがいいと思いますよ。",
            "Chinese": "我觉得，在您自己认为合适的时机，打出“跳槽”这张牌会比较好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:08:21",
            "content": "その選択肢があると、",
            "Chinese": "有了这个选项之后，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:09:01",
            "content": "やはりいざとなったら辞めるか、ということ？",
            "Chinese": "您的意思是说，到了万不得已的时候就辞职吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:09:15",
            "content": "何か嫌なこと言われても、「転職するからまぁいいや」と思えるようになるんです。",
            "Chinese": "就算再听到什么不中听的话，也能想着“反正我随时可以跳槽，无所谓了”，这样心态上就会轻松很多。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:09:35",
            "content": "もちろん転職しなくてもいいんですよ。",
            "Chinese": "当然，您也可以选择不跳槽。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:09:38",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:10:08",
            "content": "考えてみます",
            "Chinese": "我会考虑一下的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:10:17",
            "content": "ただ、いずれにせよ「転職」という選択肢があると、あなたは楽になれると思うのですが",
            "Chinese": "不过，无论如何，只要手里有“跳槽”这个选项，我想您就会轻松很多，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:10:25",
            "content": "いかがですか？",
            "Chinese": "您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:10:56",
            "content": "今は·····何とも",
            "Chinese": "现在……还不好说。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:11:48",
            "content": "今すぐに結論は出さなくて大丈夫ですからね。今までは人の分まで一生懸命に頑張ってこられましたが、これからは自分の為に仕事をすればそれで十分ですからね。",
            "Chinese": "现在不必急着下结论，没关系的。到目前为止，您已经连别人的份都拼命地扛下来了，从现在开始，您只要为自己工作就足够了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:12:09",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:12:37",
            "content": "お時間長引いてすみません、今日はこのあたりでよろしいですか？",
            "Chinese": "不好意思，超时了，今天就先到这里可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:12:48",
            "content": "よく考えます。また来て良いですか？",
            "Chinese": "我会好好想一想的。我还可以再来吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:12:58",
            "content": "もちろんです。",
            "Chinese": "当然可以。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/04(水) 20:13:10",
            "content": "いつでもお待ちしております。",
            "Chinese": "随时欢迎您再来。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/04(水) 20:13:36",
            "content": "明日ズル休みして考えてみます",
            "Chinese": "我明天想装病请个假，好好想一想。"
        },
        {
            "role": "カウンセラー",
