{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 20:51:22",
            "content": "こんばんは、21時からよろしくお願いします。",
            "Chinese": "晚上好，21点开始请多指教。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 20:59:19",
            "content": "（こんばんは、よろしくお願いいたします。）",
            "Chinese": "（晚上好，请多指教。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:00:20",
            "content": "それでは始めます。",
            "Chinese": "那么，我们开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:00:30",
            "content": "よろしくお願いいたします。",
            "Chinese": "好的，请多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:00:31",
            "content": "こんばんは、相談員です",
            "Chinese": "晚上好，我是咨询员。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:00:41",
            "content": "こんばんは。",
            "Chinese": "晚上好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:01:09",
            "content": "初めにあなたの年齢と性別を教えていただけますか？",
            "Chinese": "首先，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:01:40",
            "content": "16歳、女性です。",
            "Chinese": "16岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:01:50",
            "content": "教えてくださりありがとうございます",
            "Chinese": "感谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:02:10",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您有什么想咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:02:26",
            "content": "友達関係で悩んでいます",
            "Chinese": "我在朋友关系上很烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:02:40",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:02:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:03:06",
            "content": "どんなことがあったのでしょうか？",
            "Chinese": "发生了什么事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:03:41",
            "content": "グループの子達とあわないんです。一緒にいると疲れてしまいます。",
            "Chinese": "我跟小团体里的同学合不来。和她们在一起会觉得很累。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:04:00",
            "content": "それはしんどいですね",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:04:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:04:28",
            "content": "どんな所が合わないって感じますか？",
            "Chinese": "您觉得是哪些方面合不来呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:05:03",
            "content": "テンションが違うのと、趣味も違うんで、合わせると疲れてしまいます。",
            "Chinese": "我们的节奏不一样，兴趣也不同，硬要去迎合她们就很累。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:05:26",
            "content": "そなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:05:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:05:57",
            "content": "テンションが合わないと違和感を感じてしまいますよね",
            "Chinese": "当节奏对不上时，确实会觉得不自在呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:06:05",
            "content": "そうなんです",
            "Chinese": "是的，就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:06:39",
            "content": "その子達の方がテンションが高いって感じですか？",
            "Chinese": "您感觉她们那边的状态更嗨一些吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:06:49",
            "content": "そうなんです。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:06:57",
            "content": "なるほどね",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:07:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:07:33",
            "content": "周りのテンションが高すぎると、付いていけないって思ってしまいますよね",
            "Chinese": "周围的人情绪太高涨的话，会觉得自己跟不上节奏呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:07:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:08:07",
            "content": "どうしたらいいでしょうか？",
            "Chinese": "我该怎么办才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:09:07",
            "content": "どうしたらあなたの気持ちが楽になるかを、一緒に考えましょうね",
            "Chinese": "我们一起来想一想，怎样做能让您的心情轻松一些，好吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:09:22",
            "content": "はい、お願いいたします。",
            "Chinese": "好的，拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:09:44",
            "content": "そのために、もう少しお話しを聞かせてくださいね",
            "Chinese": "为了找到方法，请再多和我说一些情况好吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:09:53",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:10:30",
            "content": "１６歳というと、高校２年生でしょうか？",
            "Chinese": "16岁的话，是高二吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:11:44",
            "content": "高校１年生です。",
            "Chinese": "我是高一。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:12:05",
            "content": "そうでしたか",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:12:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:13:06",
            "content": "それでは、グループはこの春高校に入ってからできたんですね",
            "Chinese": "那么，这个小团体是今年春天升入高中后形成的，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:13:14",
            "content": "そうです。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:13:46",
            "content": "最初はどんな感じだった？",
            "Chinese": "一开始感觉怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:15:41",
            "content": "校則がゆるい高校なので、私、高校デビューしたくて、メガネをコンタクトにして、髪の毛を茶色にして、デジタルパーマをかけたんです。それで、頑張って陽キャをしたんですが、無理してたみたいで、疲れてしまって。",
            "Chinese": "因为我们高中的校规很松，我想在高中“出道”，就把眼镜换成了隐形眼镜，把头发染成了棕色，还烫了数码烫。然后，我努力扮演一个阳光开朗的人，但好像太勉强自己了，觉得很累。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:16:54",
            "content": "そうだったんだ",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:16:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:17:31",
            "content": "陽キャになってみたいって思ったのかな？",
            "Chinese": "是想成为一个阳光开朗的人，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:18:37",
            "content": "はい。中学時代に、陰キャのキモオタだってカースト上位のグループに嫌がらせされてたことがあって。",
            "Chinese": "是的。因为我初中时，曾被处于鄙视链顶端的团体欺负，他们说我是个“阴沉的恶心宅”。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:19:08",
            "content": "こうこうでは、もう惨めな思いしたくないって思ったんです",
            "Chinese": "所以我想，在高中不想再有那么悲惨的经历了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:19:29",
            "content": "中学時代に嫌な思いをされていたんですね",
            "Chinese": "原来您在初中时经历过那些不愉快的事啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:19:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:20:12",
            "content": "それでキャラを変えようと思ったんですね",
            "Chinese": "所以您才想改变自己的“人设”，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:20:19",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:21:28",
            "content": "でも、実際に変えてみたら",
            "Chinese": "可是，当真的改了之后……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:22:01",
            "content": "無理してる感じがしたんですね",
            "Chinese": "感觉是在勉强自己，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:22:36",
            "content": "はい。今、カースト上位のグループに入れてもらったんですが、テンションについていけないんです。でも、グループぬけたくないんです。どうしたらいいでしょうか？",
            "Chinese": "是的。现在，我虽然加入了金字塔顶端的团体，但跟不上她们的节奏。可是，我不想离开这个团体。我该怎么办才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:23:46",
            "content": "そっかー",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:23:55",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:24:04",
            "content": "先生だったらどうしますか？",
            "Chinese": "如果是老师您，会怎么办呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:24:19",
            "content": "グループはぬけたくないし、テンションにはついていけないし、苦しいところだよね",
            "Chinese": "既不想退出小团体，又跟不上她们的节奏，这确实让你左右为难，很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:24:46",
            "content": "とっても苦しいんです。苦しくて苦しくて仕方ないんです。",
            "Chinese": "我非常痛苦。痛苦得不得了。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:25:30",
            "content": "解決策が見つからないんです。",
            "Chinese": "我找不到解决的办法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:26:07",
            "content": "グループをぬけると、どうなりそうなのかな？",
            "Chinese": "如果离开这个团体，您觉得会怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:26:24",
            "content": "また、いじめられるのが怖いです。",
            "Chinese": "我怕又会被霸凌。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:27:14",
            "content": "下のグループの子たちはいじめられているんですね？",
            "Chinese": "也就是说，其他阶层较低的同学们正在被欺负，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:27:57",
            "content": "はい。一緒にバカにしています。それを一緒にやるのが辛いんです。でも、一緒にやらないとハブられるから。",
            "Chinese": "是的。我们也一起嘲笑她们。一起做这种事让我很难受。但如果不一起做，就会被排挤。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:29:34",
            "content": "本当はバカになんてしたくないのに、やらざるを得ないんだね",
            "Chinese": "明明根本不想去嘲笑别人，却又不得不这么做，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:29:44",
            "content": "そうなんです",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:30:10",
            "content": "どうしたらいいのか分からなくて",
            "Chinese": "我不知道该怎么办才好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:30:41",
            "content": "誰かに相談してみたことはありますか？",
            "Chinese": "您有试着和谁咨询或倾诉过吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:31:10",
            "content": "ここで先生に今相談したのが初めてです。",
            "Chinese": "这是我第一次在这里向老师您咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:31:48",
            "content": "ずっと１人で苦しみ続けていたんだね",
            "Chinese": "一直以来您都是一个人扛着这些痛苦呀。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:32:01",
            "content": "辛かったよね",
            "Chinese": "一定很辛苦吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:33:03",
            "content": "でも、今日思い切って相談しにきてくれてありがとう",
            "Chinese": "但是，今天您能鼓起勇气来找我商量，真的非常感谢。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:33:29",
            "content": "はい、ありがとうございます。誰も信じられません。私が虐められたとき、誰も助けてくれませんでしたから。自分で自分を守らなきゃいけないんです。",
            "Chinese": "是的，谢谢您。我谁也无法相信。因为我被欺负的时候，谁都没有帮我。我必须要自己保护自己。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:34:22",
            "content": "このグループにいれば、私は安全なんです。でも苦しいんです。",
            "Chinese": "只要待在这个团体里，我就是安全的。但是我很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:35:12",
            "content": "そうだよね",
            "Chinese": "是啊，我理解。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:37:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:37:31",
            "content": "そういう状況を親御さんに話したことはありますか？",
            "Chinese": "您有和父母谈过这种情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:38:33",
            "content": "父子家庭で、お父さんの仕事が忙しくて、夜も遅くに帰ってくるし、中々話す暇もないんです。",
            "Chinese": "我是单亲家庭，爸爸工作很忙，晚上也很晚才回来，没什么机会和他说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:38:52",
            "content": "そうなんだ",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:39:12",
            "content": "忙しくしていると、話しづらいよね",
            "Chinese": "他那么忙，确实很难开口呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:39:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:40:29",
            "content": "でも、辛い想いを身近な人には知っておいてもらいたいよね",
            "Chinese": "不过，还是希望身边亲近的人能知道您的痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:41:06",
            "content": "お父さんにこれ以上迷惑かけられないので。",
            "Chinese": "我不想再给爸爸添麻烦了。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:41:20",
            "content": "自分でなんとかしたいんです。",
            "Chinese": "我想自己想办法解决。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:41:29",
            "content": "そう思われるんですね",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/09/07(火) 21:42:06",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/09/07(火) 21:42:56",
