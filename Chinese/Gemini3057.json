{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 09:54:43",
            "content": "おはようございますよろしくお願い致します！",
            "Chinese": "早上好，请多关照！"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 09:56:19",
            "content": "おはようございます。こちらこそ宜しくお願い致します。",
            "Chinese": "早上好，也请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 09:59:57",
            "content": "始めさせて頂いてもよろしいでしょうか？",
            "Chinese": "请问，我可以开始了吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:10:09",
            "content": "いけますでしょうか？",
            "Chinese": "您方便吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:13:56",
            "content": "すいません。お待たせ致しました。大丈夫です。宜しくお願い致します。",
            "Chinese": "不好意思，让您久等了。没关系。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:14:21",
            "content": "（子どもの対応をしておりました。申し訳ございません（ ;  ; ）",
            "Chinese": "（刚才在照顾孩子，非常抱歉。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:14:59",
            "content": "そうでしたか全然大丈夫ですよ。",
            "Chinese": "原来是这样，完全没关系的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:15:13",
            "content": "ロープレ開始させて頂きますね。",
            "Chinese": "那么我们开始角色扮演吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:15:34",
            "content": "はい。お願い致します。",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:16:18",
            "content": "おはようございます相談員です。本日は色々な事をお話し下さいね。",
            "Chinese": "早上好，我是咨询师。今天请畅所欲言。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:16:31",
            "content": "宜しくお願いします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:17:11",
            "content": "こちらこそよろしくお願い致します。",
            "Chinese": "我也请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:17:26",
            "content": "本日はどのようなお悩みでご相談に来られましたか？",
            "Chinese": "今天您是带着什么样的烦恼来咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:17:43",
            "content": "勉強が出来ないんです",
            "Chinese": "我学习不好。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:18:38",
            "content": "スポーツも、何もかもできません",
            "Chinese": "运动也不行，什么都做不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:19:38",
            "content": "そうなのですね。差し支えなければ学年と性別を教えて頂きますか？",
            "Chinese": "这样啊。如果不介意的话，能告诉我您的年级和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:19:52",
            "content": "14歳　中2です",
            "Chinese": "14岁，初二。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:19:59",
            "content": "女です",
            "Chinese": "女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:20:25",
            "content": "教えて頂きありがとうございます。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:22:28",
            "content": "勉強もスポーツもできないと思われてるようですが、そのことについてどう思われていますか？",
            "Chinese": "您提到学习和运动都不行，对此您有什么想法呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:24:11",
            "content": "出来ないと思います。悲しいです",
            "Chinese": "我觉得自己不行。很难过。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:27:18",
            "content": "なるほどですね。悲しくなるのも無理はないですよね、、",
            "Chinese": "原来如此。会感到难过也是很正常的……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:27:41",
            "content": "特にできないと感じる時はどのような時ですか？",
            "Chinese": "在什么时候会特别感觉到自己不行呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:28:16",
            "content": "そうですね…テストとか",
            "Chinese": "嗯……比如考试的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:29:44",
            "content": "確かにテストは点数としてはっきり出ますもんね、、",
            "Chinese": "确实，考试成绩是很明显的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:30:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:30:51",
            "content": "スポーツに関してはどういう時に特に思われますか？",
            "Chinese": "关于运动方面，又是在什么时候会特别有这种感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:31:13",
            "content": "授業とか",
            "Chinese": "比如上体育课的时候。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:31:31",
            "content": "持久走大会で思います",
            "Chinese": "还有长跑比赛的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:32:46",
            "content": "なるほどですね。持久走も順位がはっきり出ますもんね。",
            "Chinese": "我明白了。长跑的名次也很直观。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:32:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:34:26",
            "content": "勉強、スポーツができないとおっしゃっていましたが、その中でもちょっとは好きだなと思えるスポーツや教科はありますか？",
            "Chinese": "您说自己学习和运动都不行，但在这其中，有没有您觉得稍微有点喜欢的运动或科目呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:34:34",
            "content": "ないです",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:37:40",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:37:50",
            "content": "はたあ",
            "Chinese": "唉。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:37:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:38:42",
            "content": "学校生活は楽しめていますか？",
            "Chinese": "学校生活过得还开心吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:38:59",
            "content": "はい、普通です。",
            "Chinese": "嗯，一般。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:40:31",
            "content": "授業の時間以外は特に問題なく、お過ごしという感じなのですね",
            "Chinese": "就是说除了上课时间以外，都过得没什么问题，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:40:54",
            "content": "そうですね",
            "Chinese": "嗯，算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:41:02",
            "content": "ただ、学校は授業の時間が大半ですものね。",
            "Chinese": "不过，在学校大部分时间都是在上课呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:41:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:41:46",
            "content": "全部嫌で仕方ないです",
            "Chinese": "全部都讨厌得不得了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:44:07",
            "content": "確かにそう思ってしまいますよね、、今のお悩みで学校に行くのをやめようかなと思われたことはありますか？",
            "Chinese": "的确会这么想呢……因为现在的烦恼，您有没有想过干脆不去上学了？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:44:47",
            "content": "それはないです",
            "Chinese": "那倒没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:46:38",
            "content": "なるほど。そこまでは思わないけども、嫌だと感じるし、どうしたらいいかなという感じでしょうか",
            "Chinese": "我明白了。就是说虽然没到那种地步，但还是觉得很讨厌，不知道该怎么办才好，是这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:47:42",
            "content": "行きたくないけど、行かないわけにはいかないし…",
            "Chinese": "虽然不想去，但又不能不去……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:49:28",
            "content": "なるほどですね、、",
            "Chinese": "原来如此……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:50:36",
            "content": "ただ、学校に行くなら少しでも嫌な気持ちが減ればいいですよね？",
            "Chinese": "不过，既然要去学校，如果能让讨厌的心情减少一点也好，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:50:49",
            "content": "そうですね",
            "Chinese": "嗯，是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:52:19",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:57:13",
            "content": "仮にテストで良い点数が取れればどう思いますか？",
            "Chinese": "假如考试能取得好成绩，您会怎么想？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 10:58:01",
            "content": "嬉しいです",
            "Chinese": "会很开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:59:12",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 10:59:23",
            "content": "少し学校に行くのが楽しくなりそうですかね？",
            "Chinese": "是不是去上学这件事也会变得稍微开心一点呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 11:00:23",
            "content": "はい、そうですね",
            "Chinese": "是的，会的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 11:00:50",
            "content": "すみません。途中ですが、時間がきてしまったので終わらせて頂いてもよろしいでしょうか？",
            "Chinese": "抱歉，虽然还在进行中，但时间到了，可以先到这里结束吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 11:01:50",
            "content": "（遅れてしまいましたし、こちらは続けていただいても大丈夫ですが、終了でよろしいですか？）",
            "Chinese": "（我迟到了，不过如果您想继续的话也可以，现在结束可以吗？）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 11:04:06",
            "content": "はい。貴重なお時間を頂きありがとうございました!",
            "Chinese": "好的。非常感谢您抽出宝贵的时间！"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 11:04:17",
            "content": "またよろしくお願い致します。",
            "Chinese": "期待下次再聊。"
        },
        {
            "role": "クライアント",
            "time": "2022/01/29(土) 11:04:35",
            "content": "こちらこそありがとうございました。",
            "Chinese": "我才要谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 11:05:00",
            "content": "おかげさまでとても良い練習になりました。",
            "Chinese": "托您的福，这是一次非常好的练习。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/01/29(土) 11:05:09",
            "content": "それでは失礼致します。",
            "Chinese": "那么我先告辞了。"
        }
    ],
