{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:28:50",
            "content": "こんばんは。今日はよろしくお願い致します。",
            "Chinese": "晚上好，今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:29:13",
            "content": "宜しくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:29:48",
            "content": "では、始めてもよろしいですか？",
            "Chinese": "那么，可以开始了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:30:03",
            "content": "はい大丈夫です",
            "Chinese": "好的，没问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:31:11",
            "content": "こんにちは、相談員です",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:31:17",
            "content": "最初に、年齢・性別・今日お話ししたいことを教えていただけますか？",
            "Chinese": "首先，能否请您告知一下您的年龄、性别，以及今天想谈的内容？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:31:58",
            "content": "こんにちは、まき、34才、女性です。",
            "Chinese": "您好，我叫Maki，34岁，女性。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:32:21",
            "content": "妊活しているのですが、上手くいかなくて",
            "Chinese": "我正在备孕，但是一直不太顺利。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:33:17",
            "content": "教えてくださってありがとうございます。そうなんですね...もう少し詳しく教えて頂けますか？",
            "Chinese": "谢谢您告诉我。是这样啊……能再详细和我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:33:25",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:34:06",
            "content": "不妊治療に通っているのですが、なかなか出来ないのと治療が結構辛くて",
            "Chinese": "我在进行不孕治疗，但一直没有成功，而且治疗也挺辛苦的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:34:38",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:34:48",
            "content": "それはつらいですよね。",
            "Chinese": "那一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:34:53",
            "content": "2年前には流産もあったので",
            "Chinese": "两年前还经历过流产。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:35:16",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:35:18",
            "content": "今年35才だし、だんだん体力も心配で",
            "Chinese": "今年我就35岁了，也渐渐开始担心自己的体力。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:35:28",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:35:58",
            "content": "そうだったんですね。不安な気持ちになりますよね。",
            "Chinese": "原来是这样啊。会感到不安也是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:35:59",
            "content": "このまま治療を続けても。。。と思うのと、子供をあきらめたくない思いがして",
            "Chinese": "我一方面觉得就算这样继续治疗下去也没有意义……另一方面又不想放弃要孩子。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:36:13",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:36:23",
            "content": "この頃は眠ってもすぐ目が覚めて",
            "Chinese": "最近睡觉总是很快就醒来。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:36:33",
            "content": "体温図らなきゃとか",
            "Chinese": "想着还得量体温之类的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:36:36",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:37:13",
            "content": "気づくとまだ2時台だったりして、ヤダ、もっと寝なきゃとか",
            "Chinese": "回过神来发现才两点多，就会想“糟了，还得多睡一会儿”。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:37:27",
            "content": "すごく迷います",
            "Chinese": "我非常迷茫。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:37:46",
            "content": "なるほど...",
            "Chinese": "原来如此……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:37:54",
            "content": "それは体力的にも",
            "Chinese": "那样的话无论是体力上，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:38:04",
            "content": "精神的にも疲れますね",
            "Chinese": "还是精神上都会很疲惫呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:38:17",
            "content": "はい7",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:38:28",
            "content": "今妊活を始められてから",
            "Chinese": "从您开始备孕到现在，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:38:40",
            "content": "どれくらいの期間ですか？",
            "Chinese": "大概有多长时间了？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:38:43",
            "content": "6年目です",
            "Chinese": "已经是第六年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:38:58",
            "content": "６年目なんですね。",
            "Chinese": "已经第六年了啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:39:12",
            "content": "不安になるのも無理はないですよね",
            "Chinese": "您会感到不安也是在所难免的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:39:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:39:53",
            "content": "つらい思いを誰かに聞いてもらうことは",
            "Chinese": "您有没有向别人倾诉过这些痛苦的感受呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:39:59",
            "content": "ありますか？",
            "Chinese": "（前の文と統合）"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:40:47",
            "content": "夫には話せていますが、夫は子供を欲しがっているのであまりきついことが言えないと言うか",
            "Chinese": "我能跟丈夫说，但因为他很想要孩子，所以不太好说一些太沉重的话，应该说，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:40:57",
            "content": "私もあきらめたわけではないので",
            "Chinese": "而且我自己也并没有放弃。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:41:08",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:41:12",
            "content": "ついついソフトなおなか痛かったとか",
            "Chinese": "所以不知不觉中只会说些比较轻描淡写的话，比如肚子有点痛，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:41:22",
            "content": "身体がだるくて",
            "Chinese": "身体很乏力啊，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:41:28",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:41:30",
            "content": "思うように動けないとか",
            "Chinese": "身体不听使唤之类的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:41:40",
            "content": "そんな話になってしまいます",
            "Chinese": "最后都变成说这些了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:41:59",
            "content": "なるほどですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:42:11",
            "content": "夫さんのことも考えると",
            "Chinese": "考虑到您丈夫的心情，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:42:21",
            "content": "正直なことを",
            "Chinese": "有些真实的想法，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:42:32",
            "content": "言えなかったりもするんですね。",
            "Chinese": "就说不出口了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:43:05",
            "content": "実際、体の感覚って男の人にはわからないし",
            "Chinese": "说实话，身体上的这些感觉，男性确实很难体会，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:43:14",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:43:36",
            "content": "40才過ぎてできた",
            "Chinese": "虽然也听说过有人过了40岁才怀上，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:43:50",
            "content": "とかも聞くんですけど",
            "Chinese": "这样的例子，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:43:53",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:44:23",
            "content": "そこまであと6年もこの辛い治療を続けるの？って思うと気持ちが折れて",
            "Chinese": "可是一想到还要再熬六年继续这种痛苦的治疗？心里就会崩溃，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:44:39",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:45:01",
            "content": "夫の妹には孫がいるので",
            "Chinese": "我丈夫的妹妹已经有孙子了，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:45:27",
            "content": "義母には「きっとできるわよ」って",
            "Chinese": "所以婆婆总是鼓励我说：“你一定可以的”，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:45:40",
            "content": "励まされてしまって",
            "Chinese": "总是这样鼓励我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:45:50",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:45:52",
            "content": "悪気が無いのはわかるんですけど",
            "Chinese": "我知道她没有恶意，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:45:59",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:46:23",
            "content": "必ずできるって保証はないし",
            "Chinese": "但谁也无法保证一定能成功，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:46:44",
            "content": "絶対できないって、私が決めたら進まないし",
            "Chinese": "而如果我自己下结论说绝对不可能，也就走不下去了，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:47:02",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:47:19",
            "content": "誰も悪くないけど、辛いのは私だけだから",
            "Chinese": "虽然谁都没有错，但痛苦的只有我一个人。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:47:27",
            "content": "どうしたらいいか分からなくなります",
            "Chinese": "所以我不知道该怎么办了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:47:52",
            "content": "なるほどですね...",
            "Chinese": "原来是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:48:05",
            "content": "悪気はなくても",
            "Chinese": "即使对方没有恶意，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:48:23",
            "content": "まきさんには",
            "Chinese": "对Maki您来说，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:48:49",
            "content": "つらい気持ちになりますよね",
            "Chinese": "也会感到很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:49:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:49:35",
            "content": "そう感じるのは、自然なことだと思います",
            "Chinese": "我觉得有这种感觉是很自然的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:49:51",
            "content": "まきさんは、",
            "Chinese": "Maki女士，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:50:18",
            "content": "今、状況を聴かせて頂きましたが、",
            "Chinese": "刚才听您介绍了情况，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:50:56",
            "content": "今日はどのような思いで",
            "Chinese": "今天您是带着怎样的心情"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:51:06",
            "content": "ご相談に来られましたか？",
            "Chinese": "来咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:51:33",
            "content": "迷っている事の出口が見えるかもと",
            "Chinese": "我想或许能为我正在迷茫的事情找到一个出口。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:51:51",
            "content": "なるほど、なるほど。",
            "Chinese": "原来如此，原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:52:03",
            "content": "先ほどお話し頂いたことと",
            "Chinese": "可能和您刚才说的内容有些重复，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:52:16",
            "content": "重なるかもしれませんが、",
            "Chinese": "（前の文と統合）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:52:30",
            "content": "まきさんが迷っていると感じるのは",
            "Chinese": "您感觉迷茫的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:52:39",
            "content": "どのようなところでしょうか？",
            "Chinese": "具体是哪方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:54:22",
            "content": "いたくて辛い治療ですが、痛いからと言ってやめてしまったらそれは子供を諦めることになるってわかっているけど、痛い日やだるい日にはこんな治療したって意味がないと言う気持ちになって辞めたくなります。",
            "Chinese": "虽然治疗很痛很辛苦，我也知道如果因为痛就放弃，那就等于放弃要孩子了，但在疼痛和疲惫的日子里，我就会觉得这种治疗毫无意义，想要放弃。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:55:07",
            "content": "夫の気持ちを考えたらやめたらいけない、もう少し頑張ろうと思います",
            "Chinese": "可是一想到我丈夫的心情，就觉得不能放弃，要再坚持一下。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:55:34",
            "content": "お金もかかるし",
            "Chinese": "而且也很花钱。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:55:52",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:55:56",
            "content": "嫌な日にはなんでこんなことしてるんだろうって",
            "Chinese": "在难受的日子里，我就会想“我到底为什么要做这种事”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:56:10",
            "content": "うん...",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:56:11",
            "content": "涙が止まらない時もあります",
            "Chinese": "有时候眼泪会止不住地流。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:56:21",
            "content": "そうなんですね…",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:56:29",
            "content": "でも妊娠できるのは私だけだし",
            "Chinese": "但毕竟只有我能怀孕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:56:43",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:57:15",
            "content": "なるほどですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:57:18",
            "content": "やめたらそれは二人の人生が変わることだし",
            "Chinese": "如果放弃了，我们两个的人生都会改变。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:57:28",
            "content": "うんうん。",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:58:31",
            "content": "なるほど...いろいろ考えますよね。まきさんは夫さんの気持ちを考えて、",
            "Chinese": "原来如此……是会想很多呢。Maki女士，您考虑到丈夫的心情，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:58:52",
            "content": "妊活を続けようと思っていらっしゃる",
            "Chinese": "所以想继续备孕，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:59:00",
            "content": "とのことでしたが、",
            "Chinese": "是这样对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:59:10",
            "content": "夫もですが、私も子供は欲しいです",
            "Chinese": "不仅是丈夫，我也想要孩子。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:59:25",
            "content": "まきさんもなんですね。",
            "Chinese": "Maki您也是这样想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:59:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:59:39",
            "content": "まきさんの中では",
            "Chinese": "在您心里，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 18:59:52",
            "content": "今のつらい気持ちを",
            "Chinese": "现在这份痛苦的心情……"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 18:59:52",
            "content": "でも日によってやめたい気持ちが大きくなって",
            "Chinese": "但有些天，想放弃的心情会变得特别强烈，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:00:00",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:00:11",
            "content": "その気持ちにどこで区切りを皆さんつけているのか",
            "Chinese": "大家都是在哪个节点给这种心情划上句号的呢，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:00:24",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:00:27",
            "content": "やめる決断をするのが怖いし",
            "Chinese": "我害怕做出放弃的决定，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:00:44",
            "content": "そうですよね...",
            "Chinese": "是啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:00:44",
            "content": "私の一存で良いのか",
            "Chinese": "是不是可以由我一个人来做主呢，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:00:54",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:01:02",
            "content": "辛いと言えば夫は反対しないですから",
            "Chinese": "因为只要我说很辛苦，我丈夫是不会反对的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:01:59",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:02:05",
            "content": "まきさんが",
            "Chinese": "我感觉好像Maki您，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:02:18",
            "content": "１人で気持ちを抱え込んでおられるように",
            "Chinese": "一个人把所有情绪都扛着，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:02:35",
            "content": "感じておられるように感じますが、",
            "Chinese": "（前の文と統合）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:02:45",
            "content": "どのような感じですか？",
            "Chinese": "您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:03:42",
            "content": "そうですね、一応夫と話せてはいます",
            "Chinese": "是的，基本上还是能和丈夫谈一谈的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:04:25",
            "content": "そうなんですね。まきさんの中では",
            "Chinese": "是这样啊。在Maki您心里，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:04:47",
            "content": "今のこの妊活に対する不安な気持ちを",
            "Chinese": "如果现在对备孕的这份不安情绪，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:05:10",
            "content": "少しでも落ち着かせることができたら",
            "Chinese": "能够稍微平复一些的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:05:39",
            "content": "楽になれる感じですか？",
            "Chinese": "会不会觉得轻松一些呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:06:18",
            "content": "そうですね、続ける意欲が欲しいと言うか",
            "Chinese": "是的，或者说，我想要继续下去的动力。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:06:26",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:07:07",
            "content": "そんな感じです",
            "Chinese": "大概就是这种感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:07:21",
            "content": "なるほどですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:07:38",
            "content": "まきさんも夫さんも",
            "Chinese": "Maki女士和您的丈夫"
