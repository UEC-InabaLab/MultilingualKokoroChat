        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:07:58",
            "content": "望んでおられることは",
            "Chinese": "都希望"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:08:34",
            "content": "諦めずに続けるたいお気持ちなのですね。",
            "Chinese": "不放弃、继续下去，是这样的心情呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:09:09",
            "content": "今、続けるか迷うのは、",
            "Chinese": "现在，让您犹豫是否要继续下去的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:10:28",
            "content": "どのような気持ちが一番影響していますか？",
            "Chinese": "主要是哪种心情影响最大呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:14:36",
            "content": "いかがですか？",
            "Chinese": "您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:18:35",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/09(火) 19:19:52",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/09(火) 19:20:31",
            "content": "どこで区切りを付けたら良いのかが",
