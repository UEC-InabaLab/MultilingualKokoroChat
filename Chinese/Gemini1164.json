{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 20:51:09",
            "content": "こんばんは。本日は宜しくお願い致します。",
            "Chinese": "晚上好，今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 20:55:18",
            "content": "こんばんは。よろしくお願い致します。",
            "Chinese": "晚上好，请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 20:58:19",
            "content": "始めさせていただいてもよろしいでしょうか？",
            "Chinese": "请问可以开始了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 20:58:31",
            "content": "大丈夫です。",
            "Chinese": "可以的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 20:58:45",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 20:58:52",
            "content": "お願いします。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 20:59:47",
            "content": "本日はご相談いただきましてありがとうございます。どのようなご相談でしょうか・",
            "Chinese": "非常感谢您今天前来咨询。请问您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:00:11",
            "content": "仕事を辞めようか迷っています",
            "Chinese": "我正在犹豫要不要辞职。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:00:47",
            "content": "そうなんですね。詳しく聴かせていただけますか？",
            "Chinese": "是这样啊。可以请您详细说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:01:06",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:01:34",
            "content": "何から話せばいいですか？",
            "Chinese": "我该从哪里说起呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:02:28",
            "content": "いつからそのように思われているのですか？",
            "Chinese": "您从什么时候开始有这样的想法呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:02:49",
            "content": "1年前からです。",
            "Chinese": "从一年前开始的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:03:31",
            "content": "ありがとうございます。そのころから何かそう思うことがあったのでしょうか？",
            "Chinese": "谢谢您。从那时起，有什么事情让您产生了这样的想法吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:04:28",
            "content": "はい。入社してすぐに、思っていた仕事のイメージと違っていました。",
            "Chinese": "是的。刚入职没多久，我就发现工作和我自己想象中的不一样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:05:49",
            "content": "そうなんですね。どのようなところが違うと感じられるのでしょうか？",
            "Chinese": "是这样啊。您觉得有哪些方面不一样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:06:35",
            "content": "労働時間がとにかく長くて、しんどいです。",
            "Chinese": "工作时间实在太长了，很辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:07:03",
            "content": "それは辛いですね。",
            "Chinese": "那确实很辛苦呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:07:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:07:47",
            "content": "体もしんどいし、意欲も出なくなりますね。",
            "Chinese": "身体会很疲惫，干劲也提不起来了吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:07:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:08:24",
            "content": "最近も状況は変わらないのでしょうか？",
            "Chinese": "最近情况还是没有改变吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:08:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:08:38",
            "content": "変わらないです",
            "Chinese": "一直没变。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:08:56",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:09:02",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:09:42",
            "content": "お仕事で楽しいところややりがいを感じるところはありますか？",
            "Chinese": "工作中有没有让您觉得开心或者有成就感的地方呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:09:58",
            "content": "んー",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:10:14",
            "content": "今は思い浮かばないです",
            "Chinese": "现在想不出来。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:11:09",
            "content": "ありがとうございます。お仕事の内容をお聞かせいただけますか？",
            "Chinese": "谢谢您。能请您说说您的工作内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:11:17",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:11:28",
            "content": "営業の仕事をしてます",
            "Chinese": "我做的是销售工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:12:24",
            "content": "そうなんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:12:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:13:17",
            "content": "お仕事はお好きですか？",
            "Chinese": "您喜欢这份工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:13:31",
            "content": "好きじゃないです",
            "Chinese": "不喜欢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:14:14",
            "content": "お好きではないのですね。何年ぐらいお勤めでしょうか？",
            "Chinese": "您不喜欢这份工作啊。您工作多久了呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:14:28",
            "content": "1年です",
            "Chinese": "1年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:15:40",
            "content": "そうなんですね。入られた時から思っておられた内容のお仕事ではなかったということでしょうか？",
            "Chinese": "原来如此。您是说从入职开始，工作内容就和您预期的不一样吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:15:50",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:15:56",
            "content": "内容というより",
            "Chinese": "与其说是内容，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:16:02",
            "content": "時間の長さです",
            "Chinese": "不如说是工作时长。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:16:53",
            "content": "そうなんですね、労働時間が長いのですね。",
            "Chinese": "是这样啊，是工作时间太长了。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:17:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:17:35",
            "content": "お仕事の内容についてはどのように思われているのですか？",
            "Chinese": "那关于工作内容本身，您是怎么看的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:18:09",
            "content": "仕事の内容は特に",
            "Chinese": "工作内容的话，倒也没什么特别的……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:18:18",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:18:18",
            "content": "思ってません",
            "Chinese": "没什么特别的想法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:19:35",
            "content": "同じ職場では労働時間の話をできる方はいらっしゃいますか？",
            "Chinese": "在公司里，有可以聊一聊工作时长这个话题的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:19:47",
            "content": "できます",
            "Chinese": "有。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:19:49",
            "content": "ただ",
            "Chinese": "不过——"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:19:54",
            "content": "みんな長いです",
            "Chinese": "大家的工作时间都很长。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:22:06",
            "content": "そうなんですね、他の皆さんは労働時間についてどのように思われているのでしょうか？",
            "Chinese": "是这样啊，那其他同事对工作时长是怎么看的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:22:18",
            "content": "みんな文句言ってます",
            "Chinese": "大家都在抱怨。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:23:04",
            "content": "しんどくてやる気が出なくなりますよね。",
            "Chinese": "又累又提不起干劲，是吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:23:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:24:52",
            "content": "一緒に働く皆さんとは雰囲気が良く、仲良くされているのでしょうか？",
            "Chinese": "您和一起工作的同事们氛围好吗？关系融洽吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:25:12",
            "content": "どうですかね",
            "Chinese": "这个嘛……"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:25:24",
            "content": "事務所で少し会うぐらいなので",
            "Chinese": "因为只是在办公室里偶尔见一下，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:25:37",
            "content": "愚痴を言い合ったりはしますが",
            "Chinese": "虽然会互相吐吐槽，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:25:47",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:26:01",
            "content": "仲良くとかそんなんじゃないです",
            "Chinese": "但谈不上关系融洽什么的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:26:21",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:26:27",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:27:04",
            "content": "お仕事を辞めない選択をされるとしたら",
            "Chinese": "如果您选择不辞职的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:27:32",
            "content": "職場がどのようになれば良いと考えられますか？",
            "Chinese": "您觉得工作环境变成什么样会比较好呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:27:54",
            "content": "労働時間が適正になればいいです",
            "Chinese": "只要工作时间能变得合理就好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:28:20",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:28:25",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:29:26",
            "content": "労働時間を除けばあなたが思う職場に近い感じですか？",
            "Chinese": "撇开工作时长不谈，其他方面接近您理想中的职场吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:30:30",
            "content": "んーそうですかね",
            "Chinese": "嗯……算是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:31:03",
            "content": "少しまとめさせていただきます。",
            "Chinese": "那我来稍微总结一下。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:31:09",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:32:30",
            "content": "あなたは一年前に入社され、入社された時から、労働時間が長いことがご自分の思いと違っていると感じておられます。",
            "Chinese": "您一年前入职，从那时起就觉得工作时间太长，和您自己的预期不符。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:32:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:33:25",
            "content": "でもお仕事の内容ではそれほど不満は思っておられないように見えます。",
            "Chinese": "但是对于工作内容本身，您似乎并没有太多的不满。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:33:41",
            "content": "そうなんですかね",
            "Chinese": "是这样吗。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:34:02",
            "content": "そうなのかもしれないですね",
            "Chinese": "可能确实是这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:35:25",
            "content": "周りの方々ともそんなに親しくはないけど、会って愚痴を言うこともある感じですね。",
            "Chinese": "和身边的同事并不算特别亲近，但见面时也会互相吐吐槽，是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:35:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:37:35",
            "content": "労働時間が長いため体や精神的な辛さが何とかなればと悩まれている。",
            "Chinese": "您正因为工作时间长而导致身心俱疲，并烦恼着希望能有所改变。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:37:59",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:40:47",
            "content": "あなたは長い間体も精神的にも悩まれていますね。",
            "Chinese": "您在身体和精神上已经困扰了很长时间了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:41:07",
            "content": "そうかもしれないですね",
            "Chinese": "可能是这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:42:13",
            "content": "ずいぶんお辛い日を過ごされています。どなたかに",
            "Chinese": "您一直在度过非常难熬的日子。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:43:01",
            "content": "そのお気持ちをお話ししたり、できるお相手は身近にありますか？",
            "Chinese": "您身边有可以倾诉这些感受的对象吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:43:44",
            "content": "親には話をしています",
            "Chinese": "我有和父母倾诉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:44:40",
            "content": "そうなんですね。少しでもお話しできる方がおられて安心しました。",
            "Chinese": "是这样啊。能有倾诉的对象，我就放心了。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:44:50",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:45:33",
            "content": "何よりあなたのことが心配です。",
            "Chinese": "我最担心的还是您。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:45:43",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:45:49",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/12(火) 21:46:45",
            "content": "我慢強く、お仕事を続けていらっしゃいますので。",
            "Chinese": "因为您一直很有耐心地坚持工作着。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/12(火) 21:46:57",
            "content": "はい",
