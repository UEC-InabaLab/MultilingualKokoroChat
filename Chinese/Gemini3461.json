{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 19:53:50",
            "content": "こんばんは。本日はどうぞよろしくお願いいたします。",
            "Chinese": "晚上好。今天請多多關照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 19:54:22",
            "content": "時間になりましたら開始いたします。",
            "Chinese": "时间到了我们就会开始。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 19:55:16",
            "content": "こんばんは、宜しくお願いします。わかりました。",
            "Chinese": "晚上好，请多关照。明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:00:18",
            "content": "こんばんは。相談員です。本日はよろしくお願いいたします。はじめにご年齢と性別を教えていただけますか？",
            "Chinese": "晚上好。我是咨询员。今天请多-多关照。首先，请问可以告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:00:38",
            "content": "25歳女性です。宜しくお願いします。",
            "Chinese": "25岁，女性。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:00:55",
            "content": "ありがとうございます。本日はどのようなご相談ですか？",
            "Chinese": "谢谢您。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:01:18",
            "content": "本日は、パートナーとの悩みに関して相談したいです。",
            "Chinese": "今天，我想咨询一下和伴侣之间的烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:01:47",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:02:23",
            "content": "はい、",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:02:23",
            "content": "どんなお話でもお聴きしますので、どんなお悩みか教えていただけますか？",
            "Chinese": "无论什么样的话我都会倾听，可以告诉我您有什么烦恼吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:02:43",
            "content": "はい、今一緒に大阪で同棲しているのですが",
            "Chinese": "是的，我们现在一起在大阪同居，不过——"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:02:50",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:03:00",
            "content": "私は将来的に、東京に戻りたいなと思ってます",
            "Chinese": "我未来希望能回到东京。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:03:09",
            "content": "でも彼は大阪出身の人でして",
            "Chinese": "但他是大阪出身的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:03:13",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:03:26",
            "content": "それを彼に打ち明けた時",
            "Chinese": "当我向他坦白这件事的时候，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:03:32",
            "content": "ちょっと喧嘩っぽくなってしまって",
            "Chinese": "结果有点像吵架了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:03:36",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:03:38",
            "content": "どうしたらいいかな、と悩んでました",
            "Chinese": "我就在烦恼该怎么办才好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:03:51",
            "content": "そうだったのですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:04:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:04:46",
            "content": "そのお話しをした時、",
            "Chinese": "在您说起那件事的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:05:07",
            "content": "打ち明けたとき、彼はどんなことおっしゃってましたか？",
            "Chinese": "在您坦白的时候，他说了些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:05:28",
            "content": "私の打ち明け方が良くなかったんですけど",
            "Chinese": "可能是我坦白的方式不太好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:05:39",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:06:48",
            "content": "彼の今の生き方を山に喩えて、１つの山をずっと登り続けるよりも別の山を登るのもいいと思うって言ったんですよね",
            "Chinese": "我把他现在的生活方式比作登山，说比起一直爬一座山，爬爬别的山也挺好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:07:02",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:07:06",
            "content": "そしたらいろんなものが見えてくると思うけどどうかな？っていう感じです",
            "Chinese": "大概就是“这样就能看到各种各样的风景了，你觉得怎么样？”这种感觉。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:07:11",
            "content": "そしたら",
            "Chinese": "然后他就——"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:07:17",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:07:55",
            "content": "自分が東京に行きたいから、俺にもメリットがあるように伝えてる気がするし、なんか営業みたい",
            "Chinese": "他说“感觉你是因为自己想去东京，所以才说得好像对我也有好处似的，有点像在推销”。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:08:02",
            "content": "っていうかんじだったんですよね",
            "Chinese": "就是这种感觉。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:08:21",
            "content": "クロージングしてくる営業マン見たいって",
            "Chinese": "说我像个急于成交的销售员。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:08:29",
            "content": "ええ、なるほどですね",
            "Chinese": "嗯，原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:08:45",
            "content": "私そんなつもりなかったんですけど",
            "Chinese": "我并没有那个意思，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:08:50",
            "content": "結構傷ついてしまって",
            "Chinese": "但还是挺受伤的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:08:54",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:09:23",
            "content": "それで、もうこの話は一旦やめようってなりました",
            "Chinese": "所以，我们就决定暂时不谈这个话题了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:10:03",
            "content": "そうだったんですね。。。。せっかく将来のことを打ち明けたのに、そんな言い方されたら",
            "Chinese": "原来是这样啊……好不容易坦白了对未来的想法，却被那样说……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:10:14",
            "content": "傷つきますよね。。。",
            "Chinese": "是会很受伤的吧……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:10:32",
            "content": "はい、しかも悪気があったわけではなく",
            "Chinese": "是的，而且我并没有恶意，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:10:49",
            "content": "本当に彼にとって私はプラスになるんじゃないかなっていう純粋な気持ちがあったので",
            "Chinese": "我是出于一种纯粹的心情，觉得这对他来说或许是件好事。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:10:59",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:11:01",
            "content": "私は",
            "Chinese": "我"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:11:12",
            "content": "上京してきて大学から一昨年まで東京に住んでて",
            "Chinese": "我从上大学到前年都住在东京，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:11:20",
            "content": "いろんな人たちと出会って、いろんなことに参加してきて",
            "Chinese": "遇到了很多人，也参加了很多活动，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:11:33",
            "content": "視野も広がって一緒に頑張れる仲間も見つけて",
            "Chinese": "视野也开阔了，也找到了可以一起奋斗的伙伴。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:11:33",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:11:49",
            "content": "でも東京の前の会社にいた時大阪支社の彼と出会って",
            "Chinese": "但是在东京上一家公司工作时，我遇到了在大阪分公司的他，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:12:02",
            "content": "彼の付き合うために、前の会社やめて大阪に来たんですけど",
            "Chinese": "为了和他交往，我辞掉了上一份工作来到了大阪。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:12:04",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:12:08",
            "content": "彼はずーっと大阪の人で",
            "Chinese": "他一直都待在大阪。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:12:36",
            "content": "仕事はできて目標達成とする人なんですけど",
            "Chinese": "他工作能力很强，是个能达成目标的人，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:12:43",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:12:44",
            "content": "ベースが安定思考で",
            "Chinese": "但他基本上是求稳的性格。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:12:52",
            "content": "収入落としたくない、とかですね",
            "Chinese": "比如不想降低收入之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:13:08",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:13:19",
            "content": "今の仕事も、結果はすごく出してるんですけど",
            "Chinese": "现在的工作也做出了很好的成绩，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:13:27",
            "content": "人生かけてやりたいことを見つけてはいないので",
            "Chinese": "但他还没有找到愿意为之奋斗一生的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:13:41",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:13:43",
            "content": "ビジョンはあるけど、今身での道のりを辿ってきて見つけたビジョンみたいな",
            "Chinese": "他有愿景，但那更像是在他现有的人生轨迹上找到的愿景。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:13:48",
            "content": "そんな感じのを持ってて",
            "Chinese": "他就是抱着这样的想法。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:13:58",
            "content": "はい、",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:13:59",
            "content": "私から見ると、もう少し外の世界と触れてもいいんじゃないかなって",
            "Chinese": "在我看来，他再多接触一下外面的世界或许会更好。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:14:10",
            "content": "彼は今の会社の、大阪支社を成功させたいんです",
            "Chinese": "他想让他现在公司的大阪分公司取得成功。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:14:27",
            "content": "なので、大阪にこだわってるのもあります",
            "Chinese": "所以他也很执着于留在大阪。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:14:27",
            "content": "ええ、そうなのですね。",
            "Chinese": "嗯，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:14:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:14:57",
            "content": "それは前提肯定してるんですけどね",
            "Chinese": "不过，我是肯定他的这个想法的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:15:07",
            "content": "あなたは本当に彼にとって純粋な気持ちがあって",
            "Chinese": "您对他确实怀着很纯粹的心意，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:15:20",
            "content": "東京での暮らしを提案されたんですね",
            "Chinese": "才向他提议去东京生活的，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:15:47",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:16:30",
            "content": "ただ彼は今の会社の、大阪支社を成功させたいという思いもあるということなんですね。",
            "Chinese": "不过他也有想让现在公司的大阪分公司成功的想法，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:16:37",
            "content": "そうなんです",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:16:45",
            "content": "それは肯定してるんですけどね",
            "Chinese": "我是肯定他这个想法的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:16:47",
            "content": "言葉でも",
            "Chinese": "也用语言表达过。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:16:53",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:17:59",
            "content": "でも私の言い方も良くなかったかなとは思ってます",
            "Chinese": "但我也觉得我自己的说法可能不太好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:18:11",
            "content": "そう思っていらっしゃるんですね",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:18:25",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:19:38",
            "content": "その話しをした時、",
            "Chinese": "在谈论那件事的时候，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:20:20",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:20:29",
            "content": "彼は全然彼は東京での暮らしを考えてくれなかった感じですか？",
            "Chinese": "他是完全没有考虑过去东京生活的感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:20:38",
            "content": "いえ",
            "Chinese": "不是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:21:14",
            "content": "考えてくれてはいました俺もいいなとは思ってるけど今すぐってのはわからないし、東京に行くなら、何か大きな意味づけや目的がないとって思ってるっていうのを",
            "Chinese": "他是有考虑的。他说他也觉得不错，但不确定是不是马上就去；而且如果要去东京的话，他觉得需要一个重大的意义或目的才行。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:21:18",
            "content": "最後に言ってくれてました",
            "Chinese": "他最后是这样对我说的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:21:38",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:21:53",
            "content": "あと、腰が重いのはあるって",
            "Chinese": "还有，他也说自己确实有点行动慢、迈不开步子，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:22:06",
            "content": "俺ももう28だよ？ってちょっと笑いながら",
            "Chinese": "他有点笑着说“我也已经28岁了哦？”"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:22:10",
            "content": "言ってました",
            "Chinese": "他是这么说的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:22:18",
            "content": "なるほどですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:23:04",
            "content": "ちなみに東京にいつ頃というお話をされたんですか？",
            "Chinese": "顺便问一下，你们有谈到大概什么时候去东京吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:23:21",
            "content": "明確にはいつって言ってないですね",
            "Chinese": "没有明确说具体时间。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:23:36",
            "content": "ただ、",
            "Chinese": "不过，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:23:39",
            "content": "そうだったんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:23:41",
            "content": "今の仕事辞めたらって",
            "Chinese": "我说等我把现在的工作辞了的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:23:44",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:23:46",
            "content": "いきたいなあとは",
            "Chinese": "我想去。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:23:48",
            "content": "いいました",
            "Chinese": "我是这么说的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:23:51",
            "content": "ちなみに今の仕事は",
            "Chinese": "顺便说一下，我现在的工作"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:23:58",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:24:00",
            "content": "今年いっぱいかなと思ってるので",
            "Chinese": "我想大概会做到今年年底，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:24:09",
            "content": "私が来年くらいを考えてることは",
            "Chinese": "所以我考虑明年左右去这件事，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:24:13",
            "content": "向こうもわかってると思います",
            "Chinese": "我想他应该也知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:24:26",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:24:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:25:25",
            "content": "今年いっぱいかなというのは、",
            "Chinese": "您说大概做到今年年底，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:25:32",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:25:50",
            "content": "彼ではなくて、あなたがということでよろしいですか？",
            "Chinese": "指的是您而不是他，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:25:59",
            "content": "あ、そうです！",
            "Chinese": "啊，是的！"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:26:10",
            "content": "はい。ありがとうございます。",
            "Chinese": "好的。谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:26:51",
            "content": "その時は、喧嘩っぽくなったので話しを止めたということですが、",
            "Chinese": "您说当时因为有点像吵架了，所以就停止了谈话，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:27:03",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:27:05",
            "content": "やめましたね",
            "Chinese": "是的，不谈了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:27:14",
            "content": "私がいじけたって感じです",
            "Chinese": "感觉像是我在闹别扭。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:27:23",
            "content": "向こうも謝ってきてくれましたけどね",
            "Chinese": "不过他也向我道歉了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:27:34",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:27:50",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:28:02",
            "content": "あなたはまた彼にもう一度彼にその話しをする予定ですか？",
            "Chinese": "您打算再和他谈一次这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:28:11",
            "content": "しようとは思ってます",
            "Chinese": "我是打算谈的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:28:17",
            "content": "あのときはごめんねっていう",
            "Chinese": "想先说“那时候对不起”，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:28:22",
            "content": "感じと",
            "Chinese": "以及"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:28:23",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:28:36",
            "content": "あくまでも、誘導したかったっていうよりも",
            "Chinese": "与其说是想引导他，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:28:44",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:28:56",
            "content": "新しい道も一緒に見るのはどうかなっていう意見であって",
            "Chinese": "不如说是想一起看看新的道路。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:28:58",
            "content": "あと、私は",
            "Chinese": "还有，我"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:29:09",
            "content": "我慢して彼といたくないんです",
            "Chinese": "我不想委屈自己和他在一起。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:29:19",
            "content": "本当はしたいことがあるのに、行きたいところがあるのに",
            "Chinese": "明明有想做的事，有想去的地方，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:29:20",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:29:25",
            "content": "ソレを我慢してたら",
            "Chinese": "如果总是压抑这些，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:29:29",
            "content": "2人の関係にとって",
            "Chinese": "对我们两个人的关系"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:29:33",
            "content": "よくないと思うんです",
            "Chinese": "我觉得是不好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:29:41",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:29:45",
            "content": "だからこそ、自分の気持ちを伝えたかったっていうのも",
            "Chinese": "正因如此，我才想传达自己的心情，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:29:49",
            "content": "言おうかなと思ってます",
            "Chinese": "我想把这些也告诉他。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:30:02",
            "content": "でも、不安なんです",
            "Chinese": "但是，我很不安。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:30:07",
            "content": "なんか",
            "Chinese": "总觉得，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:30:18",
            "content": "向こうは本当に行きたい気持ちがなくて",
            "Chinese": "他可能真的不想去，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:30:18",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:30:21",
            "content": "でも私は行きたくて",
            "Chinese": "但我却很想去，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:30:31",
            "content": "別れる選択肢が出てくるのかも知れないとか、",
            "Chinese": "可能会出现分手的选项。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:30:32",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:30:34",
            "content": "仮に来てくれても、",
            "Chinese": "就算他真的跟我来了，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:30:45",
            "content": "やっぱ大阪がいいってなって",
            "Chinese": "结果还是觉得大阪好，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:30:54",
            "content": "結局ばらばらになるんじゃないかとか",
            "Chinese": "最后还是会各奔东西之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:30:54",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:31:39",
            "content": "一緒にこれからもいたい相手なので",
            "Chinese": "因为他是我想要今后也一直在一起的人，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:31:46",
            "content": "そんな気持ちはありますね",
            "Chinese": "所以会有那样的担心。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:31:50",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:31:59",
            "content": "教えていただきありがとうございます。",
            "Chinese": "谢谢您告诉我这些。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:32:11",
            "content": "とんでもないです",
            "Chinese": "哪儿的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:32:11",
            "content": "したいことや行きたいところがあるのにそれを我慢してたらしんどいですよね。",
            "Chinese": "明明有想做的事和想去的地方，却要忍耐着，这一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:32:25",
            "content": "はい、絶対あとで苦しくなると思います",
            "Chinese": "是的，我觉得以后一定会很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:32:51",
            "content": "そうお感じなんですね。",
            "Chinese": "您是这么感觉的啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:33:00",
            "content": "そうですけ",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:33:01",
            "content": "ね",
            "Chinese": "是呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:33:19",
            "content": "あともし彼が大阪を選ぶなら、",
            "Chinese": "另外，如果他选择大阪的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:33:49",
            "content": "彼は仕事が一番なのかな、とも感じてしまいますね。",
            "Chinese": "也会让人觉得他是不是把工作放在第一位。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:33:59",
            "content": "そうですね、",
            "Chinese": "是的，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:34:01",
            "content": "私は",
            "Chinese": "我"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:34:10",
            "content": "彼のために大阪にきましたが",
            "Chinese": "是为了他才来到大阪的，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:34:10",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:34:11",
            "content": "彼は",
            "Chinese": "但他"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:34:14",
            "content": "私のために",
            "Chinese": "为了我，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:34:17",
            "content": "場所は変えられないのか",
            "Chinese": "就不能换个地方吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:34:20",
            "content": "とも思います",
            "Chinese": "我也会这么想。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:34:24",
            "content": "うんうん、",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:34:31",
            "content": "でも私は上京したり、場所を変えるのは慣れっこだから",
            "Chinese": "但我对上京、换地方这些已经习惯了，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:34:41",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:34:45",
            "content": "地元から出れないのは、仕方ないのかなとも思いますね",
            "Chinese": "我也觉得他离不开家乡，可能也是没办法的事。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:35:04",
            "content": "ハードルがちがうかなって",
            "Chinese": "感觉我们面对的门槛不一样。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:35:38",
            "content": "私は住む場所が変わってもいいですけど、彼にとっては、これと言った大きな理由がないのに動くのは、確かに腰が重いかもしれないです",
            "Chinese": "对我来说换个住的地方没问题，但对他来说，如果没有一个特别重大的理由就要行动，确实可能会很不情愿吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:35:58",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:36:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:36:46",
            "content": "地元の良さもあるし、でも環境を変えると新しい出会いや価値観が広がったり、そういう良さもありますよね。",
            "Chinese": "家乡有家乡的好，但改变环境也会有新的相遇、拓宽价值观，也有这样的好处呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:36:52",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:38:06",
            "content": "であなたは彼のために大阪に来たんですよね。",
            "Chinese": "而且，您是为了他才来到大阪的，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:38:11",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:39:02",
            "content": "その気持ちを汲み取ってくれてたら、",
            "Chinese": "如果他能体谅您的这份心情，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:39:20",
            "content": "言い方がよくなかったとしても、",
            "Chinese": "即使您说话的方式不太好，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:39:42",
            "content": "営業みたい、なんて言ってほしくはなかったですよね。",
            "Chinese": "也不希望他会说出“像在推销”这种话吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:39:48",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:40:13",
            "content": "でも、まあ",
            "Chinese": "不过，嘛，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:40:16",
            "content": "彼のためと言いつつ",
            "Chinese": "虽然说是为了他，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:40:19",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:40:42",
            "content": "自分が彼の方へ行きたかった、エゴ？でもあるので、そこは、強要すべきではないのかな、とも思います",
            "Chinese": "其实也是因为自己想去他那里，算是一种自我满足吧？所以我觉得在这一点上不应该强求他。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:41:20",
            "content": "なるほどですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:41:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:42:01",
            "content": "今日のご相談ではどんなことが一番相談したい点ですか？",
            "Chinese": "在今天的咨询中，您最想咨询的是哪一点呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:42:15",
            "content": "そーですね、",
            "Chinese": "这个嘛……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:42:28",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:42:56",
            "content": "分かり合えるにはどうしたらいいか、ですかね",
            "Chinese": "应该是“要怎样才能互相理解”吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:43:11",
            "content": "行ける行けないよりも",
            "Chinese": "比起去还是不去，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:43:14",
            "content": "お互いの気持ちを",
            "Chinese": "更重要的是互相理解彼此的心情。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:43:18",
            "content": "しっかり理解し合う",
            "Chinese": "能够好好地互相理解。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:43:20",
            "content": "ええ、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:43:24",
            "content": "ことの方が大切ですね",
            "Chinese": "这件事更重要。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:44:04",
            "content": "分かり合えるのがお互いにとって一番だということですね。",
            "Chinese": "也就是说，能够互相理解对彼此来说是最好的，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:44:21",
            "content": "そうですね、私にとってはそれがいいと思ってます",
            "Chinese": "是的，对我来说那是最好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:44:59",
            "content": "うんうん、分かり合えるってとても大事なことですよね",
            "Chinese": "嗯嗯，能够互相理解是非常重要的事情呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:45:08",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:45:39",
            "content": "ちなみにこれまでお互いの気持ちが分かり合えたなって時は、",
            "Chinese": "顺便问一下，至今为止，在什么时候您会觉得“我们互相理解了”呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:45:47",
            "content": "どんな時でしたか？",
            "Chinese": "是在什么时候呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:45:56",
            "content": "そーですねー。。",
            "Chinese": "这个嘛……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:46:05",
            "content": "聴くに徹した時ですかね",
            "Chinese": "应该是在专心倾听的时候吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:46:17",
            "content": "客観的に、聞けた時だと思います",
            "Chinese": "我觉得是能够客观地倾听的时候。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:46:30",
            "content": "自分のこうしたい！は、一回置いといて",
            "Chinese": "先把自己的“我想这么做！”的想法放到一边的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:46:31",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:46:35",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:46:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:47:19",
            "content": "なるほどですね",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:47:57",
            "content": "ご自身では、今回のことで、どうしたら分かり合えるかなとお感じですか？",
            "Chinese": "您自己觉得，关于这次的事情，要怎样做才能互相理解呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:48:10",
            "content": "そーですねー。。",
            "Chinese": "这个嘛……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:48:17",
            "content": "まず今ここで話したことを",
            "Chinese": "首先，把今天在这里说的话"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:48:23",
            "content": "はい、",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:48:24",
            "content": "正直に彼に伝えてその上で",
            "Chinese": "坦诚地告诉他，然后在此基础上，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:48:33",
            "content": "理解したいからって気持ちも正直にいうことですかね",
            "Chinese": "也坦诚地告诉他“我是想理解你”的这份心情吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:49:04",
            "content": "ええ。しっかりと考えをお持ちなんですね。",
            "Chinese": "嗯。您已经有很清晰的想法了呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:49:18",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:49:35",
            "content": "私もあなたの言う正直に伝えること、",
            "Chinese": "我也认为您说的“坦诚地传达”，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:50:11",
            "content": "あなたの気持ちも理解したいからって",
            "Chinese": "还有“因为我也想理解你的心情”，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:50:27",
            "content": "言うことも大事なことだと思います。",
            "Chinese": "说出这些话是很重要的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:50:37",
            "content": "はい、そうですよね",
            "Chinese": "是的，确实如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:51:16",
            "content": "ええ、それが",
            "Chinese": "嗯，那样的话"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:51:45",
            "content": "円滑なコミュニケーションになりますよね。",
            "Chinese": "就能有顺畅的沟通了呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:51:52",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:52:44",
            "content": "我慢はしんどいですし、",
            "Chinese": "忍耐是很辛苦的，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:52:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:53:29",
            "content": "相手のためにならなかったりしますからね",
            "Chinese": "有时也并不一定对对方有好处。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:53:35",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:54:12",
            "content": "先ほど言ったように、",
            "Chinese": "就像刚才说的，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:54:54",
            "content": "正直に伝えること、あなたの気持ちも理解したい、と言うことを伝えること、",
            "Chinese": "坦诚地传达，以及传达“我也想理解你的心情”这件事，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:55:59",
            "content": "あとは相手のことを「こうさせたい」みたいな相手を変えようとしないことが大切だと思います。",
            "Chinese": "还有，不要想着去改变对方，比如“想让他这么做”，我觉得这也很重要。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:56:12",
            "content": "でもあなたのことを聞いてると、",
            "Chinese": "不过听您这么说，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:56:51",
            "content": "うまくコミュニケーションをとる術を理解されてると思いますが、どうですか？",
            "Chinese": "我觉得您已经理解了如何进行良好沟通的方法，您觉得呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:57:06",
            "content": "うまく分かり合える会話はできそうですか？",
            "Chinese": "您觉得能进行一场可以好好互相理解的对话吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 20:57:11",
            "content": "そうですね、それはできると思います",
            "Chinese": "是的，我觉得我能做到。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:57:31",
            "content": "はい。良かったです。",
            "Chinese": "好的。太好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:58:23",
            "content": "また正直に話すのって、",
            "Chinese": "另外，坦诚地交谈这件事，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:58:39",
            "content": "もしかすると勇気がいるかもしれませんが、",
            "Chinese": "或许需要一些勇气，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 20:59:52",
            "content": "あなたの気持ちを我慢せずに、ただ正直に話すと、今度は彼氏さんも",
            "Chinese": "但如果您不压抑自己的心情，只是坦诚地说出来，这一次您的男朋友"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 21:00:09",
            "content": "理解してくれるかもしれませんからね。",
            "Chinese": "或许也能够理解您了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 21:00:17",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 21:00:42",
            "content": "あなたの大事な将来のことですからね。",
            "Chinese": "因为这是关系到您重要未来的事情。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 21:00:53",
            "content": "はい、ありがとうございます",
            "Chinese": "好的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 21:01:13",
            "content": "参考になりましたでしょうか？",
            "Chinese": "对您有帮助吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 21:01:23",
            "content": "はい、ありがとうございました",
            "Chinese": "是的，非常感谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 21:01:56",
            "content": "はい。あなたの大事な将来のことなので、また何かあればお越しくださいね。",
            "Chinese": "好的。因为是您重要的未来，如果再有什么事，欢迎随时来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 21:02:15",
            "content": "はい、今日はありがとうございました",
            "Chinese": "好的，今天非常感谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 21:03:09",
            "content": "はい。今日はお越しいただき、ありがとうございました。あなたのこれからを応援しています。",
            "Chinese": "好的。感谢您今天的到来。我会支持您的未来。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 21:03:27",
            "content": "それではこれで終了いたします。お疲れ様でした。",
            "Chinese": "那么本次咨询就到此结束了。您辛苦了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/10(火) 21:03:35",
            "content": "はい、ありがとうございました。お疲れ様でした。",
            "Chinese": "好的，谢谢您。您辛苦了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 21:04:14",
            "content": "（お疲れ様でした。夜分遅くまでありがとうございました。）",
            "Chinese": "（辛苦了。这么晚了，非常感谢。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/10(火) 21:05:02",
            "content": "（お手隙の際に評価して頂けたら嬉しいです。それでは終了いたします。）",
