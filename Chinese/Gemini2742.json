{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 09:52:41",
            "content": "こんにちは、本日はよろしくお願いします",
            "Chinese": "您好，今天請多多關照。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 09:52:56",
            "content": "こちらこそ宜しくお願いします。",
            "Chinese": "也請您多多關照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 09:53:29",
            "content": "時間になりましたら、声掛けさせていただきます。",
            "Chinese": "時間到了我會提醒您的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 09:54:05",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:00:09",
            "content": "こんにちは相談員です。相談に来ていただきありがとうございます。",
            "Chinese": "您好，我是諮詢師。感謝您前來諮詢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:00:21",
            "content": "宜しくお願いします",
            "Chinese": "請多關照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:00:39",
            "content": "よろしくお願いしますはじめに、年齢と性別を教えてもらえますか",
            "Chinese": "請多關照。首先，能告訴我您的年齡和性別嗎？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:00:54",
            "content": "17 女です",
            "Chinese": "17歲，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:01:06",
            "content": "ありがとうございます",
            "Chinese": "謝謝您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:01:14",
            "content": "本日はどのようなご相談でしょうか",
            "Chinese": "今天您想諮詢什麼問題呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:01:42",
            "content": "人とうまく仲良くなれません",
            "Chinese": "我不太能和別人處好關係。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:01:59",
            "content": "あと勉強も出来なくて",
            "Chinese": "而且學習也學不好。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:02:07",
            "content": "成績もヤバいです",
            "Chinese": "成績也很糟糕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:02:15",
            "content": "そうなんですね、それは悩んでしまいますよね",
            "Chinese": "是這樣啊，這確實很令人煩惱呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:02:23",
            "content": "はい、全部ダメなんです",
            "Chinese": "是的，我什麼都做不好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:02:35",
            "content": "そんなふうに感じておられるのですね",
            "Chinese": "您是這樣感覺的呀。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:02:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:03:22",
            "content": "普段、学校ではどんなふうに過ごしておられますか",
            "Chinese": "平時在學校裡，您是如何度過的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:03:33",
            "content": "普通です",
            "Chinese": "普通。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:03:52",
            "content": "そうなんですね",
            "Chinese": "是這樣啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:03:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:04:33",
            "content": "人と仲良くなれないと教えてくれましたが、どんなところでそう感じますか",
            "Chinese": "您說和別人處不好關係，具體在哪些情形下會有這樣的感覺呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:04:50",
            "content": "どんなところ…",
            "Chinese": "哪些情形……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:05:57",
            "content": "全部",
            "Chinese": "全部。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:07:01",
            "content": "そうでしたか、、仲良くなるのが難しいと思うとしんどくなりますよね、、",
            "Chinese": "這樣啊……一想到很難和人熟絡，確實會很難受呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:07:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:09:15",
            "content": "家ではどんな感じで過ごしておられますか",
            "Chinese": "在家裡，您是如何度過的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:09:25",
            "content": "普通です",
            "Chinese": "普通。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:09:36",
            "content": "そうなんですね",
            "Chinese": "是這樣啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:09:42",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:10:20",
            "content": "今は、どんなことが一番しんどいなと感じておられますか",
            "Chinese": "現在，您覺得最讓您難受的是什麼呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:10:44",
            "content": "全部つらいです",
            "Chinese": "一切都很痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:11:19",
            "content": "私なんて消えた方がいいです",
            "Chinese": "我這種人不如消失算了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:11:37",
            "content": "そうなんですね、全部がつらいと感じると、毎日がとてもしんどいですよね、、",
            "Chinese": "是這樣啊，當覺得一切都很痛苦時，每一天都會非常難熬呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:11:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:13:22",
            "content": "あなたが、つらく感じていること、今日はどんな思いでも全部お話しくださいね",
            "Chinese": "您感到痛苦的事情，今天無論是什麼想法，都可以全部說出來哦。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:13:30",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:14:54",
            "content": "学校では、気軽に話をしたりできる人はいますか",
            "Chinese": "在學校裡，有可以輕鬆聊聊的人嗎？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:15:05",
            "content": "いません",
            "Chinese": "沒有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:15:30",
            "content": "そうなんですね、それは寂しいですよね",
            "Chinese": "是這樣啊，那確實會讓人感到寂寞呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:15:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:16:12",
            "content": "休み時間とかは、どんなふうに過ごしていますか",
            "Chinese": "課間休息時，您是如何度過的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:16:40",
            "content": "机に座って携帯みてます",
            "Chinese": "坐在座位上看手機。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:17:03",
            "content": "そうでしたか",
            "Chinese": "是這樣啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:17:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:17:25",
            "content": "たまに意味もなく歩きにいったり",
            "Chinese": "偶爾也會毫無目的地去走走。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:17:36",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:17:54",
            "content": "1人だと恥ずかしいから、忙しいふりをします",
            "Chinese": "因為一個人會感到尷尬，所以 我會假裝很忙。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:19:16",
            "content": "そんなふうに時間を過ごさないといけないのは、しんどいですよね",
            "Chinese": "必須要用那種方式度過時間，一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:19:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:19:59",
            "content": "私、ほんとダメで、消えたらいいのにと毎日思ってます",
            "Chinese": "我真的好沒用，每天都想，要是能消失就好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:20:48",
            "content": "そんなふうに感じているのですね",
            "Chinese": "您是這麼感覺的呀。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:21:29",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:21:33",
            "content": "自分のどんなところが、ダメだと感じているのでしょうか",
            "Chinese": "您觉得自己哪些方面“不行”呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:21:43",
            "content": "全部です",
            "Chinese": "全都不行。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:22:03",
            "content": "そうなんですね",
            "Chinese": "是這樣啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:22:18",
            "content": "ブスだし、デブだし、コミュ障だし、勉強赤点ばかりだし",
            "Chinese": "我又醜又胖，有社交障礙，學習也老是不及格。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:22:52",
            "content": "そんなふうに感じると、とても苦しくなりますね",
            "Chinese": "有這樣的感覺，一定非常痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:23:17",
            "content": "実際そうなので…",
            "Chinese": "因為事實就是這樣……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:24:29",
            "content": "自分のことを、そんなふうに思っているのですね",
            "Chinese": "您是這樣看待自己的呀。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:24:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:25:11",
            "content": "いつ頃から、そんなふうに感じるようになったのでしょうか",
            "Chinese": "大概是從什麼時候開始有這種感覺的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:25:28",
            "content": "昔からです",
            "Chinese": "從很久以前就是了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:25:48",
            "content": "小学生から友達出来なかった",
            "Chinese": "從國小起就交不到朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:26:32",
            "content": "そうだったのですね、小学校の時から・・・ずっとしんどい思いを抱えてこられたのですね",
            "Chinese": "原來是這樣啊，從國小開始……您一直都懷抱著這麼痛苦的心情走過來的呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:26:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:28:51",
            "content": "小学校に上がる前は、どんな感じだったのでしょうか",
            "Chinese": "在上國小之前，情況是怎樣的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:29:25",
            "content": "幼稚園は先生がかまってくれてました",
            "Chinese": "在幼稚園時，老師會照顧我、關心我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:29:34",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:30:58",
            "content": "小学校になると、自分でやらないといけないことが増えてきますものね",
            "Chinese": "到了國小，必須自己做的事情就變多了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:31:15",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:32:17",
            "content": "急に自分でやるとなると、難しく感じてしまいますよね",
            "Chinese": "突然需要自己去做，確實會感到困難呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:32:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:32:52",
            "content": "みんなは勉強ついていけたけど、私はよくわかんなかったです",
            "Chinese": "大家都能跟上學習進度，但我經常聽不太懂。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:33:35",
            "content": "そうだったのですね、分からないのにやらないといけないのは、つらすぎますよね、、",
            "Chinese": "原來是這樣，明明不懂卻又不得不做，這太痛苦了……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:34:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:34:20",
            "content": "勉強が分からなかった時は、どうしておられたのですか",
            "Chinese": "學習上遇到不懂的時候，您是怎麼做的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:35:25",
            "content": "何もしませんでしたたまに先生が教えてくれたり",
            "Chinese": "我什麼也不做，偶爾老師会教我一下。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:35:39",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:36:45",
            "content": "そうやって先生が教えてくれると、理解できましたか",
            "Chinese": "那樣當老師教您時，您能理解嗎？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:37:15",
            "content": "いえ…",
            "Chinese": "沒有……"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:37:23",
            "content": "ダメダメですね…",
            "Chinese": "我真是一無是處啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:38:15",
            "content": "そうでしたか、分からないけど自分なりに一生懸命に取り組んでおられたのですね",
            "Chinese": "是這樣啊，雖然不太懂，您還是盡自己所能在努力呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:39:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:40:04",
            "content": "家では、そういったことで困っていることをお話しておられましたか",
            "Chinese": "在家裡，您有跟家人說過這些困擾嗎？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:41:00",
            "content": "はい",
            "Chinese": "說過。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:41:17",
            "content": "そうでしたか",
            "Chinese": "原來如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:41:52",
            "content": "ご家族は、何か言っていましたか",
            "Chinese": "您的家人說了些什麼嗎？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:42:26",
            "content": "もっとがんばりなさいと",
            "Chinese": "讓我再努力一點。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/20(土) 10:43:02",
            "content": "そうでしたか、そう言われてどんなふうに感じましたか",
            "Chinese": "是這樣啊，聽到這話您是什麼感覺呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/20(土) 10:44:27",
            "content": "誰もわかってくれないなと",
            "Chinese": "覺得誰都不能理解我。"
        },
        {
            "role": "カウンセラー",
