{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:01:00",
            "content": "こんにちは。マッチングありがとうございます。テーマ：カウンセラー部門「いじめ」12時35分終了予定となります。どうぞよろしくお願い致します。",
            "Chinese": "您好，感谢匹配。主题：咨询师部门“霸凌”，预计将于12点35分结束。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:01:13",
            "content": "よろしくお願いします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:01:46",
            "content": "こんにちは、相談員です。もしよかったら、はじめに年齢と性別を教えていただいても大丈夫ですか？",
            "Chinese": "您好，我是咨询师。如果方便的话，能先请您告知一下年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:02:11",
            "content": "40代 女性です",
            "Chinese": "40多岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:02:31",
            "content": "ありがとうございます。今日はどのようなご相談でしょうか？",
            "Chinese": "谢谢您。今天想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:03:05",
            "content": "高校でのことです",
            "Chinese": "是关于高中时的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:03:43",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:03:56",
            "content": "お話できる範囲で大丈夫なので、",
            "Chinese": "在您可以说的范围内就好，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:04:07",
            "content": "詳しく聞かせてもらっていいでしょうか？",
            "Chinese": "可以详细和我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:04:18",
            "content": "一部の子達がやりたい放題で",
            "Chinese": "有一部分同学为所欲为。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:04:31",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:04:44",
            "content": "先生の話も指摘も聞かないですし",
            "Chinese": "连老师的话和批评都不听，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:05:03",
            "content": "同じクラスの子達にも",
            "Chinese": "对同班同学也……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:05:28",
            "content": "うん、うん。",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:05:50",
            "content": "物を飛ばしたり後ろから椅子を蹴ったりするので",
            "Chinese": "会扔东西，或者从后面踢别人的椅子，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:06:16",
            "content": "見ているのがしんどくなってきて",
            "Chinese": "我看着都觉得很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:06:31",
            "content": "なるほどですね…",
            "Chinese": "原来是这样……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:06:37",
            "content": "注意したら",
            "Chinese": "我提醒了他们之后，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:07:06",
            "content": "私が攻撃されるようになりました",
            "Chinese": "我反而成了他们攻击的对象。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:07:29",
            "content": "そうでしたか…",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:08:06",
            "content": "あなたは、先生なのですか？",
            "Chinese": "您是老师吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:08:49",
            "content": "あっ すみません私の高校生の時の話です",
            "Chinese": "啊，不好意思，这是我高中时候的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:09:12",
            "content": "ああ、了解です。ありがとうございます。",
            "Chinese": "啊，明白了。谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:10:03",
            "content": "クラスにやんちゃな一部のクラスメートがいて、",
            "Chinese": "班里有一些调皮的同学，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:10:53",
            "content": "みんなのためにも、",
            "Chinese": "您是为了大家，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:11:24",
            "content": "なんとかしたいと、思われたのですね。",
            "Chinese": "所以想做点什么，是这样吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:11:53",
            "content": "攻撃…というのは、どんなことがありましたか？",
            "Chinese": "您说的“攻击”……具体是指什么样的事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:12:03",
            "content": "はい何もせずにはいられませんでした",
            "Chinese": "是的，我没办法袖手旁观。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:12:13",
            "content": "うん、うん。そうですよね。",
            "Chinese": "嗯，嗯。确实如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:12:25",
            "content": "トイレに連れ込まれてホースで水をかけられたり",
            "Chinese": "被他们拖进厕所用软管浇水，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:12:40",
            "content": "えええ…！？",
            "Chinese": "天啊……！？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:13:04",
            "content": "廊下を歩いているときに飛び蹴りをされたりしました",
            "Chinese": "或者在走廊走路的时候被飞踹。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:13:17",
            "content": "そんなことが…",
            "Chinese": "竟然发生了那样的事……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:13:41",
            "content": "つらい経験をされてこられましたね…",
            "Chinese": "您经历了很痛苦的事情呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:14:03",
            "content": "辛いという思いより",
            "Chinese": "与其说是痛苦，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:14:08",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:14:19",
            "content": "なぜそんなことが出きるのかって",
            "Chinese": "我更疑惑他们为什么能做出那种事，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:14:34",
            "content": "不思議でした",
            "Chinese": "感到很不可思议。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:14:43",
            "content": "なるほどですね…",
            "Chinese": "我明白了……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:15:28",
            "content": "この相談の中で、そこをお話しできたら、スッキリしそうですか？",
            "Chinese": "如果在这次咨询中能谈谈这部分，您觉得会不会更释怀一些呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:15:46",
            "content": "はい",
            "Chinese": "会的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:16:06",
            "content": "はい。ありがとうございます。",
            "Chinese": "好的。谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:16:16",
            "content": "その子達に私はなりに一生懸命",
            "Chinese": "我也尽我所能地对那些同学"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:16:24",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:16:36",
            "content": "なぜそういうことをするのか",
            "Chinese": "询问他们为什么要那样做，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:17:03",
            "content": "聞いたりして気持ちを教えてほしいと",
            "Chinese": "希望他们能告诉我他们的感受，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:17:19",
            "content": "問いかけていたのですが",
            "Chinese": "我一直这样询问他们，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:17:29",
            "content": "うん、うん。ご自身でも行動されてこられたのですね。",
            "Chinese": "嗯，嗯。您也主动采取了行动啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:17:51",
            "content": "その子達にとっては勘にさわってしまったらしく",
            "Chinese": "但对他们来说，我的行为好像惹恼了他们，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:18:07",
            "content": "悪化してしまいました",
            "Chinese": "结果情况反而变得更糟了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:18:21",
            "content": "そうだったのですね…",
            "Chinese": "原来是这样……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:19:13",
            "content": "あなた自身は、冷静に、",
            "Chinese": "您自己能够冷静地，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:19:45",
            "content": "今後のためにも、その子達の気持ちを聴く、",
            "Chinese": "为了他们将来好，而去倾听那些同学的想法，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:20:07",
            "content": "という行動ができたこと、素晴らしいですね。",
            "Chinese": "能做出这样的行动，真的很了不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:20:16",
            "content": "その時は、どんなふうに、問いかけられたのでしょうか？",
            "Chinese": "当时，您是怎样问他们的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:20:59",
            "content": "人を傷つけることを",
            "Chinese": "我说，伤害别人，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:21:39",
            "content": "してしまうと自分自身も苦しくなっちゃうよって",
            "Chinese": "到头来自己也会变得痛苦的哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:21:50",
            "content": "うん、うん。",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:22:11",
            "content": "何か今辛いことを抱えているのなら",
            "Chinese": "如果现在有什么痛苦的事情，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:22:31",
            "content": "教えてほしいって伝えました",
            "Chinese": "希望你们能告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:23:00",
            "content": "なるほどですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:23:42",
            "content": "教えてくれて、ありがとうございます。",
            "Chinese": "谢谢您告诉我这些。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:23:53",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:23:55",
            "content": "一部の子、というのは何人くらいでしたか？",
            "Chinese": "您说的一部分同学，大概有多少人呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:24:24",
            "content": "男女合わせて7人位です",
            "Chinese": "男女加起来大概7个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:24:40",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:25:17",
            "content": "高校生くらいだと、それくらいのグループというのは、",
            "Chinese": "在高中生时期，那种规模的小团体，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:25:23",
            "content": "よくありますよね。",
            "Chinese": "也是很常见的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:25:39",
            "content": "その中にバットを振り回していたリーダーみたいな子がいました。",
            "Chinese": "其中有一个像领头人一样的孩子，会拿着棒球棒挥来挥去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:25:54",
            "content": "バットを…",
            "Chinese": "棒球棒……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:26:14",
            "content": "周りから見ると、本当に怖いですね…",
            "Chinese": "在旁人看来，真的很可怕呢……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:26:24",
            "content": "はい😅",
            "Chinese": "是的😅"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:26:58",
            "content": "その子達は、プライドも高かったのではありませんか？",
            "Chinese": "那些同学的自尊心是不是也很强呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:27:21",
            "content": "自分達が偉いと思っていたみたいです",
            "Chinese": "他们好像觉得自己很了不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:27:33",
            "content": "うんうん。その子達は、もしかしたら…",
            "Chinese": "嗯嗯。那些同学，或许……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:28:27",
            "content": "自尊心や自分のパワーなど、自我というものを、",
            "Chinese": "当时可能正处于一个确认自尊心、自己的力量等，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:28:46",
            "content": "確かめている時期だったのかもしれませんね。",
            "Chinese": "也就是“自我”的时期吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:29:06",
            "content": "そうだったと思います",
            "Chinese": "我想应该是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:29:10",
            "content": "先生の言うこととか、社会的な常識にも、",
            "Chinese": "对于老师说的话、社会上的常识，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:29:27",
            "content": "反抗できる力があるんだ。と…",
            "Chinese": "觉得自己有力量去反抗，之类的……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:29:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:29:39",
            "content": "リーダーがそうだとすると、",
            "Chinese": "如果领头的是这样，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:30:13",
            "content": "グループの人は、仲間はずれが怖くかったり…",
            "Chinese": "那么团体里的其他人可能会害怕被排挤……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:30:43",
            "content": "リーダーからしても、仲間がそうなのに、",
            "Chinese": "从领头的角度来看，可能觉得同伴都那样了，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:31:03",
            "content": "自分が示しをつけるんだ、みたいな気持ちがあったり。",
            "Chinese": "自己也必须得立个威，有这样的心情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:31:20",
            "content": "ただ…",
            "Chinese": "只是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:31:42",
            "content": "あなたも、周りも、とても苦しい想いでしたね…",
            "Chinese": "无论是您还是周围的人，都承受了很痛苦的感受啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:31:54",
            "content": "はいリーダーが怖いので本当はそうしたくないのに従っている子も多かったです。",
            "Chinese": "是的，因为害怕那个领头人，很多同学其实并不想那样做，但还是被迫服从。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:32:13",
            "content": "うん、うん。",
            "Chinese": "嗯，嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:32:30",
            "content": "従わなければいけないと",
            "Chinese": "那种“不得不服从”的"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:32:44",
            "content": "いうクラスの雰囲気が",
            "Chinese": "班级氛围，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:33:00",
            "content": "とても重いものでした",
            "Chinese": "非常压抑沉重。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:33:09",
