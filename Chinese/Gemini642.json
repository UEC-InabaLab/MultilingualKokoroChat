{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 09:54:59",
            "content": "今日はよろしくお願いします",
            "Chinese": "今天请多多指教。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 09:55:07",
            "content": "お願い致します。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 09:55:25",
            "content": "ご準備出来ましたら始めさせていただきますね",
            "Chinese": "您准备好了的话，我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 09:55:30",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 09:56:59",
            "content": "では、少し早いですが始めさせていただきますね",
            "Chinese": "那么，虽然时间稍早，我们就开始吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 09:57:38",
            "content": "こんにちは。相談員です",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 09:58:13",
            "content": "差し支えなければ、年齢や性別を教えていただけますでしょうか。",
            "Chinese": "如果方便的话，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 09:58:40",
            "content": "36歳女です",
            "Chinese": "36岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 09:58:51",
            "content": "教えて頂きありがとうございます",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 09:59:10",
            "content": "今日はどのような相談でしょうか？",
            "Chinese": "今天您想咨询什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 09:59:45",
            "content": "不倫をしています",
            "Chinese": "我正在出轨。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:00:14",
            "content": "そうなんですね・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:00:36",
            "content": "どのようなことで悩まれているのでしょうか",
            "Chinese": "您在哪些方面感到困扰呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:01:01",
            "content": "不倫をしていることです‥",
            "Chinese": "就是出轨这件事……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:02:09",
            "content": "そうですよね・・うしろめたいようなお気持ちでしょうか",
            "Chinese": "是的……您是否感到有些愧疚呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:02:26",
            "content": "ええ",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:04:07",
            "content": "お相手とはどこで知り合ったのでしょうか",
            "Chinese": "您和对方是在哪里认识的呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:04:29",
            "content": "お相手とはどこで知り合ったんでしょうか",
            "Chinese": "您和对方是在哪里认识的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:04:33",
            "content": "BARで知り合いました。一人で飲んでいて、隣に座っていたのです",
            "Chinese": "在酒吧认识的。当时我一个人在喝酒，他坐在我旁边。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:05:04",
            "content": "そうだったんですね・・",
            "Chinese": "原来是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:05:31",
            "content": "いつ頃からでしょうか",
            "Chinese": "大概是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:06:23",
            "content": "一年くらいになります",
            "Chinese": "大概一年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:06:45",
            "content": "そうなんですね・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:07:41",
            "content": "不倫のお相手は独身ですか？",
            "Chinese": "对方是单身吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:08:08",
            "content": "子どもと奥様がいます",
            "Chinese": "他有孩子和妻子。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:08:41",
            "content": "それは悩んでしまいますよね",
            "Chinese": "这确实会让人烦恼呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:09:03",
            "content": "どんな雰囲気の方なんでしょうか？",
            "Chinese": "他是个什么样的人呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:09:53",
            "content": "優しくて芯のある方です",
            "Chinese": "他很温柔，也很有主见。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:10:24",
            "content": "素敵な方なんですねあなたが惹かれてしまうほどに",
            "Chinese": "看来他是个很优秀的人，难怪您会被他吸引。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:10:54",
            "content": "ええ",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:11:03",
            "content": "あなたにもお子さんはいらっしゃるのでしょうか",
            "Chinese": "您自己有孩子吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:11:25",
            "content": "いいえ",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:11:38",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:12:50",
            "content": "お相手の方にお子さんもいて・・となると悩ましいですね",
            "Chinese": "对方还有孩子……确实让人更为纠结呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:12:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:14:19",
            "content": "あなたはお相手の方と今後どのようにされていきたいと思われますか？",
            "Chinese": "您希望今后和对方如何发展呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:14:53",
            "content": "ほんとは別れなきゃいけないって分かっているんですけど‥",
            "Chinese": "我明白其实应该分开的，可是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:15:15",
            "content": "そうなんですね・・それはお辛いですね",
            "Chinese": "这样啊……这确实很难受呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:16:27",
            "content": "お相手の方はどんなふうに思っていらっしゃるのでしょうか",
            "Chinese": "您觉得对方是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:16:41",
            "content": "わかりません",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:16:42",
            "content": "今後について・・",
            "Chinese": "关于今后的事……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:17:07",
            "content": "そうなんですね・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:19:27",
            "content": "あなたが不倫をされているのには、今の夫さんにどこか不満があってとか・・そのようなことはありますか？",
            "Chinese": "您出轨是否是因为对现任丈夫有所不满呢？……有这方面的原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:19:39",
            "content": "ええ",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:19:41",
            "content": "あります",
            "Chinese": "有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:19:53",
            "content": "どういったことでしょうか？",
            "Chinese": "具体是哪些方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:20:10",
            "content": "夫は住職をしていて",
            "Chinese": "我丈夫是寺庙的住持。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:20:18",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:20:30",
            "content": "毎日朝も夜も早く",
            "Chinese": "每天早起早睡，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:20:39",
            "content": "すごい窮屈です",
            "Chinese": "让我感到非常压抑。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:20:49",
            "content": "そうなんですね・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:21:22",
            "content": "それは寂しいですね",
            "Chinese": "那确实会让人感到寂寞呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:21:39",
            "content": "うーん、",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:21:47",
            "content": "寂しくはないんですけど",
            "Chinese": "倒也不是寂寞。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:21:56",
            "content": "人柄はすごくいいので",
            "Chinese": "因为他人品非常好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:22:10",
            "content": "そうなんですね・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:23:43",
            "content": "夫さんの性格とかで、不満なことはあるのではないのですね",
            "Chinese": "也就是说，关于您丈夫的性格等方面，您并没有什么不满，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:24:01",
            "content": "ええ",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:24:35",
            "content": "あなたに対してのどんな点がご不満に感じてますか",
            "Chinese": "您对丈夫在哪些方面感到不满呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:25:08",
            "content": "とにかく生活が辛いです‥",
            "Chinese": "总之，生活很痛苦……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:25:32",
            "content": "そうだったんですね・・お辛いですね",
            "Chinese": "原来如此……这确实很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:25:57",
            "content": "どんなところが、一番辛いと感じますか",
            "Chinese": "您觉得最痛苦的是哪一方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:26:19",
            "content": "なんか、とにかく窮屈なんですよね‥",
            "Chinese": "怎么说呢，总之就是很拘束、很压抑……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:27:30",
            "content": "そうなんですねあなたが独りぼっちのように感じてしまうような・・そんな感じでしょうか？",
            "Chinese": "这样啊，会让您觉得像是孤身一人……是那样的感觉吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:28:14",
            "content": "具体的にはどんなことが窮屈に感じたしまいますか？",
            "Chinese": "具体来说，哪些事情会让您感到压抑呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:28:36",
            "content": "↑感じて　です",
            "Chinese": "抱歉，是“感到”。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:28:57",
            "content": "夫のお母様も一緒で",
            "Chinese": "我丈夫的母亲也和我们住在一起，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:29:08",
            "content": "お寺の生活に気を使ってしんどいのです",
            "Chinese": "为了寺庙里的生活处处要留心，真的很累。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:29:20",
            "content": "礼儀とか作法とか。もうウンザリです",
            "Chinese": "礼节、规矩之类的，我已经受够了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:30:17",
            "content": "そうだったんですね・・それは　逃げ出したくなるようなお気持ちですよね",
            "Chinese": "原来如此……那确实会让人想要逃离呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:30:40",
            "content": "ええ",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:30:53",
            "content": "その時に内緒で飲みに出て",
            "Chinese": "那时候我就偷偷出去喝酒，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:30:56",
            "content": "出会いました",
            "Chinese": "然后就遇见了他。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:30:58",
            "content": "義理のお母さまからも、いろいろと干渉されているなんて",
            "Chinese": "连婆婆这边也会有各种干涉啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:31:29",
            "content": "なるほど・・ですね",
            "Chinese": "原来如此……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:32:00",
            "content": "あなたが不倫してしまうお気持ちが伝わってきました",
            "Chinese": "我能理解您为什么会出轨了。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:32:18",
            "content": "ええ",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:32:46",
            "content": "今の生活はあまりにもしんどそうですよね・・",
            "Chinese": "现在的生活听起来真的太辛苦了……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:32:53",
            "content": "ええ",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:34:02",
            "content": "ちなみに、ご結婚されてどのくらいの期間でしょうか",
            "Chinese": "顺便问一下，您结婚大概多长时间了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:34:44",
            "content": "一年くらいです",
            "Chinese": "大概一年。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:35:41",
            "content": "そうですか・・まだ新婚さんのような感じくらいなんですね",
            "Chinese": "这样啊……感觉还像是新婚阶段。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:36:04",
            "content": "んー",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:36:09",
            "content": "でも私にとっては",
            "Chinese": "但对我来说，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:36:15",
            "content": "地獄のような日々です",
            "Chinese": "每天都像地狱一样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:36:44",
            "content": "それは苦しいですね・・",
            "Chinese": "那真是太痛苦了……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:36:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:37:28",
            "content": "結婚されて、いつごろからそのようにお感じになりましたか？",
            "Chinese": "结婚之后，大概从什么时候开始有这种感觉的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:37:42",
            "content": "すぐですね‥",
            "Chinese": "几乎马上就……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:37:50",
            "content": "耐えられるし慣れるかなと思ったんですが",
            "Chinese": "我以为自己能忍受、能慢慢适应，"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:37:55",
            "content": "ダメでした。",
            "Chinese": "但还是不行。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:38:00",
            "content": "そうだったんですね・・",
            "Chinese": "原来是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:38:34",
            "content": "本当に・・それでは毎日が苦しいですね",
            "Chinese": "的确如此……那每天都很难熬吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:39:05",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/02(月) 10:39:20",
            "content": "逃げ場がないですよね",
            "Chinese": "感觉无处可逃吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/02(月) 10:39:22",
            "content": "今は彼といる時が一番幸せです",
            "Chinese": "现在只有和他在一起的时候最幸福。"
        },
        {
