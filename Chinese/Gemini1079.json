{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:01:14",
            "content": "こちらは、カウンセラーいじめテーマです。",
            "Chinese": "这里是咨询师，本次咨询的主题是霸凌问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:01:27",
            "content": "こんにちはよろしくお願いします",
            "Chinese": "您好，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:01:34",
            "content": "こんにちはよろしくお願いします",
            "Chinese": "您好，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:02:02",
            "content": "こんにちは相談員ですよろしくお願いします",
            "Chinese": "您好，我是咨询师，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:02:10",
            "content": "よろしくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:02:17",
            "content": "お越しいただき、ありがとうございます",
            "Chinese": "非常感谢您的前来。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:02:36",
            "content": "お願いします",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:02:36",
            "content": "今日は、どのようなご相談ですか",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:04:26",
            "content": "友人がクラスメートに「コロナ罹ったでしょ？」と言われています。実際は罹っていないので事実無根です",
            "Chinese": "我的朋友被同班同学说“你得新冠了吧？”。实际上他并没有得过，这完全是无中生有。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:04:45",
            "content": "私は庇いましたが",
            "Chinese": "我虽然帮他说话了，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:05:02",
            "content": "ショックを受けている様子でした",
            "Chinese": "但他看起来受到了很大的打击。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:05:19",
            "content": "そうなんですね・・・それは、不快に思われますよね",
            "Chinese": "是这样啊……那肯定会感到很不舒服吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:05:35",
            "content": "ショックですよね",
            "Chinese": "会受到打击的吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:05:35",
            "content": "かわいそうです…",
            "Chinese": "他真可怜……"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:05:47",
            "content": "私もショックです",
            "Chinese": "我也很受打击。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:05:54",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:06:01",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:06:19",
            "content": "そのお友達は、仲が良いお友達ですか",
            "Chinese": "那位朋友是和您关系很好的朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:06:38",
            "content": "仲が良いです！",
            "Chinese": "关系很好！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:06:53",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:06:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:07:24",
            "content": "ちなみに、年齢、性別、何とお呼びしたらよろしいですか",
            "Chinese": "顺便问一下，您的年龄、性别，以及我该如何称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:08:14",
            "content": "17歳、男、オオミソカと呼んでください",
            "Chinese": "17岁，男，请叫我Oomisoka。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:08:49",
            "content": "オオミソカさん、教えていただき、ありがとうございます",
            "Chinese": "Oomisoka先生，感谢您告诉我这些。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:09:01",
            "content": "いいえー",
            "Chinese": "不客气——"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:09:32",
            "content": "そのような出来事があったのは、いつ頃ですか",
            "Chinese": "这样的事情大概是什么时候发生的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:09:55",
            "content": "2週間ですね",
            "Chinese": "大概是两周前。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:10:08",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:10:16",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:10:29",
            "content": "でも、許せない出来事ですよね",
            "Chinese": "但这确实是件让人无法原谅的事，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:10:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:10:55",
            "content": "学校での出来事ですか",
            "Chinese": "是在学校发生的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:11:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:11:37",
            "content": "クラスの中で、起きているのでしょうか",
            "Chinese": "是在班级里发生的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:12:11",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:13:04",
            "content": "オオミソカさんからみていて、お友達は、毎日お辛い日々をお過ごしなんですね",
            "Chinese": "在Oomisoka先生您看来，您的朋友每天都过得很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:13:47",
            "content": "表情が暗く見えます",
            "Chinese": "他的表情看起来很阴沉。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:14:38",
            "content": "そうなんですね・・・それは、お辛そうですねオオミソカさんも、いつもそのお友達と、一緒に過ごしていらっしゃるのですね",
            "Chinese": "是这样啊……那看起来是很难受呢。Oomisoka先生也总是和那位朋友待在一起吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:15:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:15:52",
            "content": "オオミソカさんは、そのような時があった時、どのようにしていらっしゃいますか",
            "Chinese": "Oomisoka先生，在发生那种情况时，您是怎么做的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:17:32",
            "content": "暴言を吐いた子に「そんなこと言わないで！」と言いましたが、",
            "Chinese": "我对那个口出恶言的同学说了“别这么说！”，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:17:42",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:18:00",
            "content": "悪びれる様子がなかったことに腹が立ちました",
            "Chinese": "他一副毫无悔意的样子，让我很生气。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:18:28",
            "content": "そうなんですね・・・苦しかったですよね",
            "Chinese": "是这样啊……您心里一定很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:18:41",
            "content": "でも、",
            "Chinese": "但是，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:19:24",
            "content": "謝れば丸く収まるはずなのに、と思ってしまいます",
            "Chinese": "我总觉得，只要他道个歉，事情本来就能圆满解决的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:20:22",
            "content": "そうですよねお友達がそのようになった時に、一緒にいて、味方になっていただき、そのお友達は、心から救われていらっしゃると思います",
            "Chinese": "是啊。在您的朋友遇到那种情况时，您能陪在他身边，站在他这一边，我想您的朋友内心一定得到了很大的慰藉。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:20:43",
            "content": "そうだといいです",
            "Chinese": "但愿如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:21:27",
            "content": "お友達は、心強いですね・・・おつらいでしょうが。",
            "Chinese": "有您这样的朋友，他一定会觉得很安心吧……不过看着他这样，您也很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:22:14",
            "content": "お友達は、いじめられている時に、どのような様子ですか",
            "Chinese": "您的朋友在被欺凌时，是什么样的状态呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:23:13",
            "content": "間違った噂が広がったので、ショックを受けていました",
            "Chinese": "因为错误的谣言传开了，他受到了很大的打击。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:23:36",
            "content": "そうなんですね・・・悔しいし、悲しいですよね",
            "Chinese": "是这样啊……一定又委屈又难过吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:24:01",
            "content": "学校の先生は、そのことに、気がついているようですか",
            "Chinese": "学校的老师有注意到这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:25:08",
            "content": "担任は「間違った噂だから気にする必要ないよ！」と言っていますが",
            "Chinese": "班主任说“这是错误的谣言，不用在意！”，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:25:20",
            "content": "ええ、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:25:32",
            "content": "「そりゃ気にするでしょ！」と内心思いました",
            "Chinese": "我心里想：“这怎么可能不在意啊！”"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:25:57",
            "content": "そうですよね・・それは、ひどすぎますよね",
            "Chinese": "是啊……这太过分了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:26:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:27:22",
            "content": "お友達か、オオミソカさん、どちらか、学校の先生に話は出来ますか担任じゃなくても、養護の先生でも、教科の先生でも、どなたでも構いません",
            "Chinese": "您的朋友或者Oomisoka先生，你们当中有谁可以和学校的老师谈谈吗？不一定是班主任，保健室的老师，或者其他科目的老师，任何一位都可以。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:28:28",
            "content": "僕でしたらできますが",
            "Chinese": "我的话可以。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:28:40",
            "content": "はい、よかったです",
            "Chinese": "好的，那太好了。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:28:53",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:29:03",
            "content": "いじめは、絶対にあってはなりません",
            "Chinese": "霸凌是绝对不能容忍的。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:29:14",
            "content": "おっしゃる通りです",
            "Chinese": "您说得对。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:29:23",
            "content": "お友達は、全く悪くありません",
            "Chinese": "您的朋友完全没有错。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:29:41",
            "content": "その通りです！",
            "Chinese": "没错！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:30:10",
            "content": "オオミソカさんは、おともだちの、そのようなことを、学校の先生に話をしていただけますか",
            "Chinese": "Oomisoka先生，您能把您朋友的这些情况，和学校老师说一下吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:30:19",
            "content": "できます",
            "Chinese": "可以。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:30:35",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:31:01",
            "content": "できることはなんでもしてあげたいです！",
            "Chinese": "只要是我能做的，什么都愿意为他做！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:32:25",
            "content": "出来ることは、何でもしたいという、オオミソカさんの、お気持ち、とても素晴らしいと思いますほんの少しでも、お友達の心、そして、オオミソカさんの心が、晴れることを応援しています",
            "Chinese": "Oomisoka先生，您这种“只要是我能做的，什么都愿意做”的心情，我觉得非常了不起。我支持你们，希望您朋友和您的心情哪怕能好转一点点。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:32:51",
            "content": "ありがとうございます！",
            "Chinese": "谢谢您！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:33:01",
            "content": "そして、お友達のいじめがなくなることを、こころから、応援しています",
            "Chinese": "另外，我从心底里希望您朋友遭受的霸凌能够消失，并会支持你们。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:33:31",
            "content": "頑張ってくださいね",
            "Chinese": "请加油。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:33:31",
            "content": "ありがとうございます！他には何かありますか？",
            "Chinese": "谢谢您！还有其他什么我能做的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:33:56",
            "content": "些細なことでもしてあげたいです",
            "Chinese": "哪怕是再小的事，我也想为他做。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:34:37",
            "content": "ダメな場合は、証拠をもって、一緒に、警察の生活安全課に一緒に行ってあげてくださいね",
            "Chinese": "如果情况没有好转，请带着证据，陪他一起去警察局的生活安全科。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:34:53",
            "content": "分かりました！",
            "Chinese": "明白了！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:34:59",
            "content": "シャープ９　１１０　です",
            "Chinese": "这是紧急求助电话#9110。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:35:11",
            "content": "いかがですか",
            "Chinese": "您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:35:12",
            "content": "ありがとうございます！",
            "Chinese": "谢谢您！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:35:34",
            "content": "また、なにかありましたら、いらしてください",
            "Chinese": "如果还有什么事，欢迎随时再来。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:35:43",
            "content": "はい！",
            "Chinese": "好的！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:35:53",
            "content": "本日は、ご相談いただき、ありがとうございます",
            "Chinese": "今天非常感谢您前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2020/12/31(木) 12:35:53",
            "content": "今日はありがとうございました！",
            "Chinese": "今天真是太谢谢您了！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:36:02",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/12/31(木) 12:36:15",
            "content": "それでは、終了いたします",
            "Chinese": "那么，本次咨询就到此结束。"
        }
    ],
    "review_by_client": {
