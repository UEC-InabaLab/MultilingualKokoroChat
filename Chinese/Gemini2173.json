        {
            "role": "クライアント",
            "time": "2021/07/12(月) 12:54:15",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/12(月) 12:54:48",
            "content": "リスカをしたくなった時に、代わりにする方法は知ってますか？",
