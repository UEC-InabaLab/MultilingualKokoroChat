        },
        {
            "role": "クライアント",
            "time": "2021/07/12(月) 12:53:37",
            "content": "やめなきゃって",
            "Chinese": "会想“必须要停下来了”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/12(月) 12:54:09",
            "content": "そうなんですね。",
