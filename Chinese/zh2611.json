    },
    {
      "role": "counselor",
      "time": "2021-10-25T15:08:52",
      "origin": "そうだったのですね。",
      "content": "原来是这样啊。"
    },
    {
      "role": "client",
      "time": "2021-10-25T15:09:20",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-10-25T15:09:57",
      "origin": "では、今あまりお友達と会う機会が減っていると、それもできなくて寂しいですね",
