    },
    {
      "role": "counselor",
      "time": "2021-10-25T15:27:19",
      "origin": "そうなんですね。",
      "content": "是这样啊。"
    },
    {
      "role": "client",
      "time": "2021-10-25T15:27:47",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-10-25T15:29:13",
      "origin": "では、またそのようなサークルを探したり、ただ観劇するだけでも",
