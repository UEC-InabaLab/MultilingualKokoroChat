    },
    {
      "role": "client",
      "time": "2021-10-25T15:10:14",
      "origin": "そうですね",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2021-10-25T15:12:15",
      "origin": "先ほど友達と会えないのは、近くに仲のいい人がいない　と言われていましたが、",
