    {
      "role": "client",
      "time": "2022-02-18T11:15:49",
      "origin": "はい",
      "content": "是的。"
    },
    {
      "role": "counselor",
      "time": "2022-02-18T11:16:13",
      "origin": "候補にあがっている所とかはありますでしょうか？",
