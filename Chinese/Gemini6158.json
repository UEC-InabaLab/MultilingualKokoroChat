{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 19:52:53",
            "content": "(本日は、お時間頂きありがとうございます。時間になりましたら、始めさせて頂きます。)",
            "Chinese": "(感谢您今天抽出时间。时间到了，我们就开始吧。)"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 19:53:17",
            "content": "(宜しくお願い致します)",
            "Chinese": "(拜托您了。)"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:00:11",
            "content": "こんばんは。相談員です。はじめに、年齢・性別・相談内容をお伝え頂けますか。",
            "Chinese": "晚上好。我是咨询员。首先，能告诉我您的年龄、性别和想咨询的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:00:34",
            "content": "12歳、男、いじめられてます。",
            "Chinese": "12岁，男，我被欺负了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:01:28",
            "content": "教えてくれてありがとうございます。話せるところからで大丈夫です。どんなことが起こっていますか？",
            "Chinese": "谢谢你愿意告诉我。从你方便说的部分开始就可以。发生了些什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:01:53",
            "content": "悪口や無視される。",
            "Chinese": "被说坏话，还被无视。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:02:21",
            "content": "そうなんですね。それは辛いね。。",
            "Chinese": "是这样啊。那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:02:28",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:03:13",
            "content": "今は何年生なのかな？",
            "Chinese": "你现在上几年级呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:03:41",
            "content": "小学６年生だよ。",
            "Chinese": "小学六年级。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:04:30",
            "content": "そうなんだね。いつぐらいから、悪口や無視は始まったの？",
            "Chinese": "这样啊。被说坏话和被无视大概是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:04:55",
            "content": "６年になってから。",
            "Chinese": "上六年级以后。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:05:49",
            "content": "そっかあ。ずっと辛い事を我慢してきたんだね。",
            "Chinese": "这样啊。你一直以来都在忍受着这些痛苦的事情呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:06:04",
            "content": "うん。そう。",
            "Chinese": "嗯。是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:06:32",
            "content": "今日は勇気を持って相談に来てくれたんだね。",
            "Chinese": "今天你鼓起勇气来咨询了呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:06:49",
            "content": "うん、そうだよ。",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:07:43",
            "content": "一緒に考えていきたいと思います。",
            "Chinese": "我想和你一起想办法。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:07:58",
            "content": "うん、ありがと",
            "Chinese": "嗯，谢谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:08:43",
            "content": "あなたは、いじめられた時、どのような気持ちになるか教えてもらえるかな？",
            "Chinese": "当你被欺负的时候，会有什么样的感受呢？可以跟我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:09:04",
            "content": "寂しいし、悲しい。",
            "Chinese": "感到孤单，又很难过。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:10:13",
            "content": "ええ。そのように孤独を感じてつらいね。誰か周りで助けれくれる人はいるの？",
            "Chinese": "嗯。感到这么孤独，一定很难受吧。身边有谁能帮你吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:10:47",
            "content": "わからないけど、お母さんには心配かけたくない。",
            "Chinese": "不太清楚，不过我不想让妈妈担心。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:12:00",
            "content": "うんうん。お母さんには言えてないんだね。それについては、本当はどう思っているの？",
            "Chinese": "嗯嗯。你还没告诉妈妈呢。关于这件事，你心里其实是怎么想的？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:12:31",
            "content": "お母さんは1人だから言いたくない。",
            "Chinese": "因为妈妈是一个人，所以我不想说。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:13:58",
            "content": "そうなのね。教えてくれてありがとう。お母さんを大事に思っているんだね。学校の先生には相談できそうかな？",
            "Chinese": "这样啊。谢谢你告诉我。你很在乎妈妈呢。你觉得能和学校老师谈谈吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:14:23",
            "content": "先生は好きじゃない。",
            "Chinese": "不太喜欢老师。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:15:10",
            "content": "そうなのね。先生にはどんな気持ちがあるのか、良かったら教えてもらえるかな？",
            "Chinese": "是这样啊。方便的话，能告诉我你对老师是什么感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:15:40",
            "content": "いじめる奴らと仲がいいから。嫌い。",
            "Chinese": "因为他和欺负我的那些家伙关系很好。我讨厌他。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:17:03",
            "content": "どうしたらいい？",
            "Chinese": "我该怎么办？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:17:11",
            "content": "そうだったんだね。そんな様子だと、嫌になるのも無理もなし、相談もしたくない気持ちになるよね。",
            "Chinese": "原来是这样啊。看到那种情况，会讨厌老师也是理所当然的，也就不想和他商量了呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:17:22",
            "content": "うん。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:17:29",
            "content": "悲しい。",
            "Chinese": "好难过。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:17:55",
            "content": "うん。悲しいし、つらいね。今日は勇気を持って相談に来てくれたので、一緒にがんがえましょう。",
            "Chinese": "嗯。又难过又辛苦呢。今天你鼓起勇气来咨询了，我们一起想办法吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:18:10",
            "content": "うん。ありがと",
            "Chinese": "嗯。谢谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:19:14",
            "content": "いじめが始まったころに、何かがあったりしたのかな？",
            "Chinese": "开始被欺负的时候，发生过什么特别的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:19:32",
            "content": "クラスが変わってから。",
            "Chinese": "换班之后。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:20:21",
            "content": "なるほど。いじめてくる子たちとは、それまでどんな関係だったの？",
            "Chinese": "原来如此。在那之前，你和那些欺负你的孩子们是什么关系呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:20:47",
            "content": "最初は仲良くしてたけど。わからない。",
            "Chinese": "一开始关系还不错。我也不知道为什么会这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:22:18",
            "content": "そっかあ。特に何があったわけでもないから、よけいに寂しくなるし、くやしいね。",
            "Chinese": "这样啊。正因为没什么特别的原因，所以才更觉得孤单和委屈吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:22:35",
            "content": "うん。悔しいよー！",
            "Chinese": "嗯。好不甘心啊！"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:23:11",
            "content": "そうだよね。心が痛くなるのを感じるよ。",
            "Chinese": "是啊。我能感受到你心里的痛。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:23:32",
            "content": "お昼休みや休憩時間は、どのように過ごしてるの？",
            "Chinese": "午休和课间休息的时候，你一般是怎么过的？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:23:47",
            "content": "1人だよ。",
            "Chinese": "我一个人。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:24:15",
            "content": "絵を描いてる。",
            "Chinese": "我在画画。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:24:52",
            "content": "そっかぁ。絵を描いているとどんな気持ちなるの？",
            "Chinese": "这样啊。画画的时候是什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:25:08",
            "content": "悲しくなるよ。",
            "Chinese": "会难过。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:25:28",
            "content": "お父さんの絵を描くよ。",
            "Chinese": "我会画爸爸的画。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:26:02",
            "content": "どうしてお父さんの絵をかくのか、良かったら教えてもらえるかな？",
            "Chinese": "方便的话，能告诉我为什么画爸爸的画吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:26:26",
            "content": "お父さん。天国にいたから。",
            "Chinese": "爸爸...他在天堂。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:27:25",
            "content": "そうだったんだね。教えてくれてありがとう。お父さんの絵をかきながら、お父さんを思い出すと寂しくなるんだね。",
            "Chinese": "原来是这样啊。谢谢你告诉我。一边画着爸爸的画，一边想起爸爸，就会感到寂寞呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:27:43",
            "content": "うん。悲しい！",
            "Chinese": "嗯。好难过！"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:28:22",
            "content": "良い人は早く亡くなるの？",
            "Chinese": "好人是不是都走得早？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:29:07",
            "content": "お父さんは良い人だったんだね。",
            "Chinese": "你爸爸真是个好人啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:29:24",
            "content": "優しかった！",
            "Chinese": "他很温柔！"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:29:41",
            "content": "いつも遊んでくれたし。",
            "Chinese": "他总是陪我玩。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:29:56",
            "content": "うん。うん。そうなんだ。素敵なお父さんだったんだね。",
            "Chinese": "嗯。嗯。是啊。真是位很棒的爸爸呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:30:09",
            "content": "うん。ヒーロー！",
            "Chinese": "嗯。是我的英雄！"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:30:28",
            "content": "すごいね。",
            "Chinese": "真厉害呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:30:38",
            "content": "凄いよ！",
            "Chinese": "超厉害的！"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:31:06",
            "content": "いてくれたら。助けてくれたのに。",
            "Chinese": "如果他还在的话，他一定会帮我的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:31:25",
            "content": "うん。そうだね。お父さん、かっこいいね。あなたは、お父さんのようにヒーローになりたいと思うのかな？",
            "Chinese": "嗯。是啊。爸爸很帅气呢。你是不是也想成为像爸爸那样的英雄呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:31:51",
            "content": "僕は人に優しくしたい。",
            "Chinese": "我想对别人温柔。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:32:39",
            "content": "大人になってもイジメはあるの？",
            "Chinese": "长大了也还会有欺负人这回事吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:32:43",
            "content": "うん。それも素敵だね。ヒーローは、優しいことも大事だと思うけどどうかな？",
            "Chinese": "嗯。那也很棒呢。我觉得温柔也很重要，你觉得呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:32:51",
            "content": "大人もあるよ",
            "Chinese": "长大后也可能会有。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:33:01",
            "content": "そうか",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:33:21",
            "content": "強くならないといけないのかな。",
            "Chinese": "我必须要变强才行吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:33:42",
            "content": "あなたにとって、優しいってどんなことか、教えてもらえるかな？強いことと近いのかな？",
            "Chinese": "对你来说，“温柔”是怎样一回事呢，能告诉我吗？它和“强大”很接近吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:34:10",
            "content": "イジメられてる子がいたら。助けたい。",
            "Chinese": "如果有人被欺负，我想去帮他。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:34:44",
            "content": "同じ思い、わかるから。",
            "Chinese": "因为我懂那种感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:35:15",
            "content": "うん。うん。そうだね。気持ちがわかる事はとっても大事だと思う。",
            "Chinese": "嗯。嗯。是啊。能够理解别人的感受，我觉得非常重要。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:35:30",
            "content": "うん。ありがと",
            "Chinese": "嗯。谢谢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:35:47",
            "content": "優しいね。",
            "Chinese": "你真温柔。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:36:54",
            "content": "ありがとう。あなたは、今、すでに優しい気持ちをもっていると感じるよ。もし誰かがいじめられていたら、何て言ってあげたい？",
            "Chinese": "谢谢。我觉得你现在已经拥有一颗温柔的心了。如果有人被欺负，你想对他说些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:37:28",
            "content": "僕が守るよって。",
            "Chinese": "我会说“我来保护你”。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:38:44",
            "content": "弱いからイジメられる。",
            "Chinese": "因为弱小才会被欺负。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:38:49",
            "content": "すばらしいよ。そして強いを思うんだけど、あなたはどう思うかな。",
            "Chinese": "这很了不起。而且我觉得这也代表着一种强大，你觉得呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:39:17",
            "content": "今は弱いと感じているのかな？",
            "Chinese": "你现在觉得自己很弱小吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:39:30",
            "content": "イジメられてる。から。",
            "Chinese": "因为我正在被欺负。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:40:08",
            "content": "イジメている人の事は強いと感じる？",
            "Chinese": "你觉得欺负别人的人很强大吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:40:38",
            "content": "人とは思ってない。",
            "Chinese": "我不把他们当人看。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:41:08",
            "content": "そうなのね。どのように思っているの？",
            "Chinese": "是这样啊。那你觉得他们是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/21(木) 20:41:30",
            "content": "人間のくず。",
            "Chinese": "人渣。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/21(木) 20:41:58",
