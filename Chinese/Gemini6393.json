{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:21:26",
            "content": "（こんにちは。今日はよろしくお願いいたします。もし可能であれば若年層の相談者役をしていただけるとありがたいです。）",
            "Chinese": "（您好。今天请多指教。如果可以的话，能请您扮演一位年轻的来访者吗？非常感谢。）"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:22:14",
            "content": "（おはようございます　承知しました　よろしくお願いします）",
            "Chinese": "（早上好，明白了，请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:22:38",
            "content": "（ありがとうございます）",
            "Chinese": "（谢谢您。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:30:28",
            "content": "こんにちは、相談員です。年齢、性別、相談内容を教えていただけますか？",
            "Chinese": "您好，我是咨询员。可以告诉我您的年龄、性别和咨询内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:31:01",
            "content": "17歳　女性　進学の事",
            "Chinese": "17岁，女性，关于升学的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:31:37",
            "content": "そうなんですね。進学の事でお悩みなんですね。",
            "Chinese": "是这样啊。您正在为升学的事情烦恼，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:31:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:32:33",
            "content": "大学受験になりますか？",
            "Chinese": "是关于考大学的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:32:54",
            "content": "専門学校に行きたい",
            "Chinese": "我想去读专科学校。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:33:48",
            "content": "そうなんですね。今は高校３年生ですか？",
            "Chinese": "这样啊。您现在是高三吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:33:59",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:34:27",
            "content": "教えてくれてありがとうございます。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:35:00",
            "content": "どういった専門学校に行きたいんですか？",
            "Chinese": "您想去什么样的专科学校呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:35:19",
            "content": "服飾",
            "Chinese": "服装设计。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:36:11",
            "content": "そうなのですね。洋服に興味があるんですね。",
            "Chinese": "是这样啊。您对服装感兴趣，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:36:37",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:37:22",
            "content": "もう試験とかは受けられたんですか？",
            "Chinese": "已经参加过考试之类的吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:37:59",
            "content": "試験はなくて書類だけ",
            "Chinese": "没有考试，只需要提交材料。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:39:25",
            "content": "そうなんですね。書類を送ると4月から入学なんですか？",
            "Chinese": "是这样啊。提交材料后，4月份就可以入学了吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:39:52",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:41:10",
            "content": "そうなんですね。ご家族は進学について、どのように言っていますか？",
            "Chinese": "是这样啊。关于升学这件事，您的家人是怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:41:31",
            "content": "話していない",
            "Chinese": "还没跟他们说。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:42:20",
            "content": "そうなのですね。それには何か理由があるんですか？",
            "Chinese": "是这样啊。这其中有什么原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:42:47",
            "content": "お金がかかるから",
            "Chinese": "因为费用很高。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:44:15",
            "content": "そうだったんですね。お金の事で親に迷惑をかけたくないという事でしょうか？",
            "Chinese": "原来是这样。是不想因为钱的事给父母添麻烦，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:44:25",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:45:27",
            "content": "そうなんですね。親御さんは就職を希望している感じですか？",
            "Chinese": "是这样啊。您的父母是希望您直接就业，是这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:46:10",
            "content": "就職すると思ってる",
            "Chinese": "他们以为我会去工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:47:15",
            "content": "そうだったんですね。だから相談しづらいと思っているんですね。",
            "Chinese": "原来是这样。所以您觉得难以启齿，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:47:25",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:48:16",
            "content": "ご姉妹はいますか？",
            "Chinese": "您有姐妹吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:48:24",
            "content": "きます",
            "Chinese": "有。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:48:45",
            "content": "↑います",
            "Chinese": "↑有。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:49:43",
            "content": "お姉さんですか？妹さんですか？",
            "Chinese": "是姐姐还是妹妹呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:50:31",
            "content": "両方",
            "Chinese": "都有。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:51:37",
            "content": "そうだったんですね。お姉さんはもう働かれているのでしょうか？",
            "Chinese": "原来是这样。您的姐姐已经工作了吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:52:27",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:53:33",
            "content": "そうなんですね。お姉さんに相談されたりしているのでしょうか？",
            "Chinese": "是这样啊。您有跟姐姐商量过吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:53:57",
            "content": "してない",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:55:02",
            "content": "そうなんですね。一人で抱え込まれて悩まれているんですね。",
            "Chinese": "是这样啊。您一直一个人把烦恼闷在心里，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:55:49",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:56:31",
            "content": "そうなのですね、それはとてもしんどいですね。",
            "Chinese": "是这样啊，那一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:56:54",
            "content": "そうかな",
            "Chinese": "是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:57:38",
            "content": "今はどんなお気持ちですか？",
            "Chinese": "您现在心情怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:58:22",
            "content": "もう書類出さないと間に合わないなと思ってる",
            "Chinese": "我在想，再不提交材料就来不及了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 10:59:18",
            "content": "そうなのですね。書類の締め切りはいつまでですか？",
            "Chinese": "是这样啊。材料的截止日期是什么时候？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 10:59:48",
            "content": "月末",
            "Chinese": "月底。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:01:11",
            "content": "そうなんですね。そうすると一度親御さんと真剣に話されてみてはどうですか？",
            "Chinese": "是这样啊。那您要不要试着和父母认真地谈一谈呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:01:50",
            "content": "うん　そうする",
            "Chinese": "嗯，我会的。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:01:52",
            "content": "ありがとう",
            "Chinese": "谢谢你。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:02:57",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:03:32",
            "content": "（時間なのでクローズお願いします）",
            "Chinese": "（时间到了，请结束吧。）"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:04:17",
            "content": "（間違えました　すみません）",
            "Chinese": "（抱歉，我弄错了。）"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:04:58",
            "content": "（続けてください　失礼しました）",
            "Chinese": "（请继续，不好意思。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:05:32",
            "content": "（わかりました。ありがとうございます。）",
            "Chinese": "（明白了。谢谢您。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:06:39",
            "content": "親御さんに相談できそうですか？",
            "Chinese": "您觉得能和父母商量吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:07:37",
            "content": "お父さん、困るよね",
            "Chinese": "爸爸会为难的吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:08:19",
            "content": "そうなんですね。お父さんには話づらいのでしょうか？",
            "Chinese": "是这样啊。您觉得很难跟爸爸开口吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:09:13",
            "content": "お父さんにお金がないって言わせる事になる",
            "Chinese": "这会让我爸爸不得不说出“我们没钱”这样的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:09:59",
            "content": "そうなのですね。そのように思われているんですね。",
            "Chinese": "是这样啊。您是这么想的，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:10:43",
            "content": "そう思わないですか？",
            "Chinese": "您不这么觉得吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:12:20",
            "content": "そうですね。お父さんに迷惑をかけたくないと思っているんですね。",
            "Chinese": "是啊。您是不想给爸爸添麻烦，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:13:15",
            "content": "かけるよね？",
            "Chinese": "会添麻烦的，对吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:14:15",
            "content": "そうかもしれませんね。",
            "Chinese": "也许是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:15:27",
            "content": "あなたとしては、服飾の専門学校にどうしても行きたいんですよね。",
            "Chinese": "对您来说，您是非常想去服装设计专科学校的，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:16:02",
            "content": "行きたいけど、行けないよね",
            "Chinese": "想去是想去，但应该是去不了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:17:22",
            "content": "行きたいけど、家族に迷惑をかけたくないという気持ちの方が強いんですね。",
            "Chinese": "虽然想去，但不想给家人添麻烦的心情更强烈一些，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:17:45",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:18:38",
            "content": "あなたは、家族思いの、とても優しい方だと思います。",
            "Chinese": "我觉得您是一个很为家人着想、非常温柔的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:20:23",
            "content": "中にはアルバイトを頑張って学費にしたりしている方もいますが、あなたはそういう人たちをどう思いますか？",
            "Chinese": "有些人会努力打工来支付学费，您对这样的人怎么看？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:20:39",
            "content": "うん　あたしもしてるよ",
            "Chinese": "嗯，我也在打工啊。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:21:01",
            "content": "普通するよね",
            "Chinese": "大家一般都会打工吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:22:09",
            "content": "そうですね。アルバイトしながら、学校に通うのは大変そうですか？",
            "Chinese": "是啊。您觉得一边打工一边上学，会很辛苦吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:23:31",
            "content": "通学できる距離じゃないから、賃貸借りる事になる",
            "Chinese": "学校离家太远，没法通勤，所以得租房子住。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:24:14",
            "content": "生活費、全部出せるほどバイトするのは無理だと思う",
            "Chinese": "我觉得光靠打工赚够全部的生活费是不可能的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:25:53",
            "content": "そうですよね。アパートを借りたり生活費を全部出せるだけアルバイトで稼ぐのは難しそうですね。",
            "Chinese": "是啊。又要租公寓，又要靠打工赚够全部的生活费，这听起来确实很难呢。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:26:13",
            "content": "多分ね",
            "Chinese": "大概吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:26:47",
            "content": "服飾は課題も出るから、時間もないと思う",
            "Chinese": "而且服装设计专业作业也多，我觉得时间上也不够。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:29:00",
            "content": "そうなんですね。少しの間お金をためてから、専門学校にチャレンジするというのはどう思いますか？",
            "Chinese": "是这样啊。那先工作一段时间攒些钱，然后再去上专科学校，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:29:21",
            "content": "うん　考えてみる",
            "Chinese": "嗯，我考虑一下。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:29:56",
            "content": "ありがとう",
            "Chinese": "谢谢你。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:30:13",
            "content": "そうですね。一度ご家族ともお話されて今後のことを考えてみてくださいね。",
            "Chinese": "是的。请您和家人商量一下，再考虑一下今后的事情吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:30:36",
            "content": "大切なお話を聞かせていただきありがとうございました。今日はこれで終わりにさせていただいてよろしいでしょうか。",
            "Chinese": "非常感谢您和我分享这么重要的事情。今天的咨询到此结束可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/08(木) 11:30:55",
            "content": "はい　大丈夫です",
            "Chinese": "好的，没问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/08(木) 11:31:43",
            "content": "今日はありがとうございました。またいつでも相談に来てくださいね。これで終わりにさせていただきますね。",
            "Chinese": "今天非常感谢您。随时欢迎您再来咨询。那么，本次咨询就到此结束了。"
        }
    ],
    "review_by_client": {
