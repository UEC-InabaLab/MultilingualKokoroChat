{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 09:51:01",
            "content": "こんにちは。本日はどうもありがとうございます。どうぞよろしくお願いいたします。",
            "Chinese": "您好。非常感谢您今天前来咨询。请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 09:51:44",
            "content": "こんにちは。こちらこそよろしくお願いいたします。",
            "Chinese": "您好。也请您多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 09:52:50",
            "content": "お時間になりましたら、始めさせていただきますね。",
            "Chinese": "时间到了，我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 09:53:11",
            "content": "はい、承知いたしました。",
            "Chinese": "好的，我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:00:10",
            "content": "こんにちは。相談員です。ご相談にお越しいただいて、どうもありがとうございます。",
            "Chinese": "您好。我是咨询师。非常感谢您前来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:00:31",
            "content": "まずはじめに、よろしかったら、年齢性別をお聴きしてもよろしいでしょうか",
            "Chinese": "首先，如果方便的话，可以请教您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:00:58",
            "content": "こんにちは。14歳、女性です。",
            "Chinese": "您好。我14岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:01:18",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:01:32",
            "content": "今日は、どうされましたか。",
            "Chinese": "今天有什么想要咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:02:01",
            "content": "友達のことで悩んでいます。",
            "Chinese": "我在为朋友的事情烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:02:42",
            "content": "そうなのですね。それは、悩みますね。",
            "Chinese": "是这样啊。这确实很令人烦恼呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:02:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:02:58",
            "content": "どんなことがありましたか。",
            "Chinese": "具体发生了什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:03:56",
            "content": "なんか私にだけ冷たい態度をとってくるのです。",
            "Chinese": "总觉得她只对我一个人态度很冷淡。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:04:23",
            "content": "そうなのですね。それは、悲しいですね。",
            "Chinese": "是这样啊。那一定很难过吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:04:38",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:04:46",
            "content": "ちなみに学年は中学２年生ですか。",
            "Chinese": "顺便确认一下，您现在是初二吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:05:04",
            "content": "はい、そうです。",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:05:21",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:05:51",
            "content": "どんなときに感じられましたか。",
            "Chinese": "您在什么时候感觉到的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:06:38",
            "content": "友達に話しかけたときです。",
            "Chinese": "在我跟她搭话的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:07:12",
            "content": "なるほと・・・。それは、傷つきましたね。",
            "Chinese": "原来如此……。那一定很受伤吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:07:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:08:02",
            "content": "いつごろから、そのように感じられていますか。",
            "Chinese": "您是从什么时候开始有这种感觉的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:08:40",
            "content": "1カ月くらい前からです。",
            "Chinese": "大概一个月前开始的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:09:23",
            "content": "そうなのですね。いままで、苦しい思いをされてきましたね。",
            "Chinese": "原来如此。这段时间您一定过得很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:09:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:10:20",
            "content": "１か月前に、気になることどんなことがありましたか。",
            "Chinese": "一个月前，有没有发生什么让您在意的事情？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:10:49",
            "content": "特に何もありません。",
            "Chinese": "并没有什么特别的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:11:38",
            "content": "ええ、そうなのですね。それでは、不安に思われますね。",
            "Chinese": "嗯，原来如此。那么，您一定感到很不安吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:11:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:12:45",
            "content": "冷たい態度といわれましたが、具体的にはどんな態度が気になりますか。",
            "Chinese": "您提到态度冷淡，具体来说有哪些让您在意的表现呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:13:51",
            "content": "返事があいまいだったり、無視されたりします。",
            "Chinese": "回应很含糊，有时还会被无视。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:14:23",
            "content": "それは、悲しいですね。",
            "Chinese": "那确实让人难过。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:14:54",
            "content": "はい。どうしたらいいですか？",
            "Chinese": "是的。我该怎么办呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:16:38",
            "content": "あなたが、少しでも楽にすごせるように一緒に考えていきたいと思います。",
            "Chinese": "我想和您一起想办法，让您能轻松一些。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:16:55",
            "content": "お願いします",
            "Chinese": "拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:18:04",
            "content": "ここで、今までのお話をまとめさせていただきますね。よろしいでしょうか。",
            "Chinese": "那么，我先总结一下目前为止我们聊的内容，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:18:12",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:20:07",
            "content": "お友達のことで悩んでいるご相談。ご自身にだけ冷たい態度をとってくると思われている。とくに、話しかけたとき、冷たい態度をとられる。１か月前　からであるが、特にきっかけは思い当たらない。",
            "Chinese": "您今天的咨询是关于朋友的事情。您觉得她只对您一个人态度冷淡，特别是在您主动搭话的时候会这样。这种情况大约从一个月前开始，但您想不出有什么特别的契机。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:20:17",
            "content": "いかがでしょうか。",
            "Chinese": "这样的理解可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:20:24",
            "content": "はい、そうです。",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:20:41",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:21:18",
            "content": "気になっているお友達とは、いままでどのように過ごされてきましたか。",
            "Chinese": "这位让您在意的的朋友，之前你们一般是如何相处的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:21:46",
            "content": "普通だと思います。",
            "Chinese": "我觉得挺正常的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:23:11",
            "content": "そうなのですね。一緒に過ごされているときは、どんなおはなしとかされるのでしょうか。",
            "Chinese": "是这样啊。一起相处时，你们一般会聊些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:23:59",
            "content": "テレビの話とか音楽の話とかしました。",
            "Chinese": "会聊电视节目啊、音乐之类的话题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:24:52",
            "content": "なるほと・・。日常の会話ができるの、いいですね。",
            "Chinese": "我明白了……能进行这些日常的交流，很不错呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:25:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:25:14",
            "content": "最近は、いかがですか。",
            "Chinese": "最近情况怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:25:27",
            "content": "全然だめです",
            "Chinese": "完全不行。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:26:02",
            "content": "そうなのですね。それでは、楽しく過ごせないですね。",
            "Chinese": "是这样啊。那一定过得很不开心吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:26:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:26:32",
            "content": "周りのお友達とそのお友達は、どのような感じでしょうか。",
            "Chinese": "她和周围其他朋友的关系怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:26:53",
            "content": "普通だと思います。",
            "Chinese": "我觉得挺正常的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:27:58",
            "content": "そうなのですね。それを感じると、今のあなたとお友達の様子を思うと苦しくなりますね。",
            "Chinese": "是这样啊。看到她和别人相处正常，再想到你们现在的状况，确实会更难受呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:28:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:29:38",
            "content": "あなたが、お友達が冷たいとおもわれたとき、どのようにされていますか。",
            "Chinese": "当您觉得朋友对您冷淡时，您通常会怎么做呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:29:58",
            "content": "黙ってしまいます。",
            "Chinese": "我会沉默不语。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:30:59",
            "content": "何も言えないほど、悲しいですね。",
            "Chinese": "难过到说不出话来了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:31:37",
            "content": "悲しいというか、どうしたらいいのかわからないのです。",
            "Chinese": "与其说难过，不如说是不知道该怎么办。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:32:09",
            "content": "なるほと・・・。困ってしまっているのですね。",
            "Chinese": "原来如此……您感到很困惑呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:32:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:32:32",
            "content": "あなたにとって、そのお友達はどんな存在ですか。",
            "Chinese": "对您来说，那位朋友是怎样的存在呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:33:46",
            "content": "どんなと言われても、よくわかりません。",
            "Chinese": "要说“是怎样的存在”，我也不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:34:27",
            "content": "ごめんなさい。言葉がたりませんでしたね。",
            "Chinese": "抱歉，我的措辞不够恰当。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:37:06",
            "content": "冷たくされるたと思われるまえのお友達があなたと一緒にいるとき、あなたは、どんな気持ちになりましたか。",
            "Chinese": "在觉得她对您变冷淡之前，和她在一起时，您是什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:37:23",
            "content": "楽しかったです。",
            "Chinese": "很开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:38:01",
            "content": "それは、すてきですね。",
            "Chinese": "那很美好呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:38:28",
            "content": "でも、今は辛いです。",
            "Chinese": "但是现在很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:39:06",
            "content": "そうでうね。その時のことを思うと、お辛いでね。",
            "Chinese": "是啊。一想到那时候的情景，就更加难受了吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:39:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:41:50",
            "content": "ちなみに、そのお友達とはいつごろからお友達でいらっしゃいますか。",
            "Chinese": "顺便问一下，您和这位朋友大概从什么时候开始成为朋友的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:42:33",
            "content": "クラスが同じになってからです。",
            "Chinese": "从我们同班开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:43:03",
            "content": "では、中学２年生からですね。",
            "Chinese": "那就是从初二开始的呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:43:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:43:24",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:44:11",
            "content": "あなたは、このお友達のことをどのように思っていますか。",
            "Chinese": "您对这位朋友是怎么想的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:44:54",
            "content": "前みたいに楽しく話がしたいです。",
            "Chinese": "我想像之前那样开心地聊天。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:46:00",
            "content": "そうなのですね。楽しく過ごしたいと思われるほど、大切なお友達なのですね。",
            "Chinese": "是这样啊。您希望能愉快地相处，说明她对您来说是很重要的朋友呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:46:30",
            "content": "大切かどうかはわかりませんが。",
            "Chinese": "至于重不重要，我也说不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:47:34",
            "content": "そうなのですね。そのお友達に、自分の気持ちをお話しされたことありますか。",
            "Chinese": "我明白了。您有向这位朋友说过自己的感受吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:47:53",
            "content": "いえ、ないです。",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:48:39",
            "content": "自分の気持ちを人に話すことは、勇気がいりますよね。",
            "Chinese": "向别人表达自己的感受确实需要勇气呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:48:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/24(土) 10:51:34",
            "content": "以前のように楽しくお話しできたらと思われていることですが、そのようになったらあなたは、どのようなお気持ちになりますか。",
            "Chinese": "您希望能像以前那样开心地聊天，如果真的能做到，您觉得自己会是什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/24(土) 10:52:45",
            "content": "前みたいに楽しく話ができたら、楽しいと思いますが、無理だと思います。",
            "Chinese": "如果能像以前那样聊天，我会觉得很开心，但我觉得不太可能。"
