{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:27:19",
            "content": "こんにちは。相談員です。",
            "Chinese": "您好。我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:27:30",
            "content": "よろしくお願いします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:28:03",
            "content": "こちらこそ、よろしくお願いいたします。",
            "Chinese": "我才是，请您多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:28:17",
            "content": "はじめに、ご年齢と、性別、ご相談の中で、なんとお呼びしたらよいかをお伺いしてもよろしいでしょうか？",
            "Chinese": "首先，可以请教您的年龄、性别，以及在咨询中该如何称呼您吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:28:59",
            "content": "れいか、20代、女です。よろしくお願いします。",
            "Chinese": "我叫Reika，20多岁，女性。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:29:42",
            "content": "れいかさんですね。お教えてくださって、ありがとうございます。",
            "Chinese": "是Reika小姐啊。感谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:29:55",
            "content": "今日はどんなご相談ですか？",
            "Chinese": "今天想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:31:01",
            "content": "縁を切りたい友達があって、でもそうすると、やっと出来た友達グループとも切れちゃうので、悩んでいます。",
            "Chinese": "有一个朋友我想和她断绝关系，但如果这么做，我好不容易才交到的朋友们可能也会断了联系，所以我很烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:31:35",
            "content": "それはお困りですね",
            "Chinese": "那一定很困扰您吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:32:39",
            "content": "それはどんなお仲間なのですか？",
            "Chinese": "是怎样的一群朋友呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:33:56",
            "content": "SNSのチャットで繋がった友達グループです。",
            "Chinese": "是在社交软件的聊天群里认识的朋友。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:34:06",
            "content": "カラオケにも行きます。",
            "Chinese": "我们也会一起去唱K。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:34:39",
            "content": "そうなんですね。皆さんと出かけて楽しんだりするお仲間なのでしょうか？",
            "Chinese": "是这样啊。是会和大家一起出去玩乐的朋友们吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:35:01",
            "content": "カラオケにも行きます",
            "Chinese": "我们也会一起去唱K。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:35:52",
            "content": "小学校の時から家事を任されていて忙しくて友達を作れませんでした。",
            "Chinese": "我从小学开始就要负责做家务，很忙，所以没能交到朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:35:52",
            "content": "楽しそうですが、そのお仲間の中に、縁を切りたいと思う方がいるのですね",
            "Chinese": "听起来很开心，但在这些朋友中，有您想断绝关系的人呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:36:15",
            "content": "愚痴ばかり吐くので凄く嫌なんです。",
            "Chinese": "她总是发牢骚，我特别讨厌这一点。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:37:10",
            "content": "そうだったんですねお友達になれた時は、うれしかったのに、今はそう感じてしまうのですね",
            "Chinese": "原来是这样。刚成为朋友的时候明明很高兴，现在却有这种感觉了呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:37:18",
            "content": "他の人みたいに適当に慰めたり出来なくて。",
            "Chinese": "我做不到像别人那样敷衍地安慰她。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:38:05",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:38:28",
            "content": "その人は最近同棲する事になって、それで時間が無くなったとか、忙しいとか、大変だとか、",
            "Chinese": "那个人最近开始同居了，然后就总说没时间、很忙、很辛苦之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:38:48",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:39:32",
            "content": "前はみんなで楽しい話してたのに、1人だけぐちぐちと、",
            "Chinese": "以前大家都在聊开心的话题，只有她一个人不停地抱怨。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:40:20",
            "content": "不幸の自慢くらべは最低だと思うから、もう、縁を切りたいな、この人！て思います。",
            "Chinese": "我觉得比惨是最差劲的行为了，所以就想，这个人，我真想和她断绝关系！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:40:49",
            "content": "そうですよね楽しい話ならいいけど、ぐちは聞いているのも嫌になってしまいますよね",
            "Chinese": "是啊，聊开心的话题还好，但抱怨的话听着听着也会觉得烦的吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:40:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:41:29",
            "content": "れいかさんだって、",
            "Chinese": "就连Reika小姐您，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:42:50",
            "content": "おうちのことでも、大変なこともあったでしょうに、楽しくふるまっておられることもありますよね。",
            "Chinese": "家里也有很多辛苦的事，但您不也表现得很开朗吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:43:35",
            "content": "今も祖母の介護に実家に通っているし、家事も全部やっています。",
            "Chinese": "现在也还在来回老家照顾祖母，家务也全都是我来做。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:44:32",
            "content": "でも、そんな事は言いません。",
            "Chinese": "不过，这些我都不说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:44:47",
            "content": "そうだったんですね。おうちのこと、しっかりと向き合ってられるんですね。それでも、",
            "Chinese": "是这样啊。您很认真地在处理家里的事情呢。即便如此，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:45:28",
            "content": "ぐちなんかこぼさずに、一生懸命されていて、頭が下がります。",
            "Chinese": "您也一句怨言都没有，非常努力，真令人敬佩。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:45:56",
            "content": "独り言は言いますけど",
            "Chinese": "我会自言自语就是了。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:46:36",
            "content": "やる事が条件で一人暮らしができたし。",
            "Chinese": "（照顾家里）是我能够一个人住的条件。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:46:37",
            "content": "それくらい、時には、言っちゃうことあっても、頑張ってるんですもの",
            "Chinese": "没关系，您那么努力，偶尔说说也是应该的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:46:51",
            "content": "そうなんですね！",
            "Chinese": "原来如此！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:47:33",
            "content": "ご家族のご理解や",
            "Chinese": "是得到了家人的理解和"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:47:50",
            "content": "協力もあるのですね",
            "Chinese": "帮助吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:48:56",
            "content": "母は私が小学校の時に、突然家事をやらなくなって、それで私がやってきました。",
            "Chinese": "我上小学的时候，妈妈突然就不做家务了，从那以后就一直是我在做。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:49:13",
            "content": "だから友達を作る時間は無かったんです。",
            "Chinese": "所以我没有时间交朋友。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:49:47",
            "content": "祖母が育ててくれたから、祖母の面倒を見るのは当たり前だと言われます。",
            "Chinese": "他们说因为是祖母把我养大的，所以照顾祖母是理所当然的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:49:47",
            "content": "それは、さぞ、大変で、さみしい思いもされましたね",
            "Chinese": "那一定非常辛苦，也让您感到很孤单吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:50:19",
            "content": "大変でした",
            "Chinese": "确实很辛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:51:00",
            "content": "どなたからそう言われるのですか？",
            "Chinese": "是谁对您这么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:51:22",
            "content": "母親",
            "Chinese": "我妈妈。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:51:34",
            "content": "そんな・・・",
            "Chinese": "怎么会……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:51:54",
            "content": "お母さまは",
            "Chinese": "您的母亲……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:52:14",
            "content": "私もあたりまえかなと思います。",
            "Chinese": "我也觉得也许这是理所当然的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:53:12",
            "content": "お母さまが家事をやれなくなったから、自分が協力しなきゃと受け止められたのですね",
            "Chinese": "因为母亲不能做家务了，所以您就觉得必须由自己来帮忙，是这样接受的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:53:26",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:53:58",
            "content": "協力じゃなく全部",
            "Chinese": "不是帮忙，是全部。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:54:18",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:54:55",
            "content": "全部！？！！！",
            "Chinese": "全部！？！！！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:55:30",
            "content": "れいかさんはお勤めされているのですか？",
            "Chinese": "Reika小姐您有在工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:55:52",
            "content": "していません",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:56:32",
            "content": "普段はおひとり暮らしで、どうされているのですか？ご自分のこともおありでしょうに！",
            "Chinese": "您平时一个人住，是怎么安排的呢？您应该也有自己的事情要忙吧！"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:56:32",
            "content": "祖母が認知症になったので",
            "Chinese": "因为祖母得了认知症，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:57:07",
            "content": "それは、本当に大変ですよね",
            "Chinese": "那真的非常辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:57:19",
            "content": "実家のことをやって、自分の部屋に戻ります。そしてチャット(^^)",
            "Chinese": "做完老家的事，就回到自己的房间。然后就聊聊天(^^)。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:57:44",
            "content": "そうなんですね",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:58:12",
            "content": "ご実家で家事や介護をされて、しんどい中にも",
            "Chinese": "您在老家做家务和照护，虽然很辛苦，但……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 13:59:00",
            "content": "ひとりになると、チャットで楽しまれているのですね",
            "Chinese": "但一个人的时候，会通过聊天来放松呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 13:59:53",
            "content": "たまに近めの人とはカラオケも出来て楽しいです。",
            "Chinese": "偶尔和住得近的朋友一起唱K，很开心。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:00:18",
            "content": "はじめてのグループ",
            "Chinese": "这是我第一个朋友群。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:00:24",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:00:59",
            "content": "友達って楽しいなとわかりました。",
            "Chinese": "我明白了，原来有朋友是很快乐的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:01:51",
            "content": "それはよかったですね。楽しい時間を過ごせる友達っていいですよね",
            "Chinese": "那真是太好了。能一起度过快乐时光的朋友真的很棒呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:03:20",
            "content": "どうせなら、友達とは、",
            "Chinese": "既然如此，和朋友相处，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:03:58",
            "content": "楽しく付き合っていく方がいいですよね。頑張る力にもなりますもんね",
            "Chinese": "还是愉快地相处更好，对吧？也会成为努力的动力呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:04:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:04:49",
            "content": "ここで少し、お話を整理させていただきますね",
            "Chinese": "那我们在这里稍微整理一下您说的情况。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:04:55",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:06:26",
            "content": "れいかさんは、お母さんの代わりに、ご実家の家事や、おばあさまの介護に追われる日々",
            "Chinese": "Reika小姐您，代替母亲，每天忙于老家的家务和照顾祖母。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:06:38",
            "content": "そんな中でも、",
            "Chinese": "即便在这样的情况下，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:07:26",
            "content": "やっとつながれたお友達と、これからも楽しく付き合っていきたい",
            "Chinese": "仍希望今后也能和好不容易结识的朋友们愉快地交往。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:08:04",
            "content": "ご実家のことを全部引き受けているのは、大変なことだけど、",
            "Chinese": "把老家的事情全都承担下来确实很辛苦，不过，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:08:28",
            "content": "ご自分のすべきことにしっかり向き合っておられると思います",
            "Chinese": "我觉得您一直在认真面对自己应该做的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:09:00",
            "content": "小さいころから、お友達と遊びたかったけど、",
            "Chinese": "从小时候起，虽然想和朋友们一起玩，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:09:24",
            "content": "なかなか叶えられなかったのですよね？",
            "Chinese": "却一直没能实现，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:09:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:10:03",
            "content": "あなたは本当に頑張ってきました。",
            "Chinese": "您真的一直很努力。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:11:00",
            "content": "同年代の子たちと一緒に遊びたかったですよね",
            "Chinese": "您一定很想和同龄的孩子们一起玩吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:11:13",
            "content": "はい、楽しく",
            "Chinese": "是的，开心地玩。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:11:26",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:12:13",
            "content": "だからこそ、これからの仲間との付き合いを楽しいものにしていきたい",
            "Chinese": "正因为如此，才更希望今后和朋友们的交往能是快乐的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:13:08",
            "content": "空気を乱さず、仲良くしたいと思っておられるように思いますが",
            "Chinese": "我感觉您是希望不破坏气氛，和大家好好相处，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:13:17",
            "content": "いかがですか？",
            "Chinese": "您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:14:51",
            "content": "その空気をひどく乱している人とだけ、縁を切りたいと思うが、どうしたら良いのかと悩んでいます。",
            "Chinese": "我只想和那个严重破坏气氛的人断绝关系，但不知道该怎么办才好，很烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:15:04",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:15:40",
            "content": "少しお話を聞かせてくださいね",
            "Chinese": "请和我说说具体情况吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:15:54",
            "content": "その方と",
            "Chinese": "和那位……"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:16:04",
            "content": "楽しそうですが、そのお仲間の中に、縁を切りたいと思う方がいるのですねって、言ってくれましたよね？",
            "Chinese": "您刚才是不是说过“听起来很开心，但在这些朋友中，有一位是您想断绝关系的，对吗？”"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:16:29",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:17:04",
            "content": "このことは、",
            "Chinese": "这件事，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:17:40",
            "content": "お仲間の中に、共有している方はいらっしゃいますか？",
            "Chinese": "朋友群里有其他人知道吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:17:47",
            "content": "いません",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:18:11",
            "content": "そうなんですね。少し質問をさせてくださいね",
            "Chinese": "是这样啊。请允许我问几个问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:19:30",
            "content": "その方のぐちは、れいかさんだけに向けられてくるものなのでしょうか？",
            "Chinese": "那个人的抱怨，是只针对Reika小姐您一个人吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:19:46",
            "content": "グループチャットの中です",
            "Chinese": "是在群聊里。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:20:53",
            "content": "そうなんですね。ぐちが出た時には、どんな方が答えているのでしょうか？",
            "Chinese": "是这样啊。当她抱怨的时候，通常是哪些人回应呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:21:14",
            "content": "ほかのメンバーです",
            "Chinese": "其他成员。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:21:43",
            "content": "そうなんですね。れいかさんは、その時どうされているのですか？",
            "Chinese": "是这样啊。那Reika小姐您那时候是怎么做的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:22:24",
            "content": "防寒ですが、それでは雰囲気が悪くなるかなぁと思います",
            "Chinese": "我一般会选择旁观，但又担心那样会让气氛变差。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:22:33",
            "content": "でも、共感できなくて",
            "Chinese": "但是，我无法产生共鸣。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:22:47",
            "content": "私、がおかしいですか？",
            "Chinese": "是我有问题吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:23:00",
            "content": "傍観の間違い",
            "Chinese": "是“旁观”打错了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:23:21",
            "content": "そんなことはないと思いますよ（大丈夫ですよ）",
            "Chinese": "我觉得完全没有这回事哦（没关系的）。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:23:56",
            "content": "どうしたらいいですか？",
            "Chinese": "我该怎么办呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:24:49",
            "content": "本当に、たのしくしたいですよね！一緒に考えていきましょうね",
            "Chinese": "您真的很想开心地和大家相处，对吧！我们一起来想办法吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:25:01",
            "content": "はいよろしくお願いします。",
            "Chinese": "好的，拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:25:44",
            "content": "ぐちは、何もみんなの前で発信することはないって思いますよね。",
            "Chinese": "您会觉得，抱怨这种事，没必要在大家面前说出来吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:25:52",
            "content": "それに",
            "Chinese": "而且，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:26:17",
            "content": "なぐさめたりするのも、どうかと思ってしまう。",
            "Chinese": "也会觉得去安慰她似乎不太合适。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:27:10",
            "content": "なんだか、同調する気にもなれないですよね。",
            "Chinese": "总觉得，也提不起劲去附和她呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:27:20",
            "content": "そんなもん大変じゃ無いでしょって思います。",
            "Chinese": "我会觉得“那种事根本不算辛苦吧”。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:28:26",
            "content": "そうですよね！私は、もっと大変でも頑張っている人がここにいるのに！！って思います。",
            "Chinese": "是啊！我也会想，这里明明有更辛苦却依然在努力的人啊！！"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:28:42",
            "content": "れいかさんは",
            "Chinese": "Reika小姐您，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:30:21",
            "content": "ご家族やお友達を大切にされてきた中で、お友達の大切さ、ありがたさを知っているからこそ、そう思われるのだと思います。",
            "Chinese": "正因为您一直珍视家人和朋友，深知朋友的重要和可贵，才会这样想。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:31:13",
            "content": "そんな周りのことに心配りができるあなたに、お伝えしたいことがあります。",
            "Chinese": "对于如此体贴周围人的您，我有些话想告诉您。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:31:21",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:31:51",
            "content": "お伝えしたいところではありますが、、、、",
            "Chinese": "虽然我很想告诉您……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:32:26",
            "content": "お時間のご都合もありますが、",
            "Chinese": "但考虑到时间关系，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:33:47",
            "content": "いったん、ここで、一区切りとさせていただいて、次回にまた、続きをお願いしたいと存じます。",
            "Chinese": "我想我们今天就先到这里告一段落，下次再继续谈，可以吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:34:02",
            "content": "このお話は",
            "Chinese": "这个话题，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:34:30",
            "content": "担当が変わりましても、継続してご相談いただくことができます。",
            "Chinese": "即使更换咨询师，您也可以继续咨询。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:34:43",
            "content": "今日はここで、お終いになるんですか？(shocked)",
            "Chinese": "今天就到这里结束了吗？(震惊)"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:36:46",
            "content": "中途で申し訳ございません。",
            "Chinese": "在咨询中途结束，非常抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:36:55",
            "content": "わかりました",
            "Chinese": "我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:37:19",
            "content": "ありがとうございました",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:37:59",
            "content": "人とのつながりを大切にされるれいかさん、きっと、楽しいつながりを続けていかれることをお祈りしております。",
            "Chinese": "珍惜人际关系的Reika小姐，我祈祷您一定能继续维持愉快的交往。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:38:39",
            "content": "お越しくださって、ありがとうございました。またのお越しをお待ちしております。",
            "Chinese": "感谢您的到来。期待您的下次光临。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:38:56",
            "content": "さようなら",
            "Chinese": "再见。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:39:29",
            "content": "それでは、失礼いたします。",
            "Chinese": "那么，我先告辞了。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:39:46",
            "content": "（お疲れ様でした）",
            "Chinese": "（您辛苦了）"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:39:48",
            "content": "、時間切れで、失礼いたしました。",
            "Chinese": "，因为时间到了，非常抱歉。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:40:03",
            "content": "すみませんでした",
            "Chinese": "非常抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:40:29",
            "content": "（また、よろしくお願いします）",
            "Chinese": "（下次也请多关照）"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:40:40",
            "content": "大変勉強になりました。ありがとうございました。",
            "Chinese": "非常感谢，我受益匪浅。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:41:06",
            "content": "こちらこそよろしくお願いいたします。",
            "Chinese": "我才是，请您多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/11/13(金) 14:41:15",
            "content": "（終了して下さい）",
            "Chinese": "（请结束吧）"
        },
        {
            "role": "カウンセラー",
            "time": "2020/11/13(金) 14:41:23",
            "content": "それでは、失礼いたしますね",
            "Chinese": "那么，我先告辞了。"
        }
