        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:43:52",
            "content": "そうなんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:44:25",
