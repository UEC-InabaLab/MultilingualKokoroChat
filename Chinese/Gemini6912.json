{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 20:53:43",
            "content": "（こんばんは、本日はよろしくお願いいたします。）",
            "Chinese": "（晚上好，今天请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 20:58:48",
            "content": "(よろしくお願いします)",
            "Chinese": "（请多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:00:04",
            "content": "こんばんは、相談員です。よろしくお願いします。はじめに年齢、性別、相談内容を教えてください。",
            "Chinese": "晚上好，我是咨询员。请多关照。首先，请告诉我您的年龄、性别和咨询内容。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:01:33",
            "content": "話しやすいところからで、大丈夫ですよ。",
            "Chinese": "您可以从容易说的地方开始，没关系的。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:01:58",
            "content": "はい…",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:03:02",
            "content": "家が怖いんです",
            "Chinese": "我觉得家里很可怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:03:36",
            "content": "そうなんですね、、、家が怖い、、何があったのでしょうか？",
            "Chinese": "是这样啊……觉得家里很可怕……是发生了什么事吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:04:40",
            "content": "今、とてもお辛い気持ちですか？",
            "Chinese": "您现在感到非常痛苦吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:04:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:05:38",
            "content": "そうなんですね。今、どこからお話ししてくれていますか？",
            "Chinese": "是这样啊。您现在是在哪里和我聊天的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:05:56",
            "content": "公園にいます",
            "Chinese": "我在公园里。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:06:28",
            "content": "公園、、、暑かったり寒かったりしていないですか？",
            "Chinese": "在公园啊……会不会太热或者太冷？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:06:45",
            "content": "大丈夫です",
            "Chinese": "没事的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:07:02",
            "content": "そうなんですね、少し安心しました。",
            "Chinese": "这样啊，我稍微放心一些了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:07:18",
            "content": "もし、喉が渇いたりしたら、",
            "Chinese": "如果您口渴了的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:07:34",
            "content": "飲み物など飲んでくださいね。",
            "Chinese": "请记得喝点饮料之类的哦。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:08:00",
            "content": "はい　水道もトイレもあるから、大丈夫です",
            "Chinese": "好的，这里有自来水和厕所，没问题的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:08:28",
            "content": "はい、よかったです。体調はいかがですか？",
            "Chinese": "好的，太好了。您的身体状况如何？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:08:52",
            "content": "大丈夫です",
            "Chinese": "没问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:09:16",
            "content": "教えてくれてありがとうございます。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:10:13",
            "content": "怖いというのは、泥棒と遭遇などしたのでしょうか？",
            "Chinese": "您说的害怕，是指遇到小偷之类的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:10:45",
            "content": "兄が怖いんです",
            "Chinese": "我很怕我哥哥。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:11:26",
            "content": "そうだったんですね。ちなみにあなたの年齢を教えてくれますか？",
            "Chinese": "原来是这样。顺便问一下，能告诉我您的年龄吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:11:43",
            "content": "13",
            "Chinese": "13岁。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:12:07",
            "content": "中学校１年生ですか？",
            "Chinese": "是初中一年级吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:12:19",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:12:32",
            "content": "教えてくれてありがとう。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:12:46",
            "content": "ちなみに男性？",
            "Chinese": "顺便问一下，是男生吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:12:56",
            "content": "女です",
            "Chinese": "是女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:13:32",
            "content": "お返事ありがとう。お兄さんに何かされたの？",
            "Chinese": "谢谢您的回答。您哥哥对您做了什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:13:41",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:13:55",
            "content": "そうだったんだね。怖かったね。",
            "Chinese": "原来是这样啊。你一定很害怕吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:14:06",
            "content": "叩かれたのかな？",
            "Chinese": "是被打了吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:14:07",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:14:16",
            "content": "触ってくる",
            "Chinese": "他会摸我。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:14:46",
            "content": "そうだったのね、、、いつからそんなふうにされてるの？",
            "Chinese": "是这样啊……从什么时候开始被这样对待的？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:15:03",
            "content": "小学生の頃から",
            "Chinese": "从小学的时候就开始了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:15:23",
            "content": "そんなに前から、、、。辛かったね。",
            "Chinese": "这么久了啊... 你一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:15:35",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:16:05",
            "content": "お兄さんは、実のお兄さん？",
            "Chinese": "您哥哥是亲哥哥吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:16:13",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:16:31",
            "content": "そうなんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:16:41",
            "content": "お兄さんは、何歳？",
            "Chinese": "您哥哥多大？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:16:52",
            "content": "二つ上",
            "Chinese": "大我两岁。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:17:10",
            "content": "中学３年生なのかな。",
            "Chinese": "那就是初中三年级了吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:17:20",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:17:59",
            "content": "そっか、、、。ちなみに家族構成を教えてくれるかな。",
            "Chinese": "这样啊……能告诉我您的家庭成员都有谁吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:18:25",
            "content": "両親と兄と弟",
            "Chinese": "父母、哥哥和弟弟。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:18:43",
            "content": "教えてくれて、ありがとう。",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:19:14",
            "content": "このことは、親御さんには伝えられてるのかな？",
            "Chinese": "这件事，有告诉爸爸妈妈吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:19:28",
            "content": "言えない",
            "Chinese": "说不出口。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:20:05",
            "content": "そっか、、、そうだよね。恥ずかしい？それとも、怒られると思うからかな？",
            "Chinese": "这样啊……也是。是觉得难为情？还是担心会被责怪呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:20:33",
            "content": "言いたくないから",
            "Chinese": "就是不想说。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:21:24",
            "content": "そうなんだね、言いたくないんでね。それは、どうしてかお話しできるかな。",
            "Chinese": "是这样啊，不想说。能告诉我为什么吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:22:46",
            "content": "信じてもらえなさそう？",
            "Chinese": "是觉得他们不会相信吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:22:55",
            "content": "がっかりされたくない",
            "Chinese": "不想让他们失望。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:23:11",
            "content": "がっかり、、？",
            "Chinese": "失望……？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:23:59",
            "content": "いいことじゃないでしょう",
            "Chinese": "这不是什么好事吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:24:26",
            "content": "そうなんだね、、、。一人で胸を痛めていたんだね。",
            "Chinese": "是这样啊... 你一直一个人默默地承受着痛苦呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:24:55",
            "content": "でもね、あなたが我慢することじゃないんだよ。",
            "Chinese": "但是啊，这不是你应该忍受的事情。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:25:24",
            "content": "なんで？",
            "Chinese": "为什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:26:18",
            "content": "あなたが、傷つくことは絶対、何があってもあってはいけないことだから。",
            "Chinese": "因为无论发生什么，都绝对不应该让你受到伤害。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:26:59",
            "content": "ちなみに、お兄さんに暴力はされてない？",
            "Chinese": "顺便问一下，哥哥有没有对你使用暴力？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:27:12",
            "content": "叩かれたり、していない？",
            "Chinese": "比如打你之类的，没有吧？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:27:36",
            "content": "叩かれないよ",
            "Chinese": "没有打我。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:27:48",
            "content": "そうなんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:27:59",
            "content": "触られるだけなのかな？",
            "Chinese": "只是被摸吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:28:31",
            "content": "もっと嫌なことをされていないか、相談員は心配です。",
            "Chinese": "我很担心你有没有被做了更过分的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:29:15",
            "content": "ごめんね、、、、辛いよね。",
            "Chinese": "抱歉啊……这一定很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:29:54",
            "content": "誰かに、相談してみようと思ったことはあるかな？",
            "Chinese": "你有没有想过要和谁谈谈这件事呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:30:12",
            "content": "ない",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:30:38",
            "content": "そうだったんだね、一人で抱えて耐えてきたんだね。",
            "Chinese": "是这样啊，你一直一个人扛着、忍耐着。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:31:22",
            "content": "辛いよね。でも、もうこういうの嫌だよね。",
            "Chinese": "很难受吧。但是，你已经不想再这样下去了，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:31:43",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:31:52",
            "content": "そうだよね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:32:40",
            "content": "どうなったら、あなたが楽になれるか一緒に考えさせてね。",
            "Chinese": "让我们一起想想，怎样做能让你轻松一些，好吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:32:53",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:33:00",
            "content": "ありがとう。",
            "Chinese": "谢谢你。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:33:56",
            "content": "あなたの悩みは大人の助けが必要なお悩みです。。",
            "Chinese": "你的烦恼是需要大人帮助的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:34:29",
            "content": "どうかな、、、伝えられそうな人いるかな。",
            "Chinese": "你觉得……有可以倾诉的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:34:44",
            "content": "いないかな",
            "Chinese": "应该没有吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:34:55",
            "content": "そっか、、、。",
            "Chinese": "这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:35:05",
            "content": "例えばなんだけど、",
            "Chinese": "比如说，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:35:36",
            "content": "保健室の先生とか、スクールカウンセラーさんとかはどうかな？",
            "Chinese": "保健室的老师，或者学校的心理咨询师怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:36:57",
            "content": "保健の先生は学校にいるから話しづらいカウンセラーの人は、たまにしか来ないから、どうやって話せばいいのかわからない",
            "Chinese": "保健室的老师总是在学校，不太好开口。心理咨询师又不常来，我不知道该怎么跟她开口。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:37:18",
            "content": "そうなんだね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:37:46",
            "content": "カウンセラーさんには、",
            "Chinese": "要找心理咨询师的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:38:40",
            "content": "先生に伝えて、予約が必要になるから、、、。タイムラグがあるの。",
            "Chinese": "需要通过老师预约才行……这中间会有时间差。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:39:22",
            "content": "できそう？",
            "Chinese": "你觉得能做到吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:39:24",
            "content": "そうなんだ",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:39:39",
            "content": "先生に理由聞かれたくない",
            "Chinese": "不想被老师问原因。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:40:07",
            "content": "そうだよね。バレたくないよね。",
            "Chinese": "说的也是。不想被别人发现呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:40:36",
            "content": "もし、できたら、",
            "Chinese": "如果可以的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:41:49",
            "content": "交番のお巡りさんに伝えることはできそう？",
            "Chinese": "能去告诉派出所的警察叔叔吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/05/23(木) 21:42:23",
            "content": "なんで？",
            "Chinese": "为什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/05/23(木) 21:43:12",
            "content": "また、お兄さんに嫌なことをされた時にそこへ逃げてほしいから。",
            "Chinese": "因为我希望当哥哥再对你做讨厌的事情时，你能逃到那里去。"
