{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 18:51:23",
            "content": "こんばんは。今日は宜しくお願いします。",
            "Chinese": "晚上好。今天请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:00:34",
            "content": "こんばんは。相談員です。本日は相談に来てくださり、ありがとうございます。",
            "Chinese": "晚上好。我是咨询员。非常感谢您今天前来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:08:21",
            "content": "今お話しにくい状況でしょうか?",
            "Chinese": "您现在说话方便吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:10:54",
            "content": "こんばんは、すいません、Wi-Fiが不安定で",
            "Chinese": "晚上好，不好意思，Wi-Fi不太稳定。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:11:06",
            "content": "今繋がりました。よろしくお願いします",
            "Chinese": "现在连接上了。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:11:12",
            "content": "大丈夫ですよ。",
            "Chinese": "没关系的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:11:24",
            "content": "宜しくお願いします。",
            "Chinese": "也请您多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:11:31",
            "content": "最初に",
            "Chinese": "首先，"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:11:35",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:11:46",
            "content": "性別と年代を教えていただけますか?",
            "Chinese": "可以告诉我您的性别和年龄段吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:12:17",
            "content": "女性、63才です",
            "Chinese": "女性，63岁。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:12:28",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:12:40",
            "content": "今日はどのようなご相談ですか?",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:13:50",
            "content": "定年後、再雇用ではたらいているのですが、コロナで雇用が不安になってきて",
            "Chinese": "我退休后被返聘继续工作，但因为疫情，开始担心自己的工作不保。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:14:13",
            "content": "そうなんですね。それは心配ですね。",
            "Chinese": "是这样啊。那确实让人担心呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:14:17",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:14:34",
            "content": "詳しくお聞かせいただけますか?",
            "Chinese": "您能详细说一下吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:14:51",
            "content": "再雇用されてどれくらいですか?",
            "Chinese": "您被返聘多久了？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:15:08",
            "content": "3年です",
            "Chinese": "3年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:15:45",
            "content": "なるほど。60歳で定年後ということですね。",
            "Chinese": "原来如此。也就是在60岁退休之后，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:15:51",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:16:43",
            "content": "再雇用後はどのようにお勤めなんですか?",
            "Chinese": "返聘之后的工作情况怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:17:23",
            "content": "しかもこの頃リモートワークであまり得意でないPCを使う在宅が多くて",
            "Chinese": "而且最近经常需要在家使用不擅长的电脑进行远程办公。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:18:19",
            "content": "そうなんですね。雇用が不安定な上に、苦手なリモートワークでは心身ともに疲れますよね。",
            "Chinese": "原来是这样。工作不稳定的同时，还要进行不擅长的远程办公，身心都会很疲惫吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:18:32",
            "content": "やり方がわからないことが多いので、上司に聞いてやっとやってる感じで",
            "Chinese": "因为经常有不懂的地方，所以都是问了上司才勉强完成的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:18:44",
            "content": "ええ",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:19:24",
            "content": "一年更新の雇用なので",
            "Chinese": "因为我的雇佣合同是一年一续的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:19:32",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:20:02",
            "content": "もう、使えないって思われていると思います",
            "Chinese": "我想他们肯定觉得我派不上用场了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:20:27",
            "content": "そんな風に感じておられるんですね。それは不安ですね。",
            "Chinese": "您是这么感觉的啊。这确实会让人不安。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:20:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:20:41",
            "content": "更新時期はいつですか?",
            "Chinese": "合同什么时候续签呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:20:57",
            "content": "3月までです",
            "Chinese": "到3月份。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:21:47",
            "content": "後、二か月ですね。",
            "Chinese": "也就是说还有两个月呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:21:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:22:11",
            "content": "期日が近くなると、居てもたってもいられなくなりますね。",
            "Chinese": "日子越近，就越是坐立不安吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:22:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:23:10",
            "content": "コロナで今までと状況が違うかもしれませんが、通常はどのように更新の話があるのですか?",
            "Chinese": "虽然因为疫情情况可能和以往不同，但通常续签是怎么谈的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:23:54",
            "content": "2月20日までに契約延長します",
            "Chinese": "会在2月20日之前决定是否续签合同。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:24:06",
            "content": "来週から面談です",
            "Chinese": "下周开始就要面谈了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:24:30",
            "content": "そうですか。来週に迫っているんですね。",
            "Chinese": "是吗？那下周就近在眼前了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:24:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:24:53",
            "content": "ますます不安でいっぱいになりますね。",
            "Chinese": "那就更让人充满不安了。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:24:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:25:24",
            "content": "ちなみに、定年まではどのくらいお勤めだったんですか?",
            "Chinese": "顺便问一下，您到退休前工作了多久呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:25:47",
            "content": "35年です",
            "Chinese": "35年。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:26:30",
            "content": "35年ですか…それは凄いですね。",
            "Chinese": "35年啊……真了不起呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:27:30",
            "content": "そうですか",
            "Chinese": "是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:27:32",
            "content": "そんなに長い間継続して一つのお仕事を続けられるのは、できることではありませんよ。",
            "Chinese": "能在同一个岗位上坚持工作这么长时间，不是谁都能做到的。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:28:07",
            "content": "周りもみんなそうでしたから",
            "Chinese": "因为周围的人也都是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:28:30",
            "content": "そんな風に思われるんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:28:53",
            "content": "差し支えなければ、どのようなお仕事か教えていただけますか?",
            "Chinese": "如果方便的话，能告诉我您是做什么工作的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:29:05",
            "content": "事務です",
            "Chinese": "是做文职工作的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:29:21",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:29:37",
            "content": "どれくらいの規模の職場なんですか?",
            "Chinese": "您的工作单位规模有多大呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:30:21",
            "content": "私の所属は400にんくらいです",
            "Chinese": "我所在的部门大约有400人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:30:38",
            "content": "大規模ですね。",
            "Chinese": "规模很大呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:31:06",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:31:24",
            "content": "ご家族構成はどのようですか?",
            "Chinese": "您的家庭成员构成是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:31:37",
            "content": "一人です",
            "Chinese": "我一个人住。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:32:01",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:32:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:33:12",
            "content": "あなた自身は、35年そのお仕事をどのような思いでやってこられたのですか?",
            "Chinese": "您本人在这35年里，是抱着怎样的心情来做这份工作的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:33:30",
            "content": "思い",
            "Chinese": "“心情”？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:33:35",
            "content": "ですか",
            "Chinese": "是吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:33:52",
            "content": "ええ。一言で35年と言っても",
            "Chinese": "嗯。虽说用一句话概括是35年，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:34:13",
            "content": "色々なことがおありになったのではないかと思います。",
            "Chinese": "但我想您一定也经历了很多事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:34:45",
            "content": "なかなかできることではないと私は思います。",
            "Chinese": "我认为这真的不是一件容易的事。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:35:03",
            "content": "まぁ、正確に間違いなくやるって感じです",
            "Chinese": "嗯，就是感觉要准确无误地完成工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:35:46",
            "content": "そうなんですね。仕事をなさる上で、「正確さ」を大切にされてきたんですね。",
            "Chinese": "原来如此。您在工作中一直很重视“准确性”呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:35:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:36:07",
            "content": "大事なことですよね。",
            "Chinese": "这是很重要的呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:36:42",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:37:01",
            "content": "定年になった時は、どのような気持ちでしたか?",
            "Chinese": "您退休的时候，是怎样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:37:49",
            "content": "肩の荷が降りた感じでした",
            "Chinese": "感觉如释重负。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:38:46",
            "content": "そうでしたか。今まで、気を張り詰めてこられたから、ほっとされましたね。",
            "Chinese": "是吗？因为一直以来都神经紧绷，所以终于松了一口气吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:39:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:39:48",
            "content": "再雇用後の仕事の内容は、今までと変わりがありましたか?",
            "Chinese": "返聘之后的工作内容和以前有变化吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:41:09",
            "content": "同じです",
            "Chinese": "一样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:41:28",
            "content": "同じ内容のお仕事なんですね。",
            "Chinese": "工作内容是一样的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:41:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:41:56",
            "content": "仕事への取り組み方は変わりましたか?",
            "Chinese": "对待工作的方式有变化吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:42:47",
            "content": "いえ、とくには",
            "Chinese": "没有，没什么特别的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:43:23",
            "content": "そうなんですね。では定年までと同様に",
            "Chinese": "这样啊。那么就和退休前一样，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:43:55",
            "content": "正確に、間違えないように誠実に取り組まれてきたんですね。",
            "Chinese": "您一直都认真负责，力求准确无误地完成工作呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:44:07",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:44:39",
            "content": "今までのお話を少しまとめても宜しいですか?",
            "Chinese": "我可以稍微总结一下刚才的谈话内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:44:48",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:44:58",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:47:03",
            "content": "あなたは35年、正確に間違いのないように心がけながらな一つのお仕事に打ち込まれて、定年を迎えられ、その後も再雇用で今までと変わらない姿勢で、同じ仕事に就いておられる。",
            "Chinese": "您35年来，一直专心于一份工作，时刻注意做到准确无误，迎来了退休，之后又被返聘，以和从前一样的态度，继续从事同样的工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/02/05(金) 19:48:17",
            "content": "コロナの中、雇用が不安定になり、苦手なリモートワークも入ってきて、上司に教えてもらいながらこなしている。",
            "Chinese": "在疫情中，您的工作变得不稳定，还加入了您不擅长的远程办公，您一边向上司请教一边完成工作。"
        },
        {
            "role": "クライアント",
            "time": "2021/02/05(金) 19:48:29",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
