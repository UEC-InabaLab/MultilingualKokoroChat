{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 18:54:40",
            "content": "こんばんは本日はよろしくお願いします",
            "Chinese": "晚上好，今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 18:56:38",
            "content": "こんばんは、よろしくお願いします",
            "Chinese": "晚上好，请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 18:57:51",
            "content": "お時間になりましたら、声掛けさせていただきますね",
            "Chinese": "时间到了我会提醒您的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:00:04",
            "content": "こんばんは相談員ですよろしくお願いします",
            "Chinese": "晚上好，我是咨询师，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:00:33",
            "content": "まずはじめにご年齢と性別を教えていただけますか",
            "Chinese": "首先，能请您告知年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:00:37",
            "content": "こちらこそ",
            "Chinese": "我才是，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:01:02",
            "content": "17才　男",
            "Chinese": "17岁，男。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:01:17",
            "content": "教えていただいて有難うございます",
            "Chinese": "谢谢您的告知。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:01:25",
            "content": "いえ",
            "Chinese": "不客气。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:01:29",
            "content": "本日はどのようなご相談でしょうか",
            "Chinese": "今天您有什么想咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:01:59",
            "content": "なんかめんどくさくなって",
            "Chinese": "感觉有点麻烦了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:02:15",
            "content": "そうなんですね、、",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:02:19",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:02:37",
            "content": "どんなことがあったのか、もう少し詳しく教えていただけますか？",
            "Chinese": "能再稍微详细地告诉我发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:03:01",
            "content": "毎月保護司と会うんですけど",
            "Chinese": "我每个月都要和保护司见面。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:03:11",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:03:30",
            "content": "会わなくてもなんとかならないかなと",
            "Chinese": "我在想，不见面应该也可以吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:04:14",
            "content": "会うとどんなことがあるのでしょうか",
            "Chinese": "见面的时候一般会做些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:04:25",
            "content": "話をします",
            "Chinese": "就是聊天。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:04:31",
            "content": "ええ",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:04:53",
            "content": "例えばどんな話をされますか",
            "Chinese": "比如说，会聊些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:05:14",
            "content": "聞かれたこと話します。近況報告ですね",
            "Chinese": "她问什么我就回答，算是汇报近况吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:05:28",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:05:36",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:06:13",
            "content": "保護司さんと会う時に、どんなことがめんどうだと感じておられますか",
            "Chinese": "和保护司见面时，您觉得麻烦的是哪些方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:06:37",
            "content": "わざわざ時間空けなきゃいけないこと",
            "Chinese": "还得特地空出时间。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:07:29",
            "content": "その時間が無駄だなと感じてしまうのでしょうか、、",
            "Chinese": "会让您觉得那段时间很浪费吗……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:08:07",
            "content": "無駄というか、会わなきゃいけないから会ってるけど",
            "Chinese": "也不算浪费吧，就是因为必须见才去见。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:08:16",
            "content": "ええ",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:08:31",
            "content": "めんどくさいなと思ってる",
            "Chinese": "就是觉得麻烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:09:50",
            "content": "会わなきゃいけないと思うと、強制的な感じがして嫌になってきますよね、、",
            "Chinese": "一想到是必须得见的，就会有种被强制的感觉，会让人讨厌呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:10:14",
            "content": "強制的か",
            "Chinese": "强制吗……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:10:23",
            "content": "そうかも",
            "Chinese": "可能吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:10:33",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:11:36",
            "content": "どんなことがあって保護司と会うようになったのでしょうか（お話しできる範囲で結構です）",
            "Chinese": "是因为发生了什么事才开始和保护司见面的呢？（在您方便说的范围内就可以了）"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:11:59",
            "content": "万引き",
            "Chinese": "偷东西。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:12:11",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:12:16",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:12:38",
            "content": "それはいつ頃の出来事ですか",
            "Chinese": "那是大概什么时候发生的事呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:12:56",
            "content": "去年の秋",
            "Chinese": "去年秋天。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:14:29",
            "content": "相談にのりたいと思うので、そのことについてもう少しお話することできますか？",
            "Chinese": "我想更好地理解您遇到的情况，可以再多聊聊那件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:14:58",
            "content": "何の相談ですか？",
            "Chinese": "咨询什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:15:59",
            "content": "保護司と会うことがめんどうと感じていることをどうすればいいか、一緒に考えたいと思うんですが",
            "Chinese": "我是想和您一起想想，该如何应对“觉得和保护司见面很麻烦”这件事。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:16:23",
            "content": "あー😩保護司のおばさんに会うのがめんどっちなの",
            "Chinese": "啊—😩就是觉得见那个保护司阿姨很麻烦。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:16:44",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:17:28",
            "content": "その時にどんなことが頭に浮かぶかな？",
            "Chinese": "那时候您脑子里会浮现些什么想法呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:18:25",
            "content": "会わなきゃいけないから仕方ないけど",
            "Chinese": "虽然非见不可，也没办法，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:18:38",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:19:01",
            "content": "他にもやりたいことあるしさ",
            "Chinese": "但我还有其他想做的事啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:19:39",
            "content": "やりたいことあるのに、時間使われるのはつらいよね、、",
            "Chinese": "明明有想做的事，却被占用了时间，确实挺难受的……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:19:59",
            "content": "優しいおばさんなんだけどさ",
            "Chinese": "虽然她人很和善啦，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:20:08",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:20:53",
            "content": "めんどくさいだよね。",
            "Chinese": "但就是麻烦嘛。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:21:32",
            "content": "他にやりたいことって、どんなことかよかったら教えてもらえるかな？",
            "Chinese": "您想做的其他事情，大概有哪些呢，方便说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:22:08",
            "content": "家でごろごろ",
            "Chinese": "在家躺着。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:22:53",
            "content": "そんなめんどくさい時間なら、家でごろごろしてたいって感じかな",
            "Chinese": "感觉是“与其花那么麻烦的时间，还不如在家躺着”这样吧？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:23:20",
            "content": "家でゴロゴロしてたいんだよ",
            "Chinese": "我就是想在家躺着啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:23:57",
            "content": "うんうん、無駄な時間だと思うとそう思うよね、、",
            "Chinese": "嗯嗯，如果觉得是浪费时间，会这么想也正常呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:24:32",
            "content": "無駄ではない",
            "Chinese": "并不是浪费。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:24:49",
            "content": "そっか、ごめんね",
            "Chinese": "这样啊，抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:24:57",
            "content": "いえ",
            "Chinese": "没事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:25:20",
            "content": "その時間は「めんどくさい」なんだよね",
            "Chinese": "那段时间对您来说就是“很麻烦”，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:25:45",
            "content": "前は家に来てくれたのに今月からは自分が出向かなきゃいけないんだ",
            "Chinese": "以前都是她来家里，但从这个月开始我必须自己过去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:26:00",
            "content": "そうなんだね",
            "Chinese": "这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:26:06",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:26:20",
            "content": "それって、なんでそうなったのかな？",
            "Chinese": "这个变化，您知道是什么原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:26:33",
            "content": "知らん",
            "Chinese": "不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:27:04",
            "content": "何か事前に連絡とか無かった感じかな",
            "Chinese": "是不是没有提前联系或通知呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:27:33",
            "content": "前回会った時に次からは来てねと言ってた",
            "Chinese": "上次见面时，她就说下次开始要我过去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:27:57",
            "content": "理由は聞かされずかな？",
            "Chinese": "没有告诉你理由吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:28:20",
            "content": "保護の言うことは絶対でしょ",
            "Chinese": "保护司说的话是绝对的吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:28:37",
            "content": "保護司の言うことは絶対でしょ",
            "Chinese": "保护司说的话是绝对的吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:28:40",
            "content": "そっか、それもそうだよね",
            "Chinese": "这样啊，说的也是呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:29:38",
            "content": "あーあ　やだな",
            "Chinese": "唉，真不想去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:29:58",
            "content": "うんうん絶対守らないとって、思ってるとしんどくなるよね、、",
            "Chinese": "嗯嗯，一直想着“必须绝对遵守”，确实会很累呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:30:14",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:31:47",
            "content": "近況報告するのが嫌なのか、保護司のおばさんと会うのが嫌なのか、時間がとられるのが嫌とか　自分ではどんな感じかな？",
            "Chinese": "是不喜欢汇报近况呢，还是不喜欢见那位保护司阿姨，或者是不喜欢被占用时间……对您来说是哪一方面更让您抗拒呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:32:06",
            "content": "いくのが嫌",
            "Chinese": "不想去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:32:42",
            "content": "そっか、たしかに出向かないといけないのはしんどいよね・・",
            "Chinese": "我懂，确实要亲自跑一趟会很辛苦呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:32:51",
            "content": "めんどくさい",
            "Chinese": "就是麻烦。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:33:48",
            "content": "バイクダメ出し",
            "Chinese": "她不让我骑摩托车。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:34:05",
            "content": "そうなんだ・・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:34:12",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:34:30",
            "content": "何でか聞いた？",
            "Chinese": "问过原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:34:42",
            "content": "学校で禁止だから",
            "Chinese": "因为学校禁止。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:35:04",
            "content": "そっかそっかどこで会ってるのかな？",
            "Chinese": "这样啊，那你们在哪里见面呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:35:41",
            "content": "駅前のなんとかセンターって言ってた",
            "Chinese": "她说是车站前的某个中心。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:36:15",
            "content": "もしかすると今度初めて外で会う感じかな？",
            "Chinese": "也就是说这次可能是第一次在外面见面吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:36:23",
            "content": "そう",
            "Chinese": "对。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:36:53",
            "content": "そっか、はじめてだと少し緊張するよね",
            "Chinese": "这样啊，第一次的话多少会紧张一点吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:37:01",
            "content": "いや",
            "Chinese": "不会。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/02(金) 19:37:21",
            "content": "そっか、じゃあどんな感じかな？",
            "Chinese": "这样啊，那您是什么感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/02(金) 19:37:33",
            "content": "めんどくさいだけ",
