{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 12:54:27",
            "content": "こんちには。本日はよろしくお願いします。13時になったらまたお声がけいたしますね。",
            "Chinese": "您好。今天请多关照。下午1点（13点）我会再联系您。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 12:55:47",
            "content": "こんにちは。本日はよろしくお願いいたします。",
            "Chinese": "您好。今天请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:00:11",
            "content": "始めてもよろしいでしょうか？",
            "Chinese": "请问，我们可以开始了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:00:22",
            "content": "お願いいたします。",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:01:03",
            "content": "こんにちは。相談員です。本日はご相談の場にお越し下さりありがとうございます。",
            "Chinese": "您好。我是咨询师。感谢您今天前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:01:15",
            "content": "お願いします。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:01:47",
            "content": "本日は1時間になりますのでよろしくお願い致します。まず最初にご相談内容をお聞かせ下さいますか？",
            "Chinese": "今天我们有一个小时的咨询时间，请多关照。首先，能请您告诉我您想咨询的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:02:21",
            "content": "仕事のことで迷っています。",
            "Chinese": "我对工作上的事感到很迷茫。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:02:31",
            "content": "このまま続けるか",
            "Chinese": "是该继续做下去，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:02:51",
            "content": "辞めて違う職を探すか",
            "Chinese": "还是辞职去找别的工作。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:03:02",
            "content": "最近、職場から",
            "Chinese": "最近，公司这边"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:03:18",
            "content": "アンケート調査がありまして",
            "Chinese": "发来了一份问卷调查，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:03:50",
            "content": "働く時間が少なくなるけれどどうしますか？",
            "Chinese": "大意是“工作时间会减少，您打算怎么办？”"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:04:00",
            "content": "ざっくり言うと",
            "Chinese": "简单来说，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:04:08",
            "content": "そういう内容です。",
            "Chinese": "就是这样的内容。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:04:20",
            "content": "働く時間が少なくなると",
            "Chinese": "如果工作时间减少，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:04:29",
            "content": "収入が減る",
            "Chinese": "收入就会下降，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:04:42",
            "content": "でも好きで始めた仕事",
            "Chinese": "可这是我因为喜欢才开始做的工作，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:04:57",
            "content": "色々考えてしまいます。",
            "Chinese": "所以思来想去，心里很纠结。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:05:07",
            "content": "なるほどですね。かしこまりました。お仕事を続けるかどうかのお悩みということですね。",
            "Chinese": "原来如此，我明白了。您的困扰是要不要继续这份工作，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:05:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:05:27",
            "content": "もう少しお話を伺いたいのですが",
            "Chinese": "我想再多了解一些情况，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:05:31",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:05:49",
            "content": "今はどのような内容のお仕事をされていらっしゃるのですか？",
            "Chinese": "您现在从事的是什么样的工作呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:06:12",
            "content": "ホテル業界です",
            "Chinese": "是酒店行业的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:06:28",
            "content": "主にフロントです",
            "Chinese": "主要是前台。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:06:53",
            "content": "そうなのですね。お勤めされてどれくないになるのでしょうか？",
            "Chinese": "原来如此。您在这份工作上做了多久了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:07:13",
            "content": "10年以上になります",
            "Chinese": "已经超过10年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:07:54",
            "content": "長くお勤めされていらっしゃるのですね。なのに、労働時間の短縮ということでしょうか？",
            "Chinese": "您工作这么长时间了啊。但还是要缩短工作时间吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:08:03",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:08:15",
            "content": "コロナの影響で",
            "Chinese": "受新冠疫情的影响，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:08:30",
            "content": "閉めているホテルもありますし",
            "Chinese": "有些酒店已经关门了，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:08:41",
            "content": "AI導入で",
            "Chinese": "而且公司引进了AI，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:08:56",
            "content": "人員削減を考えているようで",
            "Chinese": "公司似乎在考虑裁员。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:09:16",
            "content": "そうだったのですね。お好きな仕事なだけに複雑なお気持ちになられますよね。",
            "Chinese": "原来是这样。正因为是您喜欢的工作，心情才会如此复杂吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:09:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:10:24",
            "content": "アンケート調査はいつ頃行われたのですか？",
            "Chinese": "这份问卷调查大概是什么时候进行的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:11:00",
            "content": "7月に入ってからです。先月ですね。",
            "Chinese": "是从7月份开始的。也就是上个月。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:11:14",
            "content": "では、本当に最近のお話なのですね。",
            "Chinese": "那真的是最近才发生的事呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:11:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:11:36",
            "content": "7月から営業再開で",
            "Chinese": "我们从7月开始重新营业，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:11:45",
            "content": "そのタイミングでした",
            "Chinese": "就是那个时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:12:01",
            "content": "そうだったのですね。コロナの不安もありつつお仕事の不安も抱えていらっしゃるのはお辛いですよね。",
            "Chinese": "原来是这样。一边要为疫情担忧，一边又要为工作烦恼，一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:12:25",
            "content": "そうですね。色々不安はつのります。",
            "Chinese": "是啊。各种不安感越来越强了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:13:04",
            "content": "職場は何人いらっしゃるのでしょうか？",
            "Chinese": "您公司里有多少员工呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:13:20",
            "content": "結構います",
            "Chinese": "人挺多的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:13:48",
            "content": "色々なホテルを経営している会社で",
            "Chinese": "因为我们公司经营着多家酒店。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:14:16",
            "content": "なるほどですね。多くのかたがいる職場なのですね。",
            "Chinese": "原来如此，是个员工很多的职场呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:14:25",
            "content": "そうすると、",
            "Chinese": "这样的话，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:14:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:14:42",
            "content": "今回のアンケート調査は全員に行われたのでしょうか？",
            "Chinese": "这次的问卷调查是面向所有员工的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:14:53",
            "content": "そうだと思います",
            "Chinese": "我想是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:15:46",
            "content": "私の居るホテルのフロントの者は記入していました",
            "Chinese": "我所在的酒店前台的同事都填写了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:16:08",
            "content": "そうなのですね。そうすると記入は任意ですか？",
            "Chinese": "是这样啊。那填写是自愿的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:16:44",
            "content": "みんな生活があるので",
            "Chinese": "因为大家都有生活要维持，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:17:05",
            "content": "アンケートは提出していると思います",
            "Chinese": "我想大家都提交了问卷。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:17:46",
            "content": "そうなのですね。お話の途中すみません。あなた様を呼び方をお伺いしてもよろしいですか？",
            "Chinese": "是这样啊。不好意思，打断一下。请问我该如何称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:18:12",
            "content": "ゆりです。",
            "Chinese": "我叫由里。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:18:46",
            "content": "ゆりさんですね。ありがとうございます。そうすると、ゆりさんはまだアンケートは提出されていないということでしょうか？",
            "Chinese": "是由里女士对吗？谢谢您。那么，由里女士，您是还没有提交问卷吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:19:07",
            "content": "一応提出はしました。",
            "Chinese": "我还是提交了的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:19:17",
            "content": "締め切りがあったもので",
            "Chinese": "因为有截止日期，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:19:31",
            "content": "継続で",
            "Chinese": "我选了继续工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:19:53",
            "content": "締め切りまであるのですね。すると、なおさら焦りますよね。",
            "Chinese": "原来还有截止日期啊。那样的话，会更让人焦虑呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:20:02",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:20:20",
            "content": "会社側も色々大変だと思うので",
            "Chinese": "我也觉得公司方面很不容易，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:20:59",
            "content": "一方的な解雇でないだけ良いかなと思います",
            "Chinese": "只要不是单方面解雇，我觉得就算不错了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:21:27",
            "content": "会社側もですが従業員の方はそれぞれの生活を抱えてますからもっと大変だと思います。",
            "Chinese": "公司方面固然不易，但员工们都各自背负着生活，我想会更辛苦。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:21:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:21:41",
            "content": "１０年以上働かれているので",
            "Chinese": "因为您已经工作了10年以上，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:21:50",
            "content": "やりきれないお気持ちになりますよね。",
            "Chinese": "心里会感到很不甘心吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:21:56",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:22:07",
            "content": "フロントで入ったのですが",
            "Chinese": "我是以做前台入职的，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:22:26",
            "content": "違うところに配置になったら",
            "Chinese": "如果被调到别的岗位，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:22:30",
            "content": "と思うと",
            "Chinese": "一想到这个，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:22:39",
            "content": "色々考えてしまいます",
            "Chinese": "我就会想很多。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:23:03",
            "content": "というと、他のフロント以外になる可能性があるということでしょうか？",
            "Chinese": "您的意思是，有可能会被调到前台以外的岗位吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:23:28",
            "content": "アンケートの内容であったので",
            "Chinese": "因为问卷里有这方面的内容，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:23:43",
            "content": "とりあえず",
            "Chinese": "所以暂时觉得，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:24:02",
            "content": "働けるだけでも良いのかな",
            "Chinese": "能继续工作就已经不错了，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:24:10",
            "content": "という思いもあり",
            "Chinese": "我也有这样的想法，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:24:42",
            "content": "どちらでも というところに印をつけました",
            "Chinese": "我勾选了“都可以”的选项。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:25:02",
            "content": "そうだったのですね。。そんな状況だと不安が一層、増してしまいますね。",
            "Chinese": "原来是这样啊……在那种情况下，不安感会更加强烈呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:25:08",
            "content": "ちなみに、",
            "Chinese": "顺便问一下，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:25:14",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:25:39",
            "content": "フロント以外は、お気持ちが進まない理由はありますか？",
            "Chinese": "除了前台之外，您不太想去的原因是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:26:03",
            "content": "そうですね",
            "Chinese": "这个嘛……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:26:41",
            "content": "理由をお聞かせいただけますか？",
            "Chinese": "能跟我说说理由吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:26:48",
            "content": "やってやれないことはないのですが",
            "Chinese": "也不是说完全做不了，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:27:06",
            "content": "レストランや宴会",
            "Chinese": "比如餐厅或宴会部，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:27:25",
            "content": "ウェディング",
            "Chinese": "还有婚庆部。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:27:44",
            "content": "フロントがやりたくて",
            "Chinese": "我是因为想做前台"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:27:55",
            "content": "入ったので",
            "Chinese": "才进公司的，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:28:08",
            "content": "その気持ちが強いです",
            "Chinese": "这份心情依然很强烈。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:28:11",
            "content": "でも",
            "Chinese": "但是，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:28:18",
            "content": "そんなこと",
            "Chinese": "这种话，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:28:29",
            "content": "言ってられないなとも思います",
            "Chinese": "我也觉得现在不是可以说这种话的时候了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:28:54",
            "content": "そうお考えなのですね。不安と戦いながらも前進されようとする強いお気持ちが伝わります。",
            "Chinese": "您是这么想的啊。我能感受到您在与不安斗争的同时，也想努力前进的坚强意志。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:29:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:29:25",
            "content": "ちなみに同僚や上司、後輩はいらっしゃいますか？",
            "Chinese": "顺便问一下，您有同事、上司或后辈吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:29:37",
            "content": "おります",
            "Chinese": "有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:30:13",
            "content": "そうなのですね。皆さんで、このことについてお話とかはされましたか？",
            "Chinese": "是这样啊。大家有一起讨论过这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:30:24",
            "content": "はい",
            "Chinese": "有的，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:30:32",
            "content": "話はしています",
            "Chinese": "我们有聊过。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:31:24",
            "content": "そうなのですね。皆さんも、迷われていらっしゃいましたか？",
            "Chinese": "是这样啊。大家也都很迷茫吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:31:40",
            "content": "半々位で",
            "Chinese": "大概一半一半吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:32:05",
            "content": "アンケートの前に辞めた者もいますし",
            "Chinese": "有的人在问卷调查之前就辞职了，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:32:22",
            "content": "そうでしたか、、、",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:32:55",
            "content": "迷っている者、ジャンル問わず頑張ろうという者といます",
            "Chinese": "有正在犹豫的，也有说不管什么岗位都会努力去做的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:33:28",
            "content": "そうなのですね。環境が変わりつつあり不安になりますね。少しお話戻りまして時間はどれくらい短くなるのでしょうか？",
            "Chinese": "是这样啊。环境在不断变化，确实会让人不安呢。让我们稍微回到之前的话题，工作时间大概会缩短多少呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:33:58",
            "content": "そうですね",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:34:44",
            "content": "先月は日でいうと2～3時間は短くなりました",
            "Chinese": "上个月的话，每天缩短了2到3个小时。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:34:54",
            "content": "交代で少人数で",
            "Chinese": "因为是轮班制，用很少的人手"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:35:04",
            "content": "まわしていますので",
            "Chinese": "来维持运营的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:35:57",
            "content": "なるほどですね。そうすると収入面もやはり考えてしましますよね。",
            "Chinese": "原来是这样。这样的话，收入方面确实也会让人担心吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:36:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:36:24",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:36:34",
            "content": "でもその状況の中、しっかり考えていらっしゃるゆりさん、今でも本当に頑張られているのが伝わりますよ。",
            "Chinese": "但在这种情况下，由里女士您还能认真地思考，我能感受到您真的已经非常努力了。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:36:46",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:37:00",
            "content": "そしたら、少しお話整理させていただきますね。お時間いただけますか？",
            "Chinese": "那么，请允许我稍微整理一下您说的情况，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:37:10",
            "content": "お願いします",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:37:13",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:40:39",
            "content": "好きで１０年以上働かれている職場で、コロナや人員削減の関係で労働時間短縮が提示されてしまってる状態なので収入的にもフロント以外の配置になることにも不安を抱えていらっしゃいますね。でもそんなこと言っていられないと前向きには考えていらっしゃるけど、お仕事を続けようか辞めようか、迷われていらっしゃる。どうしたらよいのだろう・・・ということで大丈夫でしょうか？",
            "Chinese": "您在自己喜欢并且工作了超过10年的公司，因为疫情和裁员的原因，公司提出了缩短工作时间的要求，这让您对收入以及可能被调离前台岗位感到不安。虽然您积极地认为现在不是挑剔的时候，但仍然在是该继续工作还是辞职之间犹豫不决，烦恼着“我该怎么办才好”……我这样理解对吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:40:52",
            "content": "もし間違った認識があれば",
            "Chinese": "如果我的理解有任何不准确的地方，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:41:01",
            "content": "遠慮なくおっしゃってくださいね。",
            "Chinese": "请随时告诉我。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:41:30",
            "content": "まさにそういうことです。",
            "Chinese": "完全就是这样。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:41:43",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:41:50",
            "content": "こちらこそ確認いただきありがとうございます。",
            "Chinese": "我也要谢谢您的确认。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:42:24",
            "content": "差し支えなければですが、今はご家族で住んでいらっしゃいますか？",
            "Chinese": "如果方便的话，您现在是和家人一起住吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:42:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:43:20",
            "content": "夫と子どもが一人います",
            "Chinese": "我和丈夫以及一个孩子住在一起。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:44:05",
            "content": "子どもは小学生です",
            "Chinese": "孩子在上小学。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:44:35",
            "content": "そうなのですね。お子様はまだ小学生でいらっしゃいましたか。",
            "Chinese": "这样啊，您的孩子还在上小学呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:44:42",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:45:09",
            "content": "そうすと、お仕事以外にもお疲れとかは溜まっていらっしゃいませんか？",
            "Chinese": "这样的话，除了工作之外，您会不会也感到很疲惫呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:45:20",
            "content": "ありがとうございます",
            "Chinese": "谢谢您的关心。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:45:29",
            "content": "大丈夫です",
            "Chinese": "我没事的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:46:08",
            "content": "夫も子どもも家のことを手伝ってくれますので",
            "Chinese": "我丈夫和孩子都会帮忙做家务。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:46:26",
            "content": "素敵なご家族ですね。",
            "Chinese": "真是温馨的家庭呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:46:43",
            "content": "仲良くやっています",
            "Chinese": "我们相处得很融洽。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:47:47",
            "content": "よかったです。ご家庭は癒しになられているのですね。",
            "Chinese": "太好了。家庭对您来说也是一种疗愈与支撑呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:48:06",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:49:10",
            "content": "ご主人様にはご相談はされていらっしゃいますか？",
            "Chinese": "您和您的先生商量过这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:49:18",
            "content": "はい",
            "Chinese": "有的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:49:35",
            "content": "好きにしたら良いって言われています",
            "Chinese": "他说让我按自己的想法来就好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:50:08",
            "content": "そうなのですね。ゆりさんのこと、尊重されていらっしゃるのですね。",
            "Chinese": "是这样啊。他很尊重由里您的想法呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:50:26",
            "content": "そうなのかな？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:50:34",
            "content": "特に",
            "Chinese": "他也没有特别地"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:51:01",
            "content": "決めつけられはしないです",
            "Chinese": "强求我怎么做。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:51:43",
            "content": "はい！続けるにしても職場離れるにしてもゆりさんの意思が尊重される環境下にはあると思いますよ。素敵なご主人様ですね。",
            "Chinese": "是的！无论是继续工作还是离开公司，您都处在一个您的意愿能被尊重的环境中。您的先生真好。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:52:02",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:52:13",
            "content": "ここまでご相談されてもう少しお話しておきたいことありますか？",
            "Chinese": "谈到这里，您还有什么想进一步聊聊的吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:52:24",
            "content": "いいえ",
            "Chinese": "没有了。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:52:42",
            "content": "話はできました",
            "Chinese": "想说的都说了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:53:08",
            "content": "たくさんお話くださりありがとうございます。もし、少しでもまだ引っかかることがあれば、時間のある限り話下さいね。",
            "Chinese": "非常感谢您愿意分享这么多。如果还有哪怕一点点挂心的事，在时间允许的情况下都可以再和我聊。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:53:26",
            "content": "はい ありがとうございます",
            "Chinese": "好的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:53:47",
            "content": "少しだけ私の気持ちを伝えてもよろしいでしょうか？",
            "Chinese": "我可以稍微说一下我的想法吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:53:55",
            "content": "お願いします",
            "Chinese": "好的，请讲。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:55:38",
            "content": "今ある環境はコロナのこともあり、現状では不安が募ってしまう一方かもしれません。コロナが突然訪れたように、突然の出来事ってたくさんこれからもあると思います。",
            "Chinese": "现在的环境因为有疫情的关系，可能会让您的不安情绪不断加剧。就像新冠疫情突然到来一样，我想未来也还会有很多突发事件。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:56:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:56:44",
            "content": "しかし、未来どうなるか分からない不安をずっと考えるより、「今ここでなにができるか」目の前のことを少しづつ乗り越えていただけると、",
            "Chinese": "但是，与其一直为不确定的未来而感到不安，不如专注于‘此时此地我能做什么’，一步步地去克服眼前的问题，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:58:18",
            "content": "ご自身の不安も倍増せずに考えていただけるのではないかな、と思いました。温かいご家庭がありゆりさんの意思は尊重されるはずです。",
            "Chinese": "我想这样或许能让您在思考时，不安感不至于加倍。您有一个温暖的家庭，您的意愿一定会被尊重的。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:58:51",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:58:59",
            "content": "今は、お仕事も継続しようかな・・という前向きなお気持ちもあります。なので、もし、進めてみてつらくなった時",
            "Chinese": "您现在也有“要不还是继续工作吧”这样的积极想法。所以，如果在尝试的过程中觉得痛苦了，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 13:59:15",
            "content": "そこで、逃げてみてもいいのではないでしょうか？",
            "Chinese": "到那个时候，选择暂时退一步、换条路走也未尝不可。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 13:59:49",
            "content": "はい。先のことばかり考えていても不安しかないので",
            "Chinese": "是的。老是考虑将来的事只会徒增不安，"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 14:00:01",
            "content": "今を頑張ってみます",
            "Chinese": "我会努力把当下做好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 14:00:47",
            "content": "無理しすぎずにつらくなったり、不安になったらまた、こちらにいらして下さいね。",
            "Chinese": "别太勉强自己，如果觉得辛苦或不安了，欢迎随时再来找我。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 14:01:04",
            "content": "気持ちが楽になりました。辛くなったときは違う道を考えます。",
            "Chinese": "我心情轻松多了。如果觉得辛苦了，我会考虑换一条路。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 14:01:12",
            "content": "ありがとうございました。",
            "Chinese": "非常感谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 14:02:00",
            "content": "今でも十分に考えて頑張っていらっしゃりますので焦らずに・・・応援しています。",
            "Chinese": "您已经想得很多、也一直在努力了，请别着急……我会一直支持您。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 14:02:16",
            "content": "本日はありがとうございました。",
            "Chinese": "今天非常感谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 14:02:40",
            "content": "こちらこそ、ありがとうございました。本日のご相談を終了とさせていただきます。",
            "Chinese": "我也要谢谢您。今天的咨询到此结束。"
        },
        {
            "role": "クライアント",
            "time": "2020/08/04(火) 14:02:45",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/08/04(火) 14:02:54",
            "content": "（ありがとうございました！）",
            "Chinese": "（非常感谢！）"
        },
        {
            "role": "クライアント",
