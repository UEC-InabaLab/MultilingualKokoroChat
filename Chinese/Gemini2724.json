{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 19:55:49",
            "content": "こんばんは。本日のロールプレイよろしくお願い致します。",
            "Chinese": "晚上好。今天的角色扮演请多指教。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 19:57:54",
            "content": "こちらこそ宜しくお願い致します。",
            "Chinese": "我也请您多多指教。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:00:12",
            "content": "早速、ロールプレイを始めさせていただきますね。",
            "Chinese": "那我们就马上开始角色扮演吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:00:27",
            "content": "（はい、お願いします。）",
            "Chinese": "（好的，拜托了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:00:51",
            "content": "こんばんは。相談員です。まず初めに年齢と性別を教えていただけますか？",
            "Chinese": "晚上好，我是咨询员。首先，请问能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:01:09",
            "content": "20 性別はいやです",
            "Chinese": "20岁，性别不想说。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:01:17",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:01:32",
            "content": "答えたくなかったら大丈夫ですよ。",
            "Chinese": "如果您不想回答也没关系的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:01:56",
            "content": "本日はどういった相談でしょうか？",
            "Chinese": "您今天想咨询什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:02:26",
            "content": "明日学校で人を殺したくて",
            "Chinese": "我想明天在学校杀人。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:02:45",
            "content": "どうやれば捕まらないですか？",
            "Chinese": "怎么做才能不被抓？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:02:48",
            "content": "えぇ",
            "Chinese": "呃……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:03:22",
            "content": "殺したくなるくらい腹が立つことがあったのでしょうか？",
            "Chinese": "是发生了什么事，让您气到想杀人吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:03:30",
            "content": "別に",
            "Chinese": "倒也没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:03:44",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:03:57",
            "content": "方法を教えて欲しいです",
            "Chinese": "希望你能告诉我方法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:04:44",
            "content": "何の方法でしょうか？",
            "Chinese": "您指的是什么方法呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:05:00",
            "content": "殺した後捕まらない方法",
            "Chinese": "杀了人之后不被抓的方法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:05:11",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:05:49",
            "content": "あなたはいつから殺したいと思うようになったのですか？",
            "Chinese": "您是从什么时候开始有想杀人的念头的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:06:12",
            "content": "ここ最近",
            "Chinese": "最近这段时间。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:06:22",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:06:34",
            "content": "きっかけはありましたか？",
            "Chinese": "有什么契机吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:06:42",
            "content": "特に",
            "Chinese": "没什么特别的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:06:54",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:07:23",
            "content": "具体的な計画は立てておられるのですか？",
            "Chinese": "您已经制定了具体的计划吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:07:35",
            "content": "まだ",
            "Chinese": "还没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:07:55",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:08:51",
            "content": "なぜ殺そうと思ったのでしょうか？",
            "Chinese": "为什么会想着要杀人呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:09:19",
            "content": "みんな死んだらいいのにと思ったから",
            "Chinese": "因为我觉得大家都去死就好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:09:33",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:09:50",
            "content": "どういう時にそう思うのですか？",
            "Chinese": "您在什么时候会这么想呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:10:23",
            "content": "いつも思ってる",
            "Chinese": "我一直都这么想。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:10:42",
            "content": "いつもそう思っておられるんですね。",
            "Chinese": "您一直都有这样的想法啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:11:19",
            "content": "家にいる時と学校にいる時だとどっちの方が考える時間が多いのですか？",
            "Chinese": "在家里和在学校的时候，哪一边会更常这样想呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:11:32",
            "content": "変わらない",
            "Chinese": "都一样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:11:41",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:12:16",
            "content": "どこにいてもみんな死んでしまえばいいと思われているのですね。",
            "Chinese": "也就是说，无论在哪里，您都会觉得大家死了就好了。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:12:29",
            "content": "そんな感じかな",
            "Chinese": "差不多吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:12:36",
            "content": "そうですか。",
            "Chinese": "这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:12:48",
            "content": "ずっと考えているのも疲れますよね。",
            "Chinese": "一直想着这些事，也会很累吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:13:02",
            "content": "別に",
            "Chinese": "并不会。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:13:15",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:13:47",
            "content": "周りの人に今のお気持ちを話されたりはしましたか？",
            "Chinese": "您有跟身边的人说过您现在的心情吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:15:03",
            "content": "人を殺したいって？話すと思う？",
            "Chinese": "想杀人这种事？你觉得我会去说吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:16:05",
            "content": "そうですね。もしかすると誰かにお話しされているのかなと思いましたので。",
            "Chinese": "说得也是。我只是想，或许您已经对谁说过了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:17:05",
            "content": "学校は毎日通っておられるのですか？",
            "Chinese": "您每天都有去上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:17:32",
            "content": "毎日では無い",
            "Chinese": "不是每天都去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:17:49",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:18:52",
            "content": "学校はいかがですか？",
            "Chinese": "您觉得学校怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:19:05",
            "content": "いかがって？",
            "Chinese": "什么怎么样？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:19:46",
            "content": "分かりづらくて申し訳ありません。",
            "Chinese": "抱歉，我表达得不够清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:20:18",
            "content": "通ってみての感想です。大変だとかしんどいだとか楽だとかです。",
            "Chinese": "就是您去上学的一些感受。比如觉得很辛苦、很累，或者很轻松之类的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:20:47",
            "content": "普通、いやではない",
            "Chinese": "一般吧，不讨厌。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:21:05",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:22:56",
            "content": "授業を受けていてどうですか？",
            "Chinese": "上课的时候感觉怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:23:25",
            "content": "楽過ぎてつまらない",
            "Chinese": "太简单了，很无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:23:36",
            "content": "なるほど。",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:23:55",
            "content": "理解力がおありなんですね。",
            "Chinese": "看来您的理解能力很强呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:24:19",
            "content": "方法、教えてくれませんか？",
            "Chinese": "能告诉我方法吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:24:44",
            "content": "先程のバレない方法ということでしょうか？",
            "Chinese": "您是指刚才说的那个不被发现的方法吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:24:53",
            "content": "そう",
            "Chinese": "对。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:25:00",
            "content": "捕まらない方法",
            "Chinese": "不被抓的方法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:25:13",
            "content": "そうですね。",
            "Chinese": "是呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:26:52",
            "content": "その場で死ぬのもありか",
            "Chinese": "当场死掉也可以吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:27:51",
            "content": "私は相談員なので分からないのですが、よければあなたのお気持ちを伺ってお力になれたらと思っております。",
            "Chinese": "我作为咨询员，并不知道那种方法。但如果您愿意的话，我希望能听听您的心情，为您提供一些帮助。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:28:21",
            "content": "教えてくれないんだ？",
            "Chinese": "你不告诉我，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:28:47",
            "content": "お力？一緒にやってくれんの？",
            "Chinese": "帮助？你是要和我一起做吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:30:05",
            "content": "人を殺めることと捕まらない方法というのは加担できないですが、あなたの辛いお気持ちがあるなら気持ちを聞かせていただけたらと思っています。",
            "Chinese": "关于杀人和不被抓的方法，我无法参与。但如果您有痛苦的心情，我希望能听您倾诉。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:32:05",
            "content": "その、腫れ物にさわる感じ、やめてもらえます？",
            "Chinese": "那个，能不能别像碰脓包一样小心翼翼的？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:32:50",
            "content": "そう思わせてしまっていたのなら大変失礼いたしました。",
            "Chinese": "如果让您有这种感觉，我非常抱歉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:34:35",
            "content": "どのような文が不快にさせてしまっていたのでしょうか？",
            "Chinese": "是哪些话让您感到不舒服了呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:34:54",
            "content": "全体的に",
            "Chinese": "整体上都是。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:35:14",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:35:23",
            "content": "気持ち聞いてどうするの？何か変わる？",
            "Chinese": "听了我的心情又怎么样呢？能改变什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:35:30",
            "content": "変わらないよ",
            "Chinese": "什么也改变不了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:36:54",
            "content": "あなたのお気持ちが変わらないとしてもせっかくお話に来て下さっているので、学校のお話やあなたについてお話を聞かせてもらえると嬉しいです。",
            "Chinese": "即使您的心情不会改变，但您特地来找我聊，如果您能跟我聊聊学校的事或者关于您自己的事，我会很高兴。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:37:10",
            "content": "そうやってみんな偽善、建前でしか物を言わない腹の底では見下している",
            "Chinese": "大家就是这样，口头上说的都是伪善和场面话，心里其实在看不起人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:37:32",
            "content": "そう思われたのですね。",
            "Chinese": "您是这么觉得的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:38:47",
            "content": "でもこのSNS相談はあなたのための時間と場所なので、安心してくださって大丈夫ですよ。",
            "Chinese": "不过，这个SNS咨询是为您而设的时间和空间，您可以放心。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:40:25",
            "content": "あまり学校家の事は話したく無い",
            "Chinese": "我不太想谈学校和家里的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:41:06",
            "content": "そうでしたか。それなら無理にお話されなくて大丈夫ですよ。",
            "Chinese": "是这样啊。那您不用勉强自己说，没关系的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:42:08",
            "content": "普段学校に行っていない日はどうお過ごしか聞いてもよろしいですか？",
            "Chinese": "那么，我可以问问您平时不去学校的日子是怎么过的吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:42:36",
            "content": "zoomで講義、あとネトゲ",
            "Chinese": "用Zoom上课，还有就是玩网游。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:42:48",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:43:04",
            "content": "どういったゲームをされるのですか？",
            "Chinese": "您都玩些什么类型的游戏呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:43:16",
            "content": "色々",
            "Chinese": "各种各样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:43:29",
            "content": "そうなのですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:43:54",
            "content": "ゲームも色々なものがありますものね。",
            "Chinese": "游戏确实也有很多种呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/16(火) 20:44:14",
            "content": "ゲームの中にいられたらいいのに",
            "Chinese": "要是一直能待在游戏里就好了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/16(火) 20:44:31",
            "content": "そう思うこともありますよね。",
            "Chinese": "是啊，有时候是会这么想。"
        },
        {
