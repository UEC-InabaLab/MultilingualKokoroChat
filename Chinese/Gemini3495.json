{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:23:03",
            "content": "こんにちは。本日はよろしくお願いいたします。",
            "Chinese": "您好，今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:23:17",
            "content": "こんにちは、本日はよろしくお願いいたします。",
            "Chinese": "您好，今天请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:23:34",
            "content": "時間になりましたら開始させていただきます。",
            "Chinese": "时间到了，我们就可以开始了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:30:07",
            "content": "分かりました",
            "Chinese": "好的，明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:30:48",
            "content": "こんにちは。相談員です。はじめにご年齢と性別を教えていただけますか？",
            "Chinese": "您好，我是咨询师。首先，能告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:31:08",
            "content": "20代女性です",
            "Chinese": "我是20多岁的女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:31:19",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:31:36",
            "content": "本日はどのようなご相談ですか？",
            "Chinese": "今天您想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:32:04",
            "content": "今日は、評価されるのが怖い気持ちについて話したいです",
            "Chinese": "今天我想谈谈对被评价感到害怕的心情。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:32:41",
            "content": "ええ。評価されるのが怖いということですね。",
            "Chinese": "嗯，您是说害怕被评价，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:32:52",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:33:26",
            "content": "どういうときに感じるお気持ちですか？",
            "Chinese": "在什么样的情况下会有这样的感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:34:13",
            "content": "カウンセラーの仕事をやりたいなと思ってまして",
            "Chinese": "我在考虑从事咨询师这份工作，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:34:27",
            "content": "ええ、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:34:53",
            "content": "専門学校で、生徒同士のロールプレイがあるんですけど、",
            "Chinese": "在专门学校里，学生之间会做角色扮演练习，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:35:02",
            "content": "そのロールプレイのあとに",
            "Chinese": "角色扮演结束后，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:35:06",
            "content": "うんうん、",
            "Chinese": "嗯嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:35:08",
            "content": "相手からフィードバックもらうんですけど",
            "Chinese": "会从对方那里得到反馈，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:35:19",
            "content": "いいところは嬉しいんですけど",
            "Chinese": "优点被肯定时我会很高兴，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:35:23",
            "content": "はい、",
            "Chinese": "是的，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:35:32",
            "content": "改善点を聞くのが怖い、ときがありまして",
            "Chinese": "但有时候会害怕听到需要改进的地方。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:35:37",
            "content": "昔からそうなんですけど",
            "Chinese": "其实我从以前就这样，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:35:48",
            "content": "インスタとか、Facebookとか",
            "Chinese": "比如在Instagram、Facebook上，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:35:51",
            "content": "投稿したいと思っても",
            "Chinese": "即使想发帖，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:35:53",
            "content": "ええ、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:35:59",
            "content": "周りからの目や評価を気にしすぎてしまい",
            "Chinese": "也会过度在意他人的目光和评价，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:36:07",
            "content": "結構投稿やめたりとか",
            "Chinese": "常常最后就不发了，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:36:10",
            "content": "そう言うことが多く",
            "Chinese": "这种情况很多，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:36:15",
            "content": "悩んでます",
            "Chinese": "所以很困扰。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:36:27",
            "content": "そうなんですね。。。",
            "Chinese": "原来如此……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:36:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:37:15",
            "content": "周りから見られてると思うと、SNSも楽しめなかったりしますよね。",
            "Chinese": "一想到被周围的人看着，就没办法享受社交媒体的乐趣了，是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:37:25",
            "content": "そーですね、",
            "Chinese": "是啊，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:38:51",
            "content": "投稿したいと思っていても、",
            "Chinese": "即使想要发帖，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:40:18",
            "content": "楽しむためのツールなのに悩んでしまいますよね。",
            "Chinese": "明明是用来享受的工具，却反而因此而烦恼了呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:40:26",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:41:06",
            "content": "専門学校で、生徒同士のロールプレイの時は、",
            "Chinese": "在专业学校里，进行同学间角色扮演的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:41:30",
            "content": "改善点を聞く時は、どんなお気持ちになるのですか？",
            "Chinese": "当听到需要改进的地方时，您会有什么感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:41:53",
            "content": "いやだなーというか、否定されてる気持ちになります",
            "Chinese": "会觉得很抗拒，像是被否定了一样。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:43:00",
            "content": "そうなんですね。確かに否定されてると感じると、聞くのが怖いと感じたりしますよね。",
            "Chinese": "原来如此。确实，如果感觉自己被否定了，就会害怕去听了呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:43:25",
            "content": "はいそうですね",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:44:02",
            "content": "周りからの目や評価を気にしすぎてしまうというのは、",
            "Chinese": "您提到过于在意他人的目光和评价，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:44:20",
            "content": "いつ頃からでしたか？",
            "Chinese": "大概是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:45:16",
            "content": "いつごろからかはあんまり覚えてないですね。。",
            "Chinese": "具体从什么时候开始不太记得了……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:45:27",
            "content": "でも",
            "Chinese": "不过，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:45:34",
            "content": "ええ、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:45:35",
            "content": "高校の時とかも",
            "Chinese": "高中的时候也是，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:45:49",
            "content": "勉強とか評価されたり比較されるのは嫌いでした",
            "Chinese": "很不喜欢在学习上被评价、被比较。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:46:04",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:46:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:47:06",
            "content": "学生の頃は勉強とか、点数とか順位とか評価されるようなことが多いですよね。",
            "Chinese": "学生时代确实有很多需要被评价的事情，比如学习、分数、排名等等。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:47:17",
            "content": "そうですね",
            "Chinese": "确实是。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:48:18",
            "content": "本日はどのようなことが一番相談したい点になりますか？",
            "Chinese": "今天您最想咨询的重点是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:48:51",
            "content": "気にしすぎてしまうので、評価を怖がらなくなりたいですね",
            "Chinese": "因为我太在意了，所以希望自己不再害怕评价。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:49:52",
            "content": "かしこまりました。ではその目標に向けて一緒に考えていきましょうね。",
            "Chinese": "好的，我明白了。那么我们就朝着这个目标一起思考吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:50:02",
            "content": "はいお願いします",
            "Chinese": "好的，拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:50:45",
            "content": "ちなみに、カウンセラーの仕事をやりたいと思ったきっかけはどんなものですか？",
            "Chinese": "顺便问一下，您想从事咨询师工作的契机是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:50:54",
            "content": "自分が学生の頃",
            "Chinese": "在我学生时期，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:50:58",
            "content": "辛かった時",
            "Chinese": "在我很痛苦的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:51:02",
            "content": "はい、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:51:07",
            "content": "コーチングやカウンセリングを仕事にしている方に救われて",
            "Chinese": "被从事教练技术或心理咨询工作的人拯救过，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:51:11",
            "content": "そこから目指すようになりました",
            "Chinese": "从那之后我就开始以此为目标了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:51:22",
            "content": "そうなんですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:51:27",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:52:13",
            "content": "ご自身が救われた経験から、今度は自分が目指す職業になったのですね。",
            "Chinese": "因为自己曾被拯救过，所以现在也把这个当成了自己追求的职业，是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:52:21",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:52:52",
            "content": "教えていただきありがとうございます。",
            "Chinese": "感谢您的分享。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:53:08",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:53:34",
            "content": "話が少し戻ってしまいますが、",
            "Chinese": "我们稍微回到之前的话题，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:54:18",
            "content": "周りからの目や評価を気にしすぎてしまうのは、",
            "Chinese": "关于过度在意他人的目光和评价，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:54:49",
            "content": "何か理由みたいなものはありそうですか？",
            "Chinese": "您觉得有什么可能的原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:55:13",
            "content": "うーん",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:55:34",
            "content": "たぶん",
            "Chinese": "大概是，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:55:40",
            "content": "幼稚園行ってたときに",
            "Chinese": "上幼儿园的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:55:41",
            "content": "ええ、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:56:00",
            "content": "サッカーチームのユニホームみたいな服を着て一回行ったことがあって",
            "Chinese": "有一次我穿了一件像足球队队服一样的衣服去了幼儿园。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:56:07",
            "content": "それをみんなにすごく馬鹿にされたんですね",
            "Chinese": "结果被大家狠狠地嘲笑了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:56:14",
            "content": "それで結構傷ついた記憶があって",
            "Chinese": "因此留下了很受伤的记忆，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:56:17",
            "content": "ええ…",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:56:27",
            "content": "すごく恥ずかしい気持ちになったので",
            "Chinese": "当时感到非常羞耻，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:56:30",
            "content": "そこからかなとは思います",
            "Chinese": "我想可能就是从那时开始的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:57:36",
            "content": "そうだったんですね。みんなにすごく馬鹿にされたら、それは傷つきますね。。。",
            "Chinese": "原来如此。被大家那样嘲笑，确实会很受伤呢……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:57:50",
            "content": "はい、当時はすごく傷ついたと思います",
            "Chinese": "是的，我想当时真的很受伤。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:58:31",
            "content": "そうだったんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:58:37",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 12:58:55",
            "content": "傷つくのは無理がないと思います。",
            "Chinese": "会受伤也是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:58:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 12:59:02",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:00:03",
            "content": "サッカーのユニホームだってファッションの一部ですからね。否定される筋合いはないですよね。",
            "Chinese": "足球队的队服也算是时尚的一部分嘛。并没有被否定的道理。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:00:13",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:01:00",
            "content": "でも平気でバカにするような発言をするような子もいますね。",
            "Chinese": "但是，也确实有些孩子会若无其事地说出嘲笑别人的话。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:01:10",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:02:16",
            "content": "今までのお話の他にも、評価を気にしすぎてしまう時はありますか？",
            "Chinese": "除了刚才提到的情况之外，还有其他会过度在意评价的时候吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:03:35",
            "content": "特にないですかね",
            "Chinese": "倒也没有了吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:04:01",
            "content": "承知しました。",
            "Chinese": "明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:04:51",
            "content": "今まで、",
            "Chinese": "到目前为止，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:04:57",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:05:18",
            "content": "フィードバックもらうときなど、",
            "Chinese": "比如在收到反馈的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:05:45",
            "content": "否定されてる気持ちになるとのことでしたが、",
            "Chinese": "您提到会觉得像被否定，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:06:14",
            "content": "そのあとはどんな気分になったりしますか？",
            "Chinese": "之后您的心情一般会怎样呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:07:11",
            "content": "きぶん、、そうですね、、",
            "Chinese": "心情嘛……这个……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:07:35",
            "content": "まあでもボジティブに",
            "Chinese": "不过我会尽量积极一点，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:07:44",
            "content": "はい、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:07:46",
            "content": "評価が自分を成長させるから、",
            "Chinese": "觉得评价能让我成长，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:07:56",
            "content": "大丈夫って言い聞かせるようにはしてます",
            "Chinese": "所以我会不断对自己说‘没关系’。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:08:12",
            "content": "なるほどですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:08:53",
            "content": "成長するための大事なフィードバックですからね。",
            "Chinese": "毕竟那是为了成长所需的重要反馈。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:09:16",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:10:03",
            "content": "大丈夫って言い聞かせるのは、気持ち的にうまくいってる感じですか？",
            "Chinese": "这样安慰自己，情绪上会有好转吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:10:10",
            "content": "うーん",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:10:15",
            "content": "あんまり効果はないかなって感じです",
            "Chinese": "感觉效果不太好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:10:24",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:11:12",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:11:44",
            "content": "だと、今まではポジティブに言い聞かせたり、試してはきたが、",
            "Chinese": "也就是说，到目前为止，您虽然尝试过积极地劝说自己，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:11:48",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:12:07",
            "content": "あまり効果が得られなかったという感じなのでしょうか。",
            "Chinese": "但效果并不明显，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:12:14",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:12:34",
            "content": "そうなんですね。",
            "Chinese": "我了解了。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:12:58",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:13:33",
            "content": "気にしすぎなかったり、評価を怖がらなくなるといのは、",
            "Chinese": "如果能不过度在意、不再害怕评价，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:13:47",
            "content": "あなたにとってどんなイメージですか？",
            "Chinese": "对您来说会是怎样的状态呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:13:58",
            "content": "うーん",
            "Chinese": "嗯……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:14:09",
            "content": "どんなイメージ。。",
            "Chinese": "会是什么样的状态呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:14:41",
            "content": "例えば、",
            "Chinese": "比如说，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:14:45",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:15:13",
            "content": "今評価を気にしたな、と自覚して気持ちを切り替えたり",
            "Chinese": "觉察到“自己又在意评价了”，然后切换一下心情，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:15:20",
            "content": "とかでしょうか。",
            "Chinese": "类似这样的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:15:31",
            "content": "そーですね。。",
            "Chinese": "是啊……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:15:38",
            "content": "自覚はめっちゃしてるので",
            "Chinese": "我其实非常能自我觉察，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:15:46",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:16:19",
            "content": "評価も糧になると思い、ありがたくどんな評価も受け取るイメージが理想ですが",
            "Chinese": "理想的状态是能将评价视为成长的养分，欣然接受各种反馈，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:16:24",
            "content": "そう頭ではわかっていても",
            "Chinese": "虽然道理上明白，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:16:32",
            "content": "なかなか心が納得いかない部分がありますね",
            "Chinese": "但心里还是有无法接受的部分。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:16:39",
            "content": "はい、",
            "Chinese": "嗯，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:17:26",
            "content": "ありがたくどんな評価も受け取るイメージという理想が持っておられ、",
            "Chinese": "您抱着“感激地接受任何评价”这样一种理想状态，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:17:50",
            "content": "でも心が納得いかない部分もあるということですね。",
            "Chinese": "但同时心里也有无法接受的部分，是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:17:59",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:18:28",
            "content": "そうですよね。",
            "Chinese": "可以理解。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:18:50",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:19:25",
            "content": "フィードバックだって今後のための改善点とわかっているけど、でも傷つきたくないし、",
            "Chinese": "虽然知道反馈是为了今后改进，但还是不想受伤，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:20:10",
            "content": "気にしなきゃいいというのは、頭でわかっていても気になったり、評価が怖かったりとかありますよね。",
            "Chinese": "道理上明白“不要在意就好”，但还是会很在意，会害怕评价，有这样的情况吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:20:26",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:21:05",
            "content": "なかなか心が納得いかない部分というのはそのような感じですか？",
            "Chinese": "您说的“心里无法接受的部分”，是像我刚才说的那种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:21:37",
            "content": "そのような感じとはなんでしょうか？",
            "Chinese": "您所说的“类似这种感觉”具体是指什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:22:17",
            "content": "なかなか心が納得いかない部分というのは、気にしなきゃいいというのは頭でわかっていても気になったり、評価が怖かったり",
            "Chinese": "我说的“心里无法接受的部分”是指，道理上明白“不要在意就好”，但还是会很在意，会害怕评价，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:22:26",
            "content": "ということでしょうか？",
            "Chinese": "是这个意思吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:22:40",
            "content": "いえ、そこではなく",
            "Chinese": "不，不是那个意思，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:22:49",
            "content": "はい、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:22:56",
            "content": "評価って誰でも傷つくもんじゃないかな？って言う",
            "Chinese": "而是觉得，被评价难道不是谁都会受伤的吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:23:10",
            "content": "傷つくことを気にしなくていいんじゃないかなって言う気持ちですね",
            "Chinese": "所以，是不是不用太在意受伤这件事呢？我是这样想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:23:37",
            "content": "そういうことなんですね。",
            "Chinese": "原来是这个意思啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:23:50",
            "content": "そこまでポジティブに無理に捉えようとしなくてもいいんじゃない？って感じですかね",
            "Chinese": "大概就是，是不是不用勉强自己那么积极地去看待这件事呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:24:12",
            "content": "なるほどですね。",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:24:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:25:03",
            "content": "確かに例えば、落ち込んでいたときに、",
            "Chinese": "确实是这样。比如说，在情绪低落的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:25:36",
            "content": "無理にポジティブになろうとしたって、ポジティブにはなれないですからね。",
            "Chinese": "再怎么勉强自己积极起来，也很难真的积极得起来。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:25:44",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:26:30",
            "content": "子どもの時の楽しく遊んでいる時とか、",
            "Chinese": "就像小时候开心地玩耍时，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:27:07",
            "content": "周りの人とか評価とか気にしていないですもんね。",
            "Chinese": "根本不会在意周围的人或他们的评价。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:27:13",
            "content": "そうですね",
            "Chinese": "确实。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:27:42",
            "content": "それと同じように、というと語弊があるかもしれないですが、",
            "Chinese": "这么说可能不太恰当，但就像那样，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:28:31",
            "content": "昨日の自分から一歩だけでも成長したと思える自分を評価してあげるのはいかがですか？",
            "Chinese": "不妨去肯定一下“比昨天的自己哪怕只进步了一小步”的自己，您觉得如何？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:28:45",
            "content": "そうですね",
            "Chinese": "也对。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:29:02",
            "content": "自分が成長した部分は自分しかわからないので",
            "Chinese": "自己成长了哪些地方，只有自己最清楚，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:29:12",
            "content": "ええ、",
            "Chinese": "嗯，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:29:12",
            "content": "その評価を相手に求めると言うよりは",
            "Chinese": "所以与其向别人寻求这种评价，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:29:17",
            "content": "自分でしてあげるのはいいですね",
            "Chinese": "不如自己给予自己肯定，这样很好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:29:44",
            "content": "あなたのことを今一番評価していいのは、",
            "Chinese": "现在最有资格评价您的，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:29:55",
            "content": "あなた自身ですからね。",
            "Chinese": "正是您自己啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:30:01",
            "content": "そうですね",
            "Chinese": "确实。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:30:11",
            "content": "評価を気にしたりする時って、",
            "Chinese": "当我们在意评价的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:30:41",
            "content": "どうしても周りの評価を一番上にしちゃうので、",
            "Chinese": "总是会不自觉地把周围的评价放在第一位，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:31:32",
            "content": "評価を自分自身でするってとても肯定感も上がりますし、",
            "Chinese": "所以自己评价自己，不仅能大大提升自我肯定感，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:32:11",
            "content": "もしあなたがカウンセラーになったら、クライアントに伝えて欲しい言葉です。",
            "Chinese": "如果您成为心理咨询师，这也是您想对来访者说的话吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:32:23",
            "content": "はい、ありがとうございます",
            "Chinese": "是的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:32:41",
            "content": "何かご質問はありますか？",
            "Chinese": "您还有什么问题吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:32:50",
            "content": "大丈夫です",
            "Chinese": "没有了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:33:08",
            "content": "少しは参考になりましたでしょうか。",
            "Chinese": "希望能对您有所帮助。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:33:16",
            "content": "はい、ありがとうございました",
            "Chinese": "是的，非常感谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:34:13",
            "content": "ありがとうございます。自分自身の評価するのは自分に甘くなるわけではないので、ぜひ参考にしてみてください。",
            "Chinese": "谢谢您。由自己来评价自己并不等于对自己放纵，请不妨参考试试看。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:34:34",
            "content": "はい、今日はありがとうございました",
            "Chinese": "好的，今天非常感谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/18(水) 13:35:37",
            "content": "それではこれで終了させていただきます。あなたのこれからを応援しています。",
            "Chinese": "那么本次咨询就到此结束。我支持您未来的发展。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/18(水) 13:35:55",
            "content": "お疲れ様でした。",
            "Chinese": "您辛苦了。"
        },
        {
            "role": "カウンセラー",
