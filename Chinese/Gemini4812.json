{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 12:53:37",
            "content": "（こんにちは。相談員役です。本日はよろしくお願いいたします。時間になりましたら始めさせていただきます。）",
            "Chinese": "（您好。我扮演的是咨询员。今天请多多关照。时间到了我们就开始吧。）"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 12:54:36",
            "content": "（こちらこそよろしくお願い致します。承知しました。）",
            "Chinese": "（我也请您多多关照。明白了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:00:14",
            "content": "こんにちは。相談員です。ご相談にお越しいただきありがとうございます。はじめに年齢と性別、今日の相談内容を教えていただけますか。",
            "Chinese": "您好。我是咨询员。感谢您前来咨询。首先，请问能告诉我您的年龄、性别以及今天的咨询内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:00:36",
            "content": "高校生　女性",
            "Chinese": "高中生，女性。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:00:46",
            "content": "お母さんが怖い",
            "Chinese": "妈妈很可怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:01:18",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:01:55",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:02:09",
            "content": "怖いというとキツく怒ってきたりとか、具体的にどんな感じなのでしょうか？",
            "Chinese": "您说可怕，是指她会严厉地对您发火之类的吗？具体是什么样的情况呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:02:34",
            "content": "物を投げてきたりする",
            "Chinese": "她会朝我扔东西。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:03:27",
            "content": "そんなことが・・・そんなことをされたら悲しくなりますね。",
            "Chinese": "竟然会这样……被这么对待，一定会很难过吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:03:42",
            "content": "怪我はなかったのでしょうか？",
            "Chinese": "您没有受伤吧？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:03:43",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:03:49",
            "content": "大丈夫",
            "Chinese": "没事的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:04:32",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:04:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:05:52",
            "content": "怪我をしていないなら良かったですが、ちなみに、どんな時にあなたに物を投げられたりしてくるのでしょうか？",
            "Chinese": "没有受伤就好。顺便问一下，她一般在什么情况下会朝您扔东西呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:06:11",
            "content": "機嫌が悪い時",
            "Chinese": "她心情不好的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:06:52",
            "content": "ええ。それはお母さんの機嫌でしょうか？",
            "Chinese": "嗯。是指您母亲的心情吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:07:17",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:08:17",
            "content": "そうだったんですね。お母さんの機嫌で、あなたに八つ当たりしてくるなんて理不尽に感じてしまいますね。",
            "Chinese": "原来是这样啊。因为母亲心情不好就拿您出气，这确实让人觉得很不讲道理呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:08:46",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:08:56",
            "content": "あなたは何も悪くありませんからね。",
            "Chinese": "这完全不是您的错。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:09:30",
            "content": "昨日はテレビのリモコン投げてきた",
            "Chinese": "昨天她朝我扔了电视遥控器。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:09:54",
            "content": "今日は洗濯物を投げてきた",
            "Chinese": "今天她朝我扔了洗好的衣物。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:11:10",
            "content": "ええ・・・本当に怖かったですよね・・・",
            "Chinese": "嗯……那一定真的很害怕吧……"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:11:22",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:12:13",
            "content": "お母さんが機嫌悪くなると、物を投げてきたり以外にも何かあるのでしょうか？（例えば、怒鳴ったりとか）",
            "Chinese": "您母亲心情不好的时候，除了扔东西，还会有其他行为吗？（比如，大吼大叫之类的）"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:12:38",
            "content": "イライラするとあたってきたりする",
            "Chinese": "她一烦躁就会拿我出气。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:12:56",
            "content": "怒鳴ることもある",
            "Chinese": "也会吼我。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:14:04",
            "content": "そうでしたか・・・。物を投げられるだけでも怖いのに。心が痛みますよね。",
            "Chinese": "是这样啊……光是被扔东西就已经很可怕了，心里一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:14:43",
            "content": "うん、怖い",
            "Chinese": "嗯，很害怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:16:28",
            "content": "ええ。そんな中、よく誰かに相談しようと思ってくれて良かったです。あなたが少しでも楽になるために一緒に考えて行きましょうね。ちなみに、お母さんの物を投げたり、怒鳴ったりは、いつ頃からあったのでしょうか？",
            "Chinese": "嗯。在这样的情况下，您能想到要找人倾诉，真的很好。为了让您能轻松一些，我们一起来想办法吧。顺便问一下，您母亲扔东西、大吼大叫的行为，大概是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:17:00",
            "content": "中学の頃から",
            "Chinese": "从初中开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:18:20",
            "content": "そうなんだ。ずっと怖い思いを抱えているんですね。",
            "Chinese": "是这样啊。您一直承受着这样的恐惧呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:18:54",
            "content": "でもお母さんと2人だから",
            "Chinese": "但是家里只有我和妈妈两个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:19:17",
            "content": "そっか。お母さんと二人暮らしなんですね。",
            "Chinese": "这样啊。您和妈妈两个人一起生活呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:19:20",
            "content": "お母さん私しかいないから",
            "Chinese": "因为妈妈只有我了。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:19:32",
            "content": "そう",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:20:45",
            "content": "お母さんのこと、怖い以外には、どう思っているのかな？",
            "Chinese": "对于您的母亲，除了害怕之外，您还有什么样的感觉呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:21:04",
            "content": "よくわからない",
            "Chinese": "我也不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:21:50",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:21:57",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:22:35",
            "content": "普段、お家でどんな感じで過ごしているんですか？",
            "Chinese": "平时在家里，您们是怎么相处的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:23:04",
            "content": "お母さんと2人で過ごしてる",
            "Chinese": "就我和妈妈两个人一起过。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:24:07",
            "content": "そうなんだ。お母さんとよく喋ったりするのかな？",
            "Chinese": "是这样啊。您和妈妈经常聊天吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:24:30",
            "content": "今はあまり話さないようにしてる",
            "Chinese": "现在我尽量不怎么和她说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:24:57",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:25:03",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:26:12",
            "content": "中学の時から怖い思いをしたと思うけど、これまで誰に相談してきたのでしょうか？",
            "Chinese": "我想您从初中开始就一直感到害怕，那您至今有和谁谈过这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:26:40",
            "content": "一度高校の先生に話したけど",
            "Chinese": "曾经跟高中的老师说过一次，但是……"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:26:58",
            "content": "周りに話したりして",
            "Chinese": "但他却跟周围的人说了。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:27:06",
            "content": "信用できない",
            "Chinese": "没法信任了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:28:12",
            "content": "そうでしたか。せっかく相談したのに、そんなことをされたら嫌ですよね。",
            "Chinese": "是这样啊。好不容易鼓起勇气倾诉，却被那样对待，一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:28:19",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:29:13",
            "content": "話が戻りますが、物を投げてきたりするのは、週にどのくらいあるのですか？",
            "Chinese": "回到之前的话题，她扔东西的频率大概是每周几次呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:29:27",
            "content": "週に4回ぐらい",
            "Chinese": "大概一周四次左右。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:29:39",
            "content": "その時による",
            "Chinese": "也要看当时情况。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:31:10",
            "content": "そうだったんですね。しんどい思いをいつもしているのですね。",
            "Chinese": "原来是这样。您一直都过得很辛苦呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:32:12",
            "content": "怒鳴られるときは、どんなことを言われるんですか？",
            "Chinese": "被吼的时候，她都会说些什么呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:35:57",
            "content": "言いづらいことは言わなくて大丈夫ですからね。",
            "Chinese": "如果有难以启齿的事情，不说也没关系的。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:40:17",
            "content": "いろいろあるから",
            "Chinese": "说得很多很杂。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:41:20",
            "content": "ええ。辛いことを思い出させてしまってすみません。",
            "Chinese": "嗯。让您回想起痛苦的事情，非常抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:41:27",
            "content": "家事ができてないと怒られる",
            "Chinese": "家务没做好就会被骂。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:42:07",
            "content": "お母さん仕事が忙しいから",
            "Chinese": "因为妈妈工作很忙。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:42:19",
            "content": "そうだったんですね。家事はあなたがいつも担当してるのかな？",
            "Chinese": "是这样啊。家务活平时都是您负责的吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:42:40",
            "content": "お母さんが遅いとしてる",
            "Chinese": "妈妈回家晚的时候我会做。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:44:02",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:44:30",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:46:16",
            "content": "家事もやっていてとなると、遊ぶ時間とかはあるのですか？",
            "Chinese": "如果还要做家务的话，那您有时间玩或放松吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:46:49",
            "content": "あんまりないかも",
            "Chinese": "可能不太有。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:48:12",
            "content": "そうなんだ。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:48:27",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:49:24",
            "content": "今、溜め込んでいるストレスとかはどんなことがあるのかな？",
            "Chinese": "您现在积压的压力，都有哪些呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:49:36",
            "content": "よくわからない",
            "Chinese": "我也不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:50:01",
            "content": "そっか。",
            "Chinese": "这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:50:35",
            "content": "好きな音楽を聴いたり、趣味の時間とかはあるのかな？",
            "Chinese": "您会听喜欢的音乐，或者有属于自己的兴趣时间吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:51:36",
            "content": "部屋が狭いし",
            "Chinese": "房间很小，而且……"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:51:49",
            "content": "一緒にいる時はムリ",
            "Chinese": "跟她在一起的时候不行。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:53:00",
            "content": "そうなんですね。ちなみに、今高校何年生で、卒業後の進路はどう考えているのですか？",
            "Chinese": "是这样啊。顺便问一下，您现在是高中几年级，毕业后有什么打算呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:53:22",
            "content": "学年は言いたくない",
            "Chinese": "我不想说几年级。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:53:33",
            "content": "就職したい",
            "Chinese": "我想找工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:54:13",
            "content": "そにのように考えているんですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:54:27",
            "content": "そのように、です。すみません。",
            "Chinese": "是“那样”。不好意思，刚才说错了。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:54:40",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:55:11",
            "content": "ここまで、大切なお話を聞かせてくれてありがとうございます。",
            "Chinese": "谢谢您告诉我这么多重要的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/03/26(日) 13:57:02",
            "content": "お母さんの機嫌が悪いときとか、家事の負担とか、本当にしんどいですよね。",
            "Chinese": "母亲心情不好的时候，还有家务的负担，真的让您很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/03/26(日) 13:57:28",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
