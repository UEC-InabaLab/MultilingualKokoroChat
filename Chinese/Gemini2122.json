{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:01:18",
            "content": "よろしくお願いいたします",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:04:13",
            "content": "遅くなってごめんなさい",
            "Chinese": "抱歉让您久等了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:04:28",
            "content": "よろしくお願いいたします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:05:12",
            "content": "今から始めてもよろしいでしょうか？",
            "Chinese": "请问现在可以开始了吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:05:21",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:05:37",
            "content": "こんにちは、相談員です",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:05:57",
            "content": "今日はどのようなご相談でしょうか？",
            "Chinese": "今天您想咨询些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:06:19",
            "content": "学校に行きたくない",
            "Chinese": "我不想上学。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:06:33",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:06:57",
            "content": "どんなことが嫌で学校に行きたくないのでしょうか？",
            "Chinese": "是因为学校里有什么讨厌的事情，才不想去的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:07:33",
            "content": "とにかく行く気にならない",
            "Chinese": "总之就是提不起劲去。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:07:46",
            "content": "そうでしたか",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:08:18",
            "content": "いやなのです",
            "Chinese": "就是很讨厌。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:09:31",
            "content": "いやでも行かなければって思うと辛いですよね",
            "Chinese": "明明很讨厌，却又觉得非去不可，这种感觉一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:10:09",
            "content": "うん…",
            "Chinese": "嗯……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:10:58",
            "content": "今は学校に行っていますか？それともお家ですごされていますか？",
            "Chinese": "您现在还去学校吗？还是待在家里呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:11:17",
            "content": "家です",
            "Chinese": "在家。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:11:28",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:12:23",
            "content": "いつ頃から学校に行っていないのでしょうか？",
            "Chinese": "您大概是从什么时候开始没去上学的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:12:54",
            "content": "ゴールデンウィークあけてから",
            "Chinese": "从黄金周结束之后开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:13:48",
            "content": "一月近く経つのですね",
            "Chinese": "已经快一个月了呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:15:36",
            "content": "きっかけとしては、どんなことが浮かびますか？",
            "Chinese": "您能想到有什么契机吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:16:28",
            "content": "きっかけ？毎日憂うつ",
            "Chinese": "契机？我每天都很忧郁。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:17:07",
            "content": "それは辛かったですね",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:18:39",
            "content": "毎日憂鬱だと、学校にいきたくなるのも無理はないと思います",
            "Chinese": "如果每天都感到很忧郁，不想去学校也是很自然的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:19:05",
            "content": "学校に行きたくなくなるのも無理はないと思います",
            "Chinese": "不想去学校也是可以理解的。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:19:06",
            "content": "そうだけど",
            "Chinese": "话是这么说，可是……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:19:24",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:20:45",
            "content": "学校で憂鬱だなと感じたのはどんなことでしたか？あるいはどんなときでしたか？",
            "Chinese": "在学校里，是哪些事情或在什么时候，会让您感到忧郁呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:21:10",
            "content": "友達",
            "Chinese": "朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:21:27",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:21:47",
            "content": "友達のどんなことが憂鬱だったのかな？",
            "Chinese": "是朋友的哪些方面让您感到忧郁呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:22:33",
            "content": "友達と話をしても楽しくない",
            "Chinese": "和朋友聊天也不开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:23:02",
            "content": "それは残念ですよね",
            "Chinese": "那确实让人挺失落的呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:24:19",
            "content": "どういうことで楽しくないのでしょうか？話が合わないという感じかな？",
            "Chinese": "具体是因为什么觉得不开心呢？是感觉聊不到一块儿吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:25:04",
            "content": "話をしても否定される",
            "Chinese": "我一说话就会被否定。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:25:45",
            "content": "否定されると気分が悪いよね",
            "Chinese": "总是被否定，心里会很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:26:14",
            "content": "例えばどんなことを否定されるのかな？",
            "Chinese": "比如说，会被否定些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:26:25",
            "content": "うん本当に嫌な気持ちになる",
            "Chinese": "嗯，真的感觉非常不舒服。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:27:28",
            "content": "そうだよね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:27:38",
            "content": "自分が言っていれのはまちがっていないのに",
            "Chinese": "明明我说的并没有错……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:27:48",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:28:54",
            "content": "友達の方が私より上だといわんばかりに否定される",
            "Chinese": "朋友总是用一种高高在上的语气来否定我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:30:16",
            "content": "そうなんですね上から目線はムカつきますよね",
            "Chinese": "是这样啊，那种高高在上的态度确实很让人火大呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:30:30",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:31:33",
            "content": "友達と意見が合わないことが多いとストレスが溜まりそうですね",
            "Chinese": "如果经常和朋友意见不合，压力会越积越多吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:32:01",
            "content": "ストレスたまってるよ",
            "Chinese": "压力已经超大了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:32:12",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:32:56",
            "content": "それで行きたくなくなってしまったのかもしれませんね",
            "Chinese": "也许就是因为这个才不想去学校的吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:33:56",
            "content": "それもそうだけど",
            "Chinese": "这算是一个原因，不过……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:34:14",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:34:56",
            "content": "（お聴きしていますね）",
            "Chinese": "（我正在认真倾听。）"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:37:02",
            "content": "みんなキライ",
            "Chinese": "我讨厌所有人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:37:41",
            "content": "そうか",
            "Chinese": "这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:38:17",
            "content": "それはしんどいですね",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:39:16",
            "content": "あなたが学校に行きたくない気持ちがよく解りました",
            "Chinese": "我非常理解您不想去学校的心情了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:39:38",
            "content": "家では毎日どんな風に過ごしているのですか？",
            "Chinese": "在家里，您每天是怎么度过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:40:27",
            "content": "パソコンで動画みたりしている",
            "Chinese": "用电脑看看视频之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:41:11",
            "content": "動画をみるのは楽しいですか？",
            "Chinese": "看视频会觉得开心吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:41:46",
            "content": "この頃飽きてきたかな",
            "Chinese": "最近感觉有点看腻了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:42:33",
            "content": "そうか毎日みてるとそうなるかもしれませんね",
            "Chinese": "是啊，每天都看的话，确实可能会腻呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:43:48",
            "content": "ちなみに、あなたの学年と性別をお聴きするのを忘れていました",
            "Chinese": "对了，我忘了问您的年级和性别了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:44:02",
            "content": "よろしかったら、教えていただけますか",
            "Chinese": "如果方便的话，可以告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:44:25",
            "content": "中学生の女子だよ",
            "Chinese": "我是初中女生。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:44:38",
            "content": "教えてくださりありがとうございます",
            "Chinese": "谢谢您告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:45:15",
            "content": "家ではどんなことを考えていますか？",
            "Chinese": "您在家的时候，一般会想些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:46:17",
            "content": "学校であったこと友達とのこと",
            "Chinese": "想的都是学校里的事，还有和朋友有关的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:46:32",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:47:19",
            "content": "そういうときは、どんな気持ちになりますか？",
            "Chinese": "那种时候，您是什么样的感受呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:48:08",
            "content": "どうしょうもない嫌な気持ち",
            "Chinese": "一种无可奈何又很讨厌的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:49:03",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:49:47",
            "content": "話を否定されたりして、嫌なことが多かったですからね",
            "Chinese": "毕竟总是被否定，经历了很多不愉快的事情呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:50:15",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:51:28",
            "content": "嫌なことを思い出してしまう、辛い日々を過ごされてきているのですね",
            "Chinese": "总是会回想起那些不愉快的事，您一直以来过得都很辛苦呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:52:00",
            "content": "ご家族に方とは、どんなお話をされていますか？",
            "Chinese": "您和家人会聊些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:53:08",
            "content": "お父さんもお母さんも仕事だし、帰り遅いし",
            "Chinese": "爸爸妈妈都要上班，回家也很晚。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:53:20",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:54:42",
            "content": "お話をあまりされていないということでしょうか？",
            "Chinese": "就是说，您跟他们不怎么聊天是吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:54:57",
            "content": "毎日つまらない",
            "Chinese": "每天都很无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:55:42",
            "content": "それはしんどいですね",
            "Chinese": "那一定很难受吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:56:51",
            "content": "あなたとしては、これからどうされたいですか？",
            "Chinese": "那您自己希望接下来怎么做呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 16:57:55",
            "content": "そんなのわからない考えないし",
            "Chinese": "我不知道，也不想去想。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 16:59:58",
            "content": "どうしたいかわからなくなってしまうのは、とてもやるせないですね",
            "Chinese": "变得不知道自己想怎么做，这确实会让人感到非常无助呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 17:01:16",
            "content": "お父さんもお母さんもみんなキライなのとにかく",
            "Chinese": "反正爸爸、妈妈……我讨厌所有人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 17:02:16",
            "content": "そうなんだ・・・",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 17:04:09",
            "content": "誰か一人でも好きな人がいるといいのだけれどねみんなキライと感じてしまうのは、本当に苦しいことだと思います",
            "Chinese": "哪怕只有一个喜欢的人也好啊。感觉所有人都很讨厌，想必真的非常痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 17:04:56",
            "content": "うん誰も好きじゃない",
            "Chinese": "嗯，谁我都不喜欢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 17:05:42",
            "content": "そうかそれはしいどいですよね",
            "Chinese": "这样啊，那确实很煎熬呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 17:06:14",
            "content": "身近な人以外でもいいので、好きな人とかいますか？",
            "Chinese": "除了身边的人，有喜欢的人吗？比如偶像之类的？"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 17:06:32",
            "content": "いないよ",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 17:07:51",
            "content": "あなたのとても、寂しくて、苦しい状況が伝わってきました",
            "Chinese": "我感受到了，您现在非常孤独和痛苦的处境。"
        },
        {
            "role": "クライアント",
            "time": "2021/07/02(金) 17:08:33",
            "content": "近くにいるおばさんが弁当持ってくるけど小言ばっかり",
            "Chinese": "住得近的阿姨会给我送便当，但总是唠叨个没完。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/07/02(金) 17:09:10",
