{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 09:54:23",
            "content": "本日はよろしくお願いします。時間になりましたら始めさせていただきます。",
            "Chinese": "今天请多关照。时间到了我们就开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 09:54:48",
            "content": "(こちらこそお世話になります。よろしくお願い致します。)",
            "Chinese": "(我也要麻烦您了。请多关照。)"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:00:14",
            "content": "こんにちは、相談員です。はじめに年齢、性別、本日の相談内容をお聞かせください。",
            "Chinese": "您好，我是咨询师。首先，请告诉我您的年龄、性别，以及今天想咨询的内容。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:01:24",
            "content": "16歳、男、学校辞めたい",
            "Chinese": "16岁，男，想退学。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:02:16",
            "content": "そうなのですね。高校を辞めたいということですね？いつ頃からそう思うようになったのですか？",
            "Chinese": "是这样啊。也就是说，你想从高中退学，对吗？大概从什么时候开始有这种想法的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:03:21",
            "content": "半年くらい前",
            "Chinese": "大概半年前。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:04:17",
            "content": "ということは入学して割とすぐにそう思ったのですね？何がきっかけがあったのでしょうか？",
            "Chinese": "也就是说，入学后没多久你就有这个想法了，是吗？是有什么契机吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:04:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:04:55",
            "content": "友達がいないから",
            "Chinese": "因为没有朋友。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:05:14",
            "content": "勉強もつまんない",
            "Chinese": "学习也很无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:06:46",
            "content": "なるほど。友達がいなくて勉強も面白くないのですね。中学からのお友達や顔見知りも全くいないのですか？",
            "Chinese": "原来如此。没有朋友，学习也觉得没意思，是吧。初中的朋友或熟人也一个都没有吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:07:20",
            "content": "いない",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:08:26",
            "content": "そうだったのですね。それは不安ですよね。",
            "Chinese": "是这样啊。那一定很不安吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:08:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:09:04",
            "content": "どういう時に一番辛いと感じますか？",
            "Chinese": "在什么时候会觉得最难受呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:09:48",
            "content": "休み時間1人でいる時",
            "Chinese": "课间休息一个人待着的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:11:53",
            "content": "休み時間の時が辛いのですね。その時、どういうことを考えますか？",
            "Chinese": "是在课间休息的时候会觉得难受啊。那个时候，你会想些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:12:47",
            "content": "早く帰りたい",
            "Chinese": "想早点回家。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:12:59",
            "content": "って思う",
            "Chinese": "会这么想。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:13:13",
            "content": "そうですよね。そう思っちゃいますよね。",
            "Chinese": "是啊，会这么想也是很自然的呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:13:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:15:00",
            "content": "他の時間はどうですか？",
            "Chinese": "其他时间怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:15:41",
            "content": "普通",
            "Chinese": "就那样吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:16:05",
            "content": "でも体育は嫌い",
            "Chinese": "但是讨厌体育课。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:16:55",
            "content": "座ってやる授業は大丈夫ということかな？体育は運動が苦手だから嫌いなの？",
            "Chinese": "是说坐着上的课就没问题吗？讨厌体育课是因为不擅长运动吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:18:22",
            "content": "勉強はつまんない体育は他の人と一緒にやるから嫌い",
            "Chinese": "学习很无聊，体育课是因为要和别人一起上，所以讨厌。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:19:08",
            "content": "そうなんだね。勉強はどういうところが嫌い？",
            "Chinese": "这样啊。学习具体是哪些地方让你不喜欢呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:19:53",
            "content": "つまんない",
            "Chinese": "很无聊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:21:35",
            "content": "なるほど。体育は他の人とやるから嫌いとのことだけど何か具体的に嫌な思いをしたことがあるのかな？",
            "Chinese": "原来如此。你说因为要和别人一起上，所以讨厌体育课。那是有过什么具体的不愉快的经历吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:21:59",
            "content": "友達いないから",
            "Chinese": "因为没有朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:23:22",
            "content": "そうなんだね。友達がいないと確かにつまらないよね。誰かと喋りたいよね。",
            "Chinese": "是这样啊。没有朋友确实会觉得无聊，也会想找个人聊聊天，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:24:07",
            "content": "わかんない友達いないとダメ？",
            "Chinese": "我不知道……没有朋友就不行吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:26:01",
            "content": "ダメじゃないと思うよ。一人が好きって人もたくさんいるよ。",
            "Chinese": "我觉得不是不行哦。喜欢独处的人也有很多呀。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:26:57",
            "content": "そうなんだ",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:28:09",
            "content": "そうだと思うよ。",
            "Chinese": "我也这么认为。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:29:00",
            "content": "でも学校に友達がいたらいいなと思うのかな？",
            "Chinese": "但是，你会不会想，如果在学校有朋友就好了呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:29:39",
            "content": "1人よりはいいかも",
            "Chinese": "可能比一个人要好一些吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:30:59",
            "content": "そうなんだね。でも今まで半年以上登校してたんだね。よく頑張っているね。",
            "Chinese": "是这样啊。不过，你已经坚持上学半年多了呢，真的很努力了。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:31:22",
            "content": "ありがとう",
            "Chinese": "谢谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:33:39",
            "content": "うん、本当によく頑張ってるね。これから友達が一人いればいいなとのお話だったけど、自分で何かこうしてみようかな？って思うようなことはあるのかな？もしあれば聞かせてくれないかな？",
            "Chinese": "嗯，你真的非常努力了。刚才你说如果能有一个朋友就好了，那你自己有没有想过可以试着做点什么呢？如果有什么想法，可以告诉我吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:34:46",
            "content": "わかんない",
            "Chinese": "我不知道。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:35:09",
            "content": "どうすればいい？",
            "Chinese": "我该怎么办？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:36:30",
            "content": "そうだね。例えば、君の周りで一人でいる子は誰か見かけたことはない？",
            "Chinese": "说的是呢。比如说，你有没有在周围看到过也是独自一人的同学？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:37:08",
            "content": "いない",
            "Chinese": "没有。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:37:21",
            "content": "みんなグループになってる",
            "Chinese": "大家都成群结队的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:37:54",
            "content": "そっか。みんなお友達になっているように見えるんだね。",
            "Chinese": "这样啊。看来在你眼里，大家好像都交到朋友了呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:38:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:38:57",
            "content": "部活は入っているの？",
            "Chinese": "有参加社团活动吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:39:13",
            "content": "入っていない",
            "Chinese": "没有参加。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:39:45",
            "content": "そうなんだね。中学の時はどうだったの？何かやってた？",
            "Chinese": "这样啊。那初中的时候呢？有做过什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:40:26",
            "content": "野球部だった",
            "Chinese": "以前是棒球部的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:40:53",
            "content": "高校では続けようと思わなかったのかな？",
            "Chinese": "上高中之后没有想过要继续吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:41:23",
            "content": "好きでやってたわけじゃないから",
            "Chinese": "因为并不是因为喜欢才参加的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:41:37",
            "content": "楽しくなかった？",
            "Chinese": "不觉得开心吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:42:35",
            "content": "楽しくない",
            "Chinese": "不开心。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:44:08",
            "content": "そうだったんだ。じゃあ好きなことや、やってみたいこととか楽しいなと思うことってあるかな？",
            "Chinese": "是这样啊。那么，有没有什么你喜欢做的事、想尝试的事，或者让你觉得开心的事呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:44:39",
            "content": "わかんない",
            "Chinese": "不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:46:02",
            "content": "まだわからないんだね。中学の時の友達や高校以外ではどうかな？",
            "Chinese": "还不知道啊。那和初中时的朋友相处，或者在高中以外的场合，怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:46:27",
            "content": "どうって？",
            "Chinese": "什么意思？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:47:59",
            "content": "楽しいって思うこと、何かあるかな？好きなことってある？",
            "Chinese": "有没有什么让你觉得开心的事呢？有什么喜欢做的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:48:27",
            "content": "ゲームとか",
            "Chinese": "比如游戏之类的吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:49:05",
            "content": "そうなんだね。ゲームが好きなんだね。楽しいよね。",
            "Chinese": "是这样啊，你喜欢游戏啊。是挺开心的呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:49:23",
            "content": "楽しいかどうかはわかんない",
            "Chinese": "不知道算不算开心。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:49:38",
            "content": "でも遊んだりはする",
            "Chinese": "但还是会玩。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:50:17",
            "content": "今一番好きなことは、強いて言えばゲームなんだね。オンラインでやったりしてるのかな？",
            "Chinese": "如果非要说的话，现在最喜欢的事就是游戏吧。会在线上玩吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:51:39",
            "content": "オンラインで遊んでる",
            "Chinese": "在线上玩。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:52:43",
            "content": "そうなんだね。そこでは友達いるんだね。",
            "Chinese": "是这样啊。那在游戏里有朋友吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:53:11",
            "content": "友達なのかな",
            "Chinese": "算是朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:53:14",
            "content": "わかんない",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:55:50",
            "content": "いろんな友達いていいと思うけどな。それに、いつも一緒にいたりする関係が友達ってわけでもないと思うけど。",
            "Chinese": "我觉得有各种各样的朋友也挺好的呀。而且，朋友也不一定非得是那种总要待在一起的关系。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:56:08",
            "content": "そうなんだ",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 10:56:52",
            "content": "どう思う？",
            "Chinese": "你怎么觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:57:16",
            "content": "そうかもしない",
            "Chinese": "也许是吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 10:57:27",
            "content": "しれない",
            "Chinese": "说不定。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 11:00:27",
            "content": "君はもう毎日登校してて充分頑張ってるよ。でもやっぱり友達欲しいなって思ったらもし一人でいる子を見かけた時、寒いね、とか少し声かけてみるのもいいかもしれないよ。どんなきっかけで仲良くなるかわからないから",
            "Chinese": "你每天坚持来学校，已经非常努力了。不过，如果还是觉得想要朋友的话，下次看到有独自一人的同学时，可以试着轻轻搭句话，比如“今天好冷啊”之类的，也许会不错哦。因为谁也不知道会因为什么契机而成为朋友。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 11:00:57",
            "content": "わかった",
            "Chinese": "我明白了。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 11:01:10",
            "content": "少し頑張ってみる",
            "Chinese": "我会试着稍微努力一下。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 11:03:29",
            "content": "きっと君なら少しずつ乗り越えられると思うな。応援してます。今日は時間になってしまったけどどうだったかな？今日は言いにくい話、話してくれてありがとう。またいつでも相談にきてね。待ってます。",
            "Chinese": "我相信你一定能一点点克服的，我支持你。今天时间差不多了，你感觉怎么样？谢谢你今天愿意跟我说这些难以启齿的话。随时都可以再来咨询，我等你哦。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 11:04:52",
            "content": "話聞いてくれてありがとう自分の話を聞いてくれる友達が欲しいなって思った",
            "Chinese": "谢谢你听我倾诉。我发现，我还是想要一个能听我说话的朋友。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 11:05:54",
            "content": "きっと一番いいタイミングでできると思うよ。君は一人じゃないからね。いつでもきてね。",
            "Chinese": "我相信你一定能在最合适的时机交到朋友的。你不是一个人哦，随时都可以来。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/15(金) 11:06:32",
            "content": "ありがとう",
            "Chinese": "谢谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/15(金) 11:07:10",
            "content": "（時間になりましたので、終了させていただきます。ありがとうございました。）",
            "Chinese": "(时间到了，本次咨询就到此结束。非常感谢。)"
        },
        {
