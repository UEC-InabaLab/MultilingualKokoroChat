{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:25:49",
            "content": "（こんにちは、本日はよろしくお願いいたします。時間になりましたら始めさせていただきますね。）",
            "Chinese": "（您好，今天请多关照。时间一到，我这边就开始了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:30:13",
            "content": "こんにちは、相談員です。はじめに年齢、性別、今日の相談内容を教えてください。",
            "Chinese": "您好，我是咨询师。首先，请告诉我您的年龄、性别和今天的咨询内容。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:31:08",
            "content": "６年、男",
            "Chinese": "6年级，男生。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:31:42",
            "content": "お兄ちゃんがたたく",
            "Chinese": "哥哥会打我。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:32:03",
            "content": "教えてくれてありがとうございます。",
            "Chinese": "谢谢你告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:32:23",
            "content": "それは、とても怖い思いをしましたね。",
            "Chinese": "那一定让你非常害怕吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:32:37",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:32:52",
            "content": "ケガの具合はどうですか？",
            "Chinese": "伤得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:33:18",
            "content": "あざになってる",
            "Chinese": "都成瘀伤了。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:33:28",
            "content": "おなかとか",
            "Chinese": "肚子什么的。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:33:34",
            "content": "うでとか",
            "Chinese": "胳膊什么的。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:33:40",
            "content": "せなかもいたい",
            "Chinese": "后背也疼。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:33:50",
            "content": "うんうん、それは、とても痛かったよね。",
            "Chinese": "嗯嗯，那一定很疼吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:34:12",
            "content": "お母さんとかには、そのことを伝えてるのかな？",
            "Chinese": "你把这件事告诉妈妈了吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:34:17",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:34:40",
            "content": "そうなんですね。なんて言ってくれましたか？",
            "Chinese": "这样啊。她怎么说的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:35:02",
            "content": "叩いてくるとき、お母さんもいる",
            "Chinese": "他打我的时候，妈妈也在。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:35:49",
            "content": "お母さんは、かばってくれないのかな？お兄ちゃんは、何年生？",
            "Chinese": "妈妈没有保护你吗？哥哥是几年级？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:36:59",
            "content": "お兄ちゃんはお母さんと来る",
            "Chinese": "哥哥是和妈妈一起来的。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:37:16",
            "content": "やめてって言うとひどくなる",
            "Chinese": "我说“别这样”就会变本加厉。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:38:09",
            "content": "それは、つらいねお母さんもたたいてくるの？",
            "Chinese": "那真是太痛苦了。妈妈也打你吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:38:52",
            "content": "お母さんはたたかない",
            "Chinese": "妈妈不打我。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:38:57",
            "content": "見てる",
            "Chinese": "她就看着。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:39:02",
            "content": "それかいなくなる",
            "Chinese": "或者走开。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:39:33",
            "content": "そうだったんですね。それは悲しいよね。",
            "Chinese": "原来如此，那真的让人很难过。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:40:02",
            "content": "ご家族のことを教えてくれますか？",
            "Chinese": "能跟我说说你的家庭情况吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:40:19",
            "content": "何人家族かな？",
            "Chinese": "家里有几口人呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:40:42",
            "content": "2人",
            "Chinese": "两个人。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:40:48",
            "content": "ぼくとおかあさん",
            "Chinese": "我和妈妈。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:41:30",
            "content": "うんうん、お母さんと、相談者様の２人暮らしなんですね。",
            "Chinese": "嗯嗯，就是你和妈妈两个人一起住，对吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:41:53",
            "content": "お母さんは、どんなお仕事をしてるのかな？",
            "Chinese": "妈妈是做什么工作的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:42:02",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:42:09",
            "content": "スーパーにいってる",
            "Chinese": "她在超市上班。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:42:33",
            "content": "そっか、何時に家に帰ってくるの？",
            "Chinese": "这样啊，她几点回家？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:43:03",
            "content": "夜",
            "Chinese": "晚上。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:44:00",
            "content": "それは、寂しいよね。夜、何時ぐらいにお母さんは帰ってくるの？",
            "Chinese": "那很孤单吧。妈妈晚上大概几点回来呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:44:16",
            "content": "わかんない",
            "Chinese": "不知道。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:44:25",
            "content": "僕が寝た後帰ってくる",
            "Chinese": "我睡着以后她才回来。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:44:55",
            "content": "そうだったんですね。夜ご飯とかはどうしてるのかな？",
            "Chinese": "是这样啊。那晚饭怎么办呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:45:40",
            "content": "自分でする",
            "Chinese": "我自己弄。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:46:27",
            "content": "すごいね、自分で作れるんだね。でもお母さんに作ってほしいよね。",
            "Chinese": "真厉害，能自己做饭了。不过还是希望妈妈能做给你吃吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:46:51",
            "content": "お母さんは、前は作ってくれた",
            "Chinese": "妈妈以前会做给我吃。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:47:07",
            "content": "お誕生日とか。おいしいの。ハンバーグ。",
            "Chinese": "比如生日的时候。很好吃的。汉堡肉。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:47:21",
            "content": "うんうん、そうなんだね。それは嬉しいよね。",
            "Chinese": "嗯嗯，是这样啊。那一定很开心吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:47:26",
            "content": "今は忙しいって。",
            "Chinese": "她说现在很忙。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:47:56",
            "content": "ハンバーグ好きなんだね。そうなんだね。お母さん忙しいんだね。",
            "Chinese": "你喜欢汉堡排呀。原来如此。妈妈现在很忙呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:48:16",
            "content": "お母さんのこと、好き？",
            "Chinese": "你喜欢妈妈吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:48:55",
            "content": "好き",
            "Chinese": "喜欢。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:49:12",
            "content": "うんうん、どんなところが好き？",
            "Chinese": "嗯嗯，你喜欢她哪些地方？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:49:58",
            "content": "手をつないでくれるの。時々。",
            "Chinese": "她会牵我的手。偶尔会。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:50:06",
            "content": "今は大きいからダメなんだって",
            "Chinese": "她说我现在长大了，就不行了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:50:57",
            "content": "そっか、そっか、それは嬉しいね。今は、してくれないんだね。もっとしてほしいよね。",
            "Chinese": "是吗，是吗，那很开心呢。现在不牵了啊。你很希望她能再多牵牵你的手吧。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:51:35",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:52:07",
            "content": "その、お兄ちゃんがたたいてくる時、お母さんはどんな顔してるかな？",
            "Chinese": "那个，哥哥打你的时候，妈妈是什么表情呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:52:53",
            "content": "わかんない",
            "Chinese": "不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:53:32",
            "content": "そうだよね、たたかれている時は自分を守ることでいっぱいだよね。",
            "Chinese": "是啊，被打的时候光顾着保护自己，根本顾不上看别的了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:54:13",
            "content": "そのお兄さんはどんな人かな？",
            "Chinese": "那个哥哥是个什么样的人呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:54:52",
            "content": "見た目とか。どうんな感じだろう",
            "Chinese": "外表看起来怎么样？感觉如何？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:54:58",
            "content": "お母さんが連れてくる人。",
            "Chinese": "是妈妈带来的人。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:55:10",
            "content": "見た目、怖い",
            "Chinese": "长得很吓人。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:55:13",
            "content": "いつも同じ人？",
            "Chinese": "总是同一个人吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:55:18",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:55:29",
            "content": "そうなんだね、見た目が怖いのね。",
            "Chinese": "是吗，长得吓人啊。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:56:49",
            "content": "口を大きく開ける",
            "Chinese": "他会张大嘴巴。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:56:56",
            "content": "痛い",
            "Chinese": "很疼。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:57:17",
            "content": "うんうん、そうだよね、痛いよね。相談者さんのお悩みは、叩かれたくないことで良いのかな？",
            "Chinese": "嗯嗯，是啊，很疼的。你的烦恼是，不希望再被打了，对吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:57:41",
            "content": "一番嫌なことはどんなこと？",
            "Chinese": "最讨厌的是什么事呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:58:10",
            "content": "嫌。来ないでほしい。",
            "Chinese": "讨厌。希望他不要来。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:58:22",
            "content": "うんうん、そうだよね。",
            "Chinese": "嗯嗯，是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:58:58",
            "content": "相談員の心配してることがあるのだけれど、伝えても良いですか？",
            "Chinese": "我有些担心的事情，想跟你说，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 11:59:19",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 11:59:29",
            "content": "ありがとうございます。",
            "Chinese": "谢谢你。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 12:00:05",
            "content": "相談者様のアザがとても心配です。叩かれていることがとても心配です。",
            "Chinese": "我很担心你身上的淤青。也很担心你被打这件事。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 12:00:33",
            "content": "どうしたら、叩かれることがなくなるだろうね。",
            "Chinese": "我们该怎么做才能不再被打呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 12:00:52",
            "content": "一緒に考えても良いですか？",
            "Chinese": "我们可以一起想想办法吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 12:00:54",
            "content": "わかんない",
            "Chinese": "不知道。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 12:00:59",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 12:01:14",
            "content": "ありがとう",
            "Chinese": "谢谢你。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 12:01:51",
            "content": "相談者様の家の近くに交番はありますか？",
            "Chinese": "你家附近有派出所吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 12:02:38",
            "content": "わかんない",
            "Chinese": "不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 12:04:05",
            "content": "そっか、うんうん。もし、交番を見かけたらそのアザをおまわりさんに見せてあげてほしいのだけれど、できそうですか？",
            "Chinese": "这样啊，嗯嗯。如果看到派出所的话，能把这些淤青给警察叔叔看一下吗？你可以做到吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 12:04:15",
            "content": "うん",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 12:04:45",
            "content": "でも交番がわからないよ",
            "Chinese": "但是我不知道派出所在哪。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 12:05:26",
            "content": "うん、ぜひそうしてくださいね。そうですよね。それから、担任の先生にもこのことを伝えられるかな？",
            "Chinese": "嗯，请一定要这么做哦。说的也是呢。那么，能把这件事告诉班主任老师吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 12:06:05",
            "content": "嫌。他の友達いるし。",
            "Chinese": "不要。还有别的同学在。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 12:06:31",
            "content": "なるほど、、、。知られてしまうのが心配なんだね？",
            "Chinese": "原来如此……是担心被别人知道吧？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 12:06:40",
            "content": "そう",
            "Chinese": "对。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 12:07:05",
            "content": "うんうん、そうだよね、知られるのは嫌だよね。",
            "Chinese": "嗯嗯，是啊，不想被别人知道呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 12:07:30",
            "content": "学校に、スクールカウンセラーはいるかな？",
            "Chinese": "学校里有心理咨询老师吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 12:07:48",
            "content": "たまに来てる？かも",
            "Chinese": "偶尔会来？也许有。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/09(金) 12:08:40",
            "content": "そうなんですね。スクールカウンセラーにこのことを伝えられそう？",
            "Chinese": "是这样啊。那能试着告诉学校的心理咨询师这件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/09(金) 12:09:16",
            "content": "見つけられたら、たぶん",
