{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 17:51:37",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 17:51:52",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 17:52:06",
            "content": "よろしくお願いいたします",
            "Chinese": "请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 17:52:14",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 17:52:59",
            "content": "お時間少し早いですが始めますか？時間ピッタリにいたしましょうか？",
            "Chinese": "时间稍微早了一点，我们现在就开始，还是等到了约定时间再开始呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 17:53:40",
            "content": "お任せします。どちらでも構いません。",
            "Chinese": "听您的安排，我都可以。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 17:54:51",
            "content": "ありがとうございますでは、お言葉にあまえて早速始めさせていただきますよろしくお願いいたします",
            "Chinese": "谢谢您。那我就恭敬不如从命，马上开始吧。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 17:54:59",
            "content": "お願いいたします。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 17:55:30",
            "content": "こんにちは、相談員ですよろしくお願いいたします",
            "Chinese": "您好，我是咨询员，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 17:55:36",
            "content": "お願いいたします。",
            "Chinese": "麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 17:56:12",
            "content": "ニックネームでも構いませんので何とお呼びすればよろしいでしょうか？",
            "Chinese": "用昵称也可以，请问我该怎么称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 17:56:32",
            "content": "みかと申します。",
            "Chinese": "我叫美香。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 17:57:13",
            "content": "ありがとうございますでは、みかさん今日はどのようなご相談でしょうか？",
            "Chinese": "谢谢您。那么，美香女士，今天您有什么事想咨询呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 17:57:42",
            "content": "仕事のことで悩んでいます。",
            "Chinese": "我因为工作上的事感到很烦恼。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 17:58:18",
            "content": "このまま続けるべきか。",
            "Chinese": "我是否应该继续做下去。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 17:58:28",
            "content": "そうなのですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 17:58:37",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 17:59:10",
            "content": "続けるべきか、後はどんな選択がありますか？",
            "Chinese": "除了继续做下去，还有其他什么选择呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:00:13",
            "content": "続けるか、職場を変えるか、辞めて違う職を探すか、といったところです",
            "Chinese": "要么继续做，要么换个工作，要么辞职再找其他工作，大概就是这几种选择。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:00:50",
            "content": "3選択でお悩みな感じなのですね",
            "Chinese": "看来您是在这三个选择之间犹豫不决呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:01:25",
            "content": "そうですね",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:02:06",
            "content": "このまま続けない。と思われたのは何か理由があるのですか？",
            "Chinese": "让您产生“不想再继续这样下去了”的想法，是有什么原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:02:33",
            "content": "そうですね",
            "Chinese": "嗯，是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:02:59",
            "content": "一言ではお伝えできないです。",
            "Chinese": "这不是一两句话能说清楚的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:03:45",
            "content": "そうでしたか人生の大事な選択肢に迫られておられる感じですね",
            "Chinese": "是这样啊。感觉您正面临着人生的重要抉择呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:04:00",
            "content": "そうなんですかね。",
            "Chinese": "是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:04:30",
            "content": "自分ではわかりません",
            "Chinese": "我自己也不清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:05:13",
            "content": "差支えなければ今のご職業はどんなジャンルなのですか？",
            "Chinese": "如果方便的话，可以告诉我您现在从事的是哪一类工作吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:05:50",
            "content": "介護職です。",
            "Chinese": "是护理工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:06:47",
            "content": "そうなのですね介護は肉体的にも精神的にもきついお仕事ですよね",
            "Chinese": "是这样啊。护理工作无论在身体上还是精神上，都是很辛苦的呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:06:55",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:07:38",
            "content": "よろしければ、みかさんのご年代を伺ってもよろしいでしょうか？",
            "Chinese": "如果方便的话，可以请问一下您的年龄段吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:07:53",
            "content": "40代です。",
            "Chinese": "40多岁。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:09:02",
            "content": "ありがとうございます40代というと、介護職は無理が効かなくなってくる感じではないでしょうか？",
            "Chinese": "谢谢您。说到40多岁，从事护理工作会不会开始感觉有些力不从心了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:10:27",
            "content": "体力的には問題なく、希望通りのシフト制ですので、無理という感じではないです",
            "Chinese": "体力上没有问题，而且是按我希望的排班制，所以并不觉得吃力。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:11:15",
            "content": "そうでしたか体力面では問題はないのですね",
            "Chinese": "是这样啊，体力方面没有问题呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:11:22",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:11:49",
            "content": "介護のお仕事は何年やっておられるのですか？",
            "Chinese": "您从事护理工作多少年了？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:12:07",
            "content": "10年程度です。",
            "Chinese": "大概10年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:12:28",
            "content": "10年も頑張られてこられたのですね",
            "Chinese": "您已经坚持了10年，真的很了不起。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:12:47",
            "content": "気がつけば10年でした。",
            "Chinese": "不知不觉就10年了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:13:38",
            "content": "10年もやっておられれば色々なご経験やご苦労もあったでしょね",
            "Chinese": "做了10年，想必您也经历了很多，吃了不少苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:13:54",
            "content": "そうですね。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:14:21",
            "content": "職場の環境は良い方だとは思います",
            "Chinese": "我觉得工作环境还算不错。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:14:34",
            "content": "そうでしたか",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:14:40",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:15:02",
            "content": "10年同じ職場だったわけですよね",
            "Chinese": "也就是说，您在同一个地方工作了10年，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:15:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:16:17",
            "content": "環境は良いけど、他に気になる事はおありでしたか？",
            "Chinese": "虽然环境很好，但还有其他让您在意的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:16:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:17:26",
            "content": "どんな事かお聞かせいただいてもよろしいでしょうか？",
            "Chinese": "可以和我说说是什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:18:22",
            "content": "色々な仕事を任せてもらい、やりがいを感じているのですが",
            "Chinese": "公司交给我各种各样的工作，我也觉得很有成就感，但是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:18:34",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:19:24",
            "content": "先輩方がいるにも関わらずリーダーを任され、気まずい思いをしています。",
            "Chinese": "明明有前辈在，我却被任命为负责人，感觉很尴尬。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:19:36",
            "content": "嫌がらせとかはないです",
            "Chinese": "并没有人刁难我。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:20:23",
            "content": "自分の立ち振舞いがよくわからず",
            "Chinese": "我只是不知道该如何自处。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:20:45",
            "content": "介護の仕事は特に好きとかではなく",
            "Chinese": "而且我也不是特别喜欢护理这份工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:20:54",
            "content": "みかさんがリーダーになられていることを先輩方に気が引けてしまわれておられるのですね",
            "Chinese": "您是因为自己当了负责人，对前辈们感到有些过意不去，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:21:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:21:43",
            "content": "将来自分の親の面倒が見れたらと思って始めた仕事なので。",
            "Chinese": "当初开始这份工作，是想着将来能照顾自己的父母。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:22:33",
            "content": "キャリアを積むか、辞めて違うことをするか迷います",
            "Chinese": "我很犹豫是该继续积累经验，还是辞职去做别的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:23:12",
            "content": "気が引けてる上に、介護のお仕事も特に未練がある訳でもなく、今後を考えてしまわれるきっかけだったのですね",
            "Chinese": "既对前辈感到过意不去，又对护理工作本身没有特别的留恋，这成了您思考未来的契机，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:23:23",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:24:32",
            "content": "もし、違う職業につくとしたらもう、しぼられているのですか？",
            "Chinese": "如果要从事其他职业，您已经有比较明确的方向了吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:24:59",
            "content": "そうですね",
            "Chinese": "算是有的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:25:26",
            "content": "好きなこと、趣味です。",
            "Chinese": "是我喜欢的事情，我的爱好。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:26:23",
            "content": "そうなんですねでも一方で10年頑張られた介護職もキャリアをつんでも良いかもともお思いでいらっしゃる",
            "Chinese": "是这样啊。但另一方面，您也觉得在坚持了10年的护理工作上继续发展事业或许也不错。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:26:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:27:00",
            "content": "好きなことだけで仕事になるのか。考えてしまいます。",
            "Chinese": "我总在想，光靠喜欢的事情能成为工作吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:27:42",
            "content": "趣味といえる好きな事が仕事に繋がるかのご不安もあられるのですね",
            "Chinese": "您也担心自己喜欢的、称得上是爱好的事情，是否能发展成工作，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:27:59",
            "content": "そうですね。",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:29:11",
            "content": "10年という長い期間積み重ねてこられた事とお好きな事では迷いも生じますね",
            "Chinese": "在坚持了10年之久的事情和自己喜欢的事情之间，确实会感到迷茫呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:29:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:29:50",
            "content": "色々考えてしまいます。",
            "Chinese": "会想很多。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:30:27",
            "content": "みかさんが、お好きな事をお仕事として成り立っておられる方は身近におられるのですか？",
            "Chinese": "在您身边，有把喜欢的事情做成工作的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:30:50",
            "content": "身近にはいません。",
            "Chinese": "身边没有。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:31:14",
            "content": "世の中的にはいると思いますが。",
            "Chinese": "但我想社会上是有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:31:18",
            "content": "何かでご覧になったことは？",
            "Chinese": "您有在什么地方看到过吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:31:56",
            "content": "すみません。",
            "Chinese": "抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:32:11",
            "content": "質問の意味がわかりません。",
            "Chinese": "我不太明白您问题的意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:33:38",
            "content": "失礼いたしましたテレビとか書籍とかでみかさんが好きなお仕事で成功されてる方をご存じかとの確認でした",
            "Chinese": "非常抱歉。我的意思是，您是否在电视或书籍上，知道有通过您喜欢的工作取得成功的人？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:33:48",
            "content": "すみません",
            "Chinese": "不好意思。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:34:17",
            "content": "そういうことですね",
            "Chinese": "原来是这个意思。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:34:39",
            "content": "はい。写真家です。",
            "Chinese": "是的。是摄影师。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:34:43",
            "content": "伝え方が悪くて申し訳ないです",
            "Chinese": "我的表达方式不好，非常抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:35:02",
            "content": "すみません",
            "Chinese": "不好意思。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/18(土) 18:35:04",
            "content": "おお！写真家さんでいらっしゃるのですね",
            "Chinese": "哦！原来是摄影师啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/18(土) 18:35:29",
