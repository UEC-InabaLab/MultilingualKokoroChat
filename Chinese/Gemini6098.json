{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 10:51:42",
            "content": "今日はよろしくお願いします。",
            "Chinese": "今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 10:53:10",
            "content": "(お世話になります。よろしくお願い致します。)",
            "Chinese": "（麻烦您了，请多多关照。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:01:41",
            "content": "こんにちは。相談員です。最初に、年齢、性別、ご相談内容を教えて下さい。",
            "Chinese": "您好，我是咨询员。首先，请告诉我您的年龄、性别以及您想咨询的内容。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:02:15",
            "content": "14歳、男、死にたいです",
            "Chinese": "14岁，男，我想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:03:11",
            "content": "そうなのですね…。それほと゛お辛いお気持ちなのですね。",
            "Chinese": "是这样啊……您的心情是如此痛苦啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:03:34",
            "content": "つらい",
            "Chinese": "很痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:03:43",
            "content": "苦しい",
            "Chinese": "很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:04:05",
            "content": "そうですよね。苦しいお気持ちもあって…。",
            "Chinese": "是啊，您的心情很痛苦……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:04:45",
            "content": "ここでは何でもお話し頂いて大丈夫ですよ。",
            "Chinese": "在这里，您可以畅所欲言，没关系的。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:05:20",
            "content": "苦しまずに死ぬ方法を教えてください",
            "Chinese": "请告诉我无痛苦的死法。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:05:39",
            "content": "もうつらいのは嫌だ",
            "Chinese": "我不想再这么痛苦下去了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:05:45",
            "content": "そのようにお考えなのですね。",
            "Chinese": "您是这样想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:06:16",
            "content": "今家の中とかにいらっしゃいますか?",
            "Chinese": "您现在是在家里吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:06:43",
            "content": "自分の部屋にいる",
            "Chinese": "在自己的房间里。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:07:36",
            "content": "そうでしたか。今苦しまれている状況を教えて頂いてよろしいですか?",
            "Chinese": "这样啊。可以告诉我您现在正经历的痛苦状况吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:08:43",
            "content": "話したくない死ぬ方法を教えてください",
            "Chinese": "我不想说。请告诉我怎么死。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:11:10",
            "content": "そのようにお考えなのですね。今日、食事は摂られました?",
            "Chinese": "您是这样想的啊。今天吃饭了吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:12:39",
            "content": "食べてない",
            "Chinese": "没吃。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:13:11",
            "content": "そうでしたか…。夜は眠れていますか?",
            "Chinese": "这样啊……晚上睡得着吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:13:41",
            "content": "眠れてない",
            "Chinese": "睡不着。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:14:28",
            "content": "そうなのですね…。それでは気持ちだけでなく、体もしんどいですよね。",
            "Chinese": "是这样啊……那不只是心情上，身体也一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:15:17",
            "content": "そうかもしない体の方は気にしてませんでした",
            "Chinese": "也许是吧。我之前没怎么在意身体。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:15:38",
            "content": "そういうお気持ちなんですね。14歳ということは、中学三年生でしょうか?",
            "Chinese": "原来是这种心情啊。14岁的话，是初三吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:16:01",
            "content": "2年生",
            "Chinese": "初二。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:17:37",
            "content": "そうだったんですね。同じことにとらわれていると、呼吸も浅くなりますので、一度深呼吸を2～3回やってみて下さい。",
            "Chinese": "原来是这样。如果一直纠结于同一件事，呼吸也会变浅，不妨试着做两三次深呼吸吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:18:02",
            "content": "してみました",
            "Chinese": "试了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:18:44",
            "content": "いくらか気持ちが楽になりそうですか?",
            "Chinese": "感觉心情有好一点吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:18:57",
            "content": "分からないです",
            "Chinese": "不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:19:56",
            "content": "そうですよね。何か温かい飲み物を飲めそうですか?",
            "Chinese": "是啊。能喝点热饮吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:20:51",
            "content": "何も口に入れたくない",
            "Chinese": "什么都不想吃，也不想喝。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:21:46",
            "content": "そうなのですね。あなたの心と身体が心配です。今のお部屋は暖かいですか?",
            "Chinese": "是这样啊。我很担心您的身心状况。您现在房间里暖和吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:22:32",
            "content": "普通",
            "Chinese": "一般吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:22:41",
            "content": "寒くはないです",
            "Chinese": "不冷。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:22:52",
            "content": "今、ご家族の方はお家にいらっしゃいますか?",
            "Chinese": "现在您的家人在家吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:23:24",
            "content": "いない仕事に行ってます",
            "Chinese": "不在，他们去上班了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:24:07",
            "content": "寒くないとのことで、良かったです。今のお気持ちをご家族の方に相談されました?",
            "Chinese": "不冷就好。您有跟家人倾诉过现在的心情吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:24:36",
            "content": "言えてない",
            "Chinese": "没能说出口。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:25:02",
            "content": "知られなくない",
            "Chinese": "不想让他们知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:25:23",
            "content": "そうでしたか…。お友達にはご相談されました?",
            "Chinese": "这样啊……那跟朋友倾诉过吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:25:45",
            "content": "友達はいないです",
            "Chinese": "我没有朋友。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:25:54",
            "content": "いないとダメですか？",
            "Chinese": "没有朋友不行吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:26:01",
            "content": "変ですか？",
            "Chinese": "很奇怪吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:26:12",
            "content": "そうなんですね。そんなことはないですよ。",
            "Chinese": "是这样啊。没有那回事的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:27:05",
            "content": "ここでは誰にもお話し出来ないことでも、何でもお話しして大丈夫ですよ。",
            "Chinese": "在这里，即使是不能对任何人说的事情，也都可以放心说出来。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:27:33",
            "content": "いじめられています",
            "Chinese": "我被霸凌了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:28:09",
            "content": "そうだったのですね。いつ頃からですか?",
            "Chinese": "是这样啊。从什么时候开始的？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:28:36",
            "content": "1年前から",
            "Chinese": "从一年前开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:29:17",
            "content": "ずっとお一人で抱えて、悩まれていらっしゃったのですね。",
            "Chinese": "这么久以来，您一直都是一个人扛着这些烦恼啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:29:47",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:29:53",
            "content": "つらいです",
            "Chinese": "很痛苦。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:29:58",
            "content": "もう死にたい",
            "Chinese": "我已经想死了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:30:38",
            "content": "いじめをする人は一人ですか?複数ですか?",
            "Chinese": "霸凌您的人是一个人，还是有好几个人？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:31:43",
            "content": "クラス全員",
            "Chinese": "全班同学。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:32:33",
            "content": "そうでしたか…。それでは苦しいお気持ちにもなりますよね。",
            "Chinese": "这样啊……难怪您会感到这么痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:33:08",
            "content": "学校は休んでいるのですか?",
            "Chinese": "您现在没去上学吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:33:32",
            "content": "行ってない",
            "Chinese": "没去。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:34:21",
            "content": "そうなのですね。行きたくないですよね。",
            "Chinese": "是这样啊。肯定不想去吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:34:36",
            "content": "考えるのも嫌だ",
            "Chinese": "连想都不愿意想。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:35:02",
            "content": "そうですよね。そのようなお気持ちになりますよね。",
            "Chinese": "是啊，会有这种心情的吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:37:03",
            "content": "今は、行きたくない学校から離れても苦しさは続いているのですね?",
            "Chinese": "现在，即使离开了不想去的学校，痛苦也还在持续，是吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:37:54",
            "content": "生きているのもつらいですだから早く死にたい",
            "Chinese": "活着也很痛苦，所以我想快点死。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:39:20",
            "content": "そうなのですね…。学校に行かなければならないけど、行きたくない、そのような葛藤を抱えていらっしやるのでしょうか?",
            "Chinese": "是这样啊……您是不是正因为“必须去学校，但又不想去”而感到矛盾呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:40:43",
            "content": "考えてない苦しまずに死にたいだけです",
            "Chinese": "我没想那么多，只想不受痛苦地死去。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:41:44",
            "content": "そうでしたか。今はクラスメート達から遮断された環境にいらっしゃるのですね。",
            "Chinese": "这样啊。那您现在是处在一个和同学们隔绝的环境里，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:42:11",
            "content": "はいでも頭の中にいます",
            "Chinese": "是的，但他们还在我脑子里。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:43:58",
            "content": "そうなのですね。苦しいですよね。何か気分転換に出来ることはありますか?",
            "Chinese": "是这样啊，一定很痛苦吧。有什么可以用来转换心情的事吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:44:25",
            "content": "ない",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:46:05",
            "content": "そうでしたか。フリースクール等の、また違った環境の中で勉強をする方法もありますが、いかがですか?",
            "Chinese": "这样啊。其实，也可以考虑去“自由学校”之类的地方，在不同的环境里学习，您觉得怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:48:28",
            "content": "学校変わったところで",
            "Chinese": "就算换了学校……"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:49:00",
            "content": "どうせまたいじめられる",
            "Chinese": "反正还是会被霸凌。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:49:05",
            "content": "何も変わらない",
            "Chinese": "什么都不会改变。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:51:10",
            "content": "そうでしたか。学校に行かないということを選んでもいいと思いますよ。",
            "Chinese": "是这样啊。我觉得，选择不去上学也是可以的哦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:52:11",
            "content": "あなたの大切な命と引き換えに、無理に学校に行くことを選ぶことは無いと思いますよ。",
            "Chinese": "我认为没必要为了勉强去上学，而牺牲您宝贵的生命。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:52:43",
            "content": "たいした命じゃないです",
            "Chinese": "我的命不值钱。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:53:22",
            "content": "そんなことはないですよ。こうやってここにいらした勇気を持っていらして。",
            "Chinese": "没有那回事。您能像这样来到这里，本身就是一件很有勇气的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:54:47",
            "content": "一年間も頑張って学校に通われていたのですね。",
            "Chinese": "您努力坚持上学，也已经有一年了啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:55:19",
            "content": "最初は普通でした",
            "Chinese": "一开始还好。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:55:28",
            "content": "急にいじめられて",
            "Chinese": "突然就开始被霸凌了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:55:56",
            "content": "そうだったんですね。びっくりして、悲しいお気持ちでしたね。",
            "Chinese": "是这样啊。您一定感到很震惊，又很难过吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 11:56:07",
            "content": "何も分からないです",
            "Chinese": "我什么都不明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 11:56:39",
            "content": "そういうお気持ちなのですね。",
            "Chinese": "原来是这样的心情啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 12:00:26",
            "content": "あなたの気持ちが少しでも楽になれたらと思います。その勇気をもって環境を変えることにチヤレンジしてみませんか?",
            "Chinese": "我希望能让您的心情哪怕轻松一点点。要不要就凭着这份勇气，来挑战一下改变环境呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 12:00:53",
            "content": "無理です",
            "Chinese": "不可能的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 12:01:21",
            "content": "そうお思いなのですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 12:02:50",
            "content": "今は、傷ついた心の充電期間として、少しゆっくり休みませんか?",
            "Chinese": "现在，不如就把它当作是为受伤的心灵充电的时期，先好好休息一下，好吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/12/11(月) 12:04:06",
            "content": "何もしなくてもつらいです最後聞いてくれただけで十分ですさようなら",
            "Chinese": "就算什么都不做也很痛苦。最后能听我说这些，就足够了。再见。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/12/11(月) 12:05:41",
            "content": "（すみません、最後までたどりつけませんでした。終わりにしてもよろしいでしょうか?）",
            "Chinese": "（抱歉，没能进行到最后。可以结束了吗？）"
        },
        {
