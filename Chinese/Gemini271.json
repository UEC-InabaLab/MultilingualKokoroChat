{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 17:59:53",
            "content": "こんにわ相談員です。宜しくお願いします",
            "Chinese": "您好，我是咨询师。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:00:13",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:00:33",
            "content": "今日はどんなご相談でしたでしょうか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:01:02",
            "content": "自分の仕事のことで悩んでいます",
            "Chinese": "我正在为工作的事情烦恼。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:01:20",
            "content": "そうですか、、それは重要なことですね。。",
            "Chinese": "这样啊……那确实是很重要的事情呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:01:26",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:01:34",
            "content": "お仕事のどのようなお悩みですか？",
            "Chinese": "关于工作，您具体在烦恼哪些方面呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:01:55",
            "content": "何からお伝えしたらよいのか",
            "Chinese": "不太确定该从哪里说起。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:02:10",
            "content": "これまでと職場が変わり",
            "Chinese": "和之前相比，工作场所变了，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:02:13",
            "content": "はい、ゆっくりどうぞ",
            "Chinese": "好的，您慢慢说。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:02:19",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:02:26",
            "content": "働きにくくなりまして",
            "Chinese": "工作变得不太好开展了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:02:44",
            "content": "それは悩ましいですね",
            "Chinese": "那确实让人烦恼呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:03:03",
            "content": "どうように、働きにくくなったのでしょうか？",
            "Chinese": "具体是哪些方面，让您觉得工作困难了呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:03:06",
            "content": "ここの職場でなくてもよいかなと",
            "Chinese": "有时会想，或许不一定非要在这里工作。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:03:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:03:40",
            "content": "なるほど、、そのように考えちゃうわけですねー",
            "Chinese": "原来如此……会不由得这么想呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:03:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:03:56",
            "content": "どのように、、",
            "Chinese": "具体是怎样……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:04:05",
            "content": "働きにくくなったのか、、",
            "Chinese": "工作变得不顺心了呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:04:13",
            "content": "教えていただけますか？",
            "Chinese": "可以请您说说看吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:04:22",
            "content": "これまでは違う店舗で仕事をしていたのですが",
            "Chinese": "之前我一直在其他门店工作，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:04:30",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:04:50",
            "content": "コロナの影響で違う店舗に移ることになりまして",
            "Chinese": "受新冠疫情影响，我被安排调到别的门店，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:05:05",
            "content": "職場の環境が変わりました",
            "Chinese": "工作环境发生了变化。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:05:23",
            "content": "はい、コロナ禍での異動は大変ですよね",
            "Chinese": "是的，在疫情期间被调动工作，真的很辛苦呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:05:30",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:05:53",
            "content": "なるほど、、職場の環境がどのように変わったのでしょうか？",
            "Chinese": "原来如此，工作环境具体发生了哪些变化呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:06:34",
            "content": "一緒に働くメンバーが変わり",
            "Chinese": "一起工作的同事变了，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:06:42",
            "content": "はい、そうですよね",
            "Chinese": "嗯，是呢。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:07:15",
            "content": "店舗が変わったことよりも人間関係ですね",
            "Chinese": "与其说是门店的变化，不如说是人际关系方面的问题。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:07:24",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:07:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:07:50",
            "content": "お仕事の内容とか、やり方も変わった感じでっすか？",
            "Chinese": "工作内容或者做法方面，您感觉也有变化吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:08:17",
            "content": "仕事の内容は同じですが",
            "Chinese": "工作内容是一样的，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:08:25",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:08:48",
            "content": "店舗が変わってやり方は変わったと思います",
            "Chinese": "但因为门店变了，我觉得做事的方法也变了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:09:51",
            "content": "なるほど、ただでさえコロナで精神的に大変な中、異動で人間関係や仕事のやり方が変わるって、相当ご苦労されてますよね",
            "Chinese": "原来如此。本来疫情期间精神压力就很大了，又因为调动导致人际关系和工作方式都变了，您一定相当辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:10:02",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:10:50",
            "content": "好きな仕事が嫌になりそうです",
            "Chinese": "我快要对原本喜欢的工作产生厌烦了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:11:13",
            "content": "なるほど、、それは寂しい感じですね",
            "Chinese": "原来如此……那确实让人感到难过呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:11:22",
            "content": "ちなみに、、",
            "Chinese": "顺便问一下……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:11:24",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:11:27",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:12:02",
            "content": "どのような店舗をやられてるのか、何名くらいでお店をやってらっしゃるのか、",
            "Chinese": "您所在的门店是哪种类型的？大概有多少名员工？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:12:24",
            "content": "と、えだまめこさんの立場も教えていただけませんか？",
            "Chinese": "另外，能告诉我一下您的职位吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:12:33",
            "content": "どのような店舗ですか？",
            "Chinese": "您是指门店的类型吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:12:50",
            "content": "はい、、業種など",
            "Chinese": "是的……比如行业类别等。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:13:13",
            "content": "エステ関連で、スタッフは10名程度です",
            "Chinese": "是美容相关的，员工大概有10名。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:13:40",
            "content": "私は違う店舗の店長で",
            "Chinese": "我是另一家门店的店长，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:13:47",
            "content": "そうですか、、エステ店さんは需要が多く、お忙しいですよね、、",
            "Chinese": "这样啊……美容店的需求很大，应该很忙吧……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:13:58",
            "content": "そうですか、、店長さんですね",
            "Chinese": "原来如此……您是店长啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:13:59",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:14:25",
            "content": "すみません、、違う店舗の店長・・・とは？",
            "Chinese": "不好意思……您说的“另一家门店的店长”，是指？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:14:45",
            "content": "現在ホテルが休業中で違う店舗に移って働いています",
            "Chinese": "目前我所在的酒店正在停业，所以我被调到其他门店工作。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:15:05",
            "content": "本来はホテル内に店舗があります",
            "Chinese": "我们原本的门店是在酒店里的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:15:38",
            "content": "なるほど、、有難うございます。いまは臨時的に、違う店舗にいってらっしゃるわけですね",
            "Chinese": "明白了，谢谢您。也就是说，您现在是临时到另一家门店工作，是这样吧？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:15:51",
            "content": "そうなのです",
            "Chinese": "是的，就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:15:56",
            "content": "そうしますと、、",
            "Chinese": "这样的话……"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:16:00",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:16:55",
            "content": "人間関係と、仕事のやり方と、に今、違和感を感じてらっしゃるわけですね＞",
            "Chinese": "也就是说，您现在是对人际关系和工作方式感到不适应，是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:17:02",
            "content": "？",
            "Chinese": "对吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:17:10",
            "content": "はいそうです",
            "Chinese": "是的，没错。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:17:29",
            "content": "他にも、、気になる事とかございますか？",
            "Chinese": "除此之外，还有其他让您在意的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:18:27",
            "content": "恐らくその辺がモヤモヤしている原因だと思うのですが",
            "Chinese": "我想，这些大概就是我内心烦闷的原因吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:18:34",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:18:55",
            "content": "これまで感じたことのないモヤモヤで",
            "Chinese": "这是一种我从未有过的烦闷感。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:19:18",
            "content": "なるほど、、初めての感覚なのですね",
            "Chinese": "原来如此，是第一次有这种感觉啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:19:19",
            "content": "せっかく好きで始めた仕事なのに",
            "Chinese": "明明是因为喜欢才开始做的工作，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:19:25",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:19:25",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:19:43",
            "content": "嫌いになりそうで",
            "Chinese": "却好像要变得讨厌它了，"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:19:54",
            "content": "それも嫌な感じです",
            "Chinese": "这种感觉本身也让我很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:20:23",
            "content": "なるほど、、それほどの思いになってらっしゃるのですね",
            "Chinese": "原来如此……您已经到了这种程度了啊。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:20:29",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:20:47",
            "content": "ため息ばかりです",
            "Chinese": "我总是忍不住叹气。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:21:12",
            "content": "その初めての感覚のモヤモヤは、どんな時にそう感じられますか？",
            "Chinese": "您这种前所未有的烦闷感，通常是在什么时候感觉到的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:21:37",
            "content": "そうですね",
            "Chinese": "嗯，让我想想。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:21:49",
            "content": "仕事をしているときは",
            "Chinese": "在工作的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:21:59",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:22:21",
            "content": "気持ちよくしようと思いまして",
            "Chinese": "我会努力让自己心情愉快地工作，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:22:27",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:22:36",
            "content": "モヤモヤ感じないのですが",
            "Chinese": "所以不会感到烦闷，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:22:58",
            "content": "そうですか、、それは少し良かったです",
            "Chinese": "这样啊……那还算是稍微好一些。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:22:59",
            "content": "自宅に帰ってきて思い返してモヤモヤになります",
            "Chinese": "但是回到家后，一回想起来就会觉得烦闷。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:23:18",
            "content": "なるほど、、辛い感じですね",
            "Chinese": "原来如此……那一定很难受吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:23:24",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:23:48",
            "content": "それはどのくらいの周期でそう考えますか？",
            "Chinese": "这种情况大概以什么样的频率发生呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:24:12",
            "content": "最近は毎日のようにです",
            "Chinese": "最近几乎每天都会。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:24:18",
            "content": "やはり",
            "Chinese": "果然还是……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:24:38",
            "content": "そんなにですか、それはお疲れになりますね",
            "Chinese": "这么频繁吗？那您一定很累了吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:24:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:25:02",
            "content": "はじめはそれほどではなく",
            "Chinese": "一开始还没这么严重，"
        },
        {
            "role": "カウンセラー",
            "time": "2020/07/27(月) 18:25:11",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2020/07/27(月) 18:25:33",
            "content": "他の店舗のスタッフとリズムが合わないのかなと思っています",
            "Chinese": "我觉得，可能是我和其他门店的员工节奏不太合拍。"
        },
