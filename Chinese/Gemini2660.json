{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:29:07",
            "content": "ご相談ありがとうございます。",
            "Chinese": "感谢您前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:30:17",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:30:45",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:31:19",
            "content": "はじめに、年齢、性別、今日の相談したいことよろしくお願いいたします。",
            "Chinese": "首先，请告知您的年龄、性别以及今天希望咨询的事项，谢谢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:31:49",
            "content": "35才　女です",
            "Chinese": "35岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:32:14",
            "content": "ありがとうございます。",
            "Chinese": "好的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:32:58",
            "content": "相談したいことがあれば、何でも気軽にきいてくださいね",
            "Chinese": "如果有什么想谈的，请随时告诉我，什么都可以。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:33:49",
            "content": "人の目が気になってしまい恐いです",
            "Chinese": "我总是很在意别人的眼光，感到害怕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:34:45",
            "content": "人目が気になり、怖いんですね。",
            "Chinese": "您是在意别人的眼光，感到害怕呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:34:52",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:35:43",
            "content": "そのことについて、もう少し詳しく、お聴きしてもいいですか？",
            "Chinese": "关于这件事，可以请您再详细说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:35:55",
            "content": "子供が障害者で暴れたり　叫んだりするのが周りの人から見られているきがします",
            "Chinese": "我的孩子有残疾，他发脾气或大叫的时候，我感觉周围的人都在看我。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:36:36",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:36:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:37:15",
            "content": "お名前はどう、およびしたらいいでしょうか？",
            "Chinese": "请问我该如何称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:37:36",
            "content": "いいたくないです",
            "Chinese": "我不想说。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:38:05",
            "content": "わかりました。",
            "Chinese": "好的，我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:39:31",
            "content": "では、仮のお名前でも難しいですか？なんでも大丈夫ですので",
            "Chinese": "那么，用一个化名可以吗？任何名字都可以的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:40:16",
            "content": "かねです",
            "Chinese": "叫我Kane吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:40:39",
            "content": "ありがとうございます。かねさん宜しくお願い致します。",
            "Chinese": "谢谢您。Kane女士，请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:40:49",
            "content": "よろしくおねがいします",
            "Chinese": "请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:41:08",
            "content": "こちらこそ宜しくお願い致します。",
            "Chinese": "我也一样，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:42:15",
            "content": "お子さんについてですが、叫んだり暴れたりは、おうちの中でもよくありますか？",
            "Chinese": "关于您的孩子，他在家里也经常大叫或发脾气吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:42:27",
            "content": "ありますね",
            "Chinese": "会的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:42:47",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:42:52",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:43:21",
            "content": "それは、どんな時が多いですか？",
            "Chinese": "那通常是在什么情况下会发生呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:44:03",
            "content": "家でもありますが特に外出時でしょうか",
            "Chinese": "在家也会，但尤其是在外出时吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:45:01",
            "content": "それは、特に何処に出かけたときに多くありますか？",
            "Chinese": "特别是去哪些地方时更容易发生呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:45:30",
            "content": "買い物です",
            "Chinese": "购物的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:46:01",
            "content": "お買い物のときですね。",
            "Chinese": "是购物的时候呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:46:16",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:47:04",
            "content": "おうちから近くのスーパー、デパートでしょうか？",
            "Chinese": "是家附近的超市或百货商店吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:47:14",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:47:47",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:48:47",
            "content": "お子さんは、毎回叫んだり、暴れたりしてしまいますか？",
            "Chinese": "您的孩子每次都会大叫和发脾气吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:49:17",
            "content": "ほとんど毎日必ずあります",
            "Chinese": "基本上每天都会，可以说是必然发生的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:50:02",
            "content": "ほとんど毎日なんですね。",
            "Chinese": "几乎每天都这样呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:50:09",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:50:47",
            "content": "それは、人目が気になってしまいますね",
            "Chinese": "那样的话，确实会很在意别人的眼光呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:51:16",
            "content": "はい　気にならなくなりたいです",
            "Chinese": "是的，我希望能变得不在意。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:52:42",
            "content": "そうですよね。気になると思うので。少しでも気にならない方法あれば嬉しいですもんね",
            "Chinese": "是啊，我理解您会很在意。如果有什么方法能让您稍微不那么在意，那肯定会很好吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:53:13",
            "content": "そうなんです",
            "Chinese": "是这样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:53:35",
            "content": "そうだと思います。",
            "Chinese": "我想也是。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:54:03",
            "content": "お子さんが機嫌いい時は普段ありますか？",
            "Chinese": "您的孩子平时有心情好的时候吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:55:01",
            "content": "おやつを食べてる時や動画を見ている時は割と機嫌はいいです",
            "Chinese": "吃零食或者看视频的时候，心情还算不错。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:55:21",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:56:23",
            "content": "動画をみているときはおうちでテレビですか？それともスマホアプリの動画でしょうか？",
            "Chinese": "看视频的时候，是在家里看电视呢？还是在手机上看APP里的视频？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:56:36",
            "content": "どちらもです",
            "Chinese": "两者都有。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:56:53",
            "content": "どちらもなんですね。",
            "Chinese": "两者都有呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:56:58",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:57:23",
            "content": "お外でも動画をみることはありますか？",
            "Chinese": "在外面也会给孩子看视频吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:58:22",
            "content": "ありません",
            "Chinese": "不会。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:58:42",
            "content": "そうなんですね。",
            "Chinese": "明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 15:59:31",
            "content": "おうちでだけみてるんですね",
            "Chinese": "只在家里看呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 15:59:41",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:00:59",
            "content": "人目を気にならなくなりたいのですがどうしたら良いですか?",
            "Chinese": "我希望能变得不在意别人的眼光，该怎么做才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:01:10",
            "content": "おやつはどうですか？お家でのみにしていますか",
            "Chinese": "那零食呢？您也是只在家里给孩子吃吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:02:16",
            "content": "家でしか　しつけのため与えていません。",
            "Chinese": "为了管教他，只在家里给。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:02:20",
            "content": "そうですよね。気になるとどうしていいかわからなくなりますよね",
            "Chinese": "是啊。一旦在意起来，就会不知道该怎么办了呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:02:42",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:02:55",
            "content": "そうなんですね。人目も気になるとは思うので",
            "Chinese": "是这样啊。我想您确实很在意别人的眼光。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:04:56",
            "content": "もしも、動画とおやつであれば、どちらかを、お子さんに機嫌よくしてもらうに渡しますか❔",
            "Chinese": "如果是在视频和零食之间选择，为了让孩子心情变好，您会给他哪一个呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:07:07",
            "content": "どちらもですね",
            "Chinese": "两个都会给吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:07:28",
            "content": "どちらもなんですね。",
            "Chinese": "两个都会给啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:07:36",
            "content": "今までも家では　どちらも　やってますので",
            "Chinese": "因为至今为止在家里都是两个一起给的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:08:42",
            "content": "外出の時は動画見る余裕もないですし　おやつもできるだけ与えたくないので",
            "Chinese": "外出的时候，既没有精力让他看视频，也想尽量不给零食。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:08:57",
            "content": "お外であれば、どうですか❔人目も気になるとは思うので",
            "Chinese": "那在外面的时候呢？因为您也很在意别人的眼光。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:09:19",
            "content": "そうなんですね。",
            "Chinese": "明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:10:28",
            "content": "動画をみせる時間が難しいようでしたら、おやつでしょうか",
            "Chinese": "如果让他看视频的时间不好安排的话，那零食怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:11:33",
            "content": "そうですが　家でしか与えていませんので",
            "Chinese": "话是这么说，但我只在家里给他吃。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:11:48",
            "content": "そうですよね。",
            "Chinese": "也是呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:13:37",
            "content": "人目が気になるということなので、出来たら、かねさんも、お子さんも気分よく過ごせたらいいなとは思うので。",
            "Chinese": "因为您很在意别人的眼光，所以如果可能的话，我希望您和您的孩子都能心情愉快地度过。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:13:56",
            "content": "そうなんです",
            "Chinese": "是这样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:15:18",
            "content": "それが一番いいと思いますので。動画とおやつ以外は好きなものありませんか❔ぬいぐるみや、おもちゃ等",
            "Chinese": "我也觉得那是最好的。除了视频和零食，他还有其他喜欢的东西吗？比如毛绒玩具，或者其他玩具之类的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:16:36",
            "content": "ゲームも好きですね",
            "Chinese": "他也喜欢游戏。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:16:50",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:16:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:17:13",
            "content": "おそとではしたりないですか❔",
            "Chinese": "在外面不玩吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:18:12",
            "content": "したりないとは?",
            "Chinese": "“玩得不够”是指什么？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:18:20",
            "content": "ゲームですか",
            "Chinese": "是指游戏吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:18:42",
            "content": "お外でゲームですね",
            "Chinese": "是的，在外面玩游戏。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:20:05",
            "content": "どうなんでしょうか…わかりませんがおやつ以外に何かと聞かれたので答えたのですが",
            "Chinese": "这个嘛…我也不太清楚，但因为您问我除了零食还有没有别的，所以我就回答了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:20:21",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:22:04",
            "content": "もし、お外でもゲームでご機嫌いいようであれば、お出かけの時にゲームさせながらお買い物はどうかなと思いましたので",
            "Chinese": "我在想，如果在外面玩游戏也能让他心情好的话，那么外出购物时，让他玩着游戏，您觉得怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:23:01",
            "content": "そうですね　その方法もありますね　一度試してみますね",
            "Chinese": "嗯，这个方法也可以。我试一次看看吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:24:01",
            "content": "ゲームお好きなら一度試すのもいいと思います",
            "Chinese": "如果他喜欢游戏的话，我觉得试一次也挺好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:24:26",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "クライアント",
            "time": "2021/11/05(金) 16:24:34",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/11/05(金) 16:25:17",
            "content": "こちらこそ相談していただきありがとうございます。",
            "Chinese": "我也要谢谢您来找我咨询。"
        },
        {
            "role": "クライアント",
