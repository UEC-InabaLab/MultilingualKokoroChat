{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 09:54:40",
            "content": "（時間になったらはじめますよろしくお願いしますね）",
            "Chinese": "（时间到了我们就开始吧。请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 09:58:10",
            "content": "おはようございます。よろしくお願いいたします。",
            "Chinese": "早上好。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:00:07",
            "content": "こんにちは。相談員です。",
            "Chinese": "您好，我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:00:16",
            "content": "こんにちは",
            "Chinese": "您好。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:01:02",
            "content": "初めに、よろしかったら、年齢と性別をおしえていただけますか？",
            "Chinese": "首先，如果方便的话，可以告诉我您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:01:46",
            "content": "２８歳 女性です",
            "Chinese": "28岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:01:49",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:02:16",
            "content": "今日はどんなご相談でお越しですか？",
            "Chinese": "今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:02:42",
            "content": "子育てに疲れました",
            "Chinese": "育儿让我感到非常疲惫。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:03:13",
            "content": "そうなんですね,お話してくれてありがとうございます,,",
            "Chinese": "是这样啊，感谢您愿意和我分享。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:03:31",
            "content": "お子さんはおいくつですか？",
            "Chinese": "您的孩子现在多大了？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:03:47",
            "content": "11月末に生まれました",
            "Chinese": "11月底出生的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:04:05",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:04:31",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:04:33",
            "content": "ちょうど3か月ですね",
            "Chinese": "正好3个月大呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:04:39",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:05:16",
            "content": "一番お疲れがたまる時期ですよね,,",
            "Chinese": "这正是最容易累积疲憊的时期呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:05:42",
            "content": "相談者さんは、眠れてますか？",
            "Chinese": "您最近睡得好吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:06:30",
            "content": "夜は三時間おきに起きないといけないので、その合間に寝るという感じです。",
            "Chinese": "晚上每隔三小时就得起来，所以只能在间隙中断断续续地睡。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:07:42",
            "content": "そうですよね...授乳にげっぷにリセットする時間がとれないですね...",
            "Chinese": "是啊……喂奶、拍嗝，根本没有时间让自己喘口气……"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:07:52",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:08:02",
            "content": "本当に大変な時期だと思います",
            "Chinese": "我想这确实是一个非常辛苦的时期。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:08:19",
            "content": "よく頑張っていらっしゃいますね..",
            "Chinese": "您真的已经做得很好了。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:08:33",
            "content": "はい。目が離せなくってしんどいです。",
            "Chinese": "是的。眼睛一刻也离不开，真的很辛苦。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:08:40",
            "content": "有り難うございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:08:55",
            "content": "こちらこそ、そんな時に来てくれてありがとうございます。",
            "Chinese": "我才要谢谢您，在这么辛苦的时候还愿意来这里。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:09:18",
            "content": "お食事は食べられていますか？",
            "Chinese": "您有好好吃饭吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:09:36",
            "content": "合間、合間で食べてます。",
            "Chinese": "也是在间隙时间随便吃点。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:09:59",
            "content": "そうですか..食べた気がしないですよね..",
            "Chinese": "是这样啊……感觉就像没吃过一样吧……"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:10:21",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:11:06",
            "content": "食べたいっていう感覚もあまりないので、それは大丈夫なんですけど",
            "Chinese": "其实我也没有什么想吃的感觉，所以这方面还好。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:11:23",
            "content": "自分の時間がないのがつらいです。",
            "Chinese": "没有属于自己的时间，这让我很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:11:33",
            "content": "そうですよね...",
            "Chinese": "是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:12:04",
            "content": "食欲もないくらいですから、本当におつらい状況なんだと思います",
            "Chinese": "都到没什么食欲的程度了，我想您的情况真的非常辛苦。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:12:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:12:28",
            "content": "どなたか、お手伝いしてもらえていますか？",
            "Chinese": "身边有没有人能帮帮您？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:13:30",
            "content": "夫と二人で子育てしてます",
            "Chinese": "我和丈夫两个人一起带孩子。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:13:59",
            "content": "そうなんですね..ご主人はお仕事はいかがですか？",
            "Chinese": "是这样啊。您先生的工作怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:14:40",
            "content": "普通の会社員なので、昼間は仕事に行ってます。",
            "Chinese": "他是一般的上班族，所以白天要去上班。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:15:09",
            "content": "そうなんですね...では、ほとんどワンオペなんでしょうか",
            "Chinese": "这样啊……那您基本上是一个人带孩子吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:15:18",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:15:52",
            "content": "そうでしたか...それでは自分のことどころじゃないですよね",
            "Chinese": "原来是这样……那确实顾不上自己的事了吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:16:10",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:17:18",
            "content": "そうなんですね..周りにご相談する人はいますか？",
            "Chinese": "是这样啊，身边有可以商量的人吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:17:41",
            "content": "いないです",
            "Chinese": "没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:18:00",
            "content": "う～ん..それはおつらいですよね",
            "Chinese": "嗯……那一定很辛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:18:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:18:40",
            "content": "子育てに困難を感じるのももっともだと思いますよ",
            "Chinese": "我觉得您会感到育儿困难是很正常的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:19:06",
            "content": "本当にお疲れ様です",
            "Chinese": "您真的辛苦了。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:19:26",
            "content": "有り難うございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:19:40",
            "content": "ご主人に、あなたのお気持ちはお話してますか？",
            "Chinese": "您跟丈夫说过您的这些感受吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:20:42",
            "content": "話…",
            "Chinese": "说过……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:20:48",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:21:07",
            "content": "した？してないかもしれません",
            "Chinese": "说了吗？可能并没有说。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:21:24",
            "content": "そうなんですね...",
            "Chinese": "是这样啊……"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:21:32",
            "content": "お互いに、目の前のことで精一杯な感じです。",
            "Chinese": "感觉我们彼此都只顾得上眼前的事，已经筋疲力尽了。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:21:39",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:22:29",
            "content": "そうですか..ご主人もお仕事もされていて、お互いに余裕がない感じなんでしょうか？",
            "Chinese": "是这样啊……因为您丈夫也在工作，所以彼此都没有余力，是这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:22:50",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:23:00",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:23:08",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:23:32",
            "content": "相談者さんは、今、どんなお気持ちですか？",
            "Chinese": "您现在，是怎样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:23:46",
            "content": "気持ち…",
            "Chinese": "心情……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:23:51",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:24:00",
            "content": "疲れた？",
            "Chinese": "累？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:24:04",
            "content": "しんどい",
            "Chinese": "很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:24:16",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:24:23",
            "content": "どうにもならない",
            "Chinese": "无可奈何。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:24:30",
            "content": "…",
            "Chinese": "……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:24:41",
            "content": "お話してくれてありがとうございます",
            "Chinese": "谢谢您愿意把这些说出来。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:24:57",
            "content": "改めて自分の気持ちと言われると難しいですね",
            "Chinese": "被这样一问，要说清自己的感受还真有点难呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:25:08",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:25:45",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:26:04",
            "content": "疲れて、しんどくて、逃げることもできなくて、気持ちを感じる余裕なんてないのかもしれないですよね",
            "Chinese": "又累又辛苦，也无处可逃，或许根本没有余力去感受自己的心情了，对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:27:04",
            "content": "責任感がとっても強いようにかんじます",
            "Chinese": "我感觉您的责任感非常强。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:27:18",
            "content": "頑張り屋さんで..",
            "Chinese": "是个很努力的人……"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:28:29",
            "content": "そうなんですかねそう言ってもらうと嬉しいですね。",
            "Chinese": "是吗？听您这么说，我很高兴。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:29:37",
            "content": "そう思います。お子さんへの愛情も人一倍強くて、ご主人にもお気づかいされていらっしゃるのではないでしょうか？",
            "Chinese": "我是这么认为的。您对孩子的爱比常人更深，对丈夫也非常体贴，不是吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:30:46",
            "content": "そうですね…",
            "Chinese": "是啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:30:55",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:31:17",
            "content": "そうかもしれないです",
            "Chinese": "可能真的是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:31:52",
            "content": "そうですね..そう思います",
            "Chinese": "是啊，我也是这么认为的。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:32:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:32:30",
            "content": "今一番どうしたいと思いますか？",
            "Chinese": "您现在最希望怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:33:14",
            "content": "わからないです",
            "Chinese": "我不知道。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:33:21",
            "content": "どうしたらいいんでしょうか？",
            "Chinese": "我该怎么办才好呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:33:50",
            "content": "そうなんですね。ご一緒に考えましょう",
            "Chinese": "是这样啊。我们一起来想想办法吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:34:20",
            "content": "ちょっとお話を整理してもいいですか？",
            "Chinese": "我可以稍微整理一下我们刚才的谈话内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:34:35",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:37:02",
            "content": "１１月にお子さんが生まれて、授乳も３時間おきで、睡眠も食事も合間にとっている。自分のじかんもなくてとにかくしんどい。ご主人は昼間はお仕事で、帰ってくると手伝ってくれるけれど、目の前のことをこなすのにいっぱいでゆっくりお話しを聞いてもらう余裕もない",
            "Chinese": "您在11月生了宝宝，每3小时就要喂一次奶，睡眠和吃饭都只能在间隙里解决。完全没有自己的时间，总之就是非常辛苦。丈夫白天去上班，回来后也会帮忙，但彼此都忙于眼前的事，没有余力好好听您说说心里话。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:37:21",
            "content": "という感じでよかったでしょうか？",
            "Chinese": "我这样概括可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:37:43",
            "content": "そうですね",
            "Chinese": "是的，差不多是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:37:59",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:38:32",
            "content": "まず、一つ提案なんですが、いいですか？",
            "Chinese": "首先，我有一个建议，您愿意听听吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:38:48",
            "content": "はい。教えてください。",
            "Chinese": "好的，请告诉我。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:39:19",
            "content": "どなたかにSOSを出せないか、考えませんか？",
            "Chinese": "我们一起来想想，能不能向谁发出求助（SOS）呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:39:38",
            "content": "SOS?",
            "Chinese": "求助？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:39:46",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:39:55",
            "content": "誰か助けてくれるのですか？",
            "Chinese": "会有人愿意帮我吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:40:06",
            "content": "そう思います",
            "Chinese": "我相信会的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:40:15",
            "content": "たとえば",
            "Chinese": "比如说，"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:40:18",
            "content": "？",
            "Chinese": "？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:40:23",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:40:42",
            "content": "各自治体に、ファミリーサポートのような機能があります",
            "Chinese": "各个地方政府都有类似“家庭支援”的服务。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:41:01",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:41:05",
            "content": "お子さんを数時間預かってくれたり",
            "Chinese": "可以帮忙照看几个小时孩子，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:42:00",
            "content": "保健所の保健士さんが具体的なことも含めて育児相談にも乗ってくれます",
            "Chinese": "保健所的保健师也会提供包括具体问题在内的育儿咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:42:19",
            "content": "それはできそうですか？",
            "Chinese": "您觉得这些可行吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:42:28",
            "content": "そんな所があるんですか？",
            "Chinese": "还有这样的地方吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:42:34",
            "content": "はい",
            "Chinese": "有的。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:42:39",
            "content": "知らなかったです",
            "Chinese": "我之前都不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:42:50",
            "content": "そうでしたか",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:42:56",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:42:59",
            "content": "私事ですが",
            "Chinese": "说点我自己的事，"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:43:12",
            "content": "でも、何を聞いたらいいんでしょうか？",
            "Chinese": "可是，我该问些什么好呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:43:20",
            "content": "ゴメンナサイ",
            "Chinese": "不好意思，打断了您。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:43:29",
            "content": "聞かせてください。",
            "Chinese": "请您说说看。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:43:36",
            "content": "いえ、こちらこそすみません",
            "Chinese": "不，该说抱歉的是我才对。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:43:44",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:43:46",
            "content": "知りたいです",
            "Chinese": "我想听。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:44:23",
            "content": "私事ですが、私はダメママだったのでファミリーサポートにはかなり助けられました",
            "Chinese": "说件我自己的事，我以前也觉得自己是个不称职的妈妈，家庭支援服务真的帮了我大忙。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:44:38",
            "content": "そうだったのですね",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:44:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:45:09",
            "content": "最初のお話で",
            "Chinese": "回到我们一开始的话题，"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:45:15",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:45:39",
            "content": "自分の時間がないとおっしゃっていましたが",
            "Chinese": "您说没有属于自己的时间，"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:46:06",
            "content": "はい。無いです。",
            "Chinese": "是的。完全没有。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:46:34",
            "content": "そうですよね。ほんの少し預かってもらえるだけで、ゆっくりお風呂に入ったり、出来るようになるかと...",
            "Chinese": "是啊。哪怕只是有人能帮忙照看一小会儿，您也许就能好好泡个澡，稍微喘口气了……"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:46:52",
            "content": "そうですね。",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:47:27",
            "content": "相談者さんは、きっと手を抜かず、しっかり子育てされているんですね",
            "Chinese": "您一定是一位一丝不苟、尽心尽力地养育孩子的母亲吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:47:57",
            "content": "だからこそ、息抜きが必要なのかもしれないと感じました",
            "Chinese": "正因为如此，我才觉得您或许更需要喘口气。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:47:58",
            "content": "そんなことは無いです。私こそダメダメです。",
            "Chinese": "没有那回事。我才是个不合格的妈妈。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:48:08",
            "content": "そうなんですか？",
            "Chinese": "是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:48:32",
            "content": "どんな時にそう思われますか？",
            "Chinese": "您在什么情况下会这么想呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:49:09",
            "content": "はい。泣いてる時とか、抱っこしたら泣き止むのを解ってるのに",
            "Chinese": "是的。比如孩子哭的时候，我明明知道只要抱起来他就不哭了，"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:49:12",
            "content": "しんどいな",
            "Chinese": "但还是会觉得“好累啊”，"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:49:25",
            "content": "また、抱っこしないといけないのだなぁ",
            "Chinese": "“又得抱他了啊”。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:49:34",
            "content": "そうですよね。しんどいですよね",
            "Chinese": "是啊，这确实很辛苦。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:49:36",
            "content": "とか思ってイライラしたり",
            "Chinese": "一想到这些就会感到烦躁。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:49:42",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:49:55",
            "content": "とってもわかります",
            "Chinese": "我非常理解。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:50:11",
            "content": "夫は家出たら自由なのに",
            "Chinese": "可是丈夫一出家门就自由了，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:50:19",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:50:49",
            "content": "さっき、お話をまとめてもらった時に気づいたのですが",
            "Chinese": "刚才您帮我梳理的时候，我意识到一件事，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:50:57",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:51:39",
            "content": "夫に話しを聞いてもらう余裕ないっていうより",
            "Chinese": "与其说他没有余力听我说，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:52:06",
            "content": "（聞いてます）",
            "Chinese": "（我在认真听。）"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:52:08",
            "content": "私が話したいと思ってないのかもしれないな",
            "Chinese": "不如说，可能是我自己并不想跟他谈。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:52:13",
            "content": "と感じました。",
            "Chinese": "我感觉是这样。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:52:20",
            "content": "悪いことしてるなぁと",
            "Chinese": "感觉自己做了件坏事。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:52:20",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:52:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:52:43",
            "content": "それはどうしてですか？",
            "Chinese": "为什么会这么觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:53:13",
            "content": "どうしてでしょうか",
            "Chinese": "为什么呢……"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:53:19",
            "content": "もしかしたら",
            "Chinese": "也许……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:53:31",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:53:49",
            "content": "夫に労ってほしいのかもしれないですね",
            "Chinese": "我可能是希望丈夫能体恤我、安慰我吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:54:01",
            "content": "そうなんですね",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:54:17",
            "content": "わたしがイライラしてるのを気づいてるのかも",
            "Chinese": "他可能也察觉到我很烦躁了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:54:28",
            "content": "なるほど",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:54:45",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:55:03",
            "content": "夫さんに、気づいてもらいたい、という感じでしょうか？",
            "Chinese": "是希望先生能察觉到，是这种感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:55:21",
            "content": "そうなのかもしれませんね",
            "Chinese": "或许是这样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:55:33",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:55:49",
            "content": "気づいてもらいたい、ですよね",
            "Chinese": "是希望他能察觉到，对吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:56:14",
            "content": "男性にはなかなか難しいのかもしれませんが",
            "Chinese": "虽然对男性来说，这可能有点难，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:56:27",
            "content": "そう思うのはもっともですよね",
            "Chinese": "但您会这么想也是理所当然的。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:56:37",
            "content": "そうなのかもしれません",
            "Chinese": "也许是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:56:46",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:57:00",
            "content": "ゆっくりでいいので...",
            "Chinese": "慢慢来就好……"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:57:45",
            "content": "はい。ただ、私がイライラしてるから、夫が気をつかってくれてるのだなと話をしていて気づきました。",
            "Chinese": "嗯。不过，通过这次谈话我意识到，可能正因为我很烦躁，所以丈夫才对我小心翼翼的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:58:09",
            "content": "なるほど。そうなんですね",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:58:25",
            "content": "たとえばですが",
            "Chinese": "比如说，"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 10:59:15",
            "content": "今日、帰ってきたら、いつもと違う気持ちで「おかえりなさい」って言えそうです。",
            "Chinese": "今天他回来的时候，我感觉自己能用和以往不同的心情对他说“你回来了”。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:59:29",
            "content": "素晴らしいです",
            "Chinese": "那太棒了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:59:37",
            "content": "さすがですね",
            "Chinese": "真了不起。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 10:59:52",
            "content": "しんどい時は",
            "Chinese": "感到辛苦的时候，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 11:00:14",
            "content": "夫さんのお話でもいいので",
            "Chinese": "就算是来谈谈您丈夫的事也好，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 11:00:30",
            "content": "こうしてお話ししに来てくれると嬉しいです",
            "Chinese": "能像这样再来和我聊聊，我会很高兴的。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 11:00:37",
            "content": "有り難うございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 11:00:41",
            "content": "ここで話させていただいて、良かった。",
            "Chinese": "能在这里倾诉，真是太好了。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 11:00:50",
            "content": "色々、気づけました。",
            "Chinese": "我有了很多新的觉察。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 11:01:04",
            "content": "そうですか。それはうれしいです",
            "Chinese": "是吗？那我就太高兴了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 11:01:18",
            "content": "相談者さんには相談者さんには",
            "Chinese": "您、您……"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 11:01:26",
            "content": "すみません",
            "Chinese": "不好意思。"
        },
        {
            "role": "クライアント",
            "time": "2023/02/11(土) 11:01:33",
            "content": "大丈夫です",
            "Chinese": "没关系。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 11:01:46",
            "content": "相談者さんには素晴らしい力がおありなので",
            "Chinese": "您自身就拥有非常棒的力量，"
        },
        {
            "role": "カウンセラー",
            "time": "2023/02/11(土) 11:02:27",
            "content": "きっと夫さんとももっと心地いい関係が築けるのだと思います",
