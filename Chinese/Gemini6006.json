{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 17:50:50",
            "content": "(こんばんは。時間になりましたら始めますので宜しくお願い致します）",
            "Chinese": "(晚上好。时间到了我们就开始，请多关照。)"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 17:51:20",
            "content": "(こんばんは。よろしくお願いします)",
            "Chinese": "(晚上好。请多关照。)"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 17:52:27",
            "content": "(希望はありますか？)",
            "Chinese": "(您有什么要求吗？)"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 17:52:52",
            "content": "（大丈夫です。）",
            "Chinese": "（没问题。）"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 17:55:51",
            "content": "(かしこまりました。)",
            "Chinese": "(好的，明白了。)"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:00:06",
            "content": "相談員です。まずは年齢・性別、お話ししたい事を教えてください。宜しくお願い致します。",
            "Chinese": "我是咨询员。首先请告诉我您的年龄、性别以及想聊的内容。请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:00:28",
            "content": "15歳女死にたいです",
            "Chinese": "15岁，女生。我想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:02:05",
            "content": "そうなんですね。死にたいと思うほどお辛い状況なのですね。",
            "Chinese": "是这样啊。您现在的情况一定很痛苦，已经到了想死的地步了呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:03:53",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:04:03",
            "content": "今はお一人ですか？",
            "Chinese": "您现在一个人吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:04:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:05:43",
            "content": "そうなんですね。いつごろから死にたいと思うようになりましたか？",
            "Chinese": "是这样啊。大概从什么时候开始有想死的念头的呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:06:03",
            "content": "最近です",
            "Chinese": "最近开始的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:07:25",
            "content": "最近なのですね。何か心が痛むことなどありましたか？",
            "Chinese": "是最近啊。有发生什么让您伤心的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:07:48",
            "content": "心当たりないんです",
            "Chinese": "没有特别的原因。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:09:08",
            "content": "ありがとうございます。心あたりがないのに死にたいと思われるのですね。",
            "Chinese": "谢谢您告诉我。没有特别的原因，却还是想死呢。"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:09:32",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:10:09",
            "content": "なるほど、、、それは辛いですね。",
            "Chinese": "原来如此……那一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:12:12",
            "content": "つらいです",
            "Chinese": "很痛苦。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:12:19",
            "content": "死にたいと思う理由が分からないのかもしれませんね。",
            "Chinese": "也许您自己也不太清楚为什么会想死呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:12:57",
            "content": "うん、辛いですよね。",
            "Chinese": "嗯，一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:13:09",
            "content": "わからないです",
            "Chinese": "我不知道。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:14:41",
            "content": "分からないはど心が傷ついているのですね。",
            "Chinese": "正因为不知道原因，才说明您的内心受到了很深的伤害呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:17:26",
            "content": "その中でも相談に来てくださりありがとうございます。今は寒いですか？暖かいですか？",
            "Chinese": "在这种情况下您还能来咨询，真的非常感谢。您现在觉得冷还是暖和？"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:17:34",
            "content": "寒いです",
            "Chinese": "很冷。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:19:35",
            "content": "そうなんですね。寒いと体にも良くないと思います。出来れば暖かい場所に行くことは可能でしょうか？",
            "Chinese": "是这样啊。我觉得寒冷对身体不好。如果可以的话，您能去一个暖和点的地方吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:20:20",
            "content": "今はここに居たいです",
            "Chinese": "我现在想待在这里。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:23:48",
            "content": "はい。わかりました、では今の気持ちを言えるなら返信してください。私はいつまでも待ってますから。",
            "Chinese": "好的，我明白了。那么，如果您能说出来，请告诉我您现在的心情。我会一直等您的。"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:24:49",
            "content": "しんどいです",
            "Chinese": "很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:26:04",
            "content": "ありがとうございます。しんどいのですね。その理由も分かりませんか？",
            "Chinese": "谢谢您。您是感觉很难受吧。其中的原因您也不清楚吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:26:12",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:31:04",
            "content": "私も何か分からないけど同じような気持ちになったことはありますから気持ちは何となくですがわかります。同じ今の時間で何が死にたいと思わせるのかゆっくり考えていきませんか？",
            "Chinese": "虽然我说不清楚具体是什么，但我也曾有过和您类似的感受，所以大概能理解您的心情。我们要不要一起慢慢地想一想，是什么让您在此时此刻产生了想死的念头？"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:31:48",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:31:59",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:32:51",
            "content": "気持ち楽に焦らずでいいので。",
            "Chinese": "放轻松，不用着急就好。"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:33:45",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:34:55",
            "content": "はい、よろしくお願いいたします。",
            "Chinese": "好的，那就拜托您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:36:58",
            "content": "今の気持ちは少しでも前より変わりましたか？",
            "Chinese": "您现在的感受，和刚才相比有哪怕一点点变化吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:37:19",
            "content": "あんまりです",
            "Chinese": "没什么变化。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:37:48",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:40:13",
            "content": "焦らずゆっくりと、気を楽にしてくださいね。",
            "Chinese": "别着急，慢慢来，让自己放松一些。"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:41:03",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:41:23",
            "content": "はい。",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:43:23",
            "content": "まだ死にたいと思われますか？",
            "Chinese": "现在还是会觉得想死吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:43:28",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:44:10",
            "content": "わかりました。",
            "Chinese": "我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:45:36",
            "content": "今の気持ちが少しでも楽になりそうですか？無理ですか？",
            "Chinese": "现在的心情有可能哪怕轻松一点吗？还是说很难呢？"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:46:42",
            "content": "わからないです。",
            "Chinese": "不太清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:48:36",
            "content": "私は心が傷ついて辛くて死にたいと思う状況になっていると思います。私もありましたから。",
            "Chinese": "我想，您是因为内心受伤、很痛苦，才会到了想死的地步。我自己也经历过。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:50:08",
            "content": "だけど死ねませんでした、、、",
            "Chinese": "但是，我没能死成……"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:51:14",
            "content": "そうなんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:53:12",
            "content": "はい。今は多くの人に支えられて何とか生きてますし、最近は夢も出来ました。",
            "Chinese": "是的。现在我在很多人的支持下，总算还好好地活着，而且最近也有了梦想。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:55:50",
            "content": "一緒に頑張っていきませんか？いつでも相談に乗りますし、また来てくれますかね？",
            "Chinese": "我们一起努力下去好吗？我随时都可以听您倾诉，您还会再来找我聊聊吗？"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:55:57",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:57:47",
            "content": "わかりました、いつでも相談に来てください。この先のことも良ければ一緒に考えていきたいと思います。",
            "Chinese": "我明白了，欢迎您随时来咨询。如果可以的话，我也想和您一起思考接下来的事情。"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 18:58:52",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 18:59:15",
            "content": "こちらこそ、ありがとうございます。",
            "Chinese": "我才要谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 19:01:18",
            "content": "時間になりましたので今回はここまでで、また次回に話せればよろしくお願いいたします。",
            "Chinese": "时间到了，这次就先到这里。期待下次能再和您聊。"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 19:01:49",
            "content": "はい。ありがとうございました。",
            "Chinese": "好的。非常感谢您。"
        },
        {
            "role": "クライアント",
            "time": "2023/11/18(土) 19:01:54",
            "content": "(お疲れ様でした。ありがとうございました。)",
            "Chinese": "（您辛苦了。非常感谢。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 19:02:30",
            "content": "（ありがとうございます、勉強になりました。)",
            "Chinese": "（谢谢您，我受益匪浅。）"
        },
        {
            "role": "カウンセラー",
            "time": "2023/11/18(土) 19:03:03",
            "content": "失礼いたします。",
            "Chinese": "那我先告辞了。"
        }
    ],
