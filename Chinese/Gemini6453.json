{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:21:05",
            "content": "（今日はありがとうございます。お時間になったら始めさせていただきますので、よろしくお願いいたします。）",
            "Chinese": "（感谢您今天前来。时间一到我们就会开始，请多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:21:36",
            "content": "(こちらこそよろしくお願いいたします。)",
            "Chinese": "（我才是，请您多关照。）"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:21:56",
            "content": "(ご希望の設定等ありますか？)",
            "Chinese": "（您有什么希望的设定吗？）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:22:33",
            "content": "（特にはありません。よろしくお願いいたします。）",
            "Chinese": "（没有特别的要求。请多关-照。）"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:23:10",
            "content": "(かしこまりました)",
            "Chinese": "（明白了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:23:34",
            "content": "（ありがとうございます。）",
            "Chinese": "（谢谢您。）"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:30:17",
            "content": "今日はご相談に来てくださりありがとうございます。始めにご年齢、性別、仮名、ご相談内容を教えていただけますか？",
            "Chinese": "今天感谢您前来咨询。首先，可以请您告诉我您的年龄、性别、化名，以及咨询的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:30:45",
            "content": "12歳、女",
            "Chinese": "12岁，女。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:30:55",
            "content": "仮名はなんですか？",
            "Chinese": "化名是什么？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:31:27",
            "content": "ありがとうございます。なんとお呼びさせていただけばよろしいでしょうか？",
            "Chinese": "谢谢。请问我该怎么称呼你呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:31:54",
            "content": "表示されている名前で呼んでください",
            "Chinese": "请用显示的名字称呼我。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:32:20",
            "content": "はるさん、こんにちは。今日はどうされましたか？",
            "Chinese": "小春，你好。今天想聊些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:32:32",
            "content": "こんにちは。学校に行きたくない",
            "Chinese": "你好。我不想去上学。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:33:08",
            "content": "小学校に行きたくないという相談ですか？",
            "Chinese": "是关于不想去小学的咨询吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:33:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:34:29",
            "content": "そうなんですね、はるさんは6年生ですか？",
            "Chinese": "这样啊，小春，你是六年级吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:34:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:35:02",
            "content": "ありがとうございます。いつからそう感じているのですか？",
            "Chinese": "谢谢你。你从什么时候开始有这种感觉的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:36:14",
            "content": "3学期入ってからです",
            "Chinese": "从第三学期开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:37:43",
            "content": "２学期中は大丈夫だったけど、３学期入ってから急に行きたくなくなったのですか？",
            "Chinese": "第二学期的时候还可以，但到了第三学期就突然不想去了，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:37:59",
            "content": "そんな感じです",
            "Chinese": "嗯，差不多是那样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:39:15",
            "content": "そう感じながら学校に通うのは毎日つらいですよね？",
            "Chinese": "每天都带着这种感觉去上学，一定很痛苦吧？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:39:51",
            "content": "学校には最近行ってないです",
            "Chinese": "我最近没去上学了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:40:26",
            "content": "そうなんですね。最近とはいつ頃から行っていませんか？",
            "Chinese": "这样啊。你说的“最近”，大概是从什么时候开始没去的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:41:06",
            "content": "1月から",
            "Chinese": "从一月开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:42:13",
            "content": "１月からというのは３学期入って一度も行けていないのですか？それとも途中からでしょうか？",
            "Chinese": "从1月开始，是指进入第三学期后一次都没去过吗？还是从中途开始不去的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:42:37",
            "content": "途中からです",
            "Chinese": "是从中途开始的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:43:23",
            "content": "途中から行きたくなくなったということですね。何かきっかけや理由はありますか？",
            "Chinese": "也就是说你是从中途开始不想去的，对吧。有什么契机或原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:43:57",
            "content": "友達とトラブル",
            "Chinese": "和朋友发生了矛盾。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:45:17",
            "content": "お友達と何かトラブルがあったんですか。それは嫌だったですよね。よければその時のことを少し詳しく教えてもらえないでしょうか？",
            "Chinese": "和朋友发生什么矛盾了吗？那一定很难受吧。如果不介意的话，能稍微详细地告诉我当时的情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:46:12",
            "content": "仲間外れにされた",
            "Chinese": "被排挤了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:46:40",
            "content": "それはひどいですね。悲しかったでしょう・・・",
            "Chinese": "那真的很过分。你一定很难过吧……"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:46:54",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:48:08",
            "content": "なぜそんな目にあわされるのか、理由は聞きましたか？",
            "Chinese": "你有问过他们，为什么会这样对你吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:48:52",
            "content": "聞いてない",
            "Chinese": "没问过。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:50:01",
            "content": "だれか話を聞けそうな人はいませんか？自分では理由思いつきますか？",
            "Chinese": "有没有可以帮你打听一下情况的人呢？你自己能想到是什么原因吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:50:47",
            "content": "わからないです",
            "Chinese": "我不清楚。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:52:13",
            "content": "そうですか。理由がわからないのに仲間外れにされて、それは合いたくなくなりますよね。",
            "Chinese": "是这样啊。不知道为什么就被排挤，也难怪你会不想再见到他们了。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:52:39",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:55:27",
            "content": "理由は知りたくないですか？理由がわかれば解決方法もわかると思うのですが、お友達に聞いてみることはできませんか？",
            "Chinese": "你不想知道原因吗？如果知道了原因，我想也许就能找到解决的办法。可以试着去问问朋友吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:56:38",
            "content": "話しかけても無視される",
            "Chinese": "就算我跟他们说话，也会被无视。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:57:32",
            "content": "それでは聞けませんよね。辛さが増してしまいますね。",
            "Chinese": "那样的话，确实问不出口呢。只会让你更难受。"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:58:11",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 11:59:11",
            "content": "ご家族はだれがおられますか？",
            "Chinese": "你家里都有谁呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 11:59:34",
            "content": "お父さんとお母さん",
            "Chinese": "爸爸和妈妈。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:00:01",
            "content": "３人暮らしなのでしょうか？",
            "Chinese": "是三个人一起生活吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:00:11",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:00:49",
            "content": "そうなんですね。学校に行っていないことについてご両親から何か言われることはありますか？",
            "Chinese": "这样啊。关于你没去上学这件事，爸爸妈妈有说什么吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:01:27",
            "content": "言われない",
            "Chinese": "没说什么。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:02:03",
            "content": "朝とかは起こしに来たりされませんか？",
            "Chinese": "那早上他们会来叫你起床吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:02:22",
            "content": "起こされます",
            "Chinese": "会被叫起床。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:03:09",
            "content": "お母さんに起こされるのですか？毎朝何時ころに起こされますか？",
            "Chinese": "是妈妈叫你吗？大概每天几点叫你起床呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:03:28",
            "content": "お母さんです。7時くらい",
            "Chinese": "是妈妈。大概7点左右。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:04:13",
            "content": "お母さんは毎朝学校に間に合う時間に起こしに来られるのでしょうか？",
            "Chinese": "妈妈每天都是在能赶上上学的时间来叫你起床吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:04:24",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:05:33",
            "content": "そうなんですね。お母さんも早朝から起きられていて、そのあと家族そろって朝ご飯を食べているのでしょうか？",
            "Chinese": "这样啊。妈妈也是一大早就起床，那之后全家人会一起吃早饭吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:06:05",
            "content": "ご飯はそれぞれです",
            "Chinese": "我们各吃各的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:06:53",
            "content": "それぞれということですが、はるさんはどこで朝ご飯を食べますか？",
            "Chinese": "你说的“各吃各的”，那么小春你是在哪里吃早饭呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:07:10",
            "content": "リビング",
            "Chinese": "在客厅。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:08:02",
            "content": "リビングで一人で食べているんですか？その時お母さんはどこにおられますか？",
            "Chinese": "你是在客厅一个人吃吗？那时候妈妈在哪里呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:08:42",
            "content": "リビングかキッチンにいます",
            "Chinese": "在客厅或者厨房。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:09:53",
            "content": "側におられるのですね。でははるさんも安心ですね？",
            "Chinese": "那就是在你身边呢。这样的话，小春也会感到安心吧？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:10:20",
            "content": "安心？よくわからないです",
            "Chinese": "安心？我不太明白。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:11:56",
            "content": "お母さんがいる横で朝ご飯食べられるのは安心しますよね？",
            "Chinese": "妈妈在旁边，你一边吃早饭，会觉得安心一些，对吧？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:12:13",
            "content": "そうかもしれないですね",
            "Chinese": "也许是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:12:33",
            "content": "はい。その時に今日は学校どうするとか聞かれませんか？",
            "Chinese": "嗯。那个时候，妈妈会问你“今天学校怎么办”之类的话吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:12:57",
            "content": "聞かれます",
            "Chinese": "会问。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:13:45",
            "content": "そのときはどういう会話になりますか？",
            "Chinese": "那个时候，你们一般是怎么对话的呢？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:14:26",
            "content": "休むって言ってます",
            "Chinese": "我会说“我今天休息”。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:15:09",
            "content": "お母さんはすぐにいいよって言ってくれますか？",
            "Chinese": "妈妈会马上就同意吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:15:31",
            "content": "そうかーって感じです",
            "Chinese": "就感觉是“哦，这样啊”的回应。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:15:54",
            "content": "そっかーって、明るい感じですか？",
            "Chinese": "“这样啊”，是那种很轻松的语气吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:16:16",
            "content": "普通な感じです",
            "Chinese": "就是很普通的语气。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:18:13",
            "content": "そうなんですね。今日ははるさん相談に来てくれたんだけど、どういうことを相談したいですか？行けるようになりたいとか、こうなりたいみたいなことありますか？",
            "Chinese": "这样啊。小春今天来找我咨询，是具体想聊些什么呢？比如，有没有“想重新去上学”或者“想变成什么样”之类的想法？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:18:56",
            "content": "今まで通りになりたい",
            "Chinese": "我想变回和以前一样。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:20:02",
            "content": "そうなんですね。ありがとうございます。はるさん的には具体的にどうしたら良さそうとか、方法を考えてみたことはありますか？",
            "Chinese": "这样啊。谢谢你告诉我。小春你自己有想过，具体要怎么做才好，或者考虑过什么方法吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:20:30",
            "content": "わからないからここに来ました",
            "Chinese": "就是因为不知道，我才来这里的。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:23:47",
            "content": "そうなんですね。ありがとうございます。では方法を一緒に考えてみたいですがいいでしょうか？",
            "Chinese": "这样啊，谢谢你。那么，我们一起来想一想办法，可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:26:13",
            "content": "お願いします",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:26:21",
            "content": "そのお友達には何か連絡手段はありますか？",
            "Chinese": "你和那个朋友有什么联系方式吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:27:35",
            "content": "連絡手段って？",
            "Chinese": "联系方式是指？"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:28:12",
            "content": "たとえばラインとかはつながっていますか？",
            "Chinese": "比如说，你们有加LINE好友吗？"
        },
        {
            "role": "クライアント",
            "time": "2024/02/17(土) 12:28:51",
            "content": "やってないです",
            "Chinese": "我不用LINE。"
        },
        {
            "role": "カウンセラー",
            "time": "2024/02/17(土) 12:29:27",
            "content": "そうなんですね。学校以外でも見かけることはありますか？",
