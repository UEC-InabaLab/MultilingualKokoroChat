{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 20:51:19",
            "content": "(こんばんは。本日はよろしくお願いいたします。お時間になりましたら始めさせていただきます。）",
            "Chinese": "（晚上好。今天请多指教。时间到了我们就开始吧。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 20:58:40",
            "content": "(こんばんは。よろしくお願いします。)",
            "Chinese": "（晚上好。请多指教。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:00:05",
            "content": "こんばんは。相談員です。本日はお越しくださり、ありがとうございます。はじめにご年齢、性別、相談内容を教えていただけますでしょうか。",
            "Chinese": "晚上好。我是咨询师。非常感谢您今天前来。首先，能请您告知您的年龄、性别和咨询内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:00:46",
            "content": "32歳、女",
            "Chinese": "32岁，女。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:00:57",
            "content": "生きるのに疲れました",
            "Chinese": "我活得好累。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:01:46",
            "content": "ご相談にお越しくださり、ありがとうございます。",
            "Chinese": "感谢您前来咨询。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:02:30",
            "content": "お話しできるところからで構いませんが、どのようなことでお困りなのでしょうか？",
            "Chinese": "您可以从方便说的部分开始，请问您遇到了什么样的困扰呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:03:14",
            "content": "死にたい",
            "Chinese": "想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:03:49",
            "content": "ええ、そのように感じておられるのですね。ちなみに今はどちらにおられますか？",
            "Chinese": "嗯，您现在有这样的感受啊。顺便问一下，您现在在哪里呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:03:58",
            "content": "家です",
            "Chinese": "在家。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:05:01",
            "content": "そうなんですね。よくお話に来てくださいました。",
            "Chinese": "是这样啊。很感谢您能来和我谈谈。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:06:05",
            "content": "いつ頃からそのように感じておられるのでしょうか",
            "Chinese": "您大概从什么时候开始有这样的感觉的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:06:16",
            "content": "覚えてません",
            "Chinese": "不记得了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:07:26",
            "content": "そうだったのですね。死にたいくらい何か嫌な思いをされたのでしょうか？",
            "Chinese": "是这样啊。是发生了什么让您难过到想死的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:08:01",
            "content": "いろいろ",
            "Chinese": "各种各样的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:08:44",
            "content": "そうだったのですね。例えば、どんなことがあったかお話できそうでしょうか？",
            "Chinese": "是这样啊。比如说，您方便说说都发生了些什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:10:03",
            "content": "仕事や家とか嫌な思いはそれなりにしてきました",
            "Chinese": "在工作、家庭之类的方面，也经历了不少不愉快的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:11:13",
            "content": "ええ、そうだったのですね。その中でもあなたのなかで強い出来事がおありだったのですか？",
            "Chinese": "嗯，是这样啊。在这些事情中，有没有对您冲击特别大的事情呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:12:17",
            "content": "たぶん",
            "Chinese": "大概有吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:13:48",
            "content": "ええ、そのことに関してこちらで聞かせていただけますか？",
            "Chinese": "嗯，您愿意在这里和我说说那件事吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:15:08",
            "content": "なんかもう全部しんどいです",
            "Chinese": "感觉什么都好累。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:15:25",
            "content": "絶対言わなきゃいけないんですか？",
            "Chinese": "一定要说出来吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:16:03",
            "content": "いえ、そういうわけではありませんよ。あなたがお話したいことだけで構いません",
            "Chinese": "不，不是那样的。您只说您想说的部分就可以了。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:17:17",
            "content": "もう疲れちゃいました",
            "Chinese": "我已经很累了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:18:24",
            "content": "ええ、色々なことが重なり、苦しんでおられるのですね。",
            "Chinese": "嗯，种种事情叠加在一起，让您很痛苦啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:19:36",
            "content": "最近はどのように過ごされているのですか？",
            "Chinese": "您最近是怎么过的呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:20:31",
            "content": "いろいろ",
            "Chinese": "就那样吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:21:02",
            "content": "例えば、お仕事はいかがでしょうか？",
            "Chinese": "比如说，工作方面怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:21:14",
            "content": "してないです",
            "Chinese": "没在工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:22:10",
            "content": "そうなのですね。では、おうちではいかがでしょうか？",
            "Chinese": "是这样啊。那在家里怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:22:39",
            "content": "家事とかしてます",
            "Chinese": "做做家务之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:23:23",
            "content": "そうなのですね。ご家族とお住まいなのでしょうか？",
            "Chinese": "是这样啊。您是和家人一起住吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:23:35",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:24:21",
            "content": "どなたと一緒にお住まいなのですか？",
            "Chinese": "您和谁一起住呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:24:38",
            "content": "子供1人です",
            "Chinese": "和一个孩子。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:25:03",
            "content": "ええ、お子様とお二人暮らしなのですね。",
            "Chinese": "嗯，您和孩子两个人一起生活啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:27:24",
            "content": "先ほど、もう疲れたとおっしゃっていましたが、おうちのなかでなにかご苦労がおありだったのでしょうか",
            "Chinese": "您刚才说已经很累了，是在家里有什么辛苦的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:27:55",
            "content": "いろいろ",
            "Chinese": "各种各样的事。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:28:02",
            "content": "子育てとか",
            "Chinese": "比如带孩子之类的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:29:36",
            "content": "ええ、子育てにもお疲れなのですね。",
            "Chinese": "嗯，育儿也让您感到疲惫了啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:33:00",
            "content": "例えば、子育てではどんなことが疲れるのでしょうか？",
            "Chinese": "比如说，育儿的哪些方面让您觉得累呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:33:22",
            "content": "全部",
            "Chinese": "全部。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:34:13",
            "content": "あなたのなかで、いま全てが嫌になっておられるのですね。",
            "Chinese": "对您来说，现在好像对一切都感到厌烦了呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:34:33",
            "content": "そうですね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:34:57",
            "content": "終わりにしたい",
            "Chinese": "想结束这一切。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:35:28",
            "content": "ええ、こんな気持ちになるなら終わりにしたいという感じでしょうか",
            "Chinese": "嗯，是“与其要承受这种心情，不如结束这一切”的感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:35:54",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:39:05",
            "content": "そうなのですね。全部が嫌になると苦しいですよね",
            "Chinese": "是这样啊。对一切都感到厌烦，一定很痛苦吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:39:26",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:39:55",
            "content": "もう苦しみたくない",
            "Chinese": "不想再痛苦下去了。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:40:04",
            "content": "だから死にたい",
            "Chinese": "所以想死。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:40:33",
            "content": "ええ、すべて手放して楽になりたいお気持ちなのですね",
            "Chinese": "嗯，您是想放下一切，让自己轻松下来吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:40:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:40:58",
            "content": "もう死んでいいですか",
            "Chinese": "我可以去死了吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:42:10",
            "content": "それくらい今の状況を終わりにしたいのですね",
            "Chinese": "您就是那么迫切地想结束现在的状况啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:42:44",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:44:15",
            "content": "ええ、でもそのようなお気持ちがおありの中、本日このようにお話に来てくださったのですよね",
            "Chinese": "嗯，即便心里有这样的感受，您今天还是愿意来和我谈谈，对吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:45:27",
            "content": "最後に何か言ってこうかなと思って。",
            "Chinese": "想说点什么当作最后的话。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:46:36",
            "content": "言いたいことや、吐き出したいこと他にもありますか？",
            "Chinese": "还有其他想说的话，或者想倾诉的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:47:35",
            "content": "何だろ",
            "Chinese": "该说什么呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:48:10",
            "content": "もう別にいいかな",
            "Chinese": "感觉也无所谓了。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:48:27",
            "content": "死んだら特に意味ないですし。",
            "Chinese": "反正死了也就没什么意义了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:50:06",
            "content": "そのように考えておられるのですね。",
            "Chinese": "您是这么想的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:52:00",
            "content": "死ぬことはご自身のなかでもう決めてらっしゃるのですか？",
            "Chinese": "您心里是不是已经决定要去死了呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:52:44",
            "content": "いずれはと思ってます",
            "Chinese": "我想迟早会的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:54:32",
            "content": "そうなのですね。今すぐではないのは何かあなたに思うところがあるのでしょうか",
            "Chinese": "这样啊。之所以不是现在立刻，是不是您还有什么顾虑或想法呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:55:04",
            "content": "死ぬ方法を探し中です",
            "Chinese": "正在寻找自杀的方法。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:56:05",
            "content": "そうだったのですね。探してみてどんなお気持ちなのでしょうか？",
            "Chinese": "是这样啊。在寻找的过程中，您是什么样的心情呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:56:52",
            "content": "どれがマシな死に方かなと思ってます",
            "Chinese": "我在想哪种死法会好受一点。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:58:20",
            "content": "苦しまない方法という感じでしょうか？",
            "Chinese": "是指不那么痛苦的方法吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:58:38",
            "content": "そんな感じですかね",
            "Chinese": "差不多是这个意思吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 21:59:38",
            "content": "そうなのですね。おひとりで死のうと考えていらっしゃるのでしょうか",
            "Chinese": "是这样啊。您是打算一个人去死吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 21:59:47",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 22:00:50",
            "content": "（すみません。時間配分が全くできておらず、終了時間がきてしまいました）",
            "Chinese": "（不好意思。我完全没有把握好时间，结束的时间已经到了。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 22:01:25",
            "content": "(承知しました。)",
            "Chinese": "（明白了。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 22:01:48",
            "content": "（途中となってしまいましたが、一旦終了の挨拶をさせていただきます。）",
            "Chinese": "（虽然谈话中断了，但请允许我先做结束的问候。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 22:02:03",
            "content": "(お疲れ様でした。ありがとうございました。)",
            "Chinese": "（您辛苦了。非常感谢。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 22:02:29",
            "content": "お話の途中となってしまいましたが、そろそろ終了の時間となってしまいました。本日はお越しくださり、ありがとうございました。",
            "Chinese": "虽然我们话说到一半，但差不多到结束的时间了。感谢您今天前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 22:02:54",
            "content": "ありがとうございました。",
            "Chinese": "非常感谢。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/11/16(水) 22:02:57",
            "content": "（ロープレありがとうございました。）",
            "Chinese": "（角色扮演辛苦了，谢谢。）"
        },
        {
            "role": "クライアント",
            "time": "2022/11/16(水) 22:03:28",
            "content": "(こちらこそありがとうございました。)",
            "Chinese": "（我也要谢谢您。）"
        }
    ],
