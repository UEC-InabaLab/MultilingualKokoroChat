{
    "dialogue": [
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:29:19",
            "content": "こんばんは",
            "Chinese": "晚上好。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:30:09",
            "content": "こんばんわ、よろしくお願いします。",
            "Chinese": "晚上好，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:30:32",
            "content": "本日はどのようなお話でいらっしゃいましたか？",
            "Chinese": "今天您想聊些什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:30:33",
            "content": "宜しくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:31:10",
            "content": "自分に自信がなくなってしまって",
            "Chinese": "我对自己失去了信心。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:31:31",
            "content": "人と会いたくないというか",
            "Chinese": "或者说，我有点不太想见人。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:31:39",
            "content": "会社にも行きたくないんです",
            "Chinese": "我也不想上班了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:31:46",
            "content": "なるほど、、それはお困りですね。",
            "Chinese": "原来如此，这确实让您很困扰呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:31:49",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:32:16",
            "content": "何かきっかけとかございましたか？",
            "Chinese": "是发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:32:58",
            "content": "この間、資格試験があったのですが",
            "Chinese": "前段时间有个资格考试……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:33:06",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:33:31",
            "content": "年下の人が合格したのに私は落ちてしまって",
            "Chinese": "比我年轻的人通过了考试，而我却落榜了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:33:51",
            "content": "そうだったんですね",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:34:29",
            "content": "しかも資格合格で彼女がチームリーダーと言うか、",
            "Chinese": "而且，她因为通过了资格考试，成了我们团队的领导，该怎么说呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:34:57",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:35:04",
            "content": "私の部署の上司みたいな立場になって、指示される側になってしまって",
            "Chinese": "她现在相当于我部门的上司了，我变成了接受她指示的一方。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:35:24",
            "content": "あら、、そうなんですね",
            "Chinese": "哎呀……是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:35:24",
            "content": "毎日本当に嫌なんです",
            "Chinese": "每天都真的很讨厌。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:35:37",
            "content": "なるほど、、",
            "Chinese": "我明白了……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:35:55",
            "content": "失礼ですが、相談者さまの年代など教えていただけますか？",
            "Chinese": "冒昧地问一下，可以告诉我您的年龄段吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:36:22",
            "content": "29才です",
            "Chinese": "29岁。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:36:45",
            "content": "性別も教えて頂いてもよろしいでしょうか？",
            "Chinese": "方便告诉我您的性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:36:50",
            "content": "女性です",
            "Chinese": "女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:37:01",
            "content": "ありがとうございます。。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:37:09",
            "content": "なんとお呼びすれば宜しいでしょうか？",
            "Chinese": "我该怎么称呼您呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:37:23",
            "content": "まきです",
            "Chinese": "我叫真希。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:37:46",
            "content": "ありがとうございますまきさんよろしくお願いします",
            "Chinese": "谢谢您，真希女士，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:37:52",
            "content": "そうしますと、",
            "Chinese": "那么……"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:38:09",
            "content": "宜しくお願いします",
            "Chinese": "请多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:38:15",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:38:18",
            "content": "先日の試験というのは昇格がかかった試験だったのでしょうか？",
            "Chinese": "前几天的那个考试是关系到晋升的考试吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:39:05",
            "content": "昇格をはっきり言われたわけではないですが、資格が無いと昇格はできないという性格の資格ではありました",
            "Chinese": "虽然没有明确说是为了晋升，但那个资格确实是属于没有它就无法晋升的那种。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:40:00",
            "content": "なるほど、まきさんも狙われたわけですね",
            "Chinese": "原来如此，真希女士也是为此而努力的吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:40:02",
            "content": "結構自分ではよいところまでできたと思ったので、落ちたことは本当にショックで",
            "Chinese": "我自己觉得已经考得相当不错了，所以落榜真的让我很受打击。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:40:26",
            "content": "なるほど、、それは落ち込んでしまいますよね",
            "Chinese": "我明白了……那确实会让人很失落呢。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:41:02",
            "content": "わたしも経験ございます、お気持ちお察しします。",
            "Chinese": "我也有过类似的经历，很能理解您的心情。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:41:27",
            "content": "どんな経験なんですか？",
            "Chinese": "是什么样的经历呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:42:01",
            "content": "昇格試験に落ちた経験です；",
            "Chinese": "是晋升考试落榜的经历。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:42:13",
            "content": "もう少し、",
            "Chinese": "再稍微……"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:42:17",
            "content": "そうですか",
            "Chinese": "是这样啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:42:25",
            "content": "お話おきかせいただきたいのですが、",
            "Chinese": "我想再多听您说说，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:42:29",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:42:38",
            "content": "その年下の女性とまきさんとはどのようなご関係だったのでしょうか？",
            "Chinese": "您和那位比您年轻的女士之前是怎样的关系呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:42:51",
            "content": "年齢違いだけど同期です",
            "Chinese": "虽然年龄不同，但我们是同期入职的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:43:15",
            "content": "なるほど、、仲も良かったかんじですか？",
            "Chinese": "我明白了……感觉你们关系也还不错吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:43:38",
            "content": "そうですね、うまく協力していました。彼女が上司に引き立てられて、",
            "Chinese": "是的，我们合作得很好。她很受上司器重，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:44:01",
            "content": "にこにこ話していた李",
            "Chinese": "总是笑盈盈地聊天之类的，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:44:06",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:44:23",
            "content": "業務指示をする朝礼などあって",
            "Chinese": "还有在晨会上布置工作任务什么的，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:44:32",
            "content": "すごく悔しいです",
            "Chinese": "我非常不甘心。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:44:45",
            "content": "いや~な気分になります",
            "Chinese": "心情会变得很糟糕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:44:52",
            "content": "なるほど、、悔しいお気持ちなんですね",
            "Chinese": "我明白了……您是觉得很不甘心，是吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:45:14",
            "content": "どんな部分が特に嫌ですか？",
            "Chinese": "具体是哪些方面让您特别讨厌呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:46:20",
            "content": "実力もある人だから仕方ないですが、たぶん資格試験の成績もそんなに違わないと思うのに",
            "Chinese": "她确实有实力，所以也没办法，但我觉得我们的资格考试成绩应该也差不了多少。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:46:36",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:46:41",
            "content": "周りからちやほやされて",
            "Chinese": "却被周围的人捧着、夸着。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:46:54",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:47:29",
            "content": "けど私は今まで通り、ルーティーンワークのまま",
            "Chinese": "而我却和以前一样，还是做着常规工作。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:47:47",
            "content": "なるほど、、",
            "Chinese": "我明白了……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:48:22",
            "content": "その年下の女性と比べてしまう感じでしょうか？",
            "Chinese": "您会不自觉地拿自己和那位比您年轻的女士作比较吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:48:34",
            "content": "彼女も悪気はないかもしれないけど、にこにこ話しかけてきて",
            "Chinese": "她可能也没有恶意，但总是笑眯眯地来跟我搭话，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:48:38",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:48:52",
            "content": "私に力が無いってことを",
            "Chinese": "自己没有能力这件事，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:48:54",
            "content": "つうかんします",
            "Chinese": "让我痛切地感受到了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:49:15",
            "content": "なるほど、、そこが一番気になる感じなのですね",
            "Chinese": "原来如此……这一点是最让您在意的吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:49:34",
            "content": "もし、、ですが、",
            "Chinese": "如果……只是设想一下，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:49:39",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:50:00",
            "content": "まきさんも試験に合格してたらどうなってましたか？",
            "Chinese": "如果真希女士您也通过了考试，情况会怎么样呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:50:46",
            "content": "分かりませんが、同じ立場で違うグループに配属されたかも",
            "Chinese": "我也不确定，但可能我们会在同等的职位上，被分配到不同的团队。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:50:57",
            "content": "なるほど、、",
            "Chinese": "原来如此。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:51:05",
            "content": "そうなってたら",
            "Chinese": "如果真是那样的话，"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:51:27",
            "content": "いまのような嫌な気持ちにはならずにいられましたか？",
            "Chinese": "您是不是就不会有现在这种讨厌的感觉了呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:51:30",
            "content": "でも現実に今は毎日彼女の指示で仕事して、",
            "Chinese": "但现实是，我现在每天都要听从她的指示工作，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:51:41",
            "content": "毎日嫌な気持ちになって",
            "Chinese": "每天心情都很糟糕。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:51:50",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:52:29",
            "content": "正直、彼女を褒めて持ち上げている同僚の顔を見るのも嫌な気持ちです",
            "Chinese": "说实话，看到那些夸她、捧她的同事，我心里也很不舒服。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:52:48",
            "content": "わたしができないのがわるいんですけど",
            "Chinese": "虽然是我自己能力不行才这样的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:53:04",
            "content": "なるほど、今のグループは何名くらいいらっしゃるのでしょうか？",
            "Chinese": "我明白了，您现在的小组大概有多少人呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:53:28",
            "content": "8名です",
            "Chinese": "8个人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:53:58",
            "content": "なるほど、、他の方々も嫌な思いされてる感じですか？",
            "Chinese": "原来如此……其他人也有类似不舒服的感觉吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:54:15",
            "content": "いえ、彼女を褒めたりしてます",
            "Chinese": "没有，他们都在夸奖她。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:54:30",
            "content": "なるほど、、",
            "Chinese": "原来如此。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:54:44",
            "content": "よく出来る人なのは本当なので",
            "Chinese": "因为她确实是个很能干的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:54:55",
            "content": "まきさんのお悩みは、他の方に相談されたりしてますか？",
            "Chinese": "真希女士，您有跟其他人谈过您的烦恼吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:55:07",
            "content": "かいしゃでですか？",
            "Chinese": "在公司里吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:55:13",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:55:34",
            "content": "みんなおめでとうムードなのに言えません",
            "Chinese": "大家都是一片祝贺的氛围，我说不出口。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:55:51",
            "content": "なるほど、、そういう感じなのですね。",
            "Chinese": "原来如此……是那样的氛围啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/01/07(木) 18:55:58",
            "content": "まきさんは、",
            "Chinese": "真希女士您，"
        },
        {
            "role": "クライアント",
            "time": "2021/01/07(木) 18:56:15",
