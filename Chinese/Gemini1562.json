{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 14:50:48",
            "content": "本日はよろしくおねがいいたします",
            "Chinese": "今天请多多关照。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 14:56:36",
            "content": "よろしくお願いいたします。",
            "Chinese": "请多多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 14:57:09",
            "content": "さっそく始めてもよろしいでしょうか？それとも15時ぴったりに始めますか？",
            "Chinese": "我们现在就开始可以吗？还是等到15点整再开始？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 14:57:52",
            "content": "今から開始で大丈夫ですよ。",
            "Chinese": "现在开始就可以的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 14:58:06",
            "content": "了解しました。では始めます。",
            "Chinese": "明白了。那么我们开始吧。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 14:58:17",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 14:58:28",
            "content": "こんいちは、相談員です。本日はどのようなご相談でしょうか？",
            "Chinese": "您好，我是咨询师。今天您有什么想咨询的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 14:58:57",
            "content": "恋人のことです。",
            "Chinese": "是关于我恋人的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 14:59:11",
            "content": "恋人のことなんですね。",
            "Chinese": "原来是关于您恋人的事啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 14:59:19",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 14:59:34",
            "content": "もしよろしければもう少し詳しくお話いただけますか？",
            "Chinese": "如果您方便的话，能再详细地跟我说说吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:00:41",
            "content": "私は30代。彼は10才年したです。",
            "Chinese": "我30多岁，他比我小10岁。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:00:58",
            "content": "はい、ありがとうございます。",
            "Chinese": "好的，谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:01:54",
            "content": "その女性と何かありましたか？",
            "Chinese": "您和那位女性之间发生了什么事吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:02:12",
            "content": "私たちは結構うまくいっていると思っていました。",
            "Chinese": "我原以为我们相处得还挺顺利的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:02:13",
            "content": "失礼しました。その男性でした。",
            "Chinese": "不好意思，是那位男性。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:02:22",
            "content": "行き違いました。",
            "Chinese": "我搞错了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:02:35",
            "content": "そうなんですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:03:32",
            "content": "でも彼は最初から結婚する気はないよと言っていました。",
            "Chinese": "不过他从一开始就说没有结婚的打算。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:03:46",
            "content": "そんなことがあったんですね、、、",
            "Chinese": "发生过那样的事啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:04:03",
            "content": "そう言われるとショックですね、、",
            "Chinese": "被那样说确实会很受打击呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:05:49",
            "content": "ちなみに彼のその発言はいつ頃聞きましたか？",
            "Chinese": "顺便问一下，您大概是什么时候听到他那样说的？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:06:01",
            "content": "私は付きあっているうちに彼の気持ちは変わってくれるかもしれないとあまり深刻に受け止めていませんでした。",
            "Chinese": "我当时没有太当回事，想着在交往的过程中，他的想法也许会改变。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:06:29",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:07:24",
            "content": "彼のその発言は付き合い始めてすぐです。",
            "Chinese": "他说那话，是在我们刚开始交往的时候。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:07:41",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:07:50",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:09:01",
            "content": "今回のこのご相談でお話しておきたいことは何でしょうか？",
            "Chinese": "在这次咨询中，您最想谈的是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:09:17",
            "content": "私はなるべく結婚がらみの話しは出さないようにしていました。",
            "Chinese": "我一直尽量避免提起和结婚有关的话题。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:09:31",
            "content": "ええ",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:09:38",
            "content": "（聞いてますね）",
            "Chinese": "（我在认真聆听）"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:11:05",
            "content": "彼と一緒にいる時間の楽しい雰囲気を壊したくなかったのです。",
            "Chinese": "我不想破坏和他在一起时那种愉快的氛围。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:11:24",
            "content": "そうなんですね。。",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:11:53",
            "content": "彼との楽しい時間を大事にされてたんですね。",
            "Chinese": "您一直很珍惜与他在一起的美好时光呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:12:37",
            "content": "はい。私は彼に対して心を開くようになっていきました。",
            "Chinese": "是的。我渐渐地向他敞开了心扉。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:13:18",
            "content": "そうだったんですね。楽しいと安心しますよね。",
            "Chinese": "原来是这样。感到快乐就会安心呢。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:14:38",
            "content": "そうしてある日思い切って結婚のことをどう思っているのか聞いて見ました。",
            "Chinese": "于是有一天，我鼓起勇气问了他对结婚这件事的看法。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:14:57",
            "content": "ええ。ええ。",
            "Chinese": "嗯。嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:15:08",
            "content": "（聞いてますね）",
            "Chinese": "（我在认真聆听）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:16:03",
            "content": "そしたらどのような答えが来ましたか？",
            "Chinese": "那么他当时是怎么回答的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:16:52",
            "content": "すると、彼は今は仕事のことで一杯。結婚のことは考える余地がないと言ったのです。",
            "Chinese": "他说，他现在满脑子都是工作，没有余地考虑结婚的事情。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:17:30",
            "content": "そのようなことが、、",
            "Chinese": "竟然是这样……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:18:19",
            "content": "最初の言葉と違いがあって困っちゃいますね、、",
            "Chinese": "这和最初的话有些出入，真让人困扰呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:18:54",
            "content": "やっぱりとは思ったものの、私にとっては大きなショックでした。",
            "Chinese": "虽然我也觉得“果然如此”，但对我来说还是一个很大的打击。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:19:17",
            "content": "そう感じるのも無理はないと思いますよ。",
            "Chinese": "我觉得您有这种感觉是很正常的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:21:04",
            "content": "ちなみに結婚のことについてはいつ頃聞きましたか？",
            "Chinese": "顺便问一下，您大概是什么时候问他关于结婚的事的？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:22:37",
            "content": "付き合い始めた当初から、彼は結婚のことは考えられないと言っていたので、そうか、やっぱりと思ったのですが。",
            "Chinese": "因为在刚开始交往时他就说过无法考虑结婚，所以我心想，“果然是这样啊”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:22:51",
            "content": "うんうん",
            "Chinese": "嗯嗯。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:25:43",
            "content": "私との結婚をどう思っているかと聞いたのではなく、結婚というものについてどう思っているのかと聞いたのです。",
            "Chinese": "我问的并不是他对和我结婚的看法，而是他对“结婚”这件事本身怎么看。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:26:12",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:26:39",
            "content": "3ヵ月ほど前のことです。",
            "Chinese": "是大概3个月前的事。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:27:15",
            "content": "３か月前なんですね。",
            "Chinese": "是三个月前啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:28:04",
            "content": "わかってはいてもいざ言われるとそう思うのも無理はないですね。。",
            "Chinese": "即使心里明白，但真的被他这么说时，会那样想也是很正常的。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:28:39",
            "content": "わたしはすっかり衝撃を受けて、それから何もする気が起きなくなってしまいました。",
            "Chinese": "我大受打击，从那之后就做什么都提不起劲了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:29:18",
            "content": "そうなんですね、、落ち込んでしまいますよね、、",
            "Chinese": "是这样啊……难免会沮丧呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:29:47",
            "content": "今は彼とのやり取りはどんな感じですか？",
            "Chinese": "现在您和他之间的互动是怎样的呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:31:28",
            "content": "しばらくして、この人と付き合っていてもしょうがないと思い、お別れのご挨拶をしました。",
            "Chinese": "过了一段时间，我觉得和这个人继续交往下去也没有意义，就向他提出了分手。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:31:52",
            "content": "挨拶をしたんですね。",
            "Chinese": "您提出分手了啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:32:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:32:11",
            "content": "その時の彼の反応はいかがでした？",
            "Chinese": "当时他的反应如何呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:33:08",
            "content": "彼は淡々としていました。",
            "Chinese": "他显得很冷静、平淡。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:33:37",
            "content": "そうだったんですね。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:33:43",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:33:59",
            "content": "そのときのあなたの感情はどんな感じでしたか？",
            "Chinese": "那时您的感受是怎样的？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:34:52",
            "content": "私にとってもそれは予想通りでした。",
            "Chinese": "对我来说，那也在意料之中。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:35:14",
            "content": "やっぱりねと。",
            "Chinese": "心想“果然如此”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:35:29",
            "content": "そう感じたんですね。",
            "Chinese": "您是那样感受到的啊。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:36:08",
            "content": "３か月前に結婚について聞いた時との感情の違いはありましたか？",
            "Chinese": "和三个月前问起结婚时相比，您的感受有什么不同吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:36:31",
            "content": "あなたのですね",
            "Chinese": "我是指您的感受。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:40:05",
            "content": "3か月前に聞いた時は、もしかして、結婚というものについて少しは考えが変わっているかもしれないと僅かな変化の期待をもっていたと思います。",
            "Chinese": "我想，3个月前问的时候，我心里还抱着一丝期待，觉得他对于结婚这件事的想法或许已经有了一些改变。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:40:28",
            "content": "ええ。",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:40:35",
            "content": "（聞いてますね）",
            "Chinese": "（我在认真聆听）"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:41:48",
            "content": "期待を裏切られたようになってしまいますよね、、",
            "Chinese": "那会让人感觉像是期待落空了呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:42:42",
            "content": "彼にお別れのご挨拶をして、しばらくすると寂しさがこみ上げてきました。",
            "Chinese": "向他道别之后，过了一阵子，寂寞感慢慢涌上来了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:42:58",
            "content": "そうなんですね、、",
            "Chinese": "是这样啊……"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:43:33",
            "content": "寂しさが出るのも無理はないと思いますよ。",
            "Chinese": "感到寂寞也是很自然的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:43:51",
            "content": "それほど彼との時間が楽しかったんですね、、",
            "Chinese": "可见与他在一起的时光，对您来说真的很愉快呢……"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:45:35",
            "content": "期待を裏切られたというより、こっちが勝手に期待して思い通りにならなくって、がっかりしているんだろうなと思っています。",
            "Chinese": "与其说是期待被辜负，我更觉得是自己单方面地期待，结果不如意，所以才感到失望吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:46:05",
            "content": "そのように思っていたんですね。",
            "Chinese": "您是这样想的啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:46:18",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:46:41",
            "content": "ここまでを少しまとめてもよろしいでしょうか？",
            "Chinese": "我可以稍微总结一下到目前为止的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:47:04",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:47:25",
            "content": "彼は最初は結婚する気はないと言っていた。",
            "Chinese": "他一开始就说没有结婚的打算。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:47:55",
            "content": "最初からです。",
            "Chinese": "从一开始就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:48:00",
            "content": "それとすみません、今更ではあるのですがあなたのお名前をお聞きしてもよろしいでしょうか？",
            "Chinese": "另外，不好意思，虽然现在问有些晚了，可以请教一下您的名字吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:48:09",
            "content": "失礼しました。",
            "Chinese": "失礼了。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:48:22",
            "content": "さちです。",
            "Chinese": "我叫幸。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:48:34",
            "content": "さちさんですね。ありがとうございます。",
            "Chinese": "是幸女士吧。谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:49:21",
            "content": "さちさんはなるべく結婚がらみの話しは出さないようにしていました。",
            "Chinese": "幸女士您一直尽量避免提起和结婚有关的话题。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:49:33",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:50:22",
            "content": "さちさんは付き合っていくうちに彼の気持ちが変わるかもしれないとわずかな変化を期待していました。",
            "Chinese": "幸女士在交往过程中，抱着“也许他的想法会改变”的一丝期待。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:50:34",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:51:15",
            "content": "３か月前に思い切って結婚について聞いてみたら彼は仕事で一杯だから結婚は考えられないと言っていた。",
            "Chinese": "3个月前，您鼓起勇气问他关于结婚的事，他说因为工作太忙，无法考虑结婚。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:51:28",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:52:08",
            "content": "幸さんは大きなショックを受けてしばらくしてから彼とお別れした後寂しさが込みあがっていた。",
            "Chinese": "幸女士受到很大打击，过了一段时间和他分手后，寂寞感涌了上来。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:52:20",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:52:22",
            "content": "という感じでよろしいでしょうか？",
            "Chinese": "这样总结可以吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:52:49",
            "content": "はい。その通りです。",
            "Chinese": "是的，就是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:53:09",
            "content": "寂しさが感じてしまうのも無理はないとおもいます。",
            "Chinese": "我觉得您会感到寂寞是很正常的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:53:46",
            "content": "でもその寂しさは彼との時間が本当に楽しかったからだと私は見えるのですがいかがでしょうか？",
            "Chinese": "但在我看来，这份寂寞，也正说明了您和他在一起的时光真的非常快乐，您觉得呢？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:54:27",
            "content": "なるほど。　それで、実はその後で、彼にラインしました。",
            "Chinese": "原来如此。其实在那之后，我给他发了LINE消息。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:54:45",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:55:08",
            "content": "差支えなければどのようなラインでしたか？",
            "Chinese": "如果不介意的话，能说说您发了什么消息吗？"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:55:52",
            "content": "会いたくなったら会ってくれる?と。",
            "Chinese": "“如果我想见你，你会见我吗？”"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:56:10",
            "content": "ええ。ええ。",
            "Chinese": "嗯。嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:56:16",
            "content": "（聞いてますね）",
            "Chinese": "（我在认真聆听）"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:56:48",
            "content": "すると彼からはOKと返事がきました。",
            "Chinese": "然后他回复说“OK”。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:57:37",
            "content": "そうだったんですね。",
            "Chinese": "原来是这样。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:58:32",
            "content": "それで1度会ってみましたが、やっぱり何か大事なものが違っているなと感じでしまいました。",
            "Chinese": "于是我们见了一次面，但我还是感觉，有什么重要的东西不太一样了。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:58:53",
            "content": "そのように感じたんですね。",
            "Chinese": "您有那样的感受啊。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 15:59:04",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:59:08",
            "content": "もやもやしてしまいますよね",
            "Chinese": "心里会有一种说不清的烦闷感吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 15:59:30",
            "content": "（実はお時間なのですがこのまま続けますか？）",
            "Chinese": "（其实时间差不多了，您希望继续吗？）"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 16:00:10",
            "content": "彼のことはもう考えないことにします。",
            "Chinese": "我决定不再想他的事了。"
        },
        {
            "role": "クライアント",
            "time": "2021/04/04(日) 16:00:41",
            "content": "今日は終わりにします。",
            "Chinese": "今天就到这里吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2021/04/04(日) 16:00:50",
            "content": "そのように考えたんですね。",
            "Chinese": "您是这样决定的啊。"
        },
        {
