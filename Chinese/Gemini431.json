{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:25:59",
            "content": "こんにちは。",
            "Chinese": "您好。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:26:13",
            "content": "こんにちは。よろしくお願い致します",
            "Chinese": "您好。请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:27:05",
            "content": "少し早いですが、始めても大丈夫でしょうか？",
            "Chinese": "现在可能有点早，请问可以开始吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:27:31",
            "content": "時間になってからでお願い致します。",
            "Chinese": "请等时间到了再开始。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:27:49",
            "content": "はい、わかりました。",
            "Chinese": "好的，我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:30:24",
            "content": "こんにちは。相談員です。今日はどのようなご相談でしょうか。",
            "Chinese": "您好。我是咨询师。今天您想咨询什么问题呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:31:50",
            "content": "はじめまして。学校でいじめられてて",
            "Chinese": "您好。我在学校被霸凌了……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:31:56",
            "content": "どうしたらいいのかわかりません、、",
            "Chinese": "我不知道该怎么办才好……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:32:25",
            "content": "そうなんですね・・ご自身がですか？",
            "Chinese": "是这样啊……是您自己吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:32:53",
            "content": "いいえ。友達がです。",
            "Chinese": "不是，是我的朋友。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:33:18",
            "content": "見てるのも辛くて",
            "Chinese": "我看着也觉得很难受。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:34:22",
            "content": "それは、辛いですよね。もう少し、ご様子をお聞きしてもいいですか？",
            "Chinese": "那一定很难受吧。可以请您再多说一些具体情况吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:34:36",
            "content": "はい、、",
            "Chinese": "好的……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:35:09",
            "content": "どの様ないじめなのでしょうか？",
            "Chinese": "是怎样的霸凌呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:35:34",
            "content": "仲のいい友達がいるのですが、無視されたり、陰口受けていたりしていて、、",
            "Chinese": "我有个关系很好的朋友，她被大家无视，还在背后被说坏话……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:35:49",
            "content": "自分は見て見ぬふりするしかなくて",
            "Chinese": "我只能假装没看见。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:36:42",
            "content": "それは、見ていても辛くて嫌な気分になりますね。いつから、そのような状況になったのでしょうか？",
            "Chinese": "看到那种情况，确实会让人感到难受和不快。这种情况是从什么时候开始的呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:37:48",
            "content": "2週間まえほどですね",
            "Chinese": "大概是两周前吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:39:02",
            "content": "そうなんですね。もう、２週間もそんな情景を見られていて、辛くなられたんですね？何か、きっかけがあったのでしょうか？",
            "Chinese": "是这样啊。您已经看了两周这样的情景，一定很难受吧？是有什么起因吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:39:17",
            "content": "はい。",
            "Chinese": "有的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:39:20",
            "content": "辛いですね。",
            "Chinese": "很难受。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:39:29",
            "content": "きっかけは、、、、よくわからないです。",
            "Chinese": "起因……我也不太清楚。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:39:50",
            "content": "もともと、ハッキリものを言う性格だからかもしれません。",
            "Chinese": "可能是因为她本来就是个说话很直的人。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:40:26",
            "content": "お友達のご様子はどうですか？",
            "Chinese": "您的朋友现在的状态怎么样？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:40:57",
            "content": "元気がないです",
            "Chinese": "她没什么精神。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:41:43",
            "content": "かわいそうですね。お友達とは、何か話されましたか？",
            "Chinese": "真让人心疼。您有和她聊过吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:41:57",
            "content": "はい。かわいそうです。",
            "Chinese": "是的，她很可怜。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:42:25",
            "content": "帰りにこっそり話しました。",
            "Chinese": "回家的路上我们悄悄聊了聊。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:42:37",
            "content": "でも、元気なくて、、",
            "Chinese": "但她还是提不起劲……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:42:56",
            "content": "「わたしのことはほっといていいから」って。",
            "Chinese": "她说：“你不用管我了。”"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:43:50",
            "content": "そうなんですね。お友達に迷惑をかけたくないと思われたのかもしれませんね。",
            "Chinese": "是这样啊。她可能是不想给您添麻烦吧。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:44:24",
            "content": "それを聞いてどんな風に思われましたか？",
            "Chinese": "听了这话，您有什么感受呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:46:57",
            "content": "さとさんとお呼びしても大丈夫ですか？答えにくかったら、大丈夫ですよ。",
            "Chinese": "我可以称呼您为“Sato”小姐吗？如果不好回答也没关系。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:51:15",
            "content": "そうですね",
            "Chinese": "可以。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:51:55",
            "content": "複雑な気持ちです。",
            "Chinese": "心情很复杂。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:52:59",
            "content": "(すみません。今電波がわるくて、、、もしかしたら時間差あるかもしれません。申し訳ありません。)",
            "Chinese": "（不好意思，现在网络不太好……可能会有延迟。非常抱歉。）"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:52:59",
            "content": "「さとさん」で構いません。",
            "Chinese": "叫我“Sato”就可以。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:54:34",
            "content": "いじめにあっている、お友達を見ていて、とても辛いと思われているんですね。それに対して、見ているしかない自分に何となく釈然としない思いがおありなんですね。今日、ここでお話にお越しいただいたのは、一番そこをお話されたいですか？さとさんのお気持ちを、もう少しお聞かせ頂ければと思うのですが",
            "Chinese": "看着被霸凌的朋友，您感到非常难受。同时，对于只能旁观的自己，您也感到有些无法释怀。您今天来这里，是想主要谈谈这方面的事情吗？如果可以的话，我想再多听听Sato小姐您的感受。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:56:33",
            "content": "はい。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:56:38",
            "content": "何も出来ないのはつらいですね",
            "Chinese": "什么都做不了，真的很难受。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:57:02",
            "content": "わたしはどうしたらいいのか、、、、",
            "Chinese": "我到底该怎么办才好……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:57:26",
            "content": "本当にね。友達だと余計にそう思いますよね。",
            "Chinese": "是啊。因为是朋友，所以感觉会更强烈吧。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:57:46",
            "content": "はい。確かに、その子にも火がない訳ではないと思うのです。",
            "Chinese": "是的。不过，我觉得她自己也不是完全没有问题。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:59:04",
            "content": "でも、わたしもその子に対して強くいうことはできないですし。",
            "Chinese": "但是，我也没法对她说什么重话。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 16:59:29",
            "content": "そう思われるのですね。先ほど、そのお友達は、ものをはっきりと言われるタイプだといわれていましたね。",
            "Chinese": "您是这么想的啊。您刚才也提到，您的朋友是那种说话很直的人。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 16:59:45",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:00:44",
            "content": "そういう所にも、今回のいじめの原因があるのではないかと、さとさんは思っていらっしゃるという事ですね？",
            "Chinese": "所以Sato小姐您认为，这次霸凌的原因可能也和她这个性格有关，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:04:02",
            "content": "そうですね。",
            "Chinese": "是的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:04:31",
            "content": "でも、その子のことを否定するのもなんかしたくないし、、、、",
            "Chinese": "但是，我也不想否定她的性格……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:06:29",
            "content": "さとさんには、今回のいじめのはっきりしたそうですね。今は、そのお友達も傷ついていらっしゃるでしょうし。原因が分からない、という事ですが、原因は何であれ、いじめは見ていても嫌な光景ですね。何かしてあげたい、と思うなおさんのお気持ちは、その友人はご存じですか？",
            "Chinese": "Sato小姐您似乎对这次霸凌有很明确的看法。现在您的朋友肯定也很受伤。您说不知道原因，但无论原因是什么，霸凌都是让人不忍目睹的景象。您朋友知道您（Nao小姐）想为她做点什么的心情吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:06:52",
            "content": "すみません、誤字です",
            "Chinese": "抱歉，打错字了。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:07:16",
            "content": "なんだかもやもやします。",
            "Chinese": "总觉得心里很堵。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:09:00",
            "content": "どうでしょう、、、",
            "Chinese": "我也不太确定……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:09:00",
            "content": "わたしは「大丈夫？」と声かけることしかできません。",
            "Chinese": "我只能问她“你还好吗？”"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:09:42",
            "content": "そうですね。でも、お友達は、そういう風に、自分の事を心配してくれている、なおさんがいてくれるだけでも、凄く支えになってると思いますよ。",
            "Chinese": "是啊。不过，我觉得对您的朋友来说，有您（Nao小姐）这样关心她的人在身边，本身就是一种巨大的支持了。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:10:30",
            "content": "あ。さとです。",
            "Chinese": "啊，我叫Sato。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:10:40",
            "content": "どうなんでしょうか",
            "Chinese": "会是这样吗？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:10:44",
            "content": "すみません",
            "Chinese": "非常抱歉。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:10:48",
            "content": "いいえ",
            "Chinese": "没关系。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:11:14",
            "content": "支えになっているのかどうか",
            "Chinese": "不知道是不是真的成了她的支持。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:11:45",
            "content": "明らかなイジメっていうわけでもないし、先生に相談もできないです",
            "Chinese": "这也不算是很明显的霸凌，所以也没法跟老师说。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:12:26",
            "content": "もう学校に行きたくないと言っています。",
            "Chinese": "她说她已经不想去学校了。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:13:51",
            "content": "そうなんですね・・・そうやって、さとさんには気持ちを話されているんですね。だれもいない、と孤独感におちいっているかもしれないお友達に、こっそりとでも、声をかけてくれる友人がいるって、ありがたいですよ。",
            "Chinese": "是这样啊……但她愿意把心里话对Sato您说。对于一个可能陷入“身边一个人都没有”这种孤独感的朋友来说，能有一个哪怕是悄悄关心她的朋友，也是非常难得和可贵的。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:14:30",
            "content": "こんなことし出来ない自分が情けないばかりです。",
            "Chinese": "只能做这些事的自己，让我觉得很没用。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:15:56",
            "content": "そんな、情けないなんて。いじめの問題は難しいです。でも、さとさんは、そうやって、一生懸命考えていらっしゃる。",
            "Chinese": "别这么说，您一点也不没用。霸凌问题本身就很复杂。但Sato小姐您在这样努力地为朋友着想。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:17:32",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:17:46",
            "content": "このまま、いじめがエスカレートしたり、お友達が学校に来なくなった時、さとさんは、先生にご相談されたりできると思いますか？",
            "Chinese": "如果霸凌继续升级，或者您的朋友不去上学了，到那时候，Sato小姐您觉得您能和老师商量吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:18:10",
            "content": "わからないです、、",
            "Chinese": "我不确定……"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:18:47",
            "content": "先生もちゃんと話を聞いてくれるかどうか、、",
            "Chinese": "也不知道老师会不会认真听我说……"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:20:15",
            "content": "そうですね。無理はしない方がいいかもしれませんね。先生にはご相談しにくい感じですか？",
            "Chinese": "说得也是。也许不必勉强。是不是觉得不太好跟老师开口？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:20:42",
            "content": "今の先生はなんとなく話にくくて",
            "Chinese": "总觉得现在的老师不太好说话。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:22:12",
            "content": "そうなんですね。それは、ちょっと辛いですね。今、そのお友達に、さとさんが、無理なく出来そうな事は、何かありますか？",
            "Chinese": "是这样啊。那确实有点难办呢。现在，在您力所能及的范围内，有什么可以为您朋友做的事情吗？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:22:31",
            "content": "はい。",
            "Chinese": "有的。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:22:47",
            "content": "なんでしょうか？",
            "Chinese": "是什么呢？"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:22:50",
            "content": "適宜、連絡とることでしょうか？",
            "Chinese": "应该是适时地和她保持联系吧？"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:23:18",
            "content": "あぁ、それは、とてもいい事だと思います。",
            "Chinese": "啊，我觉得这非常好。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:23:46",
            "content": "いきなり連絡とれなくなったりしたら怖いですけど。",
            "Chinese": "不过，如果突然联系不上了会很害怕。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:24:09",
            "content": "その子は感情の浮き沈みが激しいから",
            "Chinese": "因为她情绪起伏很大。"
        },
        {
            "role": "カウンセラー",
            "time": "2020/09/14(月) 17:24:55",
            "content": "少しでも、自分が無理なく出来る事があれば、それをして上げてください。それで、十分だと思いますよ。",
            "Chinese": "只要是您力所能及的事情，哪怕只是一点点，都可以去做。我觉得那样就足够了。"
        },
        {
            "role": "クライアント",
            "time": "2020/09/14(月) 17:25:12",
            "content": "そうなんですかね？こんなことでいいのでしょうか？",
