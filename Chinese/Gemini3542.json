{
    "dialogue": [
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:25:09",
            "content": "（本日は宜しくお願い致します。時間になりましたら始めさせて頂きます）",
            "Chinese": "（今天请多关照。时间到了我们就开始。）"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:25:25",
            "content": "わかりました、宜しくお願い致します。",
            "Chinese": "明白了，请多关照。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:25:59",
            "content": "（ありがとうございます）",
            "Chinese": "（非常感谢。）"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:30:40",
            "content": "こんばんは。相談員です。",
            "Chinese": "晚上好。我是咨询师。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:30:52",
            "content": "こんばんは。",
            "Chinese": "晚上好。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:31:26",
            "content": "今日はご相談に来て下さってありがとうございます。",
            "Chinese": "感谢您今天前来咨询。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:31:38",
            "content": "はい、宜しくお願いします",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:32:34",
            "content": "宜しくお願いします、こちらこそ。始めに、年齢と性別をお伺いしても良いですか？",
            "Chinese": "也请您多关照。首先，可以请问您的年龄和性别吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:32:52",
            "content": "20代　女性です。",
            "Chinese": "20多岁，女性。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:33:26",
            "content": "ありがとうございます。",
            "Chinese": "谢谢您。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:33:31",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:34:08",
            "content": "今日のご相談の内容を教えて頂けますか？",
            "Chinese": "可以请您说明一下今天想咨询的内容吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:34:28",
            "content": "パートナーに対して",
            "Chinese": "是关于我伴侣的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:34:37",
            "content": "たまにきつい言い方になってしまうことがあるので",
            "Chinese": "我有时候会对他说话很冲，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:34:40",
            "content": "相談したいです。",
            "Chinese": "所以想就这件事来咨询一下。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:35:09",
            "content": "承知いたしました。",
            "Chinese": "好的，我明白了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:36:56",
            "content": "パートナーの方にきつい言い方になる、ということですね。ご自身ではそれを直したいと思っていらっしゃるということでしょうか？",
            "Chinese": "您是说，您会对伴侣说话很冲，是这样吗？您自己是希望能改掉这一点吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:37:05",
            "content": "そうでさね",
            "Chinese": "是的呢。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:37:08",
            "content": "それを治したいです",
            "Chinese": "我想改掉这个毛病。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:38:08",
            "content": "そうでしたか、ご自身でそうお考えになるというのはとても誠実な方と感じます。",
            "Chinese": "原来如此，您能这样自我反思，我觉得您是一位非常真诚的人。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:38:17",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:38:49",
            "content": "どんなシーンできつい言い方になってしますのでしょうか？",
            "Chinese": "通常是在什么样的情况下，您会用比较冲的语气说话呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:39:12",
            "content": "自分が正しいと思った時",
            "Chinese": "当我觉得自己是对的时候，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:39:13",
            "content": "に",
            "Chinese": "就会"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:39:28",
            "content": "きつい言い方になります",
            "Chinese": "用很冲的语气说话。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:39:31",
            "content": "シーンは",
            "Chinese": "具体情况"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:39:45",
            "content": "バラバラですが",
            "Chinese": "虽然每次都不太一样，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:39:47",
            "content": "話し合いとか",
            "Chinese": "比如在讨论事情的时候，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:40:00",
            "content": "いつもより深いお互いの関係に関する話になった時",
            "Chinese": "或者在聊一些比平时更深入的、关于我们俩关系的话题时，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:40:10",
            "content": "相手のことをしっかり傾聴せずに",
            "Chinese": "我没有认真倾听对方，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:40:21",
            "content": "なんていうんでしょう",
            "Chinese": "该怎么说呢……"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:40:23",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:40:34",
            "content": "相手のことを最後までしっかり話を聞かずに",
            "Chinese": "没能耐心地把对方的话听到最后，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:40:38",
            "content": "多分こういうことだろうなって",
            "Chinese": "就觉得“大概是这么回事吧”，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:40:45",
            "content": "推測したら",
            "Chinese": "一旦这么推测，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:40:51",
            "content": "自分の意見をすごく言って",
            "Chinese": "我就会拼命表达自己的意见，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:40:55",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:41:01",
            "content": "決めつけてしまう？感じです",
            "Chinese": "感觉就像是单方面下结论？有种武断的感觉。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:41:53",
            "content": "なるほど、パートナーの方とお話するときに、自分が正しいと思うと、",
            "Chinese": "我明白了，就是说和您的伴侣交谈时，一旦您觉得自己是正确的，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:42:34",
            "content": "相手の話より、ご自身の価値観や判断が",
            "Chinese": "相较于对方的话，您自己的价值观和判断就会……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:43:03",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:43:30",
            "content": "正しいと感じると、最後まで話を聞く前にきつい言い方をしてしまうということでしょうか。",
            "Chinese": "当您觉得自己的想法是正确的，就会在听完对方的话之前，用很冲的语气说话，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:43:50",
            "content": "そうです",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:44:26",
            "content": "それは無理も無いと思いますが、",
            "Chinese": "我觉得那也是人之常情，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:44:56",
            "content": "パートナーの方とは穏やかにお話が出来た方が良いですよね。",
            "Chinese": "但如果能和伴侣平心静气地交谈，那会更好，对吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:45:14",
            "content": "そうですね、そう思います",
            "Chinese": "是啊，我也是这么想的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:46:21",
            "content": "喧嘩をしたときではなく、普段の会話の中できつくなってしまいますか？",
            "Chinese": "不只是在吵架的时候，平时对话时也会变得语气很冲吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:46:35",
            "content": "なりますね",
            "Chinese": "会的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:46:45",
            "content": "最初は頑張るんです",
            "Chinese": "一开始我会努力克制的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:46:51",
            "content": "そうでしたか。",
            "Chinese": "是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:46:56",
            "content": "でも",
            "Chinese": "但是"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:46:58",
            "content": "どんどん",
            "Chinese": "渐渐地"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:47:04",
            "content": "我慢できなくなって",
            "Chinese": "就忍不住了，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:47:11",
            "content": "抑圧しようとしてしまいます",
            "Chinese": "会想要压制对方。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:47:31",
            "content": "なるほど、そうだったのですね。",
            "Chinese": "原来如此，是这样啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:47:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:48:14",
            "content": "けれど、抑制しよう、気をつけようと思っていらっしゃることは、非常に良いことだと思います。",
            "Chinese": "但是，您能想着要去克制、要去注意，我觉得这本身就是一件非常好的事。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:48:23",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:49:15",
            "content": "いえいえ、パートナーとは言っても、完全に価値観が一緒ではありませんし、",
            "Chinese": "不客气。虽说是伴侣，但价值观也不可能完全相同，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:49:36",
            "content": "はい",
            "Chinese": "是的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:50:30",
            "content": "自分がこう考えていると言うことを分かってもらえないときには、つい激しい口調になるのも無理はないと思います。",
            "Chinese": "当对方无法理解自己的想法时，会忍不住用激烈的语气说话，我觉得这也是难免的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:51:07",
            "content": "そうですよね",
            "Chinese": "是啊。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:51:17",
            "content": "でも",
            "Chinese": "但是，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:51:25",
            "content": "穏やかに話せる人も",
            "Chinese": "也有人能够平心静气地交谈，"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:51:25",
            "content": "はい",
            "Chinese": "嗯。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:51:28",
            "content": "いると思うので",
            "Chinese": "我觉得是有的，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:51:35",
            "content": "それを考えると",
            "Chinese": "一想到这个，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:51:42",
            "content": "やっぱり治していきたいなと思います",
            "Chinese": "我还是想慢慢改掉这个毛病。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:52:27",
            "content": "そうですね。とても前向きでパートナーの方を大事にしたいという思いが伝わってきます。",
            "Chinese": "是啊。我能感受到您积极向上的态度，以及想要珍惜伴侣的心情。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:52:39",
            "content": "ありがとうございます",
            "Chinese": "谢谢您。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:53:15",
            "content": "きつい言い方をしてしまったとき、パートナーの方はどんな反応をなさいますか？",
            "Chinese": "当您用很冲的语气说话时，您的伴侣通常是什么反应呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:53:38",
            "content": "困ってる感じですね",
            "Chinese": "他看起来很困扰的样子。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:54:22",
            "content": "そうでしたか。そこで喧嘩になるということでもない、と考えて良いですか？",
            "Chinese": "这样啊。那么是否可以理解为，并不会因此就吵起来呢？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:55:00",
            "content": "喧嘩になるということでもないとはどういうことですかね？",
            "Chinese": "“不会演变成吵架”是什么意思呢？"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:55:26",
            "content": "激しい言い合いになってしまったりはしませんか？",
            "Chinese": "就是说，你们不会因此而激烈地争吵起来吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:55:43",
            "content": "するときはしますね",
            "Chinese": "有时候会的。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:55:51",
            "content": "私が発端なことが",
            "Chinese": "而且起因是我，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:55:54",
            "content": "ほとんどです",
            "Chinese": "几乎都是这样。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:57:41",
            "content": "なるほど。ご自身の激しい言い方を発端に言い合いになる、だからこそご自分が気をつけて穏やかに話したいとお考えなのですね。",
            "Chinese": "我明白了。因为您激烈的说话方式会引发争吵，所以您才想自己多加注意，平心静气地交谈，是这样吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:58:11",
            "content": "そうですね！",
            "Chinese": "是的！"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 19:59:23",
            "content": "自分の良くないところは、自分で気付くのが難しいですが、それを分かっていらっしゃるというのは素晴らしいことだと思いますよ。",
            "Chinese": "自己的缺点，自己是很难察觉的，您能意识到这一点，我觉得非常了不起。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 19:59:57",
            "content": "そう言っていただきありがとうございます",
            "Chinese": "谢谢您这么说。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 20:00:12",
            "content": "それでは、今日はなるべく激しい言い方をせずに、",
            "Chinese": "那么，今天我们就一起来思考一下，如何能尽量避免激烈的说话方式，"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 20:00:20",
            "content": "はい",
            "Chinese": "好的。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 20:01:17",
            "content": "意見や考え方が違っても、穏やかな話し合いが出来るようになる方法を一緒に考えていきましょう。",
            "Chinese": "即使意见或想法不同，也能平心静气地进行讨论的方法吧。"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 20:01:30",
            "content": "はい、宜しくお願いします",
            "Chinese": "好的，麻烦您了。"
        },
        {
            "role": "カウンセラー",
            "time": "2022/05/26(木) 20:02:48",
            "content": "まず、激しい言い方をするときというのは、もう半分怒っている状態だと思うのですが、いかがですか？",
            "Chinese": "首先，当您用激烈的语气说话时，我想您已经处于半生气的状态了，是这样吗？"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 20:02:59",
            "content": "そうですねー。。",
            "Chinese": "是啊……"
        },
        {
            "role": "クライアント",
            "time": "2022/05/26(木) 20:03:10",
            "content": "いらいらしてますね",
